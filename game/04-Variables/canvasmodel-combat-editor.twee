:: Canvas Combat Editor
<<set $demo to $demo or {
	type: "human",
	position: "missionary",
	consent: true,
	debug: true,
}>>

<<if $sexstart is 1>>
	<<set $sexstart to 0>>
	<div class="combat-init">
		<<switch $demo.type>>
			<<case "human">>
				<p class="text-muted">인간 초기화</p>
				<<maninit>>
			<<case "bestial">>
				<p class="text-muted">야수 초기화</p>
				<<beastCombatInit>>
		<</switch>>
		<<if $demo.consent>>
			<<consensual>>
			<<set $consensual to 1>>
		<<else>>
			<<molested>>
			<<set $consensual to 0>>
		<</if>>
		<<set $position to $demo.position>>
	</div>
<</if>>

<<if $demo.type is "tentacles">>
	<div class="combat-state">
		<p class="text-muted">촉수 상태</p>
		<<statetentacles>>
	</div>
<</if>>

<div class="combat-effects">
	<p class="text-muted">효과</p>
	<<effects>>
</div>
<div class="combat-effectsman">
	<p class="text-muted">인간 효과</p>
	<<effectsman>>
</div>
<div class="combat-man">
	<<switch $demo.type>>
		<<case "human">>
			<p class="text-muted">인간</p>
			<<man>>
		<<case "bestial">>
			<p class="text-muted">야수</p>
			<<beast>>
	<</switch>>
</div>

<<if $demo.type.includes("human")>>
	<div class="combat-state">
		<p class="text-muted">인간 상태</p>
		<<stateman>>
	</div>
<</if>>
<div class="combat-actions">
	<p class="text-muted">전투 애니메이션</p>
	<<animateCombat>>
</div>
<div class="combat-actions">
	<p class="text-muted">인간 행동</p>
	<<actionsman>>
</div>

<span id="next"><<link [[다음|$passage]]>><</link>></span><<nexttext>>
<<link [[침실|Bedroom]]>>
	<<endcombatdemo>>
<</link>>
<br><br>
