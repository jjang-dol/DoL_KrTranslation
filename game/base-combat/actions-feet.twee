:: Widgets Actions Feet [widget]
<<widget "feetgrab">>
	<<if $combattype is "train">>
		<<set _end to $enemyno-1>>
	<<else>>
		<<set _end to 0>>
	<</if>>

	<<set _xx to $enemyno-1>>
	<<if _xx is -1>>
		<<set _stanceCheck to 0>>
	<<else>>
		<<set _stanceCheck to $NPCList[_xx].stance>>
	<</if>>

	<<if $consensual is 1 and !hasSexStat("promiscuity", 3) and $enemytype is "man" or $consensual is 1 and !hasSexStat("deviancy", 3) and $enemytype isnot "man">>
		<!-- Do Nothing -->
	<<elseif _stanceCheck isnot "topface">>
		<<for _j = $enemyno-1; _j gte _end; _j-->>
			<<if $NPCList[_j].penis is 0>>
				<<if $feetactiondefault is "grab">>
					| <label><span class="sub"><<his>> 자지를 움켜쥔다</span> <<radiobutton "$feetaction" "grab" checked>><<feetdifficulty>> <<combatpromiscuous3>></label>
				<<else>>
					| <label><span class="sub"><<his>> 자지를 움켜쥔다</span> <<radiobutton "$feetaction" "grab">><<feetdifficulty>> <<combatpromiscuous3>></label>
				<</if>>
				<<break>>
			<</if>>
		<</for>>
		<<for _j = $enemyno-1; _j gte _end; _j-->>
			<<if $NPCList[_j].vagina is 0>>
				<<if $feetactiondefault is "vaginagrab">>
					| <label><span class="sub">발로 <<his>> 보지를 누른다</span> <<radiobutton "$feetaction" "vaginagrab" checked>><<feetdifficulty>> <<combatpromiscuous3>></label>
				<<else>>
					| <label><span class="sub">발로 <<his>> 보지를 누른다</span> <<radiobutton "$feetaction" "vaginagrab">><<feetdifficulty>> <<combatpromiscuous3>></label>
				<</if>>
				<<break>>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

<<widget "feetgrabnew">>
	<<if $feettarget isnot "self">>
		<<set _stanceCheck to $NPCList[$feettarget].stance>>

		<<set $_penis to (npcHasStrapon($feettarget) ? "페니스 밴드" : "자지")>>
		<<if $consensual is 1 and (!hasSexStat("promiscuity", 3) and $enemytype is "man" or !hasSexStat("deviancy", 3) and $enemytype isnot "man") and !$promiscuityIgnore>>
			<!-- Do Nothing -->
		<<elseif _stanceCheck isnot "topface">>
			<<if $NPCList[$feettarget].penis is 0>>
				<<if $NPCList[$feettarget].chastity.penis.includes("chastity")>>
					<<set _feetaction["상대의 " + $NPCList[$feettarget].chastity.penis + "【을를】 발로 누른다"] to "grab">>
				<<elseif !($leftleg isnot 0 or $rightleg isnot 0)>>
					<<set _feetaction["상대의 " + $_penis + "【을를】 움켜쥔다"] to "grab">>
				<</if>>
			<</if>>

			<<if $NPCList[$feettarget].vagina is 0>>
				<<if $NPCList[$feettarget].chastity.vagina.includes("chastity")>>
					<<set _feetaction["상대의 " + $NPCList[$feettarget].chastity.vagina + "【을를】 발로 누른다"] to "vaginagrab">>
				<<else>>
					<<set _feetaction["상대의 보지를 발로 누른다"] to "vaginagrab">>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "feetKick">>
	<<if $feettarget isnot "self">>
		<<if $consensual isnot 1 and ($fightTargets is undefined or $fightTargets.includes($feettarget))>>
			<<set _feetaction["발로 찬다"] to "kick">>
		<</if>>
	<</if>>
<</widget>>

<<widget "feetGrabRub">>
	<<set _feetaction["비빈다"] to "grabrub">>
	<<set _feetaction["멈춘다"] to "stop">>
<</widget>>

<<widget "feetOthervagina">>
	<<set _feetaction["비빈다"] to "vaginagrabrub">>
	<<set _feetaction["멈춘다"] to "stop">>
<</widget>>

<<widget "feetRunClothed">>
	/* Commented for lack of effect
	<<if $NPCList[$feettarget].vagina is "clothed" or $NPCList[$feettarget].penis is "clothed">>
		<<set _feetaction["Rub " + $NPCList[$feettarget].pronouns.his + " crotch"] to "rub">>
	<</if>>*/
<</widget>>

<<widget "feetshoes">>
	<<if $feettarget is "self" or $options.targetYourself is false or _targetnumber is 1>>
		<<if !$worn.feet.type.includes("shackle") and !$worn.feet.type.includes("naked")>>
			<<set _feetaction["신발을 벗어찬다"] to "feetshoes">>
		<</if>>
	<</if>>
<</widget>>

<<widget "feetsocks">>
	<<if $feettarget is "self" or $options.targetYourself is false or _targetnumber is 1>>
		<<if $worn.feet.type.includes("shackle") or $worn.feet.type.includes("naked")>>
			<<if $worn.legs.state is "ankles">>
				<<set _feetaction["하의를 벗어찬다"] to "feetsocks">>
			<<elseif $worn.legs.state is "thighs">>
				<<set _feetaction["하의를 끌어내린다"] to "feetsocks">>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "legLock">>
	<<if typeof $feettarget != "string">>
		<<if ($vaginastate is "penetrated" or $anusstate is "penetrated") and ($NPCList[$feettarget].penis is "vagina" or $NPCList[$feettarget].penis is "anus") and $leglocktarget is undefined>>
			<<if ($consensual is 0 and ($enemytype is "man" ? $promiscuity : $deviancy) lte 94)
			or ($consensual is 1 and ($enemytype is "man" ? $promiscuity : $deviancy) lte 34 and !$promiscuityIgnore)>>
				<!-- Do Nothing -->
			<<else>>
				<<if $position is "missionary">>
					<<set _feetaction["다리로 휘감는다"] to "legLock">>
				<<else>>
					<<set _feetaction["뒤로 밀어붙인다"] to "legLock">>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "legLocked">>
	<<if $position is "missionary">>
		<<set _feetaction["다리 조이기를 유지한다"] to "legLocked">>
		<<set _feetaction["풀어준다"] to "legRelease">>
	<<else>>
		<<set _feetaction["계속 뒤로 밀어붙인다"] to "legLocked">>
		<<set _feetaction["멈춘다"] to "legRelease">>
	<</if>>
<</widget>>
