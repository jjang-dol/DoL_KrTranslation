:: Widgets Audience Swarm [widget]
<<widget "audiencecameraswarm">>
	<<if _audienceswarminitcount is undefined or _audienceswarminitcount gte $audienceselector>>
		<<set _audienceswarminitcount to $audienceselector>>
		<<set _audienceswarmcarry to {"drya":{}}>>
	<<else>>
		<<set _audienceswarminitcount to $audienceselector>>
	<</if>>

	<<set _tmpcam to "none">>
	<<set _tmpsmoving to "creeping">>
	<<set _tmppspot to "">>
	<<set _tmpproof to "t">>

	<<if $swarm.type is "slimes" or $swarm.type is "pale slimes">>
		<<set _tmpsmoving to "질척거리는">>
	<<elseif $swarm.type is "worms" or $swarm.type is "maggots">>
		<<set _tmpsmoving to "꿈틀거리는">>
	<<elseif $swarm.type is "snakes" or $swarm.type is "eels">>
		<<set _tmpsmoving to "미끄러져 움직이는">>
	<<elseif $swarm.type is "spiders">>
		<<set _tmpsmoving to "기어다니는">>
	<<elseif $swarm.type is "fish">>
		<<set _tmpsmoving to "파닥거리는">>
	<</if>>

	<<rng>>
	<<if $rng gte 81 and $facepic isnot 1>>
		<<set $facepic to 1>>
		$audiencedesc $audiencecamera【이가】 당신의 얼굴에 <<ahis>> 카메라를 들이댄다. <<ahe>>【이가】 사진을 찍자 플래시가 번쩍인다.
		<br>
		<<set _tmpcam to "face">>
	<<elseif $rng gte 41 and $bottompic isnot 1>>
		<<set $bottompic to 1>>
		$audiencedesc $audiencecamera【이가】 당신의 <<bottom>>에 <<ahis>> 카메라를 들이댄다. <<ahe>>【이가】 사진을 찍자 플래시가 번쩍인다.
		<br>
		<<set _tmpcam to "bottom">>
	<<elseif $rng gte 21 and $genitalpic isnot 1>>
		<<set $genitalpic to 1>>
		$audiencedesc $audiencecamera【이가】 당신의 <<genitals>>에 <<ahis>> 카메라를 들이댄다. <<ahe>>【이가】 사진을 찍자 플래시가 번쩍인다.
		<br>
		<<set _tmpcam to "front">>
	<<elseif $bodypic isnot 1>>
		<<set $bodypic to 1>>
		$audiencedesc $audiencecamera【이가】 전체 장면을 카메라에 담으려고 몸을 뒤로 젖힌다. <<ahe>>【이가】 사진을 찍자 플래시가 번쩍인다.
		<br>
		<<set _tmpcam to "full">>
	<</if>>

	<<if $swarm.amount.genital[1] gt 0 and _tmpcam is "front">>
		<<set _tmppspot to "gi">>
	<<elseif $swarm.amount.genital[0] gt 0 and _tmpcam is "front">>
		<<set _tmppspot to "g">>
	<<elseif $swarm.amount.butt[1] gt 0 and _tmpcam is "bottom">>
		<<set _tmppspot to "bi">>
	<<elseif $swarm.amount.butt[0] gt 0 and _tmpcam is "bottom">>
		<<set _tmppspot to "b">>
	<<elseif $swarm.amount.genital[1] gt 0 or $swarm.amount.butt[1] gt 0>>
		<<set _tmppspot to "i">>
	<<else>>
		<<set _tmppspot to "o">>
	<</if>>

	<<if _audienceswarmcarry.drya[_tmppspot] is undefined>>
		<<set _audienceswarmcarry.drya[_tmppspot] to "t">>
		<<set _tmpmark to "!">>
		<<set _tmporgasm to "">>
		<<if $orgasmdown gte 1>>
			<<if $orgasmcount gt 3>>
				<<aHe>>【이가】 또다시 소리친다. "이 <<print $swarm.name>>만으로 또 절정하다니, 넌 진짜 <<print either("걸레", "더러운 걸레", "암캐", "창녀", "쓸모없는 걸레", "극단적인 변태")>>【이】야.
				<<set _tmporgasm to "<span class=\"pink\">, 격하게 절정하는 모습까지</span>">>
				<<set _tmpmark to "?">>
			<<else>>
				<<aHe>>【이가】 당신에게 소리친다. "이 <<print $swarm.name>>만으로 절정하다니, 넌 정말 <<print either("걸레", "창녀", "변태")>>【이】야.
				<<set _tmporgasm to "<span class=\"pink\">, 절정하는 모습까지</span>">>
			<</if>>
		<<else>>
			<<if _tmpcam is "none">>
				$audiencedesc $audiencecamera【이가】 외친다. "난
			<<else>>
				<<aHe>>【이가】 말한다. "난
			<</if>>
			<<if $swarm.amount.active[0] lte 4>>
				<<print $swarm.name>>【이가】 
			<<elseif $swarm.amount.active[0] lte 8>>
				몰려드는 <<print $swarm.name>>【이가】 
			<<else>>
				바글거리는 <<print $swarm.name>> 무리가
			<</if>>
		<</if>>
		<<print _tmpsmoving>>
		<<if _tmppspot is "g">>
			네 <<genitals>> 위에서 <<print _tmpsmoving>> 게 정말 좋아<<print _tmpmark>>"
		<<elseif _tmppspot is "gi">>
			네 <<genitals>> 위에서 <<print _tmpsmoving>> 게 정말 좋아<<print _tmpmark>>"
		<<elseif _tmppspot is "b">>
			네 <<bottom>> 위에서 <<print _tmpsmoving>> 게 정말 좋아<<print _tmpmark>>"
		<<elseif _tmppspot is "bi">>
			<span class="red">네 <<bottom>> 안에서 <<print _tmpsmoving>> 게 정말 좋아<<print _tmpmark>></span>"
		<<elseif _tmppspot is "i">>
			<span class="red">네 몸 안에서 <<print _tmpsmoving>> 게 정말 좋아<<print _tmpmark>></span>"
			<<set _tmpproof to "f">>
		<<else>>
			네 몸 위에서 <<print _tmpsmoving>> 게 정말 좋아<<print _tmpmark>>"
			<<set _tmpproof to "f">>
		<</if>>

		<<if _tmpcam is "face">>
			<<aHe>>【이가】 자랑스럽게 <<ahis>> 폰을 본다. "여기 <<pher>> 얼굴 클로즈업 사진이 있지<<print _tmporgasm>><<if _tmpproof is "t">>. 이게 증거야."<<else>>."<</if>>
		<<elseif _tmpcam is "bottom">>
			<<aHe>>【이가】 자랑스럽게 <<ahis>> 폰을 보여준다. "여기 <<pher>> <<bottom>> 클로즈업 사진이 있지<<print _tmporgasm>><<if _tmpproof is "t">>. 이게 증거야!"<<else>>."<</if>>
		<<elseif _tmpcam is "front">>
			<<aHe>>【이가】 자랑스럽게 <<ahis>> 폰을 치켜든다. "여기 <<pher>> <<genitals>> 클로즈업 사진이 있지<<print _tmporgasm>><<if _tmpproof is "t">>. 이게 증거야!"<<else>>."<</if>>
		<<elseif _tmpcam is "full">>
			<<aHe>>【이가】 자랑스럽게 <<ahis>> 폰에 있는 사진들을 보여준다. "이 걸레 사진들이 증거지."
			<<set _tmpproof to "f">>
		<</if>>
	<</if>>
<</widget>>
