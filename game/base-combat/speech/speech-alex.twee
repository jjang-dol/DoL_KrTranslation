:: Widgets speech-Alex [widget]
<<widget "speech-alex">>
	<<set _npc_speech to true>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Alex") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Alex")>>
		<<He>>【은는】 미소 지었다. "처음이야? 잊지 못하게 각별히 신경 써줄게."
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Alex">>
		<<He>>【은는】 미소 지었다. "조이는데. 네 엉덩이를 쓰게 해줬다는 건 아무한테도 말 안 할게."
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Alex">>
		<<He>>【은는】 미소 지었다. "이렇게 입을 써본 적은 없지? 이빨만 안 닿게 조심해."
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Alex">>
		<<He>>【은는】 미소 지었다. "도시 <<girls>>【은는】 참 귀엽단 말이지."
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<if $alex_countdown is undefined and $farm_stage gte 7>>
			<<switch _loveInterest>>
				<<case "Black Wolf">>
					<<He>>【은는】 어깨를 늘어뜨렸다. "짐승이랑 양다리를 걸친 거야? 술이 더 필요하겠어..."
				<<case "Great Hawk">>
					<<He>>【은는】 노려보았다. "황무지에서 뇌라도 파먹힌 거냐? 거긴 얼쩡거리지 마."
				<<default>>
					<<He>>【은는】 노려보았다. "양다리를 걸쳤어?"
			<</switch>>
		<<else>>
			<<switch _loveInterest>>
				<<case "Black Wolf" "Great Hawk">>
					"내가 술을 너무 많이 마셨나 봐." <<he>>【이가】 말했다. "말도 안 되는 소리를 다 하네."
				<<default>>
					"내가 술을 너무 많이 마셨나 봐." <<he>>【이가】 <<his>> 이마를 짚으며 말했다.
			<</switch>>
		<</if>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "성기구들" : "성기구")>>
		<<if C.npc.Alex.dom gte 30>>
			<<print `<<He>>【은는】 당신의 $_sexToy【을를】 보고 씩 웃었다. "` + [`이제야 좀 말이 통하네.`, `귀여운 장난감이네. 어떻게 쓰는지 아는 게 좋을 거야.`, `도시에선 고작 그게 최선이야?`][random(0,2)] + `"`>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<print `<<He>>【은는】 당신의 $_sexToy【을를】 보고 머뭇거렸다. "` + [`알았어. 네 판단을 믿을게.`, `그걸 어떻게 쓰는지 알고 있길 바라.`, `넌 항상 어떻게 해야 재밌는지 잘 아네.`][random(0,2)] + `"`>>
		<<else>>
			<<print `<<He>>【은는】 당신의 $_sexToy【을를】 보고 미소 지었다. "` + [`네 생각 꽤 마음에 들어.`, `거친 밤이 될 것 같네.`, `도시에선 이런 게 잘 팔리나 보지.`][random(0,2)] + `"`>>
		<</if>>
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>