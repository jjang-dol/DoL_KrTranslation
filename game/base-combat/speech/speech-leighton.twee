:: Widgets speech-Leighton [widget]
<<widget "speech-leighton">>
	<<set _npc_speech to true>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Leighton") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Leighton")>>
		<<He>>【이가】 비릿하게 웃는다. "만족스럽지 못하군. 훈련이 더 필요하면 언제든 내게로 와라."
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Leighton">>
		<<He>>【이가】 비릿하게 웃는다. "훈련이 더 필요하겠군."
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Leighton">>
		<<He>>【이가】 비릿하게 웃는다. "아직 실력이 부족하군... 뭐, 지금 당장은 말이지."
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Leighton">>
		<<He>>【이가】 비릿하게 웃는다. "처음치고는 나쁘지 않군."
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<He>>【이가】 씨익 웃는다. "다른 학생이라? <<nnpc_him "Robin">>도 내 사무실로 한번 불러야겠군."
			<<case "Kylar">>
				<<He>>【이가】 눈살을 찌푸린다. "카일라라고? 그걸로 설명이 다 되는군."
			<<case "Whitney">>
				<<He>>【이가】 얼굴을 찌푸린다. "너랑 그 불량배가? 별로 놀랍지도 않군."
			<<case "Sydney">>
				<<if $sydneySeen.includes("spank")>>
					<<He>>【이가】 씨익 웃는다. "시드니? 다음번엔 내 사무실에서 <<nnpc_his "Sydney">> 체벌을 해야겠어."
				<<else>>
					<<He>>【이가】 씨익 웃는다. "시드니? 조만간 그 녀석도 내 방에 부를 작정이다."
				<</if>>
			<<case "Black Wolf" "Great Hawk">>
				<<He>>【이가】 눈살을 찌푸린다. "동물이라니? 이건 아주 엄격한 훈육이 필요하겠군."
			<<default>>
				<<He>>【이가】 씩 웃는다. "누군지는 모르겠군. 어쨌든 개인적인 일이니 상관없지."
		<</switch>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
		<<He>>【이가】 당신의 $_sexToy【을를】 보고 씨익 웃는다. "그걸로 내가 몇 가지 가르쳐 줄 수 있겠군."
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>

