			<<print either(
				`"목소리가 어쩜 이렇게 애처로울까," <<he>>【이가】 콧소리를 내며 머리칼을 쓸어내린다. "다 낫게 해줄 테니까."`, 
				`"징징댈 필요 없어요,<<if C.npc.Avery.love gte 60>> 내 사랑스러운<</if>> 강아지," <<he>>【이가】 달래듯 속삭인다. "네가 원하는 걸 정확히 안겨줄 테니까."`
			)>>
		<<else>>
			<<print either(
				`<<He>>【이가】 달래듯 발개진 뺨을 쓰다듬는다. "불쌍하고 애타는 내 강아지. 그렇게나 쑤셔대니?"`, 
				`<<He>>【이가】 콧소리를 낸다. "목소리가 아주 애타 죽으려고 하네, <<pcpetname "Avery">>. 그 고통에서 벗어나게 해줄까요?"`, 
				`"자, 조용히 해요, <<pcpetname "Avery">>. 그렇게 애원하지 않아도," 	<<he>>【이가】 귓가에 대고 속삭인다. "내가 바로 여기 있으니까."`, 
			)>>
		<</if>>

	/* PC Pleading / Begging */
	<<elseif $speechplead is 1>>
		<<switch $speechspecialdialogue>>
			<<case "avery_plead_mansion">> /* I'm sorry, Avery, please */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"네 그 사과 따위는 필요 없어, 내가 원하는 건 복종이야!"
				<<else>>
					"거봐, 착한 애완동물처럼 내 밑에서 옴짝달싹 못 하잖아. 안됐지만 지금 난 자비 따위 베풀 기분이 아니거든," <<he>>【이가】 콧소리를 낸다.
				<</if>>
			<<case "avery_plead_premansion">> /* Was this all the date was for...? */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					<<He>>【이가】 콧방귀를 뀐다. "네가 더 나은 대우를 받을 자격이라도 있다고 생각해요? 네가 받는 건 딱 내가 주는 만큼뿐이야."
				<<else>>
					<<He>>【이가】 웃는다. "뭘 기대했던 거예요, <<pcpetname "Avery">>? <<= either("동화속 이야기라도","내 인내심이 끝없을 거라고")>>?"
				<</if>>
			<<case "avery_plead_hunting_1">> /* Sorry I didn't mean to */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"내 머리를 장식으로 아나," <<he>>【이가】 으르렁거린다. "네가 뭘 하고 있는지 아주 잘 알고 있었잖아!"
				<<else>>
					"조용히 해. 착한 <<girl>>답게 벌이나 받아."
				<</if>>
			<<case "avery_plead_hunting_2">> /* I promise I'll do better */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"제대로 하긴, 내가 아주 싹 고쳐놓을 테니까!"
				<<else>>
					"앞으로는 잘하게 될 거예요. 내가 직접 확실히 버르장머리를 고쳐놓을 테니까." <<He>>【이가】 차갑게 미소 짓는다.
				<</if>>
			<<case "avery_plead_romance">> /* I love you, Avery */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"그 따위 단어로 감히 나를 조종하려 들 생각 마," <<he>>【이가】 뱉어내듯 말한다.
				<<else>>
					<<He>>【이가】 비웃는다. "진정으로 나를 사랑했다면 그렇게 거역하지도 않았겠지."
				<</if>>
		<</switch>>
	/* PC Moaning */
	<<elseif $speechmoan is 1>>
		<<switch $speechspecialdialogue>>
			<<case "avery_moan_default">> /* You're worth more than any payout */
				<<if C.npc.Avery.rage gte 60 >>
					<<He>>【이가】 코웃음을 친다. "그래요? 최근에 네가 벌인 짓거리를 보면 믿기지가 않는데."
				<<elseif C.npc.Avery.rage gte 20>>
					<<He>>【이가】 픽 웃는다. "알아요. 그래도 얌전히만 군다면 돈은 계속 들어올 테니까요, <<pcpetname "Avery">>."
				<<else>>
					<<He>>【이가】 <<= either("미소 짓는다","<<laughs>>")>>. "그렇게 생각해요? 아주 귀엽네."
				<</if>>
			<<case "avery_moan_ascended">> /* I'm all yours, Hound */
				<<if $consensual>>
					<<if C.npc.Avery.rage gte 60 >>
						<<His>> eyes widen for a moment, then grow dark with desire. "그래, 당신은 내 거지." <<He>>【이가】 으쓱하며 <<= either("콧방귀를 뀐다","코웃음을 친다")>>. "네 분수를 잘 알고 있다니 다행이네, 내 작은 여우."
					<<elseif C.npc.Avery.rage gte 20>>
						<<His>> eyes widen for a moment, then grow dark with desire. "그래, 그렇지?" <<He>>【이가】 만족스러운 듯 픽 웃는다. "네 분수를 잘 알고 있군, 내 작은 여우..."
					<<else>>
						<<His>> eyes widen for a moment, then grow dark with desire. "그래... 그렇지." <<He>>【이가】 만족스러운 듯 <<laughs>>. "네 분수를 알고 있다니 기쁘네요, 내 작은 여우."
					<</if>>
				<<elseif C.npc.Avery.rage gte 60 >>
					<<His>> eyes widen for a moment, then grow dark with desire. "그래, 당신은 내 거지." <<He>>【이가】 으쓱하며 <<= either("콧방귀를 뀐다","코웃음을 친다")>>. "그러니까 그짝으로 행동해!"
				<<elseif C.npc.Avery.rage gte 20>>
					<<His>> eyes widen for a moment, then grow dark with desire. "그래, 그렇지?" <<He>>【이가】 만족스러운 듯 픽 웃는다. "그러니까 앞으로 행동 똑바로 하는 게 좋을 거야, <<girl>>."
				<<else>>
					<<His>> eyes widen for a moment, then grow dark with desire. "그래... 그렇지." <<He>>【이가】 만족스러운 듯 <<laughs>>. "그러니까 행동 똑바로 하도록 해요, <<pcpetname "Avery">>."
				<</if>>
			<<case "avery_moan_romance">> /* I love you, Avery */
				<<if C.npc.Avery.rage gte 60 >>
					<<He>>【이가】 코웃음을 친다. "그래요? 최근에 하도 말썽을 부려서 속아 넘어갈 뻔했잖아."
				<<elseif C.npc.Avery.rage gte 20>>
					<<He>>【이가】 픽 웃는다. "알아요. 그래도 한 번 더 말해줘도 좋지만."
				<<else>>
					<<He>>【이가】 <<= either("미소 짓는다","<<laughs>>")>>. "알아요. 아주 사랑스럽다니까."
				<</if>>
				<<if !$averyUniqueComments.includes("moan_romance")>>
					<<set $averyUniqueComments.pushUnique("moan_romance")>>
					<<npcincr Avery rage -1>><<larage>>
				<</if>>
			<<case "avery_moan_daddy">> /* Put me in my place, daddy */
				<<set $averyUniqueComments.pushUnique("called_daddy")>>
				<<his>> 눈이 잠시 휘둥그레졌다가, 이내 능글맞은 미소를 짓는다. 당신이 <<him>>【을를】 "<<nnpc_mummy "Avery">>"라고 부른 게 마음에 든 모양이다.
				<<if $consensual>>
					<<if C.npc.Avery.rage gte 60 >>
						"오, 확실하게 네 분수를 가르쳐주지. <<nnpc_Mummy "Avery">>【이가】 제대로 벌 줄 날만 벼르고 있었으니까."
					<<elseif C.npc.Avery.rage gte 20>>
						<<He>>【이가】 다 안다는 듯 미소 짓는다. "<<nnpc_mummy "Avery">>【이가】 네 분수를 톡톡히 가르쳐주길 바라는 건가요? 관심을 끌려고 일부러 말썽을 피웠나 보네."
					<<else>>
						<<He>>【이가】 킥킥거린다. "음. 그렇게 불러주는 거 정말 마음에 드는걸. 걱정 마요, <<nnpc_mummy "Avery">>【이가】 알아서 잘 보살펴 줄 테니까."
					<</if>>
				<<elseif C.npc.Avery.rage gte 60 >>
					<<He>>【이가】 비웃는다. "아, 그럴 작정이야. <<nnpc_mummy "Avery">>【이가】 네가 있어야 할 곳이 어디인지 아주 뼈저리게 상기시켜 줄 테니까."
				<<elseif C.npc.Avery.rage gte 20>>
					"<<nnpc_mummy "Avery">> 손에 아주 혼쭐이 나고 싶어서 일부러 엉뚱한 짓을 벌인 건가? 네가 있어야 할 자리가 어딘지 기꺼이 가르쳐주지."
				<<else>>
					"<<nnpc_mummy "Avery">>【이가】 네 분수를 짚어주길 바랐던 거예요? 굳이 내 손을 강제로 빌리지 말고 곱게 말로 부탁했어도 됐을 텐데."
				<</if>>
			<<case "avery_moan_premansion">> /* Take me away from that place */
				<<if C.npc.Avery.rage gte 60 >>
					"안 됐네. 전에는 나와는 엮이기조차 싫어했던 것 같은데 말이지."
				<<elseif C.npc.Avery.rage gte 20>>
					"한 번 더 빌게 만들어야겠어. 그렇게 절박해질 때 목소리가 훨씬 더 달콤하니까."
				<<else>>
					<<He>>【이가】 장난스럽게 미소 짓는다. "음. 집에서 나를 기다리는 모습이 꽤나 예뻐 보일 것 같네요."
				<</if>>
			<<case "avery_moan_mansion">> /* Let me show you how grateful I am */
				<<if C.npc.Avery.rage gte 60 >>
					"갑작스러운 그 감사함이 오래갔으면 좋겠네요. 최근 네 행실은 도저히 눈감아 줄 수가 없었으니까."
				<<elseif C.npc.Avery.rage gte 20>>
					"지금처럼만 굴면 불평할 일도 없을 텐데. 그렇게 하고 싶죠?"
				<<else>>
					<<He>>【이가】 픽 웃는다. "말은 번지르르하게 잘하네. 자, 그럼 그 예쁜 제안을 어디 한번 어디에 써먹어 볼까."
				<</if>>
		<</switch>>
	/* PC Demanding  */
	<<elseif $speechdemand is 1>>
		<<switch $speechspecialdialogue>>
			<<case "avery_demand_default">> /* You don't pay me enough */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					"감히 내 앞에서 돈 따위 입에 올리지 마, 이 탐욕스러운 걸레년!"
				<<else>>
					<<His>> eyes narrow. "그런 짓거리를 해놓고 감히 더 내놓으라고 요구하다니, 배가 부르군요."
				<</if>>
			<<case "avery_demand_mansion">> /* Stop it Avery */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					<<He>>【이가】 경멸하듯 웃는다. "파트너 행세라도 하고 싶나? 그럼 복종부터 배우시지!"
				<<else>>
					"네가 엉뚱한 짓을 벌일 때 직함 따위가 네 훈육을 막아주진 못한답니다."
				<</if>>
			<<case "avery_demand_hunting">> /* Get the hell away */
				"정말 끝도 없이 이러네!" <<he>>【이가】 <<= either("침을 뱉는다","화난 듯 쉭 소리를 낸다","으르렁거린다")>>. "내가 해주는 건 하나도 고마워할 줄 몰라!<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>> 끝도 없이 바라는 것만 있지!<</if>>"
			<<case "avery_demand_romance">> /* I told you I loved you */
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					<<His>> expression twists with anger. "내가 너한테 해준 게 얼텐데, 감히 그 <<= either("시궁창","지옥구석")>> 같은 곳이 나랑 있는 것보다 낫다고 생각하는 거야?"
				<<else>>
					<<His>> expression hardens. "그 비참한 삶에서 벗어날 기회를 줬더니, 그걸 내 얼굴에 침 뱉기로 갚아?"
				<</if>>
			<<default>> /* Mock/Disparage or defautl demand */
				<<if C.npc.Avery.rage gte 20>>
					<<He>>【이가】 씩씩거린다. "당장 그 더러운 입 안 다물어!"
				<<else>>
					"정말 후회할 소릴 지껄이기 전에 멈추는 게 좋을 거예요, <<pcpetname "Avery">>," <<he>>【이가】 낯빛을 어둡게 하며 으르렁거린다.
				<</if>>
		<</switch>>
	/* PC forgiving (Angel TF only) */
	<<elseif $speechforgive is 1>>
		<<if $avery_fate is "saved">>
			<<= $enemyanger gt 20 or $enemyhealth lt $enemyhealthmax ? "분노에 찬" : "짜증 섞인">> 표정 속에서 <<his>>의 눈썹이 미세하게 씰룩이는 것이 보인다.
		<<elseif C.npc.Avery.rage gte 20>>
			"네가? 나를 용서하겠다고?" <<He>>【이가】 콧방귀를 뀐다. "우리 사이에 용서가 필요한 사람이 있다면, 그건 바로 너야!"
		<<else>>
			"도대체 뭘 용서한다는 건지 원," <<he>>【이가】 비웃는다. "네가 스스로 자초해서 얻어낸 꼴에 불과하잖아, 이 작은 <<bastard>>【아야】."
		<</if>> 
	/* PC apologizing more than once */
	<<elseif $speechapologiseno is 1>>
		<<if $enemyanger lte 20>>
			<<print either(
				`"거봐, 아주 신나서 싹싹 빌어대네," <<he>>【이가】 콧소리를 낸다. "진정해요, 이미 용서해 줬으니까."`,
				`"내 눈에 들려고 안달이 난 모습이 귀엽긴 하지만, 사과는 한 번이면 족해요."`,
				`<<He>>【이가】 완전히 흥미롭다는 듯 웃는다. "이미 네 사과는 받아줬어요, <<pcpetname "Avery">>. 그렇게 빌고 또 빌 필요 없으니까."`
				)>>
		<<elseif $enemyanger lte 100>>
			<<print either(
				`"이렇게 빨리 싹싹 빌고 기어오를 줄은 몰랐네." <<He>>【이가】 차갑게 미소 짓는다. "정말이지."`,
				`"네가 그렇게 절박해하는 꼴을 보는 건 확실히 재밌긴 하네," <<he>>【이가】 건조하게 킥킥거린다. "하지만 내 용서가 마르지 않는 샘물은 아니랍니다."`,
				`"아쉽지만 내 아량은 무한정 리필되는 자원이 아니에요, <<pcpetname "Avery">>," <<he>>【이가】 비웃는다.`
			)>>
		<<else>>
			<<print either(
				`"거짓말을 지껄이고 있었다는 걸 진작에 알아챘어야 했는데!" <<He>>【이가】 분노에 찬 표정을 짓는다.`,
				`"그 얕은 수작에 또 넘어갈 줄 알았다면, 네가 생각한 것보다 훨씬 더 멍청한 거다!"`,
				`"나를 거스를 때마다 매번 사과하면 그만일 줄 알았나?" <<he>>【이가】 비웃는다. "그 얄팍한 수작에 두 번은 안 속아."`,
				`"입만 아프니까 그만하지. 나를 또 거스른 그 순간에 네 용서받을 기회는 끝났으니까."`,
				`"너 같은 거짓말쟁이가 하는 사과를 내가 또 받아줄 거라고 생각했나?" <<He>>【이가】 경멸하듯 웃는다. "꿈 깨시지."`
			)>>
		<</if>>
	/* PC apologizing when Avery has the unforgiving trait  */
	<<elseif $speechapologiseunforgiving is 1 and $consensual>>
	<<if $enemyanger lte 20 or C.npc.Avery.rage lt 20>>
		<<print either(
			`"입 아프게 떠들 필요 없어, <<pcpetname "Avery">>," 미소를 지으며 <<he>>【이가】 말한다.`,
			`"정말 미안했다면 애초에 그런 짓은 안 했겠지," 눈썹을 치켜올리며 <<he>>【이가】 말한다.`
		)>>
	<<elseif $enemyanger lte 100 or C.npc.Avery.rage lt 60>>
		<<print either(
			`"네가 한 짓에 딱 맞는 대가를 치르게 될 거야, <<girl>>."`,
			`"입 아프게 떠들지 마," 짓궂게 웃으며 <<he>>【이가】 말한다.`
		)>>
	<<else>>
		<<print either(
			`"그 좆같은 입 다물어," <<he>>【이가】 씩씩거린다. "그쯤 했으면 됐어."`,
			`"정말 미안했다면 애초에 그런 짓은 안 했겠지, 이 <<= either("썅년","새끼","썅것")>>【아야】."`
		)>>
	<</if>>
<<elseif $speechapologiseunforgiving is 1 and !$consensual>>
	<<if $enemyanger lte 20 or C.npc.Avery.rage lt 20>>
		<<print either(
			`"입 아프게 떠들지 마, <<pcpetname "Avery">>," 고통을 약속하는 듯한 억지 미소를 지으며 <<he>>【이가】 말한다.`,
			`"정말 미안했다면 애초에 그런 짓은 안 했겠지," 무자비한 시선으로 쏘아보며 <<he>>【이가】 말한다.`,
