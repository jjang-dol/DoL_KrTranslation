:: Widgets speech-Whitney [widget]
<<widget "speech-whitney">>
	<<set _npc_speech to true>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Whitney") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Whitney")>>
		<<He>>【이가】 비웃는다. "이제 처녀란 소리는 못 듣겠네. 넌 이제 내 천박한 걸레년이야."
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Whitney">>
		<<He>>【이가】 크게 웃는다. "여긴 안 된다 이거냐? 네가 뒈질 듯이 꽥꽥거리는 소릴 듣고 싶다고, <<bitch>>【아야】!"
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Whitney">>
		<<He>>【이가】 웃는다. "내가 장담컨대 너 조만간 푹 빠져들 거다!"
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Whitney">>
		<<He>>【이가】 웃어제낀다. "표정이 왜 그래? 내가 처음은 아닐 거 아냐, 이 걸레야."
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<if _loveInterest is "Black Wolf">>
			<<print `<<He>>【이가】 비웃는다. "` + [`개새끼랑 떡쳤다고 자기 입으로 인정하는 거냐? 참 가지가지 하네.`, `네년이 진짜 누구의 <<bitch>>인지 내가 확실하게 일깨워줘야겠네.`][random(0,1)] + `"`>>
		<<elseif _loveInterest is "Great Hawk">>
			<<print `<<He>>【이가】 비웃는다. "` + [`새랑 떡쳤다고 자기 입으로 인정하는 거냐? 참 가지가지 하네.`, `네가 어딜 날아가. 내 손아귀를 벗어날 순 없어.`][random(0,1)] + `"`>>
		<<elseif random(1, 2) lte 1>>
			<<switch _loveInterest>>
				<<case "Robin">>
					<<He>>【이가】 비웃는다. "그딴 약해빠진 등신새끼한테 푹 빠졌다고? 다음번엔 누굴 밟아줘야 할지 알겠네."
				<<case "Kylar">>
					<<He>>【이가】 성질을 낸다. "그딴 괴물 새끼한테 홀딱 넘어갈 줄 알았어야 했는데."
				<<case "Sydney">>
					<<He>>【이가】 웃는다. "책 도둑놈들 두 마리가 나란히 있네. 아주 귀여워 죽겠어."
				<<default>>
					<<He>>【이가】 으르렁거린다. "네년한테 왜 선택권 따윈 없는지 내가 뼈저리게 알려주지."
			<</switch>>
		<<else>>
			<<He>>【이가】 웃어제낀다. "네 사소한 연애놀음 따윈 알 바 아냐. 넌 내 거니까."
		<</if>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
		<<print `<<He>>【이가】 당신의 $_sexToy【을를】 보고 씩 웃는다. "` + [`착한 걸레.`, `네가 발정난 걸레년인 건 알고 있었지.`, `괜히 머리 굴리지 마.`, `왜, 네 그 음탕한 주둥이라도 아프냐?`][random(0,3)] + `"`>>
	<<elseif $speechchastity is 1>>
		<<if $worn.genitals.name is "chastity parasite">>
			<<print [`<<He>>【이가】 웃는다. "내가 여길 쥐어짤 때마다 네년은 참 음탕한 표정을 지어."`, `<<He>>【이가】 눈썹을 들어 올린다. "그렇게 좋아?"`, `<<He>>【이가】 눈썹을 찌푸린다. "발정난 걸레년."`][random(0, 2)]>>
		<<elseif $worn.genitals.origin is "Whitney">>
			<<if $rng gte 86 and $player.gender_appearance is "f" and $player.penissize lt 0>>
				<<print `<<He>>【이가】 능글맞게 웃는다. "네 그 조그맣고 ${$player.virginity.penile is true ? "써본 적 없는" : "쓸모없는"} 좆이 잠겨 있으니까 존나 귀엽네." <<insecurity "penis_small" 4>><<ginsecurity "penis_small">>`>>
			<<elseif $rng gte 61>>
				<<if playerBellyVisible() and random(0, 100) gte 50>>
					"착한 걸레." <<He>>【이가】 능글맞게 웃는다. "이런 거 없어도 아주 잘만 즐기고 있으니까 굳이 안 풀어줘도 되겠어."
				<<elseif ((!playerBellyVisible() and knowsAboutAnyPregnancy("pc", "Whitney")) or !$settings.pregnancySpeechEnabled) and random(0, 100) gte 50>>
					<<print `"착한 걸레." <<He>>【이가】 능글맞게 웃는다. "걱정 마, 네 배가 ${$settings.pregnancySpeechEnabled ? "불러와도" : "박혀대도"} 넌 여전히 내 걸레니까."`>>
				<<elseif C.npc.Whitney.vagina isnot "none" and $whitneyromance and $settings.pregnancySpeechEnabled and !npcIsPregnant("Whitney")>>
					"착한 걸레." <<He>>【이가】 능글맞게 웃는다. "내 걸 가질 준비가 되면, 나중에 언젠간 풀어주지 뭐."
				<<else>>
					"착한 걸레." <<He>>【이가】 능글맞게 웃는다. "네가 놀아나는 데 그게 필요한 것도 아니잖아."
				<</if>>
			<<else>>
				<<print `"착한 걸레." <<He>>【이가】 능글맞게 웃는다. "${["너 같은 걸레년이 채워지지도 않고 돌아다니게 내버려둘 순 없지.", "그것 때문에 잔뜩 열올랐으면 좋겠는데.", "이딴 게 망가지지도 않으면 좋을 텐데."][random(0,2)]}"`>>
			<</if>>
		<</if>>
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>
