:: Widgets speech-Robin [widget]
<<widget "speech-robin">>
	<<set _npc_speech to true>>
	<<rng>>
	<<if !$robinUniqueComments>>
		<<set $robinUniqueComments to []>>
	<</if>>
	<<set _robinMemory to false>>
	<<if C.npc.Robin.trauma gte 20 and $rng gte 90 and !$weekly.robinMemory>>
		<<cleareventpool>>
		<<if $robinPunishments.includes("mansion")>>
			<<addinlineevent "robin_speech_mansion">>
				<<if C.npc.Robin.dom gte 70>>
					"그... 역겨운 부자 놈들 손길 따위보단 언제든 네 손길을 택할 거야." <<He>>【은는】 더 험한 말을 뱉기 전에 입을 다문다.
				<<else>>
					"그 파티에서 그런 일을 겪고 나서도... 난 여전히 네 손길이 제일 좋아," <<he>>【이가】 속삭인다.
				<</if>>
				<<robinMemoryHeal "healedMansion">>
			<</addinlineevent>>
		<</if>>
		<<if $robinPunishments.includes("landfill") and C.npc.Robin.love gte 60>>
			<<addinlineevent "robin_speech_mist">>
				<<if C.npc.Robin.trauma gte 60>>
					"네가 너무나도 필요해," <<he>>【이가】 <<= either("속삭인다","흐느낀다","헐떡인다")>>. "그 감정들은 결코 안개 때문만이 아니었어."
				<<else>>
					"그땐 분홍 안개에 취해 있었던 거 알지만, 그래도... 널 정말 사랑해. 너무너무 많이." 흐리멍덩한 눈을 한 채 <<he>>【이가】 미소 짓는다.
				<</if>>
				<<robinMemoryHeal "healedMist">>
			<</addinlineevent>>
		<</if>>
		<<if $robinSeen.includes("pilloryRescue")>>
			<<addinlineevent "robin_speech_pillory_rescue">>
				<<if $robinSeen.includes("pilloryNaked")>>
					"네가 날 찾아와 주는 한, 네 품에선 안전하다는 걸 알아," <<he>>【이가】 속삭인다.
				<<else>>
					"나의 영웅..." 로빈의 목소리가 떨린다. "이 마을의 끔찍한 사람들에게서 날 구해줬잖아. 난 네 거야."
				<</if>>
				<<robinMemoryHeal "healedPilloryRescue">>
			<</addinlineevent>>
		<</if>>
		<<if $robinSeen.includes("ubMetal")>>
			<<addinlineevent "robin_speech_metal">>
				<<print either(
					`"천천히 해도 돼..." <<he>>【이가】 <<= either("따뜻하게 미소 짓는다","속삭인다","중얼거린다")>>. "이제 남들에게 보여주려고 애쓸 필요 없잖아."`,
					`"서두르지 않아도 돼..." <<he>>【이가】 <<= either("따뜻하게 미소 짓는다","속삭인다","중얼거린다")>>. "이제 아무도 너한테 억지로 하라고 강요하지 않아."`
				)>>
				<<robinMemoryHeal "healedUbMetal">>
			<</addinlineevent>>
		<</if>>
		<<if $robinSeen.includes("ubDouble") and (C.npc.Robin.virginity.anal is "player" or C.npc.Robin.virginity.vaginal is "player" or C.npc.Robin.virginity.penile is "player" or C.npc.Robin.dom gte 70)>>
			<<addinlineevent "robin_speech_double">>
				<<if C.npc.Robin.virginity.anal is "player" or C.npc.Robin.virginity.vaginal is "player" or C.npc.Robin.virginity.penile is "player">>
					"그 역겨운 인간들에게 빼앗기기 전에 너한테 내 처음을 줄 수 있어서 정말 다행이야." <<He>>【은는】 미소 짓는다.
				<<elseif C.npc.Robin.dom gte 70>>
					"그런 작자들은 너에 비하면 아무것도 아니야... 우리가 나눈 것들, 그리고 지금 함께 나누고 있는 것들에 비하면 말이야." <<He>>【은는】 미소 짓는다.
				<</if>>
				<<robinMemoryHeal "healedUbDouble">>
			<</addinlineevent>>
		<</if>>
		<<if $robinSeen.includes("ubMachine") and (!$robinSeen.includes("ubMachineRobinBegged") or C.npc.Robin.trauma gte 60)>>
			<<addinlineevent "robin_speech_machine">>
				<<if $robinSeen.includes("ubMachineRobinBegged")>>
					"그때 그런 말을 해서 미안해," <<he>>【이가】 속삭인다. "날 용서해 줬으면 좋겠는데..."
				<<else>>
					"그때 날 위해 참아줬잖아," <<he>>【이가】 숨을 헐떡인다. "몇 배로 갚아줄게."
				<</if>>
				<<robinMemoryHeal "healedUbMachine">>
			<</addinlineevent>>
		<</if>>
		<<if $robinSeen.includes("ubEscapeAlone")>>
			<<addinlineevent "robin_speech_escape_alone">>
				"나의 영웅..." <<he>>【이가】 <<= either("속삭인다","흐느낀다","헐떡인다")>>. "이제 아무도 우릴 갈라놓지 못해."
				<<robinMemoryHeal "healedUbEscape">>
			<</addinlineevent>>
		<</if>>
		<<if $robinSeen.includes("ubEscapeTogether")>>
			<<addinlineevent "robin_speech_escape_together">>
				<<if $robinSeen.includes("ubHuntEscape")>>
					"나의 영웅..." 로빈의 목소리가 떨린다. "다시 돌아와서 날 구해줬잖아. 나도 네가 그만큼 소중하게 보살핌받는다고 느끼게 해줄게."
				<<elseif $robinSeen.includes("ubMetalEscape")>>
					"이제 아무도 우릴 거기에 가둬두지 못해," <<he>>【이가】 속삭인다. "네가 어디를 가든 함께 갈게."
				<<else>>
					"그 끔찍한 곳에서 무사히 빠져나와서 정말 다행이야," <<he>>【이가】 속삭인다. <<if C.npc.Robin.dom gte 70>>"베일리가 우릴 다시 잡아가지 못하게 할 거야."<<else>>"거기론 절대 다시 돌아가고 싶지 않아."<</if>>
				<</if>>
				<<robinMemoryHeal "healedUbEscape">>
			<</addinlineevent>>
		<</if>>
		<<if _eventpool.length gt 0>>
			<<set _robinMemory to true>>
		<</if>>
	<</if>>

	<<if $robinmist>>
		<<if $speechhit is 1>>
			<<print either(
				`당신이 가격하자 <<he>>【이가】 움찔한다. "윽!"`,
				`당신이 <<him>>【을를】 때리자 뒤로 물러선다.`
			)>>
		<<elseif $speechscream is 1>>
			<<print either(
				`<<his>> 귀에는 닿지 않는다.`,
				`<<He>>【은는】 아무 반응도 보이지 않는다.`,
				`로빈은 당신의 비명에 반응하려 하지만, 뜻대로 되지 않는다.`
			)>>
		<<elseif $speechspray is 1>>
			"아야!" <<He>>【은는】 두 손으로 눈을 가리며 뒤로 물러선다. <<stress 6>><<gstress>>
		<<else>>
			<br><br>
			<<print [
				`로빈이 울고 있다.`,
				`로빈은 필사적으로 당신에게서 시선을 돌리려 하지만, <<he>>【은는】 멈추지 않는다.`,
				`"나, 난...<<if $robinromance isnot 1>> 이러고 싶지 않은데...<</if>>" 로빈이 나지막이 속삭인다.`,
				`<<if $robinromance is 1>>"사랑해!" 로빈이 말하지만, 웃고 있지는 않다.<<else>>"정말 미안해!" 로빈이 겁에 질린 표정으로 말한다.<</if>>`,
				`"제, 제발, 난 그저—" 로빈이 숨을 헐떡인다. <<He>>【은는】 말을 끝맺으려 하지 않는다.`,
				`로빈은 차마 시선을 마주치지 못하고 눈을 감아버린다.`,
				`로빈이 비명을 지른다. 눈물이 <<his>> 얼굴을 타고 흘러내린다.`,
				`로빈이 고개를 흔들며 눈을 질끈 감는다.`,
				`"그, 그만해!" 로빈이 소리치지만, 당신을 향한 것이 아니다.`,
				`"<<if $robinromance is 1>>네가 필요해...<<else>>미안해... 미안해... 어쩔 수가...<</if>>" 로빈이 눈물어린 눈으로 말한다.`
			][random(0,9)]>>
			<<grtrauma>>
		<</if>>
	<<elseif $robinMetal>>
		<<print [
			`로빈은 당신의 시선을 마주하지 못한다.`,
			`<<if $robinromance is 1>>"빨리," 로빈이 속삭인다. "그래야 쟤들이 널 내버려 둘 거야."<<else>>"제발 날 미워하지 마," 로빈이 속삭인다. "너도 어쩔 수 없어... 미안해."<</if>>`,
			`로빈이 구속구에서 빠져나가려 발버둥친다.`,
			`로빈이 금속 촉수에서 벗어나려 몸부림친다. 하지만 꿈쩍도 하지 않는다.`,
			`"제발," 로빈이 훌쩍인다.`,
			`로빈이 울음을 삼킨다.`,
			`"미안해," 로빈이 딸꾹질을 한다.`,
			`"저들이 내게 무슨 짓을 했어," 로빈이 수치스럽다는 듯 말한다. "감각이... 없어."`,
			`"<<if $robinromance is 1>>너무 오래 걸려서 미안해," 로빈이 중얼거린다.<<else>>"정말 미안해," 로빈이 중얼거린다. "해 보려고 하는데, 나... 못하겠어..."<</if>>`,
			`"<<if $robinromance is 1>>저들이 날 이용해서 널 괴롭히고 있어," 로빈이 흐느낀다.<<else>>"넌 내 친구잖아," 로빈이 흐느낀다. "이러고 싶지 않아..."<</if>>`
		][random(0,9)]>>
	<<elseif $speechNPCPenisVirgin is 1 or $speechNPCVaginaVirgin is 1>>
		<<if $speechvaginavirgin is 1 or $speechanusvirgin is 1>>
			<<He>>【이가】 숨을 헉 들이켠다. "미안해! 나도 처음이라 그래! 내가 잘하고 있으면 좋겠는데."
		<<else>>
			<<He>>【이가】 감탄한다. "미안해! 이런 느낌일 줄은 몰랐어... 계속하자!"
		<</if>>
	<<elseif $speechNPCAnusVirgin is 1>>
		<<if $speechpenisvirgin is 1>>
			<<He>>【이가】 얼굴을 찌푸린다. "기분이 좀 묘하네." 그러더니 <<he>>【이가】 미소 짓는다. "우리 둘 다 처음인데, 내가 너무 못하고 있는 건 아니었으면 좋겠어!"
		<<else>>
			<<He>>【이가】 얼굴을 찌푸린다. "기분이 좀 묘하네." 그러더니 <<he>>【의】 표정이 밝아진다. "내가 잘하고 있는 거면 좋겠다."
		<</if>>
	<<elseif ($speechpenisvirgin is 1 and $player.virginity.penile is "Robin") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Robin")>>
		<<He>>【이가】 헐떡인다. "나를 위해 처음을 간직해준 거야? 나한텐 이렇게 특별한 선물을 받을 자격이 없는데. 고마워." <<his>> 뺨을 타고 눈물이 흘러내린다.
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Robin">>
		<<He>>【이가】 헐떡인다. "너무 야해!"
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Robin">>
		<<He>>【이가】 헐떡인다. "너 때문에 아래가 이상해져."
	<<elseif $speechbreasts is 1>>
		<<if $player.breastsize gte 5 and !$robinSeen.includes("breastsBig")>>
			<<set $robinSeen.pushUnique("breastsBig")>>
			<<His>> 두 눈이 놀라움으로 커진다. "이렇게 클 줄은 몰랐어!"
		<<elseif $player.breastsize lte 2>>
			"귀여워," <<he>>【이가】 말한다.
			<<if insecurityExists("breasts_small") and !$robinUniqueComments.includes("breastsAcceptance")>><<set $robinUniqueComments.pushUnique("breastsAcceptance")>><<acceptance "breasts_small" 10>><<gacceptance>><</if>>
		<<else>>
			"네 가슴은 볼 때마다 늘 놀라워," <<he>>【이가】 말한다. "그래도 난 정말 좋아!"
		<</if>>
	<<elseif $speechpenisbig is 1>>
		<<if C.npc.Robin.penis isnot "none">>
			<<if C.npc.Robin.penissize gte 3>>
				<<print either(
					`<<He>>【은는】 놀란 표정으로 당신의 <<genitals>>【을를】 바라본다. "우리 똑같네! 너무 기뻐!"`,
					`<<He>>【은는】 당신의 <<genitals>>【을를】 바라본다. "최선을 다해 볼게!"`
				)>>
			<<else>>
				<<print either(
					`<<His>> 두 눈이 커진다. "생각했던 것보다 훨씬 크네!"`,
					`<<He>>【은는】 당신의 <<genitals>>【을를】 바라본다. "최선을 다해 볼게!"`
				)>>
			<</if>>
		<<else>>
			<<print either(
				`<<He>>【이가】 숨을 헉 들이켠다. "원래부터 이렇게 컸었어?"`,
				`<<He>>【은는】 당신의 <<genitals>>【을를】 빤히 응시한다. "다 받아낼 수 있으면 좋겠는데!"`
			)>>
		<</if>>
	<<elseif $speechvaginaflaunt is 1>>
		<<if C.npc.Robin.dom gte 70>>
			<<set _flauntPool to [
				`"그냥 쳐다보고만 있지 않아도 되는데!" <<he>>【이가】 말한다.`,
				`<<He>>【은는】 골반을 살랑거리며 장난스레 윙크를 보낸다.`
			]>>
			<<if $fame.sex gte 600>>
				<<run _flauntPool.push(`"내 게 제일 마음에 든다고 해줄래?" <<He>>【이가】 미소 짓는다.`)>>
			<</if>>
			<<if $player.penisExist>>
				<<run _flauntPool.push(`"더 이상 기다리게 하지 마," <<he>>【이가】 말한다.`)>>
			<</if>>
			<<print _flauntPool.pluck()>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<if !$robinSeen.includes("vaginaFlaunt")>>
				<<set $robinSeen.pushUnique("vaginaFlaunt")>>
				"내가 너한테 이런 식으로 몸을 보여주고 있다니 믿기지가 않아..." <<He>>【이가】 웃는다.
			<<else>>
				<<print either(
					`"마, 마음에 들어?" 양 볼을 붉히며 <<he>>【이가】 묻는다.`,
					`"너 말고 다른 사람한테는 절대 이런 거 안 보여줘. 넌 나한테 특별하니까." 뺨을 더 붉히며 <<he>>【이가】 미소 짓는다.`,
					`"너한테 이런 모습을 보여주고 있다는 게 아직도 믿기지 않아..." <<He>>【이가】 미소 짓는다.`
				)>>
			<</if>>
		<<else>>
			<<set _flauntPool to [
				`"이러는 거 정말 부끄러운데... 그래도 네가 보고 싶어 했던 거 맞지?" <<he>>【이가】 말한다.`,
				`"보니까 마음에 들어?" <<He>>【이가】 미소 짓는다.`,
				`"너 때문에 아래쪽이 자꾸 이상한 느낌이 들어, 알고 있어?" <<He>>【이가】 미소 짓는다.`
			]>>
			<<if $player.penisExist>>
				<<run _flauntPool.push(`"네가 내 안에 들어와 줬으면 좋겠어," 뺨을 더 붉히며 <<he>>【이가】 미소 짓는다.`)>>
			<</if>>
			<<print _flauntPool.pluck()>>
		<</if>>
	<<elseif _robinMemory>>
		<<set $weekly.robinMemory to true>>
		<<runeventpool>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<He>>【이가】 말한다. "너 여러모로 바람둥이구나. (이 대사는 플레이스홀더이며 볼 수 없어야 합니다.)"
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
		<<if C.npc.Robin.dom gte 70>>
			<<print `<<He>>【이가】 당신의 $_sexToy【을를】 보고 킥킥거린다. "` + [`너랑 이거 예전부터 해보고 싶었어.`, `너무 야해... 계속해줘.`][random(0,1)] + `"`>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<print `<<He>>【이가】 당신의 $_sexToy【을를】 보며 얼굴을 붉힌다. "` + [`우와! 부끄럽지도 않아?`, `천천히 해, 알았지?`][random(0,1)] + `"`>>
		<<else>>
			<<print `<<He>>【이가】 당신의 $_sexToy【을를】 보고 킥킥거린다. "` + [`네가 거길 만지고 있다니 믿기지가 않아.`, `너무 야해... 계속해줘.`][random(0,1)] + `"`>>
		<</if>>
	<<elseif $speechwheeze is 1>>
		<<if C.npc.Robin.dom gte 70>>
			<<print either(
				`<<He>>【이가】 미소 짓는다. "너무 버거워? 하지만 들리는 소리가 너무 좋은걸!"`,
				`"어라? 무슨 말이라도 하려고?" 짓궂은 미소를 지으며 <<he>>【이가】 묻는다.`
			)>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<print either(
				`<<He>>【은는】 <<= either("말을 더듬는다","더듬거린다","당황한다")>>. "미, 미안해! 내가 너무 거칠어?"`,
				`<<He>>【은는】 불안한 표정을 짓는다. "<<= either("멈춰줬으면 좋겠으면 말해줘","계속해도 될까? 아프게 하고 싶지 않아")>>."`
			)>>
		<<else>>
			<<print either(
				`"방금 뭐라고 했어?" 로빈이 당신 쪽으로 귀를 기울인다.`,
				`"지금 진짜로 말할 여유가 있는 거야?" 놀리는 듯한 미소를 띠며 <<he>>【이가】 말한다.`
			)>>
		<</if>>
	<<elseif $speechapologise is 1>>
		<<if C.npc.Robin.dom gte 70>>
			<<if $panicviolenceRecent and C.npc.Robin.trauma gte 20>>
				"괜찮아. 우리 같이 이겨낼 수 있어," <<he>>【이가】 당신을 향해 미소 짓는다.
			<<elseif $panicviolenceRecent>>
				"신경 쓰지 마. 그동안 정말 많이 힘들었잖아," 다정한 미소를 띠며 <<he>>【이가】 말한다.
			<<else>>
				<<He>>【은는】 잠시 머뭇거리더니 미소를 짓는다. "용서해 줄게. 그래도 다음부턴 그러지 마, 알겠지?"
			<</if>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<if $panicviolenceRecent and C.npc.Robin.trauma gte 20>>
				<<He>>【이가】 가쁘게 숨을 내쉰다. "나... 이해해. 괜찮아. 곁에 있어 줄게."
			<<elseif $panicviolenceRecent>>
				"괘, 괜찮아? 우리 그만둘까?" <<He>>【은는】 불안해 보인다.
			<<else>>
				<<He>>【은는】 당신을 빤히 바라보더니 가볍게 웃음을 터뜨린다. "아, 그냥 장난친 거였어? 그럼 됐어, 화 안 났어."
			<</if>>
		<<else>>
			<<if $panicviolenceRecent and C.npc.Robin.trauma gte 20>>
				"괜찮아. 네가 어떤 상태인지 다 이해해. 사과하지 않아도 돼." <<He>>【이가】 당신을 향해 부드럽게 미소 짓는다.
			<<elseif $panicviolenceRecent>>
				<<He>>【은는】 걱정스러운 표정을 짓는다. "자꾸 걱정되잖아. 정말 괜찮은 거 맞아?"
			<<else>>
				"괜찮아! 그렇게 화나지도 않았어." <<He>>【이가】 미소 짓는다.
			<</if>>
		<</if>>
	<<elseif $speechapologiseno is 1>>
		<<if C.npc.Robin.dom gte 70>>
			<<if $panicviolenceRecent>>
				"걱정 마, 이 정돈 감당할 수 있어," <<he>>【이가】 당신을 안심시킨다.
			<<else>>
				"으, 그만해!" 로빈이 입술을 삐죽이지만, 진심으로 화를 내는 건 아니다.
			<</if>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<if $panicviolenceRecent>>
				아픔에도 불구하고, <<he>>【은는】 애써 부드러운 미소를 지어 보인다.
			<<else>>
				어떻게 반응해야 할지 몰라, <<he>>【은는】 어색하게 미소 짓는다.
			<</if>>
		<<else>>
			<<if $panicviolenceRecent>>
				"괜찮으니까 그냥 다 털어내," <<he>>【이가】 말한다. "내가 다 보살펴 줄게."
			<<else>>
				<<He>>【은는】 한쪽 눈썹을 치켜올리며 쿡쿡 웃는다.
			<</if>>
		<</if>>
	<<elseif $speechaskrough is 1>>
		<<if C.npc.Robin.dom gte 70>>
			<<print either(
				`"네가 그렇게까지 원한다면, 내 실력을 제대로 보여줘야겠네!"`,
				`"알았어. 너무 버거우면 꼭 말해줘야 해, 알겠지?" <<He>>【이가】 당신을 보며 미소 짓는다.`
			)>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<print either(
				`<<His>> 두 눈이 커진다. "왜, 왜 그렇게 하고 싶은 거야?"`,
				`<<He>>【은는】 불안한 표정을 짓는다. "널 아프게 하고 싶지 않은데..."`
			)>>
		<<else>>
			<<print either(
				`<<He>>【이가】 말한다. "더 거칠게 해달라고? 미안해, 지금도 나로선 최대한 거칠게 하고 있는 건데."`,
				`"정말 괜찮겠어? 해볼 수는 있겠지만, 그래도..." <<He>>【은는】 망설이는 눈빛으로 당신을 쳐다본다.`
			)>>
		<</if>>
	<<elseif $speechmoan is 1>>
		<<if isLoveInterest("Robin") and ($speechspecialdialogue is "robin_moan_dom" or $speechspecialdialogue is "robin_moan_default")>>
			<<switch $speechspecialdialogue>>
				<<case "robin_moan_dom">>
					<<if C.npc.Robin.trauma gte 20>>
						<<He>>【이가】 숨을 헐떡인다. "나한텐 오직 너만이 소중하니까."
						<<set _moanHeal to true>>
					<<else>>
						<<print either(
							`<<He>>【이가】 키득거린다. "널 위해서라면 뭐든지."`,
							`<<He>>【은는】 자랑스러움과 기쁨으로 얼굴을 활짝 밝히며 미소 짓는다.`
						)>>
					<</if>>
				<<case "robin_moan_default">>
					<<if C.npc.Robin.trauma gte 60>>
						<<His>> 눈가가 촉촉해진다. "나도 네가 내 곁에 있어줘서 정말 기뻐."
						<<set _moanHeal to true>>
					<<elseif C.npc.Robin.trauma gte 20>>
						<<He>>【이가】 메마른 웃음을 터뜨린다. "저, 정말 그래? 너 덕분에 나도 정말 행복해."
						<<set _moanHeal to true>>
					<<elseif C.npc.Robin.dom lte 30>>
						"나, 나도 너 때문에 행복해," 양 볼을 붉히며 <<he>>【이가】 말한다.
					<<else>>
						"어휴. 완전히 녹아내려 웅덩이가 돼도 어디 안 휩쓸려가게 꽉 잡아줄게," <<he>>【이가】 쿡쿡 웃는다.
					<</if>>
			<</switch>>
			<<set _moanDom to true>>
		<<elseif C.npc.Robin.dom gte 70>>
			<<print either(
				`<<He>>【이가】 미소 짓는다. "더 들려줘," <<he>>【이가】 당신에게 맞추어 신음한다.`,
				`<<He>>【이가】 키득거린다. "계속해 봐. 그 소리 듣는 거 너무 좋아."`,
				`흥분으로 눈을 반짝이며 <<he>>【이가】 당신에게 맞추어 신음한다.`
			)>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<if C.npc.Robin.trauma gte 80>>
				"제발," <<his>> 목소리가 갈라진다. "너 없인 난 아무것도 아니야."
				<<set _moanHeal to true>>
			<<elseif C.npc.Robin.trauma gte 40>>
				<<He>>【이가】 거칠게 숨을 내쉬며 멍한 표정 사이로 간신히 옅은 미소를 짓는다.
				<<set _moanHeal to true>>
			<<elseif C.npc.Robin.trauma gte 20>>
				"그건..." 시선을 피하며 <<he>>【은는】 제대로 말을 잇지 못한다.
				<<set _moanHeal to true>>
			<<else>>
				<<print either(
					`<<His>> 뺨과 귀가 빨개진다. "그런 말을 하다니 믿기지 않아!"`,
					`<<He>>【이가】 키득거린다. "너무 야하게 들려."`,
					`<<He>>【이가】 어색하게 웃는다. "그, 그런 말을 하면서 안 부끄러워?"`
				)>>
			<</if>>
		<<else>>
			<<if C.npc.Robin.trauma gte 80>>
				"제발," <<he>>【이가】 숨을 헐떡인다. "너 없인 난 아무것도 아니야."
				<<set _moanHeal to true>>
			<<elseif C.npc.Robin.trauma gte 40>>
				<<He>>【이가】 부드럽게 웃는다. "너도 참 대단해," <<he>>【이가】 말한다.
				<<set _moanHeal to true>>
			<<elseif C.npc.Robin.trauma gte 20>>
				<<He>>【이가】 부드럽게 키득거린다. "너 진짜 멋진 거 알아?"
				<<set _moanHeal to true>>
			<<else>>
				<<print either(
					`뺨과 귀를 붉히며 <<he>>【의】 얼굴에 미소가 번진다.`,
					`<<He>>【이가】 쿡쿡 웃는다. "말솜씨 하나는 정말 좋다니까," <<he>>【이가】 말한다.`
				)>>
			<</if>>
		<</if>>
		<<if _moanDom and !$robinUniqueComments.includes("moanDom")>>
			<<set $robinUniqueComments.pushUnique("moanDom")>>
			<<npcincr Robin dom 1>><<gdom>>
		<</if>>
		<<if _moanHeal and !$robinUniqueComments.includes("moanHeal")>>
			<<set $robinUniqueComments.pushUnique("moanHeal")>>
			<<npcincr Robin trauma -1>><<lrtrauma>>
		<</if>>
	<<elseif $speechvagina is 1 and $player.virginity.vaginal is true>>
		<<if C.npc.Robin.dom gte 70>>
			"어라! 아직 처녀였을 줄은 몰랐어!" <<His>> 손가락이 당신의 처녀막에 닿는다. "조심해서 해볼게!"
		<<else>>
			"내가 잘하고 있어?" 처녀막을 손가락으로 콕콕 찌르며 <<he>>【이가】 걱정스러운 표정으로 당신을 바라본다. "거길 아프게 하고 싶지 않아."
		<</if>>
	<<elseif $speechheadsuckle is 1>>
		<<rng>>
		<<if C.npc.Robin.trauma gte 20 and $rng gte 67>>
			<<print either(
				`"다른 사람한텐 절대 이런 짓 못 하게 할 거야," <<he>>【이가】 만족스럽게 한숨을 내쉰다. "오직 너한테만."`,
				`"그동안 온갖 일이 다 있었는데도... 내 모유가 아직 괜찮았으면 좋겠어..." <<He>>【이가】 간신히 옅은 미소를 지어 보인다.`
			)>>
		<<elseif $robinSeen.includes("forestMilking") and $rng gte 34>>
			<<print either(
				`"소풍 때 있었던 일 때문에 이러는 거야?" <<He>>【이가】 <<= either("묻는다","쿡쿡 웃는다")>>.`,
				`"소풍 때 내 모유를 마시고 싶어 했던 게 이런 이유였구나..." <<He>>【은는】 곰곰이 생각한다. "생각보다 느낌이 꽤 좋아..."`
			)>>
		<<elseif C.npc.Robin.dom gte 70>>
			<<print either(
				`"이건 아기를 위해 남겨둬야 하는 거 아니야?" <<He>>【이가】 쿡쿡 웃는다. "우리 아기랑 경쟁하고 싶진 않은데."`,
				`"네가 너무 맛있게 먹으니까, 내 핫초코 가판대에서도 내 모유를 써야 하나 고민되기 시작하네," <<he>>【이가】 <<= either("쿡쿡 웃는다","히죽 웃는다")>>. <<if !$robinUniqueComments.includes("suckleDom")>><<set $robinUniqueComments.pushUnique("suckleDom")>><<npcincr Robin dom 1>><<gdom>><</if>>`
			)>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<print either(
				`"난 상관없는데..." <<He>>【이가】 중얼거린다.`,
				`"그건 아기 먹을 거 아니야?" 머뭇거리며 <<he>>【이가】 묻는다.`
			)>>
		<<else>>
			<<print either(
				`"진짜로 아기 먹을 건 안 남겨둬도 괜찮은 거야?" <<He>>【이가】 <<= either("묻는다","쿡쿡 웃는다","키득거린다")>>.`,
				`"내가 정말 그렇게 맛있어?" <<He>>【이가】 <<= either("키득거린다","쿡쿡 웃는다","미소 짓는다")>>. "<<= either("아기 먹을 것도 좀 남겨둬, 알겠지?","우리 아기한테도 필요하다는 거 잊으면 안 돼.")>>"`
			)>>
		<</if>>
	<<elseif $speechheadnipple is 1>>
		<<if C.npc.Robin.dom gte 70>>
			<<if currentSkillValue("oralskill") gte 400>>
				<<print either(
					`"네 입안이 따뜻해서 정말 기분 좋아!" <<he>>【이가】 <<= either("신음한다","쿡쿡 웃는다","키득거린다")>>.`,
					`"제발 멈추지 마," <<he>>【이가】 신음한다. "네가 그렇게 해주는 거 너무 좋아."`
				)>>
			<<else>>
				<<print either(
					`"나의 영웅도 나처럼 가끔은 서툴 때가 있구나," <<he>>【이가】 <<= either("쿡쿡 웃는다","키득거린다","당신을 놀린다")>>. <<if !$robinUniqueComments.includes("nippleDom")>><<set $robinUniqueComments.pushUnique("nippleDom")>><<npcincr Robin dom 1>><<gdom>><</if>>`,
					`"계속 물고 있어도 아무것도 안 나올 텐데!" 로빈이 입술을 삐죽거리더니, 이내 <<= either("키득거린다","쿡쿡 웃는다")>>.`
				)>>
			<</if>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<if currentSkillValue("oralskill") gte 400>>
				<<print either(
					`"기, 기분 좋아," <<he>>【이가】 중얼거린다.`,
					`"이거 왠지... 왠지 조금 부끄러운 느낌이야," 양 볼을 붉히며 <<he>>【이가】 털어놓는다.`
				)>>
			<<else>>
				<<print either(
					`복잡한 표정 속에서도 <<his>> 뺨은 여전히 붉게 물들어 있다.`,
					`"너 때문에 부끄러워지잖아," <<he>>【이가】 <<= either("중얼거린다","속삭인다","수줍게 미소 짓는다")>>.`
				)>>
			<</if>>
		<<else>>
			<<if currentSkillValue("oralskill") gte 400>>
				<<print either(
					`쾌감에 젖어 한숨을 내쉬며 <<he>>【이가】 미소 짓는다.`,
					`"오늘따라 유난히 살갑네." <<He>>【이가】 <<= either("키득거린다","쿡쿡 웃는다","미소 짓는다")>>.`
				)>>
			<<else>>
				<<print either(
					`<<He>>【이가】 <<= either("숨을 헉 들이켠다","쿡쿡 웃는다","키득거린다")>>. "간지러워!"`,
					`"겨우 그거밖에 안 할 거야?" <<he>>【이가】 <<= either("쿡쿡 웃는다","키득거린다","당신을 놀린다")>>.`
				)>>
			<</if>>
		<</if>>
	<<elseif $speechvaginavagina is 1 and C.npc.Robin.dom gte 70 and $fame.sex gte 600>>
		"그래서... 내 건 몇 번째쯤 되는 것 같아?" <<He>>【이가】 미소 짓는다.
	<<elseif $speechanallick is 1 and C.npc.Robin.dom lte 30>>
		<<print either(
			`"조금 간지러운 느낌이야!" <<He>>【이가】 <<= either("키득거린다", "미소 짓는다", "쿡쿡 웃는다")>>.`,
			`"이거 왠지 좀 부끄러운 느낌인데," <<he>>【이가】 <<= either("숨을 헐떡인다", "놀란 듯 말한다")>>.`
		)>>
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>
