							<<case 5>> "끝내지도 않고 날 흥분시키는 건 잔인한 짓이지."
							<<default>> "넌 강한 새끼를 갖게 될 거다."
						<</switch>>
					<</if>>
				<<else>>
					<<if $NPCList[_n].type is "wolfgirl" or $NPCList[_n].type is "wolfboy">>
						<<switch $npcspeechcycle>>
