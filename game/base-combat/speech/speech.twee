<<widget "clothesspeech">>
	<<rng>>
	<<if $rng gte 81>>
		<<rng>>
		<<if !$worn.upper.type.includes("naked")>>
			<<He>>【은는】 당신의 $worn.upper.name【을를】 살펴본다.
			<<switch $worn.upper.name>>
				<<case "sundress">>
					<<switch random(1,3)>>
						<<case 1>> "정말 귀엽고 작은 드레스네."
						<<case 2>> "네 드레스 마음에 들어."
						<<case 3>> "정말 귀엽고 순수해 보여."
					<</switch>>
				<<case "evening gown">>
					<<if $enemyanger gte 20>>
						"비싼 창녀처럼 생겼네."
					<<else>>
						"우아한걸."
					<</if>>
				<<case "ballgown">>
					<<switch random(1,3)>>
						<<case 1>> "아름다워."
						<<case 2>> "누군가의 댄스 파트너를 빼앗은 것 같네."
						<<case 3>> "네 옷을 더럽히는 게 조금 미안해질 정도야."
					<</switch>>
				<<case "kimono" "mini kimono">>
					<<switch random(1,3)>>
						<<case 1>> "참 이국적이네."
						<<case 2>> "이건 어디서 났어?"
						<<case 3>> "날 위해서 차려입기까지 했군."
					<</switch>>
				<<case "maid dress">>
					<<switch random(1,3)>>
						<<case 1>> "네 <<master>>【을를】 위해 봉사할 시간이야."
						<<case 2>> "이제 내가 네 <<master>>【이】야."
						<<case 3>> "날 <<master>>라고 불러."
					<</switch>>
				<<case "nun's habit">>
					<<if $enemyanger gte 20>>
						<<switch random(1,3)>>
							<<case 1>> "정숙해 보이려고? 아무도 안 속아, 걸레년아."
							<<case 2>> "그게 널 지켜줄 것 같아?"
							<<case 3>> "경건한 계집일수록 유린하는 재미가 쏠쏠하지."
						<</switch>>
					<<else>>
						"수녀를 박아보는 게 소원이었지."
					<</if>>
				<<case "pyjama shirt">>
					<<if $rng gte 71 and $location isnot "home">>
						"누군가 오늘 아침에 옷 입는 걸 깜빡한 모양이네."
					<<elseif $rng gte 41>>
						"전혀 안 어울려."
					<<else>>
						"자신을 너무 과소평가하지 마."
					<</if>>
				<<case "t-shirt">>
					"그 셔츠는 네 귀여운 몸을 가리는 데 아주 서투르네."
				<<case "school shirt">>
					<<if ["Sirris","River","Doren","Winter","Mason","Leighton"].includes($NPCList[_n].fullDescription)>>
						<<if $location is "school">>
							"그래도 복장 규정은 지키고 있네."
						<<else>>
							"아직도 배울 열정이 남아있어?"
						<</if>>
					<<elseif $NPCList[_n].teen is 1>>
						<<switch random(1,4)>>
							<<case 1>> "교복이 잘 어울리네."
							<<case 2>> "이런 걸 입게 만드는 게 짜증나."
							<<case 3>> "선생님이라고 불러."
							<<case 4>> "너한테 가르쳐줄 게 아주 많아."
						<</switch>>
					<<else>>
						<<switch random(1,4)>>
							<<case 1>> "학생을 박아보는 게 소원이었지."
							<<case 2>> "아직도 학교에 다니는구나."
							<<case 3>> "선생님이라고 불러."
							<<case 4>> "너한테 가르쳐줄 게 아주 많아."
						<</switch>>
					<</if>>
				<<case "tank top">>
					<<switch random(1,2)>>
						<<case 1>> "걸레들만 탱크톱을 입지."
						<<case 2>> "네 가슴이 아주 잘 드러나는군."
					<</switch>>
				<<case "tuxedo jacket">>
					<<if $enemyanger gte 20>>
						"어디 근사한 데 가던 길이었나 본데. 이제 나한테 붙잡혔어."
					<<elseif $player.gender_appearance is "f">>
						"남자애로 보이려고 하는 거야?"
					<<else>>
						"우아한걸."
					<</if>>
				<<case "babydoll lingerie">>
					<<if $enemyanger gte 20>>
