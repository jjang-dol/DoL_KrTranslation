:: Widgets Speech [widget]
<<widget "cumspeech">>
	<<rng>>
	<<He>>【이가】 말한다.
	<<if $player.gender_appearance is "m" or ($exposed gte 2 and $player.penisExist)>>
		<<if _deniedOrgasm and $speechorgasmnocumcount is 0>>
			<<set $speechorgasmnocumcount += 1>>
			<<if $enemyanger lte 100>>
				"방금 가려고 하지 않았어? 어떻게 된 거지?"
			<<else>>
				"좋아! 넌 갈 자격도 없어, 꼬맹아."
			<</if>>
		<<elseif _deniedOrgasm and $enemyanger gt 100>>
			<<switch random(1,3)>>
				<<case 1>> "왜 그래? 절정이 너무 아팠어? 건방진 꼬맹이에게 좋은 교훈이군."
				<<case 2>> "좋아! 네겐 딱 맞는 벌이야, 꼬맹아."
				<<case 3>> "우리가 좀 더 거칠게 다뤄주면 절정의 고통이 조금 더 견디기 쉬워질지도 모르겠는데."
			<</switch>>
		<<elseif ($orgasmcount gte 24 or $femaleclimax) and $speechorgasmnocumcount is 0>>
			<<set $speechorgasmnocumcount += 1>>
			"절정에 달했는데 아무것도 안 나오네! 도대체 몸이 어떻게 된 거야?"
		<<elseif $speechorgasmnocumcount gte 1>>
			<<if $speechorgasmrepeat is 0>>
				<<switch random(1,3)>>
					<<case 1>> "너무 짜여서 말라버린 거야, 아니면 원래 이렇게 한심했어?"
					<<case 2>> "가짜로 느끼는 척하는 게 아니길 바라."
					<<case 3>> "이렇게 찔끔 싸다니 수치스러운 줄 알아야지."
				<</switch>>
			<<else>>
				<<switch random(1,3)>>
					<<case 1>> "벌써 <<phim>>【을를】 다 써먹었나 본데."
					<<case 2>> "아직도 나오는 게 없다니. 실망스러운데."
					<<case 3>> "우리가 좀 더 거칠게 다루면 정액이 나오려나?"
				<</switch>>
			<</if>>
			<<set $speechorgasmrepeat += 1>>
		<<elseif $orgasmcount gte 18 and $speechorgasmweakcumcount is 0>>
			<<set $speechorgasmweakcumcount += 1>>
			"겨우 그 정도밖에 못 싸는 거야?"
		<<else>>
			<<if $speechorgasmrepeat is 0>>
				<<switch $speechorgasmcount>>
					<<case 1>> "싼다! 그거야, 조금도 참지 말고 다 쏟아내."
					<<case 2>> "아까보다 더 많이 싸고 있잖아! 부끄러움도 몰라?"
					<<case 3>> "숨기려 하지 마, 너도 정액을 쥐어짜이는 걸 좋아하잖아."
					<<case 4>> "네 소중한 자지 우유를 모조리 짜내."
					<<case 5>> "엄청나게 쌌네! 완전 난장판으로 만들고 있다는 거 알아?"
					<<default>> "이렇게 정액을 싸대다니, 대단하다고 해야 할지 아니면 너 대신 부끄러워해야 할지 모르겠네."
				<</switch>>
			<<else>>
				<<switch $speechorgasmcount>>
					<<case 1>> "<<pShe>>【이가】 정말로 싸고 있어!"
					<<case 2>> "또 싼다고? <<pShe>>【은는】 정말 천박하다니까!"
					<<case 3>> "<<pShe>>【이가】 또 싸네? 이거 끝내주는데!"
					<<case 4>> "이러다간 아주 한 방울도 안 남게 짜이겠어."
					<<case 5>> "나중에 쓸 수 있게 <<pher>> 정액 좀 남겨두고 싶어."
					<<default>> "저렇게 많이 쌌는데, 저 녀석 무사할까?"
				<</switch>>
			<</if>>
			<<set $speechorgasmrepeat += 1>>
		<</if>>
	<<else>> <!-- gender appearance is female and either the player does not have a dick or the npc is not aware of it -->
		<<if $speechmilk and $rng gte 71>>
			<<switch $speechmilk>>
				<<case 1>>"젖을 짜고 있어!"
				<<case 2>>"내가 먼저 입술을 대기 전까지 못 참은 거야?"
				<<default>>"세상에, 엄청나게 싸댔군."
			<</switch>>
		<<elseif $speechorgasmrepeat is 0>>
			<<switch $speechorgasmcount>>
				<<case 1>> "좋아할 줄 알았어, 네 경련은 거짓말을 못 하거든."
				<<case 2>> "이번 절정은 어때? 틀림없이 저번보다 더 기분 좋을걸."
				<<case 3>> "또 가는 거야? 정말 천박한 걸레라니까!"
				<<case 4>> "내가 이렇게 가버리게 해줬는데, 설마 나를 잊진 않겠지?"
				<<case 5>> "끊임없이 가버리다니, 너 진짜 대단한 걸레로구나!"
				<<default>> "<<girl>>【을를】 반복해서 가게 만드는 건 너무 재밌다니까."
			<</switch>>
		<<else>>
			<<switch $speechorgasmcount>>
				<<case 1>> "<<pShe>>【은는】 갈 때 아주 앙증맞게 경련을 일으킨다니까."
				<<case 2>> "<<pHer>> 보지가 완전히 질척질척하게 젖었어!"
				<<case 3>> "<<pShe>>【은는】 정말 민감하다니까."
				<<case 4>> "또 간다고? 최고잖아."
				<<case 5>> "또 가네! 정말 음탕한 <<bitch>>【아야】."
				<<default>> "조심해, 너무 많이 가게 하면 망가져 버릴지도 몰라."
			<</switch>>
		<</if>>
		<<set $speechorgasmrepeat += 1>>
	<</if>>
<</widget>>

