				`"그 창녀 같은 씹구멍 좀 그만 가려, 나도 언제까지고 점잖게 굴진 않을 거니까."`,
			][random(0,2)]>>
		<</if>>

	<<elseif $speechapologiseno is 1>>
		<<He>>【은는】 말한다.
		<<if $enemyanger lte 20>>
			<<print [
				`"쉿, 네 사과는 이미 받았어."`,
				`"정말 예의 바르기도 해라, 네가 반성하고 있는 건 이미 알고 있단다."`,
				`"네가 미안해하는 건 알고 있으니, 걱정하지 마."`,
			][random(0,2)]>>
		<<elseif $enemyanger lte 100>>
			<<print [
				`"처음 말할 때 벌써 들었다고."`,
				`"징징대지 마."`,
				`"쉿, <<girl>>."`,
			][random(0,2)]>>
		<<else>>
			<<print [
				`"입 닥쳐, <<bitch>>."`,
				`"네 목구멍에 쑤셔 넣어버리기 전에 입 다물어."`,
				`"내가 입 놀려도 좋다고 허락했나, 이 <<slut>>【아야】?"`,
			][random(0,2)]>>
		<</if>>

	<<elseif $speechapologiseunforgiving is 1>>
		<<He>>【은는】 말한다.
		<<print [
			`"입 닥쳐, <<bitch>>."`,
			`"네 목구멍에 쑤셔 넣어버리기 전에 입 다물어."`,
			`"내가 입 놀려도 좋다고 허락했나, 이 <<slut>>【아야】?"`,
		][random(0,2)]>>

	<<elseif $speechfacesit is 1>>
		<<if (($enemyarousal / $enemyarousalmax) * 100) gte 70>>
			<<if (($enemyanger / $enemyangermax) * 100) gte 10>>
				<<print [
					`<<He>>【은는】 말한다. "그래, 삼켜버려라, <<girl>>!"`,
					`<<He>>【은는】 말한다. "네 그 쓸모없는 쌍판에 잔뜩 싸질러 버릴 거다!"`,
					`<<He>>【은는】 말한다. "다 들이마시지 않으면 내 체액에 익사시켜 주마!"`,
				][random(0,2)]>>
			<<else>>
				<<print [
					`<<He>>【은는】 신음한다. "그래! 계속 혀를 놀려보라고!"`,
					`<<He>>【은는】 쾌감에 취해 있다. "흐음, 기분 정말 최고야!"`,
					`<<He>>【은는】 한숨을 쉰다. "이제 얼마 안 남았어..."`,
				][random(0,2)]>>
			<</if>>
		<<else>>
			<<if (($enemyanger / $enemyangermax) * 100) gte 10>>
				<<print [
					`<<He>>【은는】 말한다. "혀를 더 부지런히 놀려라, <<girl>>!"`,
					`<<He>>【은는】 말한다. "네가 기절할 때까지 이대로 깔고 앉아 있을까 보다!"`,
					`<<He>>【은는】 말한다. "네 얼굴에 싸기 전까진 안 비켜줄 거다."`,
				][random(0,2)]>>
			<<else>>
				<<print [
					`<<He>>【은는】 말한다. "네 입으로 기분 좋게 해 봐."`,
					`<<He>>【은는】 말한다. "내가 얼굴에 깔고 앉는 게 좋아?"`,
					`<<He>>【은는】 말한다. "맛이 어때?"`,
				][random(0,2)]>>
			<</if>>
		<</if>>

	<<elseif $speechanallick is 1>>
		<<if (($enemyarousal / $enemyarousalmax) * 100) gte 70>>
			<<print [
				`<<He>>【은는】 신음한다. "그래! 계속 혀를 놀려보라고!"`,
				`<<He>>【은는】 쾌감에 취해 있다. "흐음, 내 엉덩이를 핥아대는 네 혀놀림이 기가 막히는군!"`,
				`<<He>>【은는】 한숨을 쉰다. "네가 내 엉덩이를 계속 핥아대니 가버릴 것 같아..."`,
			][random(0,2)]>>
		<<elseif (($enemyanger / $enemyangermax) * 100) gte 10>>
			<<print [
				`<<He>>【은는】 말한다. "그래, <<girl>>, 혀를 잘 굴려서 내 항문이나 핥으라고!"`,
				`<<He>>【은는】 말한다. "착한 <<girl>>【이】야. 내 항문을 아주 깨끗하게 핥으렴."`,
				`<<He>>【은는】 다정하게 속삭인다. "나쁘지 않은걸, 이 창녀야. 계속 핥아대!"`,
			][random(0,2)]>>
		<<else>>
			<<print [
				`<<He>>【은는】 말한다. "내 항문을 파고드는 네 혀의 감촉이 너무 좋네."`,
				`<<He>>【은는】 말한다. "내 엉덩이 핥는 걸 퍽 마음에 들어 하는 거 같은데, 안 그래?"`,
				`<<He>>【은는】 말한다. "그래! 거길 헤집는 네 혀가 정말 최고야."`,
			][random(0,2)]>>
		<</if>>

	<<elseif $speechanalkiss is 1>>
		<<if (($enemyanger / $enemyangermax) * 100) gte 10>>
			<<print [
				"<<He>>【은는】 말한다. \"항문에 입이나 맞추는 것. 그게 네 진짜 주제지.\"",
				"<<He>>【은는】 말한다. \"착한 걸레년, 계속 그 엉덩이에 입 맞춰.\"",
				"<<He>>【은는】 다정하게 속삭인다. \"오오, 엉덩이에 입술을 아주 야무지게 부비는구나!\""
			][random(0,2)]>>
		<<else>>
			<<print [
				"<<He>>【은는】 말한다. \"내 엉덩이에 입 맞추는 거, 마음에 들지?\"",
				"<<He>>【은는】 말한다. \"흐음. 아주 기분 좋은데. 내 엉덩이에 계속 입술을 맞춰봐.\"",
				"<<He>>【은는】 말한다. \"내 엉덩이에 닿는 네 입술 감촉이 아주 끝내주네.\""
			][random(0,2)]>>
		<</if>>

	<<elseif $speechmouthotheranus is 1>>
		<<if (($enemyanger / $enemyangermax) * 100) gte 10>>
			<<print [
				"<<He>>【은는】 말한다. \"내 엉덩이에 입이나 맞춰!\"",
				"<<He>>【은는】 말한다. \"내 엉덩이나 핥아라, 이 <<bitch>>【아야】!\"",
				"<<He>>【은는】 말한다. \"네 자리는 바로 거기서 내 항문이나 숭배하는 거야, 이 창녀야.\"",
				"<<He>>【은는】 말한다. \"입을 좀 바쁘게 놀려 봐! 내 엉덩이를 아주 기분 좋게 만들어달란 말이야.\"",
				"<<He>>【은는】 말한다. \"내 엉덩이 맛이 어때?\""
			][random(0,4)]>>
		<<else>>
			<<print [
				"<<He>>【은는】 말한다. \"네 얼굴을 깔아뭉개는 내 엉덩이가 마음에 들어?\"",
				"<<He>>【은는】 말한다. \"네 입으로 내 항문을 아주 만족시켜 보란 말이야.\"",
				"<<He>>【은는】 말한다. \"계속해, 내 엉덩이에 잘 봉사해 봐.\"",
				"<<He>>【은는】 말한다. \"네가 내 엉덩이를 떠받들듯 숭배했으면 좋겠어.\"",
				"<<He>>【은는】 말한다. \"네 그 천박한 입으로, 내 엉덩이에 온갖 짓을 다 해보라고.\""
			][random(0,4)]>>
		<</if>>
	<<elseif $speechaskrough is 1>>
		<<if (($enemyanger / $enemyangermax) * 100) gte 10>>
			<<print [
				"<<He>>【은는】 말한다. \"좀 더 거친 걸 원해? 정 원한다면야, 이 창녀년아.\"",
				"<<He>>【은는】 말한다. \"네가 얼마나 가치 없는 창녀인지 똑똑히 알게 해 주지.\"",
				"<<He>>【은는】 말한다. \"맞을 짓을 했으니 신나게 두들겨 패 주마.\"",
				"<<He>>【은는】 말한다. \"네가 기절할 때까지 얼마나 더 세게 팰 수 있을지 궁금한데.\"",
				"<<He>>【은는】 말한다. \"이제 겨우 시작일 뿐이야, <<bitch>>.\""
			][random(0,4)]>>
		<<else>>
			<<print [
				"<<He>>【은는】 말한다. \"더 거칠게 해 달라고? 취향 한 번 변태 같네.\"",
				"<<He>>【은는】 말한다. \"거친 걸 원한다고? 아주 제대로 거칠게 다뤄주지.\"",
				"<<He>>【은는】 말한다. \"너한테 딱 어울리는 방식으로 대우해주마, 이 창녀야.\"",
				"<<He>>【은는】 말한다. \"지금까진 널 너무 부드럽게 대해줬어.\"",
				"<<He>>【은는】 말한다. \"하! 창녀가 험하게 굴려지길 바란다니. 얼마든지 환영이지.\""
			][random(0,4)]>>
		<</if>>
	<<else>>
		<<if not $gloryhole>>
			<<basespeech>>
		<<else>>
			<<basegloryholespeech>>
		<</if>>
	<</if>>
<</widget>>

<<widget "basespeech">>
	<<if $enemyanger lte 20 or _args[0] is "low">>
		<<rng>>
		<<He>>【이가】 속삭인다.
		<<if $rng lte 5>>
			"넌 정말 아름다워."
		<<elseif $rng lte 10>>
			"넌 정말 아주 예쁘구나."
		<<elseif $rng lte 15>>
			"넌 참 아름다운 <<girl>> 같네."
		<<elseif $rng lte 20>>
			"분명 시선을 많이 끌겠는걸."
		<<elseif $rng lte 25>>
			"넌 아주 귀여워."
		<<elseif $rng lte 30>>
			"넌 너무 사랑스러워."
		<<elseif $rng lte 35 and $consensual is 0>>
			"착한 <<girl>>답게 굴면 해치지 않을게."
		<<elseif $rng lte 40>>
			"착한 <<girl>>답게 굴면 기분 좋게 해줄게."
		<<elseif $rng lte 45>>
			"날 기분 좋게 해주면, 너도 기분 좋게 해줄게."
		<<elseif $rng lte 50>>
			"네 피부 정말 매끄럽네."
		<<elseif $rng lte 55>>
			"네 온몸에 키스하고 싶어."
		<<elseif $rng lte 60>>
			"넌 연약한 아이구나, 그렇지?"
		<<elseif $rng lte 65>>
			"넌 정말 훌륭해."
		<<elseif $rng lte 70>>
			"네 몸은 정말 매력적이야."
		<<elseif $rng lte 75>>
			"네 몸을 부끄러워하지 마."
		<<elseif $rng lte 80>>
			"넌 아주 연약해 보여."
		<<elseif $rng lte 85>>
			"넌 천사 같구나."
		<<elseif $rng lte 90 and !$gloryhole>>
			"네 <<breasts>>【은는】 정말 귀엽네."
		<<elseif $rng lte 95>>
			"좋은 냄새가 나네."
		<<elseif $rng lte 100>>
			"넌 정말 귀여운 <<girl>> 같아."
		<</if>>
	<<elseif ($enemyanger lte 100 and _args[0] isnot "low") or _args[0] is "mid">>
		<<rng>>
		<<He>>【이가】 당신을 엄격하게 쳐다본다.
		<<if $rng lte 5>>
			"내 인내심을 시험하지 마."
		<<elseif $rng lte 10>>
			"나쁜 걸레년은 다치는 법이지."
		<<elseif $rng lte 15>>
			"너는 나쁜 <<girl>>【이가】 아니겠지, 그렇지?"
		<<elseif $rng lte 20>>
			"내가 널 다치게 하지 않을 거라 생각하지 마."
		<<elseif $rng lte 25>>
			"존나 섹시하네."
		<<elseif $rng lte 30>>
			"네가 얼마나 버틸 수 있을지 궁금하군."
		<<elseif $rng lte 35>>
			"이왕 벌어지는 일이니, 그냥 편하게 받아들이는 게 좋을 텐데."
		<<elseif $rng lte 40>>
			"착한 <<girl>>답게 굴면 한결 수월해질 거다."
		<<elseif $rng lte 45>>
			"네 몸을 가지고 재미 좀 봐야겠어."
		<<elseif $rng lte 50>>
			"내게 반항하지 마."
		<<elseif $rng lte 55>>
			"넌 이러기 위해 태어난 거야."
		<<elseif $rng lte 60>>
			"네가 즐기고 있다는 거 다 알아."
		<<elseif $rng lte 65>>
			"이게 다 네 탓이라는 건 알지."
		<<elseif $rng lte 70>>
			"너 이거 좋아하잖아, 안 그래."
		<<elseif $rng lte 75>>
			"넌 지금 살얼음판을 걷고 있어, <<girl>>."
		<<elseif $rng lte 80>>
			"이게 내 밑바닥일 거라 착각하지 마."
		<<elseif $rng lte 85>>
			"이제 넌 내 소유야."
		<<elseif $rng lte 90>>
			"내가 끝이라고 할 때까지 안 끝나."
		<<elseif $rng lte 95>>
			"넌 재미있는 장난감이지만, 딴생각은 품지 마."
		<<elseif $rng lte 100>>
			"너보다 잘난 사람을 존경으로 대해야지."
		<</if>>
	<<elseif ($enemyanger gt 100 and !_args[0]) or _args[0] is "high">>
		<<rng>>
		<<He>>【이가】 분노로 당신을 노려본다.
		<<if $rng lte 5>>
			"씨발 창녀년."
		<<elseif $rng lte 10>>
			"넌 그저 더러운 <<slut>>일 뿐이야."
		<<elseif $rng lte 15>>
			"넌 정액받이 통이야, 그 이상도 이하도 아니지."
		<<elseif $rng lte 20>>
			"너같이 쓸모없는 쓰레기 새끼한테 관심을 가져주는 사람이 있다는 걸 기뻐해야지."
		<<elseif $rng lte 25>>
			"내가 아직 널 죽이지 않은 것에 감사해야 할 거다."
		<<elseif $rng lte 30>>
			"아주 다양한 방법으로 널 부숴버릴 거야."
		<<elseif $rng lte 35>>
			"내 일이 끝나기 전까지 내게 예의를 표하게 될 거다."
		<<elseif $rng lte 40>>
			"볼일이 끝나면 널 어디다 내다 버릴까 고민되네."
		<<elseif $rng lte 45>>
			"너 같은 <<bitch>>한텐 강간도 사치지."
		<<elseif $rng lte 50>>
			"넌 꼴좋게 당해도 싸, <<bitch>>."
		<<elseif $rng lte 55>>
			"이런 취급 받는 걸 즐기잖아. 부정하려 들지 마."
		<<elseif $rng lte 60>>
			"넌 쓸모없는 육변기에 불과해."
		<<elseif $rng lte 65>>
			"쓸모없는 쓰레기치고는 꽤 예쁘장하게 생겼네."
		<<elseif $rng lte 70>>
			"나를 가버리게 하는 게 네 유일한 목적이라는 걸 잊지 마."
		<<elseif $rng lte 75>>
			"너도 이걸 좋아한다는 거 다 알아, 이 멍청한 <<slut>>."
		<<elseif $rng lte 80>>
			"넌 이것보다 훨씬 끔찍한 꼴을 당해야 해, 창녀야."
		<<elseif $rng lte 85>>
			"넌 가치 없는 <<slut>>【이】야."
		<<elseif $rng lte 90>>
			"널 다치게 할 거고, 넌 그걸 좋아하게 될 거다."
		<<elseif $rng lte 95>>
			"너 같은 <<girl>>【은는】 단 하나의 쓸모밖에 없어."
		<<elseif $rng lte 100>>
			"넌 정말 형편없는 걸레년이구나."
		<</if>>
	<</if>>
<</widget>>

<<widget "basegloryholespeech">>
	<<if $enemyanger lte 20 or _args[0] is "low">>
		<<rng>>
		<<He>>【이가】 속삭인다.
		<<if $rng lte 5>>
			"네 얼굴을 볼 수 있으면 좋을 텐데."
		<<elseif $rng lte 10>>
			"틀림없이 넌 아주 예쁠 거야."
		<<elseif $rng lte 15>>
			"반대편에 있는 <<girl>>【을를】 볼 수 있으면 좋을 텐데."
		<<elseif $rng lte 20>>
			"너는 남자애야, 아니면 여자애야? 모른다는 게 너무 흥분되네."
		<<elseif $rng lte 25>>
			"넌 분명 귀엽겠지. 정말 널 보고 싶어."
		<<elseif $rng lte 30>>
			"누가 날 기쁘게 해 주는지 볼 수 없다는 건 흥분되는군."
		<<elseif $rng lte 35>>
			"착한 <<girl>>답게, 네가 가진 걸 전부 보여줘 봐."
		<<elseif $rng lte 40>>
			"착한 <<girl>>답게 굴어, 그럼 기분이 좋아질 테니까."
		<<elseif $rng lte 45>>
			"날 기분 좋게 만들면, 너도 기분 좋아질 거야."
		<<elseif $rng lte 50>>
			"널 만질 수 있다면 좋을 텐데."
		<<elseif $rng lte 55>>
			"네 온몸에 키스하고 싶어."
		<<elseif $rng lte 60>>
			"이 벽만 가로막고 있지 않았다면 너한테 무슨 짓을 했을지 몰라."
		<<elseif $rng lte 65>>
			"넌 내게 끝내주는 짓을 하고 있어."
		<<elseif $rng lte 70>>
			"내가 네 몸을 어루만질 수만 있다면."
		<<elseif $rng lte 75>>
			"네 몸을 볼 수 있다면 좋겠어."
		<<elseif $rng lte 80>>
			"이 벽이 없었으면 좋았을 텐데."
		<<elseif $rng lte 85>>
			"이 반대편에 누가 있을까 궁금하네."
		<<elseif $rng lte 90>>
			"아주 잘하고 있어."
		<<elseif $rng lte 95>>
			"네가 어떻게 생겼을지 궁금해."
		<<elseif $rng lte 100>>
			"넌 정말이지 착한 <<girl>> 같네."
		<</if>>
	<<elseif $enemyanger lte 100 or _args[0] is "mid">>
		<<rng>>
		<<He>>【이가】 말한다.
		<<if $rng lte 5>>
			"내 인내심을 시험하지 마."
		<<elseif $rng lte 10>>
			"나쁜 걸레년은 다치는 법이지."
		<<elseif $rng lte 15>>
			"너는 나쁜 <<girl>>【이가】 아니겠지, 그렇지?"
		<<elseif $rng lte 20>>
			"내가 널 다치게 할 방법을 못 찾을 거라 생각하지 마."
		<<elseif $rng lte 25>>
			"더 잘해야지, <<girl>>."
		<<elseif $rng lte 30>>
			"네가 얼마나 더 대줄 수 있을지 궁금하군."
		<<elseif $rng lte 35>>
			"이왕 벌어지는 일이니, 그냥 편하게 받아들이는 게 좋을 텐데."
		<<elseif $rng lte 40>>
			"착한 <<girl>>답게 굴면 모든 게 한결 쉬워질 거다."
		<<elseif $rng lte 45>>
			"넌 네 몸으로 날 기쁘게 만들게 될 거야."
		<<elseif $rng lte 50>>
			"내게 반항하지 마."
		<<elseif $rng lte 55>>
			"넌 이러기 위해 태어난 거야."
		<<elseif $rng lte 60>>
			"네가 즐기고 있다는 거 다 알아."
		<<elseif $rng lte 65>>
			"이게 다 네 탓이라는 건 알지."
		<<elseif $rng lte 70>>
			"너 이거 좋아하잖아, 안 그래."
		<<elseif $rng lte 75>>
			"넌 지금 살얼음판을 걷고 있어, <<girl>>."
		<<elseif $rng lte 80>>
			"이게 내 밑바닥일 거라 착각하지 마."
		<<elseif $rng lte 85>>
			"이제 넌 내 소유야."
		<<elseif $rng lte 90>>
			"내가 끝이라고 할 때까지 안 끝나."
		<<elseif $rng lte 95>>
			"넌 재미있는 장난감이지만, 딴생각은 품지 마."
		<<elseif $rng lte 100>>
			"너보다 잘난 사람을 존경으로 대해야지."
		<</if>>
	<<elseif $enemyanger gt 100 or _args[0] is "high">>
		<<rng>>
		<<He>>【이가】 분노로 벽을 내리친다.
		<<if $rng lte 5>>
			"씨발 창녀년."
		<<elseif $rng lte 10>>
			"넌 그저 더러운 걸레년일 뿐이야."
		<<elseif $rng lte 15>>
			"넌 정액받이 통이야, 그 이상도 이하도 아니지."
		<<elseif $rng lte 20>>
			"너같이 쓸모없는 쓰레기 새끼가 내게 관심을 보일 수 있게 허락받은 걸 기뻐해야지."
		<<elseif $rng lte 25>>
			"아직 내가 이 벽을 부수고 넘어가지 않은 것에 감사해야 할 거다."
		<<elseif $rng lte 30>>
			"난 이 벽을 부수고, 그다음엔 널 부숴버릴 거야."
		<<elseif $rng lte 35>>
			"내 일이 끝나기 전까지 내게 예의를 표하게 될 거다."
		<<elseif $rng lte 40>>
			"내가 저쪽으로 넘어가면 네게 무슨 짓을 할지 아주 기대되는군."
		<<elseif $rng lte 45>>
			"너 같은 암캐년한텐 강간도 사치야."
		<<elseif $rng lte 50>>
			"넌 이것보다 훨씬 끔찍한 꼴을 당해야 해, 이 암캐야."
		<<elseif $rng lte 55>>
			"너도 즐기고 있잖아. 부정하려 들지 마."
		<<elseif $rng lte 60>>
			"넌 쓸모없는 육변기에 불과해."
		<<elseif $rng lte 65>>
			"필요하다면 이 벽이라도 부숴버리겠어, 이 쓸모없는 쓰레기야."
		<<elseif $rng lte 70>>
			"나를 가버리게 하는 게 네 유일한 목적이라는 걸 잊지 마."
		<<elseif $rng lte 75>>
			"이거 좋아하잖아, 안 그래? 멍청한 걸레년."
		<<elseif $rng lte 80>>
			"넌 이것보다 훨씬 끔찍한 꼴을 당해야 해, 창녀야. 내가 네게 닿을 수만 있다면."
		<<elseif $rng lte 85>>
			"넌 가치 없는 걸레년이야."
		<<elseif $rng lte 90>>
			"내가 저쪽으로 가서, 널 다치게 만들 테고, 넌 그걸 좋아하게 될 거다."
		<<elseif $rng lte 95>>
			"너 같은 <<girl>>【은는】 단 하나의 쓸모밖에 없어."
		<<elseif $rng lte 100>>
			"넌 정말 형편없는 걸레년이구나."
		<</if>>
	<</if>>
<</widget>>

<<widget "sprayspeech">>
	<<He>>【이가】 외친다.
	<<switch $speechspraycycle>>
		<<case 0>> "그딴 건 씨발 어디서 났어?"
		<<case 1>> "넌 재미없어."
		<<case 2>> "이 사디스트 <<bitch>>【아야】!"
		<<case 3>> "씨발! 좆같네!"
		<<case 4>> "아악!"
		<<case 5>> "제기랄. 제법 반항할 줄 아네."
		<<default>> "내 눈!"
	<</switch>>
	<<set $speechspraycycle to $speechspraycycle isnot undefined ? ($speechspraycycle + 1) % 7 : 0>>
<</widget>>

<<widget "beastspeech">>
	<<set _n to _args[0]>>
	<<switch $NPCList[_n].type>>
	<<case "lizardgirl" "lizardboy">>
		<<bHe>>【이가】 하악거린다.
	<<case "dolphingirl" "dolphinboy">>
		<<bHe>>【이가】 딸깍거리는 소리를 낸다.
	<<case "catgirl" "catboy">>
		<<bHe>>【이가】 가르랑거린다.
	<<case "harpy">>
		<<bHe>>【이가】 짹짹거린다.
	<<case "cowgirl" "bullboy">>
		<<bHe>>【이가】 음메 하고 운다.
	<<case "spidergirl" "spiderboy">>
		<<bHe>>【이가】 찍찍거린다.
	<<case "foxgirl" "foxboy">>
		<<bHe>>【이가】 깽깽거린다.
	<<default>>
		<<bHe>>【이가】 으르렁거린다.
	<</switch>>
	<<if $NPCList[_n].fullDescription is "Great Hawk">>
		<<hawkspeech>>
	<<elseif $NPCList[_n].penis isnot "none">>
		<<if $player.gender_appearance is "f">>
			<<if $enemyanger gte 60>>
				<<if $enemyarousal gte ($enemyarousalmax / 2)>>
					<<if $NPCList[_n].type is "wolfgirl" or $NPCList[_n].type is "wolfboy">>
						<<switch $npcspeechcycle>>
							<<case 0>> "내 냄새를 묻히겠다. 내 것으로."
							<<case 1>> "모두가 냄새를 알 것이다. 무리에게 전리품으로 보여주겠다."
							<<case 2>> "네 안의 새끼가 곧 널 얌전하게 만들 거다."
							<<case 3>> "반항하지 마라, 애써 잡은 사냥감이다."
							<<case 4>> "계속 발버둥 치면 무리와 나누겠다!"
							<<case 5>> "사냥감은 내 것이다."
							<<default>> "복종해! 복종해라!"
						<</switch>>
					<<else>>
						<<switch $npcspeechcycle>>
							<<case 0>> "빨리 내 씨앗으로 널 마킹하고 싶어."
							<<case 1>> "가득 채워주지, 네 주인이 누군지 모두가 알게 말이야."
							<<case 2>> "내가 네 안에 새끼를 품게 하면 그렇게 건방지게 굴지 못할 거다."
							<<case 3>> "반항하지 않으면 재미없지."
							<<case 4>> "얌전히 구는 게 좋을 거야, 아니면 내 형제들과 널 나눌 테니까."
							<<case 5>> "네 자궁은 내 것이다."
							<<default>> "내 자지가 네 주제를 알려줄 거다."
						<</switch>>
					<</if>>
				<<else>>
					<<if $NPCList[_n].type is "wolfgirl" or $NPCList[_n].type is "wolfboy">>
						<<switch $npcspeechcycle>>
							<<case 0>> "사냥감에게 누가 알파인지 보여주마."
							<<case 1>> "그만 발버둥 쳐라. 복종해!"
							<<case 2>> "사냥감은 운이 좋다고 여겨라. 먹는 걸 더 좋아하니까."
							<<case 3>> "자랑스럽게 여겨라. 먹지 않고, 짝짓기한다. 무리 중 최고다."
							<<case 4>> "가만히 있어라, 안 그러면 공격한다."
							<<case 5>> "좋은 냄새가 난다. 나중에 먹겠다."
							<<default>> "네게서 강한 새끼가 나올 거다, 무리의 어미로서."
						<</switch>>
					<<else>>
						<<switch $npcspeechcycle>>
