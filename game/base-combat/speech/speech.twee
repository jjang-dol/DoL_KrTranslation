					<<else>>
						<<switch random(1,3)>>
							<<case 1>> "정말 섹시해."
							<<case 2>> "세상에, 진짜 꼴린다."
							<<case 3>> "그렇게 입고 있는데 내가 참을 수 있을 거라 기대하지 마."
						<</switch>>
					<</if>>
				<<case "crop top">>
					"네 예쁘고 꽉 조이는 몸을 제대로 보여주는군."
				<<case "tube top">>
					<<switch random(1,2)>>
						<<case 1>> "거의 아무것도 안 입었잖아."
						<<case 2>> "속옷만 입고 돌아다니는 거나 다름없네."
					<</switch>>
				<<case "turtleneck">>
					<<if $enemyanger gte 20>>
						<<switch random(1,2)>>
							<<case 1>> "그걸 입으니까 진짜 천박해 보여."
							<<case 2>> "걸레들만 이렇게 입지."
						<</switch>>
					<<else>>
						<<switch random(1,2)>>
							<<case 1>> "귀여운 배네."
							<<case 2>> "정말 날씬해."
						<</switch>>
					<</if>>
				<<case "sweater">>
					<<switch random(1,2)>>
						<<case 1>> "정말 사랑스러워."
						<<case 2>> "왜 그렇게 부끄러워해?"
					<</switch>>
				<<case "serafuku" "gakuran">>
					<<switch random(1,3)>>
						<<case 1>> "정말 귀여운 복장이네."
						<<case 2>> "너 그 애니메이션 오타쿠 같은 애들이냐?"
						<<case 3>> "이런 걸 입은 <<girl>>【을를】 언제 한번 박아보고 싶었지."
					<</switch>>
				<<case "plant top">>
					<<switch random(1,7)>>
						<<case 1>> "정말 이상하군."
						<<case 2>> "그게 뭐야?"
						<<case 3>> "인어 같아."
						<<case 4>> "묘한 매력이 있네."
						<<case 5>> "옷 잃어버렸어?"
						<<case 6>> "저거 위생적이지 않을 텐데."
						<<case 7>> "저거 식물로 만든 거야?"
					<</switch>>
				<<case "towel top" "large towel">>
					<<switch random(1,3)>>
						<<case 1>> "많이 서둘렀나 보지?"
						<<case 2>> "새 옷 좀 사 입어야겠네."
						<<case 3>> "벗기기 좋아서 마음에 드네."
					<</switch>>
				<<default>>
					<<basespeech>><<neutral 1>>
			<</switch>>
		<<else>>
			<<basespeech>><<neutral 1>>
		<</if>>
	<<elseif $rng gte 61>>
		<<rng>>
		<<if !$worn.lower.type.includes("naked")>>
