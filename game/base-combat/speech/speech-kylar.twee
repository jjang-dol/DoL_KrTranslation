:: Widgets speech-Kylar [widget]
<<widget "speech-kylar">>
	<<set _npc_speech to true>>
	<<set _kylar to statusCheck("Kylar")>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Kylar") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Kylar")>>
		<<He>>【이가】 숨을 헐떡인다. "너도 처음이었구나," <<he>>【이가】 말한다. "우린 운명이야."
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Kylar">>
		<<if $player.vaginaExist and $settings.pregnancySpeechEnabled>>
			<<He>>【이가】 헐떡인다. "이러면 애는 못 만들겠지만, 널 참을 수 없었어."
		<<elseif !$player.vaginaExist and _kylar.gender is "m" and knowsAboutAnyPregnancy("pc","Kylar") and $settings.pregnancySpeechEnabled>>
			<<He>>【이가】 헐떡인다. "그래서 전에 임신했던 거야? 그래도 처음이었는데!"
		<<else>>
			<<He>>【이가】 헐떡인다. "네 모든 부분, 가장 깊은 곳까지 다 느끼고 싶어!"
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Kylar">>
		<<He>>【이가】 숨을 몰아쉰다. "드디어 네가 내 가장 은밀한 곳에 키스해주고 있어. 내 꿈에서처럼!"
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Kylar">>
		<<He>>【이가】 숨을 거칠게 쉰다. "사랑해사랑해사랑해!!!"
		<<set $kylarSeen.pushUnique("saidLove")>>
	<<elseif $speechcrossdressaroused is 1 and $settings.pregnancySpeechEnabled>>
		<<if _kylar.gender is "h">>
			<<He>>【이가】 숨을 헐떡인다. "아. 난 네가... 그런 줄 알았어." <<He>>【이가】 씨익 웃으며 머리를 가로젓는다. "뭐 어때! 우린 여전히 가족을 만들 수 있어...!"
		<<elseif $player.penisExist>>
			<<He>>【이가】 헐떡인다. "네가 날 임신시켜 줄 수 있어. 가족을 만드는 건 포기했었는데..." <<He>>【이가】 울기 시작한다. "네가 날 임신시킬 수 있어...!"
		<<else>>
			<<He>>【이가】 헐떡인다. "내가 널 임신시켜 줄 수 있어. 가족을 만드는 건 포기했었는데..." <<He>>【이가】 울기 시작한다. "내가 널 임신시킬 수 있어...!"
		<</if>>
	<<elseif $speechcrossdressdisappointed is 1>>
		<<if !$player.vaginaExist and knowsAboutAnyPregnancy("pc","Kylar")>>
			<<He>>【이가】 한숨을 쉰다. "아. 난 네가..." <<He>>【이가】 갑자기 들떠서 말한다. "그래도 전에 임신했었잖아? 흐음, 그럼 아직 희망이 있네."
		<<else>>
			<<He>>【이가】 한숨을 쉰다. "아. 난 네가..." <<He>>【이가】 머리를 흔든다. "겨, 괜찮아. 우린 언제든 입양하면 돼."
		<</if>>
	<<elseif $speechhermaroused is 1>>
		<<if _kylar.gender is "h" and $settings.pregnancySpeechEnabled>>
			<<He>>【이가】 헐떡인다. "너한테 둘 다 있어...? 나처럼...? 우리는 엄청 많은 아이들을 만들 수 있을 거야... 완벽해..."
		<<else>>
			<<He>>【이가】 헐떡인다. "둘 다 있어...? 네가 이것보다 더 완벽할 수 있을 줄 몰랐는데..."
		<</if>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<if _loveInterest is "Black Wolf" or _loveInterest is "Great Hawk">>
			<<His>> 눈이 가늘어진다. "나도 짐승처럼 할 수 있어. 똑똑히 봐!"
		<<elseif random(1, 100) lte 50>>
			<<switch _loveInterest>>
				<<case "Robin">>
					<<He>>【이가】 으르렁거린다. "나만큼 로빈이 널 챙겨줄 순 없어!"
				<<case "Whitney">>
					<<He>>【이가】 멈칫한다. "휘... 휘트니는 날 못 막아!"
				<<case "Sydney">>
					<<He>>【이가】 으르렁거린다. "시드니는 나만큼 널 잘 몰라!"
					<<set $kylarSeen.pushUnique("sydneyWriting")>>
				<<default>>
					<<He>>【이가】 멈칫한다. "누구... 얘기하는 거야...?"
			<</switch>>
		<<else>>
			<<He>>【이가】 굳어버린다. "걔넨 필요 없어! 넌 나만 있으면 돼!"
		<</if>>
		<<npcincr Kylar rage 10>><<ggksuspicion>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
		<<if !$player.penisExist and $NPCList[0].vagina isnot "none" and random(0,2) isnot 0>>
			<<print `<<He>>【이가】 당신의 $_sexToy【을를】 보며 말한다. "` + [`써, 써줘. 제발, 날... 그걸 써줘.`, `우리가 사랑한다는 증거지, 그렇지?`][random(0,1)] + `"`>>
		<<elseif $player.penisExist or $NPCList[0].penis isnot "none" and random(0,2) isnot 0>>
			<<print `<<He>>【이가】 당신의 $_sexToy【을를】 보며 말한다. "` + [`내가... 뭘 잘못했어...?`, `네가 행복하다면 나도 좋지만...`][random(0,1)] + `"`>>
		<<else>>
			<<He>>【이가】 당신의 $_sexToy【을를】 보고 입을 삐죽 내민다. "나로는 부족해?"
		<</if>>
	<<elseif _silent isnot 1>>
		<<set $kylarsexcycle to $kylarsexcycle or 0>>
		<<switch $kylarsexcycle>>
			<<case 0>>
				<<if $settings.pregnancySpeechEnabled and (playerCanBreedWith("Kylar") or (!$genderknown.includes("Kylar") and $player.gender_appearance is "f"))>>
					<<He>>【이가】 당신의 귓가에 속삭인다. "우리 아기를 아주 많이 가질 거야."
				<<else>>
					"우리 아기를 아주 많이 입양할 거야," <<he>>【이가】 말한다.
				<</if>>
			<<case 1>>
				<<print `"넌 최고의 <<pmummy>>【이가】 될 거야," <<he>>【이가】 말한다.`>>
			<<case 2>>
				"정말 야하다니까," <<he>>【이가】 말한다. "우리 아직 결혼도 안 했는데!"
			<<case 3>>
				"내 기운을 쏙 빼놓아줘," <<he>>【이가】 말한다. "그리고 멈추지 마."
			<<case 4>>
				<<print `"널 쳐다본 다른 ${$pronoun is "m" ? "개자식들" : "창년들"} 따위 전부 잊어버릴 때까지 몇 번이고 다시 할 거야," <<he>>【이가】 말한다.`>>
			<<case 5>>
				"네가 영원히 생각하는 건 나뿐일 거야," <<he>>【이가】 말한다.
			<<case 6>>
				"모두 다 나쁜 놈들이야," <<he>>【이가】 말한다. "너 빼고. 넌 완벽해."
			<<case 7>>
				"이러니까 안심돼," <<he>>【이가】 말한다. "영원히 끝나지 않았으면 좋겠어."
			<<case 8>>
				"사-사랑해," <<he>>【이가】 말한다.
				<<set $kylarSeen.pushUnique("saidLove")>>
			<<default>>
				"넌 정말 음탕하고 야해. 전부 내 거야," <<he>>【이가】 말한다.
		<</switch>>
		<<set $kylarsexcycle to ($kylarsexcycle + 1) % 10>> <!-- increase by one, and reset to 0 if it hits 10 -->
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>
