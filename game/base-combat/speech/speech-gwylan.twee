		<<set $gwylanUniqueComments.pushUnique("pregnant")>>
		<<He>>【이가】 킥킥 웃는다. "사랑스러운 축복이네. 좋을 것 같아."
	<<elseif $speechleglock is 1 and !$gwylanUniqueComments.includes("leglock")>>
		<<set $gwylanUniqueComments.pushUnique("leglock")>>
		<<He>>【이가】 킥킥 웃는다. "날 꽉 안아, <<pcpetname 'Gwylan'>>【아야】."
	<<elseif $speechscream is 1>>
		<<He>>【이가】 킥킥 웃는다. "조용히 해, <<pcpetname 'Gwylan'>>【아야】. 소리 지를 필요 없어."
	<<elseif $speechwheeze is 1>>
		<<He>>【이가】 킥킥 웃는다. "쉿. 아무 말 마."
	<<elseif $speechpenisbig is 1 and !$gwylanUniqueComments.includes("big_pp")>>
		<<set $gwylanUniqueComments.pushUnique("big_pp")>>
		<<He>>【은는】 손을 입술에 댄다. "꽤 크지만, 내가 감당할 수 있어."
	<<elseif $speechmasturbate is 1 and !$gwylanUniqueComments.includes("masturbate")>>
		<<set $gwylanUniqueComments.pushUnique("masturbate")>>
		<<He>>【이가】 킥킥 웃는다. "손 좀 치워봐, 내가 처리할게."
	<<elseif $speechheadbreasts is 1 and !$gwylanUniqueComments.includes("head_breasts")>>
		<<set $gwylanUniqueComments.pushUnique("head_breasts")>>
		<<He>>【이가】 킥킥 웃는다. "거기 따뜻해? 뭐라고? 안 들려."
	<<elseif $speechfacesit is 1 and !$gwylanUniqueComments.includes("facesit")>>
		<<set $gwylanUniqueComments.pushUnique("facesit")>>
		<<He>>【이가】 킥킥 웃는다. "자, 내 허리를 잡아. 애써봐."
	<<elseif $speechvaginaescape is 1>>
		<<if $enemyarousal gte ($enemyarousalmax / 5) * 4>>
			<<He>>【이가】 코웃음을 친다. "이리 돌아와, 나 아직 안 끝났어."
		<<else>>
			<<He>>【이가】 킥킥 웃는다. "너무 버거워?"
		<</if>>
	<<elseif $speechpenisescape is 1>>
		<<if $enemyarousal gte ($enemyarousalmax / 5) * 4>>
			<<He>>【이가】 코웃음을 친다. "다시 집어넣어."
		<<else>>
			<<He>>【이가】 킥킥 웃는다. "거기로 다시 들어가, 이 바보 같은 <<girl>>【아야】."
		<</if>>
	<<elseif $combat_silenced and !$gwylanUniqueComments.includes("silenced")>>
		<<set $gwylanUniqueComments.pushUnique("silenced")>>
		"내 말 들었어야지, 이 못된 <<girl>>【아야】."
	<<elseif $speechaskrough is 1>>
		<<He>>【이가】 킥킥 웃는다. "어떻게 거절하겠어? 달콤하게 아프게 해줄게."
	<<elseif $speechbeat is 1>>
		<<print either(
			`<<He>>【이가】 눈살을 찌푸린다. "그만 반항해, <<pcpetname 'Gwylan' 'naughty'>>【아야】."`,
			`<<He>>【이가】 눈살을 찌푸린다. "그냥 복종해. 그럼 아픔은 전부 사라질 테니까."`,
			`<<He>>【이가】 눈살을 찌푸린다. "왜 버둥거리는 거야? 이게 네가 원하던 거 아니었어?"`,
			`<<He>>【이가】 눈살을 찌푸린다. "나도 이러는 게 즐거운 건 아니야, 그러니까 제발. 의미 없는 발버둥은 멈춰."`,
			`<<He>>【이가】 눈살을 찌푸린다. "미안해. 다 끝나면 아프지 않게 뭐라도 줄게."`,
		)>>
	<<elseif $speechgrowl is 1>>
		<<He>>【이가】 킥킥 웃는다. "오, 흥분되는 으르렁거림이네. 그 송곳니 다시 보여줘 봐." <<npcincr Gwylan lust 1>><<glust>><br>
	<<elseif $speechgrowlheat is 1 or $speechgrowlrut is 1>>
		<<He>>【이가】 킥킥 웃는다. "오, 사랑스러운 으르렁거림이네. 쉿, 내가 기분 좋게 해줄게." <<npcincr Gwylan lust 1>><<glust>><br>
	<<elseif $speechplead is 1>>
		<<He>>【이가】 킥킥 웃는다. "쉿, 조용."
	<<elseif $speechdemand is 1 and $hypnosis_traits.devotion gte 2 and !$combat_silenced>>
		<<if $gwylanUniqueComments.includes("demand")>>
			<br><span class="red"><<He>>【은는】 멈칫하더니 속을 알 수 없는 표정으로 당신을 노려본다.</span> "내가 경고했잖아."
			당신이 입을 열자마자 <<his>> 손가락이 목을 훑고 올라온다.
			<<if $hallucinations gte 2>>
				<<hypnosisText "<span class='red'>푸른 안개가 당신의 입에서 새어 나오고, <<he>>【은는】 그것을 <<his>> 손으로 부드럽게 붙잡는다. 아무리 애써도 목소리를 빼앗긴 것처럼 아무 소리도 나오지 않는다.</span>">>
			<<else>>
				<<hypnosisText "<span class='red'>목소리가 목에 걸린다. 아무리 애써도 아무 말도 할 수 없다.</span>">>
			<</if>>
			<br>
			<<gwylanHypnoName "cap">>【은는】 다시 미소 짓는다. "네가 얌전히 굴면 돌려줄게. 자, <<pcpetname "Gwylan" "good">>【이】니까 쉿해." <<He>>【은는】 다시 자리를 잡고 행동을 재개한다.
			<<set $combat_silenced to true>>
			<<if $consensual is 1>>
				<<set $consensual to 0>>
				<<molested>><<controlloss>>
			<</if>><br><br>
		<<else>>
			<<set $gwylanUniqueComments.pushUnique("demand")>>
			<<He>>【이가】 킥킥 웃는다. "<<gwylanCommand "그 입 다물고 있어. 아니면 내가 막아줄 테니.">>"
		<</if>>
	<<elseif $speechdemand is 1 and !$gwylanUniqueComments.includes("demand")>>
		<<set $gwylanUniqueComments.pushUnique("demand")>>
		<<He>>【이가】 킥킥 웃는다. "계속 그렇게 센 척 해봐. 난 네 얼굴을 기억하고 싶어."
	<<elseif $speechforgive is 1>>
		<<He>>【은는】 인상을 찌푸리더니 잠시 침묵한다. "내가 널 용서받을 자격이 있을까?"
	<<elseif $speechhit is 1>>
		<<if $rng gte 100>>
			<<He>>【은는】 당신이 때리자 뒷걸음질을 친다. "붸에!"
		<<elseif $enemyarousal gte ($enemyarousalmax / 5) * 4>>
			<<He>>【은는】 흥분과 고통에 숨을 헐떡인다. "모-<<pcpetname 'Gwylan' 'naughty'>>【아야】!"
		<<else>>
			<<He>>【이가】 흠칫 놀란다. "아야! 아우, <<pcpetname 'Gwylan' 'bad'>>【아야】."
		<</if>>
	<<elseif $speechvaginaflaunt is 1 and $gwylanComments.flaunt is 0>>
		<<set $gwylanComments.flaunt to 3>>
		<<print either(
			`<<He>>【이가】 얼굴을 붉힌다. "구경은 즐거워?"`,
			`<<He>>【이가】 킥킥 웃는다. "네 눈길이 나를 훑고 다니는 게 느껴져, 난 그게 좋아."`,
			`<<He>>【이가】 킥킥 웃는다. "나 예뻐 보여?"`
		)>>
	<<else>>
		<<cleareventpool>>

		<<if !$gwylanUniqueComments.includes("clothes")>>
			<<if $worn.upper.name is "chain tunic">>
				<<addinlineevent "gwylan_speech_clothes_chain_tunic" 3>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>>【은는】 손으로 $worn.upper.name【을를】 쓸어내린다. 옛 향수에 잠긴 듯하다. <<His>> 손길이 더욱 부드러워진다.
					<<set $enemyanger -= 25>>
				<</addinlineevent>>
			<</if>>
			<<if $worn.head.name is "sage witch hat">>
				<<addinlineevent "gwylan_speech_clothes_sage_witch_hat">>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>>【은는】 당신의 $worn.head.name 테두리를 어루만지며 미소 짓는다. "너랑 정말 잘 어울려! 더 자주 입어야겠는걸."
				<</addinlineevent>>
			<</if>>
			<<if $worn.upper.type.includes("holy")>>
				<<addinlineevent "gwylan_speech_clothes_holy">>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>>【은는】 두 손으로 당신의 $worn.upper.name【을를】 쓸어내린다. "네가 원한다면, 좀 더럽혀질 수 있게 도와줄게."
				<</addinlineevent>>
			<</if>>
			<<if $worn.neck.name is "holy pendant">>
				<<addinlineevent "gwylan_speech_clothes_holy_pendant">>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>>【은는】 당신의 $worn.upper.name【을를】 보며 킥킥 웃는다. "네가 추락 공포증이 아니길 바라."
				<</addinlineevent>>
			<</if>>
			<<if $worn.neck.name is "stone pendant">>
				<<addinlineevent "gwylan_speech_clothes_stone_pendant">>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<if $gwylanTalked.includes("stone pendant")>>
						<<He>>【은는】 당신의 $worn.upper.name【을를】 보고 미소 짓는다. "손상되지 않은 걸 찾아냈다니 다행이야. 돌 펜던트는 죄다 파괴된 줄 알았거든."
					<<else>>
						<<He>>【은는】 당신의 $worn.upper.name【을를】 본다. "이거 어디서 구했어? 나중에 꼭 말해줘."
					<</if>>
				<</addinlineevent>>
			<</if>>
			<<if $worn.neck.name is "dark pendant">>
				<<addinlineevent "gwylan_speech_clothes_dark_pendant">>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>>【은는】 당신의 $worn.upper.name【을를】 본다. "네가 그걸 어떻게 다뤄야 할지 잘 알길 바라."
				<</addinlineevent>>
			<</if>>
			<<if $worn.lower.name is "naked" and playerHasStrapon()>>
				<<addinlineevent "gwylan_speech_clothes_strap">>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>>【은는】 당신의 <<penisSimple>>【을를】 본다. "그래, 안 될 건 없지."
				<</addinlineevent>>
			<</if>>
			<<if $exposed gte 2>>
				<<addinlineevent "gwylan_speech_clothes_naked">>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>>【은는】 당신의 몸을 훑어보고는 킥킥 웃는다. "내 맨살 위에 네 맨살이 닿는 걸 느끼고 싶어."
				<</addinlineevent>>
			<</if>>

			<<for $_labelClothes, $_valueClothes range $worn>>
				<<if setup.specialClothes.some(item => item.name === $_valueClothes.name and !$gwylanTalked.includesAny(item.sets))>>
					<<addinlineevent "gwylan_speech_clothes_special" 4>>
						<<set $gwylanUniqueComments.pushUnique("clothes")>>
						<<set $_clothesObject to $worn[$_labelClothes].plural ? "그것들을" : "그걸">>
						<<set $_clothesTopic to $worn[$_labelClothes].plural ? "그것들" : "그거">>
						<<print either(
							`<<He>>【은는】 당신의 ` + $worn[$_labelClothes].name + `【을를】 본다. "어디서 ` + $_clothesObject + ` 찾은 거야? 나중에 꼭 내게 말해줘야 해."`,
							`<<He>>【은는】 당신의 ` + $worn[$_labelClothes].name + `【을를】 본다. "` + $_clothesTopic + ` 뒤에 숨은 이야기가 있을 것 같네. 우리 일이 끝나면 그것에 대해 이야기해 보자."`
						)>>
					<</addinlineevent>>
					<<break>>
				<</if>>
			<</for>>

			/* Todo: Gwylan - Lots more clothing comments */
		<</if>>

		<<addinlineevent "gwylan_speech_neutral_1">>
			<<He>>【이가】 속삭인다. "그냥 누워있어, 내가 널 돌봐줄 테니까."
		<</addinlineevent>>
		<<addinlineevent "gwylan_speech_neutral_2">>
			<<He>>【이가】 속삭인다. "네 짐을 나와 나눠 줘."
		<</addinlineevent>>

		<<if $gwylanSeen.includes("ritual_sex") and !$gwylanSeen.includes("partners")>>
			<<addinlineevent "gwylan_speech_kiss">>
				<<He>>【이가】 말한다. "기억해, 키스는 안 돼."
			<</addinlineevent>>
		<</if>>

		<<if $enemyanger gte 15>>
			<<addinlineevent "gwylan_speech_anger">>
				"가만히 있고 내게 맡겨."
			<</addinlineevent>>
		<</if>>

		<<if $consensual isnot 1 and $enemyanger gte 20>>
			<<addinlineevent "gwylan_speech_rape_1" 3>>
				<<He>>【이가】 말한다. "반항하려고 하지 마."
			<</addinlineevent>>
			<<addinlineevent "gwylan_speech_rape_2" 3>>
				<<He>>【이가】 말한다. "그냥 내게 복종해. 내가 다 괜찮게 만들어 줄게."
			<</addinlineevent>>
			<<addinlineevent "gwylan_speech_rape_3" 3>>
				<<He>>【이가】 말한다. "쉿, 복잡하게 생각하지 마. 계속 내 눈을 바라봐."
			<</addinlineevent>>
			<<addinlineevent "gwylan_speech_rape_4" 3>>
				<<He>>【이가】 말한다. "나와 함께 더 깊이 빠져들자. 고통은 잊게 될 거야."
			<</addinlineevent>>
			<<addinlineevent "gwylan_speech_rape_5" 3>>
				<<He>>【이가】 말한다. "우리 모두 조금은 고통받아야 해."
			<</addinlineevent>>
			<<if $gwylanSeen.includes("yearning")>>
				<<addinlineevent "gwylan_speech_rape_6" 3>>
					<<He>>【이가】 말한다. "네가 저지른 일에 비하면, 이 정도는 견뎌야지."
				<</addinlineevent>>
				<<addinlineevent "gwylan_speech_rape_7" 4>>
					<<He>>【이가】 말한다. "네 입맞춤에 독이 올랐잖아. 네가 책임을 져야지."
				<</addinlineevent>>
			<</if>>
			<<if $gwylanSeen.includes("romance")>>
				<<addinlineevent "gwylan_speech_rape_8" 3>>
					<<He>>【이가】 말한다. "영원이란 말 그대로 영원이야. 병들거나 아플지라도."
				<</addinlineevent>>
			<</if>>
		<</if>>

		<<if $combat_silenced>>
			<<addinlineevent "gwylan_speech_silenced" 2>>
				<<He>>【이가】 킥킥 웃는다. "아아, 무슨 할 말이 있는 표정이네. 걱정 마, 네 아름다운 목소리는 나랑만 공유하는 거니까."
			<</addinlineevent>>
		<</if>>

		<<if _gwylanTF.known is true and _gwylanTF.tail is "revealed">>
			<<if _gwylanStatus.includes("heat")>>
				<<addinlineevent "gwylan_speech_tf_heat">>
					<<His>> 얼굴은 짙게 붉어졌고, 끙끙거리는 소리를 낸다. <<if C.npc.Gwylan.pronoun is 'm'>>러트<<else>>발정기<</if>>【이가】 온 게 아닐까 하는 생각이 든다.
				<</addinlineevent>>
			<</if>>
			<<addinlineevent "gwylan_speech_tf_ears">>
				<<his>> 여우 귀 중 하나가 쫑긋거린다.
			<</addinlineevent>>
			<<addinlineevent "gwylan_speech_tf_tail">>
				<<if $enemyarousal gte ($enemyarousalmax / 5) * 4>>
					<<His>> 꼬리가 빠르게 이리저리 흔들린다.
				<<elseif $enemyarousal gte ($enemyarousalmax / 5) * 2>>
					<<His>> 꼬리가 이리저리 흔들린다.
				<<else>>
					<<His>> 꼬리가 천천히 이리저리 흔들린다.
				<</if>>
			<</addinlineevent>>
		<</if>>

		/* Todo: Gwylan - Lots more misc comments */

		<<addinlineevent "gwylan_speech_silent" 15>>
			/* Say nothing */
		<</addinlineevent>>

		<<runeventpool>>

	<</if>>
	<<if $gwylanComments>>
		<<set _keys to Object.keys($gwylanComments)>>
		<<for $_i to 0; $_i lt _keys.length; $_i++>>
			<<if $gwylanComments[_keys[$_i]] gt 0>>
				<<set $gwylanComments[_keys[$_i]]-->>
			<</if>>
		<</for>>
	<</if>>
<</widget>>
