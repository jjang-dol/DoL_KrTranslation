:: Widgets speech-GWYLAN [widget]
<<widget "speech-gwylan">>
	<<set _npc_speech to true>>
	<<run statusCheck("Gwylan")>><<rng>>
	<<set _gwylan to $NPCList.find(npc => npc.fullDescription === "Gwylan")>>
	<<if !$gwylanComments>>
		<<set $gwylanComments to {}>>
		<<set $gwylanComments.penetrated to 0>>
		<<set $gwylanComments.mouth to 0>>
		<<set $gwylanComments.trib to 0>>
		<<set $gwylanComments.imminent to 0>>
		<<set $gwylanComments.touch to 0>>
		<<set $gwylanComments.fondle to 0>>
		<<set $gwylanComments.flaunt to 0>>
		<<set $gwylanUniqueComments to []>>
	<</if>>
	<<if $possessed>>
		<<if $control gte $controlmax>>
			<<He>>【이가】 소리친다. "지금이야! 떨쳐내!"
		<<elseif $enemyhealth lte 50 and !$gwylanUniqueComments.includes("wraithPain")>>
			<<set $gwylanUniqueComments.pushUnique("wraithPain")>>
			<<He>>【은는】 쓰러지기 직전인 채로, 고통스럽게 앓는 소리를 낸다. "제발... 의지를 짜내봐!"
		<<else>>
			<<switch random(1,10)>>
				<<case 1>>
					<<He>>【이가】 으르렁거린다. "넌 <<phim>>【을를】 가질 수 없어."
				<<case 2>>
					<<He>>【이가】 으르렁거린다. "넌 그것보다 강해. 난 알아."
				<<case 3>>
					<<He>>【이가】 명한다. "꺼져!"
				<<case 4>>
					<<He>>【이가】 말한다. "내게 돌아와, <<pcpetname 'Gwylan' 'name'>>【아야】."
				<<case 5>>
					<<He>>【이가】 말한다. "날 떠나지 마."
				<<case 6>>
					<<He>>【이가】 말한다. "네 족쇄로 돌아가."
				<<case 7>>
					<<He>>【은는】 집중을 유지하려 애쓰며, 거칠게 숨을 몰아쉰다. "왜 <<phim>>【을를】?"
				<<case 8>>
					<<He>>【은는】 당신을 가만히 붙잡아두려 애쓴다. "그냥 싸워 이겨내."
				<<case 9>>
					<<He>>【이가】 말한다. "당장 <<phim>>【을를】 놔줘."
				<<case 10>>
					<<He>>【이가】 말한다. "이래도 네게 평화는 오지 않을 거야."
			<</switch>>
		<</if>>
	<<elseif $abomination is 1>>
		<<switch random(1,10)>>
			<<case 1>>
				<<He>>【이가】 킥킥 웃는다. "네가 이 짐승을 깨웠으니 만족시켜 줘야지."
			<<case 2>>
				<<He>>【은는】 숨을 거칠게 쉰다. "이런 에너지는 파괴할 수 없어. 소모해야만 해."
			<<case 3>>
				<<He>>【이가】 부드러운 신음을 내뱉는다. "어쩔 수 없잖아. 네가 필요해."
			<<case 4>>
				<<His>> 두 눈이 정욕으로 <span class="witch">빛난다</span>.
			<<case 5>>
				<<He>>【이가】 킥킥 웃는다. "인정해, <<pcpetname "Gwylan">>【아야】. 넌 유린당하고 싶잖아."
			<<case 6>>
				<<He>>【은는】 갈망에 미쳐 아무 말도 하지 않는다.
			<<case 7>>
				"네가 시작한 일이야," <<he>>【이가】 말한다. "이제 물러설 수는 없어."
			<<case 8>>
				"날 떠나지 마," <<he>>【이가】 외친다.
			<<case 9>>
				"미안해," <<he>>【이가】 훌쩍인다.
			<<case 10>>
				<<He>>【은는】 숨을 거칠게 쉰다. "너 정말 맛있어 보여, <<pcpetname "Gwylan">>【아야】. 널 맛보게 해줘."
		<</switch>>
	<<elseif $speechNPCPenisVirgin is 1 or $speechNPCVaginaVirgin is 1>>
		<<if $speechpenisvirgin is 1 or $speechvaginavirgin is 1 or $speechanusvirgin is 1>>
			<<He>>【이가】 얼굴을 찡그린다. "오 이런. 순결을 또 잃는 건 영원히 적응이 안 되네." <<He>>【이가】 킥킥 웃는다. "나랑 함께 겪어줘서 고마워. 넌 내 마지막 첫 경험이 될 거야."
		<<else>>
			<<He>>【이가】 얼굴을 찡그린다. "오 이런. 순결을 또 잃는 건 영원히 적응이 안 되네." <<He>>【이가】 킥킥 웃는다. "네게 보답으로 뭔가를 줄 수 있어서 다행이야. 넌 내 마지막 첫 경험이 될 거야."
		<</if>>
	<<elseif $speechNPCAnusVirgin is 1>>
		<<if $speechpenisvirgin is 1>>
			<<He>>【이가】 얼굴을 찡그린다. "이런, 이 몸은 아직 항문에 준비되지 않았어. 나중에 후유증이 남겠네." <<He>>【은는】 잠시 후 미소 짓는다. "음탕한 <<girl>>【이】구나, 첫 경험을 이런 식으로 하다니."
		<<else>>
			<<He>>【이가】 얼굴을 찡그린다. "이런, 이 몸은 아직 항문에 준비되지 않았어. 나중에 후유증이 남겠네." <<He>>【은는】 잠시 후 미소 짓는다. "아냐, 괜찮아, 계속해."
		<</if>>
	<<elseif $speechpenisvirgin is 1 or $speechvaginavirgin is 1>>
		<<if $fallenangel gte 2>>
			<<if $transformationParts.fallenAngel.halo isnot "hidden">>
				<<He>>【은는】 더 이상 당신의 헤일로에 얼굴이 비치지 않자, 눈살을 찌푸린다. "이게 정말 네가 원했던 거야?"
			<<else>>
				<<He>>【이가】 눈살을 찌푸린다. "이게 정말 네가 원했던 거야?"
			<</if>>
			<<set $gwylanSeen.pushUnique("fallen_angel")>>
		<</if>>
		<<if $position is "missionary">>
			<<He>>【은는】 잠시 몸을 앞으로 기울여 당신의 이마에 키스한다.
		<<else>>
			<<He>>【은는】 다시 엎드리기 전에 당신의 뺨에 입을 맞춘다.
		<</if>>
		"네가 준 이 선물을 기억할게."
	<<elseif $speechanusvirgin is 1>>
		"너 꽤 모험심이 강하구나. 나를 믿어줘서 고마워."
	<<elseif $speechmouthvirgin is 1>>
		"쉿, 잘하고 있어. 턱에 힘 빼."
	<<elseif $speechNPCKissVirgin is 1>>
		<<He>>【이가】 애정 어린 눈으로 당신을 응시한다. "우리가 여기까지 오다니, 이젠 내가 더 키스하고 싶어 졌는걸." <<He>>【이가】 킥킥 웃는다.
	<<elseif $speechhermaroused is 1>>
		<<if _gwylan.gender is "h">>
			<<He>>【이가】 고개를 갸웃거린다. "우리 여러모로 닮지 않았어?"
		<<else>>
			<<He>>【이가】 고개를 갸웃거린다. "오, 와아! 레비스를 실제로 보는 건 처음이야. 넌 정말 놀랍구나."
		<</if>>
	<<elseif $speechcrossdressaroused is 1>>
		<<He>>【은는】 잠시 생각에 잠긴다. "예상 밖의 생식기지만, 나쁘지 않아. 난 다재다능하거든."
	<<elseif $speechspray is 1>>
		<<He>>【이가】 눈을 가린다. "붸에!"
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Black Wolf" "Great Hawk">>
				<<He>>【이가】 킥킥 웃는다. "쉿, 동물 친구들과 지내는 게 어떤 건지 잘 아니까."
			<<case "Eden">>
				<<He>>【이가】 눈살을 찌푸린다. "쉿, <<nnpc_his 'Eden'>> 이름은 입에 올리지 마."
			<<case "Robin">>
				<<if $gwylan.robin gte 50>>
					<<He>>【이가】 킥킥 웃는다. "로빈한테도 우리 사이에 끼워 달라고 하지 그래."
				<<elseif $gwylanSeen.includes("romance")>>
					<<He>>【이가】 고개를 갸웃거린다. "누구랑 어울려도 상관없지만, 결국엔 내게 돌아오게 될 거야. 넌 약속했잖아." <<npcincr Gwylan dom -2>><<lyearning>>
				<<else>>
					<<He>>【이가】 킥킥 웃는다. "쉿. 굳이 다른 이름들을 부를 필요 없어. 우리 둘 뿐이니까."
				<</if>>
			<<case "Kylar">>
				<<if $gwylanSeen.includesAny("kylar_parents", "kylar_kidnapped")>>
					<<He>>【이가】 고개를 갸웃거린다. "네가 <<nnpc_him "Kylar">>에 대해 내게 해준 얘기들이 있는데, 그래도 <<nnpc_him "Kylar">>【을를】 찾는다니 정말 흥미롭네."
				<<elseif $gwylanSeen.includes("romance")>>
					<<He>>【이가】 고개를 갸웃거린다. "누구랑 어울려도 상관없지만, 결국엔 내게 돌아오게 될 거야. 넌 약속했잖아." <<npcincr Gwylan dom -2>><<lyearning>>
				<<else>>
					<<He>>【이가】 킥킥 웃는다. "쉿. 굳이 다른 이름들을 부를 필요 없어. 우리 둘 뿐이니까."
				<</if>>
			<<default>>
				<<if $gwylanSeen.includes("romance")>>
					<<He>>【이가】 고개를 갸웃거린다. "누구랑 어울려도 상관없지만, 결국엔 내게 돌아오게 될 거야. 넌 약속했잖아." <<npcincr Gwylan dom -2>><<lyearning>>
				<<else>>
					<<He>>【이가】 킥킥 웃는다. "쉿. 굳이 다른 이름들을 부를 필요 없어. 우리 둘 뿐이니까."
				<</if>>
		<</switch>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set _sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
		<<if $location is "forest_shop">>
			<<He>>【은는】 당신의 <<print _sexToy>>【을를】 보며 미소 짓는다. "나한테도 근처에 뭐 굴러다니는 게 있을 텐데." <<He>>【이가】 옆으로 손을 뻗더니, ?gwylanItem 하나를 찾아낸다. <<He>>【은는】 잠시 그것에 대해 생각하는 듯하더니, 어둠 속으로 다시 던져버린다.
		<<else>>
			<<He>>【은는】 당신의 <<print _sexToy>>【을를】 보며 미소 짓는다. "누가 계획을 세워 왔나 보네. 쌀 때도 계획대로 될까?"
		<</if>>
	<<elseif $speechcum is 1>>
		<<if _deniedOrgasm and !$gwylanUniqueComments.includes("ear_slime") and $consensual is 1>>
			<<set $gwylanUniqueComments.pushUnique("ear_slime")>>
			<<if $gwylanSeen.includes("hypnosis_silence")>>
				<<He>>【이가】 눈살을 찌푸린다. "기생충이 또 말썽인 거야? 그만할까?"
			<<elseif !$gwylanSeen.includes("ear_slime_intro")>>
				<<He>>【이가】 눈살을 찌푸린다. "정말 그만하고 싶지 않은 거 맞아?"
			<<else>>
				<<set $gwylanSeen.pushUnique("ear_slime_intro")>>
				<<He>>【이가】 눈살을 찌푸리며 잠시 물러난다. "상태가 좋아 보이지 않네. 이 일 끝나고 <span class='blue'>나한테 와서 얘기해.</span> 내가 도울 수 있을지도 몰라. 네가 힘들면 멈춰도 좋아."
			<</if>>
		<<elseif $player.penisExist and ($orgasmcount gte 24 or $femaleclimax)>>
			<<if !$gwylanUniqueComments.includes("no_cum")>>
				<<set $gwylanUniqueComments.pushUnique("no_cum")>>
				"이런, 아무것도 안 나오네. 충분한 거야?"
			<<else>>
				<<switch random(1, 4)>>
					<<case 1>>"내가 뭔가 나오게 어르고 달랠 수 있을 거야..."
					<<case 2>>"쯧. 좋지 않네."
					<<case 3>>"아무래도 영양제가 필요할지도 몰라."
					<<case 4>>"이리 와, 뭐라도 나한테 줘봐."
				<</switch>>
			<</if>>
		<<elseif $player.penisExist and $orgasmcount gte 18 and !$gwylanUniqueComments.includes("small_cum")>>
			<<set $gwylanUniqueComments.pushUnique("small_cum")>>
			"오 이런, 슬슬 마르기 시작하는 거 같은데."
		<<elseif $speechspank is 1>>
			<<He>>【이가】 킥킥 웃는다. "오 이런, 정말 더러운 <<pcpetname 'Gwylan' 'simple'>>【이】구나, 너."
		<<elseif _gwylan.vagina is "penisimminent" or _gwylan.vagina is "penisentrance">>
			<<He>>【이가】 킥킥 웃는다. "어머, 안에다 싸고 싶어 하는 거 같네. 불쌍한 <<pcpetname 'Gwylan' 'simple'>>【아야】."
		<<elseif _gwylan.vagina is "frot">>
			<<if playerChastity("penis")>>
				<<He>>【이가】 입술을 내민다. "그거 당장 벗겨야겠어. 날 제대로 채워주길 원해."
			<<else>>
				<<He>>【이가】 킥킥 웃는다. "네가 싸기 직전에 그냥 확 들어가게 냅둘까 하는 충동이 드네..."
			<</if>>
		<<elseif _gwylan.mouth is "penis">>
			<<if playerHasStrapon()>>
				<<He>>【은는】 당신이 절정에 달하는 모습을 올려다보며, <<his>> 입에서 당신의 <<penis>>【을를】 빼내고 기침을 하면서도 웃기 시작한다. "내가 이 장난감을 빠는 걸 보는 게 그렇게 꼴려?"
			<<else>>
				<<if $gwylanUniqueComments.includes("cum_in_mouth")>>
					<<He>>【은는】 당신이 <<his>> 입안에 다시 싸기 시작하자 몸을 지탱한다.
				<<else>>
					<<set $gwylanUniqueComments.pushUnique("cum_in_mouth")>>
					<<His>> 눈이 휘둥그레지며, 당신이 <<his>> 입안에 싸기 시작한다.
				<</if>>
				<<switch $player.penissize>>
					<<case 6>>
						<<He>>【은는】 코로 깊게 숨을 들이쉬고, 머리를 숙여 능숙하게 당신의 큼직한 자지를 모두 받아낸다. <<He>>【은는】 당신이 사정을 마칠 때까지 목구멍 깊숙이 담아둔다. 당신의 <<penis>>【을를】 빠르게 빼내더니 거칠게 숨을 들이켠다. <<He>>【이가】 헐떡이며 입을 벌려 텅 빈 속을 당신에게 보여준다. 당신의 정액은 모두 <<his>> 목구멍으로 넘어갔다.
					<<case 5 4 3>>
						<<He>>【은는】 고개를 숙이고, 당신의 자지 전체를 받아낸다. 당신이 사정을 마칠 때까지 입안에 머금고 있다가, 짧은 헐떡임과 함께 당신을 놓아준다. <<He>>【이가】 미소를 지으며 입을 벌려 머금은 정액을 당신에게 보여주고는 몽땅 삼켜버린다.
					<<default>>
						<<He>>【은는】 고개를 숙여, 당신의 아담한 자지를 쉽게 받아낸다. 당신이 사정을 마칠 때까지 입안에 머금고 있다가 놓아준다. <<He>>【이가】 미소를 지으며 입을 벌려 머금은 정액을 당신에게 보여주고는 몽땅 삼켜버린다.
				<</switch>>
			<</if>>
		<<elseif _gwylan.mouth is "vagina">>
			<<He>>【은는】 당신이 몸을 계속 떠는 동안 당신을 더 격렬하게 핥는다.
		<<elseif _gwylan.vagina is "penis">>
			<<if playerHasStrapon()>>
				<<He>>【은는】 당신이 절정에 오르자 유혹하듯 웃는다. "장난감으로도 나보다 오래 못 버티는 거야? 불쌍한 <<pcpetname 'Gwylan' 'simple'>>【아야】."
			<<else>>
				<<if _gwylanStatus.includes("wantsPregnancy") and $settings.pregnancySpeechEnabled>>
					<<He>>【은는】 당신의 <<penis>> 위에서 계속 흔들며 신음한다. "<<pcPetname 'Gwylan' 'good'>>【아야】, 내게 <<if $wolfgirl gte 6 or $fox gte 6 or $cat gte 6>>새끼를<<else>>아이를<</if>> 줘."
				<<elseif _gwylanStatus.includes("heat")>>
					<<He>>【은는】 당신의 정액이 <<his>> 자궁을 채우는 걸 느끼며 거칠게 숨을 몰아쉰다. 안도하며 한숨을 쉰다. "이게 필요했어. 네 씨앗이 내 안에 필요했어."
				<<else>>
					<<print either(
						`<<He>>【은는】 당신이 <<him>>【을를】 채워주자 흥분으로 몸을 떤다. "<<pcPetname 'Gwylan' 'good'>>【아야】, 날 채워줘."`,
						`<<He>>【이가】 엉덩이를 비비고, 한 손을 <<his>> <<bellyDescription 'Gwylan'>>에 얹는다. "따뜻해."`
					)>>
				<</if>>
			<</if>>
