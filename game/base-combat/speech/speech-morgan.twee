:: Widgets speech-Morgan [widget]
<<widget "speech-morgan">>
	<<set _npc_speech to true>>
	<<if $possessed>>
		<<switch random(1,10)>>
			<<case 1>>
				<<He>>【이가】 표효한다. "네가 <<phim>>【을를】 다치게 두지 않겠다!"
			<<case 2>>
				<<He>>【이가】 애원한다. "이겨내, <<charles>>! 저항하라고!"
			<<case 3>>
				<<He>>【이가】 침을 뱉듯 말한다. "안개 속으로 돌아가!"
			<<case 4>>
				<<He>>【이가】 노려본다. "나가. <<phim>>에게서 떨어져!"
			<<case 5>>
				<<He>>【이가】 노려본다. "네가 무너져가는 게 다 보여."
			<<case 6>>
				<<He>>【이가】 쉿쉿거린다. "두 번 말하게 하지 마라."
			<<case 7>>
				<<He>>【이가】 알 수 없는 비명을 지른다.
			<<case 8>>
				<<He>>【이가】 당신과 눈을 맞추며 안심하라는 듯 고개를 끄덕인다.
			<<case 9>>
				<<He>>【이가】 숨죽여 중얼거린다.
			<<case 10>>
				<<He>>【이가】 고개를 가로젓는다. "너는 추락할 거다. 추락하고 다시는 일어나지 못해."
		<</switch>>
	<<elseif ($speechpenisvirgin is 1 and $player.virginity.penile is "Morgan") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Morgan")>>
		<<He>>【이가】 미소 짓는다. "다시 네 처음이 된 것 같네. 이거 어떻게 한 거야, <<charles>>?"
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Morgan">>
		<<He>>【이가】 미소 짓는다. "<<charles>>【아야】, 내가 네 다른 처음까지 가져가게 생겼구나! 멋지지 않니?"
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Morgan">>
		<<He>>【이가】 미소 짓는다. "어떻게 하는지 다 까먹은 거야?"
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Morgan">>
		<<He>>【이가】 미소 짓는다. "내 맛도 기억 못하는 거야?"
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<default>>
				<<He>>【이가】 으르렁거린다. "<<charles>>【아야】, 넌 이 <<mummy>>의 것이란다!"
		<</switch>>
	<<elseif ($NPCList[_n].vagina is "feet" or $NPCList[_n].penis is "feet") and random(1, 10) is 1 and $settings.footFetishEnabled>>
		<<He>>【이가】 신음을 흘린다. "아, <<charles>>, 네 발...!" /* I hate you I hate you I hate you */
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
		<<He>>【이가】 당신의 $_sexToy【을를】 보고 말한다. "<<charles>>, 저건 뭐야?"
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>
