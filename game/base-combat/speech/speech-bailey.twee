:: Widgets speech-Bailey [widget]
<<widget "speech-bailey">>
	<<set _npc_speech to true>>
	<<set $_stringsPre to ($enemyanger lte 60 ? "<<He>>【이가】 낄낄거린다. ":"<<He>>【이가】 으르렁거린다. ")>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Bailey") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Bailey")>>
		<<print $_stringsPre + `"젠장. 네년 가치가 방금 좀 떨어졌어."`>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Bailey">>
		<<print $_stringsPre + `"이렇게 조이면 좀 더 자주 대줘야 할 거 아냐. 네가 뭐라도 되는 줄 알아?"`>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Bailey">>
		<<print $_stringsPre + `"이상한 생각 마라. 얌전히 받아들여."`>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Bailey">>
		<<print $_stringsPre + `"놀랐냐? 조만간 키스 더 잘하는 법을 배우게 될 거다."`>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<if $robinpaid is 1>>
					<<print $_stringsPre + `"네가 빚을 대신 갚아줬는데도 <<nnpc_he 'Robin'>>【은는】 구경조차 못 하는 꼴이라니."`>>
				<<elseif C.npc.Robin.dom gte 50>>
					<<print $_stringsPre + `"너 덕분에 그 고아 녀석도 제법 배짱이 생겼더군. 애석하게도 <<nnpc_he 'Robin'>>【이가】 널 구해주진 않겠지만 말이야."`>>
				<<else>>
					<<print $_stringsPre + either(
						`"그 쓸모없는 꼬맹이는 널 구해주지 못해."`,
						`"그 고아 녀석이 뭘 할 수 있을 것 같냐? 내가 그만둘 때까지 징징대기라도 할까?"`
					)>>
				<</if>>
			<<case "Black Wolf" "Great Hawk">>
				<<print $_stringsPre + either(
					`"사람들은 네가 짐승 새끼랑 ${$player.penisExist ? "떡치는" : "박히는"} 꼴을 보려고 기꺼이 웃돈을 낼 거다."`,
					`"짐승 새끼들은 살처분 당하지만, 넌 몸을 굴려야 할 거다."`
				)>>
			<<case "Eden">>
				<<print $_stringsPre + `"계속 이런 식이면 <<nnpc_him 'Eden'>>에게 다시 보내버릴 거다."`>>
			<<case "Gwylan">>
				<<print `<<He>>【은는】 잠시 멈칫하더니 입을 연다. "그 이름은 함부로 들먹이지 않는 게 좋을 거다."`>>
			<<case "Whitney">>
				<<if $whitney_bailey_met gte 1>>
					<<print $_stringsPre + `"그 멍청이는 쓸모가 있지. 하지만 중요한 놈이라고 착각하진 마라."`>>
				<<else>>
					<<print $_stringsPre + `"만약 <<nnpc_he _loveInterest>>【이가】 널 신경 썼다면, 진작에 네 몸값을 지불했겠지."`>>
				<</if>>
			<<case "Kylar">>
				<<if $kylar_abduction_bailey is 1>>
					<<print $_stringsPre + either(
						`"어디 <<nnpc_him 'Kylar'>>【을를】 더 크게 불러보시지. 창문 밖에 <<nnpc_he 'Kylar'>>【이가】 있을지도 모르잖아."`,
						`"그 변태 새끼는 아마 지켜보고 있을 거다. 맘대로 보라지."`
					)>>
				<<else>>
					<<print $_stringsPre + `"만약 <<nnpc_he _loveInterest>>【이가】 널 신경 썼다면, 진작에 네 몸값을 지불했겠지."`>>
				<</if>>
			<<case "Sydney">>
				<<if $temple_bailey>>
					<<print $_stringsPre + either(
						`"고해성사할 때나 지껄여."`,
						`"그 애송이는 널 위해 기도나 하겠지. 난 차라리 <<nnpc_he 'Sydney'>>【이가】 네 몸값을 냈으면 좋겠군."`
					)>>
				<<else>>
					<<print $_stringsPre + `"만약 <<nnpc_he _loveInterest>>【이가】 널 신경 썼다면, 진작에 네 몸값을 지불했겠지."`>>
				<</if>>
			<<case "Avery">>
				<<if $avery_fate is "saved">>
					<<print $_stringsPre + `"<<nnpc_He 'Avery'>>【은는】 네가 나락으로 떨어지게 내버려뒀을 거다."`>>
				<<elseif $avery_mansion and $avery_fate isnot "fallen" and $avery_fate isnot "kicked" and $renttime lte 0>>
					<<print $_stringsPre + `"난 <<nnpc_him 'Avery'>>【와과】 거래를 했지만, <<nnpc_he 'Avery'>>【은는】 돈줄이 말랐더군. 따지려거든 <<nnpc_him 'Avery'>>한테 가서 따져."`>>
				<<elseif $bailey_avery_met>>
					<<print $_stringsPre + `"그 멍청이를 계속 불러봐. <<nnpc_his 'Avery'>> 돈이 여기까지 닿을 수 있나 보자고."`>>
				<<else>>
					<<print $_stringsPre + `"만약 <<nnpc_he _loveInterest>>【이가】 널 신경 썼다면, 진작에 네 몸값을 지불했겠지."`>>
				<</if>>
			<<case "Alex">>
				<<print $_stringsPre + either(
					`"그 멍청한 ${C.npc.Alex.pronoun is "f" ? "카우걸이" : "카우보이가"} 뭘 할 수 있을 것 같냐?"`,
					`"네 농부 녀석은 아마 어딘가에 처박혀서 술이나 퍼마시고 있겠지."`,
					`"그 술고래는 네가 <<nnpc_his 'Alex'>> 밭 한가운데 서 있어도 널 못 찾을 거다."`
				)>>
			<<default>>
				<<print $_stringsPre + `"만약 <<nnpc_he _loveInterest>>【이가】 널 신경 썼다면, 진작에 네 몸값을 지불했겠지."`>>
		<</switch>>
	<<elseif $speechgenitals is 1>>
		<<print either(
			`<<He>>【은는】 당신의 <<genitals>>【을를】 쳐다본다. "이건 돈이 되겠군."`,
			`<<He>>【은는】 당신의 <<genitals>>【을를】 쳐다본다. "밥값은 충분히 하겠어."`
		)>>
	<<elseif $speechbreasts is 1>>
		<<print either(
			`<<He>>【은는】 당신의 <<breasts>>【을를】 쳐다본다. "이건 돈이 되겠군."`,
			`<<He>>【은는】 당신의 <<breasts>>【을를】 쳐다본다. "밥값은 충분히 하겠어."`
		)>>
	<<elseif $speechpregnant is 1 and $settings.pregnancySpeechEnabled>>
		<<if getChildrenAt("home").length>>
			<<print `<<He>>【은는】 당신의 불룩한 배를 보며 한숨을 쉰다. "임신이라니. 뻔하군."`>>
		<<else>>
			<<print `<<He>>【은는】 당신의 불룩한 배를 쳐다본다. "다리를 함부로 벌리고 다닌 모양이지?"`>>
		<</if>>
	<<elseif $speechplead is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"입 아프게 떠들지 마라."`,
				`"징징대지 마. 죽이지는 않을 테니까."`,
				`"애원한다고 네 빚이 줄어들진 않아."`,
				`"더 애절하게 빌어봐. 혹시 내가 자비를 베풀지 뉘 아냐."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"네 입에서 나오는 말 한마디마다 빚이 늘어날 거다."`,
				`"네 목숨이 아깝다면 닥치고 받아들여라."`,
				`"빌어봤자 소용없다, 이 새끼야."`
			)>>
		<</if>>
	<<elseif $speechmoan is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"조용히 해."`,
				`"신음은 손님들 앞에서나 내라고."`,
				`"비명은 돈 내는 놈들한테나 질러."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"입 닥쳐라, 꼬맹아."`,
				`"소리 한 번만 더 내봐, 이 새끼야."`,
				`"한 번만 더 소리 내면 진짜로 비명을 지르게 만들어 주마."`
			)>>
		<</if>>
	<<elseif $speechdemand is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"여기선 네가 명령하는 게 아니다."`,
				`"넌 협상할 처지가 아니야."`,
				`"그 주둥아리 때문에 빚만 더 늘어날 거다, 꼬맹아."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"입만 산 새끼."`,
				`"그 빌어먹을 주둥아리 좀 닥쳐."`,
				`"네깟 게 요구할 권리 따윈 없어. 옛날부터 그랬지."`
			)>>
		<</if>>
	<<elseif $speechscream is 1>>
		<<set $speechscream to 0>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"닥쳐."`,
				`"조용히 해."`,
				`"아무도 안 온다."`,
				`"누가 널 도와줄 거라고 생각하나?"`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"닥쳐."`,
				`"조용히. 해라."`,
				`"시끄러운 새끼."`
			)>>
		<</if>>
	<<elseif $speechforgive is 1>>
		<<print `<<He>>【은는】 비웃는다. ` + either(
			`"네 용서 따위 필요 없다."`,
			`"날 용서해? 도대체 뭘?"`,
			`"빌어먹을 주둥아리 다물어, 아님 내가 직접 꿰매주지."`
		)>>
	<<elseif $speechapologiseunforgiving is 1>>
		<<print $_stringsPre + either(
			`"닥쳐. 귀에 딱지가 앉도록 들은 소리니까."`,
			`"내가 그딴 헛소리에 속아 넘어갈 줄 알았나?"`,
			`"내가 눈도 깜짝할 것 같냐, 이 새끼야?"`,
			`"집어치워. 진짜 미안하다면 반항하지도 않았겠지."`
		)>>
	<<elseif $speechgrowl is 1 or $speechgrowlheat is 1 or $speechgrowlrut is 1>>
		<<print $_stringsPre + either(
			`"이 똥개 새끼가."`,
			`"필요하면 입마개라도 씌워주마."`,
			`"물어뜯고 싶으면 물어봐. 그 대가가 뭔지 똑똑히 보여줄 테니."`,
			`"길거리 똥개를 거둬준 대가가 이거군."`
		)>>
	<<elseif $speechstruggle is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"반항하지 마라."`,
				`"시간 낭비하게 하지 마."`,
				`"넌 아무 데도 못 간다."`,
				`"일 귀찮게 만들지 마라."`,
				`"저항하지 마."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"그만 움직여라, 이 새끼야."`,
				`"그만 좀 꿈틀거려, 빌어먹을 꼬맹아."`,
				`"적당히 해라."`,
				`"내 인내심을 시험하지 마라."`,
				`"네 무덤만 더 파고 있을 뿐이다."`
			)>>
		<</if>>
	<<elseif $speechspank is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"뭘 배웠는지 깨달았나?"`,
				`"네가 진 빚에서 까주마."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"더 세게 쳐달라고? 좋아."`,
				`"네가 자초한 일이다."`,
				`"이건 내 시간을 낭비하게 만든 대가다."`,
				`"네가 주제 파악을 할 때까지 멈추지 않겠다."`,
				`"거슬리게 굴면 이렇게 되는 거다."`
			)>>
		<</if>>
	<<elseif $speechcum is 1>>
		<<print $_stringsPre + either(
			`"감사하게 여기길 바란다."`,
			`"나를 기억하게 만들 기념품이다."`,
			`"작별 선물이라고 쳐두지."`
		)>>
	<<elseif $arousal gte 9500>>
		<<print $_stringsPre + either(
			`"표정 좋군. 네가 그렇게 달아올라 헐떡이는 꼴을 보려고 큰돈을 낼 놈들이 많을 거다."`,
			`"카메라를 가져왔어야 했는데. 네 프로필 사진으로 쓰면 딱 좋겠군."`
		)>>
	<<elseif $enemyanger lte 60>>
		<<if $rng gte 81>>
			<<set $_options to ["default"]>>
			<<if $hairlength gte 600>>
				<<run $_options.push("hair")>>
			<</if>>
			<<if $player.breastsize gte 6 or $player.penissize gte 4>>
				<<run $_options.push("cow")>>
			<</if>>
			<<if $athletics gte 750 or $physique gte $physiquesize * 0.75>>
				<<run $_options.push("healthy")>>
			<</if>>
			<<switch $_options[random(0, $_options.length - 1)]>>
				<<case "hair">><<print $_stringsPre + `"머리는 계속 길렀나? 이런 걸 좋아할 놈을 알지."`>>
				<<case "cow">><<print $_stringsPre + `"요즘은 젖소가 비싼 값에 팔린다는 거 알 거다."`>>
				<<case "healthy">><<print $_stringsPre + `"체력이 좋군. 마음에 들어. 거칠게 반항하는 걸 돈 주고 볼 놈들도 있거든."`>>
				<<case "default">><<print $_stringsPre + `"불필요하게 힘 빼지 마라."`>>
			<</switch>>
		<<else>>
			<<print $_stringsPre + either(
				`"긴장 풀어. 평소처럼 내가 알아서 처리할 테니."`,
				`"넌 항상 최고로 예쁜 꼬마 ` + ["새끼","자식","<<bitch>>"][random(0,2)] + `【이었였】지."`,
				`"이러는 게 훨씬 편할 거다. 날 믿어."`,
				`"가만히 있어."`,
				`"배우는 속도가 빠르군. 좋아."`,
				`"가만히 있어라. 거의 다 끝나가니까."`,
				`"가만히 있어. 둘 다 시간 낭비일 뿐이다."`,
				`"넌 항상 제일 다루기 힘든 녀석이었지. 너도 알고 있길 바란다."`
			)>>
		<</if>>
	<<else>>
		<<if $rng gte 91 and $enemyanger lte 70>>
			<<print $_stringsPre + `"가기 전에 물건 상태 좀 확인해 봐야겠군."`>>
		<<else>>
			<<print $_stringsPre + either(
				`"왜 꼭 스스로 일을 꼬이게 만드는 거냐?"`,
				`"가만히 있으라고 했을 텐데."`,
				`"너 때문에 우리 둘 다 힘들어지잖아."`,
				`"네가 선택한 길이다."`,
				`"이제 내 말 들을 마음이 생겼나?"`,
				`"널 비싼 값에 사겠다는 호구 새끼가 있거든."`,
				`"넌 나랑 같이 가는 거다, 잔말 마."`,
				`"이 성가신 상황을 만든 값도 청구하마."`,
				`"계속 발악해봐. 그 끝이 어딘지 똑똑히 보여줄 테니."`,
				`"네가 움직일 때마다 내 돈이 깎인단 말이다."`,
				`"얌전히 굴었으면 진작에 끝났을 일이다."`,
				`"그만 꿈틀대. 넌 아무 데도 못 가니까."`,
				`"네가 반항하는 매 초마다 네 빚이 늘어날 거다."`
			)>>
		<</if>>
	<</if>>
<</widget>>
