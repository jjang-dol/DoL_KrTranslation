:: Widgets speech-Eden [widget]
<<widget "speech-eden">>
	<<set _npc_speech to true>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Eden") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Eden")>>
		<<He>>【이가】 말한다. "네 순결을 느꼈다. 어쩔 수 없었어. 널 취해야 했으니까."
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Eden">>
		<<He>>【이가】 말한다. "지금은 아프겠지만 곧 익숙해질 거다."
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Eden">>
		<<He>>【이가】 말한다. "제길, 느낌 좋네. 우리 앞으로 더 자주 하게 될 거다."
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Eden">>
		<<He>>【이가】 말한다. "어땠지? 난 아직 안 끝났다."
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Black Wolf" "Great Hawk">>
				<<He>>【이가】 말한다. "기회만 생기면 저건 널 갈가리 찢어버릴 거다. 피해 다녀."
			<<case "Gwylan">>
				<<He>>【이가】 굳는다. "그 망할 마녀도 널 내게서 빼앗으려 드는 건가?"
			<<default>>
				<<He>>【이가】 말한다. "그게 누구든, 잊어버려." <<He>>【이가】 상처받은 목소리로 말한다.
		<</switch>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
		에덴이 당신의 $_sexToy【을를】 쳐다본다. "이런 건 필요 없어," <<he>>【이가】 말한다. "방해만 된다."
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
	<<if $daily.eden.huntCaught gte 1>>
		<<switch $daily.eden.huntCaught>>
			<<case 1>> "누가 감히 널 건드려?" 에덴이 으르렁거린다.
			<<case 2>> "넌 내 거야," 에덴이 딱딱하게 말한다.
			<<case 3>> "넌 내 거다," 에덴이 말한다. "나만의 것."
			<<case 4>> "너한테 이럴 수 있는 건 나뿐이야," 에덴이 말한다.
			<<case 5>> "누구든 네 몸에 손을 댄다면," 에덴이 말한다. "다 죽은 목숨이다."
			<<case 6>> "오직 나만이 널 이렇게 안을 수 있다," 에덴이 속을 끓이며 말한다.
			<<case 7>> "말해," 에덴이 으르렁거린다. "넌 내 거라고."
			<<case 8>> "넌 내 소유다," 에덴이 말한다. "나만의 소유."
			<<case 9>> "네 주인이 누군지 잊지 마," 에덴이 말한다.
			<<case 10>> "네 머리카락 한 올까지도 다 내 거다," 에덴이 으르렁거린다.
		<</switch>>
		<<set $daily.eden.huntCaught to ($daily.eden.huntCaught + 1) % 10>>
		<<unset _noNameComment>>
	<</if>>
	<<if $daily.eden.robinCrash gte 1>>
		<<switch $daily.eden.robinCrash>>
			<<case 1>> "<<nnpc_He "Robin">> 따위가 널 지킬 순 없다," 에덴이 으르렁거린다.
			<<case 2>> "오직 나만이 널 지킨다," 에덴이 말한다.
			<<case 3>> "너를 먹여 살리는 건 나다," 에덴이 말한다.
			<<case 4>> "널 돌보는 건 나라고," 에덴이 소리친다.
			<<case 5>> "<<nnpc_He "Robin">>【이가】 마을에서 널 구해낸 게 아냐," 에덴이 코웃음 친다. "내가 구했지."
			<<case 6>> "내겐 너뿐이다," 에덴이 말한다.
			<<case 7>> "그리고 넌 나만 있으면 된다," 에덴이 말한다.
			<<case 8>> "다른 놈들은 그저 소음에 불과해," 에덴이 말한다.
			<<case 9>> "절대 널 놓아주지 않겠다," 에덴이 말한다.
			<<case 10>> "너는 오직 내 거다," 에덴이 으르렁거린다. "다른 놈들은 머릿속에서 완전히 지워주마."
		<</switch>>
		<<set $daily.eden.robinCrash to ($daily.eden.robinCrash + 1) % 10>>
		<<unset _noNameComment>>
	<</if>>
<</widget>>
