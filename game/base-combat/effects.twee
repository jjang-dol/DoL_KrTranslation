			<<elseif $orgasmdown gte 1>>
				<<sex 5 "genitals" $feettarget>><<set $speechleglock to 1>><<personselect $feettarget>>
				<span class="lewd">당신은 절정에 다다르자 <<combatperson $feettarget>>에게 더욱 강하게 <<if $position is "missionary">>다리를 감으며<<else>>다리로 밀착하며<</if>>, <<his>> 도주를 막는다. </span>
			<<else>>
				<<set $feetactiondefault to "legLock">><<set $feetuse to 0>><<unset $leglocktarget>>
				<span class="blue">당신은 <<combatperson $feettarget>>에게 <<if $position is "missionary">>다리를 감은 상태를 유지하려<<else>>다리로 계속 밀착하려<</if>> 하지만 <<he>>【은는】 용케 당신의 다리를 벌려 떼어낸다.</span>
			<</if>>
		<</if>>

		<<if $feetaction is "legRelease">>
			<<set $feetaction to 0>><<set $feetactiondefault to "legRelease">><<personselect $feettarget>>
			당신은 <<if $position is "missionary">>다리를 풀어<<else>>밀착하는 것을 멈춰<</if>>, <<combatperson $feettarget>>【이가】 빠져나가게 해준다.
			<<set $feetuse to 0>><<unset $leglocktarget>>
		<</if>>

		/*Stalked actions */
		<<if !$stalk_end>>
			<<if $feetaction is "walk">>
				<<if $earSlime.growth gt 50 and $earSlime.growth - random(0, Math.clamp(75 - ($earSlime.defyCooldown * 5), 0, 75)) gte (currentSkillValue('willpower')/ 10) and hasSexStat("exhibitionism", 2)>>
					당신은 걷고 있었지만, <span class="red">갑자기 몸이 다르게 움직이는 것을 느낀다.</span> 슬라임이 당신의 통제력을 빼앗는 것이 느껴진다.
					<<set $feetaction to "strut">>
				<<else>>
					<<set $feetaction to 0>><<set $feetactiondefault to "walk">>
					<<set $feetuse to "walk">>
					당신은 계속 걷는다,
					<<if $control gte ($controlmax * 0.8)>>
						확고하고 흔들림 없는 발걸음으로.
					<<elseif $control gte ($controlmax * 0.6)>>
						한 발 한 발 앞을 향해 딛으며.
					<<elseif $control gte ($controlmax * 0.4)>>
						점점 가까워지는 발소리에 걱정하면서도.
					<<elseif $control gte ($controlmax * 0.2)>>
						최선을 다해 침착함을 유지하며.
					<<else>>
						달려가고 싶은 충동을 억누르며.
					<</if>>
					<<stalk_walk_events>>
				<</if>>
			<</if>>

			<<if $feetaction is "strut">>
				<<set $feetaction to 0>><<set $feetactiondefault to "strut">>
				<<set $feetuse to "strut">>
				당신은 거드름을 피우며 걷는다,
				<<if $control gte ($controlmax * 0.8)>>
					어깨와 엉덩이를 흔들며.
				<<elseif $control gte ($controlmax * 0.6)>>
					한 발 한 발 앞을 향해 딛으며.
				<<elseif $control gte ($controlmax * 0.4)>>
					점점 가까워지는 발소리에 걱정하면서도.
				<<elseif $control gte ($controlmax * 0.2)>>
					최선을 다해 침착함을 유지하며.
				<<else>>
					달려가고 싶은 충동을 억누르며.
				<</if>>
				<<meek 3>>
				<<stalk_walk_events>>
			<</if>>

			<<if $feetaction is "run">>
				<<set $feetaction to 0>><<set $feetactiondefault to "run">>
				<<if $mouthaction is "taunt" and !$stalk_end>>
					<<stalk_taunt_effects>>
				<<elseif _stalkNoRunning is "chastity parasite">>
					<<set $feetactiondefault to "walk">><<set $feetuse to "walk">>
					<<if $earSlime.growth gte 150>><<set $earSlime.defyCooldown++>><</if>>
					당신은 달리려 하지만, <span class="lewd">느껴지는 쾌감이 너무 강해 달릴 수 없다는 것을 깨닫는다.</span>
					<<stalk_walk_events>>
				<<elseif $earSlime.growth - random(0, Math.clamp(110 - ($earSlime.defyCooldown * 10), 0, 110)) gte (currentSkillValue('willpower')/ 10)>>
					<<if $earSlime.growth gt 50 and hasSexStat("exhibitionism", 2)>>
						<<set $feetactiondefault to "strut">><<set $feetuse to "strut">>
						당신은 달리려 하지만, <span class="red">갑자기 자신이 거드름을 피우며 걷고 있다는 것을 깨닫는다.</span> 슬라임이 당신의 통제력을 빼앗는 것이 느껴진다.
						<<meek 3>>
					<<else>>
						<<set $feetactiondefault to "walk">><<set $feetuse to "walk">>
						당신은 달리려 하지만, <span class="red">더 이상 빠르게 움직일 수 없다는 것을 깨닫는다.</span> 슬라임이 당신의 통제력을 빼앗는 것이 느껴진다.
					<</if>>
					<<if $daily.stalkWillpower lt 20>>
						<<gwillpower>><<willpower 1>>
						<<set $daily.stalkWillpower to ($daily.stalkWillpower or 0) + 1>>
					<</if>>

					<<stalk_walk_events>>
				<<elseif $NPCList[0].state is "pursuit">>
					<<if $feetuse isnot "run">>
						당신은 뛰기 시작하여 도둑을 쫓는다.
						<<stalk_run>>
					<<else>>
						당신은 도둑을 쫓는다.
					<</if>>
					<<if !$stalk_event>>
						<<run_text>>
					<</if>>
					<<if $worn.feet.type.includes("heels")>>
						<<if currentSkillValue("feetskill") gte random(1, 1000)>>
							<<set _stalk_feet to true>>
						<<else>>
							<<set _stalk_feet to false>>
						<</if>>
					<<else>>
						<<set _stalk_feet to true>>
					<</if>>
					<<if currentSkillValue('athletics') gte random(1, $NPCList[0].skills.athletics)>>
						<<set _stalk_athletics to true>>
					<<else>>
						<<set _stalk_athletics to false>>
					<</if>>
					<<if _stalk_athletics and _stalk_feet>>
						<span class="teal">당신은 따라잡는다.</span>
						<<set $NPCList[0].distance -= 2>>
					<<else>>
						<span class="red"><<He>>【이가】 당신을 앞지른다.</span>
						<br>
					<</if>>
					<<stalk_run_events>>
				<<elseif $NPCList[0].state is "chased">>
					<<if $feetuse isnot "run">>
						당신은 뛰기 시작하여 사냥감을 쫓는다.
						<<stalk_run>>
					<<else>>
						당신은 사냥감을 쫓는다.
					<</if>>
					<<if !$stalk_event>>
						<<run_text>>
					<</if>>
					<<if $worn.feet.type.includes("heels")>>
						<<if currentSkillValue("feetskill") gte random(1, 1000)>>
							<<set _stalk_feet to true>>
						<<else>>
							<<set _stalk_feet to false>>
						<</if>>
					<<else>>
						<<set _stalk_feet to true>>
					<</if>>
					<<if currentSkillValue('athletics') gte random(1, $NPCList[0].skills.athletics)>>
						<<set _stalk_athletics to true>>
					<<else>>
						<<set _stalk_athletics to false>>
					<</if>>
					<<if _stalk_athletics and _stalk_feet>>
						<span class="teal">당신은 따라잡는다.</span>
						<<set $NPCList[0].distance -= 2>>
					<<else>>
						<span class="red"><<He>>【이가】 당신을 앞지른다.</span>
						<br>
					<</if>>
					<<stalk_run_events>>
				<<else>>
					<<if $feetuse isnot "run">>
						당신은 냅다 뛰기 시작한다.
						<<if $NPCList[0].fullDescription is "Ivory Wraith" or $NPCList[0].bold * 2 gte random(1, 1000)>>
							등 뒤의 발소리가 빨라진다. <span class="red">당신은 쫓기고 있다.</span>
							<<stalk_run>>
							<<if $worn.feet.type.includes("heels")>>
								<<if currentSkillValue("feetskill") gte random(1, 1000)>>
									<<set _stalk_feet to true>>
								<</if>>
							<<else>>
								<<set _stalk_feet to true>>
							<</if>>
							<<if currentSkillValue('athletics') gte random(1, $NPCList[0].skills.athletics)>>
								<<set _stalk_athletics to true>>
							<<else>>
								<<set _stalk_athletics to false>>
							<</if>>
							<<if _stalk_athletics and _stalk_feet>>
								<span class="teal">발소리가 멀어진다.</span>
								<<set $NPCList[0].distance += 2>>
							<<else>>
								<span class="red">발소리가 가까워진다.</span>
							<</if>>
						<<else>>
							<span class="teal">아무도 쫓아오지 않는다.</span>
							<<set $stalk_end to "escaped">>
						<</if>>
					<<else>>
						당신은 계속 달린다.
						<<if !$stalk_event>>
							<<run_text>>
						<</if>>
						<<if $worn.feet.type.includes("heels")>>
							<<if currentSkillValue("feetskill") gte random(1, 1000)>>
								<<set _stalk_feet to true>>
							<</if>>
						<<else>>
							<<set _stalk_feet to true>>
						<</if>>
						<<if currentSkillValue('athletics') gte random(1, $NPCList[0].skills.athletics)>>
							<<set _stalk_athletics to true>>
						<<else>>
							<<set _stalk_athletics to false>>
						<</if>>
						<<if _stalk_athletics and _stalk_feet>>
							<span class="teal">발소리가 멀어진다.</span>
							<<set $NPCList[0].distance += 2>>
						<<else>>
							<span class="red">발소리가 가까워진다.</span>
						<</if>>
					<</if>>
					<<if $NPCList[0].distance gte 5>>
						<span class="green">당신은 그들을 멀리 따돌리고,</span> 안전한 곳으로 탈출한다.
						<<set $stalk_end to "escaped">>
					<<else>>
						<<stalk_run_events>>
					<</if>>
				<</if>>
			<</if>>

			<<if $feetaction is "stand">>
				<<set $feetaction to 0>><<set $feetactiondefault to "stand">>
				<<if $control gte ($controlmax * 0.8)>>
					당신은 단단히 발을 딛고 가만히 서 있는다.
				<<elseif $control gte ($controlmax * 0.6)>>
					당신은 가만히 서서 심호흡을 한다.
				<<elseif $control gte ($controlmax * 0.4)>>
					긴장됨에도 불구하고, 당신은 가만히 서 있는다.
				<<elseif $control gte ($controlmax * 0.2)>>
					두려움에도 불구하고, 당신은 가만히 서 있는다.
				<<else>>
					공포에 떨면서도, 당신은 가만히 서 있는다.
				<</if>>
				<<set $NPCList[0].distance to 0>>
			<</if>>

			<<if $feetaction is "hobble">>
				<<set $feetaction to 0>><<set $feetactiondefault to "hobble">>
				<<if $leftleg is "bound" or $rightleg is "bound">>
					당신은 묶인 다리가 허락하는 한 최대한 빨리 절뚝거리며 걷는다,
				<<else>>
					당신은 익숙하지 않은 하이힐이 허락하는 한 최대한 빨리 절뚝거리며 걷는다,
				<</if>>
				<<if $control gte ($controlmax * 0.8)>>
					어려운 상황에도 불구하고 흔들림 없는 발걸음으로.
				<<elseif $control gte ($controlmax * 0.6)>>
					넘어지지 않도록 조심하며.
				<<elseif $control gte ($controlmax * 0.4)>>
					뒤에서 들려오는 발소리에 대한 커져가는 두려움을 억누르며.
				<<elseif $control gte ($controlmax * 0.2)>>
					침착함을 유지하려 애쓰며.
				<<else>>
					공포에 질려 움츠러들고 싶은 충동을 억누르며.
				<</if>>
			<</if>>

			<<if $feetaction is "hide">>
				<<set $feetaction to 0>><<set $feetactiondefault to "hide">>
				<<set _difficulty to $NPCList[0].skills.security>>
				<<set _difficulty += $liquidcount * 20>>
				<<if currentSkillValue('skulduggery') gte random(1, _difficulty)>>
					<<set _hide_success to true>>
				<</if>>
				<<if $earSlime.growth - random(0, Math.clamp(75 - ($earSlime.defyCooldown * 5), 0, 75)) gte (currentSkillValue('willpower')/ 10)>>
					<<if $earSlime.growth gte 150>><<set $earSlime.defyCooldown++>><</if>>
					<<if $earSlime.growth gt 50 and hasSexStat("exhibitionism", 2)>>
						<<set $feetactiondefault to "strut">><<set $feetuse to "strut">>
						당신은 숨으려 하지만, <span class="red">갑자기 자신이 거드름을 피우며 걷고 있다는 것을 깨닫는다.</span> 슬라임이 당신의 통제력을 빼앗는 것이 느껴진다.
						<<meek 3>>
					<<else>>
						<<set $feetactiondefault to "walk">><<set $feetuse to "walk">>
						당신은 숨으려 하지만, <span class="red">더 이상 빠르게 움직일 수 없다는 것을 깨닫는다.</span> 슬라임이 당신의 통제력을 빼앗는 것이 느껴진다.
					<</if>>
					<<if $daily.stalkWillpower lt 20>>
						<<gwillpower>><<willpower 1>>
						<<set $daily.stalkWillpower to ($daily.stalkWillpower or 0) + 1>>
					<</if>>

					<<stalk_walk_events>>
				<<elseif _hide_success and ($NPCList[0].state is "pursuit" or $NPCList[0].state is "chased")>>
					<<switch $location>>
						<<case forest lake>>
							당신은 나무 뒤에 숨어서 아무도 보지 않기를 바란다.
						<<case moor>>
							당신은 작은 언덕 뒤에 웅크리고 아무도 보지 않기를 바란다.
						<<default>>
							당신은 작은 골목으로 몸을 날려 쓰레기통 뒤에 숨는다.
					<</switch>>
					<<set $stalk_end to "hide">>
				<<elseif !_hide_success and ($NPCList[0].fullDescription isnot "Ivory Wraith" and ($NPCList[0].legs is "run" or $NPCList[0].bold gte random(1, 1000))
				or $NPCList[0].fullDescription is "Ivory Wraith" and C.npc["Ivory Wraith"].lust gte random(5,15))>>
					<<switch $location>>
						<<case alley>>
							당신은 좁은 골목으로 몸을 날려 쓰레기통 뒤에 숨는다. 모퉁이 너머를 살짝 엿본다. 아무도 보이지 않는다.
						<<case forest lake>>
							당신은 빽빽한 덤불 속으로 달려가 두꺼운 나무 기둥 뒤에 숨는다. 옆을 살짝 엿본다. 아무도 보이지 않는다.
						<<case moor>>
							당신은 작은 언덕을 넘어 도랑으로 뛰어든다. 위를 올려다보지만 아무도 보이지 않는다.
						<<default>>
							당신은 좁은 골목으로 몸을 날려 쓰레기통 뒤에 숨는다. 옆을 살짝 엿본다. 아무도 보이지 않는다.
					<</switch>>
					<span class="red">그때, 어떤 기척이 느껴진다.</span>
					<<set $NPCList[0].distance to 0>>

					/* Prevents stalking mouth actions from appearing once the encounter starts */
					<<set $mouthaction to 0>><<set $mouthactiondefault to "rest">>

					<<if $npcrow.includes(0)>>
						<<stalk_nnpc_text_attack $NPCList[0].fullDescription>>
						<<if !$stalk_assess>>
							<<if $NPCList[0].fullDescription is "Ivory Wraith">>
								<span class="red"><<if $wraith.seen gte 3>>익숙한 <</if>>창백한 형체가 당신을 내려다보고 있고, 그 눈은 <<wraithEyes "adv">> 번뜩이고 있다.</span>
							<<else>>
								<span class="pink"><<print window.KR.gatPersonNameDictKR($npc[$npcrow.indexOf(0)])>>【이】다.</span>
							<</if>>
							<<set $stalk_assess to true>>
						<</if>>
						<br><br>
						<<events_stalk_nnpc $NPCList[0].fullDescription>>
					<<else>>
						<br><br>
						<<events_stalk>>
					<</if>>
				<<else>>
					<<switch $location>>
						<<case alley>>
							당신은 좁은 골목으로 몸을 날려 쓰레기통 뒤에 숨는다.
							<<if $NPCList[0].fullDescription isnot "Ivory Wraith">>
								<span class="green"><<if $enemyno gt 1>>그들은<<else>><<stalk_nnpc_name>>【은는】 <</if>> 당신이 있는 쪽을 쳐다보지도 않고 지나쳐 간다.</span>
							<</if>>
						<<case forest lake>>
							당신은 빽빽한 덤불 속으로 달려가 두꺼운 나무 기둥 뒤에 숨는다. 가장자리 너머로 살짝 엿본다.
							<<if $NPCList[0].fullDescription isnot "Ivory Wraith">>
								<span class="green"><<if $enemyno gt 1>>그들은<<else>><<stalk_nnpc_name>>【은는】 <</if>> 당신이 있는 쪽을 쳐다보지도 않고 지나쳐 간다.</span>
							<</if>>
						<<case moor>>
							당신은 작은 언덕을 넘어 도랑으로 뛰어든다.
							<<if $NPCList[0].fullDescription isnot "Ivory Wraith">>
								<<if $enemyno gt 1>>
									그들은 언덕 위에서 잠시 멈췄다가, <span class="green">당신 쪽을 쳐다보지도 않고 지나쳐 간다.</span>
								<<else>>
									<<stalk_nnpc_name>>【은는】 언덕 위에서 잠시 멈췄다가, <span class="green">당신 쪽을 쳐다보지도 않고 지나쳐 간다.</span>
								<</if>>
							<</if>>
						<<default>>
							당신은 좁은 골목으로 몸을 날려 쓰레기통 뒤에 숨는다. 옆을 살짝 엿본다.
							<<if $NPCList[0].fullDescription isnot "Ivory Wraith">>
								<span class="green"><<if $enemyno gt 1>>그들은<<else>><<stalk_nnpc_name>>【은는】 <</if>> 당신이 있는 쪽을 쳐다보지도 않고 지나쳐 간다.</span>
							<</if>>
					<</switch>>
					<<if $NPCList[0].fullDescription is "Ivory Wraith">>
						<<set $stalk_assess to true>>
						창백한 형체는 낄낄거리며 웃고는 <span class="teal">짙고 서늘한 안개 속으로 흩어진다</span>. 그 목소리가 당신 주위에 메아리친다.
						<<switch random(1, 3)>>
							<<case 3>><<set _wraith_output to "자기 자신에게서 도망칠 수 있는 시간은 한정되어 있다.">>
							<<case 2>><<set _wraith_output to "해가 지평선 아래에 잠든 동안.">>
							<<case 1>><<set _wraith_output to "그들이 빛을 잃기 전에.">>
						<</switch>>
						"<span class="wraith"><<print _wraith_output>></span>"
						<<trauma 2>><<stress 4>><<gtrauma>><<gstress>>
					<</if>>
					<<set $stalk_end to "hide">>
				<</if>>
			<</if>>

			<<if $feetaction is "confront">>
				<<famescrap 1>>
				당신은 몸을 홱 돌려 정면으로 마주친다,
				<<person1>>
				<<if $npcrow.includes(0)>>
					<<if $NPCList[0].fullDescription is "Ivory Wraith">>
						<<if $stalk_assess>>
							그 창백한 형체와.
						<<else>>
							어떤<<if $wraith.seen gte 3>> 익숙한<</if>> 창백한 형체와.
						<</if>>
					<<else>>
						<<if $stalk_assess>>
							<<if $enemyno gte 3>>
								<<print window.KR.getDescriptionKr($NPCList[0].fullDescription)>>【와과】 <<his>> 일행들과.
							<<elseif $enemyno is 2>>
								<<print window.KR.getDescriptionKr($NPCList[0].fullDescription)>>【와과】 <<his>> 일행과.
							<<else>>
								<<print window.KR.getDescriptionKr($NPCList[0].fullDescription)>>.
							<</if>>
						<<else>>
							<<if $enemyno gte 3>>
								어느 <<personsimple>>【와과】 <<his>> 일행들과.
							<<elseif $enemyno is 2>>
								어느 <<personsimple>>【와과】 <<his>> 일행과.
							<<else>>
								어느 <<personsimple>>【와과】.
							<</if>>
							<span class="pink"><<print window.KR.getDescriptionKr($NPCList[0].fullDescription)>>【이】다.</span>
						<</if>>
					<</if>>
				<<elseif $enemyno gte 3>>
					그 <<person>>【와과】 <<his>> 일행들과.
				<<elseif $enemyno is 2>>
					그 <<person>>【와과】 <<his>> 일행과.
				<<else>>
					그 <<person>>【와과】.
				<</if>>
				<<set $stalk_assess to true>>
				<<if !$worn.face.type.includes("gag")>>
					<<if $npcrow.includes(0)>>
						<<actionsconfrontNNPC>>
					<<else>>
						<<actionsconfront>>
					<</if>>
				<</if>>
				<br><br>
				<<if $combatgoal is "confront">>
					<<if $NPCList[0].fullDescription is "Ivory Wraith">>
						<<set $stalk_assess to true>>
						당신은 눈을 깜박인다. 눈을 떴을 때, <span class="red">창백한 형체가 당신의 얼굴 바로 앞까지 다가와 있다.</span>
					<<elseif $NPCList[0].fullDescription is "Gwylan">>
						<span class="red"><<He>>【이가】 달려들어 당신을 바닥에 넘어뜨린다.</span>
					<<else>>
						<span class="purple"><<He>>【은는】 당신 앞에 다가와 멈춰 선다.</span>
					<</if>>
					<br><br>
					<<set $NPCList[0].distance to 0>>
					<<set $stalk_end to "confront">>
				<<elseif $NPCList[0].fullDescription isnot "Ivory Wraith" and $NPCList[0].bold * 2 gte random(1, 1000)
				or $NPCList[0].fullDescription is "Ivory Wraith" and C.npc["Ivory Wraith"].lust gte random(1,10)>>
					<<if $NPCList[0].fullDescription is "Ivory Wraith">>
						당신은 눈을 깜박인다. 눈을 떴을 때, <span class="red">창백한 형체가 당신의 얼굴 바로 앞까지 다가와 있다.</span>
					<<elseif $NPCList[0].fullDescription is "Gwylan">>
						<span class="red"><<He>>【은는】 멈추지 않는다.</span>
					<<else>>
						<span class="red"><<He>>【이가】 당신을 향해 성큼성큼 다가온다.</span>
					<</if>>

					/* Prevents stalking mouth actions from appearing once the encounter starts */
					<<set $mouthaction to 0>><<set $mouthactiondefault to "rest">>

					<<if $NPCList[0].fullDescription is "Gwylan">>
						<<stalk_nnpc_text_attack $NPCList[0].fullDescription>>
						<<set $NPCList[0].distance to 0>>
						<<events_stalk_nnpc $NPCList[0].fullDescription>>
					<<else>>
						<<if $npcrow.includes(0)>>
							<<stalk_nnpc_text_attack $NPCList[0].fullDescription>>
						<<elseif $NPCList[0].traits.includes("relaxed")>>
							"그냥 장단 맞춰," <<he>>【이가】 말한다. "그게 너한테 편할 테니까."
						<<elseif $NPCList[0].traits.includes("sociable")>>
							"나 같은 <<gentleman_npc>>한테 그런 식으로 말하면 안 되지," <<he>>【이가】 말한다. "어떻게 보상해야 할지 알고 있겠지."
						<<elseif $NPCList[0].traits.includes("brooding")>>
							"세상 이치가 다 이런 거지," <<he>>【이가】 말한다. "곧 끝날 거야."
						<<else>>
							"진짜 죽여주게 꼴리네," <<he>>【이가】 말한다. "어차피 조만간 덮쳐질 텐데. 내가 먼저 맛 좀 봐야겠어."
						<</if>>
						<br><br>
						<<set $NPCList[0].distance to 0>>
						<<stalk_img>>
						<br><br>
						<<stalk_attack>>
					<</if>>
				<<else>>
					<<if $npcrow.includes(0)>>
						<<stalk_nnpc_text_threat $NPCList[0].fullDescription>>
					<<else>>
						<span class="green"><<He>>【은는】 두 손을 들어 올린다.</span>
						<<if $NPCList[0].traits.includes("relaxed")>>
							"진정해, <<girl>>【아야】," <<he>>【이가】 당신에게서 멀찌감치 떨어지며 말한다. "겁주려던 건 아니었어."
						<<elseif $NPCList[0].traits.includes("sociable")>>
							"젠장, <<girl>>【아야】," <<he>>【이가】 말한다. "내가 그렇게 못생겼냐?" <<He>>【은는】 당신에게서 멀찌감치 떨어진다.
						<<elseif $NPCList[0].traits.includes("brooding")>>
							그 <<person>>【은는】 웃음을 터뜨린다. "길거리가 너한테 그렇게 거칠게 군 거야?" <<he>>【이가】 묻는다. "공간을 좀 내주지."
						<<else>>
							"그냥 쳐다본 것뿐이야!" <<he>>【이가】 말한다. "아무 짓도 안 할 거야, 정말로." <<He>>【은는】 당신에게서 멀찌감치 떨어진다.
						<</if>>
						<br><br>

						<<He>>【은는】 앞서 걸어간다. 당신은 자신이 조금 바보같이 느껴진다.
					<</if>>
					<br><br>
					<<set $stalk_end to "passed">>
					<<set $NPCList[_n].distance to 1>>
				<</if>>
			<</if>>

			<<if $feetaction is "ambush" and !$stalk_end>>
				<<set $feetaction to 0>><<set $feetactiondefault to "run">>
				<<set _difficulty to $NPCList[0].skills.athletics>>
				<<if currentSkillValue('skulduggery') gte random(1, _difficulty)>>
					<<set _ambush_success to true>>
				<</if>>
				<<if $earSlime.growth - random(0, Math.clamp(75 - ($earSlime.defyCooldown * 5), 0, 75)) gte (currentSkillValue('willpower')/ 10)>>
					<<if $earSlime.growth gte 150>><<set $earSlime.defyCooldown++>><</if>>
					<<if $earSlime.growth gt 50 and hasSexStat("exhibitionism", 2)>>
						<<set $feetactiondefault to "strut">><<set $feetuse to "strut">>
						당신은 기습을 위해 숨으려 하지만, <span class="red">갑자기 자신이 거드름을 피우며 걷고 있다는 것을 깨닫는다.</span> 슬라임이 당신의 통제력을 빼앗는 것이 느껴진다.
						<<meek 3>>
					<<else>>
						<<set $feetactiondefault to "walk">><<set $feetuse to "walk">>
						당신은 기습을 위해 숨으려 하지만, <span class="red">더 이상 빠르게 움직일 수 없다는 것을 깨닫는다.</span> 슬라임이 당신의 통제력을 빼앗는 것이 느껴진다.
					<</if>>
					<<if $daily.stalkWillpower lt 20>>
						<<gwillpower>><<willpower 1>>
						<<set $daily.stalkWillpower to ($daily.stalkWillpower or 0) + 1>>
					<</if>>

					<<stalk_walk_events>>
				<<elseif !_ambush_success or $NPCList[0].fullDescription is "Ivory Wraith" and C.npc["Ivory Wraith"].lust gte random(5,15)>>
					<<switch $location>>
						<<case alley>>
							당신은 좁은 골목으로 몸을 날려 쓰레기통 뒤에 숨는다. 그리고 덮칠 준비를 한다.
						<<case forest lake>>
							당신은 빽빽한 덤불 속으로 달려가 두꺼운 나무 기둥 뒤에 숨는다. 그리고 덮칠 준비를 한다.
						<<case moor>>
							당신은 작은 언덕을 넘어 도랑으로 뛰어든다. 그리고 덮칠 준비를 한다.
						<<default>>
							당신은 좁은 골목으로 몸을 날려 쓰레기통 뒤에 숨는다. 그리고 덮칠 준비를 한다.
					<</switch>>
					<br><br>

					당신은 <<if $enemyno gt 1>>그들이<<else>><<him>>【이가】 <</if>> 가까이 온 것을 느끼자마자 뛰쳐나가 공격하지만,
					<<if $NPCList[0].fullDescription is "Ivory Wraith">>
						<span class="red">하지만 창백한 수많은 팔에 안겨들었을 뿐이다.</span>
					<<elseif $NPCList[0].fullDescription is "Gwylan">>
						<span class="red">하지만 <<him>>【은는】 재빠르게 피하고 도리어 당신을 붙잡는다.</span>
					<<else>>
						<span class="red">하지만 <<he>>【은는】 대비하고 있었다. <<He>>【은는】 당신을 붙잡아 바닥에 짓누른다.</span>
					<</if>>

					/* Prevents stalking mouth actions from appearing once the encounter starts */
					<<set $mouthaction to 0>><<set $mouthactiondefault to "rest">>
					<br><br>
					<<set $NPCList[0].distance to 0>>
					<<if $npcrow.includes(0)>>
						<<stalk_nnpc_text_attack $NPCList[0].fullDescription>>
						<<if !$stalk_assess>>
							<<if $NPCList[0].fullDescription is "Ivory Wraith">>
								<span class="red"><<if $wraith.seen gte 3>>익숙한 <</if>>창백한 형체가 당신을 내려다보고 있고, 그 눈은 <<wraithEyes "adv">> 번뜩이고 있다.</span>
							<<else>>
								<span class="pink"><<print window.KR.gatPersonNameDictKR($npc[$npcrow.indexOf(0)])>>【이】다.</span>
							<</if>>
						<</if>>
						<br><br>
						<<events_stalk_nnpc $NPCList[0].fullDescription>>
					<<else>>
						<br><br>
						<<stalk_attack>>
					<</if>>
				<<else>>
					<<switch $location>>
						<<case alley>>
							당신은 네 발로 좁은 골목으로 몸을 날린다. 제자리에서 재빠르게 방향을 틀어 쓰레기통 뒤에 숨은 뒤, 덮칠 준비를 한다.
						<<case forest lake>>
							당신은 네 발로 빽빽한 덤불 속으로 달려가 두꺼운 나무 기둥 뒤에 숨는다. 그리고 덮칠 준비를 한다.
						<<case moor>>
							당신은 작은 언덕을 넘은 후, 네 발로 재빠르게 돌아서 추격<<pluralise $enemyno "자" "자">>【을를】 마주 본다. 그리고 덮칠 준비를 한다.
						<<default>>
							당신은 네 발로 좁은 골목으로 몸을 날린다. 제자리에서 재빠르게 방향을 틀어 쓰레기통 뒤에 숨은 뒤, 덮칠 준비를 한다.
					<</switch>>
					<br><br>

					<<if $NPCList[0].fullDescription is "Ivory Wraith">>
						<<set $stalk_assess to true>>
						귓가에 심장 뛰는 소리가 울린다. 다가오는 소리는 들리지 않지만, 기척은 느낄 수 있다. 당신은 본능에 몸을 맡긴 채 엄폐물에서 뛰쳐나가 공격한다.
						<br><br>

						당신의 시야가 끔찍한 창백함으로 가득 차고, <span class="red">만지는 순간 차가운 안개 속으로 사라져버린다</span>. 당신은 고통스럽게 바닥에 나뒹군다. <<pain 4>><<gpain>>
						<br><br>

						그 목소리가 당신 주위에 메아리친다.
						<<switch random(1, 3)>>
							<<case 3>><<set _wraith_output to "추격은 꺾인다.">>
							<<case 2>><<set _wraith_output to "포식자는 제 자리를 기억한다.">>
							<<case 1>><<set _wraith_output to "손에 아무것도 쥐지 마라. 그것을 탐하라.">>
						<</switch>>
						"<span class="wraith"><<print _wraith_output>></span>"
						<<trauma 2>><<stress 4>><<gtrauma>><<gstress>>
					<<else>>
						당신의 예민한 귀가 발소리에 집중하고, 완벽한 타이밍을 기다린다. 숨어있던 곳에서 뛰쳐나간 당신은,
						<<if $npcrow.includes(0)>>
							<<if !$stalk_assess>>
								<span class="green">추격자를 넘어뜨린다.</span> <span class="pink"><<print window.KR.gatPersonNameDictKR($npc[$npcrow.indexOf(0)])>>【이】다.</span>
							<<else>>
								<span class="green"><<print window.KR.gatPersonNameDictKR($npc[$npcrow.indexOf(0)])>>【을를】 넘어뜨린다.</span>
							<</if>>
						<<else>>
							<span class="green"><<person1>><<person>>【을를】 넘어뜨린다. <<if $enemyno gt 1>><<His>> 일행은 충격에 빠져 물러난다.<</if>></span>
						<</if>>
					<</if>>
					<<set $stalk_end to "ambush">>
				<</if>>
			<</if>>
		<</if>>

		/*End of stalked actions */

		/***
		*    ██   ██  █████  ██   ██ ███████ ██   ██
		*    ███ ███ ██   ██ ██   ██   ███   ██   ██
		*    ██ █ ██ ██   ██ ██   ██   ███   ███████
		*    ██   ██ ██   ██ ██   ██   ███   ██   ██
		*    ██   ██  █████   █████    ███   ██   ██
		*
		*/
		<<if $newtarget isnot undefined>>
			<<setnewtarget>>
		<</if>>

		<<if $mouthaction is "rest">>
			<<set $mouthaction to 0>><<set $mouthactiondefault to "rest">>
		<</if>>

		<<if $mouthaction is "kissskin">>
			<<set $mouthaction to 0>><<actionskiss $mouthtarget>><<submission 3>><<set $mouthactiondefault to "kissskin">>
		<</if>>

		<<if $mouthaction is "kisslips">>
			<<set $mouthaction to 0>><<set $mouthactiondefault to "kisslips">><<personselect $mouthtarget>><<combatpromiscuity1>>
			<<if $NPCList[$mouthtarget].fullDescription is "Gwylan" and (C.npc.Gwylan.dom lt 50 or !$gwylanSeen?.includes("yearning"))>>
				당신은 입술을 <<hers>> 것에 가까이 가져가지만,
				<<if $NPCList[$mouthtarget].lefthand is 0 or $NPCList[$mouthtarget].rightthand is 0>>
					<<if $NPCList[$mouthtarget].lefthand is 0>>
						<<set $NPCList[0].lefthand to "mouth">><<he>>【은는】 <<his>> 손으로 당신의 입을 틀어막는다.
						<<set $mouthuse to "lefthand">>
					<<else>>
						<<set $NPCList[0].righthand to "mouth">><<he>>【은는】 <<his>> 손으로 당신의 입을 틀어막는다.
						<<set $mouthuse to "righthand">>
					<</if>>
				<<else>>
					<<he>>【은는】 몸을 피한다.
				<</if>>
				<span class="purple"><<He_Short>>【은는】 짜증이 난 듯 보인다.</span>
				<<set $enemytrust -= 40>><<set $enemyanger += 5>>
			<<elseif combatSkillCheck("oral", $mouthtarget)>>
				당신은 입술을 <<hers>> 것에 가까이 가져간다.
				<<set $mouthuse to "kiss">><<set $mouthstate to "kissentrance">>
				<<set $NPCList[$mouthtarget].mouth to "kissentrance">>
				<<set $NPCList[$mouthtarget].location.head = "head">>
			<<else>>
				당신은 얼굴을 <<hers>> 것에 가까이 가져가려 하지만 <<he>>【은는】 몸을 피한다.
			<</if>>
		<</if>>

		<<if $mouthaction is "growl">>
			<<set $mouthaction to 0>><<set $mouthactiondefault to "growl">><<set _sound to 1>>
			<<if playerAwareTheyAreInHeat()>>
				<<set $speechgrowlheat to 1>>
				<<submission 2>>
				당신은 으르렁거리려 하지만, <span class="pink">발정기 탓에 음탕하게 흐느끼는 소리로 들린다.</span>
			<<elseif playerRutMinArousal() or playerHeatMinArousal()>>
				<<set $speechgrowlrut to 1>>
				<<submission 2>>
				당신은 으르렁거리려 하지만, <span class="pink">러트 탓에 음탕하게 흐느끼는 소리로 들린다.</span>
			<<else>>
				<<set $speechgrowl to 1>>
				<<actionsgrowl>>
				<<brat 2>>
			<</if>>
		<</if>>

		<<if $mouthaction is "plead">>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "<<him>>에게 애원한다">>
				<<set $speechwheezeaction to "plead">>
			<<else>>
				<<set $mouthactiondefault to "plead">>
				<<actionsplead>><<set $speechplead to 1>>
				<<if $role is "islander" and (!$islander_language or $islander_language lt 100)>>
					<<if $enemyno gte 2>>그들은 당신의 말을 이해하지 못하지만<<else>><<He>>【은는】 당신의 말을 이해하지 못하지만<</if>>, 당신의 어조에는 반응한다.
				<</if>>
				<<meek `1 + $englishtrait`>>
			<</if>>
		<</if>>

		<<if $mouthaction is "moan">>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "야한 말을 한다" 2>><<set $speechmoan to 1>>
				<<set $speechwheezeaction to "moan">>
			<<else>>
				<<set $mouthactiondefault to "moan">>
				<<actionsmoan>><<set $speechmoan to 1>>
				<<if $role is "islander" and (!$islander_language or $islander_language lt 100)>>
					<<if $enemyno gte 2>>그들은 당신의 말을 이해하지 못하지만<<else>><<He>>【은는】 당신의 말을 이해하지 못하지만<</if>>, 당신의 어조에는 반응한다.
				<</if>>
				<<submission `1 + $englishtrait`>>
			<</if>>
		<</if>>

		<<if $mouthaction is "ask" and $askAction is "askchoke" and $askedtochoke isnot 1>>
			<<set $mouthaction to 0>><<unset $askAction>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "목을 졸라 달라고 부탁한다" 1>>
				<<set $speechwheezeaction to "askChoke">>
			<<else>>
				<<set $askedtochoke to 1>>
				<<set $mouthactiondefault to 0>>
				<<actionschoke>> /* todo: add a case where it doesn't work */
				<<if $role is "islander" and (!$islander_language or $islander_language lt 100)>>
					<span class="red"><<if $enemyno gte 2>>그들은 당신의 말을 이해하지 못하고<<else>><<He>>【은는】 당신의 말을 이해하지 못하고<</if>>,</span> 이를 무시한다.
				<</if>>
