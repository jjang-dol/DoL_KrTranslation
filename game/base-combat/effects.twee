					<span class="pink">"안 돼," <<if $enemyno gte 2>>그들이 웃는다<<else>><<he>>【이가】 웃는다<</if>>. "벗은 게 더 예쁠 텐데."</span>
				<<elseif combatSkillCheck("seduction", $mouthtarget, $NPCList[$mouthtarget].fullDescription) or $gamemode is "soft" or $gloryhole>>
					<<set $noupper to 1>><span class="green"><<if $enemyno gte 2>>그들은 알겠다는 듯 고개를 끄덕인다<<else>><<He_Short>>【은는】 알겠다는 듯 고개를 끄덕인다<</if>>.</span>
					<<for _j = 0; _j lt $enemynomax; _j++>>
						<<if $NPCList[_j].lefthand is "overupperclothes">>
							<<personselect _j>>
							<<set $NPCList[_j].lefthand to 0>><<combatPerson>>【이가】 당신의 $worn.over_upper.name【을를】 놓아준다.
						<<elseif $NPCList[_j].lefthand is "upperclothes">>
							<<personselect _j>>
							<<set $NPCList[_j].lefthand to 0>><<combatPerson>>【이가】 당신의 $worn.upper.name【을를】 놓아준다.
						<<elseif $NPCList[_j].lefthand is "underupperclothes">>
							<<personselect _j>>
							<<set $NPCList[_j].lefthand to 0>><<combatPerson>>【이가】 당신의 $worn.under_upper.name【을를】 놓아준다.
						<</if>>
						<<if $NPCList[_j].righthand is "overupperclothes">>
							<<personselect _j>>
							<<set $NPCList[_j].righthand to 0>><<combatPerson>>【이가】 당신의 $worn.over_upper.name【을를】 놓아준다.
						<<elseif $NPCList[_j].righthand is "upperclothes">>
							<<personselect _j>>
							<<set $NPCList[_j].righthand to 0>><<combatPerson>>【이가】 당신의 $worn.upper.name【을를】 놓아준다.
						<<elseif $NPCList[_j].righthand is "underupperclothes">>
							<<personselect _j>>
							<<set $NPCList[_j].righthand to 0>><<combatPerson>>【이가】 당신의 $worn.under_upper.name【을를】 놓아준다.
						<</if>>
					<</for>>
				<<else>>
					<<combatRequestRefused "noupper" $mouthtarget>>
				<</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "ask" and $askAction is "nomask">>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "<<him>>에게 당신의 "+ $worn.face.name " 벗기지 말라고 말한다">>
			<<else>>
				<<set $mouthactiondefault to "rest">><<brat 5 demanding>><<if !$gloryhole and $gamemode isnot "soft">><<seductionskillusecombat>><</if>><<unset $askAction>>
				<<set $nomaskasked to 1>>
				당신은 <<him>>에게 당신의 $worn.face.name【을를】 벗기지 말라고 말한다.

				<<if $role is "islander" and (!$islander_language or $islander_language lt 100)>>
					<span class="red"><<if $enemyno gte 2>>그들은<<else>><<He>>【은는】 <</if>> 당신의 말을 이해하지 못하고,</span> 말을 무시한다.
				<<elseif $combatgoal is "strip">>
					<span class="pink">"안 돼," <<if $enemyno gte 2>>그들이 웃는다<<else>><<he>>【이가】 웃는다<</if>>. "벗은 게 더 예쁠 텐데."</span>
				<<elseif combatSkillCheck("seduction", $mouthtarget, $NPCList[$mouthtarget].fullDescription) or $gamemode is "soft" or $gloryhole>>
					<<set $nomask to 1>><span class="green"><<if $enemyno gte 2>>그들은 알겠다는 듯 고개를 끄덕인다<<else>><<He_Short>>【은는】 알겠다는 듯 고개를 끄덕인다<</if>>.</span>
					<<for _j = 0; _j lt $enemynomax; _j++>>
						<<if $NPCList[_j].lefthand is "mask">>
							<<personselect _j>>
							<<set $NPCList[_j].lefthand to 0>><<combatPerson>>【이가】 당신의 $worn.face.name【을를】 놓아준다.
						<</if>>
						<<if $NPCList[_j].righthand is "mask">>
							<<personselect _j>>
							<<set $NPCList[_j].righthand to 0>><<combatPerson>>【이가】 당신의 $worn.face.name【을를】 놓아준다.
						<</if>>
					<</for>>
				<<else>>
					<<combatRequestRefused "nomask" $mouthtarget>>
				<</if>>
			<</if>>
		<</if>>

		<<if $mouthaction is "ask" and $askAction is "nochoke">>
			<<set $mouthaction to 0>><<unset $askAction>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "<<him>>에게 목 졸리고 싶지 않다고 말한다">>
			<<else>>
				<<set $mouthactiondefault to "rest">><<brat 5>><<if !$gloryhole and $gamemode isnot "soft">><<seductionskillusecombat>><</if>>
				당신은 <<him>>에게 <<his>> 손이 당신의 목을 조르는 것은 싫다고 말한다.
				<<if $role is "islander" and (!$islander_language or $islander_language lt 100)>>
					<span class="red"><<if $enemyno gte 2>>그들은<<else>><<He>>【은는】 <</if>> 당신의 말을 이해하지 못하고,</span> 말을 무시한다.
				<<elseif combatSkillCheck("seduction", $mouthtarget, $NPCList[$mouthtarget].fullDescription) or $gamemode is "soft" or $gloryhole>>
					<<set $nochoke to 1>><span class="green"><<if $enemyno gte 2>>그들은 알겠다는 듯 고개를 끄덕인다<<else>><<He_Short>>【은는】 알겠다는 듯 고개를 끄덕인다<</if>>.</span>
					<<if $neckuse is "hand">>
						<<unset $neckuse>>
						<<for _j = 0; _j lt $enemynomax; _j++>>
							<<if $NPCList[_j].lefthand is "throat" or $NPCList[_j].righthand is "throat">>
								<<personselect _j>>
								<<if $NPCList[_j].lefthand is "throat">><<set $NPCList[_j].lefthand to 0>><</if>>
								<<if $NPCList[_j].righthand is "throat">><<set $NPCList[_j].righthand to 0>><</if>>
								<<combatPerson>>【이가】 당신의 목을 놓아준다.
							<</if>>
						<</for>>
					<</if>>
				<<else>>
					<<combatRequestRefused "nochoke" $mouthtarget>>
					<<for _j = 0; _j lt $enemynomax; _j++>>
						<<if $NPCList[_j].lefthand is 0>>
							<<personselect _j>>
							<<set $NPCList[_j].lefthand to "throat">>
							<<set $neckuse to "hand">>
							<span class="red"><<combatPerson>>【이가】 즉시 빈손으로 당신의 목을 움켜쥔다.</span>
							<<break>>
						<<elseif $NPCList[_j].righthand is 0>>
							<<personselect _j>>
							<<set $NPCList[_j].lefthand to "throat">>
							<<set $neckuse to "hand">>
							<span class="red"><<combatPerson>>【이가】 즉시 빈손으로 당신의 목을 움켜쥔다.</span>
							<<break>>
						<</if>>
					<</for>>
				<</if>>
			<</if>>
		<</if>>

		/* Ask <<him>> to put a condom on */
		<<if $mouthaction is "ask" and $askAction is "condoms">>
			<<set $mouthaction to 0>><<unset $askAction>><<set _sound to 1>>
			<<personselect $mouthtarget>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $settings.asphyxiaLevel gte 2>>
				<<wheeze "<<him>>에게 콘돔을 쓰라고 말한다">>
			<<else>>
				<<set $mouthactiondefault to "rest">><<sub 2>>
				<<if $NPCList[$mouthtarget].condom and $NPCList[$mouthtarget].condom.willUse is true>><<set $_checkSkip to true>><</if>>
				<<if $consensual is 0>>
					<<set $_condomAskBaseDifficulty to 2000 + 10 * (100 - $NPCList[$mouthtarget].pregnancyAvoidance)>>
					<<set $_condomAskDifficultyMultiplier to 200>>
				<<else>>
					<<set $_condomAskBaseDifficulty to 1500 + 5 * (100 - $NPCList[$mouthtarget].pregnancyAvoidance)>>
					<<set $_condomAskDifficultyMultiplier to 100>>
				<</if>>
				<<if !$gloryhole and $gamemode isnot "soft" and !$npcrow.includes($mouthtarget) and !$_checkSkip>><<seductionskillusecombat>><</if>>
				<<set $NPCList[$mouthtarget].condomAsk to true>>
				당신은 <<combatperson>>에게 콘돔을 사용해 달라고 부탁한다.
				<<if $role is "islander" and (!$islander_language or $islander_language lt 100)>>
					<span class="red"><<if $enemyno gte 2>>그들은<<else>><<He>>【은는】 <</if>> 당신의 말을 이해하지 못하고,</span> 말을 무시한다.
				<<elseif combatSkillCheck("seduction", $mouthtarget, $NPCList[$mouthtarget].fullDescription, $_condomAskBaseDifficulty, $_condomAskDifficultyMultiplier) or $gamemode is "soft" or $gloryhole or $npcrow.includes($mouthtarget) or $_checkSkip>>
					<<if !$npcrow.includes($mouthtarget)>>
						<<if $settings.condomLevel is 1 or !$NPCList[$mouthtarget].condom>>
							<<set $NPCList[$mouthtarget].condomCanGive to true>>
							<<if $consensual is 0>>
								<<He_Short>>【은는】 대답하기 전 잠시 멈칫한다.
								<<set _response to [
									"네가 가지고 있다면 쓸게.",
									"네가 하나 챙겨왔길 바라.",
									"난 없는데. 너 혹시 있어?",
									"집에 깜빡 두고 온 모양이네.",
									"너한테 하나 있는 게 좋을 텐데."
								]>>
							<<else>>
								<<He_Short>>【은는】 잠시 초조한 표정을 짓는다.
								<<set _response to [
									"안 가져왔어. 너한테 있어?"
								]>>
							<</if>>
							<span class="blue">"<<print _response.pluck()>>"</span>
						<<elseif $NPCList[$mouthtarget].condom>>
							<<if $NPCList[$mouthtarget].condom.willUse is true>>
								<<if $consensual is 0>>
									<<He_Short>>【은는】 고개를 끄덕인다.
									<<set _response to [
										"어차피 그럴 생각이었어.",
										"이래라저래라 하지 마, 어차피 그럴 거였으니까.",
										"내가 너한테 노콘으로 박을 줄 알았냐? 멍청한 걸레년."
									]>>
								<<else>>
									<<He_Short>>【은는】 고개를 끄덕인다.
									<<set _response to [
										"어차피 하나 쓸 계획이었어."
									]>>
								<</if>>
								<<if $settings.pregnancySpeechEnabled>>
									<<if playerPregnancyPossibleWith($NPCList[$mouthtarget])>>
										<<run _response.pushUnique(
											"내가 애를 책임지고 싶어 하는 것처럼 보이냐?",
											"널 임신시키긴 싫거든, 걸레년아.",
											"너 같은 창녀를 임신시킬 생각은 없어."
										)>>
									<<elseif NPCPregnancyPossibleWithPlayer($NPCList[$mouthtarget])>>
										<<run _response.pushUnique(
											"내가 애를 책임지고 싶어 하는 것처럼 보이냐?",
											"내가 임신할 생각은 없거든.",
											"네가 내 안에 애를 만들게 두진 않을 거니까."
										)>>
									<</if>>
								<</if>>
								<span class="teal">"<<print _response.pluck()>>"</span>
							<<else>>
								<<set $NPCList[$mouthtarget].condom.willUse to true>>
								<<if $consensual is 0>>
									<<He_Short>>【은는】 대답하기 전 잠시 멈칫한다.
									<<set _response to [
										"당연하지, 걸레년.",
										"그래, 너한테 무슨 병이 옮을지도 모르니까.",
										"좋아, 대신 협조적으로 나오길 바란다.",
										"좋은 생각이군, 나한테 증거가 남는 건 귀찮으니까."
									]>>
								<<else>>
									<<He_Short>>【은는】 알겠다는 듯 고개를 끄덕인다.
									<<set _response to [
										"만약을 대비해 하나 챙겨왔지."
									]>>
								<</if>>
								<<if $settings.pregnancySpeechEnabled>>
									<<if playerPregnancyPossibleWith($NPCList[$mouthtarget])>>
										<<run _response.pushUnique(
											"애를 감당하긴 싫으니까.",
											"널 임신시키긴 싫어.",
											"내 이름이 붙은 애새끼가 생기는 건 딱 질색이거든."
										)>>
									<<elseif NPCPregnancyPossibleWithPlayer($NPCList[$mouthtarget])>>
										<<run _response.pushUnique(
											"애를 감당하긴 싫으니까.",
											"내가 임신할 생각은 없거든.",
											"네가 내 안에 애를 만들게 두진 않을 거니까."
										)>>
									<</if>>
								<</if>>
								<span class="green">"<<print _response.pluck()>>"</span>
							<</if>>
						<</if>>
					<<else>>
						/*Named NPC section*/
						/*If the NPC does not have a condom, or NPC condoms are disabled*/
						<<if $settings.condomLevel is 1 or !$NPCList[$mouthtarget].condom>>
							/*If the NPC's pregnancyAvoidance is 50 or higher*/
							<<if $NPCList[$mouthtarget].pregnancyAvoidance gte 50>>
								<<set $NPCList[$mouthtarget].condomCanGive to true>>
								<<set $_speech to "acceptGive">>
							<<else>>
								<<set $_speech to "reject">>
							<</if>>
						/*If the NPC brought their own condom */
						<<elseif $NPCList[$mouthtarget].condom>>
							/*If the NPC was going to use the condom anyways*/
							<<if $NPCList[$mouthtarget].condom.willUse is true>>
								<<set $_speech to "acceptHas">>
							<<else>>
								<<set $NPCList[$mouthtarget].condom.willUse to true>>
								<<set $_speech to "accept">>
							<</if>>
						<</if>>
						<<set $_npcn to $npc[$npcrow.indexOf($mouthtarget)]>>
						<<switch $_npcn>>
							<<case "Robin">>
								/*Default pregnancyAvoidance is 50. Will have a condom if NPC condoms are enabled.*/
								<<switch $_speech>>
									<<case "accept">>
										<<He_Short>>【은는】 고개를 끄덕인다. "안전한 게 낫겠지?"
									<<case "acceptGive">>
										<<He_Short>>【은는】 고개를 끄덕인다. "안전한 게 낫겠지? <span class="blue">근데 하나 있어?</span>"
									<<case "acceptHas">>
										<<He_Short>>【은는】 고개를 끄덕인다. "안전한 게 낫겠지? <span class="teal">나한테 하나 있어.</span>"
									<<case "reject">>
										/*MEANT TO BE UNREACHABLE*/
										<<He_Short>>【은는】 거절한다! <span class="red">"이 고아원 엉덩이는 내 거야!"</span>
								<</switch>>
							<<case "Kylar">>
								/*Default pregnancyAvoidance is 0, and any condoms they use will be sabotaged beforehand.*/
								<<switch $_speech>>
									<<case "accept">>
										<<He_Short>>【은는】 흥분한 듯 고개를 끄덕인다.
										<<if $awareness gte 300>>
											"물-물론이지! <span class="red">내가 직접 챙겨왔다고!</span>"
										<<else>>
											"물-물론이지! <span class="teal">내가 직접 챙겨왔다고!</span>"
										<</if>>
									<<case "acceptGive">>
										/*MEANT TO BE UNREACHABLE*/
										<<He_Short>>【은는】 아쉬운 듯 고개를 끄덕인다. "알았어, 하지만 네가 치트를 써서 이 디버그 라인에 도달했기 때문이야. <span class="blue">근데 너 하나 가지고 있어?</span>"
									<<case "acceptHas">>
										<<He_Short>>【은는】 흥분한 듯 고개를 끄덕인다.
										<<if $awareness gte 300>>
											"물-물론이지! <span class="red">내가 직접 챙겨왔다고!</span>"
										<<else>>
											"물-물론이지! <span class="teal">내가 직접 챙겨왔다고!</span>"
										<</if>>
									<<case "reject">>
										<<He_Short>>【은는】 잠시 슬픈 표정을 짓는다.
										<<if pregnancyCompatible("Kylar") and $settings.pregnancySpeechEnabled>>
											"하-하지만 왜? 우린 아이를 많이 낳아야 하잖아. <span class="lewd">지금부터 시작해야 한다고</span>."
										<<else>>
											"하-하지만 왜? 그런 거 필요 없잖아! <span class="lewd">생으로 하고 싶단 말이야.</span>"
										<</if>>
								<</switch>>
							<<case "Eden">>
								/*Default pregnancyAvoidance is 0, maybe increase after having 1 or 2 children?*/
								<<switch $_speech>>
									<<case "accept">>
										<<He_Short>>【은는】 짜증 난 표정을 짓는다. "<span class="green">알았어.</span><<if pregnancyCompatible("Eden") and $settings.pregnancySpeechEnabled>> 먹여 살릴 입을 하나 더 늘릴 필욘 없지<<else>> 치우는 것도 귀찮으니까<</if>>."
									<<case "acceptGive">>
										<<He_Short>>【은는】 짜증 난 표정을 짓는다. "<span class="blue">좋아, 너한테 있다면야.</span><<if pregnancyCompatible("Eden") and $settings.pregnancySpeechEnabled>> 먹여 살릴 입을 하나 더 늘릴 필욘 없지<<else>> 치우는 것도 귀찮으니까<</if>>."
									<<case "acceptHas">>
										<<He_Short>>【은는】 짜증 난 표정을 짓는다. "<span class="teal">좋아, 굴러다니는 게 하나 있으니까.</span> 찢어지더라도 날 탓하지 마, 아마 네 나이만큼이나 오래된 걸 테니까."
									<<case "reject">>
										<<He_Short>>【은는】 비웃는다. "싫어. <span class="lewd">내 방식대로 할 거야.</span>"
								<</switch>>
							<<case "Whitney">>
								/*Default pregnancyAvoidance is 50*/
								<<switch $_speech>>
									<<case "accept">>
										<<He_Short>>【은는】 씩 웃는다. <span class="green">"당연하지, 걸레년아."</span>
									<<case "acceptGive">>
										<<He_Short>>【은는】 씩 웃는다. <span class="blue">"그래, 너한테 있다면야."</span>
									<<case "acceptHas">>
										<<He_Short>>【은는】 씩 웃는다. "<span class="teal">알았어, 알았다고.</span> 조급하긴, 성급한 <<bitch>>【아야】."
									<<case "reject">>
										<<He_Short>>【은는】 씩 웃는다. "아니, <span class="lewd">넌 그런 배려를 받을 가치가 없는 거 같은데.</span>"
								<</switch>>
							<<case "Avery">>
								/*Default pregnancyAvoidance is 50*/
								<<averyCondomUseSpeech $_speech>>
							<<case "Alex">>
								/*Default pregnancyAvoidance is 50, but always forgets to bring a condom.*/
								<<switch $_speech>>
									<<case "accept">>
										/*MEANT TO BE UNREACHABLE*/
										<<He_Short>>【은는】 인상을 찌푸리며 주머니를 뒤적인다. <<His>> 얼굴이 밝아진다. "<span class="green">대체 이게 어떻게 여기 들어 있는 거지?</span> 이런 걸 챙긴 기억이 없는데."
									<<case "acceptGive">>
