				<<print window.KR.getCreatureTypeKr($struggle.anus.creature)>>【은는】 <span class="pink">따뜻한 액체를 당신의 <<bottom>> 안으로 뿜어내며 부르르 떤다.</span><<neutral 5 "anus">><<struggle_fluid anus>><<purity -1>><<internalejac>><<bodyliquid "anus" "goo">><<analejacstat>><<ejacstat>>
			<<case 13>>
				<<impregnateParasite $struggle.anus.creature 50>>
				<<if _impreg is true>>
					<<print window.KR.getCreatureTypeKr($struggle.anus.creature)>>의 <<struggle_appendage anus>>【이가】 <span class="red">다시 부풀어 오른다.</span> 그러나 그 압박감은 금세 사라진다. 무언가를 남겨둔 듯한 기분이다.<<neutral 5 "anus">><<bodyliquid "anus" "goo">><<struggle_fluid anus>><<purity -1>><<internalejac>><<bodyliquid "anus" "goo">>
					<<set _impreg to false>>
				<<else>>
					<<print window.KR.getCreatureTypeKr($struggle.anus.creature)>>의 <<struggle_appendage anus>>【이가】 당신의 <<bottom>> 안을 들락날락한다.<<neutral 5 "anus">><<bodyliquid "anus" "goo">><<struggle_fluid anus>><<purity -1>><<internalejac>><<bodyliquid "anus" "goo">>
				<</if>>
			<<case 14>>
				<<print window.KR.getCreatureTypeKr($struggle.anus.creature)>>【은는】 부르르 떨며 <span class="blue">그 <<struggle_appendage anus>>【을를】 빼내고,</span> 당신의 <<bottom>>에서 떨어져 나간다.<<neutral 5 "anus">><<struggle_fluid anus>>
				<<set $anususe to 0>>
				<<set $anusstate to 0>>
				<<struggle_part_init "anus" "cum">>
				<<struggleClearActions "anus_">>
			<<default>>
				<<print window.KR.getCreatureTypeKr($struggle.anus.creature)>>의 <<struggle_appendage anus>>【이가】 당신의 <<bottom>> 안을 쑤신다.<<neutral 5 "anus">><<bodyliquid "anus" "goo">><<struggle_fluid anus>><<purity -1>><<internalejac>><<bodyliquid "anus" "goo">>
		<</switch>>
		<<set $struggle.anus.progress += 1>>
		<br>
	<</if>>

	<<if $struggle.chest.creature>>
		<<switch $struggle.chest.progress>>
			<<case 0>>
				<<neutral 2 "breasts">>
				<<if $struggle.chest.legs is "tentacles">>
					<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【이가】 촉수로 당신의 <<breasts>>【을를】 더듬고,
					<<if $player.breastsize gte 3>>
						그것들을 함께 쥐어짜며 <span class="blue">남근 형태의 <<struggle_appendage chest>>【을를】 문지른다.</span>
					<<else>>
						그것들을 애무하며 <span class="blue">남근 형태의 <<struggle_appendage chest>>【을를】 그 사이로 문지른다.</span>
					<</if>>
				<<elseif $struggle.chest.legs is "legs">>
					<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 다리가 당신의
					<<if $player.breastsize gte 3>>
						<<breasts>>【을를】 더듬는다. <span class="blue">그 생물체에서 남근 같은 <<struggle_appendage chest>>【이가】 튀어나와,</span> 그것들에 문지른다.
					<<else>>
						<<breasts>>【을를】 더듬으며, <span class="blue">그 생물체에서 남근 같은 <<struggle_appendage chest>>【이가】 튀어나와</span> 그 행렬에 합류한다.
					<</if>>
				<<else>>
					<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 몸이 당신의 <<breasts>> 위를 미끄러지듯 움직인다.
					<<if $player.breastsize gte 3>>
						<span class="blue">그 생물체에서 남근 같은 <<struggle_appendage chest>>【이가】 튀어나와</span> 가슴에 비벼댄다.
					<<else>>
						그것은 당신을 희롱하며 <span class="blue">생물체에서 튀어나온 남근 모양의 <<struggle_appendage chest>>【을를】 꺼낸다.</span>
					<</if>>
				<</if>>
			<<case 1>>
				<<struggle_clothes chest>>
			<<case 2>>
				<<if $player.breastsize gte 3>>
					<<if $struggle.chest.legs is "tentacles">>
						<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 촉수가 <span class="pink">당신의 가슴을 감싼다.</span><<neutral 5 "breasts">>
					<<else>>
						<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【은는】 당신의 <<breasts>>【을를】 모아 쥐고 <span class="pink">그 사이로 <<struggle_appendage chest>>【을를】 밀어넣는다.</span><<neutral 3 "breasts">>
					<</if>>
				<<else>>
					<<if $struggle.chest.legs is "tentacles">>
						<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【이가】 촉수로 당신의 <<breasts>>【을를】 더듬고 튕긴다.<<neutral 5 "breasts">>
					<<else>>
						<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【은는】 당신의 <<breasts>>【을를】 주무르고 애무한다.<<neutral 3 "breasts">>
					<</if>>
				<</if>>
				<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
					<span class="pink">유두에서 모유가 새어 나오는 것을 느낀다.</span>
					<<breastfeed>>
					<<milkvolume 1>>
				<<else>>
					<<milkvolume 1>>
				<</if>>
			<<case 3>>
				<<if $player.breastsize gte 3>>
					<<if $struggle.chest.legs is "tentacles">>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 촉수들이 <span class="pink">당신의 <<breasts>>에서 모유를 짜낸다.</span>
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 촉수들이 당신의 <<breasts>>【을를】 쥐어짜는 동안, 다른 촉수들은 젖꼭지를 튕긴다.
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">>
					<<else>>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【은는】 <span class="pink">당신의 <<breasts>> 사이로 <<struggle_appendage chest>>【을를】 쑤셔대고</span> 그동안 <span class="pink">당신의 유두에서는 젖이 흘러나온다.</span>
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【은는】 <span class="pink">당신의 <<breasts>> 사이로 <<struggle_appendage chest>>【을를】 쑤셔댄다.</span>
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">>
					<</if>>
				<<else>>
					<<struggle_flat_chest>>
				<</if>>
			<<case 4>>
				<<if $player.breastsize gte 3>>
					<<if $struggle.chest.legs is "tentacles">>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 부속물이 <span class="pink">당신의 <<breasts>>【을를】 압박하고</span> 그동안 <span class="pink">촉수들은 계속해서 젖꼭지에서 젖을 짜낸다.</span>
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 부속물이 <span class="pink">당신의 <<breasts>>【을를】 누르는 동안</span> <span class="pink">촉수들은 계속해서 주물럭거린다.</span>
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">>
					<<else>>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【이가】 당신의 <<breasts>>【을를】 범하는 동안 <span class="pink">유두에서 모유가 샌다.</span> 그 생물체가 부르르 떨자 <span class="purple">따뜻한 액체가 그 <<struggle_appendage chest>>에서 뿜어져 나온다.</span>
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 <<struggle_appendage chest>>【이가】 당신의 <<breasts>>【을를】 범한다. 그 괴물이 몸을 떨더니 <span class="purple">그 <<struggle_appendage chest>>에서 따뜻한 액체가 뿜어져 나온다.</span>
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">><<bodyliquid "chest" "goo">>
					<</if>>
				<<else>>
					<<struggle_flat_chest>>
				<</if>>
			<<case 5>>
				<<if $player.breastsize gte 3>>
					<<if $struggle.chest.legs is "tentacles">>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 부속물이 <span class="pink">당신의 <<breasts>> 사이를 쑤시는 동안</span> <span class="pink">촉수들은 계속해서 당신의 유두에서 모유를 짜낸다.</span>
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 돌기가 <span class="pink">당신의 <<breasts>> 사이를 쑤시는 동안</span> <span class="pink">촉수들은 계속해서 주무른다.</span>
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">>
					<<else>>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 <<struggle_appendage chest>>【이가】 당신의 <<breasts>>【을를】 범하며, 찌를 때마다 따뜻한 액체를 뿜어내고 <span class="pink">당신의 젖꼭지에서는 젖이 흘러나온다.</span>
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 <<struggle_appendage chest>>【이가】 당신의 <<breasts>> 사이를 계속 쑤시며 따뜻한 액체를 내뿜는다.
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">><<bodyliquid "chest" "goo">>
					<</if>>
				<<else>>
					<<struggle_flat_chest>>
				<</if>>
			<<case 6>>
				<<if $player.breastsize gte 3>>
					<<if $struggle.chest.legs is "tentacles">>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 부속기관이 당신의 <<breasts>>【을를】 쑤시고, 그동안 <span class="pink">촉수들은 계속해서 당신의 유두에서 젖을 짜낸다.</span> 생물체가 부르르 떨더니 그 <<struggle_appendage chest>>에서 따뜻한 액체가 분출된다.
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 부속기관이 당신의 <<breasts>>【을를】 범하고, <span class="pink">촉수들은 계속해서 가슴을 주무른다.</span> 괴물이 부르르 떨더니 <<struggle_appendage chest>>에서 따뜻한 액체가 뿜어져 나온다.
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">><<bodyliquid "chest" "goo">>
					<<else>>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 <<struggle_appendage chest>>【이가】 당신의 <<breasts>>【을를】 범하며 찌를 때마다 따뜻한 액체를 내뿜고 <span class="pink">당신의 젖꼭지에서는 젖이 흘러내린다.</span>
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 <<struggle_appendage chest>>【이가】 당신의 <<breasts>> 사이를 계속 쑤시며, 따뜻한 액체를 내뿜는다.
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">><<bodyliquid "chest" "goo">>
					<</if>>
				<<else>>
					<<struggle_flat_chest>>
				<</if>>
			<<case 12>>
				<<if $player.breastsize gte 3>>
					<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【은는】 부르르 떨며 <span class="blue">그 <<struggle_appendage chest>>【을를】 거두고,</span> 당신의 <<breasts>>에서 떨어진다.<<bodyliquid "chest" "goo">>
				<<else>>
					<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【이가】 <span class="blue">당신의 <<breasts>>에서 떨어져 나간다.</span>
				<</if>>
				<<set $chestuse to 0>>
				<<set $cheststate to 0>>
				<<struggle_part_init "chest" "cum">>
				<<struggleClearActions "chest_">>
			<<default>>
				<<if $player.breastsize gte 3>>
					<<if $struggle.chest.legs is "tentacles">>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 부속기관이 당신의 <<breasts>> 사이를 계속 쑤시며 따뜻한 액체를 뿜어내고, 촉수들은 <span class="pink">계속해서 젖꼭지에서 젖을 짜낸다.</span>
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 부속기관이 당신의 <<breasts>> 사이를 계속 쑤시며, 따뜻한 액체를 내뿜는다.
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">><<bodyliquid "chest" "goo">>
					<<else>>
						<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 <<struggle_appendage chest>>【이가】 당신의 <<breasts>>【을를】 범하며 쑤실 때마다 따뜻한 액체를 뿜어내고, 그동안 <span class="pink">당신의 유두에서는 모유가 흘러나온다.</span>
							<<breastfeed>>
						<<else>>
							<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 <<struggle_appendage chest>>【이가】 당신의 <<breasts>> 사이를 계속 쑤시며 따뜻한 액체를 뿜어낸다.
							<<milkvolume 1>>
						<</if>>
						<<sex 5 "breasts">><<bodyliquid "chest" "goo">>
					<</if>>
				<<else>>
					<<struggle_flat_chest>>
				<</if>>
		<</switch>>
		<<set $struggle.chest.progress += 1>>
		<br>
	<</if>>

	<!-- populate an array of unoccupied bodyparts to target -->
	<<set _targets to []>>
	<<if $mouthuse is 0>><<set _targets.push("mouth")>><</if>>
	<<if $vaginause is 0 and $player.vaginaExist>><<set _targets.push("vagina")>><</if>>
	<<if $penisuse is 0 and (playerHasStrapon() or $player.penisExist)>><<set _targets.push("penis")>><</if>>
	<<if $anususe is 0 and $settings.analEnabled>><<set _targets.push("anus")>><</if>>
	<<if $chestuse is 0>><<set _targets.push("chest")>><</if>>

	<<for _i to 0; _i lt $struggle.number; _i++>>
		<<if $struggle.enemy[_i].location is "fleeing">>
			<<struggle_name _i>>【이가】 
			<<if $struggle.enemy[_i].health gte 1 and $struggle.enemy[_i].satisfied lt 1>>
				<<if $underwater is 1 or $struggle.enemy[_i].motion is "swimming">>
					당신 주위를 헤엄치며
				<<elseif $struggle.enemy[_i].motion is "flying">>
					당신 주위를 맴돌며
				<<else>>
					근처에 착지하며
				<</if>>
				<span class="blue">공격을 준비한다.</span>
				<<set $struggle.enemy[_i].location to "lurking">>
			<<else>>
				<<if $underwater is 1 or $struggle.enemy[_i].motion is "swimming">>
					탁한 물 속으로 헤엄쳐 간다.
				<<elseif $struggle.enemy[_i].motion is "flying">>
					날아간다.
				<<else>>
					뛰어서 멀어진다.
				<</if>>
				<span class="green">돌아오지 않을 것이다.</span>
				<<set $struggle.done += 1>>
				<<set $struggle.enemy[_i].location to "fled">>
			<</if>>
			<br>
		<<elseif $struggle.enemy[_i].location is "lurking" and _targets.length gt 0>>
			<!-- lurkers attacc -->
			<<rng>>
			<<if $dodging gte 1>>
				<<set _doge_chance to ((currentSkillValue("feetskill") / 3) + (currentSkillValue('danceskill') / 3) - $drunk - (!!$worn.feet.type.includes("heels") * 200))>>
				<<feetskilluse>>
			<</if>>
			<<if $left_guard is 1>>
				<<set _left_guard_chance to (currentSkillValue("handskill") / 3)>>
				<<handskilluse>>
			<</if>>
			<<if $right_guard is 1>>
				<<set _right_guard_chance to (currentSkillValue("handskill") / 3)>>
				<<handskilluse>>
			<</if>>
			<<set _hit_chance to random(1, 1000)>>
			<<if _doge_chance gte _hit_chance>>
				<<struggle_bide_the>> <<struggle_name _i>>【이가】 
				<<if $underwater is 1 or $struggle.enemy[_i].motion is "swimming">>
					당신을 향해 헤엄쳐 오지만
				<<elseif $struggle.enemy[_i].motion is "flying">>
					당신을 향해 날아오지만
				<<else>>
					당신을 향해 뛰어오르지만
				<</if>>
				<<set $dodging -= 1>>
				<<if $drunk gte 60>>
					당신은 술에 취해 비틀거리며 길을 피한다<<if !random(100)>>. 마치 취권의 달인처럼<</if>>.
				<<elseif currentSkillValue("feetskill") gte 800 or currentSkillValue('danceskill') gte 400>>
					당신은 춤추듯 옆으로 피한다.
				<<elseif currentSkillValue("feetskill") gte 200>>
					당신은 옆으로 비켜선다.
				<<else>>
					당신은 비틀거리며 피한다.
				<</if>>
				<<if _doge_chance - _hit_chance gte 200>>
					<span class="green">그것을 피해낸다.</span>
				<<else>>
					<span class="teal">가까스로 피해낸다.</span>
					<<for $_slot range setup.clothingLayer.torso>>
						<<if $worn[$_slot].name isnot "naked">>
							<<set $worn[$_slot].integrity -= random(10, 15)>>
							<<set _clothesdamaged to true>>
							그것이 스쳐 지나가며 당신의 $worn[$_slot].name【을를】 찢는다.
							<<break>>
						<</if>>
					<</for>>
					<<if !_clothesdamaged>>
						그것이 지나가며 당신을 채찍질한다. <<pain 2>>
					<</if>>
					<<neutral 2>>
				<</if>>
			<<elseif _left_guard_chance gte _hit_chance or _right_guard_chance gte _hit_chance>>
				<<struggle_bide_the>> <<struggle_name _i>>【이가】 
				<<if $underwater is 1 or $struggle.enemy[_i].motion is "swimming">>
					당신을 향해 헤엄쳐 오지만
				<<elseif $struggle.enemy[_i].motion is "flying">>
					당신을 향해 날아오지만
				<<else>>
					당신을 향해 뛰어오르지만
				<</if>>
				<<if currentSkillValue("handskill") gte 800>>
					당신은 타이밍을 맞춰 타격을 가해 그 기세를 꺾고
				<<elseif currentSkillValue("handskill") gte 200>>
					당신은 그것을 옆으로 쳐내고
				<<else>>
					당신의 발버둥에 그것이 옆으로 나가떨어지며
				<</if>>
				<<if _left_guard_chance - _hit_chance gte 200 or _right_guard_chance - _hit_chance gte 200>>
					<span class="green">바닥에 메다꽂는다.</span>
					<<set $struggle.enemy[_i].health -= 1>>
				<<else>>
					<span class="teal">간신히 피한다.</span>
					<<for $_slot range ["over_upper", "over_lower", "upper", "lower", "under_upper", "under_lower"]>>
						<<if $worn[$_slot].name isnot "naked">>
							<<set $worn[$_slot].integrity -= random(10, 15)>>
							<<set _clothesdamaged to true>>
							그것이 지나가면서 당신의 $worn[$_slot].name【을를】 찢어발긴다.
							<<break>>
						<</if>>
					<</for>>
					<<if !_clothesdamaged>>
						그것이 지나가며 당신을 후려친다. <<pain 2>>
					<</if>>
					<<neutral 2>>
				<</if>>
				<<if _left_guard_chance gte _hit_chance>>
					<<unset $left_guard>>
				<<elseif _right_guard_chance gte _hit_chance>>
					<<unset $right_guard>>
				<</if>>
			<<elseif $rng lte 66 and _targets.length gt 0>>
				<<set _target to _targets.pluck()>>
				<<struggle_bide_the>> <<struggle_name _i>>【이가】 
				<<if $underwater is 1 or $struggle.enemy[_i].motion is "swimming">>
					당신을 향해 헤엄쳐 온다.
				<<elseif $struggle.enemy[_i].motion is "flying">>
					당신을 향해 날아온다.
				<<else>>
					당신을 향해 뛰어오른다.
				<</if>>
				<span class="blue">당신의 <<struggle_region _target>>에 착지한다.</span>
				<<struggle_attach _target>>
				<<set V[_target + 'use'] to "struggle">>
				<<set V[_target + 'state'] to "struggle">>
				<<set V[_target + 'target'] to "struggle">>
			<<elseif random(1, 2) is 2>>
				<<struggle_name _i>>의 몸에서 돌기가 튀어나오더니 <span class="blue">당신에게 끈적이는 액체를 한 줄기 내뿜는다.</span>
				<<random_goo>>
			<<else>>
				<<struggle_name _i>>【은는】 빈틈을 노리고 있다.
				<<set $struggle.enemy[_i].bide to true>>
			<</if>>
			<br>
		<</if>>
	<</for>>
	<<unset $left_guard>>
	<<unset $right_guard>>
	<<if $oxygen lt $oxygenmax and $underwater isnot 1 and _strangle is 1>>
		<<unset _strangle>>
		<br>산소: <<oxygencaption>>
	<</if>>
	<br>
	<<turnend>>
<</widget>>


<<widget "struggle_difficulty">>/*Unused for now*/
	<!-- can be slapped at the end of _pull actions to show difficulty -->
	<<set $_chance to $struggle[_args[0]].success>>
	<<struggle_difficulty_set>>

	| 성공 확률 :
	<<if $_chance gte 100>>
		<span class="green"><<print $_chance>>%</span>
	<<elseif $_chance gte 80>>
		<span class="teal"><<print $_chance>>%</span>
	<<elseif $_chance gte 60>>
		<span class="lblue"><<print $_chance>>%</span>
	<<elseif $_chance gte 40>>
		<span class="blue"><<print $_chance>>%</span>
	<<elseif $_chance gte 20>>
		<span class="purple"><<print $_chance>>%</span>
	<<elseif $_chance gte 1>>
		<span class="pink"><<print $_chance>>%</span>
	<<else>>
		<span class="red"><<print $_chance>>%</span>
	<</if>>
<</widget>>

<<widget "struggle_difficulty_set">>
	<<for $_part range ["mouth", "vagina", "penis", "anus", "chest"]>>
		<<set $struggle[$_part].success to Math.trunc(($struggle[$_part].grip * 17) + (currentSkillValue('physique') / 600))>>
		<<if $struggle[$_part].success gte 100>>
			<!-- can't strengthen anymore, default to pull -->
			<<if $leftactiondefault is $_part + '_strengthen'>>
				<<set $leftactiondefault to $_part + '_pull'>>
			<</if>>
			<<if $rightactiondefault is $_part + '_strengthen'>>
				<<set $rightactiondefault to $_part + '_pull'>>
			<</if>>
		<</if>>
	<</for>>
<</widget>>

<<widget "struggle_bide_the">>
	<<if $struggle.enemy[_i].bide is true>>
		<<set $struggle.enemy[_i].bide to false>>
		빈틈을 발견한
	<</if>>
<</widget>>

<<widget "struggle_fluid">>
	<<if ["mouth", "vagina", "anus"].includes(_args[0])>>
		<<if $struggle[_args[0]].creature is "lurker" or $struggle.mouth.creature is "slime">>
			<<drugs 25>>
		<<elseif $struggle[_args[0]].creature is "pale slime">>
			<<drugs 50>>
			<<hallucinogen 40>>
		<</if>>
	<</if>>
<</widget>>

<<widget "struggle_clothes">>
	<<if _args[0] is "vagina" or _args[0] is "penis">>
		<<if $worn.over_lower.vagina_exposed is 0 or (setup.clothes.over_lower[clothesIndex('over_lower', $worn.over_lower)].skirt is 1 and $worn.over_lower.skirt_down is 1)>>
			<<set _struggle_exposed to "over">>
		<<elseif $worn.lower.vagina_exposed is 0 or (setup.clothes.lower[clothesIndex('lower', $worn.lower)].skirt is 1 and $worn.lower.skirt_down is 1)>>
			<<set _struggle_exposed to "main">>
		<<elseif $worn.under_lower.vagina_exposed is 0 or (setup.clothes.under_lower[clothesIndex('under_lower', $worn.under_lower)].skirt is 1 and $worn.under_lower.skirt_down is 1)>>
			<<set _struggle_exposed to "under">>
		<<elseif (playerChastity("penis") and _args[0] is "penis") or (playerChastity("vagina") and _args[0] is "vagina")>>
			<<set _struggle_exposed to "genitals">>
		<<else>>
			<<set _struggle_exposed to "naked">>
		<</if>>
	<<elseif _args[0] is "anus">>
		<<if (setup.clothes.over_lower[clothesIndex('over_lower', $worn.over_lower)].skirt is 1 and $worn.over_lower.skirt_down is 1) or $worn.over_lower.anus_exposed is 0>>
			<<set _struggle_exposed to "over">>
		<<elseif $worn.lower.anus_exposed is 0 or (setup.clothes.lower[clothesIndex('lower', $worn.lower)].skirt is 1 and $worn.lower.skirt_down is 1)>>
			<<set _struggle_exposed to "main">>
		<<elseif $worn.under_lower.anus_exposed is 0 or (setup.clothes.under_lower[clothesIndex('under_lower', $worn.under_lower)].skirt is 1 and $worn.under_lower.skirt_down is 1)>>
			<<set _struggle_exposed to "under">>
		<<elseif playerChastity("anus")>>
			<<set _struggle_exposed to "genitals">>
		<<else>>
			<<set _struggle_exposed to "naked">>
		<</if>>
	<<elseif _args[0] is "chest">>
		<<if !$worn.over_upper.type.includes("naked") and $worn.over_upper.exposed lt 2>>
			<<set _struggle_exposed to "over_top">>
		<<elseif !$worn.upper.type.includes("naked") and $worn.upper.exposed lt 2>>
			<<set _struggle_exposed to "main_top">>
		<<elseif !$worn.under_upper.type.includes("naked") and $worn.under_upper.exposed is 0>>
			<<set _struggle_exposed to "under_top">>
		<<else>>
			<<set _struggle_exposed to "naked">>
		<</if>>
	<<elseif _args[0] is "mouth">>
		<<if $worn.face.type.includes("face_covering") or $worn.face.type.includes("gag")>>
			<<set _struggle_exposed to "mask">>
		<<else>>
			<<set _struggle_exposed to "naked">>
		<</if>>
	<</if>>

	<<if _struggle_exposed is "over_top">>
		<<set $struggle[_args[0]].progress -= 1>>
		<<if $struggle[_args[0]].legs is "tentacles">>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 촉수들이 들어갈 길을 찾으며 당신의 $worn.over_upper.name【을를】 찢어댄다.<<neutral 2>><<set $worn.over_upper.integrity -= 10>>
		<<else>>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 부속지가 당신의 $worn.over_upper.name 너머로 <<struggle_bodypart _args[0]>>【을를】 쿡쿡 찌른다.<<neutral 1>>
		<</if>>
		<<set $worn.over_upper.integrity -= 10>><<struggle_softlock_prevent>>
		<<if $struggle[_args[0]].creature is "slime">>
			<span class="purple">옷감이 슬라임에 녹아들며 쉬익 소리를 낸다.</span><<set $worn.over_upper.integrity -= 30>>
		<<elseif $struggle[_args[0]].creature is "pale slime">>
			<span class="purple">옷감이 창백한 슬라임에 녹아들며 격렬하게 쉬익 소리를 낸다.</span><<set $worn.over_upper.integrity -= 50>>
		<</if>>
		<<if $worn.over_upper.integrity lte 0>>
			<<integritycheck no_text>><<exposure>>
			<<if $struggle[_args[0]].legs is "tentacles">>
				촉수들이 옷감을 휘감고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<top>>【을를】 드러낸다.</span>
			<<else>>
				촉수가 옷감을 꿰뚫고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<top>>【을를】 드러낸다.</span>
			<</if>>
		<</if>>
	<<elseif _struggle_exposed is "main_top">>
		<<set $struggle[_args[0]].progress -= 1>>
		<<if $struggle[_args[0]].legs is "tentacles">>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 촉수들이 들어갈 길을 찾으며 당신의 $worn.upper.name【을를】 찢어댄다.<<neutral 2>><<set $worn.upper.integrity -= 10>><<struggle_softlock_prevent>>
		<<else>>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 부속지가 당신의 $worn.upper.name 너머로 <<struggle_bodypart _args[0]>>【을를】 쿡쿡 찌른다.<<neutral 1>>
		<</if>>
		<<set $worn.upper.integrity -= 10>>
		<<if $struggle[_args[0]].creature is "slime">>
			<span class="purple">옷감이 슬라임에 녹아들며 쉬익 소리를 낸다.</span><<set $worn.upper.integrity -= 30>>
		<<elseif $struggle[_args[0]].creature is "pale slime">>
			<span class="purple">옷감이 창백한 슬라임에 녹아들며 격렬하게 쉬익 소리를 낸다.</span><<set $worn.upper.integrity -= 50>>
		<</if>>
		<<if $worn.upper.integrity lte 0>>
			<<integritycheck no_text>><<exposure>>
			<<if $struggle[_args[0]].legs is "tentacles">>
				촉수들이 옷감을 휘감고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<undertop>>【을를】 드러낸다.</span>
			<<else>>
				촉수가 옷감을 꿰뚫고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<undertop>>【을를】 드러낸다.</span>
			<</if>>
		<</if>>
	<<elseif _struggle_exposed is "under_top">>
		<<set $struggle[_args[0]].progress -= 1>>
		<<if $struggle[_args[0]].legs is "tentacles">>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 촉수들이 들어갈 길을 찾으며 당신의 $worn.under_upper.name【을를】 찢어댄다.<<neutral 3>><<set $worn.under_upper.integrity -= 10>>
		<<else>>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 부속지가 당신의 $worn.under_upper.name【을를】 쿡쿡 찌른다.
		<</if>>
		<<set $worn.under_upper.integrity -= 10>><<struggle_softlock_prevent>>
		<<if $struggle[_args[0]].creature is "slime">>
			<span class="purple">옷감이 슬라임에 녹아들며 쉬익 소리를 낸다.</span><<set $worn.under_upper.integrity -= 30>>
		<<elseif $struggle[_args[0]].creature is "pale slime">>
			<span class="purple">옷감이 창백한 슬라임에 녹아들며 격렬하게 쉬익 소리를 낸다.</span><<set $worn.under_upper.integrity -= 50>>
		<</if>>
		<<if $worn.under_upper.integrity lte 0>>
			<<integritycheck no_text>><<exposure>>
			<<if $struggle[_args[0]].legs is "tentacles">>
				촉수들이 옷감을 휘감고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<breasts>>【을를】 드러낸다.</span>
			<<else>>
				촉수가 옷감을 꿰뚫고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<breasts>>【을를】 드러낸다.</span>
			<</if>>
		<</if>>
	<<elseif _struggle_exposed is "over">>
		<<set $struggle[_args[0]].progress -= 1>>
		<<if $struggle[_args[0]].legs is "tentacles">>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 촉수들이 그 아래의 <<struggle_bodypart _args[0]>>에 닿으려 당신의 $worn.over_lower.name【을를】 찢어댄다.<<neutral 2>><<set $worn.over_lower.integrity -= 10>>
		<<else>>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>【이가】 그 아래의 <<struggle_bodypart _args[0]>>에 닿으려 당신의 $worn.over_lower.name【을를】 찢어댄다.<<neutral 1>>
		<</if>>
		<<set $worn.over_lower.integrity -= 10>><<struggle_softlock_prevent>>
		<<if $struggle[_args[0]].creature is "slime">>
			<span class="purple">옷감이 슬라임에 녹아들며 쉬익 소리를 낸다.</span><<set $worn.over_lower.integrity -= 30>>
		<<elseif $struggle[_args[0]].creature is "pale slime">>
			<span class="purple">옷감이 창백한 슬라임에 녹아들며 격렬하게 쉬익 소리를 낸다.</span><<set $worn.over_lower.integrity -= 50>>
		<</if>>
		<<if $worn.over_lower.integrity lte 0>>
			<<integritycheck no_text>><<exposure>>
			<<if $struggle[_args[0]].legs is "tentacles">>
				그 촉수들이 옷감을 휘감고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<crotch>>【을를】 드러낸다.</span>
			<<else>>
				그 촉수가 옷감을 꿰뚫고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<crotch>>【을를】 드러낸다.</span>
			<</if>>
		<</if>>
	<<elseif _struggle_exposed is "main">>
		<<set $struggle[_args[0]].progress -= 1>>
		<<if $struggle[_args[0]].legs is "tentacles">>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 촉수들이 그 아래의 <<struggle_bodypart _args[0]>>에 닿으려 당신의 $worn.lower.name【을를】 찢어댄다.<<neutral 2>><<set $worn.lower.integrity -= 10>>
		<<else>>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>【이가】 그 아래의 <<struggle_bodypart _args[0]>>에 닿으려 당신의 $worn.lower.name【을를】 찢어댄다.<<neutral 1>>
		<</if>>
		<<set $worn.lower.integrity -= 10>><<struggle_softlock_prevent>>
		<<if $struggle[_args[0]].creature is "slime">>
			<span class="purple">옷감이 슬라임에 녹아들며 쉬익 소리를 낸다.</span><<set $worn.lower.integrity -= 30>>
		<<elseif $struggle[_args[0]].creature is "pale slime">>
			<span class="purple">옷감이 창백한 슬라임에 녹아들며 격렬하게 쉬익 소리를 낸다.</span><<set $worn.lower.integrity -= 50>>
		<</if>>
		<<if $worn.lower.integrity lte 0>>
			<<integritycheck no_text>><<exposure>>
			<<if $struggle[_args[0]].legs is "tentacles">>
				그 촉수들이 옷감을 휘감고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<undies>>【을를】 드러낸다.</span>
			<<else>>
				그 촉수가 옷감을 꿰뚫고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<undies>>【을를】 드러낸다.</span>
			<</if>>
		<</if>>
	<<elseif _struggle_exposed is "under">>
		<<set $struggle[_args[0]].progress -= 1>>
		<<if $struggle[_args[0]].legs is "tentacles">>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 촉수들이 그 아래의 <<struggle_bodypart _args[0]>>에 닿으려 당신의 $worn.under_lower.name 안으로 파고든다.<<neutral 2>><<set $worn.under_lower.integrity -= 10>>
		<<else>>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>【이가】 그 아래의 <<struggle_bodypart _args[0]>>에 닿으려 당신의 $worn.under_lower.name【을를】 찢어댄다.<<neutral 1>>
		<</if>>
		<<set $worn.under_lower.integrity -= 10>><<struggle_softlock_prevent>>
		<<if $struggle[_args[0]].creature is "slime">>
			<span class="purple">옷감이 슬라임에 녹아들며 쉬익 소리를 낸다.</span><<set $worn.under_lower.integrity -= 30>>
		<<elseif $struggle[_args[0]].creature is "pale slime">>
			<span class="purple">옷감이 창백한 슬라임에 녹아들며 격렬하게 쉬익 소리를 낸다.</span><<set $worn.under_lower.integrity -= 50>>
		<</if>>
		<<if $worn.under_lower.integrity lte 0>>
			<<integritycheck no_text>><<exposure>>
			<<if $struggle[_args[0]].legs is "tentacles">>
				그 촉수들이 옷감 속으로 파고들어 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<genitals>>【을를】 드러낸다.</span>
			<<else>>
				그 촉수가 옷감을 꿰뚫고 <span class="pink">가볍게 튕겨내 당신의 몸에서 찢어발기며, 당신의 <<genitals>>【을를】 드러낸다.</span>
			<</if>>
		<</if>>
	<<elseif _struggle_exposed is "genitals">>
		<<set $struggle[_args[0]].progress -= 1>>
		<<if $struggle[_args[0]].legs is "tentacles">>
			<<if $worn.genitals.name is "chastity parasite">>
				<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 촉수들이 당신의 $worn.genitals.name【을를】 휘감고 꿈틀대며 문지르고 쥐어짠다. <span class="lewd">당신의 확연히 흥분한 반응이 그것을 더욱 부추긴다.</span>
				<<arousal 200 "genitals">><<neutral 2 "genitals">><<set $worn.genitals.integrity -= 5>><<struggle_softlock_prevent>>
			<<else>>
				<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 촉수들이 들어갈 길을 찾으며 당신의 $worn.genitals.name 뒤로 파고들어, 당신의 <<struggle_bodypart _args[0]>>【을를】 스친다.<<neutral 2 "genitals">><<set $worn.genitals.integrity -= 10>><<struggle_softlock_prevent>>
			<</if>>
		<<else>>
			<<if $worn.genitals.name is "chastity parasite">>
				<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>【이가】 당신의 $worn.genitals.name【을를】 찢어발기려 하지만, 그저 꽉 쥐어짜 <span>당신을 더욱 흥분시킬</span> 뿐이다.
				<<neutral 1 "genitals">><<arousal 100 "genitals">><<set $worn.genitals.integrity -= 5>><<struggle_softlock_prevent>>
			<<else>>
				<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>【이가】 그 아래의 <<struggle_bodypart _args[0]>>에 닿으려 당신의 $worn.genitals.name【을를】 찢어댄다.<<neutral 1 "genitals">><<set $worn.genitals.integrity -= 10>>
			<</if>>
		<</if>>
		<<if $struggle[_args[0]].creature is "slime">>
			<span class="purple">재질이 슬라임에 녹아들며 쉬익 소리를 낸다.</span><<set $worn.genitals.integrity -= 30>>
		<<elseif $struggle[_args[0]].creature is "pale slime">>
			<span class="purple">재질이 창백한 슬라임에 녹아들며 격렬하게 쉬익 소리를 낸다.</span><<set $worn.genitals.integrity -= 50>>
		<</if>>
		<<if $worn.genitals.integrity lte 0>>
			<<integritycheck no_text>><<exposure>>
			<<if $struggle[_args[0]].legs is "tentacles">>
				그 촉수들이 재질을 휘감고 잡아당긴다. 재질은
				<<if $worn.genitals.name is "chastity parasite">>
					튕겨나가며
				<<else>>
					비명을 지르며
				<</if>>
				<span class="pink"><<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>【이가】 그것을 튕겨내 몸에서 찢어발기면서, 당신의 <<genitals>>【을를】 드러낸다.</span>
			<<else>>
				그 촉수가 재질을 꿰뚫고 잡아당긴다. 재질은
				<<if $worn.genitals.name is "chastity parasite">>
					튕겨나가며
				<<else>>
					비명을 지르며
				<</if>>
				<span class="pink"><<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>【이가】 그것을 튕겨내 몸에서 찢어발기면서, 당신의 <<genitals>>【을를】 드러낸다.</span>
			<</if>>
		<<else>>
			<<if $struggle[_args[0]].damage gte 10>>
				그것은 재질에 부딪혀 <<if $worn.genitals.name is "chastity parasite">>지쳐 버렸고<<else>>상처를 입었고<</if>>, <span class="green">멀리 떨어져 나간다.</span>
				<<if _args[0] is "vagina">>
					<<set $vaginause to 0>>
					<<set $vaginastate to 0>>
					<<struggle_part_init "vagina">>
					<<set $struggle.warded += 1>>
					<<struggleClearActions "vagina_">>
				<<elseif _args[0] is "penis">>
					<<set $penisuse to 0>>
					<<set $penisstate to 0>>
					<<struggle_part_init "penis">>
					<<set $struggle.warded += 1>>
					<<struggleClearActions "penis_">>
				<<else>>
					<<set $anususe to 0>>
					<<set $anusstate to 0>>
					<<struggle_part_init "anus">>
					<<set $struggle.warded += 1>>
					<<struggleClearActions "anus_">>
				<</if>>
			<<else>>
				그것은 재질에 부딪혀 스스로 <<if $worn.genitals.name is "chastity parasite">>지쳐 버린다<<else>>상처를 입는다<</if>>.
				<<set $struggle[_args[0]].damage += 1>>
			<</if>>
		<</if>>
	<<elseif _struggle_exposed is "mask">>
		<<set $struggle[_args[0]].progress -= 1>>
		<<if $struggle[_args[0]].legs is "tentacles">>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>의 촉수들이 그 아래의 <<struggle_bodypart _args[0]>>에 닿으려 당신의 $worn.face.name 안으로 파고든다.<<neutral 2>><<damageFaceCover 5 struggle>>
		<<else>>
			<<print window.KR.getCreatureTypeKr($struggle[_args[0]].creature)>>【이가】 그 아래의 <<struggle_bodypart _args[0]>>에 닿으려 당신의 $worn.face.name【을를】 찢어댄다.<<neutral 1>>
		<</if>>
		<<damageFaceCover 5 struggle>>
		<<if $struggle[_args[0]].creature is "slime">>
			<span class="purple">옷감이 슬라임에 녹아들며 쉬익 소리를 낸다.</span><<damageFaceCover 20 struggle>>
		<<elseif $struggle[_args[0]].creature is "pale slime">>
			<span class="purple">옷감이 창백한 슬라임에 녹아들며 격렬하게 쉬익 소리를 낸다.</span><<damageFaceCover 30 struggle>>
		<</if>>
		<<if $worn.face.integrity lte 0>>
			<<if $struggle[_args[0]].legs is "tentacles">>
				그 촉수들이 옷감 속으로 파고들어 <span class="pink">가볍게 튕겨내 몸에서 찢어발기며, 당신의 입을 드러낸다.</span>
			<<else>>
				그 촉수가 옷감을 꿰뚫고 <span class="pink">가볍게 튕겨내 몸에서 찢어발기며, 당신의 입을 드러낸다.</span>
			<</if>>
			<<faceruined>><<set $worn.face.type.push("broken")>>
		<</if>>
	<<elseif _struggle_exposed is "naked">>
		<<if _args[0] is "vagina">>
			<<print window.KR.getCreatureTypeKr($struggle[_args].creature)>>의 촉수가 <span class="purple">당신의 <<pussy>>【을를】 꾹 누른다.</span><<neutral 4 "genitals">>
		<<elseif _args[0] is "penis">>
			<<print window.KR.getCreatureTypeKr($struggle[_args].creature)>>【이가】 <span class="purple">그 구멍을 당신의 <<penis>>에 밀착시킨다.</span><<neutral 4 "genitals">>
		<<elseif _args[0] is "anus">>
			<<print window.KR.getCreatureTypeKr($struggle[_args].creature)>>의 촉수가 <span class="purple">당신의 <<bottom>>【을를】 꾹 누른다.</span><<neutral 4 "bottom">>
		<<elseif _args[0] is "chest">>
			<<print window.KR.getCreatureTypeKr($struggle[_args].creature)>>의 촉수가 <span class="purple">당신의 <<breasts>>【을를】 꾹 누른다.</span><<neutral 4 "breasts">>
		<<elseif _args[0] is "mouth">>
			<<print window.KR.getCreatureTypeKr($struggle[_args].creature)>>의 촉수가 <span class="purple">당신의 입을 꾹 누른다.</span><<neutral 4 "mouth">>
		<</if>>
	<</if>>
<</widget>>

<<widget "struggle_bodypart">><<silently>>
	<<switch _args[0]>>
		<<case "vagina">>
			<<pussy>>
		<<case "penis">>
			<<penis>>
		<<case "anus">>
			<<bottom>>
		<<case "chest">>
			<<breasts>>
		<<case "mouth">>
			<<set _text_output to "입">>
	<</switch>>
<</silently>><<print _text_output>>
<</widget>>

<<widget "struggle_appendage">><<silently>>
	<<switch $struggle[_args[0]].creature>>
		<<case "wasp" "bee">>
			<<set $_text_output to "침">>
		<<case "squid">>
			<<set $_text_output to "촉수">>
		<<default>>
			<<set $_text_output to "부속지">>
	<</switch>>
<</silently>><<print $_text_output>>
<</widget>>

<<widget "struggle_skin">><<silently>>
	<<switch $struggle[_args[0]].creature>>
		<<case "wasp" "bee">>
			<<set $_text_output to "외골격">>
		<<default>>
			<<set $_text_output to "살점">>
	<</switch>>
<</silently>><<print $_text_output>>
<</widget>>

<<widget "struggle_flat_chest">>
	<<if $struggle.chest.legs is "tentacles">>
		<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
			<span class="pink">유두에서 모유가 흘러나오는</span> 동안 <<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 촉수가 당신의 <<breasts>>【을를】 튕겨댄다.
		<<else>>
			<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>의 촉수가 당신의 <<breasts>>【을를】 튕기며 애태운다.
		<</if>>
		<<sex 5 "breasts">>
	<<else>>
		<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
			<span class="pink">유두에서 모유가 흘러나오는</span> 동안 <<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【은는】 당신의 <<breasts>>【을를】 빨아들인다.
			<<breastfeed>><<sex 3 "breasts">>
		<<else>>
			<<print window.KR.getCreatureTypeKr($struggle.chest.creature)>>【은는】 당신의 <<breasts>>【을를】 빨아대고, 그와 동시에 <<struggle_appendage chest>>【이가】 당신의 배를 문지른다.
			<<milkvolume 1>><<sex 5 "breasts">>
		<</if>>
		<<sex 3 "breasts">>
	<</if>>
<</widget>>

<<widget "struggle_attach">>
	<<set $struggle[_args[0]].creature to $struggle.enemy[_i].name>>
	<<set $struggle[_args[0]].description to $struggle.enemy[_i].description>>
	<<set $struggle[_args[0]].legs to $struggle.enemy[_i].legs>>
	<<set $struggle.enemy[_i].location to _args[0]>>
	<!-- temp var to highlight newly attached lurkers -->
	<<set T['gold_' + _args[0]] to true>>
<</widget>>


<<widget "struggleClearActions">>
	<<if _args[0]>>
		<<if ($mouthaction).toString().includes(_args[0])>>
			<<set $mouthactiondefault to $mouthaction>><<set $mouthaction to 0>>
		<</if>>
		<<if ($leftaction).toString().includes(_args[0])>>
			<<set $leftactiondefault to $leftaction>><<set $leftaction to 0>>
		<</if>>
		<<if ($rightaction).toString().includes(_args[0])>>
			<<set $rightactiondefault to $rightaction>><<set $rightaction to 0>>
		<</if>>
		<<if ($leftarmstate).toString().includes(_args[0])>>
			<<set $leftarm to 0>><<set $leftarmstate to 0>>
		<</if>>
		<<if ($rightarmstate).toString().includes(_args[0])>>
			<<set $rightarm to 0>><<set $rightarmstate to 0>>
		<</if>>
	<</if>>
<</widget>>

<<widget "struggle_region">><<silently>>
	<<if ["mouth","vagina","penis","anus","chest"].includes(_args[0])>>
		<<switch _args[0]>>
			<<case "mouth">><<set _text_output to "머리">>
			<<case "vagina">><<set _text_output to "골반">>
			<<case "penis">><<set _text_output to "배">>
			<<case "anus">><<set _text_output to "엉덩이">>
			<<case "chest">><<set _text_output to "가슴">>
		<</switch>>
	<</if>>
	<</silently>><<print _text_output>>
<</widget>>
