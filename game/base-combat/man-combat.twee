			<<set $NPCList[_n].mouth to 0>>
			<<set _stripped to true>>
		<</if>>
		<<combat-set-hand-target _args[0] $handtarget>>

	<<elseif $NPCList[_n].heldSexToy isnot undefined and $rng lte 25 and !getSexToysofType("all").includes($NPCList[_n].lefttool) and !getSexToysofType("all").includes($NPCList[_n].righttool)>>
