		<<elseif $worn.upper.name isnot "naked" and $noupper isnot 1 and !$worn.upper.cursed>>
			<span class="purple"><<He>>【이가】 <<his>> <<print _args[0] is "left" ? "왼손" : "오른손">>【으로로】 당신의 $worn.upper.name【을를】 움켜쥔다.</span>
			<<neutral 1 _n>>
			<<set $handtarget to "upperclothes">>
