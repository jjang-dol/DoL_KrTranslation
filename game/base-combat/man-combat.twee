			<<neutral 1 _n>><<set $handtarget to "buttplug">>
			<<set $handOnButtPlug to true>>
		<<elseif $worn.genitals.name isnot "naked" and $walltype isnot "front">>
			<span class="purple"><<He>>【이가】 <<his>> <<print _args[0] is "left" ? "왼손" : "오른손">>【으로로】 당신의 $worn.genitals.name【을를】 움켜쥔다.</span>
