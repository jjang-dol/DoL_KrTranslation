			<<He>>【이가】 $_hishand【으로로】 당신의 얼굴에서 $worn.face.name【을를】 벗기려 하지만, <span class="lblue">당신은 그것을 단단히 붙잡는다.</span>
			<<if random(1, 3) is 3>>
				<span class="lblue"><<He>>【이가】 짜증 섞인 한숨을 내쉬며 손을 놓는다.</span>
				<<combat-reset-hand _args[0]>>
			<<else>>
				<<if $enemyanger gt ($enemyangermax / 2)>>
					<span class="red"><<He>>【이가】 억지로 당신의 $worn.face.name【을를】 벗겨내려 시도한다!</span>
					<<damageFaceCover 4>>
				<</if>>
			<</if>>
		<<else>>
			<<He>>【이가】 $_hishand【으로로】 당신의 얼굴에서 $worn.face.name【을를】 벗겨내어, <span class="pink">당신의 정체를 드러낸다.</span>
			<<facestrip>><<clothesstripstat>><<combat-reset-hand _args[0]>>
			<<if $mouthuse is "gagged">>
				<<set $mouthuse to 0>>
			<</if>>
		<</if>>
	<<else>>
		<<combat-reset-hand _args[0]>>
	<</if>>
<</widget>>

<<widget "combat-hand-on-chastity">>
	<<if $worn.genitals.name is "naked">>
		<<cast_aside_clothes>>
		<<combat-reset-hand _args[0]>>
	<<else>>
		<<if $worn.genitals.name is "chastity parasite">>
			<span class="blue"><<He>>【이가】 당신의 $worn.genitals.name【을를】 잡아당기더니, 이내 꽉 움켜쥔다.</span>
			<span class="lewd"><<His>> 거친 손길에 당신은 더욱 달아오른다.</span>
			<<arousal 100 "genitals">>
			<<if random(0, 100) gt $enemyanger>>
				움켜쥔 것에 대한 당신의 반응을 본 <<he>>【이가】 계속해서 괴롭힌다.
				<<arousal 200 "genitals">><<if !$earSlime.defyCooldown and $earSlime.vibration lt 120>><<set $earSlime.vibration += 5>><</if>>
			<<elseif $enemyanger gt 100>>
				움켜쥔 것에 대한 당신의 반응을 본 <<he>>【이가】 포기하기 전 한 번 더 억지로 떼어내려 시도한다.
				<<set $worn.genitals.integrity -= 5>>
				<<arousal 100 "genitals">><<combat-reset-hand _args[0]>><<set $speechchastity to 1>><<bodypart_admire_chance pubic>>
			<<else>>
				당황한 기색이 역력한 <<He>>【이가】 잠시 더 꽉 쥐더니 멈춘다.
				<<combat-reset-hand _args[0]>><<set $speechchastity to 1>><<bodypart_admire_chance pubic>>
			<</if>>
			<<set $worn.genitals.integrity -= 5>>
		<<elseif $worn.genitals.origin is $NPCList[_n].fullDescription>>
			<span class="lblue"><<He>>【이가】 놓아주기 전 당신의 $worn.genitals.name【을를】 부드럽게 붙잡는다.</span>
			<<combat-reset-hand _args[0]>><<set $speechchastity to 1>><<bodypart_admire_chance pubic>>
		<<else>>
			<span class="blue"><<He>>【이가】 당신의 $worn.genitals.name【을를】 벗겨내려 시도한다.</span>
			<<His>> 거친 손길은 당신을 더욱 애타고 달아오르게 만든다. 실망한 표정의 <<He>>【이가】 잠시 무력하게 잡아당기더니 포기한다.
			<<set $enemyanger += 5>><<combat-reset-hand _args[0]>><<set $speechchastity to 1>><<bodypart_admire_chance pubic>><<set $worn.genitals.integrity -= 10>>
		<</if>>
		<<neutral 1 "genitals" _n>><<arousal 5 "genitals">>
	<</if>>
<</widget>>

<<widget "combat-hand-on-throat">>
	<<if $settings.asphyxiaLevel gte 1>>
		<<rng>>
		<<if $consensual is 1>>
			<<mancombat_choke>>
		<<else>>
			<<mancombat_strangle>>
		<</if>>
	<</if>>
<</widget>>

<<widget "combat-hand-on-head_nipples">>
	<<sex 3 "mouth">>
	<<personselect _n>>
	<<He>>【이가】 당신의 입을 <<his>> <<= window.KR.getBreastSizeKr($NPCList[_n].breastdesc)>>에 계속해서 밀어붙인다.
	<<if $settings.breastFeedingEnabled>>
		<<if $NPCList[_n].type is "plant" and $NPCList[_n].pronoun is "f">>
			<span class="pink"><<his>> 멍울에서 넥타르가 새어 나온다.</span>
		<<elseif $NPCList[_n].lactation is 1>>
			<span class="pink"><<his>> 멍울에서 모유가 새어 나온다.</span>
		<</if>>
	<</if>>
	<<bodypart_admire_chance forehead>>
<</widget>>

<<widget "combat-pen-on-bodypart">>
	<<set $_hand to _args[0]>><<set $_penbodypart to _args[1]>>
	<<He>>【이가】 당신의 <<bodypart $_penbodypart>>에
	<<set _bodywritingFrag to Wikifier.wikifyEval('<<bodywriting_npc $_penbodypart `$NPCList[_n][$_hand + "tool"]`>>')>>
	<<set _bodywritingDiv to document.createElement('div')>>
	<<run _bodywritingDiv.appendChild(_bodywritingFrag)>>
	<<set _bodywritingOutput to _bodywritingDiv.innerHTML>>
	<<= _bodywritingOutput.replace(/<\/i>\./, '</i>라고 휘갈겨 쓴다.')>>
	<<set $newlyWritten.pushUnique($_penbodypart)>>
	<<combat-reset-hand $_hand>><<set $NPCList[_n][$_hand + "tool"] to 0>>
<</widget>>

<<widget "combat-set-hand-start">>
	<<rng>>
	<<outfitChecks>>

	<<combat-get-other-hand _args[0]>>

	<<if $askedtochoke is 1 and $consensual is 1 and $settings.asphyxiaLevel gte 1 and ($neckuse isnot "hand" or ($otherNPChand is "throat" and $rng lte 30))>>
		<<set $neckuse to "hand">>
		<<set $askedtochoke to 0>>
		<<combat-set-hand-target _args[0] "throat">>
		<<neutral 1 _n>>
		<<namedNpcReaction 0 "choke">>
	<<elseif $combatgoal is "strip">>
		<<if $worn.over_upper.name isnot "naked" and $noupper isnot 1 and !$worn.over_upper.cursed>>
			<span class="purple"><<He>>【이가】 <<his>> <<print _args[0] is "left" ? "왼손" : "오른손">>【으로로】 당신의 $worn.over_upper.name【을를】 움켜쥔다.</span>
			<<neutral 1 _n>>
