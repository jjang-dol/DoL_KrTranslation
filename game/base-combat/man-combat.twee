			<<set $NPCList[_n].righttool to _tool>>
			<<if $NPCList[_n].righttool is "light">>
				<<He>>【은는】 <<his>> 손가락 끝에 맺힌 작은 초록빛 빛【을를】 꺼내들어,
			<<elseif $NPCList[_n].righttool is "jasper pendant">>
				<<He>>【은는】 <<if $NPCList[_n].clothes.upper.name isnot "naked">><<his>> <<= $NPCList[_n].clothes.upper.name>>에서 꺼낸 <</if>>벽옥 펜던트【을를】 꺼내들어,
			<<else>>
