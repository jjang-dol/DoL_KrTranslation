		<</if>>
		<<neutral 1 _n>>
	<<elseif $enemyanger + $rng lte 15 and $NPCList[_n].traits.includes("hypnotist") and $settings.hypnosisEnabled and !$noHypnosis and !$NPCList[_n].lefthand.toString().includes("hypnosis") and !$NPCList[_n].righthand.toString().includes("hypnosis")>>
		/* lefthand/righthand input can be 0 or a string, requiring a toString() for string methods. includes() performs a partial match for strings, which catches all hypnosis-category actions and prevents another hypnosis action from starting at the same time */
		<<if $NPCList[_n].fullDescription is "Gwylan">>
			<<set _tool to $hallucinations gte 2 and $hypnosis_traits.devotion gte 3 ? "light" : "jasper pendant">>
