/* Takes NPC type to calculate volume of ejaculation to be swallowed or number to represent volume in ml. and updates stat */
<<widget "cumswallow">>
	<<set _ejaculation_volume to 0>>

	<<set _ejaculation_type to (_args[0] ? _args[0] : "human")>>

	<<if _args[1]>>
		<<set _ejaculation_volume to _args[1]>>
	<<else>>
		<<if _ejaculation_type is "human">>
			<<set _ejaculation_volume to random(5, 99)>>
		<<elseif ["wolf", "dog", "fox"].some(type => _ejaculation_type.includes(type))>>
			<<set _ejaculation_volume to random(5, 100)>>
		<<elseif ["centaur", "horse", "bull", "cow"].some(type => _ejaculation_type.includes(type))>>
			<<set _ejaculation_volume to random(25, 250)>>
		<<elseif ["boar", "pig"].some(type => _ejaculation_type.includes(type))>>
			<<set _ejaculation_volume to random(50, 300)>>
		<<elseif ["bear"].some(type => _ejaculation_type.includes(type))>>
			<<set _ejaculation_volume to random(25, 300)>>
		<<elseif ["cat"].some(type => _ejaculation_type.includes(type))>>
			<<set _ejaculation_volume to random(1, 15)>>
		<<elseif ["dolphin", "creature", "hawk", "harpy", "lizard"].some(type => _ejaculation_type.includes(type))>>
			<<set _ejaculation_volume to random(20, 150)>>
		<<else>>
			<<set _ejaculation_volume to random(3, 100)>>
		<</if>>
	<</if>>
	<<switch _args[2]>>
		<<case "tiny">><<set _ejaculation_volume to Math.ceil(_ejaculation_volume / 40)>>
		<<case "large">><<set _ejaculation_volume to Math.ceil(_ejaculation_volume * 1.5)>>
	<</switch>>

	<<if _args[2] is "knotted">>
		<<if _ejaculation_type is "human" or !$settings.bestialityEnabled>>
			<<semenswallowedstat _ejaculation_volume>>
		<<else>>
			<<animalsemenswallowedstat _ejaculation_volume>>
		<</if>>
		<<set $hunger -= 200>>
		<<set $thirst -= 200>>
		<<bodyliquid "mouth" "semen" 1>>
	<<elseif $mouthaction is "ejacspit">>
		당신은 정액을 뱉어낸다.
	<<elseif _ejaculation_type is "pc">>
		<<if $awareness gte 200>>
			<<if _ejaculation_volume lte 10>>
				<span class="lewd">당신은 정액을 꿀꺽 삼키며, <<if $ejactrait gte 1>>적은 양에 실망감을 느낀다.<<else>>양이 적어 다행이라고 생각한다.<</if>></span>
			<<elseif _ejaculation_volume lte 30>>
				<span class="lewd">
					<<if $ejactrait gte 1>>
						당신은 익숙한 맛을 즐기며 정액을 삼킨다.
					<<else>>
						당신은 정액을 삼킨다.
					<</if>>
				</span>
			<<elseif _ejaculation_volume lte 100>>
				<span class="lewd">당신은 뺨이 빵빵해질 정도로 많은 정액을 입안에 머금고는, 꿀꺽꿀꺽 요란한 소리를 내며 삼킨다. 마침내 모조리 삼키고 나자, 당신은 <<if $ejactrait gte 1>>만족스러운 듯<<else>>안도하며<</if>> 한숨을 내쉰다.</span>
			<<else>>
				<span class="lewd">당신은 어떻게든 그 엄청난 양을 견디며, 거대한 정액의 파도를 꿀꺽 삼킨다.<<if $ejactrait gte 1 and !pcAreArmsBound("any") and $fingersInVagina is 0>> 당신은 입에서 흘러내린 정액이 낭비되는 것을 원치 않아 턱 밑에 손을 모아 받아낸다.<<else>> 흘러넘친 정액이 턱과 목을 타고 줄줄 흘러내린다. <<bodyliquid "neck" "semen">><</if>></span>
			<</if>>
		<<else>>
			<span class="red">자신의 정액을 삼키려고 애쓰는 동안 눈물이 <<print either("당신의 뺨을 타고", "당신의 얼굴을 타고")>> 흘러내린다.</span>
			<<if $ejactrait is 1>>
				당신은 입술을 핥고 싶은 충동을 억누르려 혀를 깨문다. <<lstress>><<stress -10>>
			<<else>>
				<<gstress>><<stress 10>>
			<</if>>
		<</if>>
		<<semenswallowedstat _ejaculation_volume>>
		<<set $hunger -= 200>>
		<<set $thirst -= 200>>
		<<bodyliquid "mouth" "semen" 1>>
	<<else>>
		<<if $consensual is 0 and _args[3] isnot "consensual" and _ejaculation_volume gte 3>>
			<span class="red">억지로 삼키려고 애쓰는 동안 눈물이 <<print either("당신의 뺨을 타고", "당신의 얼굴을 타고")>> 흘러내린다.</span>
			<<if $ejactrait is 1>>
				당신은 입술을 핥고 싶은 충동을 억누르려 혀를 깨문다. <<garousal>><<arousal 600>>
			<<else>>
				<<gstress>><<stress 10>>
				/*Prevents gstress from being displayed twice*/
				<<set _ejacStressDisplay to true>>
			<</if>>
			<<set _ejacStatDisplay to true>>
			<<if _ejaculation_type is "human" or !$settings.bestialityEnabled>>
				<<semenswallowedstat _ejaculation_volume>>
			<<else>>
				<<animalsemenswallowedstat _ejaculation_volume>>
			<</if>>
		<<else>>
			<<if _ejaculation_volume lt 3>>
				<span class="lewd">당신은 입안에 싸질러진 정액이 아무 맛도 안 느껴질 만큼 너무나 적어서 <<if $ejactrait gte 1>>실망한다.<<else>>놀란다.<</if>></span>
			<<elseif _ejaculation_volume lte 10>>
				<span class="lewd">당신은 단숨에 정액을 삼키며, <<if $ejactrait gte 1>>적은 양에 실망감을 느낀다.<<else>>양이 적어 다행이라고 생각한다.<</if>></span>
			<<elseif _ejaculation_volume lte 30>>
				<span class="lewd">
					<<if $ejactrait gte 1>>
						당신은 <<print either("강하고 쓴", "달콤하고 진한", "톡 쏘고 짭짤한")>> 맛을 즐기며 정액을 삼킨다.
					<<else>>
						당신은 정액을 삼킨다.
					<</if>>
				</span>
			<<elseif _ejaculation_volume lte 100>>
				<span class="lewd">당신은 뺨이 빵빵해질 정도로 많은 정액을 입안에 머금고는, 꿀꺽꿀꺽 요란한 소리를 내며 삼킨다. 마침내 모조리 삼키고 나자, 당신은 <<if $ejactrait gte 1>>만족스러운 듯<<else>>안도하며<</if>> 한숨을 내쉰다.</span>
			<<else>>
				<span class="lewd">당신은 엄청난 양을 감당하려 애쓰며, 삼킬 수 있는 만큼 정액을 삼킨다.<<if $ejactrait gte 1 and !pcAreArmsBound("any")>> 한 방울도 낭비하고 싶지 않아 턱 밑에 손을 모아 넘쳐흐르는 정액을 받아낸다.<<else>> 일부는 넘쳐흘러 턱과 목을 타고 흘러내린다. <</if>></span>
			<</if>>
			<<if $mouthaction is 'ejacswallow'>>
				<<if _ejaculation_type is "human" or !$settings.bestialityEnabled>>
					<<semenswallowedstat _ejaculation_volume>>
				<<else>>
					<<animalsemenswallowedstat _ejaculation_volume>>
				<</if>>
			<<else>>
				<<set _ejaculation_volume to Math.floor(_ejaculation_volume/3)>>
				<<if _ejaculation_type is "human" or !$settings.bestialityEnabled>>
					<<semenswallowedstat _ejaculation_volume>>
				<<else>>
					<<animalsemenswallowedstat _ejaculation_volume>>
				<</if>>
			<</if>>
		<</if>>

		<<set $hunger -= 200>>
		<<set $thirst -= 200>>
		<<bodyliquid "mouth" "semen" 1>>
	<</if>>
<</widget>>
