<</widget>>

<<widget "effectstentacleadv">>
	<<set _tentacle to _args[0]>>
	<<if ["vine","root","shoot"].includes(_tentacle.type)>>
		<<set _fluid to "nectar">>
		<<set _Slimy to "Sticky">>
	<<else>>
		<<set _fluid to "fluid">>
		<<set _Slimy to "Slimy">>
	<</if>>
	<<set _fluidText to (_fluid is "nectar" ? "넥타르" : "액체")>>
	<<set _slimyText to (_Slimy is "Sticky" ? "끈적한" : "미끈한")>>
	<<rng>>
	<<set _The to ($abomination is 1 ? "<<His>>" : "")>>
	<<set _the to ($abomination is 1 ? "<<his>>" : "")>>

	/*New Controls*/
	<<if ($leftaction is "lefthittentacle" and $leftactionTarget is _tentacle.id)
	or ($rightaction is "righthittentacle" and $rightactionTarget is _tentacle.id)>>
		<<if $leftaction is "lefthittentacle" and $rightaction is "righthittentacle" and $leftactionTarget is $rightactionTarget>>
			당신은 두 손으로 _the _tentacle.fullDesc【을를】 내리치고, 그것은 당신에게서 멀어지며 물러선다.
			<<set _multi to 2>>
			<<set $leftaction to 0>><<set $leftactiondefault to "lefthittentacle">>
			<<set $rightaction to 0>><<set $rightactiondefault to "righthittentacle">>
		<<elseif $leftaction is "lefthittentacle" and $leftactionTarget is _tentacle.id>>
			당신은 왼손으로 _the _tentacle.fullDesc【을를】 내리치고, 그것은 당신에게서 멀어지며 물러선다.
			<<set _multi to 1>><<set $leftaction to 0>>
			<<set $leftactiondefault to "lefthittentacle">>
		<<else>>
			당신은 오른손으로 _the _tentacle.fullDesc【을를】 내리치고, 그것은 당신에게서 멀어지며 물러선다.
			<<set _multi to 1>>
			<<set $rightaction to 0>><<set $rightactiondefault to "righthittentacle">>
		<</if>>
		<<defiance `2 * _multi`>>
		<<set $speechhit to 1 * _multi>><<set $attackstat += 1 * _multi>>
		<<if $rng lte (currentSkillValue('physique') / 200)>>
			<span class="green">그것은 당신의 힘 앞에서 덜덜 떤다.</span>
			<<set _tentacle.tentaclehealth -= 1 * _multi>><<tentacle_record "damage" 1 * _multi>>
		<</if>>
		<<set _tentacle.tentaclehealth -= 1 * _multi>><<tentacle_record "damage" 1 * _multi>>
		<<tentacleadvdisable _tentacle>>
		<<if $abomination is 1>>
			<<person>>【은는】 고통에 움찔한다.
		<</if>>
	<</if>>

	<<if ($leftaction is "leftbanish" and $leftactionTarget is _tentacle.id)
	or ($rightaction is "rightbanish" and $rightactionTarget is _tentacle.id)>>
		<<if $leftaction is "leftbanish" and $rightaction is "rightbanish" and $leftactionTarget is $rightactionTarget and $angelBanish gte 2>>
			<<set $angelBanish -= 2>>
			당신은 기도하듯 두 손을 모은다. _The _tentacle.fullDesc【이가】 눈부시게 빛나며 당신에게서 튕겨져 나간다.
			<<set _multi to 2>>
			<<set $leftaction to 0>><<set $leftactiondefault to "leftbanish">>
			<<set $rightaction to 0>><<set $rightactiondefault to "rightbanish">>
		<<elseif $leftaction is "leftbanish" and $angelBanish gte 1 and $leftactionTarget is _tentacle.id>>
			<<set $angelBanish -->>
			당신은 왼손으로 복잡한 손동작을 취한다. _The _tentacle.fullDesc【이가】 희미하게 빛나더니 격렬하게 움츠러든다.
			<<set _multi to 1>><<set $leftaction to 0>>
			<<set $leftactiondefault to "leftbanish">>
		<<elseif $rightaction is "rightbanish" and $angelBanish gte 1 and $rightactionTarget is _tentacle.id>>
			<<set $angelBanish -->>
			당신은 오른손으로 복잡한 손동작을 취한다. _The _tentacle.fullDesc【이가】 희미하게 빛나더니 격렬하게 움츠러든다.
			<<set _multi to 1>><<set $rightaction to 0>>
			<<set $rightactiondefault to "rightbanish">>
		<<else>>
			당신은 <<if $leftaction is "leftbanish">>왼<<else>>오른<</if>>손으로 복잡한 손동작을 취하지만, <span class="red">아무 일도 일어나지 않는다</span>.
		<</if>>
		<<if $purity gte 1000>>
			<<set _multi ++>>
		<</if>>
		<<defiance `Math.floor($purity / 150) * _multi`>>
		<<set $speechbanish to 1 * _multi>><<set $attackstat += 1 * _multi>>
		<<if $rng lte ($purity / 20)>><<set _tentacle.tentaclehealth -= 10 * _multi>><<tentacle_record "banish" 10 * _multi>><</if>>
		<<set _tentacle.tentaclehealth -= 10 * _multi>><<tentacle_record "banish" 10 * _multi>>
		<<tentacleadvdisable _tentacle>>
		<<if $abomination is 1>>
			<<combatPerson>>【은는】 빛을 피해 뒷걸음질 친다.
		<</if>>
	<</if>>

	<<if ($leftaction is "leftgrabtentacle" and $leftactionTarget is _tentacle.id)
	or ($rightaction is "rightgrabtentacle" and $rightactionTarget is _tentacle.id)>>
		<<tentacleadvdisable _tentacle>> /* Make sure you call this before trying to set the tentacle info */
		<<if $leftaction is "leftgrabtentacle" and $leftactionTarget is _tentacle.id>>
			<<set _hand to "left">><<set $leftaction to 0>><<set $leftactiondefault to "leftrub">>
