<<widget "tentacle_skin">>
	<<if $skin[_args[0]] and $skin[_args[0]].special is "holy" or $skin[_args[1]] and $skin[_args[1]].special is "holy" and !$banishDisable>>
		피부 위의 성스러운 문양이 하얀 빛으로 타오르며, <span class="pink">당신을 지지고,</span> <span class="teal">_the _tentacle.fullDesc까지 태운다.</span><<pain 8>><<set _tentacle.tentaclehealth -= 12>><<tentacle_record "banish" 12>><<tentacleadvdisable _tentacle>>
		<<set $speechbanish to 1>>
	<<elseif _tentacle.traits.includes("pain") and _args[0] isnot "pubic">>
		<<if _args[0].includes("_")>>
			<<set _bodypart to _args[0].split("_").pop()>>
		<<else>>
			<<set _bodypart to _args[0]>>
		<</if>>
		<<if !(playerHasStrapon() and _bodypart is "penis")>>
			_the _tentacle.fullDesc【이가】 당신의 <<bodypart _bodypart>>에 문질러지자, 당신은 <<print $masochism_level gte 3 ? "몸을 떤" : "얼굴을 찡그린">>다.
			<<pain 1>><<gpain>>
		<</if>>
	<</if>>
<</widget>>

<<widget "tentacle_record">>
	/* Records total tentacle health reductions from various sources */
	<<set $_type to _args[0] or "fluid">>
	<<set $_amount to _args[1] or 1>>

	<<if !$combat_tentacle_record>>
		<<set $combat_tentacle_record to {
			arousal: 0,
			fluid: 0,
			damage: 0,
			banish: 0,
			hypnosis: 0,
			hypnosis_backlash: 0,
			soothe: 0,
			attrition: 0,
		}>>
	<</if>>
	<<set $combat_tentacle_record[$_type] += $_amount>>
<</widget>>
