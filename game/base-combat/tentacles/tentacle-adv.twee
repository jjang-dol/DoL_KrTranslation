			<<if ($anususe is 0 and $settings.analEnabled) or ($player.vaginaExist and $vaginause is 0 or $player.penisExist and $penisuse is 0)>>
				<br>--<<deviant5>>| --<br>

				<<if $anususe is 0 and $settings.analEnabled>>
