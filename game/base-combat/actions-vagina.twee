				<<elseif $NPCList[_j].stance isnot "topface">>
					<<if $vaginaactiondefault is "vaginatovaginafuck">>
						| <label><span class="sub">보지를 상대의 보지에 비빈다</span> <<radiobutton "$vaginaaction" "vaginatovaginafuck" checked>><<vaginaldifficulty>> <<combatpromiscuous5>></label>
					<<else>>
						| <label><span class="sub">보지를 상대의 보지에 비빈다</span> <<radiobutton "$vaginaaction" "vaginatovaginafuck">><<vaginaldifficulty>> <<combatpromiscuous5>></label>
					<</if>>
					<<break>>
				<</if>>
