			<<if $consensual is 1 and ((!hasSexStat("promiscuity", 5) and $enemytype is "man" or !hasSexStat("deviancy", 5) and $enemytype isnot "man") and !$promiscuityIgnore) or $NPCList[$vaginatarget].chastity.penis.includes("chastity")>>
