				<<if $pain gte 80>>
					"아파하는 것 같은데. 멈추지 마."
				<<elseif $pain gte 40>>
					"눈물 안 숨겨도 돼, 우리 눈엔 다 보이니까."
				<<else>>
					"손 좀 치워봐, <<bitch>>. 네 꼴사나운 얼굴 좀 찍게."
				<</if>>
			<<elseif $speechcamerapose is 1>>
				<<if $pain gte 80>>
					"아픈데도 포즈를 취해주다니. 완전 프로잖아."
				<<elseif $pain gte 40>>
					"괜찮은 척하는 거야?"
				<<else>>
					"이 창녀는 카메라가 뭘 좋아하는지 알아."
				<</if>>
			<<else>>
				<<if $pain gte 80>>
					"이제 네가 얼마나 한심한 꼴인지 다 알게 되겠지."
				<<elseif $pain gte 40>>
					"잘 찍혔네. 방금 그건 눈물이야?"
				<<else>>
					"친구들한테 당장 보여주고 싶네."
				<</if>>
			<</if>>
		<</if>>
		<</addinlineevent>>
		<<runeventpool>>
		<br>
	<</if>>

	<<if $face isnot "covered">>
		<<if $exposed is 1>>
			<<fameexhibitionism 1 "pic">>
		<<elseif $exposed gte 2>>
			<<fameexhibitionism 2 "pic">>
		<</if>>
		<<if playerBellyVisible()>>
			<<famepregnancy 1 "pic">>
		<</if>>
		<<if $sexavoid is 0 or $rapeavoid is 0>>
			<<if $consensual is 1>>
				<<famesex 1 "pic">>
			<<else>>
				<<famerape 1 "pic">>
			<</if>>
			<<if $enemytype is "beast">>
				<<famebestiality 1 "pic">>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "ahe">><<silently>>
	<<if ["남자", "소년"].includes($audiencecamera)>>
		<<set _text_output to "그">>
	<<elseif ["여자", "소녀"].includes($audiencecamera)>>
		<<set _text_output to "그녀">>
	<<elseif $audiencecamera>>
		<<set _text_output to `<span class="red">[오류: "ahe"에서 알 수 없는 audiencecamera 값 $audiencecamera]</span>`>>
	<<else>>
		<<set _text_output to `<span class="red">[오류: "ahe"에서 audiencecamera가 정의되지 않음]</span>`>>
	<</if>>
<</silently>>_text_output<</widget>>

