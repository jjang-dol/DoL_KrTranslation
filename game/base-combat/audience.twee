<</widget>>

<<widget "audiencespeech">>
	<<set $audiencemember to 0>>
	<<rng>>
	<<if $audienceforceboy is 1>>
		<<set $audiencemember to "boy">>
	<<elseif $audienceforcegirl is 1>>
