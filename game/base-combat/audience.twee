<<widget "audience">>

	/* If the enemy type is machine or tentacles, exit early and return. This avoids potential issues due to the "personselect" widget not accounting for these types */
	<<if ["machine", "tentacles"].includes($enemytype)>>
		<<exit>>
	<</if>>	

	<div @class="($debugLines ? 'debugLines-audience' : '')">
	<<set $audiencepresent to 1>>
	<<if $enemyanger gte 100>>
		<<if $enemyarousal gte (($enemyarousalmax / 10) * 8)>>
			겁에 질려 있던 관중들은, 마치 당신을 희귀하고 위험한 짐승인 양 구경하며 당신 주변으로 몰려든다.
		<<elseif $enemyarousal gte (($enemyarousalmax / 10) * 4)>>
			관중 대부분은 당신이 공격할까 두려워하며 일정한 거리를 유지한다.
		<<else>>
			관중들은 당신이 공격할까 두려워하며 일정한 거리를 유지한다.
		<</if>>
		<br>
	<<elseif $enemyanger gte 60>>
		<<if $enemyarousal gte (($enemyarousalmax / 10) * 8)>>
			조심스러움과 기대감이 뒤섞인 관중들이 당신 주위로 모여든다.
		<<elseif $enemyarousal gte (($enemyarousalmax / 10) * 4)>>
			관중들은 일정한 안전거리를 둔 채 상황을 주시한다. 그중 대담한 몇 명만이 조금씩 앞으로 다가온다.
		<<else>>
			관중들은 일정한 안전거리를 둔 채 상황을 주시한다.
		<</if>>
		<br>
	<<elseif $enemyanger gte 20>>
		<<if $enemyarousal gte (($enemyarousalmax / 10) * 8)>>
			다음에 무슨 일이 벌어질지 기대에 찬 관중들이 당신 주위로 몰려든다.
		<<elseif $enemyarousal gte (($enemyarousalmax / 10) * 4)>>
			흥분한 관중들이 우르르 몰려든다.
		<<else>>
			관중들은 흥미로운 시선으로 지켜본다.
		<</if>>
		<br>
	<<else>>
		<<if $enemyarousal gte (($enemyarousalmax / 10) * 8)>>
			더 잘 보려는 관중들이 좋은 자리를 차지하려 다투며 몰려든다.
		<<elseif $enemyarousal gte (($enemyarousalmax / 10) * 4)>>
			관중들은 흥미로운 시선으로 지켜본다. 몇몇은 더 잘 보려고 군중 속을 비집고 앞으로 나온다.
		<<else>>
			관중들은 흥미로운 시선으로 지켜본다.
		<</if>>
		<br>
	<</if>>

	<<if $location isnot "prison">>
		<<if $audiencecamera1 isnot 0>>
			<<set $audienceselector to 1>>
			<<audiencecamera>>
		<</if>>

		<<if $audiencecamera2 isnot 0>>
			<<set $audienceselector to 2>>
			<<audiencecamera>>
		<</if>>

		<<if $audiencecamera3 isnot 0>>
			<<set $audienceselector to 3>>
			<<audiencecamera>>
		<</if>>

		<<if $audiencecamera4 isnot 0>>
			<<set $audienceselector to 4>>
			<<audiencecamera>>
		<</if>>

		<<if $audiencecamera5 isnot 0>>
			<<set $audienceselector to 5>>
			<<audiencecamera>>
		<</if>>

		<<if $audiencecamera6 isnot 0>>
			<<set $audienceselector to 6>>
			<<audiencecamera>>
		<</if>>

		<<set $facepic to 0>>
		<<set $breastpic to 0>>
		<<set $bottompic to 0>>
		<<set $genitalpic to 0>>
		<<set $bodypic to 0>>

		<<if $audiencecamera1 isnot 0 and $face is "covered">>
			<span class="teal">그래도 적어도 당신의 얼굴은 가려져 있다.</span>
			<br>
		<</if>>

		<<audiencespeech>>
		/*<br> commented out due to excess space they caused*/
		<<if $rng - $enemyanger + (($enemyarousalmax / $enemyarousal) * 100) gte 0>>
			<<audiencespeech>>
			/*<br>*/
		<</if>>
		<<if $rng - $enemyanger + (($enemyarousalmax / $enemyarousal) * 100) gte 20>>
			<<audiencespeech>>
			/*<br>*/
		<</if>>
		<<if $rng - $enemyanger + (($enemyarousalmax / $enemyarousal) * 100) gte 40>>
			<<audiencespeech>>
			/*<br>*/
		<</if>>
		<<if $rng - $enemyanger + (($enemyarousalmax / $enemyarousal) * 100) gte 60>>
			<<audiencespeech>>
			/*<br>*/
		<</if>>
		<<if $rng - $enemyanger + (($enemyarousalmax / $enemyarousal) * 100) gte 80>>
			<<audiencespeech>>
			/*<br>*/
		<</if>>
		<br>
	<</if>>
	</div>
<</widget>>
