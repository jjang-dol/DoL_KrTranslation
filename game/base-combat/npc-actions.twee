:: Widgets Npc Actions [widget]
<<widget "cheeklick">>
	<<set _n to _args[0]>>
	<<set _npcff to ["즐긴다","보며 미소 짓는다","음흉하게 바라본다","보며 히죽거린다"]>>
	<<set _npccr to ["눌려 있는","밀착된","짓눌린","문질러지는"]>>
	<<set _i to random(0, 3)>>
	<<set _j to random(0, 3)>>
	<<if _args[0]>>
		<<if $NPCList[_n].penis is "mouth">>
			<<He>>【은는】 당신의 얼굴이 자신의 가랑이에 _npccr[_j] 것을 _npcff[_i].
			<<neutral 1>>
		<<elseif $NPCList[_n].penis is "mouthimminent" or $NPCList[_n].penis is "mouthentrance">>
			<<He>>【은는】 자신의 자지가 당신의 입술에 _npccr[_j] 것을 _npcff[_i].
			<<neutral 1>>
		<<elseif $NPCList[_n].vagina is "mouthentrance">>
			<<He>>【은는】 당신의 얼굴이 자신의 가랑이에 _npccr[_j] 것을 _npcff[_i].
			<<neutral 1>>
		<<else>>
			<<if $consensual is 1>>
				<<switch random(1, 4)>>
				<<case 1>>
					<<He>>【이가】 당신의 뺨을 핥는다.
					<<neutral 3>>
					<<bodypart_admire random_cheek>>
				<<case 2>>
					<<He>>【이가】 당신의 머리카락을 쓰다듬는다.
					<<neutral 3>>
					<<bodypart_admire forehead>>
				<<case 3>>
					<<He>>【이가】 당신의 귀를 가볍게 깨문다.
					<<neutral 3>>
					<<bodypart_admire forehead>>
				<<case 4>>
					<<He>>【이가】 당신의 목에 코를 비빈다.
					<<neutral 3>>
					<<bodypart_admire breasts>>
				<</switch>>
			<<else>>
				<<switch random(1, 4)>>
				<<case 1>>
					<<He>>【이가】 당신의 뺨을 핥는다.
					<<neutral 3>>
					<<bodypart_admire random_cheek>>
				<<case 2>>
					<<He>>【이가】 당신의 머리카락을 잡아당긴다.
					<<neutral 3>>
					<<bodypart_admire forehead>>
				<<case 3>>
					<<He>>【이가】 당신의 귀를 깨문다.
					<<neutral 3>>
					<<bodypart_admire random_cheek>>
				<<case 4>>
					<<He>>【이가】 당신의 목을 꽉 움켜쥔다.
					<<neutral 3>>
					<<bodypart_admire breasts>>
				<</switch>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>
