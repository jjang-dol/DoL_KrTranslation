:: Widgets Actions Anus [widget]
<<widget "actionsanustopenis">>
	<<if $combattype is "train">>
		<<set _end to $enemyno-1>>
	<<else>>
		<<set _end to 0>>
	<</if>>

	<<for _j = $enemyno-1; _j gte _end; _j-->>
		<<if $NPCList[_j].penis is 0>>
			<<if $consensual is 1 and !hasSexStat("promiscuity", 5) and $enemytype is "man" or $consensual is 1 and !hasSexStat("deviancy", 5) and $enemytype isnot "man">>
				<!-- Do Nothing -->
			<<elseif $NPCList[_j].stance isnot "topface">>
				<<if $anusactiondefault is "anustopenis">>
					| <label><span class="sub"><<his>> 자지에 올라타기</span> <<radiobutton "$anusaction" "anustopenis" checked>><<analdifficulty>> <<combatpromiscuous5>></label>
				<<else>>
					| <label><span class="sub"><<his>> 자지에 올라타기</span> <<radiobutton "$anusaction" "anustopenis">><<analdifficulty>> <<combatpromiscuous5>></label>
				<</if>>
				<<break>>
			<</if>>
		<</if>>
	<</for>>
<</widget>>

<<widget "actionsanustopenisnew">>
	<<if $NPCList[$anustarget].penis is 0>>
		<<if $consensual is 1 and (!hasSexStat("promiscuity", 5) and $enemytype is "man" or !hasSexStat("deviancy", 5) and $enemytype isnot "man") and !$promiscuityIgnore>>
			<!-- Do Nothing -->
		<<elseif $NPCList[$anustarget].stance isnot "topface" and ($enemytype isnot "man" or ($NPCList[$anustarget].location.genitals is 0 and $NPCList[$anustarget].location.head isnot "genitals"))>>
			<<set _penis to (npcHasStrapon($anustarget) ? "페니스 밴드" : "자지")>>
			<<if $NPCList[$anustarget].chastity.penis.includes("chastity")>>
				<<set _anusaction["상대의 " + $NPCList[$anustarget].chastity.penis + " 위에 올라탄다"] to "anustopenis">>
			<<else>>
				<<set _anusaction["상대의 " + _penis + " 위에 올라탄다"] to "anustopenis">>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsanuspenisfuck">>
	<<if $combattype is "train">>
		<<set _end to $enemyno-1>>
	<<else>>
		<<set _end to 0>>
	<</if>>

	<<if playerChastity("anus")>>
		<!-- Do Nothing -->
	<<elseif $worn.under_lower.anus_exposed is 1 and $worn.lower.anus_exposed is 1>>
		<<for _j = $enemyno-1; _j gte _end; _j-->>
			<<if $NPCList[_j].penis is "anusentrance" or $NPCList[_j].penis is "anusimminent">>
				<<if $consensual is 1 and !hasSexStat("promiscuity", 5) and $enemytype is "man" or $consensual is 1 and !hasSexStat("deviancy", 5) and $enemytype isnot "man">>
					<!-- Do Nothing -->
				<<else>>
					<<if $anusactiondefault is "anuspenisfuck">>
						| <label><span class="sub"><<his>> 자지를 삼키기</span> <<radiobutton "$anusaction" "anuspenisfuck" checked>> <<combatpromiscuous5>><<analvirginitywarning>><<NPCvirginitywarning $NPCList[_j].fullDescription "penile">></label>
					<<else>>
						| <label><span class="sub"><<his>> 자지를 삼키기</span> <<radiobutton "$anusaction" "anuspenisfuck">> <<combatpromiscuous5>><<analvirginitywarning>><<NPCvirginitywarning $NPCList[_j].fullDescription "penile">></label>
					<</if>>
					<<break>>
				<</if>>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

<<widget "actionsanuspenisfucknew">>
	<<if playerChastity("anus")>>
		<!-- Do Nothing -->
	<<elseif $worn.under_lower.anus_exposed is 1 and $worn.lower.anus_exposed is 1>>
		<<if $NPCList[$anustarget].penis is "anusentrance" or $NPCList[$anustarget].penis is "anusimminent">>
			<<if $consensual is 1 and ((!hasSexStat("promiscuity", 5) and $enemytype is "man" or !hasSexStat("deviancy", 5) and $enemytype isnot "man") and !$promiscuityIgnore) or $NPCList[$anustarget].chastity.penis.includes("chastity")>>
				<!-- Do Nothing -->
			<<else>>
				<<set _penis to (npcHasStrapon($anustarget) ? "페니스 밴드" : "자지")>>
				<<set _anusaction["상대의 " + _penis + "【을를】 받아들인다"] to "anuspenisfuck">>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsanuspenisdoublefuck">>
	<<if playerChastity("anus")>>
		<!-- Do Nothing -->
	<<elseif $worn.under_lower.anus_exposed is 1 and $worn.lower.anus_exposed is 1>>
		<<if $consensual is 1 and ((!hasSexStat("promiscuity", 5) and $enemytype is "man" or !hasSexStat("deviancy", 5) and $enemytype isnot "man") and !$promiscuityIgnore) or $awareness lt 300>>
			<!-- Do Nothing -->
		<<else>>
			<<if ($NPCList[$anustarget].penis is "anusdouble" or $NPCList[$anustarget].chastity.penis.includes("chastity")) and !$NPCList[$anusdoubletarget].chastity.penis.includes("chastity")>>
				<<set _anusaction["상대의 " + window.KR.getPenisDescKr($NPCList[$anusdoubletarget].penisdesc) + "【을를】 받아들인다"] to "anuspenisdoublefuck">>
			<<elseif ($NPCList[$anusdoubletarget].penis is "anusdouble" or $NPCList[$anusdoubletarget].chastity.penis.includes("chastity")) and !$NPCList[$anustarget].chastity.penis.includes("chastity")>>
				<<set _anusaction["상대의 " + window.KR.getPenisDescKr($NPCList[$anustarget].penisdesc) + "【을를】 받아들인다"] to "anuspenisdoublefuck">>
			<<elseif !($NPCList[$anustarget].chastity.penis.includes("chastity") and $NPCList[$anusdoubletarget].chastity.penis.includes("chastity"))>>
				<<set _anusaction["두 자지를 모두 받아들인다"] to "anuspenisdoublefuck">>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsanusMouthEntrance">>
	<<if $NPCList[$anustarget].mouth is "anusentrance">>
		<<if $consensual is 1 and $promiscuity lt 0 and !$promiscuityIgnore>>
		<<else>>
			<<set _anusaction["상대의 입에 엉덩이를 밀어붙인다"] to "bottombay">>
		<</if>>
		<<set _anusaction["상대의 얼굴에 비빈다"] to "othermouthtease">>
	<</if>>
<</widget>>

<<widget "actionsanusMouthImminent">>
	<<if $NPCList[$anustarget].mouth is "anusimminent">>
		<<set _anusaction["상대의 입술에 비빈다"] to "othermouthrub">>
		<<set _anusaction["물러난다"] to "othermouthescape">>
	<</if>>
<</widget>>

<<widget "actionsanusMouthPenetration">>
	<<if $consensual is 0 or (!hasSexStat("promiscuity", 4) and $enemytype is "man" and !$promiscuityIgnore) or (!hasSexStat("deviancy", 4) and $enemytype isnot "man" and !$promiscuityIgnore)>>
		<<set _anusaction["협조한다"] to "othermouthcooperate">>
	<<else>>
		<<set _anusaction["비벼댄다"] to "othermouthcooperate">>
	<</if>>
<</widget>>

<<widget "actionsanusHandEntrance">>
	<<if $NPCList[$anustarget].lefthand is "anusentrance" or $NPCList[$anustarget].righthand is "anusentrance">>
		<<if $consensual is 1 and $promiscuity lt 0 and !$promiscuityIgnore>>
		<<else>>
			<<set _anusaction["상대의 손을 엉덩이로 조인다"] to "bottomhandbay">>
		<</if>>
		<<set _anusaction["상대의 손가락에 항문을 비빈다"] to "handtease">>
	<</if>>
<</widget>>

<<widget "actionsanusHandPenetration">>
	<<if $consensual is 0 or (!hasSexStat("promiscuity", 4) and $enemytype is "man" and !$promiscuityIgnore) or (!hasSexStat("deviancy", 4) and $enemytype isnot "man" and !$promiscuityIgnore)>>
		<<set _anusaction["협조한다"] to "handcooperate">>
	<<else>>
		<<set _anusaction["받아들인다"] to "handtake">>
		<<set _anusaction["비벼댄다"] to "handcooperate">>
	<</if>>
<</widget>>

<<widget "actionsanusPenisEntrance">>
	<<actionsanuspenisfucknew>>
	<<if $consensual is 1 and (!hasSexStat("promiscuity", 4) and $enemytype is "man" or !hasSexStat("deviancy", 4) and $enemytype isnot "man") and !$promiscuityIgnore>>
	<<else>>
		<<set _anusaction["엉덩이로 밀어낸다"] to "penischeeks">>
	<</if>>
	<<if $player.vaginaExist and $vaginause is 0 and !playerChastity("vagina")>>
		<<set _anusaction["보지를 대신 내민다"] to "penispussy">>
	<</if>>
	<<if $settings.vaginalDoubleEnabled and $awareness gt 300 and $vaginause is "penis" and $NPCList[$vaginatarget].penissize gte 2 and $NPCList[$anustarget].penissize gte 2 and !playerChastity("vagina") and !["legLock","legLocked"].includes($feetuse)>>
		<<set _anusaction["보지 이중 삽입으로 대신 유도한다"] to "penispussydouble">>
	<</if>>
	<<set _anusaction["끝을 애태운다"] to "penistease">>
	<<if $settings.analDoubleEnabled and _secondtarget is true and ($vaginause is 0 or ($vaginause isnot 0 and $vaginause isnot "penisdouble")) and $awareness gte 300 and !["legLock","legLocked"].includes($feetuse)>>
		<<if $npc.includes($NPCList[$anusdoubletarget].fullDescription)>>
			<<set _anusaction[$NPCList[$anusdoubletarget].fullDescription + "의 " + window.KR.getPenisDescKr($NPCList[$anusdoubletarget].penisdesc) + " 위에 올라탄다"] to "anustopenisdouble">>
		<<else>>
			<<set _anusaction[$NPCList[$anusdoubletarget].fullDescription + "의 " + window.KR.getPenisDescKr($NPCList[$anusdoubletarget].penisdesc) + " 위에 올라탄다"] to "anustopenisdouble">>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsanusPenisImminent">>
	<<actionsanuspenisfucknew>>
	<<set _anusaction["비빈다"] to "rub">>
	<<if ($consensual is 0 or (hasSexStat("promiscuity", 4) and $enemytype is "man") or (hasSexStat("deviancy", 4) and $enemytype isnot "man")) and currentSkillValue("analskill") gte 800>>
		<<set _anusaction["사정 직전까지 몰아간다"] to "penisEdging">>
	<</if>>
	<<set _anusaction["물러난다"] to "escape">>
<</widget>>

<<widget "actionsanusPenisPenetration">>
	<<set _anusaction["받아들인다"] to "take">>
	<<if $consensual is 0 or (!hasSexStat("promiscuity", 4) and $enemytype is "man" and !$promiscuityIgnore) or (!hasSexStat("deviancy", 4) and $enemytype isnot "man" and !$promiscuityIgnore)>>
		<<set _anusaction["협조한다"] to "cooperate">>
	<<else>>
		<<set _anusaction["박아댄다"] to "cooperate">>
	<</if>>
	<<if ($consensual is 0 or (hasSexStat("promiscuity", 4) and $enemytype is "man") or (hasSexStat("deviancy", 4) and $enemytype isnot "man")) and currentSkillValue("analskill") gte 800>>
		<<set _anusaction["사정 직전까지 몰아간다"] to "penisEdging">>
	<</if>>
	<<if !playerIsPregnant() and playerCanCarryAnally() and $sexStats.vagina.menstruation.currentState isnot "recovering" and playerPregnancyPossibleWith($NPCList[$anustarget]) and $enemyarousal gte $enemyarousalmax and $demon gte 6 and $demonbuild gte 90>>
		<<if playerAwareTheyCanBePregnant()>>
			<<set _anusaction["강제로 임신당한다"] to "forceImpregnation">>
		<<else>>
			<<set _anusaction["?????"] to "forceImpregnation">>
		<</if>>
	<</if>>
	<<if _secondtarget is true and ($vaginause is 0 or ($vaginause isnot 0 and $vaginause isnot "penisdouble")) and $awareness gte 300 and !["legLock","legLocked"].includes($feetuse)>>
		<<if $npc.includes($NPCList[$anusdoubletarget].fullDescription)>>
			<<set _anusaction[$NPCList[$anusdoubletarget].fullDescription + "의 " + window.KR.getPenisDescKr($NPCList[$anusdoubletarget].penisdesc) + " 위에 올라탄다"] to "anustopenisdouble">>
		<<else>>
			<<set _anusaction[$NPCList[$anusdoubletarget].fullDescription + "의 " + window.KR.getPenisDescKr($NPCList[$anusdoubletarget].penisdesc) + " 위에 올라탄다"] to "anustopenisdouble">>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsanusPenisDoubleEntrance">>
	<<actionsanuspenisdoublefuck>>
	<<set _anusaction["애태운다"] to "penisdoubletease">>
	<<if $player.vaginaExist and $vaginause is 0 and !playerChastity("vagina")>>
		<<set _anusaction["보지를 대신 내민다"] to "penispussydap">>
	<</if>>
<</widget>>

<<widget "actionsanusPenisDoubleImminent">>
	<<actionsanuspenisdoublefuck>>
	<<set _anusaction["비빈다"] to "rub">>
	<<if ($consensual is 0 or (hasSexStat("promiscuity", 5) and $enemytype is "man") or (hasSexStat("deviancy", 5) and $enemytype isnot "man")) and currentSkillValue("analskill") gte 800>>
		<<set _anusaction["둘을 사정 직전까지 몰아간다"] to "penisDoubleEdging">>
	<</if>>
	<<set _anusaction["물러난다"] to "doubleescape">>
<</widget>>

<<widget "actionsanusPenisDoublePenetration">>
	<<set _anusaction["받아들인다"] to "doubletake">>
	<<if $consensual is 0 or (!hasSexStat("promiscuity", 5) and $enemytype is "man" and !$promiscuityIgnore) or (!hasSexStat("deviancy", 5) and $enemytype isnot "man" and !$promiscuityIgnore) or $awareness lt 300>>
		<<set _anusaction["협조한다"] to "doublecooperate">>
	<<else>>
		<<set _anusaction["박아댄다"] to "doublecooperate">>
		<<if $NPCList[$anustarget].penis isnot "anusdouble" or $NPCList[$anusdoubletarget].penis isnot "anusdouble">>
			<<set _anusaction["두 번째 자지를 받아들인다"] to "anuspenisdoublefuck">>
		<</if>>
	<</if>>
	<<if ($consensual is 0 or (hasSexStat("promiscuity", 5) and $enemytype is "man") or (hasSexStat("deviancy", 5) and $enemytype isnot "man")) and currentSkillValue("analskill") gte 800>>
		<<set _anusaction["둘을 사정 직전까지 몰아간다"] to "penisDoubleEdging">>
	<</if>>
<</widget>>

<<widget "actionsanusFaceAgainstAnus">>
	<<set _anusaction["비빈다"] to "otherMouthAnusRub">>
	<<set _anusaction["멈춘다"] to "otherMouthAnusStop">>
<</widget>>

<<widget "actionsanusHandAgainstAnus">>
	<<set _anusaction["비빈다"] to "handAnusRub">>
	<<set _anusaction["멈춘다"] to "handAnusStop">>
<</widget>>

<<widget "actionsanusPenisAgainstAnus">>
	<<set _anusaction["비빈다"] to "otherAnusRub">>
	<<set _anusaction["멈춘다"] to "otherAnusStop">>
<</widget>>

:: Widgets Effects Anus [widget]
<<widget "effectsanustopenis">>
	<<if $anusaction is "anustopenis">>
		<<if $anusstate is "entrance">>
			<<selectNpcWithPartInPosition "penis" "anusentrance">>
			<<set $anusdoubletarget to $anustarget>>
			<<set $anustarget to _j>>
			<<set $anusaction to "anustopenisdouble">>
		<<else>>
			<<personselect $anustarget>>
			<<set $anusaction to 0>><<submission 10>><<analskilluse>><<combatpromiscuity5>>
			<<if $anususe is 0 or $anusstate is "entrance">>
				<<if combatSkillCheck("anal", $anustarget)>>
					<<if $NPCList[$anustarget].penis is 0>>
						<<submission 2>><<set $anususe to "penis">><<set $NPCList[$anustarget].penis to "anusentrance">><<set $anusstate to "entrance">><<set $anusactiondefault to "penistease">>
						<<if $leftarm is "anus">>
							<<set $leftarm to 0>>
						<</if>>
						<<if $rightarm is "anus">>
							<<set $rightarm to 0>>
						<</if>>
						<span class="lblue">당신은 <<combatperson>> 위로 올라타서 당신의 <<bottom>>【으로로】 <<his>> <<npcPenis $anustarget>>【을를】 누른다.</span>
						<<if $NPCList[$anustarget].type is "plant" and $NPCList[$anustarget].penissize gte 4 and canImpregnateParasite("anus")>>
							<span class="red">그것에게서 느껴지는 무언가에 겁이 난다.</span>
						<</if>>
						<<if $NPCList[$anustarget].condom and $NPCList[$anustarget].condom.willUse is true and $NPCList[$anustarget].condom.worn is false and !$NPCList[$anustarget].penisdesc.includes("strap-on")>>
							<<if $NPCList[$anustarget].chastity.penis.includes("chastity")>>
								<<He>>【은는】 콘돔을 끼우려 하지만, <<his>> $NPCList[$anustarget].chastity.penis 위로 잘 씌워지지 않는 것 같다. <span class="red"><<He>>【은는】 이내 포기해버린다.</span>
								<<set $NPCList[$anustarget].condom.willUse to false>>
							<<else>>
								<span class="green"><<He>>【은는】 <<condomDesc $anustarget>>【을를】 <<his>> 자지에 씌운다.</span>
								<<equipNPCCondom $anustarget>>
							<</if>>
						<</if>>
						<<if $enemytype is "beast">><<set $NPCList[$anustarget].stance to "top">><</if>>
						<<set $NPCList[$anustarget].location.genitals to "genitals">>
						<<namedNpcReaction $anustarget "initiative">>
					<<else>>
						<span class="blue">당신은 <<bottom>>【으로로】 <<combatperson>> 위로 올라타려 하지만, 그 육봉은 이미 차지되어 있다.</span><<set $anusactiondefault to "anustopenis">>
					<</if>>
				<<else>>
					<span class="blue">당신은 <<bottom>>【으로로】 <<combatperson>> 위로 올라타려 하지만, <<ohe>>【이가】 당신을 밀쳐낸다.</span><<set $anusactiondefault to "anustopenis">>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "effectsanuspenisfuck">>
	<<if $anusaction is "anuspenisfuck" and ["anusentrance","anusimminent","anusentrancedouble","anusimminentdouble"].includes($NPCList[$anustarget].penis)>>
		<<set $anusaction to 0>><<submission 20>><<analskilluse>><<combatpromiscuity5>>
		<<if $anusWetness + (currentSkillValue("analskill") / 10) gte ($NPCList[$anustarget].penissize * 15) + random(1, 40) or random(1, 2) is 2>>
			<<if $anususe is "penisdouble">>
				<<set _dub to "double">>
			<<else>>
				<<set _dub to "">>
			<</if>>
			<<set $anusactiondefault to "cooperate" + _dub>>
			<<set $NPCList[$anustarget].penis to "anus" + _dub>>
			<<if $player.virginity.anal isnot true>>
				<<anus_lube_text>> <span class="pink">당신은 <<personselect $anustarget>><<combatpersons>> <<= window.KR.getPenisDescKr($NPCList[$anustarget].penisdesc)>>【을를】 향해 몸을 들이밀며, 그것을 당신의 <<bottom>> 깊숙이 <<analtext>> 받아들인다.</span>
				<<switch $NPCList[$anustarget].penissize>>
				<<case 5>>
					<span class="lewd">신음을 내뱉고 싶었지만, 거대한 크기에 숨이 턱 막혀버린다.</span>
				<<case 4>>
					<span class="lewd"><<his>> 자지를 감당하기 위해 엉덩이가 늘어나며 몸이 떨린다.</span>
				<<case 1>>
					<span class="lewd">너무 작아서 거의 느껴지지도 않는다.</span>
				<<default>>
					<span class="lewd">육봉이 당신의 몸을 침범하자 몸이 떨린다.</span>
				<</switch>>
				<<sex 30 "anus" $anustarget>>
			<<elseif $player.virginity.anal is true>>
				<<anus_lube_text>> <span class="pink">당신은 <<personselect $anustarget>><<combatpersons>> <<= window.KR.getPenisDescKr($NPCList[$anustarget].penisdesc)>>【을를】 향해 몸을 들이밀며, 그것을</span> <span class="red">당신의 처녀인 <<bottom>> 깊숙이 <<analtext>> 받아들인다.</span>
				<<switch $NPCList[$anustarget].penissize>>
					<<case 5>><span class="red">비명을 지르고 싶었지만, 침범해 오는 거대한 육봉의 크기에 모든 생각과 숨이 막혀버린다.</span>
					<<case 4>><span class="red"><<his>> 자지를 감당하기 위해 엉덩이가 발버둥 치며 당신은 비명을 지른다.</span>
					<<case 1>><span class="red">당신의 <<bottom>>【이가】 그렇게 유린당한 건 처음일지 몰라도, <<his>> 자지는 너무 작아서 거의 느껴지지도 않는다.</span>
					<<default>><span class="red">당신의 <<bottom>>【이가】 처음으로 유린당하자 당신은 숨을 헐떡인다.</span>
				<</switch>>
				<<sex 100 "anus" $anustarget>><<takeVirginity $NPCList[$anustarget].fullDescription "anal">><<bruise anus>><<violence 30>><<set $speechanusvirgin to 1>>
			<</if>>
			<<takeNPCVirginity $anustarget "penile">><<analstat>><<raped>><<anusraped>><<set $anusstate to _dub + "penetrated">>
			<<unset _dub>>
		<<else>>
