							<<set $worn.over_upper.state_top to "waist">><<neutral 1>>
							<<if $worn.over_upper.state is "midriff">>
								<<set $worn.over_upper.state to "waist">>
							<</if>>
							<<if $worn.over_lower.state is "midriff">>
