:: Widgets Combat Beast [widget]
<!-- DEV NOTES NG v2.7 Beast to NPC notes. The <<beast>> widget is analogous to <<man>> (which calls <<man-combat>>) widget, otherwise combat is identical. -->
<!-- All beasts use $pronoun = "i". This will need to be commonised to m/f like other NPCs so will require cleanup. -->
<!-- $semenpuddle is unique to beast combat and only works in context of train combat. Effect is captured in this widget and could be expanded to man-combat -->
<!-- $player.penisExist and $player.vaginaExist are PC variables, should really be converted to gender / pronoun checks for PC... fix later -->
<!-- "Growling" should convert to widget to capture other beast types (squawking, yowling, roaring, etc.), as well as a "whimpering" Dom/Pain. "Jaws" "Claws" "Teeth"-->
<!-- The "man" widget sets the gang combat dynamic (and handle gender surprise), then calls man-combat for each combatant. "beast" skips this step and sets up next combatant as part of attack calls during events. -->
<!-- This could be reworked with "man" becoming "gang-combat" and new "train-combat" which can call either "man-combat" or "beast-combat" (renamed from "beast") with looping function put into "train-attack". Gender surprise can be worked into "train-attack" -->
<!-- SKIPPED .claws (0, 1) replacing $claws. Claws are rarely removed (only for dolphins). This could be revisited depending on new beast types added --> <!-- This is no longer the case see beast-generation.twee -->
<!-- TODO New widgets: growling, whimpering, jaws, claws, teeth -->
<!-- TODO Create train-combat functionality for human NPCs -->
<!-- Any instances of .location used are to prevent weirdness with monsterperson chest play.-->
<<widget "beast">>
    <div @class="($debugLines ? 'debugLines-beast' : '')">
    <<outfitChecks>>
    <<set _n to $active_enemy>>

	<<if $NPCList[_n].pronoun is "m">>
		<<set $pronoun to "m">>
	<<elseif $NPCList[_n].pronoun is "f">>
		<<set $pronoun to "f">>
	<<else>>
		<<set $pronoun to "i">>
	<</if>>

	<<if $hypnosis_deviancy_check is undefined>>
		<<set $hypnosis_deviancy_check to 1>>
		<<if $hypnosis_traits.deviancy gte random(1, 5) and $NPCList[_n].stance is "approach">>
			<<if $hypnosis_traits.devotion gte 5>>
				원초적인 충동이 당신 안에서 잠깐 솟아오르지만,
				<span class="forest-green">
					이내 사그라든다.
					<<if $worn.neck.collared gte 1>>
						당신의 $worn.neck.name【이가】 당겨지는 듯한 느낌이 들고,
					<<else>>
						목에 목걸이가 채워지는 환상에 피부가 따끔거린다. 목줄이 당겨지고,
					<</if>>
					당신을 몽상에서 깨어나게 한다.
				</span>
			<<elseif $uncomfortable.hypnosis is false>>
				<<if $water is 1 or $underwater is 1>>
					<<hypnosisText '원초적인 충동이 당신 안에서 부풀어 오른다. <span class="purple">당신은 도발적으로 몸을 흔든다.</span>'>>
				<<else>>
					<<hypnosisText '원초적인 충동이 당신 안에서 부풀어 오른다. <span class="purple">당신은 무릎을 꿇고 도발적으로 몸을 흔든다.</span>'>>
				<</if>>
				<span class="pink"><<beasttype>>【은는】 당신이 보여준 틈을 타 파고든다.</span>
				<<if $rng gte 71 and $position isnot "wall" and $NPCList[_n].location.head is 0>>
					<<set $NPCList[_n].stance to "topface">><<set $NPCList[_n].mouth to 0>>
				<<else>>
					<<set $NPCList[_n].stance to "top">><<set $head to "grappled">><<set $NPCList[_n].mouth to 0>>
				<</if>>
			<<elseif currentSkillValue('willpower') lt random(1, 1000)>>
				<<if $water is 1 or $underwater is 1>>
					<<hypnosisText '원초적인 충동이 당신 안에서 부풀어 오른다. <span class="purple">당신은 도발적으로 몸을 흔든다.</span>'>>
				<<else>>
					<<hypnosisText '원초적인 충동이 당신 안에서 부풀어 오른다. <span class="purple">당신은 무릎을 꿇고 도발적으로 몸을 흔든다.</span>'>>
				<</if>>
				<span class="pink"><<beasttype>>【은는】 당신이 보여준 틈을 타 파고든다.</span>
				<<if $rng gte 71 and $position isnot "wall" and $NPCList[_n].location.head is 0>>
					<<set $NPCList[_n].stance to "topface">><<set $NPCList[_n].mouth to 0>>
				<<else>>
					<<set $NPCList[_n].stance to "top">><<set $head to "grappled">><<set $NPCList[_n].mouth to 0>>
				<</if>>
			<<else>>
				원초적인 충동이 당신 안에서 솟아오르는 것을 느끼지만, <span class="teal">그에 따른 충동을 무시한다.</span><<gwillpower>><<willpower 2>>
			<</if>>
		<</if>>
	<</if>>

	<<if $NPCList[_n].stance is "top">>
		<<if $NPCList[_n].type is "horse" or $NPCList[_n].type is "centaur">>
			<<if $position is "wall">>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 당신의 구속된 몸 위로 교미 자세를 취하며 솟구친다.
			<<else>>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 당신 위로 교미 자세를 취하며 솟구친다.
			<</if>>
		<<else>>
			<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 교미 자세로 당신을 꼼짝 못 하게 누른다.
			<<if $semenpuddle gte 4>>
				<<if $water is 0>>
					바닥에 묻은 정액 때문에 찔러넣을 때마다 당신의 무릎이 미끄러진다.
				<<else>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>

	<<if $NPCList[_n].stance is "topface">>
		<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 앞쪽에서 당신을 꼼짝 못 하게 누른다.
		<<if $semenpuddle gte 4>>
			<<if $water is 0>>
				바닥에 묻은 정액 때문에 찔러넣을 때마다 당신은 미끄러진다.
			<<else>>
			<</if>>
		<</if>>
	<</if>>

	<<if $NPCList[_n].stance is "approach">>
		<<if $enemyanger gte 120>>
			<<if $NPCList[_n].type is "hawk">>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 당신에게 날카로운 비명을 지른다.
			<<else>>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 당신에게 <<bhis>> 이빨을 드러낸다.
			<</if>>
		<<elseif $enemyanger gte 80>>
			<<if $NPCList[_n].type is "hawk">>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 <<bhis>> 날개를 퍼덕인다.
			<<else>>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 당신에게 <<bhis>> 이빨을 드러낸다.
			<</if>>
		<<elseif $enemyanger gte 40>>
			<<if $water is 1>>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 당신 주위를 빙글빙글 헤엄친다.
			<<elseif $NPCList[_n].type is "hawk">>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 앞뒤로 펄쩍펄쩍 뛴다.
			<<else>>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 앞뒤로 서성거린다.
			<</if>>
		<<else>>
			<<if $water is 1>>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 당신 근처를 헤엄친다.
			<<else>>
				<<print window.KR.getBeastTypeKr($NPCList[_n].type)>>【이가】 당신을 덮쳐온다.
			<</if>>
		<</if>>
	<</if>>

	<<if $NPCList[_n].monster is "monster">>
		<!-- HAND SECTION -->

		<<hand_section>>

		/* End Hand Section */

		<!-- CHEST START -->

		<<chest_section>>

	<</if>>



	<<if $NPCList[_n].mouth is "hair">>
		<<if $enemyanger + $rng lte 50>>
			<span class="blue"><<bHe>>【이가】 당신의 머리채를 놓는다.</span>
			<<set $NPCList[_n].mouth to 0>>
		<<elseif $mouthuse isnot "breasts">>
			<<bHe>>【이가】 당신의 머리채를 잡아당겨 머리를 뒤로 젖힌다.
			<<violence 1>>
		<</if>>
	<</if>>

	<<beastclothing>>

	<<if $NPCList[_n].mouth is "neck">>
		<<if $enemyanger + $rng lte 100>>
			<span class="teal"><<bHe>>【이가】 당신의 목에서 <<bhis>> <<beast_jaws_text>>【을를】 떼어낸다.</span>
			<<set $NPCList[_n].mouth to 0>>
		<<elseif $enemyanger + $rng lte 200>>
			<<bHe>>【이가】 계속해서 당신의 목을 억누른다.
			<<violence 3>><<bruise neck>><<hitstat>>
		<<else>>
			<<bHe>>【이가】 <<bhis>> <<beast_jaws_text>>【을를】 조여온다. 숨을 쉴 수 없다!
			<<violence 10>><<bruise neck>><<bruise neck>><<hitstat>>
		<</if>>
	<</if>>

	<<rng>>

	/*TODO: Adjust to correct for herm characters*/
	<<if $NPCList[_n].penis is "thighs">>
		<<if $player.vaginaExist>>
			<<if $rng gte 101>>
				<span class="blue"><<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 <<pussy>> 쪽으로 기울인다.</span>
				<<set $thighuse to 0>><<set $NPCList[_n].penis to "vaginaentrance">><<set $vaginause to "penis">><<set $vaginastate to "entrance">><<set $thighactiondefault to "thighs">><<set $vaginatarget to _n>>
			<<else>>
				<<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 허벅지와 <<pussy>> 사이에서 문지른다.
				<<sex 5 "genitals">>
			<</if>>
		<<else>>
			<<if $rng gte 101>>
				<<bHe>>【이가】 <<bhis>> 자지를 당신의 허벅지 사이에서 빼낸다.
				<<set $thighuse to 0>><<set $NPCList[_n].penis to 0>><<set $thighactiondefault to "thighs">>
			<<else>>
				<<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 허벅지 사이에서 문지른다.
				<<sex 5 "anus">>
			<</if>>
		<</if>>
	<</if>>

	<<if $NPCList[_n].penis is "vagina">>
		<<set _pain to $vaginalPain>>
		<<if $enemyanger gte 100>><<set _pain *= 1.5>>
			<<if $enemyarousal gte (($enemyarousalmax / 5) * 4)>>
				<<bHe>>【이가】 거친 기세로 당신의 <<pussy>>【을를】 박는다.
			<<elseif $enemyarousal gte (($enemyarousalmax / 5) * 2)>>
				<<bHe>>【이가】 당신의 <<pussy>>【을를】 계속해서 박는다. 찔러넣을 때마다 이전보다 더 깊게 느껴진다.
			<<else>>
				우위를 증명하고 싶은 듯, <<bhe>>【은는】 당신의 <<pussy>>【을를】 깊고 신중하게 찔러넣는다.
			<</if>>
		<<elseif $enemyanger gte 20>>
			<<if $enemyarousal gte (($enemyarousalmax / 5) * 4)>>
				<<bhe>>【이가】 당신의 <<pussy>>【을를】 마구 찧어댈 때마다 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【이가】 맥동하는 것이 느껴진다.
			<<elseif $enemyarousal gte (($enemyarousalmax / 5) * 2)>>
				<<bHe>>【이가】 점점 더 갈망하며 당신의 <<pussy>>【을를】 유린한다.
			<<else>>
				<<bHe>>【이가】 깊고 신중한 찌르기로 당신의 <<pussy>>【을를】 박는다.
			<</if>>
		<<else>>
			<<if $enemyarousal gte (($enemyarousalmax / 5) * 4)>>
				<<bHe>>【이가】 당신 안에 씨를 채우기를 갈망하며, 당신의 <<pussy>>【을를】 박는다.
			<<elseif $enemyarousal gte (($enemyarousalmax / 5) * 2)>>
				<<bHe>>【이가】 쉴 새 없이 당신의 <<pussy>>【을를】 찧어댄다.
			<<else>>
				<<bHe>>【이가】 당신의 <<pussy>>에 계속해서 찔러넣는다.
			<</if>>
		<</if>>
		<<sex 30 "genitals">><<bruise vagina>><<violence 2>><<pain _pain>>
	<</if>>

	<<rng>>

	<<if $NPCList[_n].penis is "vaginaimminent" and !playerChastity("vagina")>>
		<<set _pain to $vaginalPain>>
		<<if $player.virginity.vaginal isnot true>>
			<<if $NPCList[_n].penissize gte 5>>
				<span class="pink"><<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 <<pussy>> 깊숙이 찔러넣는다.</span> 그 엄청난 크기에 생각조차 날아간다.
				<<sex 30 "genitals">><<set _pain *= 3>><<pain _pain>>
			<<elseif $NPCList[_n].penissize gte 4>>
				<span class="pink"><<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 <<pussy>> 깊숙이 찔러넣는다.</span>
				<<sex 30 "genitals">><<set _pain *= 2>><<pain _pain>>
			<<else>>
				<span class="pink"><<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 <<pussy>> 깊숙이 찔러넣는다.</span>
				<<sex 30 "genitals">><<pain _pain>>
			<</if>>
			<<sex 30 "genitals">><<takeVirginity $NPCList[_n].fullDescription "vaginal">><<violence 2>>
		<<elseif $player.virginity.vaginal is true>>
			<<if $sexStats.vagina.pregnancy.totalBirthEvents gt 0>>
				<span class="red">처녀막이 없음에도 불구하고, 처녀를 잃고 순결을 빼앗기자 당신은 몸 안에서 무언가 변하는 것을 느낀다.</span>
				<<violence 10>>
			<<else>>
				<<switch $NPCList[_n].penissize>>
					<<case 5>>
						<span class="red"><<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 처녀 보지 깊숙이 찔러넣고,</span><span class="red"> 처녀막을 파괴하며 당신의 순결을 영원히 빼앗는다. 비명을 지르고 싶지만, 엄청난 크기에 숨이 막히고 사고가 정지된다.</span>
						<<violence 200>><<set _pain *= 3>><<pain _pain>>
					<<case 4>>
						<span class="red"><<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 처녀 보지 깊숙이 찔러넣고,</span><span class="red"> 처녀막을 파괴하며 당신의 순결을 영원히 빼앗는다. 당신의 <<pussy>>【은는】 <<bhis>> 자지를 힘겹게 받아들이고, 당신은 비명을 지른다.</span>
						<<violence 200>><<set _pain *= 2>><<pain _pain>>
					<<case 1>>
						<span class="pink"><<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 처녀 보지 깊숙이 찔러넣고,</span><span class="red"> 처녀막을 부수며 당신의 순결을 영원히 빼앗는다.</span><span class="green"> 엄밀히 말해 더 이상 처녀가 아니게 되었지만, 감각은 거의 느껴지지 않는다.</span>
						<<violence 25 4 4>>
					<<default>>
						<span class="pink"><<bHe>>【이가】 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 처녀 보지 깊숙이 찔러넣고,</span><span class="red"> 처녀막을 부수며 당신의 순결을 영원히 빼앗는다.</span>
						<<violence 100>><<pain _pain>>
				<</switch>>
			<</if>>
			<<sex 100 "genitals">><<takeVirginity $NPCList[_n].fullDescription "vaginal">>
		<</if>>
		<<vaginalstat>><<set $NPCList[_n].penis to "vagina">><<bruise vagina>><<takeNPCVirginity _n "penile">><<bruise vagina>><<raped>><<vaginaraped>><<set $vaginastate to "penetrated">>
	<</if>>

	<<rng>>

	<!-- DEBUG syntax issue with this IF statement set v2.7 (???) NG -->
	<<if $NPCList[_n].penis is "vaginaentrance">>
		<<if $worn.over_lower.vagina_exposed is 0>>
			<<bHe>>【이가】 $worn.over_lower.name 위로 당신의 <<pussy>>에 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 문지른다.
			<<sex 5 "genitals">><<set $worn.over_lower.integrity -= 10>>
		<<elseif $worn.lower.vagina_exposed is 0>>
			<<bHe>>【이가】 $worn.lower.name 위로 당신의 <<pussy>>에 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 문지른다.
			<<sex 5 "genitals">><<set $worn.lower.integrity -= 10>>
		<<elseif $worn.lower.vagina_exposed is 1>>
			<<rng>>
			<<if $worn.under_lower.vagina_exposed is 1 and playerChastity("vagina")>>
				<<if $NPCList[_n].penissize gte 5>>
					<<bHe>>【이가】 그 아래에 있는 <<pussy>>에 <<if $settings.pregnancySpeechEnabled>>씨를 뿌리기<<else>>박기<</if>> 위해 필사적으로 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 당신의 $worn.genitals.name에 찔러넣는다. <<bHe>>【은는】 고통에 <<beast_growls_text>>, <span class="pink">하지만 밀어붙일 때마다 기구가 점점 더 느슨해지는 것이 느껴진다.</span>
					<<sex 10 "genitals">><<set $worn.genitals.integrity -= 240>><<set $enemyanger += 15>><<set $enemytrust -= 15>><<set $enemyhealth -= 5>>
				<<else>>
					<<bHe>>【이가】 그 아래에 있는 <<pussy>>에 <<if $settings.pregnancySpeechEnabled>>씨를 뿌리기<<else>>박기<</if>> 위해 필사적으로 당신의 $worn.genitals.name에 찔러넣는다. <<bHe>>【은는】 단단한 재질에 부딪혀 고통스러워하며 뒤로 물러나고, <<beast_growling_text>>.
					<<set $NPCList[_n].penis to 0>><<set $vaginause to 0>><<set $vaginastate to 0>><<sex 20 "genitals">><<set $worn.genitals.integrity -= 40>><<set $enemyanger += 15>><<set $enemytrust -= 15>><<set $enemyhealth -= 5>>
				<</if>>
			<<elseif $worn.under_lower.vagina_exposed is 0>>
				<<if $NPCList[_n].penissize gte 5>>
					<<bHe>>【이가】 당신의 $worn.under_lower.name 위로 당신의 <<pussy>>에 <<bhis>> <<= window.KR.getPenisDescKr($NPCList[_n].penisdesc)>>【을를】 찔러넣으며, <span class="purple">천을 찢어버린다.</span>
