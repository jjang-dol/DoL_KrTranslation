			<</if>>
		<</if>>
	<</if>>
<</widget>>

<!-- Ideally, the parameters here should be replaced when the way the Great Hawk is generated changes. -->
<<widget "hawkText">><<silently>>
	<<if ($settings.monsterChance gte $rng and $hallucinations gte 1) or ($settings.monsterChance gte $rng and !$settings.monsterHallucinationsOnly) or ($greathawkmonster is 2) or (!$settings.bestialityEnabled)>>
		<<set _text_output to "하피">>
	<<else>>
		<<set _text_output to "매">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "checkforloveinterests">>
	<<set _loveInterest to Object.values($loveInterest).filter(li => li isnot "None").random()>>
<</widget>>

<<widget "askrough">>
	<<if $speech_attitude is "meek">>
		당신은 더 거칠게 다뤄달라고 <<voice "plead">>.
		<<switch $speechcycle>>
			<<case 0>> "더 세게 때려요. 난 맞아야 해요."
			<<case 1>> "나를 때려. 당신의 <<bitch>>【으로로】 만들어줘."
			<<case 2>> "내 분수를 가르쳐주세요."
			<<case 3>> "날 쓰레기처럼 다뤄."
			<<case 4>> "내가 꽥꽥대게 만들어줘."
			<<case 5>> "날 엉망으로 만들어."
			<<default>> "날 쓸모없는 돼지 취급해줘."
		<</switch>>
	<<elseif $speech_attitude is "bratty">>
		당신은 더 거칠게 다뤄달라고 <<voice "demand">>.
		<<switch $speechcycle>>
			<<case 0>> "더 세게 치라고, 겁쟁이 새끼야."
			<<case 1>> "그게 다야?"
			<<case 2>> "가장 세게 때려봐."
			<<case 3>> "어디 한번 날 망가뜨려 봐."
			<<case 4>> "이게 최선이야?"
			<<case 5>> "때려보라고. 아니면 기운이 빠졌어?"
			<<default>> "더 세게 때려, 안 그럼 내가 널 팰 거니까."
		<</switch>>
	<<else>>
		당신은 더 거칠게 다뤄달라고 <<voice "moan">>.
		<<switch $speechcycle>>
			<<case 0>> "더 거칠게 해도 돼. 견딜 수 있으니까."
			<<case 1>> "더 세게 때려줘."
			<<case 2>> "날 쓰레기처럼 대해줘."
			<<case 3>> "네가 얼마나 센지 보여줘."
			<<case 4>> "내가 쓸모없는 것처럼 느끼게 해 줘."
			<<case 5>> "더 세게!"
			<<default>> "때려줘. 끄떡없으니까."
		<</switch>>
	<</if>>
<</widget>>

<<widget "actionsmoan">>
	<<checkforloveinterests>>
	당신은 <<voice "moan">>.
	<<if $npc.includes(_loveInterest) and random(0,100) lte 45>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<if C.npc.Robin.dom gte 70>>
					<<set $speechspecialdialogue to "robin_moan_dom">>
					"넌 날 어떻게 흥분시키는지 아는구나."
				<<else>>
					<<set $speechspecialdialogue to "robin_moan_default">>
					"녹아버릴 것 같아, 네가 날 너무 행복하게 만들어."
