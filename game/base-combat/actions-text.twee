			<</if>>
		<<else>>
			당신은 조심스럽게 <<someones $_target>> 자지를 문지른다.
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsStroke">>
	<<if _args.length lte 0>>
		<<error {
			message	: "Missing parameters for <<actionsStroke>> ",
			source	: "Called from: " + Utils.GetStack()
		}>>
	<</if>>
	<<if $enemytype is "beast">>
		당신은 <<beasttype>>의 머리를 쓰다듬는다.
	<<else>>
		당신은
		<<if _args.length is 2 and _args[0] isnot _args[1]>>
			<<personselect _args[0]>><<persons>>【와과】 <<personselect _args[1]>><<persons>>
		<<elseif $enemyno lte 1>>
			<<personselect _args[0]>><<his>>
		<<else>>
			<<personselect _args[0]>><<persons>>
		<</if>>
		피부를 ?stroke.
	<</if>>
<</widget>>

<<widget "actionshit">>
	<<if _args[0] is "both">>
		<<set _hand to "양 손">>
		<<set $_target to $lefttarget>>
	<<else>>
		<<set _hand to "손">>
		<<if _args[0] isnot undefined>>
			<<set $_target to _args[0]>>
		<<else>>
			<<set $_target to 0>>
		<</if>>
	<</if>>
	<<if $enemytype is "beast">>
		<<if $pain lte 20>>
			당신은 _hand【을를】 휘둘러 <<beasttype>>【을를】 때린다.
		<<elseif $pain lte 60>>
			당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<beasttype>>【을를】 때린다.
		<<else>>
			고통과 공포에 질려, 당신은 <<beasttype>>에게 마구 팔을 휘두른다.
		<</if>>
	<<else>>
		<<if $pain lte 20>>
			당신은 _hand【을를】 휘둘러 <<someone $_target>>【을를】 때린다.
		<<elseif $pain lte 60>>
			당신은 고통을 이겨내고 _hand【을를】 휘둘러 <<someone $_target>>【을를】 때린다.
		<<else>>
			고통과 공포에 질려, 당신은 자기방어를 위해 마구 팔을 휘두른다.
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsclitstroke">>
	<<if $consensual is 1>>
		<<if $arousal lt ($arousalmax / 5) * 3>>
			당신은 손가락으로 <<their _args[0]>> 클리토리스를 <<handtext>> 쓰다듬는다.
		<<else>>
			흥분해서, 당신은 손가락으로 <<their _args[0]>> 클리토리스를 <<handtext>> 애무한다.
		<</if>>
	<<else>>
		달래 보려는 듯, 당신은 손가락으로 <<their _args[0]>> 클리토리스를 <<handtext>> 쓰다듬는다.
	<</if>>
<</widget>>

<<widget "actionshandedge">>
	<<if $arousal gte ($arousalmax / 5) * 4>>
		<<print either(
			"가만히 있기는 힘들지만, 당신은 <<handtext>>",
			"떨리는 손으로, 당신은 <<handtext>>",
			"당신이 <<handtext>> 움직이자 손이 경련한다"
		)>>
	<<elseif $arousal gte ($arousalmax / 5) * 2>>
		<<print either(
			"당신이 <<handtext>> 움직이자 따뜻함이 팔 위로 퍼진다",
			"달아오르는 열기에도 불구하고, 당신은 <<handtext>>",
			"당신은 손을 안정시키고 <<handtext>>"
		)>>
	<<else>>
		당신은 <<handtext>>
	<</if>>

	<<if _args[1].includes("penis")>>
		<<print either(
			"손가락으로 <<his>> 기둥을 꼬집는다,",
			"<<his>> 사타구니 주위를 손가락으로 훑는다,",
			"<<his>> 자지 끝을 엄지손가락으로 문지른다,"
		)>>
	<<else>>
		<<print either(
			"손가락으로 <<his>> 입술을 누른다,",
			"<<his>> 음순 주위를 손가락으로 훑는다,",
			"<<his>> 클리토리스에 손바닥을 부드럽게 댄다,"
		)>>
	<</if>>

	<<if $enemyarousal gte ($enemyarousalmax / 5) * 4>>
		<<print either(
			"<<him>>【을를】 절정 직전에 붙잡아 둔다.",
			"<<his>> 손이 닿지 않는 곳에서 해방감을 흔들어 보인다.",
			"<<his>> 갈망하는 몸을 고문한다."
		)>>
	<<elseif $enemyarousal gte ($enemyarousalmax / 5) * 2>>
		<<print either(
			"천천히 <<him>>【을를】 절정으로 이끈다.",
			"<<his>> 흥분이 부풀어 오르게 둔다.",
			"<<him>>【을를】 애타게 만든다."
		)>>
	<<else>>
		<<print either(
			"<<his>> 흥분을 조절한다.",
			"<<his>> 흥분을 억제한다.",
			"쾌락을 휘젓는다."
		)>>
	<</if>>
<</widget>>

<<widget "actionskick">>
	<<if $enemytype is "beast">>
		<<if $pain lte 20>>
			당신은 <<beasttype>>【을를】 걷어찬다.
		<<elseif $pain lte 60>>
			당신은 <<beasttype>>【을를】 걷어차서 떼어내려 한다.
		<<else>>
			당신은 필사적으로 <<beasttype>>【을를】 걷어차서 떼어내려 한다.
		<</if>>
	<<else>>
		<<if $leftarm is "grappled" or $rightarm is "grappled">>
			당신은 공격자의 손아귀에 저항하며, 정강이를 걷어차면서 몸을 비틀어 빠져나오려 한다.
		<<else>>
			<<if $pain lte 20>>
				반항적으로, 당신은 발로 후려친다.
			<<elseif $pain lte 60>>
				다쳤지만, 당신은 발로 후려친다.
			<<else>>
				당신은 절박하게 후려친다.
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsfeetrub">>
	<<if $enemytype is "beast">>
		당신은 발가락으로 <<their>> 자지를 애무한다.
	<<else>>
		<<if _args[0] isnot undefined>>
			<<set $_target to _args[0]>>
		<<else>>
			<<set $_target to 0>>
		<</if>>
		<<if $consensual is 1>>
			<<if $arousal lt ($arousalmax / 5) * 3>>
				당신은 발가락으로 <<someones $_target>> 자지를 애무한다.
			<<else>>
				당신은 발가락으로 <<someones $_target>> 자지를 열심히 쓰다듬는다.
			<</if>>
		<<else>>
			당신은 발가락으로 <<someones $_target>> 자지를 쓰다듬는다.
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsgrabrub">>
	<<if $enemytype is "beast">>
		<<if $enemyarousal gte ($enemyarousalmax / 5) * 4>>
			<<he>>【이가】 맹렬하게 허리를 놀리는 동안, 당신은 발 사이에 <<his>> 자지를 잡고 <<feettext>> 움직인다.
		<<elseif $enemyarousal gte ($enemyarousalmax / 5) * 2>>
			<<he>>【이가】 허리를 놀리는 동안, 당신은 발 사이에 자지를 잡고 <<feettext>> 움직인다.
		<<else>>
			당신은 발 사이에 자지를 잡고 <<feettext>> 비빈다.
		<</if>>
	<<else>>
		<<if $consensual is 1>>
			<<if $arousal lt ($arousalmax / 5) * 3>>
				당신은 <<their _args[0]>> 자지를 발 사이에 단단히 잡고, 발가락으로 귀두를 <<feettext>> 쓰다듬고 애무한다.
			<<else>>
				당신은 발 사이에 <<their _args[0]>> 자지를 잡고 <<feettext>> 비빈다.
			<</if>>
		<<else>>
			당신은 발로 <<their _args[0]>> 자지를 차지하고, 발가락 사이로 귀두를 <<feettext>> 비빈다.
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsfeetpussy">>
	<<if $consensual is 1>>
