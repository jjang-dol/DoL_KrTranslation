		<</if>>
	<</if>>
<</widget>>

<<widget "actionsgrowl">>
	<<if $enemytype is "beast">>
		당신은 <<beasttype>>에게 으르렁거리며 송곳니를 드러낸다.
	<<else>>
		당신은 으르렁거리며 송곳니를 드러낸다.
	<</if>>
<</widget>>

/* Special widget for Angel TF's unique "Forgive" action */
<<widget "actionsforgive">>
	<<checkforloveinterests>>
	<<if $enemytype is "beast">>
		"넌 아무것도 모르잖아. <<beasttype>>【이】니까." 당신이 말한다. "널 용서할게."
	<<else>>
		<<if _loveInterest isnot undefined>> 
			/* Removing RNG since it's straightforward. Might add `and random(0, 100) lte 15` back if the situation calls for it */
			<<set $speechnamedrop to $npc.includes(_loveInterest) ? 0 : 1>>
			<<rng>>
			<<switch _loveInterest>>
				<<case "Avery">>
					<<if $npc.includes("Avery")>>
						<<if $avery_fate is undefined>>
							"그저 화가 났을 뿐이잖아요." 당신이 말한다. "누구나 가끔 화를 내요. 용서할게요."
						<<else>>
							"이제 왜 그렇게 화를 내는지 알겠어요, 에이버리." 당신이 말한다. "그리고 당신을 용서할게요."
						<</if>>
					<</if>>
				<<default>>
					"이런 끔찍한 짓을 저지르고 있지만, 걱정하지 마." 당신이 말한다. "널 용서할게."
			<</switch>>
		<<else>>
			"이런 끔찍한 짓을 저지르고 있지만, 걱정하지 마." 당신이 말한다. "널 용서할게."
		<</if>>
	<</if>>
<</widget>>

<<widget "actionsplead">>
	<<checkforloveinterests>>
	<<if $robinRentEvent is 1 and ["Robin","pay","still"].includes($combatPhase)>>
		당신은 <<voice "plead">>.
		<<switch random(1,5)>>
			<<case 1>>
				"로빈은 안 돼! 그만둬!"
			<<case 2>>
				"로빈은 놔줘, 제발!"
			<<case 3>>
