				<<if $arousal lt $arousalmax / 5>>
					"빼, 빼라고!"
				<<elseif $arousal lt ($arousalmax / 5) * 4>>
					"제발, ㅎ-하라는 대로 다 할 테니까, 그냥 빼줘!"
				<<else>>
					"ㄴ-내 맘대로... ㅇ-안 돼. ㅈ-제발 그만해."
				<</if>>
			<<elseif $anusstate is "penetrated">>
				<<if $arousal lt $arousalmax / 5>>
					"빼, 빼라고!"
				<<elseif $arousal lt ($arousalmax / 5) * 4>>
