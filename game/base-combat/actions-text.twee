			<<set $_target to 0>>
		<</if>>
		<<if $consensual is 1>>
			<<if $arousal lt ($arousalmax / 5) * 3>>
				당신은 <<someones $_target>> 피부에 입술을 가볍게 스친다.
			<<else>>
				당신은 <<someones $_target>> 피부에 혀부터 대고 키스한다.
			<</if>>
		<<else>>
