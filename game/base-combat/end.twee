:: Widgets End Combat [widget]

<<widget "endcombat">>

	<<if $enemyhealth lte 0>>
		<<if $enemytype is "man">>
			<<famescrap $enemynomax>>
		<</if>>
		<<if $audiencepresent is 1>>
			<<famescrap 10>>
		<</if>>
	<</if>>

	<<if $demonabsorb gte 1 and !$stalk>>
		<<if $enemytype is "tentacles" or $enemytype is "struggle">>
			<<pain `-(5 * $demonabsorb)`>>
			<<set $stress -= (300 * $demonabsorb)>>
		<<else>>
			<<set $trauma -= (150 * $demonabsorb)>>
		<</if>>
		<span class="lewd">성적인 정수를 흡수했다. 마음이 진정된다.</span>
		<<set $demonabsorb to 0>>
		<<traumaClamp>>
		<<set _br to true>>
		<br>
	<</if>>

	/* Unbind any leg shackles applied during consensual sex via <<shackle_legs>>. Last check avoids removing a shackle that was destroyed before end of combat */
	<<if $legsShackledDuringCombat and $consensual is 1 and ($worn.feet.type.includes("shackle") and $worn.feet.name isnot "vines")>>
		철컥하는 열쇠 소리와 함께 당신의 $worn.feet.name【이가】 풀린다.
		<<remove_shackle>>
		<<set _br to true>>
		<br>
	<</if>>

	/* Check if combat is active before collecting samples to avoid collecting samples when endcombat is called while combat is not active */
	<<if $combat is 1>>
		<<if ($enemyarousal gte $enemyarousalmax || $enemyejaculated gte 1) and canCollectSamples() and !($enemytype is "plant" and $abomination is 1) and !$beastRitual>>
			<<set $_samplesCollected to 0>>
			<<set $_sampleMod to $location is "forest_shop_garden" and $beastRitual ? 2 : 1>>
			<<for $_sample to 0; $_sample lt $enemyno; $_sample++>>
				<<if canCollectSampleSingle(V.NPCList[$_sample]?.type)>>
					<<if canCollectSamples() is "bound">>
						/* Ensures the bound message only shows if the player could have collected samples otherwise */
						<<set $_samplesCollected to "bound">>
						<<break>>
					<<else>>
						<<set $_samplesToCollect to collectSample(V.NPCList[$_sample]?.type, $_sampleMod)>>
						<<if $_samplesToCollect>>
							<<set $_samplesCollected += $_samplesToCollect>>
						<</if>>
					<</if>>
				<</if>>
			<</for>>
			<<if $_samplesCollected is "bound">>
				<span class="red">팔이 묶여 있어 체액 샘플을 채집할 수 없습니다.</span>
				<<set _br to true>>
				<br>
			<<elseif $_samplesCollected>>
				<<if $location is "forest_shop_garden">>
					<span class="green">그윌란이 유리병에 체액을 모으는 것을 도와준다.</span> <<npcincr Gwylan lust 1>><<glust>><br>
				<<else>>
					<span class="lewd"><<if isGwylanAbsent() is "nobody">>아무도 주지 않은<<else>>그윌란이 준<</if>> 유리병에 체액을 가능한 한 많이 채집한다.</span>
				<</if>>
				<span class="gold"><<number $_samplesCollected>></span>개의 체액 샘플을 획득했습니다.
				<<set _br to true>>
				<br>
			<</if>>
		<<elseif ($enemytype is "plant" and $abomination is 1 or $enemytype is "tentacles" and ["vine","root","shoot"].includes($tentacles[0]?.type)) and canCollectSamples() and canCollectSampleSingle("plant") and !$beastRitual>>
			<<if canCollectSamples() is "bound">>
				<span class="red">팔이 묶여 있어 넥타르 샘플을 채집할 수 없습니다.</span>
			<<else>>
				<<set $_sampleMod to $location is "forest_shop_garden" and $beastRitual ? 1.3 : 1>>
				<<set $_fromTentacles to $combat_tentacle_record.fluid || 1>>
				<<set $_nectarCollected to Math.ceil((1 + $_fromTentacles / 9) * $_sampleMod)>>
				<<set $_samplesToCollect to collectSample("plant", $_nectarCollected)>>
				<<if $location is "forest_shop_garden">>
					<span class="green">그윌란이 유리병에 넥타르를 모으는 것을 도와준다.</span> <<npcincr Gwylan lust 1>><<glust>><br>
				<<else>>
					<span class="lewd">그윌란이 준 유리병에 넥타르를 가능한 한 많이 채집한다.</span>
				<</if>>
				<span class="gold"><<number $_nectarCollected>></span>개의 넥타르 샘플을 획득했습니다.
			<</if>>
			<<set _br to true>>
			<br>
		<</if>>
	<</if>>

	<<if $transformationParts.traits.mateForLife isnot "disabled" and $sexavoid is 0>>
		<<if $enemyno is 1 and isLoveInterest($npc[$npcrow.indexOf(0)])>>
			<<if $fox gte 3>>
				<<transform fox 1>>
			<</if>>
			<<stress -10>><<trauma -5>>
			<span class="lewd">선택한 짝과의 교미는 본능적인 욕구를 충족시킵니다.</span><<llstress>><<ltrauma>>
			<<set _br to true>>
			<br>
		<</if>>
	<</if>>

	<<if $assertive gte 1>>
		당신은
		<<if $assertive lte 5>>
			<span class="pink">약간</span>
		<<elseif $assertive lte 10>>
			<span class="pink">조금</span>
		<<elseif $assertive lte 30>>
			<span class="purple">꽤</span>
		<<elseif $assertive lte 40>>
			<span class="blue">제법</span>
		<<elseif $assertive lte 50>>
			<span class="lblue">상당히</span>
		<<elseif $assertive lte 60>>
			<span class="teal">매우</span>
		<<else>>
			<span class="green">아주</span>
		<</if>>
		적극적이었다.

		<<if $assertiveaction isnot 0 and $assertiveaction isnot undefined>>
			<<if $assertiveaction is "trauma">>
				<<set $trauma -= $assertive>>
				<span class="meek">나는 정말 음탕해.</span>
				<<ltrauma>>
				<<traumaClamp>>
				<br>
			<<elseif $assertiveaction is "stress">>
				<<set $stress -= ($assertive * 10)>>
				<span class="green">재밌었어.</span>
				<<lstress>>
				<br>
			<<elseif $assertiveaction is "submissive">>
				<<sub `($assertive / 40)`>>
				<<if $enemytype is "beast">>
					<<set _plural_beast_type to window.KR.getBeastTypeKr($NPCList[0].type) + "들">>
					<span class="meek">_plural_beast_type【을를】 기분 좋게 해주는 건 즐겁다.</span>
				<<elseif $enemytype is "tentacles">>
					<span class="meek">촉수들을 기분 좋게 해주는 건 즐겁다.</span>
				<<elseif $enemytype is "struggle">>
					<span class="meek">생물들을 기분 좋게 해주는 건 즐겁다.</span>
				<<else>>
					<span class="meek">사람들을 기분 좋게 해주는 건 즐겁다.</span>
				<</if>>
				<br>
			<<elseif $assertiveaction is "defiant">>
				<<def `($assertive / 40)`>>
				<span class="brat">주도권을 쥐는 건 즐겁다.</span>
				<br>
			<</if>>
			<<set $assertive to 0>>
			<<set _br to true>>
		<</if>>

	<</if>>

	<<if $stalk_end is "escaped" or $stalk_end is "hide" or $stalk_end is "ambush">>
		<<if $transformationParts.traits.chase isnot "disabled">>
			심장이 마구 뛴다.
			<span class="green">추격전의 스릴이 당신에게 활기를 불어넣는다.</span>
			<<if $stalk_taunted is "success">>
				<span class="green">당신의 대담한 도발 덕분에 더욱 그렇다.</span> <<transform fox 1>><<promiscuity2>>
			<<else>>
				<<lstress>><<garousal>>
				<br>
				<<set _br to true>>
			<</if>>
			<<stress -8>><<arousal 200>><<transform fox 1>>
		<<elseif $stalk_taunted is "success">>
			심장이 마구 뛴다. <span class="green">대담한 도발 후의 탈출이 당신에게 활기를 불어넣는다.</span> <<transform fox 1>><<promiscuity2>>
		<</if>>
	<</if>>

	<<unset $enemytype>>
	<<updatePlayerTraumaState>>

	<<endevent _args[0]>>
	<<struggle_end>>

	<<set $enemytrust to 0>>
	<<set $combat to 0>>
	<<set $rapeavoid to 1>>
	<<set $sexavoid to 1>>
	<<set $orgasmdown to 0>>
	<<set $penisbitten to 0>>
	<<set $mouthsubmit to 0>>
	<<set $breastbitten to 0>>
	<<set $apologised to 0>>
	<<unset $removed>>
	<<unset $bodywriting_special>>
	<<unset $machine_tattoo_success>>
	<<unset $dodging>>
	<<unset $feet_planted>>
	<<unset $left_guard>>
	<<unset $right_guard>>
	<<unset $speechspraycycleplant>>
	<<unset $newlyWritten>>
	<<unset $combatBegun>>
	<<unset $combatPhase>>
	<<unset $fightTargets>>
	<<unset $pounce_delay>>
	<<unset $hypnosis_deviancy_check>>
	<<unset $animOverride>>
	<<unset $encounterDialogue>>

	<<if $player.penisExist>>
		<<set $penisstate to 0>>
		<<set $penisuse to 0>>
	<<else>>
		<<set $penisstate to "none">>
		<<set $penisuse to "none">>
	<</if>>
	<<if $player.vaginaExist>>
		<<set $vaginastate to 0>>
		<<set $vaginause to 0>>
	<<else>>
		<<set $vaginastate to "none">>
		<<set $vaginause to "none">>
	<</if>>
	<<if playerHasStrapon()>>
		<<set $penisstate to 0>>
		<<set $penisuse to 0>>
		/*<<if $playerPenisSizeBackup isnot undefined>>
			<<set $player.penissize to $playerPenisSizeBackup>>
		<</if>>*/
	<</if>>

	<<set $anusstate to 0>>
	<<set $mouthstate to 0>>
	<<set $finish to 0>>
	<<unset $stalk_end>>
	<<unset $stalk_taunted>>
	<<unset $stalk_event>>
	<<unset $stalk_clothes>>
	<<unset $stalk>>
	<<unset $stalk_assess>>
	<<unset $audience_active>>
	<<unset $combat_end_text>>
	<<set $gloryhole to 0>>
	<<set $mouthuse to 0>>
	<<set $anususe to 0>>
	<<set $thighuse to 0>>
	<<set $bottomuse to 0>>
	<<if $feetuse isnot "bound">>
		<<set $feetuse to 0>>
	<</if>>
	<<if $leftarm isnot "bound">>
		<<set $leftarm to 0>>
	<</if>>
	<<if $rightarm isnot "bound">>
		<<set $rightarm to 0>>
	<</if>>
	<<set $chestuse to 0>>
	<<set $cheststate to 0>>
	<<if $head isnot "bound">>
		<<set $head to 0>>
	<</if>>
	<<set $face to 0>>
	<<if $position is "wall">>
		<<set $leftarm to 0>>
		<<set $rightarm to 0>>
		<<set $head to 0>>
	<</if>>
	<<unset $neckuse>>
	<<if $legsShackledDuringCombat>>
		<<unset $legsShackledDuringCombat>>
	<</if>>
	<<set $position to 0>>
	<<set $walltype to "wall">>
	<<set $underlowerstruggle to 0>>
	<<set $lowerstruggle to 0>>
	<<set $upperstruggle to 0>>
	<<set $overlowerstruggle to 0>>
	<<set $overupperstruggle to 0>>
	<<set $alarm to 0>>
	<<set $rescue to 0>>
	<<set $noise to 0>>
	<<set $timer to 0>>
	<<set $beastname to "none">>
	<<set $panicparalysis to 0>>
	<<set $panicviolence to 0>>
	<<unset $panicviolenceRecent>>
	<<set $pullaway to 0>>
	<<set $novaginal to 0>>
	<<set $noanal to 0>>
	<<set $nopenile to 0>>
	<<set $nochoke to 0>>
	<<unset $pullOut>>
	<<unset $pullOutAsk>>
	<<set $player.condom to false>>
	<<unset $otherFilled>>
	<<unset $noupper>>
	<<unset $noupperasked>>
	<<unset $nomask>>
	<<unset $nomaskasked>>
	<<set $askedtochoke to 0>>
	<<unset $speechwheeze>>
	<<unset $speechwheezelewd>>
	<<unset $speechwheezeaskchokerough>>
	<<unset $speechwheezeaction>>
	<<set $speechorgasmweakcumcount to 0>>
	<<set $speechorgasmnocumcount to 0>>
	<<set $speechorgasmcount to 0>>
	<<set $speechorgasmrepeat to 0>>
	<<set $underwatertime to 0>>
	<<if $underwater isnot 1>>
		<<if !$oxygenRecovery>>
			<<oxygenrefresh>>
		<</if>>
		<<set $suffocating to 0>>
	<</if>>
	<<set $angelforgive to 0>>
	<<unset $banishDisable>>
	<<unset $penisfucked>>
	<<unset $vaginafucked>>
	<<unset $anusfucked>>
	<<set $speechdisable to 0>>
	<<unset $stealstateleft>>
	<<unset $stealstateright>>
	<<unset $position_lock>>
	<<unset $handGuideLeft>>
	<<unset $handGuideRight>>
	<<unset $easySteal>>
