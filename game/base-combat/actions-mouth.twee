:: Widgets Actions Mouth FlavorText [widget]
<<widget "breastFlavorText">>
	<<set _j to ($NPCList.findIndex(x => x.chest is "mouthentrance"))>>
	<<if _j gte 0>>
		<<personselect _j>>
		당신은 머리가
		<<if $enemyno gte 2>>
			상대의 <<persons>>
		<<else>>
			<<his>>
		<</if>>
		<<= window.KR.getBreastSizeKr($NPCList[_j].breastsdesc)>><<print ($NPCList[_j].breastsize gte 6?" 사이에":"에")>> 짓눌리는 것을 느낀다.
	<<elseif $debug or $options.debugdisable is "f">>
		Errors.report("breastFlavorText가 올바른 인덱스를 찾지 못해 무시합니다")
	<</if>>
<</widget>>

<<widget "nippleFlavorText">>
	<<set _j to ($NPCList.findIndex(x => x.chest is "mouth"))>>
	<<if _j gte 0>>
		<<personselect _j>>
		당신은 머리가
		<<if $enemyno gte 2>>
			상대의 <<persons>>
		<<else>>
			<<his>>
		<</if>>
		<<if $NPCList[_j].lactation is 1 and $settings.breastFeedingEnabled>>
			젖이 새는
		<</if>>
		<<= window.KR.getBreastSizeKr($NPCList[_j].breastdesc)>>에 짓눌려 있는 것을 느낀다.
	<<elseif $debug or $options.debugdisable is "f">>
		Errors.report("nippleFlavorText가 올바른 인덱스를 찾지 못해 무시합니다")
	<</if>>
<</widget>>

<<widget "facesitFlavorText">>
	<<if $enemyno lt 2>>
		<<personselect $mouthtarget>>
		<<if $npc.length isnot 0 and $NPCList[0].name_known is 1>>
			<<print window.KR.gatPersonNameDictKR($npc[0])>>【이가】 
		<<else>>
			<<He>>【이가】 
		<</if>>
	<<else>>
		<<if $mouthstate is "anal">>
			<<selectNpcWithPartInPosition "vagina" "facesitanal">>
		<<else>>
			<<selectNpcWithPartInPosition "vagina" "facesit">>
		<</if>>
		<<if $npcrow.includes(_j)>>
			<<print window.KR.gatPersonNameDictKR($npc[$npcrow.indexOf(_j)])>>【이가】 
		<<else>>
			<<person>>【이가】 
		<</if>>
	<</if>>
	<<if $mouthstate is "anal">>
		당신의 입 위에 앉는다.
	<<else>>
		당신의 얼굴 위에 앉는다.
	<</if>>
<</widget>>

:: Widgets Actions Mouth [widget]

<<widget "oral">>
	<<if $combattype is "train">>
		<<set _end to $enemyno-1>>
	<<else>>
		<<set _end to 0>>
	<</if>>

	<<set _xx to $enemyno-1>>
	<<if _xx is -1>>
		<<set _stanceCheck to 0>>
	<<else>>
		<<set _stanceCheck to $NPCList[_xx].stance>>
	<</if>>

	<<if $consensual is 1 and !hasSexStat("promiscuity", 4) and $enemytype is "man" or $consensual is 1 and !hasSexStat("deviancy", 4) and $enemytype isnot "man">>
		<!-- Do Nothing -->
	<<elseif _stanceCheck is "top">>
		<!-- Do Nothing -->
	<<else>>
		<<for _j = $enemyno-1; _j gte _end; _j-->>
			<<if $NPCList[_j].penis is 0>>
				<<if $mouthactiondefault is "mouth">>
					| <label><span class="sub"><<his>> 자지에 입술을 가져간다</span> <<radiobutton "$mouthaction" "mouth" checked>><<oraldifficulty>> <<combatpromiscuous4>></label>
				<<else>>
					| <label><span class="sub"><<his>> 자지에 입술을 가져간다</span> <<radiobutton "$mouthaction" "mouth">><<oraldifficulty>> <<combatpromiscuous4>></label>
				<</if>>
				<<break>>
			<</if>>
		<</for>>
		<<for _j = $enemyno-1; _j gte _end; _j-->>
			<<if $NPCList[_j].vagina is 0>>
				<<if $mouthactiondefault is "othervagina">>
					| <label><span class="sub"><<his>> 보지에 입을 가져간다</span><<radiobutton "$mouthaction" "othervagina" checked>><<oraldifficulty>> <<combatpromiscuous4>></label>
				<<else>>
					| <label><span class="sub"><<his>> 보지에 입을 가져간다</span><<radiobutton "$mouthaction" "othervagina">><<oraldifficulty>> <<combatpromiscuous4>></label>
				<</if>>
				<<break>>
			<</if>>
		<</for>>
	<</if>>

	<<if $consensual is 1 and !hasSexStat("promiscuity", 3)>>
		<!-- Do Nothing -->
	<<elseif !$gloryhole>>
		<<for _j = $enemyno-1; _j gte _end; _j-->>
			<<if $NPCList[_j].chest is 0>>
				<<if $mouthactiondefault is "movetochest">>
					| <label><span class="sub"><<his>> 가슴에 입술을 가져간다</span> <<radiobutton "$mouthaction" "movetochest" checked>><<oraldifficulty>> <<combatpromiscuous3>></label>
				<<else>>
					| <label><span class="sub"><<his>> 가슴에 입술을 가져간다</span> <<radiobutton "$mouthaction" "movetochest">><<oraldifficulty>> <<combatpromiscuous3>></label>
				<</if>>
				<<break>>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

<<widget "oralnew">>
	<<set _stanceCheck to $NPCList[$mouthtarget].stance>>

	<<if $consensual is 1 and (!hasSexStat("promiscuity", 4) and $enemytype is "man" or !hasSexStat("deviancy", 4) and $enemytype isnot "man") and !$promiscuityIgnore>>
		<!-- Do Nothing -->
	<<elseif _stanceCheck is "top">>
		<!-- Do Nothing -->
	<<else>>
		<<if $NPCList[$mouthtarget].penis is 0 and ($enemytype isnot "man" or ($NPCList[$mouthtarget].location.genitals is 0 and $NPCList[$mouthtarget].location.head isnot "head")) and !$worn.face.type.includes("face_covering") and !$worn.face.type.includes("gag")>>
			<<if $NPCList[$mouthtarget].chastity.penis.includes("chastity")>>
				<<set _mouthaction["상대의 " + $NPCList[$mouthtarget].chastity.penis + "에 머리를 가져간다"] to "mouth">>
			<<elseif npcHasStrapon($mouthtarget)>>
				<<set _mouthaction["상대의 페니스 밴드에 입술을 가져간다"] to "mouth">>
			<<else>>
				<<set _mouthaction["상대의 자지에 입술을 가져간다"] to "mouth">>
			<</if>>
		<</if>>
		<<if $NPCList[$mouthtarget].vagina is 0 and ($enemytype isnot "man" or ($NPCList[$mouthtarget].location.genitals is 0 and $NPCList[$mouthtarget].location.head isnot "head")) and !$worn.face.type.includes("face_covering") and !$worn.face.type.includes("gag")>>
			<<if $NPCList[$mouthtarget].chastity.vagina.includes("chastity")>>
				<<set _mouthaction["상대의 " + $NPCList[$mouthtarget].chastity.vagina + "에 머리를 가져간다"] to "othervagina">>
			<<else>>
				<<set _mouthaction["상대의 보지에 입을 가져간다"] to "othervagina">>
			<</if>>
		<</if>>
	<</if>>

	<<if $consensual is 1 and (!hasSexStat("promiscuity", 3) and $enemytype is "man" or !hasSexStat("deviancy", 3) and $enemytype isnot "man") and !$promiscuityIgnore>>
		<!-- Do Nothing -->
	<<elseif _stanceCheck is "topface">>
		<!-- Do Nothing -->
	<<elseif !$gloryhole>>
		<<if $NPCList[$mouthtarget].chest is 0 and $NPCList[$mouthtarget].location.genitals isnot "head" and $NPCList[$mouthtarget].location.head isnot "head" and $NPCList[$mouthtarget].location.head isnot "genitals" and !$worn.face.type.includes("face_covering") and !$worn.face.type.includes("gag")>>
			<<set _mouthaction["상대의 가슴에 입술을 가져간다"] to "movetochest">>
		<</if>>
	<</if>>
<</widget>>

<<widget "oralswallow">>
	<!-- Below if-or statement is super-clumsy but not sure how to shorten NG -->
	<<if $consensual is 1 and !hasSexStat("promiscuity", 5) and $enemytype is "man" or $consensual is 1 and !hasSexStat("deviancy", 5) and $enemytype isnot "man">>
	<<else>>
		<<if $NPCList[0].penis is "mouthentrance" or $NPCList[0].penis is "mouthimminent" or $NPCList[1].penis is "mouthentrance" or $NPCList[1].penis is "mouthimminent" or $NPCList[2].penis is "mouthentrance" or $NPCList[2].penis is "mouthimminent" or $NPCList[3].penis is "mouthentrance" or $NPCList[3].penis is "mouthimminent" or $NPCList[4].penis is "mouthentrance" or $NPCList[4].penis is "mouthimminent" or $NPCList[5].penis is "mouthentrance" or $NPCList[5].penis is "mouthimminent">>
			<<if $mouthactiondefault is "mouth">>
				| <label><span class="sub"><<his>> 자지를 입에 머금는다</span> <<radiobutton "$mouthaction" "swallow" checked>><<oralvirginitywarning>> <<combatpromiscuous5>></label>
			<<else>>
				| <label><span class="sub"><<his>> 자지를 입에 머금는다</span> <<radiobutton "$mouthaction" "swallow">><<oralvirginitywarning>> <<combatpromiscuous5>></label>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "oralswallownew">>
	<<if $consensual is 1 and (!hasSexStat("promiscuity", 5) and $enemytype is "man" or !hasSexStat("deviancy", 5) and $enemytype isnot "man") and !$promiscuityIgnore>>
	<<else>>
		<<set $_pp to (npcHasStrapon($mouthtarget) ? "페니스 밴드" : "자지")>>
		<<set $_npc to $NPCList[$mouthtarget]>> <<set $_facetype to $worn.face.type>>
		<<if !$_npc.chastity.penis.includes("chastity") and ($_npc.penis is "mouthentrance" or $_npc.penis is "mouthimminent") and !$_facetype.includes("face_covering") and !$_facetype.includes("gag")>>
			<<set _mouthaction["상대의 " + $_pp + "【을를】 입에 머금는다"] to "swallow">>
		<</if>>
	<</if>>
<</widget>>

<<widget "combatPenisEntrance">>
	<<if !$worn.face.type.includes("face_covering") and !$worn.face.type.includes("gag")>>
		<<set _mouthaction["입맞춘다"] to "peniskiss">>
	<</if>>

	<<if $consensual is 1 and (!hasSexStat("promiscuity", 3) and $enemytype is "man" or !hasSexStat("deviancy", 3) and $enemytype isnot "man") and !$promiscuityIgnore>>
	<<elseif $chestuse is 0>>
		<<set _mouthaction["가슴 사이로 붙잡는다"] to "grasp">>
	<</if>>
	<<if $head isnot "grappled" and $head isnot "bound">>
		<<set _mouthaction["물러난다"] to "pullaway">>
	<</if>>
	<<oralswallownew>>
	<<speak>>
<</widget>>

<<widget "combatPenisImminent">>
	<<if !$worn.face.type.includesAny("face_covering", "gag")>>
		<<set _mouthaction["핥는다"] to "lick">>
		<<if ($consensual is 0 or ($enemytype is "man" ? $promiscuity : $deviancy) gte 55 or $promiscuityIgnore) and currentSkillValue("oralskill") gte 800>>
			<<set _mouthaction["절정 직전에 애태운다"] to "oraledge">>
		<</if>>
	<</if>>
	<<set _mouthaction["물러난다"] to "pullaway">>
	<<oralswallownew>>
	<<speak>>
<</widget>>

<<widget "combatPenisPenetrated">>
	<<if $enemyarousal gte $enemyarousalmax and $consensual is 1 and ($enemytype is "man" ? $promiscuity : $deviancy) gte 75>>
		<<set _mouthaction["삼킨다"] to "ejacswallow">>
	<<else>>
		<<set _mouthaction["빤다"] to "suck">>
	<</if>>
	<<if ($consensual is 0 or (($enemytype is "man" ? $promiscuity : $deviancy) gte 55 or $promiscuityIgnore ) and $enemyarousal lt $enemyarousalmax) and currentSkillValue("oralskill") gte 800>>
		<<set _mouthaction["절정 직전에 애태운다"] to "oraledge">>
	<</if>>
	<<if $consensual isnot 1 and ($fightTargets is undefined or $fightTargets.includes($mouthtarget))>>
		<<set _mouthaction["문다"] to "bite">>
	<</if>>
	<<if $head isnot "grappled" and $head isnot "bound">>
		<<if $enemyarousal gte $enemyarousalmax and $consensual is 1>>
			<<set _mouthaction["뱉는다"] to "ejacspit">>
		<<else>>
			<<set _mouthaction["물러난다"] to "pullaway">>
		<</if>>
	<</if>>
<</widget>>

<<widget "combatOthervagina">>
	<<if !$worn.face.type.includesAny("face_covering", "gag")>>
		<<set _mouthaction["핥는다"] to "vaginalick">>
		<<if ($consensual is 0 or ($enemytype is "man" ? $promiscuity : $deviancy) gte 55 or $promiscuityIgnore) and currentSkillValue("oralskill") gte 800>>
			<<set _mouthaction["절정 직전에 애태운다"] to "oraledge">>
		<</if>>
		<<if $consensual isnot 1 and ($fightTargets is undefined or $fightTargets.includes($mouthtarget))>>
			<<set _mouthaction["문다"] to "bitepussy">>
		<</if>>
	<</if>>
	<<if $head isnot "grappled" and $head isnot "bound" and $mouthuse isnot "facesit">>
		<<set _mouthaction["물러난다"] to "pullawayvagina">>
	<</if>>
<</widget>>

<<widget "combatMouthOtherAnus">>
	<<if !$worn.face.type.includes("face_covering") and !$worn.face.type.includes("gag")>>
		<<set _mouthaction["엉덩이를 핥는다"] to "anallick">>
		<<if $submissive gte 1150>>
			<<set _mouthaction["엉덩이에 입맞춘다"] to "analkiss">>
		<</if>>
	<</if>>
	<<if $consensual is 1 and $head isnot "grappled" and $head isnot "bound" and $mouthuse isnot "facesit">>
		<<set _mouthaction["물러난다"] to "analpull">>
	<</if>>
<</widget>>

<<widget "combatBreast">>
	<<if !$worn.face.type.includes("face_covering") and !$worn.face.type.includes("gag")>>
		<<set _mouthaction["빤다"] to "breastsuck">>
		<<set _mouthaction["핥는다"] to "breastlick">>
		<<set _mouthaction["입을 다문다"] to "breastclosed">>
	<</if>>
	<<if $consensual is 1 or $head isnot "breasts">>
		<<set _mouthaction["물러난다"] to "breastpull">>
	<</if>>
<</widget>>

<<widget "combatNipple">>
	<<set _mouthaction["빤다"] to "breastsuck">>
	<<set _mouthaction["입을 다문다"] to "breastclosed">>
	<<if $consensual is 1 or $head isnot "breasts">>
		<<set _mouthaction["물러난다"] to "breastpull">>
	<</if>>
	<<if $consensual isnot 1 and ($fightTargets is undefined or $fightTargets.includes($mouthtarget))>>
		<<set _mouthaction["문다"] to "breastbite">>
	<</if>>
<</widget>>
