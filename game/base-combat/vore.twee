:: Widgets Vore Actions Generation [widget]
<<widget "generateActionsVore">>
	<<set $combat to 1>>
	<<if _targetlist is undefined>>
		<<getTargetList>>
	<</if>>
	<div id="listContainer">
		<div id="leftaction" @class="$options.combatControls + 'Control'">
			<<leftActionInitVore>>
		</div>

		<div id="rightaction" @class="$options.combatControls + 'Control'">
			<<rightActionInitVore>>
		</div>

		<<if ($mouthuse is 0 and !($dissociation lte 1 and $orgasmdown lte 0 and ($pain lt 100 or $willpowerpain is undefined)))>>
			<div id="mouthaction" @class="$options.combatControls + 'Control'">
				<<mouthActionInit>>
			</div>
		<</if>>
	</div>
<</widget>>

<<widget "leftActionInitVore">>
	<<set _vorecreatureKr to window.KR.getCreatureTypeKr($vorecreature)>>
	<<set $lefttarget to "vore">>
	<<switch $leftarm>>
		<<case 0>>
			<<set $lefttarget to "vore">>
			<<if $orgasmdown gte 1>>
				<<set _leftOptions to "orgasm">>
				<span class="lewd">왼팔은 자유롭지만, 경련을 멈출 수 없다.</span>
			<<elseif $pain gte 100 and $willpowerpain is 0>>
				<<set _leftOptions to "pain">>
				<span class="red">왼팔은 자유롭지만, 움직이면 아프다.</span>
			<<elseif $dissociation gte 2>>
				<<set _leftOptions to "unreal">>
				<span class="pink">왼팔은 자유롭지만, 현실감각이 없다.</span>
			<<else>>
				<<if _targetYourself is true and _targetnumber gt 1>>
					<<set _targetlistarms["자신"] to "self">>
				<</if>>
				<<if not $options.combatControls.includes("adio") and _targetnumber gt 1>>
					<<targetListBox "left" _targetlistarms>>
				<</if>>
				<<set _leftOptions to "free">>
				<span @class="($lastOptions.left isnot _leftOptions ?'gold':'')">왼팔은 자유롭다.</span>
				<<if $options.combatControls.includes("adio") and _targetnumber gt 1>>
					<<targetListBox "left" _targetlistarms>>
					<<if $options.combatControls is "radio">><br><</if>>
				<</if>>
			<</if>>
		<<case "bound">>
			<<set _leftOptions to "bound">>
			<<if $orgasmdown gte 1>>
				<span class="lewd">왼팔이 결박에서 벗어나려 꿈틀거린다.</span>
			<<elseif $pain gte 100 and $willpowerpain is 0>>
				<span class="red">왼팔이 고통스럽게 결박되어 있다.</span>
			<<elseif $dissociation gte 2>>
				<span class="pink">왼팔이 결박된 채 축 늘어져 있다.</span>
			<<else>>
				<span @class="($lastOptions.left isnot _leftOptions ?'gold':'')">왼팔이 결박되어 있다.</span>
			<</if>><<if $options.combatControls.includes("adio")>><br><</if>>
		<<case "trapped">>
			<<set _leftOptions to "trapped">>
			<span @class="($lastOptions.left isnot _leftOptions ?'gold':'purple')">왼팔이 _vorecreatureKr에게 갇혀 있다.</span><<if $options.combatControls.includes("adio")>><br><</if>>
		<<case "grappled" "penis" "othervagina" "vagina" "coverpenis" "anus" "behind">>
			<<set $_changetype to true>><<leftActionInit>>
		<<case "struggle">>
			<<set $_changetype to true>><<leftActionInitStruggle>>
		<<case "swarmgrappled">>
			<<set $_changetype to true>><<leftActionInitSwarm>>
		<<case "mechgrappled">>
			<<set $_changetype to true>><<leftActionInitMachine>>
		<<default>>
			<<set $_changetype to true>><<leftActionInitTentacle>>
	<</switch>>
	<<if $_changetype isnot true>>
		<<leftActionsVore>>
		<<if Object.keys(_leftaction).length gt 0>>
			<<if !(Object.values(_leftaction).includes($leftactiondefault))>>
				<<set $leftactiondefault to "rest">>
			<</if>>
			<<set $leftaction to $leftactiondefault>>
			<div class="extraMargin">
				<<generateCombatAction _leftaction "leftaction" "Vore">>
			</div>
			<<if $options.combatControls.includes("ists")>>
				<div id="leftactionDifficulty">
					<<leftactionDifficulty>>
				</div>
			<</if>>
		<</if>>
		<<set $lastOptions.left to clone(_leftOptions)>>
	<</if>>
<</widget>>

<<widget "leftactionDifficultyVore">>/* Blank widget to pacify the JavaScript Gods. */
	<!-- Does nothing -->
<</widget>>

<<widget "leftActionsVore">>
	<<set _vorecreatureKr to window.KR.getCreatureTypeKr($vorecreature)>>
	<<set _leftaction to {}>>
	<<if !(["orgasm", "pain", "unreal"].includes(_leftOptions))>>
		<<set _leftaction["쉰다"] to "rest">>
	<</if>>
	<<switch _leftOptions>>
		<<case "free">>
			<<set _leftaction[_vorecreatureKr + "에게서 탈출한다"] to "leftescape">>
			<<if $vorestage lte 6>>
				<<set _leftaction[_vorecreatureKr + "에 매달린다"] to "lefthold">>
			<</if>>
			<<if $rightarm is "trapped">>
				<<set _leftaction["오른팔을 빼낸다"] to "leftvorefree">>
			<</if>>
		<<case "bound" "trapped">>
		<<case "orgasm">>
			<<set _leftaction["접는다"] to "leftfold">>
			<<set _leftaction["움켜쥔다"] to "leftgrip">>
		<<case "pain">>
			<<set _leftaction["버둥거린다"] to "leftstruggleweak">>
			<<set _leftaction["보호한다"] to "leftprotect">>
		<<case "unreal">>
			<<set _leftaction["자신을 찌른다"] to "leftpoke">>
			<<set _leftaction["팔을 치워둔다"] to "leftcurl">>
	<</switch>>
<</widget>>

<<widget "rightActionInitVore">>
	<<set _vorecreatureKr to window.KR.getCreatureTypeKr($vorecreature)>>
	<<set $righttarget to "vore">>
	<<switch $rightarm>>
		<<case 0>>
			<<if $orgasmdown gte 1>>
				<<set _rightOptions to "orgasm">>
				<span class="lewd">오른팔은 자유롭지만, 경련을 멈출 수 없다.</span>
			<<elseif $pain gte 100 and $willpowerpain is 0>>
				<<set _rightOptions to "pain">>
				<span class="red">오른팔은 자유롭지만, 움직이면 아프다.</span>
			<<elseif $dissociation gte 2>>
				<<set _rightOptions to "unreal">>
				<span class="pink">오른팔은 자유롭지만, 현실감각이 없다.</span>
			<<else>>
				<<if _targetYourself is true and _targetnumber gt 1>>
					<<set _targetlistarms["자신"] to "self">>
				<</if>>
				<<if not $options.combatControls.includes("adio") and _targetnumber gt 1>>
					<<targetListBox "right" _targetlistarms>>
				<</if>>
				<<set _rightOptions to "free">>
				<span @class="($lastOptions.right isnot _rightOptions ?'gold':'')">오른팔은 자유롭다.</span>
				<<if $options.combatControls.includes("adio") and _targetnumber gt 1>>
					<<targetListBox "right" _targetlistarms>>
					<<if $options.combatControls is "radio">><br><</if>>
				<</if>>
			<</if>>
		<<case "bound">>
			<<set _rightOptions to "bound">>
			<<if $orgasmdown gte 1>>
				<span class="lewd">오른팔이 결박에서 벗어나려 꿈틀거린다.</span>
			<<elseif $pain gte 100 and $willpowerpain is 0>>
				<span class="red">오른팔이 고통스럽게 결박되어 있다.</span>
			<<elseif $dissociation gte 2>>
				<span class="pink">오른팔이 결박된 채 축 늘어져 있다.</span>
			<<else>>
				<span @class="($lastOptions.right isnot _rightOptions ?'gold':'')">오른팔이 결박되어 있다.</span>
			<</if>>
		<<case "trapped">>
			<<set _rightOptions to "trapped">>
			<span @class="($lastOptions.right isnot _rightOptions ?'gold':'purple')">오른팔이 _vorecreatureKr에게 갇혀 있다.</span><br>
		<<case "grappled" "penis" "othervagina" "vagina" "coverpenis" "anus" "behind">>
			<<set $_changetype to true>><<rightActionInit>>
		<<case "struggle">>
			<<set $_changetype to true>><<rightActionInitStruggle>>
		<<case "swarmgrappled">>
			<<set $_changetype to true>><<rightActionInitSwarm>>
		<<case "mechgrappled">>
			<<set $_changetype to true>><<rightActionInitMachine>>
		<<default>>
			<<set $_changetype to true>><<rightActionInitTentacle>>
	<</switch>>
	<<if $_changetype isnot true>>
		<<rightActionsVore>>
		<<if Object.keys(_rightaction).length gt 0>>
			<<if !(Object.values(_rightaction).includes($rightactiondefault))>>
				<<set $rightactiondefault to "rest">>
			<</if>>
			<<set $rightaction to $rightactiondefault>>
			<div class="extraMargin">
				<<generateCombatAction _rightaction "rightaction" "Vore">>
			</div>
			<<if $options.combatControls.includes("ists")>>
				<div id="rightactionDifficulty">
					<<rightactionDifficulty>>
				</div>
			<</if>>
		<</if>>
		<<set $lastOptions.right to clone(_rightOptions)>>
	<</if>>
<</widget>>

<<widget "rightactionDifficultyVore">>/* But seriously, not having this blank widget will cause red blocks of error in the "lists" actions types */
	<!-- Does nothing -->
<</widget>>

<<widget "rightActionsVore">>
	<<set _vorecreatureKr to window.KR.getCreatureTypeKr($vorecreature)>>
	<<set _rightaction to {}>>
	<<if !(["orgasm", "pain", "unreal"].includes(_rightOptions))>>
		<<set _rightaction["쉰다"] to "rest">>
	<</if>>
	<<switch _rightOptions>>
		<<case "free">>
			<<set _rightaction[_vorecreatureKr + "에게서 탈출한다"] to "rightescape">>
			<<if $vorestage lte 6>>
				<<set _rightaction[_vorecreatureKr + "에 매달린다"] to "righthold">>
			<</if>>
			<<if $rightarm is "trapped">>
				<<set _rightaction["오른팔을 빼낸다"] to "rightvorefree">>
			<</if>>
		<<case "bound" "trapped">>
		<<case "orgasm">>
			<<set _rightaction["접는다"] to "rightfold">>
			<<set _rightaction["움켜쥔다"] to "rightgrip">>
		<<case "pain">>
			<<set _rightaction["버둥거린다"] to "rightstruggleweak">>
			<<set _rightaction["보호한다"] to "rightprotect">>
		<<case "unreal">>
			<<set _rightaction["자신을 찌른다"] to "rightpoke">>
			<<set _rightaction["팔을 치워둔다"] to "rightcurl">>
	<</switch>>
<</widget>>

:: Widgets Vore [widget]
<<widget "vore">>
	<<set _vorecreatureKr to window.KR.getCreatureTypeKr($vorecreature)>>
	<<rng>>
	<<if $vorestage is 1>>
		_vorecreatureKr의 입이 당신의 허벅지를 움켜쥐고, 당신의 정강이와 발은 놈의 더듬는 혀에 내맡겨져 있다.
		<<neutral 4>>
	<<elseif $vorestage is 2>>
		_vorecreatureKr의 입이 당신의 허리를 움켜쥐고, 당신의 은밀한 부위는 놈의 미끈한 혀에 내맡겨져 있다.
		<<neutral 2 "genitals">><<neutral 2 "bottom">>
	<<elseif $vorestage is 3>>
		_vorecreatureKr의 입이 당신의 가슴을 움켜쥐고, 당신의 몸은 놈의 끈적한 혀에 내맡겨져 있다.
		<<neutral 2 "breasts">><<neutral 3 "genitals">><<neutral 3 "bottom">>
	<<elseif $vorestage is 4>>
		_vorecreatureKr의 입이 당신의 어깨를 움켜쥐고, 당신의 몸은 파고드는 혀에 내맡겨져 있다.
		<<neutral 3 "breasts">><<neutral 4 "genitals">><<neutral 4 "bottom">>
	<<elseif $vorestage is 5>>
		당신의 온몸이 _vorecreatureKr의 입 안에 들어가 있다. 놈의 끈적한 혀가 당신의 온몸을 짓누른다.
		<<neutral 4 "breasts">><<neutral 5 "genitals">><<neutral 5 "bottom">>
	<<elseif $vorestage is 6>>
		당신은 _vorecreatureKr의 식도 안에 있으며, 벽의 움직임에 밀려 나아간다.
		<<neutral 5 "breasts">><<neutral 6 "genitals">><<neutral 6 "bottom">>
	<<elseif $vorestage is 7>>
		당신은 _vorecreatureKr의 위장 안에 있다. 끈적한 액체 위로 머리를 내밀고 있기조차 힘겹다.
		<<if $vorecreature is "oyster" and $rng lte 10 and $pearlChance is undefined>>
			<<wearProp "oyster pearl">>
			당신은 뭔가 둥글고 매끄러운 것이 당신의 몸을 누르는 것을 느낀다. 당신은 그것을 붙잡고 살펴본다. <span class="green">당신은 희귀한 진주를 찾았다.</span> 꽤 짭짤한 돈벌이가 될 것이다.
			<<tending_give oyster_pearl 1>>
			<<set $pearlChance to 1>>
		<</if>>
		<<neutral 6 "breasts">><<neutral 7 "genitals">><<neutral 7 "bottom">>
	<</if>>
	<<if $vorestage is 1>>
		<<if ($vorestruggle * currentSkillValue('physique')) gte $vorestrength>>
			<<if $vorestruggle is 2>>
				당신은 두 팔로 _vorecreatureKr의 아가리를 밀어내어, <span class="green">당신을 더 삼키지 못하게 막는다.</span>
			<<elseif $vorestruggle is 1>>
				당신은 한 팔로 _vorecreatureKr의 아가리를 밀어내어, <span class="green">당신을 더 삼키지 못하게 막는다.</span>
			<<else>>
				_vorecreatureKr【이가】 당신을 더 삼키는 것을 막을 방법이 없지만, <span class="green">놈은 당신의 취약한 상태를 이용하지 않는다.</span>
			<</if>>
		<<else>>
			<<set $vorestage += 1>>
			<<if $vorestruggle is 2>>
				당신은 두 팔로 _vorecreatureKr의 아가리를 밀어내어 보지만, <span class="blue">충분하지 않다.</span> 당신은 놈의 입안으로 더 깊숙이 미끄러져 들어가, 허리까지 삼켜진다.
			<<elseif $vorestruggle is 1>>
				당신은 한 팔로 _vorecreatureKr의 아가리를 밀어내어 보지만, <span class="blue">충분하지 않다.</span> 당신은 놈의 입안으로 더 깊숙이 미끄러져 들어가, 허리까지 삼켜진다.
			<<else>>
				_vorecreatureKr【이가】 당신을 더 삼키는 것을 막을 방법이 없으며, <span class="blue">놈은 당신의 취약한 상태를 이용한다.</span> 당신은 놈의 입안으로 더 깊숙이 미끄러져 들어가, 허리까지 삼켜진다.
			<</if>>
			<<if $voretrait gte 1 and random(1, 3) is 3>>
				당신은 그 감각에 몸을 떤다.<<arousal 100>>
			<</if>>
		<</if>>
	<<elseif $vorestage is 2>>
		<<if $worn.over_lower.integrity gt 0>>
			<<set $worn.over_lower.integrity -= 1>>
		<<elseif $worn.lower.integrity lte 0>>
			<<set $worn.lower.integrity -= 1>>
		<<elseif $worn.under_lower.integrity lte 0>>
			<<set $worn.under_lower.integrity -= 1>>
		<</if>>
		<<if ($vorestruggle * currentSkillValue('physique')) gte $vorestrength>>
			<<if $vorestruggle is 2>>
				당신은 두 팔로 _vorecreatureKr의 아가리를 밀어내어, <span class="green">당신을 더 삼키지 못하게 막는다.</span>
			<<elseif $vorestruggle is 1>>
				당신은 한 팔로 _vorecreatureKr의 아가리를 밀어내어, <span class="green">당신을 더 삼키지 못하게 막는다.</span>
			<<else>>
				_vorecreatureKr【이가】 당신을 더 삼키는 것을 막을 방법이 없지만, <span class="green">놈은 당신의 취약한 상태를 이용하지 않는다.</span>
			<</if>>
		<<else>>
			<<set $vorestage += 1>>
			<<if $vorestruggle is 2>>
				당신은 두 팔로 _vorecreatureKr의 아가리를 밀어내어 보지만, <span class="purple">충분하지 않다.</span> 당신은 놈의 입안으로 더 깊숙이 미끄러져 들어가, 가슴까지 삼켜진다.
			<<elseif $vorestruggle is 1>>
				당신은 한 팔로 _vorecreatureKr의 아가리를 밀어내어 보지만, <span class="purple">충분하지 않다.</span> 당신은 놈의 입안으로 더 깊숙이 미끄러져 들어가, 가슴까지 삼켜진다.
			<<else>>
				_vorecreatureKr【이가】 당신을 더 삼키는 것을 막을 방법이 없으며, <span class="purple">놈은 당신의 취약한 상태를 이용한다.</span> 당신은 놈의 입안으로 더 깊숙이 미끄러져 들어가, 가슴까지 삼켜진다.
			<</if>>
		<</if>>
	<<elseif $vorestage is 3>>
		<<if $worn.over_lower.integrity gt 0>>
			<<set $worn.over_lower.integrity -= 1>>
		<<elseif $worn.lower.integrity gt 0>>
			<<set $worn.lower.integrity -= 1>>
		<<elseif $worn.under_lower.integrity gt 0>>
			<<set $worn.under_lower.integrity -= 1>>
		<</if>>
		<<if $worn.over_upper.integrity gt 0>>
			<<set $worn.over_upper.integrity -= 1>>
		<<elseif $worn.upper.integrity gt 0>>
			<<set $worn.upper.integrity -= 1>>
		<<elseif $worn.under_upper.integrity gt 0>>
			<<set $worn.under_upper.integrity -= 1>>
		<</if>>
		<<set $worn.upper.integrity -= 1>>
		<<if ($vorestruggle * currentSkillValue('physique')) gte $vorestrength>>
			<<if $vorestruggle is 2>>
				당신은 두 팔로 _vorecreatureKr의 아가리를 밀어내어, <span class="green">당신을 더 삼키지 못하게 막는다.</span>
			<<elseif $vorestruggle is 1>>
				당신은 한 팔로 _vorecreatureKr의 아가리를 밀어내어, <span class="green">당신을 더 삼키지 못하게 막는다.</span>
			<<else>>
				_vorecreatureKr【이가】 당신을 더 삼키는 것을 막을 방법이 없지만, <span class="green">놈은 당신의 취약한 상태를 이용하지 않는다.</span>
			<</if>>
		<<else>>
			<<set $vorestage += 1>>
			<<if $vorestruggle is 2>>
				당신은 두 팔로 _vorecreatureKr의 아가리를 밀어내어 보지만, <span class="pink">충분하지 않다.</span> 당신은 놈의 입안으로 더 깊숙이 미끄러져 들어가, 목까지 삼켜진다.
			<<elseif $vorestruggle is 1>>
				당신은 한 팔로 _vorecreatureKr의 아가리를 밀어내어 보지만, <span class="pink">충분하지 않다.</span> 당신은 놈의 입안으로 더 깊숙이 미끄러져 들어가, 목까지 삼켜진다.
			<<else>>
				_vorecreatureKr【이가】 당신을 더 삼키는 것을 막을 방법이 없으며, <span class="pink">놈은 당신의 취약한 상태를 이용한다.</span> 당신은 놈의 입안으로 더 깊숙이 미끄러져 들어가, 목까지 삼켜진다.
			<</if>>
		<</if>>
	<<elseif $vorestage is 4>>
		<<if $worn.over_lower.integrity gt 0>>
			<<set $worn.over_lower.integrity -= 1>>
		<<elseif $worn.lower.integrity gt 0>>
			<<set $worn.lower.integrity -= 1>>
		<<elseif $worn.under_lower.integrity gt 0>>
			<<set $worn.under_lower.integrity -= 1>>
		<</if>>
		<<if $worn.over_upper.integrity gt 0>>
			<<set $worn.over_upper.integrity -= 1>>
		<<elseif $worn.upper.integrity gt 0>>
			<<set $worn.upper.integrity -= 1>>
		<<elseif $worn.under_upper.integrity gt 0>>
			<<set $worn.under_upper.integrity -= 1>>
		<</if>>
