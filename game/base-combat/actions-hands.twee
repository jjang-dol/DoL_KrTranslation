								"하지만 <<his>> <<= window.KR.getBreastSizeKr(_npc.breastsdesc)>>【은는】 계속해서 얼굴을 <<if _npc.breastsize gte 6>>집어삼킨다<<else>>짓누른다<</if>>.",
								"하지만 얼굴에서 <<his>> <<= window.KR.getBreastSizeKr(_npc.breastsdesc)>>【을를】 밀어낼 수 없다."
							)>>
						<</if>>
					<<elseif ["lefthand", "righthand"].includes($mouthuse)>>
						<<if $rng % 4 == 0>>
							하지만 <<he>>【은는】 입을 더 꽉 막아 누르며, 계속 붙잡아 두려고 얼굴에 손톱을 파고든다.
							<<violence 3>><<bruise face>>
						<<else>>
							<<print either(
								"하지만 <<his>> 손을 치워낼 수 없다.",
								"하지만 <<his>> 손은 입 위에서 단단히 버티고 있다.",
								"하지만 입에서 <<his>> 손을 떼어낼 수 없다."
							)>>
						<</if>>
					<<elseif $mouthstate is "otheranus">>
						<<if $rng % 4 == 0>>
