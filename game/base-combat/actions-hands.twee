					<<set _rightaction[$currentSexToyRight.name + "【을를】 밀어 넣는다"] to "dildoSelfAnus">>
				<</if>>
				<<if $_genitals_exposed and $vaginause is 0>>
					<<set _rightaction[$currentSexToyRight.name + "【을를】 당신의 보지에 가져간다"] to "dildoSelfPussyEntrance">>
				<</if>>
			<</if>>

			<<set _rightaction["항문을 애태운다"] to "dildoSelfAnusEntrance">>
			<<set _rightaction[$currentSexToyRight.name + "【을를】 떨어뜨린다"] to "dildoDrop">>
		<</if>>
	<</if>>
<</widget>>

<<widget "strokerSelfPenisEntrance">>
	<<if _args[0] isnot undefined>>
