		<<else>>
			당신은 <<combatpersons>> 손목을 움켜쥐려 하지만,
			<<if $vaginastate is "otherhand">>
				<span class="red">오히려 <<he>>【은는】 보복하듯 <<his>> 손가락을 더 깊이 쑤셔 넣는다.</span>
			<<else>>
				<span class="red">오히려 <<he>>【은는】 손을 쳐내고 다시 쓰다듬기 시작한다.</span>
			<</if>>
			<<if $consensual is 1>>
				<<set $consensual to 0>><<molested>><<controlloss>>
			<</if>>
			<<violence 1>>
		<</if>>
	<</if>>

	<<if $leftaction is "handpullanus" or $rightaction is "handpullanus">>
