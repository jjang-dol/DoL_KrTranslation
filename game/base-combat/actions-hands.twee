			<<set $leftaction to 0>><<set $leftactiondefault to "handpullanus">>
			<<set $rightaction to 0>><<set $rightactiondefault to "handpullanus">>
			<<personselect $lefttarget>><<set $_handPullDifficulty to 500>>
