		<<elseif playerChastity("penis")>>
			당신은 허벅지 안쪽을 쓰다듬는다.
		<<elseif _args[0] is "both">>
			당신은 한 손으로는 기둥을 따라 손가락으로 훑고 다른 손으로는 끝을 둥글게 어루만지며 자지를 애무한다.
		<<else>>
			당신은 <<print $_hands>>【으로로】 기둥을 따라 손가락으로 훑어 내리며 자지를 애무한다.
		<</if>>
		<<submission 1>><<set $speechcamerapose to 1>>
	<<elseif $_hypnosis>>
		당신은 자지를 가리려 한다.
		<<if $_hypnosis is "accepted">>
			<<hypnosisText '하지만 음란한 생각이 끼어들고, <span class="lewd">당신의 정신은 곧바로 그것을 받아들인다.</span>'>>
		<<else>>
			<<hypnosisText '<span class="pink">하지만 그 생각은 정신 속에서 낚아채져 다른 생각으로 바뀐다.</span>'>>
		<</if>>
		<<if $worn.genitals.name is "chastity parasite">>
			당신은 기생 정조대를 부드럽게 꽉 쥐자, 몸 전체로 쾌감의 파도가 전해진다.
			<<if _args[0] is "both">>
				<<arousal 400 "genitals">>
			<<else>>
				<<arousal 200 "genitals">>
			<</if>>
			<<if !$stalk_end>>
				<<meek 5>><<set _stalkNoRunning to "chastity parasite">>
			<</if>>
		<<elseif playerChastity("penis")>>
			당신은 부드럽게 허벅지 안쪽을 쓰다듬는다.
		<<elseif _args[0] is "both">>
			당신은 한 손으로는 기둥을 따라 손가락으로 훑고 다른 손으로는 끝을 둥글게 어루만지며 부드럽게 자지를 애무한다.
		<<else>>
			당신은 <<print $_hands>>【으로로】 기둥을 따라 손가락으로 훑어 내리며 부드럽게 자지를 애무한다.
		<</if>>
		<<submission 1>><<set $speechcamerapose to 1>><<hypnotised 1>>
		<<if $_hypnosis is "forced" and $daily.stalkWillpower lt 20>>
			<<gwillpower>><<willpower 1>>
			<<set $daily.stalkWillpower to ($daily.stalkWillpower or 0) + 1>>
		<</if>>
	<<else>>
		당신은
		<<if $hypnosis_traits.cover gte 1>>
			<span class="green">충동적인 생각을 억누르고</span>
		<</if>>
		<<if ($worn.lower.name is "towel skirt" or $worn.lower.name is "large towel bottom") and $worn.lower.state is "waist">>
			<<print $_hands>>【으로로】 수건을 더 끌어당겨 당신의 <<print $_genital>>【을를】 가린다.
		<<else>>
			<<print $_hands>>【으로로】 당신의 <<print $_genital>>【을를】 가린다.
		<</if>>
	<</if>>
<</widget>>

<<widget "effectsCoverAnus">>
	<<if _args[1] is "lewd">>
		<<set $_hypnosis to "lewd">>
	<<elseif $uncomfortable.hypnosis is false and $hypnosis_traits.cover gte random(1,5)>>
		<<set $_hypnosis to "accepted">>
	<<elseif $hypnosis_traits.cover gte 1 and currentSkillValue('willpower') lt random(1, (200 * $hypnosis_traits.cover))>>
		<<set $_hypnosis to "forced">>
	<</if>>
	<<switch _args[0]>>
		<<case "both">>
			<<set $_hands to "양손">>
			<<set $leftactiondefault to $leftaction>>
			<<set $rightactiondefault to $rightaction>>
			<<set $leftaction to 0>><<set $rightaction to 0>>
			<<if $_hypnosis is "forced">>
				<<set $leftarm to 0>><<set $rightarm to 0>><<set $anususe to 0>>
				<<set $leftactiondefault to "leftstopanus">>
				<<set $rightactiondefault to "rightstopanus">>
			<<elseif $_hypnosis>>
				<<set $leftarm to "anus">><<set $rightarm to "anus">><<set $anususe to "cover">>
				<<set $leftactiondefault to "leftcoveranuslewd">>
				<<set $rightactiondefault to "rightcoveranuslewd">>
			<<else>>
				<<brat 2>><<set $leftarm to "anus">><<set $rightarm to "anus">><<set $anususe to "cover">>
			<</if>>
		<<case "left">>
			<<set $_hands to _args[0] + " hand">>
			<<set $leftactiondefault to $leftaction>>
			<<set $leftaction to 0>>
			<<if $_hypnosis is "forced">>
				<<set $leftarm to 0>><<set $rightarm to 0>><<if !$rightactiondefault.includes("leftcoveranus")>><<set $anususe to 0>><</if>>
				<<set $leftactiondefault to "leftstopanus">>
			<<elseif $_hypnosis>>
				<<set $leftarm to "anus">><<set $anususe to "cover">>
				<<set $leftactiondefault to "leftcoveranuslewd">>
			<<else>>
				<<brat 1>><<set $leftarm to "anus">><<set $anususe to "cover">>
			<</if>>
		<<case "right">>
			<<set $_hands to _args[0] + " hand">>
			<<set $rightactiondefault to $rightaction>>
			<<set $rightaction to 0>>
			<<if $_hypnosis is "forced">>
				<<set $rightarm to 0>><<if !$leftactiondefault.includes("leftcoveranus")>><<set $anususe to 0>><</if>>
				<<set $rightactiondefault to "rightstopanus">>
			<<elseif $_hypnosis>>
				<<set $rightarm to "anus">><<set $anususe to "cover">>
				<<set $rightactiondefault to "rightcoveranuslewd">>
			<<else>>
				<<brat 1>><<set $rightarm to "anus">><<set $anususe to "cover">>
			<</if>>
	<</switch>>
	<<if _args[1] is "lewd">>
		<<if _args[0] is "both">>
			당신은 두 손으로 엉덩이골을 벌리며, 자신의 <<bottom>>【을를】 더듬는다.
		<<else>>
			당신은 <<print $_hands>>【으로로】 자신의 <<bottom>>【을를】 더듬으며, 가볍게 찰싹 때린다.
		<</if>>
		<<submission 1>><<set $speechcamerapose to 1>>
	<<elseif $_hypnosis>>
		당신은 엉덩이를 가리려 한다.
		<<if $_hypnosis is "accepted">>
			<<hypnosisText '하지만 음란한 생각이 끼어들고, <span class="lewd">당신의 정신은 곧바로 그것을 받아들인다.</span>'>>
		<<else>>
			<<hypnosisText '<span class="pink">하지만 그 생각은 정신 속에서 낚아채져 다른 생각으로 바뀐다.</span>'>>
		<</if>>
		<<if _args[0] is "both">>
			당신은 두 손으로 엉덩이골을 벌리며, 자신의 <<bottom>>【을를】 더듬는다.
		<<else>>
			당신은 <<print $_hands>>【으로로】 자신의 <<bottom>>【을를】 더듬으며, 가볍게 한 대 찰싹 때린다.
		<</if>>
		<<submission 1>><<set $speechcamerapose to 1>><<hypnotised 1>>
		<<if $_hypnosis is "forced" and $daily.stalkWillpower lt 20>>
			<<gwillpower>><<willpower 1>>
			<<set $daily.stalkWillpower to ($daily.stalkWillpower or 0) + 1>>
		<</if>>
	<<else>>
		당신은
		<<if $hypnosis_traits.cover gte 1>>
			<span class="green">충동적인 생각을 억누르고</span>
		<</if>>
		<<if ($worn.lower.name is "towel skirt" or $worn.lower.name is "large towel bottom") and $worn.lower.state is "waist">>
			<<print $_hands>>【으로로】 수건을 엉덩이 위로 더 끌어당겨 가린다.
		<<else>>
			<<print $_hands>>【으로로】 엉덩이를 가린다.
		<</if>>
	<</if>>
<</widget>>
