				<<combat-reset-hand "left">>
			<<else>>
				<<combat-reset-hand "right">>
			<</if>>
			<<set $penisuse to 0>><<set $penisstate to 0>>
		<<else>>
			당신은 <<combatpersons>> 손목을 움켜쥐려 하지만,
			<<if $penisstate is "otherhand">>
				<span class="red">오히려 <<he>>【은는】 보복하듯 더 꽉 움켜쥔다.</span>
			<<else>>
				<span class="red">오히려 <<he>>【은는】 손을 쳐내고 다시 쓰다듬기 시작한다.</span>
			<</if>>
