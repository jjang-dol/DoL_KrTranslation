:: Widgets Machine [widget]
<<widget "machine_init">>
	<<combatinit>>
	<<set $enemytype to "machine">>
	<<set $machine to {}>>
	<<set $machine.number to 0>>
	<<set $machine.speed to 2>>
	<<for _i = 0; _i < _args.length; _i++>>
		<<set $machine[_args[_i]] to {}>>
		<<set $machine[_args[_i]].health to $machine_health>>
		<<set $machine[_args[_i]].ammo to $machine_ammo>>
		<<set $machine[_args[_i]].hack to 0>>
		<<set $machine[_args[_i]].state to "ready">>
		<<set $machine[_args[_i]].use to "ready">>
		<<if _args[_i] isnot "arm_chains" and _args[_i] isnot "leg_chains">>
			<<set $machine.number += 1>>
		<</if>>
	<</for>>
	<<set $leftactiondefault to "rest">>
	<<set $rightactiondefault to "rest">>
	<<set $feetactiondefault to "rest">>
<</widget>>

<<widget "machine_damage">>
	<<if $machine[_args[0]].health gte $machine_health>>
		<span class="red">멀쩡한</span>
	<<elseif $machine[_args[0]].health gte ($machine_health * 0.8)>>
		<span class="pink">살짝 찌그러진</span>
	<<elseif $machine[_args[0]].health gte ($machine_health * 0.6)>>
		<span class="purple">찌그러진</span>
	<<elseif $machine[_args[0]].health gte ($machine_health * 0.4)>>
		<span class="blue">금이 간</span>
	<<elseif $machine[_args[0]].health gte ($machine_health * 0.2)>>
		<span class="lblue">심하게 금이 간</span>
	<<elseif $machine[_args[0]].health gte ($machine_health * 0.1)>>
		<span class="teal">깨진</span>
	<<else>>
		<span class="green">박살난</span>
	<</if>>
<</widget>>

<<widget "machine_end">>
	<<unset $machine>>
	<<unset $machine_health>>
	<<unset $machine_ammo>>
	<<endcombat>>
<</widget>>

<<widget "machine_combat">>
	<<if $machine.tattoo>>
		<<switch $machine.tattoo.state>>
		<<case "ready">>
			<<if $position is "doggy">>
				<<set _machine_selection to random(1, 5)>>
				<<if _machine_selection is 1 and $machine.tattoo.back isnot 1>>
					<<set _machine_choice to "back">>
				<<elseif _machine_selection is 2 and $machine.tattoo.left_shoulder isnot 1>>
					<<set _machine_choice to "left_shoulder">>
				<<elseif _machine_selection is 3 and $machine.tattoo.left_cheek isnot 1>>
					<<set _machine_choice to "left_cheek">>
				<<elseif _machine_selection is 4 and $machine.tattoo.left_bottom isnot 1>>
					<<set _machine_choice to "left_bottom">>
				<<elseif $machine.tattoo.hack gte 3>>
					<<set $machine.tattoo.use to "inert">>
					<<set $machine.tattoo.state to "inert">>
					<<set $machine.number -= 1>>
					<<set $machine_stat += 1>>
					타투건이 당신의 몸 주위를 맴돌다, <span class="green">작동을 멈춘다.</span>
				<<else>>
					<<set _machine_choice to "hover">>
					<<set $machine.tattoo.hack += 1>>
					타투건이 결정을 내리려는 듯이 당신의 신체 부위를 차례대로 가리킨다.
				<</if>>
			<<else>>
				<<set _machine_selection to random(1, 8)>>
				<<if _machine_selection is 1 and $machine.tattoo.breasts isnot 1>>
					<<set _machine_choice to "breasts">>
				<<elseif _machine_selection is 2 and $machine.tattoo.forehead isnot 1>>
					<<set _machine_choice to "forehead">>
				<<elseif _machine_selection is 3 and $machine.tattoo.left_thigh isnot 1>>
					<<set _machine_choice to "left_thigh">>
				<<elseif _machine_selection is 4 and $machine.tattoo.pubic isnot 1>>
					<<set _machine_choice to "pubic">>
				<<elseif _machine_selection is 5 and $machine.tattoo.right_bottom isnot 1>>
					<<set _machine_choice to "right_bottom">>
				<<elseif _machine_selection is 6 and $machine.tattoo.right_cheek isnot 1>>
					<<set _machine_choice to "right_cheek">>
				<<elseif _machine_selection is 7 and $machine.tattoo.right_shoulder isnot 1>>
					<<set _machine_choice to "right_shoulder">>
				<<elseif _machine_selection is 8 and $machine.tattoo.right_thigh isnot 1>>
					<<set _machine_choice to "right_thigh">>
				<<else>>
					<<set _machine_choice to "hover">>
					<<set $machine.tattoo.hack += 1>>
					<<machine_damage tattoo>> 타투건이 결정을 내리려는 듯이 당신의 신체 부위를 차례대로 가리킨다.
				<</if>>
			<</if>>
			<<if _machine_choice isnot "hover" and $machine.tattoo.use isnot "destroyed" and $machine.tattoo.use isnot "inert">>
				윙윙거리는 소리와 함께, <span class="purple"><<machine_damage tattoo>> 타투건이 당신의 <<bodypart _machine_choice>> 위를 맴돈다.</span>
				<<set $machine.tattoo.use to _machine_choice>>
				<<set $machine.tattoo.state to "entrance">>
			<</if>>

		<<case "destroyed">>
			타투건이 씰룩거리지만, <span class="green">여전히 비활성화된 상태다.</span>
		<<case "inert">>
			타투건은 <span class="green">미동도 하지 않는다.</span>
		<<case "entrance">>
			<<if !$skin[$machine.tattoo.use].pen>>
				<<machine_damage tattoo>> 타투건이 당신의 <<bodypart $machine.tattoo.use>>【을를】 누른다. <span class="pink">글씨를 새길 준비를 하며 윙윙거리는 소리가 거세진다.</span><<gstress>><<stress 6>>
				<<set $machine.tattoo.state to "imminent">>
			<<elseif $machine.tattoo.armed is 1>>
				붉은빛이 당신의 피부를 스캔하자 <<machine_damage tattoo>> 타투건이 삐 소리를 낸다. <span class="purple">기계의 밑면에서 용기가 열린다.</span>
				<<set $machine.tattoo.state to "foam">>
			<<else>>
				<<machine_damage tattoo>> 타투건이 당신의 <<bodypart $machine.tattoo.use>>【을를】 누르지만, <span class="lblue">이내 뒤로 물러난다.</span> 붉은빛이 피부 위를 훑고 지나가자 기계가 멀어진다.
				<<set $machine.tattoo[$machine.tattoo.use] to 1>>
				<<set $machine.tattoo.use to "ready">>
				<<set $machine.tattoo.state to "ready">>
				<<set $machine.tattoo.hack += 1>>
			<</if>>
		<<case "imminent">>
			<span class="red"><<machine_damage tattoo>> 타투건이 당신의 <<bodypart $machine.tattoo.use>>에 "<<bodywriting_machine $machine.tattoo.use>>"라고 새긴다.</span><<ggpain>><<ggtrauma>><<ggstress>><<trauma 18>><<stress 18>><<pain 8>>
			<br><br>
			<<set $machine.tattoo[$machine.tattoo.use] to 1>>
			<<set $machine.tattoo.ammo -= 1>>
			<<set $machine_tattoo_success to true>>/*Just controls NPC response following encounter in underground dungeon.*/
			<<if $machine.tattoo.ammo gte 1>>
				<<machine_damage tattoo>> 타투건이 뒤로 물러나지만, 여전히 다시 작동할 준비가 되어 있다.
				<<set $machine.tattoo.use to "ready">>
				<<set $machine.tattoo.state to "ready">>
			<<else>>
				<<machine_damage tattoo>> 타투건이 뒤로 물러나며, <span class="green">작동을 멈춘다.</span>
				<<set $machine.tattoo.use to "inert">>
				<<set $machine.tattoo.state to "inert">>
				<<set $machine.number -= 1>>
				<<set $machine_stat += 1>>
			<</if>>
		<<case "foam">>
			<span class="pink"><<machine_damage tattoo>> 타투건이 당신의 <<bodypart $machine.tattoo.use>> 위로 분홍색 거품을 분사한다.</span>
			<<if $skin[$machine.tattoo.use] and $skin[$machine.tattoo.use].pen and ["brand", "magic"].includes($skin[$machine.tattoo.use].pen)>>
				<span class="blue">거품이 걷혔지만 당신의 <<tattoo $machine.tattoo.use>>【은는】 아무런 변화가 없다.</span>
				<<machine_damage tattoo>> 타투건이 뒤로 물러난다.
				<<set $machine.tattoo.use to "ready">>
				<<set $machine.tattoo.state to "ready">>
				<<set $machine.tattoo.ammo -= 1>>
			<<else>>
				<<bodywriting_clear $machine.tattoo.use>>
				<br><br>
				<<machine_damage tattoo>> 타투건이 당신의 <<bodypart $machine.tattoo.use>>【을를】 누른다. <span class="pink">글씨를 새길 준비를 하며 윙윙거리는 소리가 거세진다.</span>
				<<set $machine.tattoo.state to "imminent">>
			<</if>>
		<</switch>>
		<br>
	<</if>>
	<<if $machine.vaginal>>
		<<if $machine.vaginal.ammo lte 0 and $machine.vaginal.state isnot "inert" and $machine.vaginal.state isnot "destroyed">>
			<<if $machine.vaginal.state is "penetrated">>
				<<machine_damage vaginal>> 남근형 기계가 뽁 소리를 내며 당신의 <<pussy>>에서 빠져나오더니, <span class="green">요동치며 작동을 멈춘다.</span>
			<<elseif $machine.vaginal.state is "imminent" or $machine.vaginal.state is "entrance">>
				<<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>>【을를】 위협하던 것을 멈추고, <span class="green">요동치며 작동을 멈춘다.</span>
			<<else>>
				<span class="green"><<machine_damage vaginal>> 남근형 기계가 요동치며 작동을 멈춘다.</span>
			<</if>>
			<<set $machine.vaginal.use to "inert">>
			<<set $machine.vaginal.state to "inert">>
			<<set $machine.number -= 1>>
			<<machine_vaginal_disable>>
		<<else>>
			<<switch $machine.vaginal.state>>
			<<case "ready">>
				<<machine_damage vaginal>> 남근형 기계가 <span class="purple">당신의 <<pussy>>【을를】 쿡쿡 찌른다.</span>
				<<neutral 5 "genitals">>
				<<set $vaginause to "machine">><<set $vaginastate to "entrance">><<set $machine.vaginal.use to "vagina">><<set $machine.vaginal.state to "entrance">>
			<<case "entrance">>
				<<if $worn.over_lower.exposed lte 1>>
					<<if $machine.vaginal.armed is 1>>
						<<machine_damage vaginal>> 남근형 기계 위쪽의 용기가 열리며 분홍색 거품을 뿌려, <span class="purple">당신의 $worn.over_lower.name【을를】 녹여버린다.</span>
						<<set $worn.over_lower.integrity -= 100>>
					<<else>>
						<<machine_damage vaginal>> 남근형 기계가 직물을 찢으며 당신의 $worn.over_lower.name【을를】 뚫고 들어오려 한다.
						<<set $worn.over_lower.integrity -= 20>>
					<</if>>
				<<elseif $worn.lower.exposed lte 1>>
					<<if $machine.vaginal.armed is 1>>
						<<machine_damage vaginal>> 남근형 기계 위쪽의 용기가 열리며 분홍색 거품을 뿌려, <span class="purple">당신의 $worn.lower.name【을를】 녹여버린다.</span>
						<<set $worn.lower.integrity -= 100>>
					<<else>>
						<<machine_damage vaginal>> 남근형 기계가 직물을 찢으며 당신의 $worn.lower.name【을를】 뚫고 들어오려 한다.
						<<set $worn.lower.integrity -= 20>>
					<</if>>
				<<elseif $worn.under_lower.exposed lte 0>>
					<<if $machine.vaginal.armed is 1>>
						<<machine_damage vaginal>> 남근형 기계 위쪽의 용기가 열리며 분홍색 거품을 뿌려, <span class="purple">당신의 $worn.under_lower.name【을를】 녹여버린다.</span>
						<<set $worn.under_lower.integrity -= 100>>
					<<else>>
						<<machine_damage vaginal>> 남근형 기계가 직물을 찢으며 당신의 $worn.under_lower.name【을를】 뚫고 들어오려 한다.
						<<set $worn.under_lower.integrity -= 20>>
					<</if>>
				<<elseif playerChastity("vagina")>>
					<<if $machine.vaginal.armed is 1>>
						<<machine_damage vaginal>> 남근형 기계 위쪽의 용기가 열리며 당신의 $worn.genitals.name 쪽으로 분홍색 거품을 뿌려, <span class="purple"><<= ({ metal: "금속", plastic: "플라스틱", parasite: "기생충" }[setup.clothes.genitals[clothesIndex('genitals',$worn.genitals)].altDamage] || "소재")>>【을를】 녹여버린다.</span>
						<<set $worn.genitals.integrity -= 100>>
					<<else>>
						<<machine_damage vaginal>> 남근형 기계가 직물을 찢으며 당신의 $worn.genitals.name【을를】 뚫고 들어오려 한다.
						<<set $worn.genitals.integrity -= 20>>
					<</if>>
				<<else>>
					<<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>>【을를】 압박하며, <span class="pink">당장이라도 꿰뚫고 들어올 듯하다.</span>
					<<sex 5 "genitals">>
					<<set $vaginastate to "imminent">><<set $machine.vaginal.state to "imminent">>
				<</if>>
			<<case "imminent">>
				<<if $player.virginity.vaginal isnot true>>
					<<sex 30 "genitals">>
					<<violence 1>>
					<<set $vaginastate to "penetrated">><<set $machine.vaginal.state to "penetrated">><<vaginalstat>><<bruise vagina>><<violence 1>><<raped>><<vaginaraped>>
					<span class="pink"><<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>> 안으로 파고든다.</span>
				<<else>>
					<<sex 100 "genitals">>
					<<bruise vagina>><<vaginalstat>><<raped>><<vaginaraped>>
					<<set $vaginastate to "penetrated">><<set $machine.vaginal.state to "penetrated">>
					<span class="red"><<machine_damage vaginal>> 남근형 기계가 당신의 처녀 보지를 꿰뚫어,
						<<if $sexStats.vagina.pregnancy.totalBirthEvents gt 0>>
							처녀막이 없음에도 불구하고, 처녀와 순결을 빼앗기자 몸 안에서 무언가 변하는 것이 느껴진다.<<violence 10>>
						<<else>>
							처녀막을 찢고 당신의 순결을 영원히 앗아간다.<<violence 25>>
						<</if>>
					</span>
				<</if>>
				<<takeVirginity "sex machine" "vaginal">>
			<<case "penetrated">>
				<<if $machine.speed is 3>>
					<<switch random(1,5)>>
						<<case 1>>
							<<machine_damage vaginal>> 남근형 기계가 당신이 방심한 틈을 타 불규칙적인 박자로 당신의 <<pussy>>【을를】 유린한다.
						<<case 2>>
							<<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>> 안에서 부풀어 오르듯, 안을 꽉 채우며 넓힌다.
						<<case 3>>
							<<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>>【을를】 너무 거세게 박아대어, 찔러올 때마다 몸이 앞으로 휘청인다.
						<<case 4>>
							<<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>> 깊숙한 곳을 내리찍듯 박아댄다.
						<<case 5>>
							<<machine_damage vaginal>> 남근형 기계가 잠시 멈추더니, 이내 <span class="purple">눈에 보이지 않을 만큼 빠른 속도로 당신의 <<pussy>>【을를】 폭격한다.</span>
							<<violence 10>><<gpain>>
					<</switch>>
					<<sex 20 "genitals">><<violence 10>>
				<<elseif $machine.speed is 2>>
					<<switch random(1,5)>>
						<<case 1>>
							<<machine_damage vaginal>> 남근형 기계가 기계적인 리듬으로 당신의 <<pussy>>【을를】 범한다.
						<<case 2>>
							<<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>> 안을 찌를 때마다 궤적을 비튼다.
						<<case 3>>
							<<machine_damage vaginal>> 남근형 기계가 기계적인 리듬으로 당신의 <<pussy>>【을를】 마구 쑤셔댄다.
						<<case 4>>
							<<machine_damage vaginal>> 남근형 기계가 어떤 생물보다도 빠른 속도로 당신의 <<pussy>>【을를】 박아댄다.
						<<case 5>>
							<<machine_damage vaginal>> 남근형 기계가 잠시 멈추더니, 이내 <span class="purple">눈에 보이지 않을 만큼 빠른 속도로 당신의 <<pussy>>【을를】 폭격한다.</span>
							<<sex 30 "genitals">><<garousal>>
					<</switch>>
					<<sex 20 "genitals">>
				<<else>>
					<<switch random(1,5)>>
						<<case 1>>
							<<machine_damage vaginal>> 남근형 기계가 부드러운 리듬으로 당신의 <<pussy>>【을를】 범한다.
						<<case 2>>
							<<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>>【을를】 문지른다.
						<<case 3>>
							<<machine_damage vaginal>> 남근형 기계가 천천히 당신의 <<pussy>> 안을 밀고 들어온다.
						<<case 4>>
							<<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>> 안에서 잠시 멈췄다가, 다시 움직이기 시작한다.
						<<case 5>>
							<<machine_damage vaginal>> 남근형 기계가 당신의 <<pussy>> 입구에 밀착한 채 진동한다.
					<</switch>>
				<</if>>
				<<sex 10 "genitals">><<bruise vagina>><<violence 1>>
				<<set $machine.vaginal.ammo -= 1>>
			<<case "destroyed">>
				<<machine_damage vaginal>> 남근형 기계가 씰룩거리지만, <span class="green">미동조차 없다.</span>
			<<case "inert">>
				<<machine_damage vaginal>> 남근형 기계는 <span class="green">꼼짝도 하지 않는다.</span>
			<</switch>>
		<</if>>
		<br>
	<</if>>
	<<if $machine.anal>>
		<<if $machine.anal.ammo lte 0 and $machine.anal.state isnot "inert" and $machine.anal.state isnot "destroyed">>
			<<if $machine.anal.state is "penetrated">>
				<<machine_damage anal>> 작은 남근형 기계가 뽁 소리를 내며 당신의 <<bottom>>에서 빠져나오더니, <span class="green">요동치며 작동을 멈춘다.</span>
			<<elseif $machine.anal.state is "imminent" or $machine.anal.state is "entrance">>
				<<machine_damage anal>> 작은 남근형 기계가 당신의 <<bottom>>【을를】 위협하던 것을 멈추고, <span class="green">요동치며 작동을 멈춘다.</span>
			<<else>>
				<span class="green"><<machine_damage anal>> 작은 남근형 기계가 요동치며 작동을 멈춘다.</span>
			<</if>>
			<<set $machine.anal.use to "inert">>
			<<set $machine.anal.state to "inert">>
			<<set $machine.number -= 1>>
			<<machine_anal_disable>>
		<<else>>
			<<switch $machine.anal.state>>
			<<case "ready">>
				<<machine_damage anal>> 작은 남근형 기계가 <span class="purple">당신의 <<bottom>>【을를】 쿡쿡 찌른다.</span>
				<<neutral 5 "anus">>
				<<set $anususe to "machine">><<set $anusstate to "entrance">><<set $machine.anal.use to "anus">><<set $machine.anal.state to "entrance">>
			<<case "entrance">>
				<<if $worn.over_lower.exposed lte 1>>
					<<if $machine.anal.armed is 1>>
