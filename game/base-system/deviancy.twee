:: Widgets Deviancy [widget]
<<widget "deviancy1">>
	<<deviancyN 1>>
<</widget>>

<<widget "deviancy2">>
	<<deviancyN 2>>
<</widget>>

<<widget "deviancy3">>
	<<deviancyN 3>>
<</widget>>

<<widget "deviancy4">>
	<<deviancyN 4>>
<</widget>>

<<widget "deviancy5">>
	<<deviancyN 5>>
<</widget>>

<<widget "deviancy6">>
	<<deviancyN 6>>
<</widget>>

<<widget "deviancyN">>
	<<set $_n to _args[0]>>
	<<set $_scaledDeviancyMax to 20 * $_n>>
	<<if $control lt $controlmax>>
		<<if $_n is 6>>
			이토록 극단적인 타락 행위를 저지르자 <span class="green">통제력이 완전히 회복되지만</span>, <span class="red">정신에는 타격을 입힌다</span>.
		<<elseif $deviancy lt $_scaledDeviancyMax>>
			이런 음란한 행위는 당신을 흥분시키고, 당분간 <span class="green">통제력과 자존감을 회복시켜 준다</span>.
		<<else>>
			이런 음란한 행위는 당신을 흥분시키지만, 머리 위를 짓누르는 어둠을 걷어내지는 못한다. <span class="pink">무언가 더 극단적인 일을 해야만 한다.</span>
		<</if>>
	<<else>>
		<<if $_n is 6>>
			당신은 이미 스스로를 통제하고 있다고 느낀다. <span class="red">그래서 이런 극단적인 타락 행위를 해도 헛수고처럼 느껴져 만족감을 얻지 못한다</span>.
		<<elseif $deviancy lt $_scaledDeviancyMax>>
			당신은 이미 스스로를 통제하고 있다고 느끼지만, 이런 음란한 행위는 당신을 <span class="green">진정시키고</span> 흥분시킨다.
		<<else>>
			당신은 이미 스스로를 통제하고 있다고 느낀다. 그 행위는 <span class="pink">마음을 진정시키기에는 너무 얌전하지만</span>, 흥분시키기에는 충분하다.
		<</if>>
	<</if>>
	<<if !hasSexStat("deviancy", $_n, false) and $drunk gte 1>>
		<<if $_n is 6>>
			<span @class="'red ' + basicDrunkCss()">머리가 몽롱하고 붕 뜬다. 나중에 이 일을 기억하지 못하길 바랄 뿐이다.</span>
		<<else>>
			<span @class="'blue ' + basicDrunkCss()">알코올이 억제력을 무디게 만들자, 몸이 둥둥 떠다니는 기분이 든다.</span>
		<</if>>
	<</if>>
	<<if !hasSexStat("deviancy", $_n, false) and (playerHeatMinArousal() + playerRutMinArousal()) gte 1>>
		<<if $_n is 6>>
			<span @class="'red ' + basicJitterCss()">이러면 안 된다는 걸 알지만, 도무지 신경 쓸 수가 없다.</span>
		<<else>>
			<span @class="'pink ' + basicJitterCss()">더 나아가라고 부추기는 원초적인 충동이 느껴진다.</span>
		<</if>>
	<</if>>

	<!-- separating the code from the written text -->
	<<if $_n is 6>>
		<<set $deviancy += ($control lt $controlmax ? 2 : 1)>>
		<<if $control lt $controlmax>>
			<<control $controlmax>> /* max out control, doesn't matter if it's *10 */
			<<gggcontrol>>
		<</if>>
		<<trauma 40>>
		<<ggtrauma>>
	<<elseif $deviancy lt $_scaledDeviancyMax>>
		<<set $deviancy += ($control lt $controlmax ? 2 : 1)>>
		<<if $control lt $controlmax>>
			<<ggcontrol>>
		<</if>>
		<<control 25>><<stress $_n -300>><<combattrauma `$_n * -30`>><<ltrauma>><<lstress>>
	<<else>>
		<<if V.daily["deviancyStress" + $_n] isnot 1 and $statFreeze isnot true>>
			<<set V.daily["deviancyStress" + $_n] to 1>><<lstress>><<stress $_n -100>>
		<</if>>
	<</if>>
	<<arousal `$_n * 100`>><<garousal>>
	<<set $deviancy to Math.clamp($deviancy, 0, 100)>>
	<<earSlimeSeenActions "deviancy" $_n>>
	<br><br>
<</widget>>

<<widget "combatdeviancy1">>
	<<combatdeviancyN 1>>
<</widget>>

<<widget "combatdeviancy2">>
	<<combatdeviancyN 2>>
<</widget>>

<<widget "combatdeviancy3">>
	<<combatdeviancyN 3>>
<</widget>>

<<widget "combatdeviancy4">>
	<<combatdeviancyN 4>>
<</widget>>

<<widget "combatdeviancy5">>
	<<combatdeviancyN 5>>
<</widget>>

<<widget "combatdeviancy6">>
	<<combatdeviancyN 6>>
<</widget>>

<<widget "combatdeviancyN">>
	<<set $_n to _args[0]>>
	<<if $consensual is 1 or $_n is 6>>
		<<set $_scaledDeviancyMax to 20 * $_n>>
		<<if $deviancy lt $_scaledDeviancyMax>>
			<<set $deviancy += ($control lt $controlmax ? 2 : 1)>>
			<<if $control lt $controlmax>>
				<<set _combat_deviancy_success to (_combat_deviancy_success gte $_n ? _combat_deviancy_success : $_n)>>
				<<if $_n is 6>>
					<<control $controlmax>>
				<<else>>
					<<control 25>>
				<</if>>
			<<else>>
				<<set _combat_deviancy_max_control to $_n>>
			<</if>>
			<<if $_n is 6>>
				<<combattrauma 40>>
			<<else>>
				<<stress $_n -300>>
				<<combattrauma `$_n * -30`>>
			<</if>>
		<<else>>
			<<set _combat_deviancy_failure to $_n>>
			<<if V.daily["deviancyStress" + $_n] isnot 1 and $statFreeze isnot true>>
				<<set V.daily["deviancyStress" + $_n] to 1>><<stress $_n -100>>
			<</if>>
		<</if>>
		<<arousal `$_n * 100`>>
	<</if>>
	<<set $deviancy to Math.clamp($deviancy, 0, 100)>>
	<<earSlimeSeenActions "deviancy" $_n 5>>
<</widget>>

<<widget "combat_deviancy_text">>
	<<if _combat_deviancy_success>>
		<br>
		<<if _combat_deviancy_success is 6>>
			당신의 일탈 행위는 <span class="green">통제력을 완전히 회복시켜 주지만</span>, <span class="red">정신에는 타격을 입힌다</span>.<<gggcontrol>><<ggtrauma>><<ggarousal>>
		<<else>>
			당신의 일탈적인 행동이 <span class="green">통제력을 회복시켜 준다.</span><<ggcontrol>><<ltrauma>><<lstress>><<garousal>>
		<</if>>
	<<elseif _combat_deviancy_max_control>>
		<br>
		<<if _combat_deviancy_success is 6>>
			당신은 이미 스스로를 통제하고 있다고 느낀다. <span class="red">이런 광적인 타락 행위도 헛수고처럼 느껴져 만족감을 얻지 못한다</span>.<<gggcontrol>><<ggtrauma>><<ggarousal>>
		<<else>>
			당신의 일탈적인 행동이 <span class="green">마음을 달래고 당신을 흥분시킨다.</span><<ltrauma>><<lstress>><<garousal>>
		<</if>>
	<<elseif _combat_deviancy_failure>>
		<br>
		당신의 행동은 일탈적이긴 하지만, <span class="pink">마음을 달래기에는 너무 온건하다.</span><<garousal>>
	<</if>>
<</widget>>
