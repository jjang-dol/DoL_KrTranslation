:: Widgets Nicknames [widget]
<<widget "underworld_nickname">><<silently>>
	<<if $fame.sex gte 400>>
		<<if $fame.prostitution gte 400>>
			<<if $fame.rape gte 400>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "우리의 소년">>
							<<else>>
								<<set _text_output to "우리의 소녀">>
							<</if>>
						<<else>>
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "소년">>
							<<else>>
								<<set _text_output to "소녀">>
							<</if>>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "노리개">>
						<<else>>
							<<set _text_output to "육변기">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "파이크">>
						<<else>>
							<<set _text_output to "레이피어">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "초특급 걸레">>
						<<else>>
							<<set _text_output to "슈퍼 걸레">>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "착유기">>
						<<else>>
							<<set _text_output to "밀키">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "키블즈">>
						<<else>>
							<<set _text_output to "니블즈">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "방직공">>
						<<else>>
							<<set _text_output to "바늘">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "포키즈">>
						<<else>>
							<<set _text_output to "포키">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<<else>>
			<<if $fame.rape gte 400>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "늑대 창녀">>
						<<else>>
							<<set _text_output to "늑대 걸레">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "개 창녀">>
						<<else>>
							<<set _text_output to "개 걸레">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "스파이크">>
						<<else>>
							<<set _text_output to "난투꾼">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "공짜">>
						<<else>>
							<<set _text_output to "공짜 걸레">>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "개새끼 착즙기">>
						<<else>>
							<<set _text_output to "늑대 전사">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "개새끼 착유기">>
						<<else>>
							<<set _text_output to "늑대 기수">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "포주">>
							<<else>>
								<<set _text_output to "마담">>
							<</if>>
						<<else>>
							<<set _text_output to "사브르">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "걸레 아빠">>
							<<else>>
								<<set _text_output to "걸레 엄마">>
							<</if>>
						<<else>>
							<<set _text_output to "걸레">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<<else>>
		<<if $fame.prostitution gte 400>>
			<<if $fame.rape gte 400>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "사냥개 아버지">>
							<<else>>
								<<set _text_output to "사냥개 어머니">>
							<</if>>
						<<else>>
							<<set _text_output to "사냥개">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "지독한 놈">>
						<<else>>
							<<set _text_output to "강아지">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "단검">>
						<<else>>
							<<set _text_output to "흉터">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "섹스 구걸꾼">>
						<<else>>
							<<set _text_output to "강간 구걸꾼">>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "송곳니">>
						<<else>>
							<<set _text_output to "발톱">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "그 사냥개">>
						<<else>>
							<<set _text_output to "새끼강아지">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "스틸레토">>
						<<else>>
							<<set _text_output to "칼">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "창남 아빠">>
							<<else>>
								<<set _text_output to "창녀 엄마">>
							<</if>>
						<<else>>
							<<set _text_output to "동전 사냥꾼">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<<else>>
			<<if $fame.rape gte 400>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "맛있는 녀석">>
						<<else>>
							<<set _text_output to "그 토끼">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "새끼고양이">>
						<<else>>
							<<set _text_output to "암캐">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "거친 놈">>
						<<else>>
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "창잡이">>
							<<else>>
								<<set _text_output to "이빨 달린 보지">>
							<</if>>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "무료 샘플">>
						<<else>>
							<<set _text_output to "강간 미끼">>
						<</if>>
					<</if>>
				<</if>>
			<<else>>
				<<if $fame.bestiality gte 400>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "소굴의 아버지">>
							<<else>>
								<<set _text_output to "소굴의 어머니">>
							<</if>>
						<<else>>
							<<set _text_output to "그 늑대">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "목장주">>
						<<else>>
							<<set _text_output to "앞발">>
						<</if>>
					<</if>>
				<<else>>
					<<if $fame.scrap gte 400>>
						<<if $fame.pimp gte 400>>
							<<set _text_output to "그 쥐새끼">>
						<<else>>
							<<set _text_output to "싸움닭">>
						<</if>>
					<<else>>
						<<if $fame.pimp gte 400>>
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "아빠">>
							<<else>>
								<<set _text_output to "엄마">>
							<</if>>
						<<else>>
							<<set _text_output to "고기">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "cap">><<capitalise>><</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "overworld_nickname">><<silently>>
	<<if $fame.exhibitionism gte 400>>
		<<if $fame.good gte 400>>
			<<if $fame.business gte 400>>
				<<if $fame.social gte 400>>
					<<set _text_output to "고아">>
				<<elseif $fame.model gte 400>>
					<<set _text_output to "인기쟁이">>
				<<else>>
					<<set _text_output to "따뜻한 마음">>
				<</if>>
			<<else>>
				<<if $fame.social gte 400>>
					<<if $fame.model gte 400>>
						<<set _text_output to "스캔들 메이커">>
					<<else>>
						<<set _text_output to "과시꾼">>
					<</if>>
				<<else>>
