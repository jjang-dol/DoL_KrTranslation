:: Widgets Temperature Passout [widget]
/* This widget is run on its own after passout */
<<widget "passouttemperature">>
	<<cleareventpool>>
	<<outfitChecks>>
	<<set $passoutstat += 1>>
	<<set $passoutTimeStat to Time.date.timeStamp>>
	<<set $stress to Math.clamp($stress, 0, 8000)>>
	/* give pc some rest */
	<<set $_outside to $outside>>
	<<set $outside to 0>>
	<<pass 60>>
	<<set $outside to $_outside>>
	/* FROSTBITE */
	<<if _passout is "cold">>
		<<set Weather.bodyTemperature to Weather.tempSettings.minTemperature + 1.5>>
		<<if !["beach", "estate", "forest", "lake", "moor", "park", "sea", "tower", "wolf_cave"].includes($location)>>
			추위 때문에 당신은 기절한다.
			<br><br>
		<</if>>
		<<switch $location>>
			<<case "asylum">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Asylum]]>><</link>>
				<</addinlineevent>>
			<<case "beach">>
				<<= Weather.precipitation is "rain" ? "축축한 모래 위로 쓰러진다. 등에 비가 쏟아지는 가운데" : Weather.precipitation is "snow" ? "차가운 모래 위로 쓰러진다. 몸 위로 눈이 내리는 가운데" : "모래 위로 쓰러진다.">> 조금이나마 남은 체온을 지키려 몸을 둥글게 만다.
				<br><br>
				<<if ["rain", "snow"].includes(Weather.precipitation)>>
					<<= $worn.handheld.type.includes("rainproof") ? "우산으로 몸을 가리려" : "쏟아지는 " + Weather.precipitation + "【으로로】부터 몸을 보호하려">> 애쓰지만, 손가락은 추위로 감각이 사라져 버렸고, 팔은 축 늘어진다.
					<<silently>><<water>><</silently>>
					<br><br>
				<</if>>

				추위 때문에 당신은 기절한다.
				<br><br>

				<<if getRobinLocation() is "beach">>
					<<addinlineevent "beach" 1.25>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Beach Hypothermia Robin]]>><</link>>
					<</addinlineevent>>
				<</if>>

				<<addinlineevent "beach" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Beach Hypothermia]]>><</link>>
				<</addinlineevent>>

				<<if $fame.good gte 400 or $fame.social gte 400>>
					<<addinlineevent "fame" 0.2>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Fame]]>><</link>>
					<</addinlineevent>>
				<</if>>

				<<if dangerEvent() and !_fullyNaked>>
					<<addinlineevent "beach" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Beach Hypothermia Molest]]>><<set $molestationstart to 1>><</link>>
					<</addinlineevent>>
				<</if>>
			<<case "estate">>
				<<if !$estate>><<estate_init>><</if>> /* It's possible to trigger the $estate location passout on the link that unsets $estate */
				겨울 공기 속에서 입김이 하얗게 흩어진다. <<= Weather.precipitation is "snow" ? "때 묻지 않은 눈이 부드럽고 포근해 보인다" : "땅바닥이 괜히 편안해 보인다">>. 비틀거리며 몇 걸음 내딛다 차 옆에 주저앉아 눈을 감는다.
				<br><br>

				기절하기 직전, 당신은
				<<if $farm.aggro gte 60>>
					<<addinlineevent "remy" 1>>
						<span class="red">박차 소리가 다가오는 것을 듣는다.</span>
						<br><br>

						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Estate Remy Hot Cold]]>><</link>>
					<</addinlineevent>>
				<<elseif $wren_intro isnot undefined>>
					<<addinlineevent "wren" 1>>
						<span class="green">장화 소리가 다가오는 것을 듣는다.</span>
						<br><br>

						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Estate Wren Hot Cold]]>><<set $passoutReason to "hypothermia">><</link>>
					<</addinlineevent>>
				<<else>>
					<<addinlineevent "generic" 1>>
						누군가 다가오는 소리를 듣는다.
						<br><br>

						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Rescue]]>><</link>>
					<</addinlineevent>>
				<</if>>
			<<case "farm">>
				<<if $bus.includes("farm")>>/* If not the Underground Farm */
					<<addinlineevent "molest" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Molest]]>><<set $molestationstart to 1>><</link>>
					<</addinlineevent>>
				<<else>>
					<<addinlineevent "livestock" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Livestock Hot Cold]]>><<set $passoutReason to "hypothermia">><</link>>
					<</addinlineevent>>
				<</if>>
			<<case "forest">>
				울창한 숲을 헤치고 나아간다. 한 걸음 내디딜 때마다 가혹한 한기가 뼛속까지 스며들어 몸이 떨린다. <<if Weather.isFreezing>>매서운 공기 속에 입김이 흩어지고, <</if>>앞으로 나아가려 애쓸수록 심장이 거세게 뛴다. <<if Weather.isSnow>>발밑에서 눈이 바스락거린다.<</if>>
				<br><br>

				극도의 피로가 짓누르고, 시야에 어둠이 번지며 세상이 흐릿해진다. 한기와 피로에 압도당해, 당신은 숲 바닥에 쓰러진다. 의식이 멀어짐과 동시에 땅이 얼굴로 확 다가온다.
				<br><br>

				추위 때문에 당신은 기절한다.
				<br><br>

				<<if $forest lte 25 and !isGwylanAbsent() and C.npc.Gwylan.state isnot "scorned">>
					<<addinlineevent "gwylan" .6>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Gwylan Hot Cold]]>><<set $passoutReason to "hypothermia">><</link>>
					<</addinlineevent>>
				<</if>>

				<<addinlineevent "wolf" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Wolves Hot Cold]]>><<set $passoutReason to "hypothermia">><</link>>
				<</addinlineevent>>

				<<addinlineevent "rescue" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Rescue]]>><</link>>
				<</addinlineevent>>
			<<case "wolf_cave">>
				체온을 유지하려 필사적으로 노력하지만, 추위가 감당할 수 없을 정도로 심하다. 의식이 멀어짐과 동시에 땅이 얼굴로 확 다가온다.
				<br><br>

				<<addinlineevent "rescue" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Wolf Cave Hypothermia]]>><</link>>
				<</addinlineevent>>
			<<case "cabin">>
				<<addinlineevent "Eden" 2>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Eden Hot Cold]]>><<pass 60>><<set $passoutReason to "hypothermia">><</link>>
				<</addinlineevent>>
			<<case "tower">>
				<<addinlineevent "birdRescue" 1>>
					추위 때문에 당신은 기절한다.
					<br><br>

					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Bird Hypothermia]]>><</link>>
				<</addinlineevent>>
			<<case "moor">>
				<<if $moormove is "horse">>
					<<addinlineevent "moorHorse" 2>>
						추위 때문에 당신은 기절한다.
						<br><br>

						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Moor Horse]]>><</link>>
					<</addinlineevent>>
				<<else>>
					<<addinlineevent "birdRescue" 1.5>>
						<<if $syndromebird gte 1>>
							황야를 터덜터덜 걷는다. <<if Weather.temperature lte 4>>살을 에는 듯한 한기가 뼛속까지 파고들어 <</if>>몸이 주체할 수 없이 떨린다. 발을 떼는 것조차 버겁고, 시간이 흐를수록 몸은 점점 쇠약해져 움직임도 둔해진다.
							<br><br>

							<<= Weather.isSnow ? "눈 덮인" : "차가운">> 바닥에 쓰러지자, 팔다리가 무겁게 굳어 뜻대로 움직이지 않는다. 주변 세상이 어둠 속으로 소용돌이치고, 차가운 공기가 온몸을 완전히 감싼다.
							<br><br>

							추위 때문에 당신은 기절한다.
							<br><br>

							<<link [[모든 것이 어둠 속으로 사라진다...|Passout Bird Hypothermia]]>><</link>>
						<<else>>
							<<npc "Great Hawk">><<person1>>
							너무 약해져 더 이상 나아가지 못하고 <<= Weather.isSnow ? "눈 덮인 땅에" : "땅에">> 비틀거리며 쓰러진다. 입술은 <<= Weather.temperature lte 4 ? "살을 에는 듯한 차가운 공기 때문에" : "가쁜 숨 때문에">> 갈라졌지만, 간신히 쉰 목소리를 짜내 절박하게 도와달라 외친다.
							<br><br>

							그 비명에 누군가 응답한다. 한 줄기 <<hawkScreechDesc>>【이가】 공기를 가른다. <<hawkRescueApproachSentence>>
							<br><br>

							고개를 뒤로 젖히자, 당신을 향해 날아오는 거대한 그림자에 압도되어 입안이 더욱 바짝 마른다.
							<br><br>

							<<link [[다음|Bird Rescue No Syndrome]]>><</link>>
						<</if>>
					<</addinlineevent>>

					<<addinlineevent "rescue" 1>>
						추위 때문에 당신은 기절한다.
						<br><br>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Rescue]]>><</link>>
					<</addinlineevent>>
				<</if>>
			<<case "prison">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Prison 2]]>><</link>>
				<</addinlineevent>>
			<<case "lake">>
				시야가 흐려진다. 체온을 유지하기 위해 꽉 끌어안아 보지만, 아무 소용이 없다.
				<br><br>
				<<if $town_projects.diving gte 4 and (Time.schoolDay and Time.hour gte 16 and Time.hour lte 20 or !Time.schoolDay and Time.hour gte 6 and Time.hour lte 20)>>
					<<addinlineevent "winter" 0.75>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hot Cold Lake Office]]>><<set $passoutReason to "hypothermia">><</link>>
					<</addinlineevent>>
				<</if>>

				<<if !Time.schoolDay and ["snow", "rain"].includes(Weather.precipitation) and Time.dayState is "day">>
					<<addinlineevent "mason" 0.25>>
							<<link [[모든 것이 어둠 속으로 사라진다...|Passout Mason Hypothermia]]>><<set $phase to ["lakeunderwater", "lake_ruin", "lake_ruin_deep"].includes($bus) ? "underwater" : 1>><</link>>
					<</addinlineevent>>
				<</if>>

				<<addinlineevent "danger" 1.25>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Lake Gangbang]]>><</link>>
				<</addinlineevent>>
			<<case "school">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|School Passout]]>><<set $passoutReason to "hypothermia">><</link>>
				<</addinlineevent>>
			<<case "sea">>
				차가운 물이 당신의 마지막 체온마저 앗아간다. 더 이상 헤엄치기 힘들 만큼 팔다리가 무거워지고, 몸이 가라앉기 시작하며 당신은 기절한다.
				<br><br>

				<<addinlineevent "pirates" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Pirates Hot Cold]]>><<set $passoutReason to "hypothermia">><</link>>
				<</addinlineevent>>
			<<case "tentworld">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Tentacle World]]>><</link>>
				<</addinlineevent>>
			<<case "park">>
				당신은 앞으로 비틀거리다 차가운 바닥에 고꾸라진다. 너무 지쳐서 더 이상 나아갈 수 없다.
				<br><br>
				/* Park events needed - adding default ones now to prevent empty passages */
				<<if getRobinLocation() is "park" and !$daily.robin.passout>>
					<<addinlineevent "park" 1.25>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Robin Hypothermia Park]]>><</link>>
					<</addinlineevent>>
				<</if>>

				<<addinlineevent "rescue" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Rescue]]>><</link>>
				<</addinlineevent>>
			<<case "island">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Island Passout]]>><</link>>
				<</addinlineevent>>
			<<default>>
				/* Generic events */
				<<addinlineevent "ambulance" 0.1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Ambulance rescue]]>><<set $passoutReason to "hypothermia">><</link>>
				<</addinlineevent>>

				<<addinlineevent "molest" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Molest]]>><<set $molestationstart to 1>><</link>>
				<</addinlineevent>>

				<<addinlineevent "rescue" 1.1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Rescue]]>><</link>>
				<</addinlineevent>>

				<<if $fame.good gte 400 or $fame.social gte 400>>
					<<addinlineevent "fame" 0.2>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hypothermia Fame]]>><</link>>
					<</addinlineevent>>
				<</if>>

				<<if $location is "town" and $bus is "danube">>
					<<addinlineevent "danube" 1.5>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Danube Street]]>><<set $phase2 to _passout>><</link>>
					<</addinlineevent>>
				<</if>>

				<<if (($location is "town" and $bus is "high") or $location is "office" or $location is "avery_skyscraper") and $officejobintro is 1 and Time.hour gte 6 and Time.hour lte 21>>
					<<addinlineevent "office" 2>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Office]]>><<set $phase2 to _passout>><</link>>
					<</addinlineevent>>
				<</if>>
			<</switch>>
	/* HEATSTROKE */
	<<elseif _passout is "heat">>
		<<set Weather.bodyTemperature to Weather.tempSettings.maxTemperature - 1>>
		<<if !["beach", "estate", "forest", "lake", "moor", "sea", "wolf_cave"].includes($location)>>
			더위 때문에 당신은 기절한다.
			<br><br>
		<</if>>
		<<switch $location>>
			<<case "alley">>
				<<if Weather.temperature gte 27 and _top and !Time.schoolDay and $bullytimer gte $rng and C.npc.Whitney.init is 1 and !["dungeon", "pillory"].includes(C.npc.Whitney.state) and $daily.whitney.park is undefined>>
					<<addinlineevent "default" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Alley Heatstroke Whitney]]>><</link>>
					<</addinlineevent>>
				<</if>>

				<<if _underwear>>
					<<addinlineevent "icecube" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Ice Cube]]>><</link>>
					<</addinlineevent>>
				<</if>>

				<<if !_fullyNaked>>
					<<addinlineevent "strip" .5>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Strip]]>><<set $molestationstart to 1>><</link>>
					<</addinlineevent>>
				<</if>>

				<<addinlineevent "rescue" .5>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Rescue]]>><</link>>
				<</addinlineevent>>

				<<addinlineevent "kiss" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Kiss]]>><</link>>
				<</addinlineevent>>
			<<case "asylum">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Asylum]]>><</link>>
				<</addinlineevent>>
			<<case "beach" "seabeach">>
				<<if $location is "seabeach">>
					차가운 물 속에 있어도, 더위가 여전히 당신을 덮쳐왔다. 현기증이 일며 당신은 얕은 물 속에 무릎을 꿇고 쓰러진다. 몸이 지쳐버린 것을 느끼며 눈을 감는다.
				<<else>>
					가슴을 들썩이며 뜨거운 모래 위로 쓰러진다. 더위가 극심하여 시야가 어두워진다.
				<</if>>
				<br><br>
				<<addinlineevent "waves" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Beach Heatstroke]]>><</link>>
				<</addinlineevent>>

				<<if getRobinLocation() is "beach" and $location isnot "seabeach" and !$daily.robin.passout and $robin.timer.hurt lt 1>>
					<<addinlineevent "lemonade" 1.25>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Beach Heatstroke Lemonade]]>><</link>>
					<</addinlineevent>>
				<</if>>

				<<if dangerEvent() and !Weather.overcast>>
					<<addinlineevent "students" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Beach Heatstroke Students]]>><</link>>
					<</addinlineevent>>
					<<if !_fullyNaked and Weather.precipitation is "none">>
						<<addinlineevent "wetShirt" 1>>
							<<link [[모든 것이 어둠 속으로 사라진다...|Passout Beach Heatstroke Wet Shirt]]>><</link>>
						<</addinlineevent>>
					<</if>>
				<<else>>
					<<addinlineevent "rescue" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Beach Heatstroke Rescue]]>><</link>>
					<</addinlineevent>>
				<</if>>
			<<case "estate">>

				차들 지붕 위로 열기가 피어오르는 것이 보인다. 땀이 이마를 타고 흘러내려 눈을 찌른다. 당신은 비틀거리며 그늘로 향하다가 푹 쓰러진다.
				<br><br>

				기절하기 직전, 당신은
				<<if $farm.aggro gte 60>>
					<<addinlineevent "remy" 1>>
						<span class="red">박차 소리가 다가오는 것을 듣는다.</span>
						<br><br>

						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Estate Remy Hot Cold]]>><<estate_end>><</link>>
					<</addinlineevent>>
				<<elseif $wren_intro isnot undefined>>
					<<addinlineevent "wren" 1>>
						<span class="green">장화 소리가 다가오는 것을 듣는다.</span>
						<br><br>

						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Estate Wren Hot Cold]]>><<set $passoutReason to "hyperthermia">><</link>>
					<</addinlineevent>>
				<<else>>
					<<addinlineevent "generic" 1>>
						누군가 다가오는 소리를 듣는다.
						<br><br>

						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Rescue]]>><</link>>
					<</addinlineevent>>
				<</if>>
			<<case "farm">>
				<<if $bus.includes("farm")>>/* If not the Underground Farm */
					<<addinlineevent "generic" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Rescue]]>><</link>>
					<</addinlineevent>>
					<<if !_fullyNaked>>
						<<addinlineevent "strip" 1>>
							<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Strip]]>><<set $molestationstart to 1>><</link>>
						<</addinlineevent>>
					<</if>>
				<<else>>
					<<addinlineevent "livestock" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Livestock Hot Cold]]>><<set $passoutReason to "hyperthermia">><</link>>
					<</addinlineevent>>
				<</if>>
			<<case "forest">>
				울창한 숲을 헤치고 나아간다. 한 걸음 내디딜 때마다 지끈거리는 두통이 머리를 찌른다. <<if !Weather.overcast>>가혹한 햇빛이 머리 위 나뭇잎 사이를 뚫고 들어온다.<</if>> 이마에서는 땀이 뚝뚝 떨어지고, 우거진 잡목림을 밀고 나아가려 애쓸수록 심장이 미친 듯이 뛴다.
				<br><br>

				극도의 피로가 몸을 짓누르고, 시야에 어둠이 번지며 세상이 흐릿해진다. 더위와 피로를 이기지 못하고 숲 바닥에 쓰러진다. 의식이 멀어지는 순간, 땅이 얼굴 앞으로 확 다가온다.
				<br><br>

				더위 때문에 당신은 기절한다.
				<br><br>

				<<if $forest lte 25 and !isGwylanAbsent() and C.npc.Gwylan.state isnot "scorned">>
					<<addinlineevent "gwylan" .6>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Gwylan Hot Cold]]>><<set $passoutReason to "hyperthermia">><</link>>
					<</addinlineevent>>
				<</if>>

				<<addinlineevent "mud" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Mud]]>><</link>>
				<</addinlineevent>>

				<<addinlineevent "wolf" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Wolves Hot Cold]]>><<set $passoutReason to "hyperthermia">><</link>>
				<</addinlineevent>>

				<<addinlineevent "rescue" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Rescue]]>><</link>>
				<</addinlineevent>>
			<<case "wolf_cave">>
				이마에서 땀이 비 오듯 쏟아진다. 눈이 따갑지만 닦아낼 힘조차 없다. 더위가 극심하다. 비틀거리며 동굴 근처 그늘로 향하다가 푹 쓰러진다.
				<br><br>

				<<addinlineevent "rescue" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Wolf Cave Heatstroke]]>><</link>>
				<</addinlineevent>>
			<<case "lake">>
				열기가 밀려와 당신을 덮친다. 머리가 빙빙 돌고 시야가 흐려진다.
				<br><br>

				<<if $town_projects.diving gte 4 and (Time.schoolDay and Time.hour gte 16 and Time.hour lte 20 or !Time.schoolDay and Time.hour gte 6 and Time.hour lte 20)>>
					<<addinlineevent "winter" 0.75>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Hot Cold Lake Office]]>><<set $passoutReason to "hyperthermia">><</link>>
					<</addinlineevent>>
				<</if>>

				<<if !Time.schoolDay and ["snow", "rain"].includes(Weather.precipitation) and Time.dayState is "day">>
					<<addinlineevent "mason" 0.25>>
							<<link [[모든 것이 어둠 속으로 사라진다...|Passout Mason Hyperthermia]]>><<set $phase to ["lakeunderwater", "lake_ruin", "lake_ruin_deep"].includes($bus) ? "underwater" : 1>><</link>>
					<</addinlineevent>>
				<</if>>

				<<addinlineevent "mud" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Mud]]>><</link>>
				<</addinlineevent>>
			<<case "cabin">>
				<<addinlineevent "Eden" 2>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Eden Hot Cold]]>><<pass 60>><<set $passoutReason to "hyperthermia">><</link>>
				<</addinlineevent>>
			<<case "tower">>
				<<addinlineevent "birdRescue" 1.5>>
					더위 때문에 당신은 기절한다.
					<br><br>

					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Bird Heatstroke]]>><</link>>
				<</addinlineevent>>
			<<case "moor">>
				<<if $moormove is "horse">>
					<<addinlineevent "moorHorse" 2>>
						더위 때문에 당신은 기절한다.
						<br><br>

						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Moor Horse]]>><</link>>
					<</addinlineevent>>
				<<else>>
					<<addinlineevent "birdRescue" 1.5>>
						<<if $syndromebird gte 1>>
							<<npc "Great Hawk">><<person1>>
							가혹한 태양이 내리쬐는 황야를 무거운 발걸음으로 헤쳐 나간다. 두통으로 머리가 터질 듯 지끈거리고, 위장이 요동치며 메스꺼움이 밀려온다. 주체할 수 없이 맥박이 뛰는 가운데 마침내 더위에 굴복한다.
							<br><br>

							조금이라도 안정을 찾으려 발버둥 치며 바짝 마른 대지를 움켜쥐고 무릎을 꿇는다. 땅이 아득히 멀게 느껴지고, 세상이 빙빙 돌며 시야가 어두워진다.
							<br><br>

							더위 때문에 당신은 기절한다.
							<br><br>

							<<link [[모든 것이 어둠 속으로 사라진다...|Passout Bird Heatstroke]]>><</link>>
						<<else>>
							<<npc "Great Hawk">><<person1>>
							너무 약해져 더 이상 나아가지 못하고 땅에 비틀거리며 쓰러진다. 입술은 열기로 바짝 말라붙었지만, 간신히 쉰 목소리를 짜내 절박하게 도와달라 외친다.
							<br><br>

							그 비명에 누군가 응답한다. 한 줄기 <<hawkScreechDesc>>【이가】 공기를 가른다. <<hawkRescueApproachSentence>>
							<br><br>

							고개를 뒤로 젖히자, 당신을 향해 날아오는 거대한 그림자에 압도되어 입안이 더욱 바짝 마른다.
							<br><br>
							<<link [[다음|Bird Rescue No Syndrome]]>><</link>>
						<</if>>
					<</addinlineevent>>

					<<addinlineevent "rescue" 1>>
						더위 때문에 당신은 기절한다.
						<br><br>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Rescue]]>><</link>>
					<</addinlineevent>>
				<</if>>
			<<case "prison">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Prison 2]]>><</link>>
				<</addinlineevent>>
			<<case "sea">>
				주변이 온통 물임에도 더위가 감당할 수 없을 정도로 심하다. 더 이상 헤엄치기 힘들 만큼 팔다리가 무거워지고, 몸이 가라앉기 시작하며 당신은 기절한다.
				<br><br>

				<<addinlineevent "pirates" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Pirates Hot Cold]]>><<set $passoutReason to "hyperthermia">><</link>>
				<</addinlineevent>>
			<<case "school">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|School Passout]]>><<set $passoutReason to "hyperthermia">><</link>>
				<</addinlineevent>>
			<<case "tentworld">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Tentacle World]]>><</link>>
				<</addinlineevent>>
			<<case "park">>
				<<if isInPark("whitney")>>
					<<addinlineevent "default" 2>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Park Heatstroke Whitney]]>><</link>>
					<</addinlineevent>>
				<</if>>

				<<if $wolfgirl gte 6 or $cat gte 6>>
					<<addinlineevent "animals" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Animals]]>><</link>>
					<</addinlineevent>>
				<</if>>

				<<addinlineevent "delinquents" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Delinquents]]>><</link>>
				<</addinlineevent>>

				<<addinlineevent "flash" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Flash]]>><</link>>
				<</addinlineevent>>
			<<case "island">>
				<<addinlineevent "default" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Island Passout]]>><</link>>
				<</addinlineevent>>
			<<default>>
				/* Generic events */
				<<addinlineevent "ambulance" 0.1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Ambulance rescue]]>><<set $passoutReason to "hyperthermia">><</link>>
				<</addinlineevent>>

				<<if !_fullyNaked>>
					<<addinlineevent "strip" 1>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Strip]]>><<set $molestationstart to 1>><</link>>
					<</addinlineevent>>
				<</if>>

				<<addinlineevent "kiss" 1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Kiss]]>><</link>>
				<</addinlineevent>>

				<<addinlineevent "rescue" 1.1>>
					<<link [[모든 것이 어둠 속으로 사라진다...|Passout Heatstroke Rescue]]>><</link>>
				<</addinlineevent>>

				<<if $location is "town" and $bus is "danube">>
					<<addinlineevent "danube" 1.5>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Danube Street]]>><<set $phase2 to _passout>><</link>>
					<</addinlineevent>>
				<</if>>

				<<if (($location is "town" and $bus is "high") or $location is "office" or $location is "avery_skyscraper") and $officejobintro is 1 and Time.hour gte 6 and Time.hour lte 21>>
					<<addinlineevent "office" 2>>
						<<link [[모든 것이 어둠 속으로 사라진다...|Passout Office]]>><<set $phase2 to _passout>><</link>>
					<</addinlineevent>>
				<</if>>
		<</switch>>
	<</if>>
	<<runeventpool>>
<</widget>>

/* Determines clothes player may be given after passing out of cold */
<<widget "hypothermiaClothes">>
	<<outfitChecks>><<set _wet to $upperwetstage gte 3 or $lowerwetstage gte 3 or $underupperwetstage gte 3 or $underlowerwetstage gte 3>>
	<<set _gender to $player.gender_appearance>>
	<<set _clothes to []>>
	<<set _warmClothes to []>>

	<<if _fullyNaked>>
		<<set _warmClothes to "따뜻한 옷">>
	<<elseif _wet>>
		<<dry_full>><<upperstrip>><<lowerstrip>>
		<<set _warmClothes to "마른 옷">>
	<<elseif !_bottom>>
		<<set _warmClothes to "바지">>
	<<elseif $debug is 1 and $worn.over_upper.name is "naked" and $rng gte 46>>
		<<set _warmClothes to "재킷">>
	<<elseif $worn.upper.warmth lt 6>>
		<<set _warmClothes to _shirtless ? "셔츠" : "더 따뜻한 옷">>
	<<elseif !$worn.neck.cursed>>
		<<set _warmClothes to "목도리">>
	<<elseif $worn.head.warmth lt 3>>
		<<set _warmClothes to "모자">>
	<</if>>

	<<if $debug is 1 and $worn.over_upper.name is "naked" and $rng gt 100>>
		/* outerwearToDo: Give players a jacket that's suitably warm. Not the froggy coat. Rng to allow for the possibility that they'll get another article of clothing instead -- rng should normally be gte 45, I just wanted to make this impossible to get. */
		<<set $_slot to "over_upper">>
		<<set $_jacket to ["froggy coat"]>>
		<<overupperwear $_jacket.random()>>
	<<elseif $worn.upper.warmth lt 6>>
		<<set $_slot to "upper">>
		<<set $_upper to ["puffer jacket", "turtleneck jumper", "cable knit turtleneck", "ghost jumper"]>>
		<<if $player.gender_appearance is "m" or $settings.forcedCrossdressingEnabled>>
			<<set $_upper.push("punk leather jacket", "leather jacket", "letterman jacket")>>
		<</if>>
		<<if $player.gender_appearance is "f" or $settings.forcedCrossdressingEnabled>>
			<<set $_upper.push("heart jumper", "girl's sweater")>>
		<</if>>
		<<set $_item to $_upper.random()>>
		<<upperstrip>>
		<<switch $_item>>
			<<case "ghost jumper">><<upperwear $_item "white" "neon blue">>
			<<case "heart jumper">><<upperwear $_item "lilac" "pink">>
			<<case "skull jumper">><<upperwear $_item "black" "red">>
			<<default>><<upperwear $_item>>
		<</switch>>
		<<set _crossdress to ($worn.upper.gender is "f" and $player.gender_appearance is "m") or ($worn.upper.gender is "m" and $player.gender_appearance is "f")>>
	<<elseif !$worn.neck.cursed>>
		<<set $_slot to "neck">>
		<<set $_item to "scarf">>
		<<neckwear $_item>>
	<<elseif $worn.head.warmth lt 3>>
		<<set _costume to $christmas is 1 or $halloween is 1>>
		<<set $_slot to "head">>
		<<set $_item to $christmas is 1 ? "christmas hat" : $halloween is 1 ? "bat beanie" : "beanie">>
		<<headwear $_item>>
	<</if>>
	<<set _text_output to $worn[$_slot].name >>
	<<set _clothes.push(_text_output)>>

	<<outfitChecks>>
	<<if _bottomExposed>>
		<<set $_slot to "lower">>
		<<set $_item to either("khakis", "trousers", "jeans", "sweatpants")>>
		<<lowerwear $_item>>
		<<set _text_output to $worn[$_slot].name >>
		<<set _clothes.push(_text_output)>>
	<</if>>
<</widget>>

/*
To get the previous major area passage, use: $safePassage (for links in the last passage, unless we want to link the player elsewhere)
*/

/* Generic passouts */

:: Passout Hypothermia Molest
<<if $molestationstart is 1>>
	눈을 뜨자 <<generate1>><<person1>><<person>> 한 명이 당신 위에 올라타 있다. "이봐, 자기," <<he>>【이가】 속삭인다. "엄청 떨고 있길래, 몸 좀 데워주려고. 체온을 올릴 좋은 방법이 있거든..." <<He>>【은는】 당신을 음흉하게 내려다보며, 당신의 몸에 외설적으로 몸을 비벼댄다.
	<br><br>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<maninit>>
	<<set $enemyanger to 0>>
	<<set $encounterDialogue to "cold">>
<</if>>

<<effects>>
<<effectsman>><<man>>
<<stateman>>
<br><br>
<<actionsman>>
<<if _combatend>>
	<span id="next"><<link [[다음|Passout Hypothermia Molest Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Passout Hypothermia Molest]]>><</link>></span><<nexttext>>
<</if>>

:: Passout Hypothermia Molest Finish
<<effects>>
<<set Weather.bodyTemperature++>>
<<if $enemyarousal gte $enemyarousalmax>>
	<<ejaculation>>
	<<person>>【은는】 만족스러운 신음과 함께 당신에게서 몸을 떼며, 히죽 웃는다. "자, 이제 따뜻해졌네. 나 같은 선한 사마리아인이 도와줘서 다행인 줄 알아." <<He>>【은는】 낄낄거리며 자리를 뜨기 전, 당신의 뺨을 거만하게 툭툭 친다. <<tearful>> 당신은 일어서서 손을 비빈다. 이가 딱딱 부딪힌다.

	<<endcombat>>
	<<clotheson>>
<<elseif $enemyhealth lte 0>>
	당신이 마지막으로 <<= $submissive lte 850 ? "사납게" : "필사적으로">> 밀쳐내자, <<person>>【은는】 끙 소리를 내며 밀려난다. "이런 씨발 <<bitch>>!" 당신이 허둥지둥 도망치자 <<he>>【이가】 뒤에서 소리친다. "몸 데워주는 게 싫었으면, 그딴 식으로 돌아다니지 말았어야지!" <<tearful>> 당신은 <<him>>에게서 전속력으로 도망친다. 적어도 운동 덕분에 피가 돌기 시작했고, 추위도 잠시 잊을 수 있었다. <<athletics 1>>
	<br><br>
	<<clotheson>>
	<<endcombat>>
<</if>>

<<link [[다음|$safePassage]]>><<endevent>><<set $eventskip to 1>><</link>>

/* Generic heatstroke passout: dangerous */

:: Passout Heatstroke Strip
<<if $molestationstart is 1>>
	눈을 뜨자 <<generate1>><<person1>><<person>> 한 명이 당신 위에 올라타 있다. "이봐, 섹시한데," <<he>>【이가】 나른하게 말한다. "열사병에 걸렸나 보네? 내가 좀 도와줄게." <<He>>【은는】 당신의 옷을 잡아당기기 시작한다.
	<br><br>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<molested>>
	<<set $enemyno to 1>><<set $enemynomax to 1>>
	<<maninit>>
	<<npcstripall>>
	<<npcidlegenitals>>
	<<set $encounterDialogue to "hotStrip">>
<</if>>

<<effects>>
<<effectsman>><<man>>
<br><br>
<<stateman>>
<<actionsman>>

<<outfitChecks>>
<<if _fullyNaked or $enemyarousal gte $enemyarousalmax or $enemyhealth lte 0>>
	<span id="next"><<link [[다음|Passout Heatstroke Strip Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Passout Heatstroke Strip]]>><</link>></span><<nexttext>>
<</if>>

:: Passout Heatstroke Strip Finish
<<effects>>
<<outfitChecks>>
<<set Weather.bodyTemperature-->>
<<if _fullyNaked>>
	마지막으로 한 번 잡아당기자, <<person>>【이가】 당신의 마지막 옷을 찢어버린다. <<He>>【은는】 당신의 나체를 위아래로 훑어본다. "좋네," <<he>>【이가】 감탄하며 말한다. <<He>>【은는】 당신의 옷을 팔에 끼고 일어선다. "자, 이제 아주 시원할 거야."
	<br><br>

	<<tearful>> 당신은 여전히 몸이 약하고 열이 나는 상태에서 힘겹게 몸을 일으킨다. 당신은 <<him>>에게 <<= $submissive lte 850 ? "불쾌한" : "애원하는">> 눈빛을 보낸다.
	<br><br>

