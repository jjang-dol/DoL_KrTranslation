			<<elseif !$kylarSeen.includes("sydneyWriting") and _args[0].lewd is 1>>
				<<He>>【은는】 눈살을 찌푸리며 그걸 다시 읽더니, 입술을 일그러뜨린다. "<<nnpc_He "Sydney">>... <<nnpc_him "Sydney">>【은는】 잊어버려."
				<<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Kylar rage 1>><<set $kylarSeen.pushUnique("sydneyWriting")>>
			<<elseif _kylarStatus.includes("Rage")>>
				<<He>>【은는】 으르렁거린다. "시드니는 나만큼 널 알지 못한다고!"
				<<set $enemyanger += 30>><<set $enemytrust -= 30>><<npcincr Kylar rage 3>>
			<<else>>
				<<He>>【은는】 눈살을 찌푸린다. "네가 <<nnpc_him "Sydney">>【와과】 가깝게 지내는 게 마음에 안 들어."
				<<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Kylar rage 1>>
			<</if>>
		<<case "Black Wolf" "Great Hawk">>
			<<His>> 눈이 가늘어진다. "나도 짐승처럼 굴 수 있어. 지켜봐!"
			<<set $enemyanger += 30>><<set $enemytrust -= 30>><<npcincr Kylar rage 3>>
		<<case "Eden" "Avery" "Alex" "Gwylan">>
			<<if _kylarStatus.includes("Rage")>>
				<<He>>【은는】 으르렁거린다. "그게 누구든 쓰레기 같은 새끼들이야!"
			<<else>>
				<<He>>【은는】 으르렁거린다. "다른 놈들은 다 필요 없어! 너에겐 오직 나만 있으면 돼!"
			<</if>>
			<<set $enemyanger += 30>><<set $enemytrust -= 30>><<npcincr Kylar rage 3>>
		<<case "prostitution" "rape" "exhibitionism" "sex">>
			<<He>>【은는】 얼굴을 찡그린다.
			<<unset _silent>>
			<<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Kylar rage 1>>
		<<case "pregnancy">>
			/*ToDo: Pregnancy, write once Kylar's reaction to/thoughts on pregnancy is better understood.
			May differ based on gender, jealousy and whether or not Kylar has impregnated the PC in the past.*/
		<<case "combat" "violence" "criminal">>
			<<His>> 눈이 휘둥그레지지만, 그것에 대해 아무 말도 하지 않는다.
			<<unset _silent>>
		<<default>>
			<<if $skin[_args[0]].lewd is 1>>
				<<He>>【은는】 얼굴을 찌푸린다.
				<<unset _silent>>
				<<set $enemyanger += 10>><<set $enemytrust -= 10>><<npcincr Kylar rage 1>>
			<<else>>
				/*Do nothing.*/
				<<unset _silent>>
			<</if>>
	<</switch>>
<</widget>>

<<widget "bodypart_admire_avery">>
	/* Bodywriting reactions */
	<<set _bodypartID to _args[0]>>
	<<set _bodywritingPart to $skin[_bodypartID]>>
	/* General Avery lines */
	<<if _bodywritingPart.special is "Avery">>
		<<if random(1)>>
			<<if $averyragerevealed is 1 and C.npc.Avery.rage gte 60>>
				<<if C.npc.Avery.dom gte 60>>
					"드디어네. 이제야 네가 누구 소유인지 깨달았나 보구나." <<He>>【이가】 비웃으며 조롱 섞인 웃음을 터뜨린다. "하지만 속죄라도 할 셈이라면, 고작 이 정도보다 더 큰 걸 내놓아야 할 거야."
				<<else>>
					<<He>>【이가】 비웃으며 조롱 섞인 웃음을 터뜨린다. "이게 다 뭐야? 몸에 내 거라는 낙인을 찍는다고 내가 널 용서해 줄 것 같았어?"
				<</if>>
				목소리에 깃든 경멸에도 불구하고, <<his>> 시선은 흥미가 동한 듯 휘갈겨진 글씨를 자꾸만 훑는다.
				<<if !$averyBodyWritingSeen>><<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>><<larage>><</if>>
			<<elseif $averyragerevealed is 1 and C.npc.Avery.rage gte 20>>
				"아..." <<He>>【이가】 <<= either("냉소를 짓는다", C.npc.Avery.dom gte 60 ? "비웃는다" : "미소를 짓는다")>>.
				<<if C.npc.Avery.dom gte 60>>
					"네가 누구 소유인지 똑똑히 알고 있다니 보기 좋네..."
				<<else>>
					"놀랄 것도 없지. 내 관심을 독차지하고 있다고 과시하고 싶어 하는 건 당연하니까... 내 용서까지 바라는 모양이지?"
					<<if !$averyBodyWritingSeen>><<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>><<larage>><</if>>
				<</if>>
			<<else>> /* Low rage + rage concealed */
				"아..." <<He>>【이가】 <<= either("냉소를 짓는다","미소를 짓는다")>>.
				<<if C.npc.Avery.dom gte 60>>
					"사랑스럽기도 하지. 자기가 누구 소유인지 아주 잘 알고 있잖아."
				<<else>>
					"사랑스럽기도 하지, <<pcpetname "Avery">>. 놀랄 것도 없지만. 자기가 내 관심을 받고 있다는 걸 자랑하고 싶어 하는 건 당연하니까..."
				<</if>>
			<</if>>
		<<else>>
			<<switch _bodywritingPart.writing>>
				<<case "Avery's Trophy">>
					<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
						<<He>>【이가】 코웃음을 친다. "착각하지 마."
						<<if !$averyBodyWritingSeen>><<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Avery rage 1>><</if>>
					<<else>>
						<<print either(
							`<<He>>【이가】 한쪽 눈썹을 치켜올린다. "계속해서 이렇게 완벽하게 굴어주는 게 좋을 거야."`,
							`<<He>>【이가】 미소를 짓는다. "널 자랑하고 다니지 않는다면 아쉬운 일이지."`
						)>>
						<<if !$averyBodyWritingSeen>><<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>><</if>>
					<</if>>
				<<case "Uptown Boy" "Uptown Girl">>
					<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
						<<He>>【이가】 코웃음을 친다. "너 같은 부랑자가? 웃기지도 않는군."
						<<if !$averyBodyWritingSeen>><<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Avery rage 1>><</if>>
					<<else>>
						<<He>>【이가】 웃음을 터뜨린다. "언젠가는 정말 그렇게 될지도 모르지."
						<<if !$averyBodyWritingSeen>><<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>><</if>>
					<</if>>
				<<case "Avery's Monopoly">>
					<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
						<<He>>【이가】 비웃는다. "넌 자회사 정도에 불과해."
						<<if !$averyBodyWritingSeen>><<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Avery rage 1>><</if>>
					<<else>>
						<<print either(
							`<<He>>【이가】 웃음을 터뜨린다. "조만간 그 음란한 주사위 놀이라도 한판 해야겠어."`,
							`<<He>>【이가】 웃음을 터뜨린다. "다음엔 뭐지? 단독 주주라도 되겠다고 할 셈인가?"`
						)>><<if !$averyBodyWritingSeen>><<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>><</if>>
					<</if>>
				<<case "Endearing">>
					<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
						<<He>>【이가】 인상을 찌푸린다. "네 생각만큼 귀엽진 않아."
						<<if !$averyBodyWritingSeen>><<set $enemyanger += 20>><<set $enemytrust -= 20>><<npcincr Avery rage 1>><</if>>
					<<else>>
						<<His>> 눈빛이 부드러워진다. "정말 사랑스러워, 자기야."
						<<if !$averyBodyWritingSeen>><<set $enemyanger -= 10>><<set $enemytrust += 10>><<npcincr Avery rage -1>><</if>>
					<</if>>
				<<default>>
					<<He>>【이가】 한쪽 눈썹을 치켜올린다.
			<</switch>>
		<</if>>
	<<elseif ["Kylar", "Robin", "Eden", "Alex", "Black Wolf", "Great Hawk", "Sydney", "Gwylan"].includes(_bodywritingPart.special)>>
	"이게 뭐지?" <<He>>【은는】
		<<if $averyragerevealed is 1 and C.npc.Avery.rage gte 60>>
			인상을 찌푸린다. "당장 지워, <<girl>>. 다른 놈들에게 헛바람 넣는 꼴은 못 봐."
		<<elseif $averyragerevealed is 1>>
			인상을 찌푸린다. "당장 지워, <<girl>>. 남들 눈에 띄게 두고 싶진 않겠지?"
		<<else>>
			눈살을 찌푸린다. "여기서 볼일 끝나면 지우도록 해."
		<</if>>
	<<elseif _bodywritingPart.special is "prostitution">>
		<<if $avery_mansion>>
			<<if $averyragerevealed is 1 and C.npc.Avery.rage gte 60>>
				"여전히 싸구려 창녀처럼 굴어대는 족속한테 내 재산을 낭비하고 있었다니..." <<He>>【이가】 인상을 찌푸린다. "끝나면 그 더러운 것부터 닦아내."
			<<elseif $averyragerevealed is 1>>
				"넌 온전히 내 소유야," <<He>>【이가】 낮게 으르렁거린다. "나중에 깨끗이 닦아내. 이 저택에서 네 위치가 뭔지 생각하라고."
			<<else>>
				<<He>>【이가】 눈살을 찌푸린다. "보기 흉하잖아. 넌 이제 밑바닥 길거리 출신이 아니야, 기억 안 나? 착하게 굴고, 끝나면 지우도록 해."
			<</if>>
		<<else>> /* PC not living at Avery's mansion */
			<<if $averyragerevealed is 1 and C.npc.Avery.rage gte 60>>
				"자기가 싸구려 창녀라고 광고하지 못해 안달 난 인간이랑 함께 있는 모습을 남들에게 보였다니..." <<He>>【이가】 인상을 찌푸린다. "끝나면 그 더러운 것부터 박박 문질러 지워. 두 번 다시 바보 꼴이 되진 않을 거니까."
			<<elseif $averyragerevealed is 1>>
				<<He>>【이가】 노려본다. "내 곁에 두는 인간에게는 그에 걸맞은 품격을 바라는 법이야. 끝나면 지워. 사람들이 헛소문 내는 건 질색이니까."
			<<else>>
				<<He>>【이가】 눈살을 찌푸린다. "내가 이런 천박한 무리와 어울려 다닌다고 사람들이 생각하게 둘 순 없잖아, 그렇지? 착하게 굴고, 나중에 깨끗이 지워."
			<</if>>
		<</if>>
	<<elseif _bodywritingPart.special is "sex">>
		<<if $averyragerevealed is 1 and C.npc.Avery.rage gte 60>>
			"애정에 굶주린 음탕한 년 행세를 그렇게 하고 싶다면, 딱 그 수준에 맞춰 다뤄주지. 하지만 내가 널 다 쓰고 난 뒤에는 당장 지워."
		<<elseif $averyragerevealed is 1>>
			"관심을 끌고 싶었던 거야, <<pcpetname "Avery">>? 감당할 수 없을 만큼 충분히 줄 테니까, 다른 놈 앞에서는 절대 이런 모습 보이지 마."
		<<else>>
			"몸에 그런 음란한 약속을 적어 두다니? 다른 사람 눈에 띄지 않는 한, 글자 하나하나 빠짐없이 전부 지키게 만들어 줄게."
		<</if>>
	<<elseif _bodywritingPart.special is "exhibitionism">>
		<<if C.npc.Avery.rage gte 60>>
			"파렴치하고 음탕한 년이라고 제 몸에 낙인까지 찍어댈 정도니, 관중들 앞에서 그대로 엎어놓고 박아주는 게 낫겠군. 한 번만 더 내 거슬리게 굴어봐, 모두가 보는 앞에서 네 분수를 똑똑히 새겨줄 테니까."
		<<elseif C.npc.Avery.rage gte 20>>
			"네가 얼마나 수치심도 모르는 망나니인지 온 세상에 보여주고 싶어? 계속 기어올라 봐, 다음 가르침은 아주 공개적인 자리에서 내려줄 테니까."
		<<else>>
			"이거 부탁하는 건가, <<pcpetname "Avery">>? 남들의 엿보는 시선이 그렇게 간절하다면, 모두가 널 똑똑히 구경할 수 있게 해줄 방법은 얼마든지 있어."
		<</if>>
	<<elseif _bodywritingPart.special is "violence">>
		<<if C.npc.Avery.rage gte 60>>
			<<He>>【이가】 싸늘하게 비웃는다. "그 둔한 머리통에는 고통만이 유일하게 먹히는 언어라면, 오직 고통만을 맛보게 해 주지."
		<<elseif C.npc.Avery.rage gte 20>>
			<<He>>【이가】 헛웃음을 짓는다. "네 그 건방진 태도가 그저 내 손길을 타려고 벌인 수작인 걸 진작 알았어야 했는데. 기꺼이 상대해 주지."
		<<else>>
			<<He>>【이가】 은근한 미소를 짓는다. "난 자길 어르고 달래주는 쪽이 훨씬 좋은데, <<pcpetname "Avery">>, 그렇게까지 공손히 부탁한다면야..."
		<</if>>
	<<elseif _bodywritingPart.special is "criminal">>
		<<if $averyCrimeTracker gte 2000>>
			<<He>>【이가】 눈살을 찌푸린다. "이게 다 뭐야? 이미 그 <<= $averyragerevealed gte 1 and C.npc.Avery.rage gte 40 ? "짓거리" : "허튼짓">> 때문에 악명이 자자한 판에, 이젠 남들 다 보라고 대놓고 광고까지 하고 다니는 거야?"
			<<if !$averyBodyWritingSeen>><<set $enemyanger += 30>><<set $enemytrust -= 30>><<npcincr Avery rage 1>><<garage>><</if>>
		<<elseif C.npc.Avery.rage gte 60>>
			<<He>>【이가】 으르렁거린다. "몸에 그따위 낙인을 찍고 다니는 꼴을 보니, 내 손으로 직접 경찰서에 처넣지 않은 걸 다행으로 알아야겠어!"
		<<elseif C.npc.Avery.rage gte 20>>
			"신상에 이롭길 바란다면 내 눈에 띄는 곳에 손을 가지런히 두고 있는 게 좋을 거다."
		<<else>>
			<<print either(
				`<<He>>【이가】 으르렁거린다. "스스로를 그따위로 광고하고 다니다니, 내가 당장 손봐주지 않은 걸 다행으로 알아."`,
				`<<He>>【이가】 한쪽 눈썹을 치켜올린다. "내 물건을 조심하라는 신호인가? 훔칠 생각 하지 않아도 널 위해 얼마든지 줄 수 있단다, <<pcpetname "Avery">>."`
			)>>
		<</if>>
	<<elseif _bodywritingPart.special is "combat">>
		<<if C.npc.Avery.rage gte 60>>
			<<He>>【이가】 으르렁거린다. "싸움을 그렇게 원한다면, 어디 실컷 상대해 주지!"
		<<elseif C.npc.Avery.rage gte 20>>
			"끝나면 깨끗이 문질러 지워."
		<<else>>
			<<He>>【이가】 눈살을 찌푸린다. "볼일 끝나면 지우도록 해. 남들이 <<= $averyragerevealed gte 1 ? "내가 양아치 녀석과 어울려 다닌다고" : "네가 양아치라고">> 생각하게 둘 순 없잖아, 응?"
		<</if>>
	<<elseif _bodywritingPart.special is "rape">>
		<<if C.npc.Avery.rage gte 60>>
			<<He>>【이가】 으르렁거린다. "어딘가 단단히 비틀려 있는 줄은 알았지. 겨우 이것 때문에 나를 그렇게 도발했던 거냐, 역겨운 <<= either(`<<bitch>>`, `<<slut>>`, `창녀`, `걸레`)>> 같으니?"
		<<elseif C.npc.Avery.rage gte 20>>
			"그 역겹고 타락한 성벽을 이런 식으로 광고하고 싶었나 보지?", <<He>>【이가】 쏘아붙인다.
		<<else>>
			<<He>>【이가】 눈살을 찌푸린다. "자존심 좀 가져, <<girl>>. 다른 사람들에게 오해를 사고 싶진 않잖아. 볼일 끝나면 지우렴."
		<</if>>
	<<elseif _bodywritingPart.special is "bestiality">>
		<<if C.npc.Avery.rage gte 60>>
			<<He>>【이가】 비웃는다. "버릇을 가르치기 위해 널 개집에 하룻밤 처넣지 않은 이유가 뭔지 이따금 스스로에게 묻곤 하지."
		<<elseif C.npc.Avery.rage gte 20>>
			<<He>>【이가】 곱씹듯 읊조린다. "네가 이렇게 고집을 부리는 걸 보면, 목줄이라도 채워서 끌고 다녀야 할지도 모르겠군."
		<<else>>
			<<He>>【이가】 한쪽 눈썹을 치켜올린다. "자식 취향 한번 참 의심스럽네, <<pcpetname "Avery">>. 하지만 짐승처럼 다뤄지고 싶다면, 일단 그걸 지우렴. 목줄은 내 손으로 직접 채워줄 테니까."
		<</if>>
	<<else>>
		<<bodypart_admire_generic _bodypartID>>
	<</if>> <<if !$averyBodyWritingSeen>><<set $averyBodyWritingSeen to true>><</if>>
<</widget>>

<<widget "bodypart_admire_named">>
	<<switch $npc[$npcrow.indexOf(_n)]>>
		<<case "Kylar">>
			<<bodypart_admire_kylar _args[0]>>
			<<set _admireNothing to true>>
		<<case "Robin">>
			<<switch $skin[_args[0]].special>>
				<<case "Robin">>
					<<switch $skin[_args[0]].writing>>
						<<case "Robin's Protector">>
							<<if $NPCName[_n].trauma gte 10>>
								<<He>>【은는】 움찔한다.
								<<npcincr Robin dom -1>>
							<<else>>
								<<He>>【은는】 씩 웃는다.
								<<set _text_output to "당신은 정말 날 안전하게 지켜줘!">>
								<<npcincr Robin love 1>>
							<</if>>
						<<case "Robin & I">>
							<<if random(1)>>
								<<He>>【이가】 당신을 부드러운 눈빛으로 바라본다.
								<<set _text_output to "네가 날 선택했다는 게 아직도 놀라워,">>
							<<else>>
								<<He>>의 눈이 당신과 마주친다.
								<<set _text_output to "다른 건 바라지도 않아... 알고 있지?">>
							<</if>>
							<<npcincr Robin love 1>><<npcincr Robin dom 1>>
						<<case "The Orphan Lover">>
							<<He>>【은는】 미소 짓는다.
							<<if random(1)>>
								<<set _text_output to "정말 날 사랑해?">>
							<<else>>
								<<if $NPCName[_n].dom gte 20>>
									<<set _text_output to "널 가져서 정말 기뻐.">>
								<<else>>
									<<set _text_output to "널 가진 난 정말 운이 좋아.">>
								<</if>>
							<</if>>
							<<npcincr Robin love 1>><<npcincr Robin dom 1>>
						<<case "Robin's Boyfriend" "Robin's Girlfriend">>
							<<He>>【은는】 키득거린다.
							<<set _text_output to "우리가 함께라 너무 기뻐!">>
							<<npcincr Robin love 1>><<npcincr Robin dom 1>>
						<<default>>
							<<He>>【은는】 미소 짓는다.
							<<npcincr Robin love 1>>
					<</switch>>
				<<default>>
					/*Do nothing.*/
					<<set _admireNothing to true>>
			<</switch>>
		<<case "Eden">>
			<<switch $skin[_args[0]].special>>
				<<case "Eden">>
					<<switch $skin[_args[0]].writing>>
						<<case "Eden's Companion">>
							<<if random(1)>>
								<<set _text_output to "맞아. 넌 내 거야, 내 <<wife>>. 절대 잊지 마.">>
							<<else>>
								<<set _text_output to "네가 누구 소유인지 알려주는 아주 좋은 표식이군.">>
							<</if>>
						<<case "Hunter and Prey">>
							<<He>>【은는】 미소 짓는다.
							<<if random(1)>>
								<<set _text_output to "쫓기길 바라는 거야, 그런 거지?">>
							<<else>>
								<<set _text_output to "사냥감 취급당하는 걸 즐기는 거야, 그런 거지?">>
							<</if>>
							<<npcincr Eden lust 1>>
						<<case "It's Lonely in the Woods">>
							<<His>> 눈빛이 부드러워진다.
							<<set _text_output to "너 같은 <<girl>>【이가】 곁에 있으니 훨씬 좋네.">>
						<<case "Something is Hunting You">>
							<<He>>【이가】 한쪽 눈썹을 치켜올린다.
							<<set _text_output to "그런 게 좋아? 사냥당하는 게?">>
							<<npcincr Eden lust 1>>
						<<default>>
							<<He>>【은는】 낮게 웃는다.
					<</switch>>
					<<set $enemyanger -= 10>><<set $enemytrust += 10>>
				<<case "Black Wolf">>
					<<He>>【은는】 험악한 표정을 짓는다.
					<<if random(1)>>
						<<set _text_output to "네가 누구 애완동물이라 생각해?">>
					<<else>>
						<<set _text_output to "그럼 짐승처럼 대해줘야겠군.">>
					<</if>>
					<<set $enemyanger += 20>><<set $enemytrust -= 20>>
				<<case "Gwylan">>
					<<He>>【은는】 험악한 표정을 짓는다.
					<<if random(1)>>
						<<set _text_output to "그 마녀가 네 머릿속을 헤집어 놨군.">>
					<<else>>
						<<set _text_output to "<<nnpc_He 'Gwylan'>>【은는】 네 주인이 아니야. 나지.">>
					<</if>>
					<<set $enemyanger += 20>><<set $enemytrust -= 20>>
				<<default>>
					<<bodypart_admire_generic _args[0]>>
			<</switch>>
		<<case "Avery">>
			<<bodypart_admire_avery _args[0]>>
			<<set _admireNothing to true>>
		<<case "Alex">>
			<<switch $skin[_args[0]].special>>
				<<case "Alex">>
					<<switch $skin[_args[0]].writing>>
						<<case "Alex's Partner">>
							<<He>>【이가】 활짝 웃는다.
							<<if $player.gender_appearance is "m">>
								<<set _text_output to "물론이지! 넌 내 남자야!">>
							<<else>>
								<<set _text_output to "물론이지! 넌 내 여자야!">>
							<</if>>
							<<npcincr Alex love 1>>
						<<case "Sunrise to Sunset">>
							<<He>>【은는】 한숨을 쉰다.
							<<set _text_output to "하루 종일 일하지만 않아도 좋았을 텐데.">>
							<<npcincr Alex love 1>>
						<<case "Cowboy" "Cowgirl">>
							<<He>>【은는】 낮게 웃는다.
							<<set _text_output to "확실히 몇 번 타주긴 할 수 있지.">>
							<<npcincr Alex lust 3>>
						<<case "Hay Baler">>
							<<if random(1)>>
								<<He>>【이가】 고개를 갸웃거린다.
								<<set _text_output to "강한 걸 좋아하는구나, 그렇지?">>
							<<else>>
								<<He>>【은는】 씩 웃는다.
								<<set _text_output to "널 땀 흘리게 할 더 좋은 방법이 있지.">>
							<</if>>
							<<npcincr Alex lust 3>>
						<<default>>
							<<He>>【은는】 낮게 웃는다.
					<</switch>>
				<<default>>
					<<bodypart_admire_generic _args[0]>>
			<</switch>>
		<<case "Black Wolf">>
			/*Not obtainable*/
			<<if $monster is 1>>
				<<if random(1)>>
					<<bHe>>【은는】 얼굴을 찌푸린다.
					<<set _text_output to "멍청한 인간들의 끄적거림. 당최 이해할 수가 없어.">>
				<<else>>
					<<bHe>>【이가】 고개를 갸웃거린다.
					<<set _text_output to "저건 흙인가?">>
				<</if>>
			<</if>>
		<<case "Great Hawk">>
			/*Not obtainable*/
			<<if $monster is 1>>
				<<bHe>>【이가】 고개를 갸웃거린다.
				<<if random(1)>>
					<<set _text_output to "누가 긁은 거야? 이게 다 뭐야?">>
				<<else>>
					<<set _text_output to "이게 육지 녀석들의 풍습이야?">>
				<</if>>
			<</if>>
		<<case "Bailey">>
			<<switch $skin[_args[0]].special>>
				<<case "Robin">>
					<<switch $skin[_args[0]].writing>>
						<<case "Robin & I">>
							<<He>>【은는】 비웃는다.
							<<set _text_output to "좋은 생각이군. 패키지 상품이라면 두 배로 돈을 낼 테니까.">>
						<<default>>
							<<if $speechadmired>>
								<<He>>【은는】 노려본다.
							<<else>>
								<<He>>【은는】 미소 짓는다.
							<</if>>
							<<set _text_output to "걱정 마, 곧 <<nnpc_him 'Robin'>>한테 찾아갈 테니까.">>
					<</switch>>
				<<case "Gwylan">>
					<<switch $skin[_args[0]].writing>>
						<<case "Witch's Ward" "Witch's Familiar">>
							<<He>>【은는】 비웃는다.
							<<set _text_output to "이 헛소리는 뭐야?">>
						<<case "Gwylan's Treasure" "Gwylan's Apprentice">>
							<<He>>【은는】 비웃는다.
							<<set _text_output to "스스로에게 새기기엔 어리석은 이름이군.">>
						<<default>>
							<<He>>【은는】 코웃음을 친다.
							<<set _text_output to "네 분수에 넘치는 짓이야.">>
					<</switch>>
				<<case "prostitution">>
					<<if $skin[_args[0]].degree gte 10000>>
						<<He>>【은는】 고개를 끄덕인다.
						<<if random(1)>>
							<<set _text_output to "괜찮은 가격이군.">>
						<<else>>
							<<set _text_output to "좋아. 네 가치를 잘 아는군.">>
						<</if>>
					<<else>>
						<<He>>【은는】 비웃는다.
						<<if random(1)>>
							<<set _text_output to "너무 헐값에 넘기려 드네.">>
						<<else>>
							<<set _text_output to "적어도 네가 어디에 쓸모 있는지는 아는군.">>
						<</if>>
					<</if>>
				<<case "rape">>
					<<He>>【이가】 입술을 씰룩인다.
					<<if random(1)>>
						<<set _text_output to "쓰레기처럼 네 몸을 내던지다니. 한심하군.">>
					<<else>>
						<<set _text_output to "이 무슨 낭비람.">>
					<</if>>
				<<default>>
					/*Do nothing.*/
					<<set _admireNothing to true>>
			<</switch>>
		<<case "Briar">>
			<<if $skin[_args[0]].special is "prostitution">>
				<<if $skin[_args[0]].degree gte 10000>>
					<<He>>【은는】 질색한다.
					<<if random(1)>>
						<<set _text_output to "자만심이 아주 하늘을 찌르는군.">>
					<<else>>
						<<set _text_output to "네가 그만한 가치가 있을 리가 없잖아.">>
					<</if>>
				<<elseif $skin[_args[0]].degree gte 2500>>
					<<if random(1)>>
						<<He>>【은는】 히죽 웃는다.
						<<set _text_output to "아쉽네. 나랑 함께였다면 훨씬 더 많이 벌 수 있었을 텐데.">>
					<<else>>
						<<He>>【은는】 험악한 표정을 짓는다.
						<<set _text_output to "넌 쥐뿔도 가치 없어.">>
					<</if>>
				<<else>>
					<<He>>【은는】 코웃음을 친다.
					<<if random(1)>>
						<<set _text_output to "누가 이런 싸구려 길거리 쥐새끼를 원하겠어?">>
					<<else>>
						<<set _text_output to "내 창녀들은 적어도 자존심이란 게 있지.">>
					<</if>>
				<</if>>
				<<set $enemyanger += 30>><<set $enemytrust -= 30>>
			<<else>>
				<<bodypart_admire_generic _args[0]>>
			<</if>>
		<<case "Remy">>
			<<switch $skin[_args[0]].special>>
				<<case "Alex">>
					<<if random(1)>>
						<<if $speechadmired>>
							<<He>>【이가】 의기양양한 미소를 짓는다.
						<<else>>
							<<He>>【은는】 미소 짓는다.
						<</if>>
						<<set _text_output to "이제 더 좋은 주인을 만났구나.">>
					<<else>>
						<<His>> 눈이 가늘어진다.
						<<set _text_output to "그 풋내기라면 이런 훌륭한 표본을 낭비했을 텐데.">>
					<</if>>
					<<set $enemytrust -= 20>>
				<<case "cattle">>
					<<if $cow gte 6>>
						<<He>>【은는】 미소 짓는다.
						<<if random(1)>>
							<<set _text_output to "이 목장의 자랑이지.">>
						<<else>>
							<<set _text_output to "정말이지, 훌륭한 표본이야.">>
						<</if>>
						<<set $enemyanger -= 5>><<set $enemytrust += 5>><<livestock_obey 1>>
					<<else>>
						<<He>>【은는】 미소 짓는다.
						<<if random(1)>>
							<<set _text_output to "아직 널 더 좋은 상품으로 만들어줄 수 있지.">>
						<<else>>
							<<set _text_output to "넌 여기에 속해 있어. 절대 잊지 마.">>
						<</if>>
					<</if>>
				<<case "prostitution">>
					<<He>>【은는】 웃음을 터뜨린다.
					<<set _text_output to "넌 네 생각보다 훨씬 가치 있어.">>
				<<default>>
					<<bodypart_admire_generic _args[0]>>
			<</switch>>
		<<case "Gwylan">>
			<<switch $skin[_args[0]].special>>
				<<case "Gwylan">>
					<<switch $skin[_args[0]].writing>>
						<<case "Witch's Familiar">>
							<<He>>【이가】 낄낄거린다. <<set _text_output to "넌 내 완벽한 작은 파트너야.">>
							<<npcincr Gwylan lust 1>>
						<<case "Gwylan's Apprentice">>
							<<He>>【은는】 키득거린다.
							<<if $worn.head.name is "sage witch hat">>
								<<set _text_output to "거기다 어울리는 모자까지 있네!">>
							<<else>>
								<<set _text_output to "이보다 더 좋을 순 없지.">>
							<</if>>
						<<default>>
							<<He>>【이가】 낄낄거린다. <<set _text_output to "아, <<pcpetname 'Gwylan' 'simple'>>, 넌 정말 사랑스러워.">>
					<</switch>>
					<<set $enemyanger -= 10>><<set $enemytrust += 10>>
				<<case "Robin">>
					<<if $gwylan.robin gte 50>>
						<<He>>【이가】 낄낄거린다. <<set _text_output to "아, 그거 정말 소중한 말이네. <<nnpc_him 'Robin'>>도 우리 사이에 끼워줘야겠어.">>
					<<else>>
						/*Do nothing.*/
						<<set _admireNothing to true>>
					<</if>>
				<<case "Eden">>
					<<He>>【은는】 얼굴을 찌푸린다.
					<<if random(1)>>
						<<set _text_output to "내가 더 좋은 주인이 되어야겠네.">>
					<<else>>
						<<set _text_output to "타고난 것과 길러진 것의 차이랄까.">>
					<</if>>
				<<case "Black Wolf">>
					<<He>>【은는】 키득거린다.
					<<if random(1)>>
						<<set _text_output to "우리 쪽에 늑대들을 좀 부를까, <<pcpetname 'Gwylan' 'simple'>>?">>
					<<else>>
						<<set _text_output to "이국적인 게 당기기라도 하는 거야?">>
					<</if>>
				<<case "islander" "esoteric">>
					<<He>>【이가】 만족스럽게 흥얼거린다.
					<<set _admireNothing to true>>
				<<default>>
					/*Do nothing.*/
					<<set _admireNothing to true>>
			<</switch>>
		<<case "Mason" "Sydney">>
			/*Do nothing.*/
			<<set _admireNothing to true>>
		<<default>>
			<<bodypart_admire_generic _args[0]>>
	<</switch>>

	<<if !$speechadmired and !_admireNothing>><<set $speechadmired to 1>>
		"<<print _text_output>>"
	<</if>>
<</widget>>

<<widget "bodypart_admire_plant">>
	<<if !$speechadmired>><<set $speechadmired to 1>>
		<<if $skin[_args[0]].type is "object">>
			<<switch $skin[_args[0]].writing>>
				<<case "unicorn">>
					"저런 말도 있다고? 와우."
				<<case "heart" "cross">>
					"아우, 정말 귀여워! ...근데 그게 뭔데?"
				<<case "paw_print">>
					<<if $location is "forest">>
						"야, 너 그... 아니야, 됐어."
					<<else>>
						"이국적이네!"
					<</if>>
				<<case "flower" "butterfly">>
					"오, 이거 맘에 들어!"
					<<set $enemytrust += 20>>
				<<case "star">>
					<<if $location is "forest">>
						"별을 볼 수 있으면 좋을 텐데, 나무들이 죄다 가려버리니..."
					<<elseif Time.dayState is "night">>
						"마치 밤하늘 같아!"
					<<else>>
						"정말 밤하늘 같아..."
					<</if>>
				<<case "skull">>
					"네 몸에 저런 게 들어있다는 말이야? 난 안 믿어."
				<<case "flame">>
					<<if $skin[_args[0]].pen is "brand" or $skin[_args[0]].pen is "magic">>
						"저거... 진짜로 널 태우고 있는 건 아니지, 그치?"
					<<else>>
						"위험한 걸 즐기는 취향이군."
					<</if>>
				<<case "cattle_brand">>
					<<if $location is "moor">>
						"걱정 마. 레미가 널 내게서 빼앗아 가지는 못할 테니까."
					<<else>>
						"아우, 정말 귀여워! ...근데 그게 뭔데?"
					<</if>>
				<<case "penis">>
					"우와, 음란하기도 하지! ...안 썼다니 그게 무슨 소리야?!"
			<</switch>>
		<<else>>
			<<switch $skin[_args[0]].pen>>
				<<case "tattoo">>
					"저거 뭐야, 점인가?"
				<<case "brand">>
					"앗뜨거, 내 몸엔 저런 걸 지져 넣고 싶지 않은걸."
				<<case "magic">>
					"내가 이상한 버섯이라도 먹었나, 아니면 저게 진짜 빛나는 거야?"
				<<case "lipstick">>
					"우와, 분홍색!"
				<<case "mud">>
					"자연의 캔버스라니까."
				<<default>>
					"그렇게 귀여운 피부에 낙서를 하다니 너무하네."
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "bodypart_admire">>
	<<if !$noAdmire and ($role isnot "islander" or $islander_language gte 100)>>
		<<if _args[0].includes("random_")>>
			<<set _args[0] to _args[0].replace("random_", (random(0,1) ? "left_" : "right_"))>> <!-- ex "random_cheek" turns into either "right_cheek" or "left_cheek" -->
		<</if>>
		<<switch _args[1]>>
			<<case "bodywriting">>
				<<if $skin[_args[0]] is undefined or $newlyWritten.includes(_args[0])>>
				<<elseif $skin[_args[0]].writing>>
					<<if _args[0] is "forehead" or
					(_args[0] is "left_cheek" or _args[0] is "right_cheek") and !$worn.face.type.includes("mask") or
					(_args[0] is "left_shoulder" or _args[0] is "right_shoulder") and ($worn.upper.exposed gte 1 or $worn.upper.open is 1) and ($worn.under_upper.exposed gte 1 or $worn.under_open is 1) or
					_args[0] is "breasts" and $worn.upper.exposed gte 1 and ($worn.under_upper.exposed gte 1 or $worn.under_upper.open is 1) or
