:: Widgets Settings [widget]

<<widget "initsettings">>
	<<set $player.gender to "f">>
	<<set $player.sex to "f">>
	<<set $player.gender_body to "a">>
	<<set $player.bodyshape to "classic">>
	<<set $player.ballsExist to false>>
	<<set $player.freckles to false>>
	<<set $player.breastsize to 0>>
	<<set $player.penissize to 3>>
	<<set $bodysize to 2>>
	<<set $mouthsensitivity to 1>>
	<<set $breastsensitivity to 1>>
	<<set $bottomsensitivity to 1>>
	<<set $genitalsensitivity to 1>>
	<<set $drunkSensitivity to 1>>
	<<set $facestyle to "default">>
	<<set $facevariant to "default">>
	<<set $eyeselect to "purple">>
	<<set $hairselect to "red">>
	<<set $hairlength to 200>>
	<<set $awareselect to "innocent">>
	<<set $background to "waif">>
	<<set $startingseason to "autumn">>
	<<set $gamemode to "normal">>
	<<set $settings.darkSkinChance to 10>>
	<<set $settings.swarmsEnabled to true>>
	<<set $settings.spidersEnabled to true>>
	<<set $settings.slugsEnabled to true>>
	<<set $settings.waspsEnabled to true>>
	<<set $settings.beesEnabled to true>>
	<<set $settings.lurkersEnabled to true>>
	<<set $settings.horsesEnabled to true>>
	<<set $settings.bodyWritingLevel to 3>>
	<<set $settings.parasitesEnabled to true>>
	<<set $settings.ruinedOrgasmEnabled to true>>
	<<set $settings.bestialityEnabled to true>>
	<<set $settings.slimesEnabled to true>>
	<<set $settings.voreEnabled to true>>
	<<set $settings.tentaclesEnabled to true>>
	<<set $settings.plantsEnabled to true>>
	<<set $settings.analEnabled to true>>
	<<set $settings.analDoubleEnabled to true>>
	<<set $settings.analingusGivingEnabled to true>>
	<<set $settings.analingusReceivingEnabled to true>>
	<<set $settings.vaginalDoubleEnabled to true>>
	<<set $settings.transformAnimalEnabled to true>>
	<<set $settings.transformDivineEnabled to true>>
	/*<<set $hirsutedisable to "t">>*/
	<<set $settings.pubicHairEnabled to false>>
	<<set $settings.breastFeedingEnabled to true>>
	<<set $settings.parasitePregnancyEnabled to true>>
	<<set $settings.asphyxiaLevel to 3>>
	<<set $settings.nudeGenderPerception to 1>>
	<<set $settings.npcVirginChanceStudent to 50>>
	<<set $settings.npcVirginChanceAdult to 10>>
	<<set $settings.footFetishEnabled to true>>
	<<set $settings.toyWhipEnabled to true>>
	<<set $settings.toyDildoEnabled to true>>
	<<set $settings.toyMultiplePenetrationEnabled to true>>
	<<set $settings.pregnancySpeechEnabled to true>>
	<<set $settings.hypnosisEnabled to true>>
	<<set $settings.blindStatsEnabled to false>>
	<<set $cheatsEnabled to false>>
	<<set $settings.watersportsEnabled to false>>
	<<set $settings.facesitEnabled to true>>
	<<set $ruffledisable to "f">>
	<<set $settings.forcedCrossdressingEnabled to true>>
	<<set $saveName to "">>
	<<set $settings.skillCheckStyle to "words">>
	<<set $blackwolfmonster to 1>>
	<<set $greathawkmonster to 1>>
	<<set $nightmonstermonster to 1>>
	<<set $reducedLineHeight to false>>
	<<set $settings.clothingCostModifier to 1>>
	<<set $settings.underwearCostModifier to 1>>
	<<set $settings.schoolClothingCostModifier to 1>>
	<<set $settings.lewdClothingCostModifier to 1>>
	<<set $settings.furnitureCostModifier to 1>>
	<<set $settings.basePlayerPregnancyChance to 2>>
	<<set $settings.baseNpcPregnancyChance to 8>>
	<<set $settings.humanPregnancyMonths to 3>>
	<<set $settings.wolfPregnancyWeeks to 4>>
	<<set $settings.birdPregnancyWeeks to 3>>
	<<set $settings.playerPregnancyHumanEnabled to true>>
	<<set $settings.playerPregnancyBeastEnabled to true>>
	<<set $settings.playerPregnancyEggLayingEnabled to true>>
	<<set $settings.npcPregnancyEnabled to true>>
	<<set $settings.nnpcPregnancyEnabled to true>>
	<<set $settings.analPregnancy to false>>
	<<set $settings.npcAnalPregnancyEnabled to false>>
	<<set $settings.incompletePregnancyEnabled to false>>
	<<set $settings.fertilityCycleEnabled to true>>
	<<set $settings.pregnancyType to "realistic">>
	<<set $settings.rentCostModifier to 1>>
	<<set $settings.condomLevel to 3>>
	<<set $settings.condomChance to 60>>
	<<set $settings.condomUseChanceRape to 33>>
	<<set $settings.condomUseChanceConsensual to 83>>
	<<set $settings.multipleWardrobes to "isolated">>
	<<set $settings.tendingYieldModifier to 5>>
	<<set $notifyUpdate = true>>
	<<set _tan to 0>>

	<<startingPlayerImageReset>>
<</widget>>

<<widget "displaySettings">>
	<<if _args[0]>>
		<<set $currentSettings to _args[0]>>
	<</if>>
	<<if $passage isnot "Start" and ["characterSettings", "featSettings"].includes($currentSettings)>>
		<<set $currentSettings to "gameSettings">>
	<</if>>
	<<switch $currentSettings>>
		<<case "quickStart" "tweak">><<replace #settingsDiv>><<quickStart>><</replace>>
		<<case "presetConfirmDetails">><<replace #settingsDiv>><<presetConfirmDetails>><</replace>>
		<<case "characterSettings" "character">>
			<<replace #settingsDiv>><<characterSettings>><</replace>>
			<<if StartConfig.enableImages and $passage is "Start">><<startingPlayerImageUpdate>><<removeclass #startingPlayerImage "hidden">><</if>>
		<<case "featSettings" "feat">><<replace #settingsDiv>><<featSettings>><</replace>>
		<<case "gameSettings" "game">><<replace #settingsDiv>><<gameSettings>><</replace>>
		<<case "sizeLimitsSettings" "size">><<replace #settingsDiv>><<sizeLimitsSettings>><</replace>>
		<<case "npcSettings" "npc">><<replace #settingsDiv>><<npcSettings>><</replace>>
		<<case "exportsettings" "export">><<replace #settingsDiv>><<exportsettings>><</replace>>
		<<case "gallerySettings" "gallery">><<replace #settingsDiv>><<gallerySettings>><</replace>>
		<<case "importConfirmDetails">><<replace #settingsDiv>><<importConfirmDetails>><</replace>>
		<<case "startDescriptions">><<startDescriptions>>
		<<default>><<replace #settingsDiv>><<gameSettings>><</replace>>
	<</switch>>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "displaySubsection">>
	<<if _args[0]>>
		<<set $currentSubsection to _args[0]>>
	<</if>>
	<<switch $currentSubsection>>
		<<case "humanSettings">><<set _subsection to "human">><<replace #subsectionDiv>><<humanSettings>><</replace>>
		<<case "npcSettings">><<set _subsection to "npc">><<replace #subsectionDiv>><<npcSettings>><</replace>>
		<<case "beastSettings">><<set _subsection to "beast">><<replace #subsectionDiv>><<beastSettings>><</replace>>
		<<case "fetishSettings">><<set _subsection to "fetish">><<replace #subsectionDiv>><<fetishSettings>><</replace>>
		<<case "priceSettings">><<set _subsection to "price">><<replace #subsectionDiv>><<priceSettings>><</replace>>
		<<case "pregnancySettings">><<set _subsection to "pregnancy">><<replace #subsectionDiv>><<pregnancySettings>><</replace>>
		<<case "sizeLimitsSettings">><<set _subsection to "sizeLimits">><<replace #subsectionDiv>><div class="solidBorderContainer settings-container"><<sizeLimitsSettings>></div><</replace>>
		<<default>><<set _subsection to "human">><<replace #subsectionDiv>><<humanSettings>><</replace>>
	<</switch>>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "startOptionsComplexityButton">>
	<div @class="_selectedStart is _args[1] ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button _args[0]>>
			<<set _selectedStart to _args[1]>>
			<<set _settingsTab to "startDescriptions">>
			<<replace #startOptions>><<startOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
		<</button>>
	</div>
<</widget>>

<<widget "settingsTabButton">>
	<div @class="_settingsTab is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'" >
		<<button _args[0]>>
			<<set _settingsTab to _settingsTab is _args[1] ? "startDescriptions" : _args[1]>>
			<<if _args[1] is "game">><<set _subsection to "human">><</if>>
			<<replace #startOptions>><<startOptions>><</replace>>
			<<displaySettings _settingsTab>>
		<</button>>
	</div>
<</widget>>

<<widget "startOptions">>
	<div class="containerStart">
		<div id="startSelectionDefault" class="buttonSettings">
			<<startOptionsComplexityButton "기본" "default">>
		</div>

		<div id="startSelectionCustom" class="buttonSettings">
			<<startOptionsComplexityButton "커스텀" "custom">>
		</div>

		<div id="startSelectionRandom" class="buttonSettings">
			<<startOptionsComplexityButton "무작위" "random">>
		</div>
	</div>

	<hr>
	<<set _featTabName to "업적 부스터<span class='red'> *</span>"+ ($options.images is 1 ? " <img class='imgButton' src='img/ui/coin-gold.gif'/>" : "")>>
	<<switch _selectedStart>>
		/*Basic Start is selected */
		<<case "default">>
			<div class="containerStart">
			/*Character Creation*/
				<<settingsTabButton "캐릭터 생성<span class='red'> *</span>" "character">>
			/*Feat Boosts */
				<<settingsTabButton _featTabName "feat">>
			/*Gallery*/
				<<settingsTabButton "갤러리" "gallery">>
			/*Export/Import Settings*/
				<<settingsTabButton "설정 내보내기/불러오기" "export">>
			</div>
		/*Custom Start is Selected */
		<<case "custom">>
			<div class="containerStart">
			/*Character Creation*/
				<<settingsTabButton "캐릭터 생성<span class='red'> *</span>" "character">>
			/*Game Settings*/
				<<settingsTabButton "게임 설정" "game">>
			/*Feat Boosts*/
				<<settingsTabButton _featTabName "feat">>
			/*Gallery*/
				<<settingsTabButton "갤러리" "gallery">>
			/*Export/Import Settings*/
				<<settingsTabButton "설정 내보내기/불러오기" "export">>
			</div>
		/*Random Start is Selected */
		<<case "random">>
			<div class="containerStart">
			/*Feat Boosts*/
				<<settingsTabButton _featTabName "feat">>
			/*Gallery*/
				<<settingsTabButton "갤러리" "gallery">>
			</div>
	<</switch>>
	/*Container for different tabs*/
	<div id="settingsDiv">
		<<switch $currentSettings>>
			<<case "featSettings" "feat">><<featSettings>>
			<<default>><<startDescriptions _selectedStart>>
		<</switch>>
	</div>
<</widget>>

<<widget "settingsStart">>
	<<updatehistorycontrols>><!-- hides controls on going back in history after enabling that option -->
	<<set $settings.cheatsEnabledToggle to $cheatsEnabled>>
	<<if _selectedStart is undefined>>
		<<set _selectedStart to "default">>
	<</if>>

	설정을 선택하세요:
	<br>
	<div id="startOptions" class="no-numberify">
		<<startOptions>>
	</div>
	<br>

	<div id="settingsExit">
		<<settingsExit>>
	</div>
<</widget>>


<<widget "settingsOptions">>
<<if _selectedSettings is undefined>><<set _selectedSettings to "quick">><</if>>
<div class="containerStart">
	<div @class="_selectedSettings is 'quick' ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button "빠른 편집">>
			<<set _selectedSettings to "quick">>
			<<replace #settingsOptions>><<settingsOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
			<<displaySettings "quickStart">>
		<</button>>
	</div>
	<div @class="_selectedSettings is 'game' ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button "게임 설정">>
			<<set _selectedSettings to "game">>
			<<set _subsection to "human">>
			<<replace #settingsOptions>><<settingsOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
			<<displaySettings "gameSettings">>
			/* Resets Quick edit temporary values, to make them reflect current settings as closely as they can */
			<<unset _pregnancytype>>
		<</button>>
	</div>
	<div @class="_selectedSettings is 'gallery' ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button "갤러리">>
			<<set _selectedSettings to "gallery">>
			<<replace #settingsOptions>><<settingsOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
			<<displaySettings "gallerySettings">>
		<</button>>
	</div>
	<div @class="_selectedSettings is 'export' ? 'gold buttonStartSelected' : 'buttonStart'" >
		<<button "설정 내보내기/불러오기">>
			<<set _selectedSettings to "export">>
			<<replace #settingsOptions>><<settingsOptions>><</replace>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
			<<displaySettings "exportsettings">>
		<</button>>
	</div>
</div>
<</widget>>

<<widget "settings">>
	<<updatehistorycontrols>><!-- hides controls on going back in history after enabling that option -->
	<<set $settings.cheatsEnabledToggle to $cheatsEnabled>>
	<div id="settingsOptions" class="no-numberify">
		<<settingsOptions>>
	</div>
	<div id="settingsDiv" class="no-numberify">
		<<quickStart>><<set $currentSettings to "quickStart">>
	</div>
	<br>
	<div id="settingsExit">
		<<settingsExit>>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "settingsExit">>
	<<saveNameSection>>
	<div style="margin-top:15px">
	<<if $passage is "Start">>
		<<switch _selectedStart>>
			<<case "default">>
				<div class="my-1"><span class="gold bold">현재 설정:</span> <i>조정 가능</i></div>
				<<button "게임 시작">>
					<<presets _kinkPreset "save">>
					<<presets _namedNpcPreset "save">>
					<<presets _monstersPreset "save">>
					<<if _pregnancytype is "disabled">>
						<<set $settings.playerPregnancyHumanEnabled to false>>
						<<set $settings.playerPregnancyBeastEnabled to false>>
						<<set $settings.playerPregnancyEggLayingEnabled to false>>
						<<set $settings.npcPregnancyEnabled to false>>
						<<set $settings.nnpcPregnancyEnabled to false>>
					<<else>>
						<<set $settings.pregnancyType to _pregnancytype or "realistic">>
						<<set $settings.playerPregnancyHumanEnabled to true>>
						<<set $settings.playerPregnancyBeastEnabled to true>>
						<<set $settings.playerPregnancyEggLayingEnabled to true>>
						<<set $settings.npcPregnancyEnabled to true>>
						<<set $settings.nnpcPregnancyEnabled to true>>
					<</if>>
					<<if ($feats.locked or ($settings.cheatsEnabledToggle is false and $settings.rentCostModifier gte 1 and $settings.tendingYieldModifier lte 5)) and ($feats.soft or ($gamemode isnot "soft" and $settings.allureModifier gte 1)) and ($feats.pregnancyLocked or ($settings.humanPregnancyMonths gte 3 and $settings.wolfPregnancyWeeks gte 4))>>
						<<settingsExitFunction>>
					<<else>><!-- confirm cheats -->
						<<replace #settingsExit>><<settingsExitConfirm>><</replace>>
					<</if>>
				<</button>>
			<<case "custom">>
				<div class="my-1"><span class="gold bold">현재 설정:</span> <i>커스텀</i></div>
				<<button "게임 시작">>
					<<if ($feats.locked or ($settings.cheatsEnabledToggle is false and $settings.rentCostModifier gte 1 and $settings.tendingYieldModifier lte 5)) and ($feats.soft or ($gamemode isnot "soft" and $settings.allureModifier gte 1)) and ($feats.pregnancyLocked or ($settings.humanPregnancyMonths gte 3 and $settings.wolfPregnancyWeeks gte 4))>>
						<<settingsExitFunction>>
					<<else>><!-- confirm cheats -->
						<<replace #settingsExit>><<settingsExitConfirm>><</replace>>
					<</if>>
				<</button>>
			<<case "random">>
				<div class="my-1"><span class="gold bold">현재 설정:</span> <i>무작위</i></div>
				<<button "게임 시작">>
						/*Rerolls all settings*/
					<<presets "randomize" "characterSettings" `randomizeSettings()`>>
					<<if ($feats.locked or ($settings.cheatsEnabledToggle is false and $settings.rentCostModifier gte 1 and $settings.tendingYieldModifier lte 5)) and ($feats.soft or ($gamemode isnot "soft" and $settings.allureModifier gte 1)) and ($feats.pregnancyLocked or ($settings.humanPregnancyMonths gte 3 and $settings.wolfPregnancyWeeks gte 4))>>
						<<settingsExitFunction>>
					<<else>><!-- confirm cheats -->
						<<replace #startOptions>><<startOptions>><</replace>>
						<<replace #settingsExit>><<settingsExitConfirm>><</replace>>
					<</if>>
				<</button>>
		<</switch>>
		<div class="small-description my-2">
			NPC 성별이나 야수 외형 같은 대부분의 설정은 나중에 당신의 침실에 있는 <span class="gold">게임플레이 설정</span> 링크를 통해 바꿀 수 있습니다. <span class="red">단, 게임이 시작된 후에는 캐릭터의 성기나 업적 부스터를 변경할 수 없습니다.</span> 추가 설정은 사이드바의 <span class="gold">옵션</span> 탭에서 찾을 수 있습니다.
		</div>
	<<else>>
		<<button "변경사항 저장">>
			<<if ($feats.locked or ($settings.cheatsEnabledToggle is false and $settings.rentCostModifier gte 1 and $settings.tendingYieldModifier lte 5)) and ($feats.soft or ($gamemode isnot "soft" and $settings.allureModifier gte 1)) and ($feats.pregnancyLocked or ($settings.humanPregnancyMonths gte 3 and $settings.wolfPregnancyWeeks gte 4))>>
				<<settingsExitFunction>>
			<<else>><!-- confirm cheats -->
				<<replace #settingsExit>><<settingsExitConfirm>><</replace>>
			<</if>>
		<</button>>
	<</if>>
	</div>
<</widget>>

<<widget "settingsExitConfirm">>
	<<if _selectedStart is "random">>
		<span class="red">무작위 생성 설정으로 인해 특정 업적을 얻을 수 없게 되었습니다.</span>
		<ul>
			<<if $settings.cheatsEnabledToggle is true>><li>치트 활성화: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $settings.rentCostModifier lt 1>><li>상납금 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $settings.tendingYieldModifier gt 5>><li>작물 수확량 증가: 모든 위업이 비활성화됩니다.</li><</if>>
			<<if !$feats.soft and $gamemode is "soft">><li>이지 모드: 일부 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.soft and $settings.allureModifier lt 1>><li>매력 보정 감소: 일부 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancyLocked and $settings.humanPregnancyMonths lt 3>><li>인간 임신 기간이 3개월 미만으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancyLocked and $settings.wolfPregnancyWeeks lt 4>><li>늑대 임신 기간이 4주 미만으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
		</ul>
		이 변경사항을 유지하시겠습니까?
		<br>
		<<button "아니오">>
			<<set $settings.cheatsEnabledToggle to false>>
			<<if $gamemode is "soft">>
				<<set $gamemode to "normal">>
			<</if>>
			<<if $settings.allureModifier lt 1>>
				<<set $settings.allureModifier to 1>>
			<</if>>
			<<if $settings.rentCostModifier lt 1>>
				<<set $settings.rentCostModifier to 1>>
			<</if>>
			<<if $settings.tendingYieldModifier gt 5>>
				<<set $settings.tendingYieldModifier to 5>>
			<</if>>
			<<if !$feats.pregnancyLocked and $settings.humanPregnancyMonths lt 3>>
				<<set $settings.humanPregnancyMonths to 3>>
			<</if>>
			<<if !$feats.pregnancyLocked and $settings.wolfPregnancyWeeks lt 4>>
				<<set $settings.wolfPregnancyWeeks to 4>>
			<</if>>
			<<displaySettings "startDescriptions">>
			<<replace #settingsExit>><<settingsExit>><</replace>>
		<</button>>
		<br>
		<span class="gold small-description">(이 변경사항을 실행 취소하여 설정을 다시 뽑습니다.)</span>
		<br><br>
		<<button "예">>
			<<settingsExitFunction>>
		<</button>>
		<br>
		<span class="red small-description">(이 세이브 파일에서 업적 달성이 비활성화됩니다.)</span>

	<<else>>
		<span class="red">선택하신 설정으로 인해 더 이상 업적을 얻을 수 없게 됩니다.</span>

		<ul>
			<<if $settings.cheatsEnabledToggle is true>><li>치트 활성화: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $settings.rentCostModifier lt 1>><li>상납금 감소: 모든 업적을 비활성화합니다.</li><</if>>
			<<if $settings.tendingYieldModifier gt 5>><li>작물 수확량 증가: 모든 위업이 비활성화됩니다.</li><</if>>
			<<if !$feats.soft and $gamemode is "soft">><li>이지 모드: 일부 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.soft and $settings.allureModifier lt 1>><li>매력 보정 감소: 일부 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancyLocked and $settings.humanPregnancyMonths lt 3>><li>인간 임신 기간이 3개월 미만으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
			<<if !$feats.pregnancyLocked and $settings.wolfPregnancyWeeks lt 4>><li>늑대 임신 기간이 4주 미만으로 설정됨: 일부 임신 업적을 비활성화합니다.</li><</if>>
		</ul>
		이 변경사항을 유지하시겠습니까?
		<br>
		<<button "아니오">>
			<<set $settings.cheatsEnabledToggle to false>>
			<<if $gamemode is "soft">>
				<<set $gamemode to "normal">>
			<</if>>
			<<if $settings.allureModifier lt 1>>
				<<set $settings.allureModifier to 1>>
			<</if>>
			<<if $settings.rentCostModifier lt 1>>
				<<set $settings.rentCostModifier to 1>>
			<</if>>
			<<if $settings.tendingYieldModifier gt 5>>
				<<set $settings.tendingYieldModifier to 5>>
			<</if>>
			<<if !$feats.pregnancyLocked and $settings.humanPregnancyMonths lt 3>>
				<<set $settings.humanPregnancyMonths to 3>>
			<</if>>
			<<if !$feats.pregnancyLocked and $settings.wolfPregnancyWeeks lt 4>>
				<<set $settings.wolfPregnancyWeeks to 4>>
			<</if>>
			<<if _settingsTab is 'tweak'>>
				<<replace #gameModeQuick>><<gameMode>><</replace>>
			<<elseif _settingsTab is 'game'>>
				<<replace #gameMode>><<gameMode>><</replace>>
			<</if>>
			<<replace #settingsExit>><<settingsExit>><</replace>>
		<</button>>
		<br>
		<span class="gold small-description">(이 변경사항을 실행 취소하여 업적을 얻을 수 있게 합니다.)</span>
		<br><br>
		<<button "예">>
			<<settingsExitFunction>>
		<</button>>
		<br>
		<span class="red small-description">(이 세이브 파일에서 업적 달성이 비활성화됩니다.)</span>
	<</if>>
<</widget>>

<<widget "settingsExitConfirmHistory">>
	<span class="red"><b>경고! 기록 저장 깊이 설정값이 너무 높습니다!</b><br>
	설정값이 5를 넘으면 새로운 세이브 파일을 만들 때 오류가 생길 수 있습니다! 계속 진행하려면 이 기능을 확실히 이해하고 진행하시거나, 설정값을 낮추세요!
	</span>
	<br>
	<<link "기능 비활성화">>
		<<set $options.maxStates to 1>>
		<<replace #settingsExit>><<settingsExit>><</replace>>
		<<displaySettings>>
	<</link>>
	<br>
	<<link "안전한 수치로 설정값 낮추기">>
		<<set $options.maxStates to 5>>
		<<replace #settingsExit>><<settingsExit>><</replace>>
		<<displaySettings>>
	<</link>>
	<br><br><br>
	<<link "내 발등을 내가 찍겠습니다">>
		<<settingsExitFunction>>
	<</link>>
<</widget>>

<<widget "settingsExitFunction">>
	<<if !$ironmanmode>>
		<<set $cheatsEnabled to $settings.cheatsEnabledToggle>>
	<</if>>
	<<if $cheatsEnabled is true or $settings.rentCostModifier lt 1 or $settings.tendingYieldModifier gt 5>>
		<<set $feats.locked to true>>
	<</if>>
	<<unset $settings.cheatsEnabledToggle>>
	<<if $gamemode is "soft" or $settings.allureModifier lt 1>>
		<<set $feats.soft to true>>
	<</if>>
	<<if $settings.humanPregnancyMonths lt 3 or $settings.wolfPregnancyWeeks lt 4>>
		<<set $feats.pregnancyLocked to true>>
	<</if>>
	<<updatehistorycontrols>>
	<<presets _namedNpcPreset "save">>
	<<initnpcgender>>
	<<updatePersistentNPCs>>
	<<hirsuteHideCheck>>
	<<generateTipsList>>
	<<if $player.freckles is "random">>
		<<set $player.freckles to (random(1, 5) is 1)>>
	<</if>>
	/* Reseeds named NPC cycle data in case the incomplete pregnancy content setting changed */
	<<npcPregnancyUpdater>>

	<!-- Init shop mannequin gender -->
	<<if $mannequinHasPenis is undefined>>
		<<set $mannequinHasPenis to $player.penisExist>>
		<<set $mannequinBreastsSize to ($mannequinHasPenis ? 0 : 3)>>
	<</if>>
	<<if $settings.lewdClothingCostModifier lt Math.ceil(10 / $settings.clothingCostModifier) * 0.1>>
		<<set $settings.lewdClothingCostModifier to parseFloat((Math.ceil(10 / $settings.clothingCostModifier) * 0.1).toFixed(1))>>
	<</if>>
	<<set _settingsExitPassage to clone($settingsExitPassage)>>
	<<unset $settingsExitPassage>>
	<<run State.display(_settingsExitPassage)>>
	<<set $saveName to $saveName.replace(/[^a-zA-Z\u4e00-\u9fa5 0-9]+/g,"")>>
	<<unset $importString>>

	/* Updates the penis max size for females so its never below 2 */
	<<if $player.sex is "f" && $penissizemax < 2>>
		<<set $penissizemax to 2>>
	<</if>>
<</widget>>

/*complete:{"Vrelnir (Default)":"vrelDefault","Lollipop Scythe":"lollipopScythe","PurityGuy":"purityGuy","Fangi":"fangi"},*/
<<widget "quickStartOptions">>
	<<if _quickStartOptions is undefined>>
		<<set _quickStartOptions to {
			player:{"여성 부랑아":"femaleWaif","남성 부랑아":"maleWaif", "양성 부랑아":"hermaphroditeWaif", "브렐니르 PC":"vrel", "크로스드레서":"crossdresser","터프가이":"toughGuy"},
			genericNpc:{
				"기본 성별":"genericNpcDefaultGender",
				"전원 남성":"genericNpcAllMaleGender",
				"75% 남성":"genericNpc75MaleGender",
				"전원 여성":"genericNpcAllFemaleGender",
				"75% 여성":"genericNpc75FemaleGender",
				"전원 이성":"genericNpcAllOppositeGenders",
				"90% 이성":"genericNpc90OppositeGenders",
				"75% 이성":"genericNpc75OppositeGenders",
				"전원 동성":"genericNpcAllSameGenders",
				"90% 동성":"genericNpc90SameGenders",
				"75% 동성":"genericNpc75SameGenders",
			},
			namedNpc:{"기본 성별":"namedNpcDefaultGender", "전원 남성":"namedNpcAllMaleGender", "전원 여성":"namedNpcAllFemaleGender"},
			beasts:{
				"기본 성별":"beastDefaultGenders",
				"전원 수컷":"beastMaleGenders",
				"75% 수컷":"beast75MaleGenders",
				"전원 암컷":"beastFemaleGenders",
				"75% 암컷":"beast75FemaleGenders",
				"전원 이성":"beastOppositeGenders",
				"90% 이성":"beast90OppositeGenders",
				"75% 이성":"beast75OppositeGenders",
				"전원 동성":"beastSameGenders",
				"90% 동성":"beast90SameGenders",
				"75% 동성":"beast75SameGenders",
			},
			monsters:{"환각 상태일 때":"monstersDefault", "수인 없음":"monstersNone", "전부 수인":"monstersAll"},
			kink:{"적당히 문란함":"kinkDefault", "바닐라":"kinkVanilla", "짐승 없음":"kinkNoBeasts", "무엇이든 허용":"kinkEverything"},
			game:{
				"노말 ":"gameNormal","이지 (업적 없음)":"gameSoft","하드":"gameHard","하드 (철인)":"gameHardIronman","마조히스트":"gameMasochist","치트 포함 이지 (업적 없음)":"gameSoftCheats","치트 포함 노말 (업적 없음)":"gameNormalCheats","치트 포함 하드 (업적 없음)":"gameHardCheats","치트 포함 마조히스트 (업적 없음)":"gameMasochistCheats"
			},
			images:{"기본":"imagesdefault","고화질":"imagesHigh","저화질":"imagesLow","성능 모드":"imagesPerformance","이미지 비활성화":"imagesDisable"},
			settings:{"PC, 팁 표시":"settingPCTip","PC, 팁 없음":"settingPCNoTip","모바일, 팁 표시":"settingMobileTips","모바일, 팁 없음":"settingMobileNoTips"}
		}>>
	<</if>>
<</widget>>

<<widget "quickStart">>
	<div @class="$passage is 'Start' ? '' : 'solidBorderContainer settings-container'">
		<div class="settingsGrid">
			<<quickStartOptions>>
			<<if $passage is "Start">>
				<div class="settingsHeader">
					기본 설정
				</div>
				<div class="settingsToggleItemWide">
					<span class="gold">시작 계절:</span>
					<br>
					<label><mouse class="tooltip tangerine">가을 <<radiobutton "$startingseason" "autumn" autocheck>><span class="green"><i>초보자에게 추천합니다.</i></span></mouse></label> |
					<label><span class="teal">겨울</span> <<radiobutton "$startingseason" "winter" autocheck>></label> |
					<label><span class="lime-green">봄</span> <<radiobutton "$startingseason" "spring" autocheck>></label> |
					<label><span class="red">여름</span> <<radiobutton "$startingseason" "summer" autocheck>></label> |
					<label>무작위 <<radiobutton "$startingseason" "random" autocheck>></label>
				</div>
			<<else>>
				<div class="settingsToggleIndent p-0">
					<i>게임 설정을 빠르게 변경합니다. 더 세부적으로 조정하려면 <span class="gold">게임 설정</span> 탭을 이용하세요.</i>
				</div>
			<</if>>
			<div id="gameModeQuick" class="settingsToggleItem">
				<<gameMode>>
			</div>

			<div class="settingsToggleItem">
				<<set _foundPregnancy to !!Object.values($NPCName).find(npc => npc.pregnancy && npc.pregnancy.enabled && getActivePregnancies(npc.fullDescription).length && !setup.pregnancy.canBePregnant.includes(npc.fullDescription))>>
				<label>
					<span class="gold">임신 모드:</span>
					<br>
					<<if $passage is "Start">>
						<label><<radiobutton "_pregnancytype" "realistic" `_pregnancytype ? "autocheck" : ($settings.pregnancyType is "realistic" ? "checked": "")`>> <mouse class="tooltip green">현실적<span>임신이 바로 진행되지 않으며, 임신이 되었는지 즉시 알 수 없습니다. 임신 테스트기를 사용해야 할 수도 있으며, 처음에는 아버지가 누구인지 모를 수 있습니다. 수 시간 안에 씻어내지 않으면 보지 바깥에 묻은 정액으로도 임신할 수 있습니다.</span></mouse></label> |
						<label><<radiobutton "_pregnancytype" "fetish" `_pregnancytype ? "autocheck" : ($settings.pregnancyType is "fetish" ? "checked": "")`>> <mouse class="tooltip pink">페티시<span>정액이 몸 안에 들어가는 즉시 임신될 수 있습니다. 임신 사실과 아버지가 누구인지도 곧바로 알게 됩니다.</span></mouse></label> |
						<label><<radiobutton "_pregnancytype" "disabled" autocheck>> <mouse class="tooltip red">비활성화<span>임신이 비활성화됩니다.<<if $passage isnot "Start">>이미 진행 중인 임신을 막거나 플레이어가 자식과 상호작용하는 것을 막지는 않습니다.<</if>></span></mouse></label>
					<<else>>
						<<pregnancyType>>
					<</if>>
				</label>
				<br>
				<label>
					<<fertilityCycles>>
				</label>
				<br>
				<label data-target='["settingsincompletepregnancyenabled", "pregnancytype", "settingsnnpcpregnancyenabled", "settingsplayerpregnancyhumanenabled", "settingsplayerpregnancybeastenabled"]' data-disabledif="(T.foundPregnancy&&V.settings.incompletePregnancyEnabled===true)||T.pregnancytype==='disabled'||(!V.settings.nnpcPregnancyEnabled&&!V.settings.playerPregnancyHumanEnabled&&!V.settings.playerPregnancyBeastEnabled)">
					<<incompletePregnancy>>
				</label>
			</div>

			<<if _selectedStart isnot "custom">>
				<div class="settingsToggleItem">
					<<if $passage is "Start">>
						<span class="gold">일반 NPC 성별:</span>
						<<numberslider "$settings.maleChance" $settings.maleChance 0 100 25 {
							onInputChange: v => {
								if (V.settings.maleChanceSplit === true && v === 50) {
									V.settings.maleChanceMale = random (1, 99);
									V.settings.maleChanceFemale = random (1, 99);
									return;
								}
								if (V.settings.maleChanceSplit === true) {
									V.settings.maleChanceMale = 100 - v;
									V.settings.maleChanceFemale = v;
									return;
								}
							},
							value: v => {
								if (V.settings.maleChanceSplit === true) {
									switch (v) {
										case 100:
											return `<span class="small-description">NPC 전원이 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
										case 75:
											return `<span class="small-description">NPC의 <span class='gold inline-colour'>75%</span>가 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
										case 50:
											return `<span class="small-description">NPC의 성적 지향이 <span class='gold inline-colour'>무작위로</span> 나뉩니다.</span>`;
										case 25:
											return `<span class="small-description">NPC의 <span class='gold inline-colour'>75%</span>가 <span class='gold inline-colour'>동성</span>에게 끌립니다.</span>`;
										case 0:
											return `<span class="small-description">NPC 전원이 <span class='gold inline-colour'>동성</span>에게 끌립니다.</span>`;
										default:
											return `<span class="small-description">NPC의 <span class='gold inline-colour'>${v}%</span>가 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
									}
								} else {
									switch (v) {
										case 100:
											return `<span class="small-description">NPC 전원이 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
										case 75:
											return `<span class="small-description">NPC의 <span class='gold inline-colour'>75%</span>가 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
										case 50:
											return `<span class="small-description">NPC의 성비가 <span class='blue inline-colour'>남성</span>과 <span class='pink inline-colour'>여성</span>으로 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
										case 25:
											return `<span class="small-description">NPC의 <span class='gold inline-colour'>75%</span>가 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`;
										case 0:
											return `<span class="small-description">NPC 전원이 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`;
										default:
											return `<span class="small-description">NPC의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
									}
								}
							},
						}>>
						<span id="humanSplitBy"><<humanSplitBy>></span>
					<<else>>
						<<npcAttractionSettings>>
					<</if>>
				</div>

				<div class="settingsToggleItem">
					<span class="gold">네임드 NPC 성별:</span>
					<br>
					<<if _namedNpcPreset is undefined>><<set _namedNpcPreset to "namedNpcDefaultGender">><</if>>
					<label>전원 남성 <<radiobutton "_namedNpcPreset" "namedNpcAllMaleGender" autocheck>></label> |
					<label><<print $passage is "Start" ? "무작위 성별" : "현재 성별">> <<radiobutton "_namedNpcPreset" "namedNpcDefaultGender" autocheck>></label> |
					<label>전원 여성 <<radiobutton "_namedNpcPreset" "namedNpcAllFemaleGender" autocheck>></label>
				</div>

				<div class="settingsToggleItem">
					<<if $passage is "Start">>
						<span class="gold"><<= $settings.monsterChance is 100 ? "수인" : "짐승">> 성별:</span>
						<<numberslider "$settings.beastMaleChance" $settings.beastMaleChance 0 100 25 {
							onInputChange: v => {
								if (V.settings.beastMaleChanceSplit === true && v === 50) {
									V.settings.beastMaleChanceMale = random (1, 99);
									V.settings.beastMaleChanceFemale = random (1, 99);
									return;
								}
								if (V.settings.beastMaleChanceSplit === true) {
									V.settings.beastMaleChanceMale = 100 - v;
									V.settings.beastMaleChanceFemale = v;
									return;
								}
							},
							value: v => {
								const beasts = V.settings.monsterChance === 100 ? "수인" : "짐승";
								const Beasts = beasts;
								if (V.settings.beastMaleChanceSplit === true) {
									switch (v) {
										case 100:
											return `<span class="small-description">모든 ${beasts}이 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
										case 75:
											return `<span class="small-description">${beasts}의 <span class='gold inline-colour'>75%</span>가 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
										case 50:
											return `<span class="small-description">${Beasts}의 성적 지향이 <span class='gold inline-colour'>무작위로</span> 나뉩니다.</span>`;
										case 25:
											return `<span class="small-description">${beasts}의 <span class='gold inline-colour'>75%</span>가 <span class='gold inline-colour'>동성</span>에게 끌립니다.</span>`;
										case 0:
											return `<span class="small-description">모든 ${beasts}이 <span class='gold inline-colour'>동성</span>에게 끌립니다.</span>`;
										default:
											return `<span class="small-description">${beasts}의 <span class='gold inline-colour'>${v}%</span>가 <span class='gold inline-colour'>이성</span>에게 끌립니다.</span>`;
									}
								} else {
									switch (v) {
										case 100:
											return `<span class="small-description">모든 ${beasts}이 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`;
										case 75:
											return `<span class="small-description">${beasts}의 <span class='gold inline-colour'>75%</span>가 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`;
										case 50:
											return `<span class="small-description">${Beasts}의 성비가 <span class='blue inline-colour'>수컷</span>과 <span class='pink inline-colour'>암컷</span>으로 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
										case 25:
											return `<span class="small-description">${beasts}의 <span class='gold inline-colour'>75%</span>가 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`;
										case 0:
											return `<span class="small-description">모든 ${beasts}이 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`;
										default:
											return `<span class="small-description">${beasts}의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`;
									}
								}
							},
						}>>
						<span id="beastSplitBy"><<beastSplitBy>></span>
					<<else>>
						<<beastAttractionSettings>>
					<</if>>
				</div>

				<div class="settingsToggleItem">
					<<if $passage is "Start">>
						<<if _monstersPreset is undefined>><<set _monstersPreset to "monstersDefault">><</if>>
						<span class="gold">짐승을 수인로 대체:</span>
						<br>
						<label>항상 <<radiobutton "_monstersPreset" "monstersAll" autocheck>></label> |
						<label>환각 상태일 때만 <<radiobutton "_monstersPreset" "monstersDefault" autocheck>></label> |
						<label>사용 안 함 <<radiobutton "_monstersPreset" "monstersNone" autocheck>></label>
					<<else>>
						<<monsterSettings>>
					<</if>>
				</div>
				<<if $passage is "Start">>
					<div class="settingsToggleItem">
						<span class="gold">페티시 설정:</span>
						<br>
						<<if _kinkPreset is undefined>><<set _kinkPreset to "kinkDefault">><</if>>
						<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">바닐라<span>모든 수인 관련 토글이 비활성화되며, 인간형 식물, 촉수, 슬라임, 모유 수유, 페이스시팅, 이중 삽입, 최면도 비활성화됩니다.</span></mouse>
						<<radiobutton "_kinkPreset" "kinkVanilla" autocheck>></label> |
						<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">꽤 방탕한<span>기본 설정. 워터스포츠를 제외한 모든 페티시가 활성화됩니다.</span></mouse>
						<<radiobutton "_kinkPreset" "kinkDefault" autocheck>></label> |
						<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">수인 없음<span>수인 관련 모든 설정이 비활성화됩니다. 수간, 스웜, 보어, 기생충, 거미, 민달팽이, 말벌, 럴커, 벌, 말 등이 포함됩니다.</span></mouse>
						<<radiobutton "_kinkPreset" "kinkNoBeasts" autocheck>></label> |
						<label><mouse class="tooltip" style="border-bottom: 2px dotted var(--link)">"뭐든지"<span>워터스포츠를 포함한 모든 페티시가 활성화됩니다.</span></mouse>
						<<radiobutton "_kinkPreset" "kinkEverything" autocheck>></label>
					</div>
					<div class="settingsToggleItem">
						<i>페티시 및 게임플레이 설정을 <<= _selectedStart is "custom" ? "변경하려면" : "더 세부적으로 조정하려면">> <span class="teal"><<= _selectedStart is "default" ? "커스텀 시작" : "게임 설정">></span> 탭을 방문하세요. 게임플레이 설정은 게임을 시작한 후에도 변경할 수 있습니다.</i>
					</div>
				<</if>>
			<</if>>
		</div>
	</div>
<</widget>>

<<widget "humanSplitByFull">>
	<<link `$settings.maleChanceSplit is true ? "성적 지향 무시" : "성적 지향 설정"`>>
		<<set $settings.maleChanceSplit to $settings.maleChanceSplit is true ? false : true>>
		<<toggleclass "#simpleGenders" "hidden">>
		<<replace "#splitGenders">><<maleChanceSplitControls>><</replace>>
		<<toggleclass "#splitGenders" "hidden">>
		<<replace "#humanSplitByFull">><<humanSplitByFull>><</replace>>
	<</link>>
<</widget>>

<<widget "beastSplitByFull">>
	<<link `$settings.beastMaleChanceSplit is true ? "성적 지향 무시" : "성적 지향 설정"`>>
		<<set $settings.beastMaleChanceSplit to $settings.beastMaleChanceSplit is true ? false : true>>
		<<toggleclass "#simpleBeastGenders" "hidden">>
		<<replace "#splitBeastGenders">><<beastMaleChanceSplitControls>><</replace>>
		<<toggleclass "#splitBeastGenders" "hidden">>
		<<replace "#beastSplitByFull">><<beastSplitByFull>><</replace>>
	<</link>>
<</widget>>

<<widget "humanSplitBy">>
	<<link `$settings.maleChanceSplit is true ? "성적 지향 무시" : "성적 지향 설정"`>>
		<<set $settings.maleChanceSplit to $settings.maleChanceSplit is true ? false : true>>
		<<replace "#humanSplitBy">><<humanSplitBy>><</replace>>
		<<run $("#numberslider-input-settingsmalechance").trigger("input");>>
	<</link>>
<</widget>>

<<widget "beastSplitBy">>
	<<link `$settings.beastMaleChanceSplit is true ? "성적 지향 무시" : "성적 지향 설정"`>>
		<<set $settings.beastMaleChanceSplit to $settings.beastMaleChanceSplit is true ? false : true>>
		<<replace "#beastSplitBy">><<beastSplitBy>><</replace>>
		<<run $("#numberslider-input-settingsbeastmalechance").trigger("input");>>
	<</link>>
<</widget>>

<<widget "characterSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItem">
			<span class="gold">무작위 생성:</span><br>
				<<link "캐릭터 외모">><<presets "randomize" "characterSettings" `randomizeSettings('characterAppearance')`>><</link>>
				<mouse class="tooltip linkBlue">(?)<span>플레이어 캐릭터의 외모(머리, 눈, 피부색, 성별, 신체 부위 크기)를 무작위로 설정합니다. 신체 크기, 성별 외모, 성기, 기본 피부색은 게임을 시작한 후에는 변경할 수 없습니다.</span></mouse>
			<br>
			</div>
			<div class="settingsToggleItem">
			<<if StartConfig.enableImages is true>>
				<span class="gold">사이드바 미리보기:</span><br> <label>옷 숨기기 <<checkbox "_showClothes" true false autocheck>></label> | <label>속옷 숨기기 <<checkbox "_showUnderwear" true false autocheck>></label><<if $player.sex isnot "f">> | <label>이완된 자지 <<checkbox "_flaccidPenis" false true autocheck>></label><</if>>
				<br>
			<</if>>
			</div>
		</div>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				몸
			</div>

			<div class="settingsToggleItem" id="genitals">
				<span class="gold">생식기:</span><br>
				<label>자지 <<radiobutton "$player.sex" "m" autocheck>></label> |
				<label>보지 <<radiobutton "$player.sex" "f" autocheck>></label> |
				<label>둘 다 <<radiobutton "$player.sex" "h" autocheck>></label>
				<<if $player.sex is "h">>
					<br>
					<label>고환: <<checkbox "$player.ballsExist" false true autocheck>></label>
				<</if>>
			</div>
			<<run
			$(() => {
				$('#genitals input[type="radio"]').on('change', () => {
					if (V.player.sex === "h" && V.background === "crossdresser") V.background = "waif";
					Wikifier.wikifyEval('<<replace #settingsDiv>><<characterSettings>><</replace>>');
					Wikifier.wikifyEval('<<updatesidebarimg>>');
				});
			})
			>>

			<div class="settingsToggleItem" id="gender">
				<span class="gold">성별:</span><br>
				<label class="blue">남성 <<radiobutton "$player.gender" "m" autocheck>></label> |
				<label class="pink">여성 <<radiobutton "$player.gender" "f" autocheck>></label> |
				<label class="purple">어느 쪽도 아님 <<radiobutton "$player.gender" "n" autocheck>></label>
				<br>
				<span class="small-description">스스로를 어떻게 인식하는지 설정합니다. 다른 사람들이 당신을 어떻게 보는지에는 영향을 주지 않습니다. 나중에 거울 메뉴에서 변경할 수 있습니다.</span>
			</div>
			<<run
			$(() => {
				$('#gender input[type="radio"]').on('change', () => {
					Wikifier.wikifyEval('<<replace #settingsDiv>><<characterSettings>><</replace>>');
					Wikifier.wikifyEval('<<updatesidebarimg>>');
				});
			})
			>>

			<div class="settingsToggleItem">
				<span class="gold">체격:</span> <mouse class="tooltip linkBlue">(?)<span>체격이 크면 더 강인한 체력을 기를 수 있어 전투가 수월해집니다. 체격이 작으면 좁은 틈새를 빠져나갈 수 있어, 위험한 상황에서 탈출하기 수월해집니다. </span></mouse>
<br>

				<label><mouse class="tooltip">조그마함<span class="blue"><i>초보자에게는 권장하지 않습니다.</i></span></mouse> <<radiobutton "$bodysize" 0 autocheck>></label> |
				<label>작음 <<radiobutton "$bodysize" 1 autocheck>></label> |
				<label>보통 <<radiobutton "$bodysize" 2 autocheck>></label> |
				<label>큼 <<radiobutton "$bodysize" 3 autocheck>></label><br>
				<span class="small-description">체격이 클수록 최대 체력과 피해량이 증가합니다.</span>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">체형:</span><br>
				<<set _bodyShapeLabelsKr to {
					"classic": "평범한",
					"slender": "슬림한",
					"curvy": "잘록한",
					"soft": "푹신한"
				}>>
				<<capture _i>>
					<<for _i = 0; _i < setup.bodyShapes.length; _i++>>
						<label><<= _bodyShapeLabelsKr[setup.bodyShapes[_i]] || setup.bodyShapes[_i].toUpperFirst()>> <<radiobutton "$player.bodyshape" setup.bodyShapes[_i] autocheck>></label>
						<<= _i lt setup.bodyShapes.length - 1 ? "|" : "">>
					<</for>>
				<</capture>>
				<br>
				<span class="small-description">순수하게 외모에만 관련된 항목입니다. 나중에 거울 메뉴에서 변경할 수 있습니다.</span>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">가슴 크기:</span><br>
				<label>납작한 <<radiobutton "$player.breastsize" 0 autocheck>></label> |
				<label>아주 작은 <<radiobutton "$player.breastsize" 1 autocheck>></label> |
				<label>작은 <<radiobutton "$player.breastsize" 2 autocheck>></label> |
				<label>봉긋한 <<radiobutton "$player.breastsize" 3 autocheck>></label> |
				<label>볼륨있는 <<radiobutton "$player.breastsize" 4 autocheck>></label>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">엉덩이 크기:</span><br>
				<label>납작한 <<radiobutton "$player.bottomsize" 0 autocheck>></label> |
				<label>아담한 <<radiobutton "$player.bottomsize" 1 autocheck>></label> |
				<label>둥근 <<radiobutton "$player.bottomsize" 2 autocheck>></label> |
				<label>부드러운 <<radiobutton "$player.bottomsize" 3 autocheck>></label>
			</div>
			<<if $player.sex isnot "f">>
				<div class="settingsToggleItem">
					<span data-target="player.sex" data-disabledif="V.player.sex==='f'">
					<span class="gold">자지 크기:</span><br>
					<label>매우 작음 <<radiobutton "$player.penissize" 2 autocheck>></label> |
					<label>작음 <<radiobutton "$player.penissize" 3 autocheck>></label> |
					<label>보통 <<radiobutton "$player.penissize" 4 autocheck>></label>
					</span>
				</div>
			<</if>>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				머리
			</div>
			<<if setup.faceStyleOptions.length gt 1>>
				<div id="settingsFaceStyle" class="settingsToggleItem">
					<span class="gold">얼굴 형태:</span><br>
					<<for _styleName, _styleValue range setup.faceStyleOptions>>
					<<capture _styleName, _styleValue>>
						<span @id="'link-'+_styleValue.replace(/ /g,'-')" @class="(_styleValue is $facestyle ? 'selected' : '')">
						<<silently>><<set _text_output to _styleName>><<capitalise>><</silently>>
						<<link _text_output>>
							<<removeclass `'#link-'+$facestyle.replace(/ /g,'-')` "selected">>
							<<set $facestyle to _styleValue>>
							<<set $facevariant to "default">>
							<<addclass `'#link-'+$facestyle.replace(/ /g,'-')` "selected">>
							<<replace "#settingsFaceVariantRadios">><<faceVariantSettings>><</replace>>
							<<updatesidebarimg true>>
						<</link>> |
						</span>
					<</capture>>
					<</for>>
				</div>
			<</if>>
			<div id="settingsFaceVariants" @class="setup.faceStyleOptions.length gt 1 ? 'settingsToggleItem' : 'settingsToggleItemWide'">
				<span class="gold">인상:</span>
				<br>
				<div id="settingsFaceVariantRadios">
					<<faceVariantSettings>>
					<br>
					<span class="small-description">순수하게 외모에만 관련된 항목입니다. 나중에 거울 메뉴에서 변경할 수 있습니다.</span>
				</div>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">눈동자 색:</span><br>
				<label><span class="purple">보라색</span> <<radiobutton "$eyeselect" "purple" autocheck>></label> |
				<label><span class="blue">짙은 파란색</span> <<radiobutton "$eyeselect" "dark blue" autocheck>></label> |
				<label><span class="lblue">밝은 파란색</span> <<radiobutton "$eyeselect" "light blue" autocheck>></label> |
				<label><span class="tangerine">호박색</span> <<radiobutton "$eyeselect" "amber" autocheck>></label> |
				<label><span class="brown">헤이즐색</span> <<radiobutton "$eyeselect" "hazel" autocheck>></label> |
				<label><span class="brown">갈색</span> <<radiobutton "$eyeselect" "brown" autocheck>></label> |
				<label><span class="green">초록색</span> <<radiobutton "$eyeselect" "green" autocheck>></label> |
				<label><span class="green">연녹색</span> <<radiobutton "$eyeselect" "light green" autocheck>></label> |
				<label><span class="lime-green">라임색</span> <<radiobutton "$eyeselect" "lime green" autocheck>></label> |
				<label><span class="red">빨간색</span> <<radiobutton "$eyeselect" "red" autocheck>></label> |
				<label><span class="pink">분홍색</span> <<radiobutton "$eyeselect" "pink" autocheck>></label> |
				<label><span class="black">검은색</span> <<radiobutton "$eyeselect" "black" autocheck>></label> |
				<label><span class="grey">회색</span> <<radiobutton "$eyeselect" "grey" autocheck>></label> |
				<label><span class="light-grey">연회색</span> <<radiobutton "$eyeselect" "light grey" autocheck>></label> |
				<label><span>무작위</span> <<radiobutton "$eyeselect" "random" autocheck>></label>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">원래 머리색:</span><br>
				<label><span class="red">빨간색</span> <<radiobutton "$hairselect" "red" autocheck>></label> |
				<label><span class="black">칠흑색</span> <<radiobutton "$hairselect" "jetblack" autocheck>></label> |
				<label><span class="black">검은색</span> <<radiobutton "$hairselect" "black" autocheck>></label> |
				<label><span class="darkbrown">어두운 갈색</span> <<radiobutton "$hairselect" "darkbrown" autocheck>></label> |
				<label><span class="brown">갈색</span> <<radiobutton "$hairselect" "brown" autocheck>></label> |
				<label><span class="copperbrown">구리빛 갈색</span> <<radiobutton "$hairselect" "copperbrown" autocheck>></label> |
				<label><span class="softbrown">부드러운 갈색</span> <<radiobutton "$hairselect" "softbrown" autocheck>></label> |
				<label><span class="lightbrown">밝은 갈색</span> <<radiobutton "$hairselect" "lightbrown" autocheck>></label> |
				<label><span class="burntorange">진한 주황색</span> <<radiobutton "$hairselect" "burntorange" autocheck>></label> |
				<label><span class="strawberry">스트로베리 블론드</span> <<radiobutton "$hairselect" "strawberryblond" autocheck>></label> |
				<label><span class="tangerine">적갈색</span> <<radiobutton "$hairselect" "ginger" autocheck>></label> |
				<label><span class="gold">금발</span> <<radiobutton "$hairselect" "blond" autocheck>></label> |
				<label><span class="softblond">부드러운 금발</span> <<radiobutton "$hairselect" "softblond" autocheck>></label> |
				<label><span class="platinum">플래티넘 블론드</span> <<radiobutton "$hairselect" "platinumblond" autocheck>></label> |
				<label><span class="ashy">잿빛 금발</span> <<radiobutton "$hairselect" "ashyblond" autocheck>></label> |
				<label><span class="white">흰색</span> <<radiobutton "$hairselect" "white" autocheck>></label> |
				<label><span class="snowwhite">순백색</span> <<radiobutton "$hairselect" "snowwhite" autocheck>></label> |
				<label><span>무작위</span> <<radiobutton "$hairselect" "random" autocheck>></label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">머리 길이:</span><br>
				<label>귀 <<radiobutton "$hairlength" 0 autocheck>></label> |
				<label>목 <<radiobutton "$hairlength" 200 autocheck>></label> |
				<label>가슴 <<radiobutton "$hairlength" 400 autocheck>></label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">주근깨:</span><br>
				<label>예 <<radiobutton "$player.freckles" true autocheck>></label> |
				<label>아니요 <<radiobutton "$player.freckles" false autocheck>></label> |
				<label>무작위 <<radiobutton "$player.freckles" "random" autocheck>></label>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<<if !_skinTone>>
				<<set _skinTone to "">>
			<</if>>
			<<if !_skinShade>>
				<<set _skinShade to "light">>
			<</if>>

			<div class="settingsHeader">
				피부색
			</div>
			<div class="settingsToggleItem">
				<span class="gold">피부 톤:</span><br>
				<label>뉴트럴 <<radiovar "_skinTone" "">><<skinColourVariableCombine>><</radiovar>></label> |
				<label>웜 <<radiovar "_skinTone" "r">><<skinColourVariableCombine>><</radiovar>></label> |
				<label>골든 <<radiovar "_skinTone" "g">><<skinColourVariableCombine>><</radiovar>></label> |
				<label>올리브 <<radiovar "_skinTone" "y">><<skinColourVariableCombine>><</radiovar>></label> |
				<label>쿨 <<radiovar "_skinTone" "b">><<skinColourVariableCombine>><</radiovar>></label>
				<br>
				<span class="gold">피부 음영:</span><br>
				<label>밝은 <<radiovar "_skinShade" "light">><<skinColourVariableCombine>><</radiovar>></label> |
				<label>중간 <<radiovar "_skinShade" "medium">><<skinColourVariableCombine>><</radiovar>></label> |
				<label>어두운 <<radiovar "_skinShade" "dark">><<skinColourVariableCombine>><</radiovar>></label> |
				<label>갸루 <<radiovar "_skinShade" "gyaru">><<skinColourVariableCombine>><</radiovar>></label>
			</div>
			<div class="settingsToggleItem">
				<div class="numberslider-inline">
				<label><span class="gold">초기 태닝:</span>
				<<numberslider "_tan" _tan 0 100 1 {
					onInputChange: value => {
						Skin.color.setTan(value);
						Wikifier.wikifyEval("<<startingPlayerImageUpdate>>");
					},
					value: v => `${v}%`
				}>>
				</label>
				</div>
			</div>
		</div>

		<hr>

		<<sizeLimitsSettings>>
		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				민감도 <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>민감도는 특정 신체 부위에 성적인 접촉이 있을 때 얻는 흥분도를 결정합니다. <i>민감도가 높을수록 게임이 더 어려워집니다.</i></span>">(?)</span>
			</div>
			<div class="settingsToggleItem">
                <span class="gold">입:</span><br>
                <label>보통 <<radiobutton "$mouthsensitivity" 1 autocheck>></label> |
                <label><span class="pink">반응함</span> <<radiobutton "$mouthsensitivity" 2 autocheck>></label> |
                <label><span class="red">예민함</span> <<radiobutton "$mouthsensitivity" 3 autocheck>></label>
			</div>
			<div class="settingsToggleItem">
                <span class="gold">가슴:</span><br>
                <label>보통 <<radiobutton "$breastsensitivity" 1 autocheck>></label> |
                <label><span class="pink">반응함</span> <<radiobutton "$breastsensitivity" 2 autocheck>></label> |
                <label><span class="red">예민함</span> <<radiobutton "$breastsensitivity" 3 autocheck>></label>
			</div>

			<div class="settingsToggleItem">
                <span class="gold">엉덩이:</span><br>
                <label>보통 <<radiobutton "$bottomsensitivity" 1 autocheck>></label> |
                <label><span class="pink">반응함</span> <<radiobutton "$bottomsensitivity" 2 autocheck>></label> |
                <label><span class="red">예민함</span> <<radiobutton "$bottomsensitivity" 3 autocheck>></label>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">생식기:</span><br>
                <label>보통 <<radiobutton "$genitalsensitivity" 1 autocheck>></label> |
                <label><span class="pink">반응함</span> <<radiobutton "$genitalsensitivity" 2 autocheck>></label> |
                <label><span class="red">예민함</span> <<radiobutton "$genitalsensitivity" 3 autocheck>></label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">주량</span><br>
				<label><span class="blue">주당 </span><<radiobutton "$drunkSensitivity" 0.5 autocheck>></label> |
				<label>보통 <<radiobutton "$drunkSensitivity" 1 autocheck>></label> |
				<label><span class="red">약한 편</span> <<radiobutton "$drunkSensitivity" 1.5 autocheck>></label>
			</div>
		</div>

		<hr>

		<div class="settingsGrid">
			<div class="settingsHeader">
				성격
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">무작위 생성:</span>
				<br>
				<<link "캐릭터 특성">><<presets "randomize" "characterSettings" `randomizeSettings('characterTrait')`>><</link>>
				<mouse class="tooltip linkBlue">(?)<span>플레이어 캐릭터의 특성(배경, 성지식, 전반적인 민감도 등)을 무작위로 설정합니다. <i class="red">이 특성들은 게임을 시작한 후에는 변경할 수 없습니다.</i></span></mouse>
				<br>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">성지식:</span> <mouse class="tooltip linkBlue">(?)<span>캐릭터가 경험이 부족해도 성에 대해 어느 정도 알고 있는지 설정합니다.</span></mouse>
				<br>
				<label>순진함 <<radiobutton "$awareselect" "innocent" autocheck>></label> |
				<label>알고 있음 <<radiobutton "$awareselect" "knowledgeable" autocheck>></label>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">배경:</span><br>
				<label><span class="green">부랑아</span> <<radiobutton "$background" "waif" autocheck>> - 특별한 장점이나 단점이 없습니다. <i>초보자에게 추천합니다.</i></label>
				<br>
				<label><span class="teal">범생이</span> <<radiobutton "$background" "nerd" autocheck>> - 학교 성적이 좋습니다. 괴롭힘을 당합니다. <span class="red">('사회성 없는 나방' 업적을 획득할 수 없게 됩니다)</span></label>
				<br>
				<label><span class="teal">운동선수</span> <<radiobutton "$background" "athlete" autocheck>> - 신체적으로 능력이 좋습니다. 성적이 떨어졌습니다.</label>
				<br>
				<label><span class="teal">불량배</span> <<radiobutton "$background" "delinquent" autocheck>> - 이런저런 사고 덕분에 다른 학생들에게 인기가 많습니다. 선생님들에게는 그렇지 않습니다.</label>
				<br>
				<label><span class="blue">난잡함</span> <<radiobutton "$background" "promiscuous" autocheck>> - 당신은 성적인 경험이 있습니다.</label>
				<br>
				<label><span class="blue">노출증</span> <<radiobutton "$background" "exhibitionist" autocheck>> - 공공장소에서 자신을 노출하는 것에 친밀감을 느낍니다.</label>
				<br>
				<label><span class="blue">일탈자</span> <<radiobutton "$background" "deviant" autocheck>> - 당신은 동물을 <i>정말</i> 좋아합니다.</label>
				<br>
				<label><span class="lewd">미모</span> <<radiobutton "$background" "beautiful" autocheck>> - 사람들의 시선을 끕니다. <i>초보자에게는 권장하지 않습니다.</i></label>
				<br>
				<<if $player.sex isnot "h">>
					<label><span class="lewd"><<= $player.gender isnot $player.sex ? `\"크로스드레서\"` : "크로스드레서">></span> <<radiobutton "$background" "crossdresser" autocheck>> - 이성의 옷을 입는 것을 좋아하게 되었습니다. <<= $player.sex is "f" ? "소년" : "소녀">>처럼 보일 때는 스트레스가 더 빨리 감소하지만, <<pcSex>>처럼 보일 때는 더 느리게 감소합니다.</label>
					<br>
				<</if>>
				<label><span class="lewd">호색한</span> <<radiobutton "$background" "lustful" autocheck>> - 흥분도가 시간이 지남에 따라 증가하며 관리가 필요합니다.</label>
				<br>
				<label><mouse class="tooltip"><span class="lewd">나무성애자</span> <<radiobutton "$background" "plantlover" autocheck>> - 당신에게는 식물이 전부입니다.<span class="green">넥타르에 중독되었습니다. 최음제와 술에 더 취약합니다. 인간형 식물과 식물 기반 촉수를 만나기 위해 더 이상 환각이 필요하지 않습니다. 트라우마가 증가할수록 관리 스킬에 보너스를 받습니다.</span></mouse>
				</label>
			</div>
		</div>
		<hr>
		<<quickStart>>
	</div>
	<br>
	<<link "<span class='fa-icon fa-up-arrow'></span>페이지 상단">>
		<<script>>
			document.body.scrollTop = 0;
			document.documentElement.scrollTop = 0;
		<</script>>
	<</link>>
<</widget>>

<<widget "featExplanation">>
	<<link "설명 숨기기...">>
		<<replace #featExplanation>><</replace>>
		<<toggleclass '#explain' 'hidden'>>
	<</link>><br>
	여러 세이브 파일의 업적을 모두 불러오지 않을 경우, <span class="gold">가장 최근에 불러온 세이브</span>에서 잠금 해제된 업적만이 다음 회차로 이어집니다. 100% 완료를 목표로 하고 있다면 이 점을 주의해 주세요!
	<br><br>
	<span class="green">업적 부스터에 코인을 사용해도 코인은 영구적으로 소모되지 않으며, 하나의 업적으로 얻은 코인은 두 번 얻을 수 없습니다.</span> 사용한 코인은 개인 코인 저장소에 남아 새로운 게임을 시작할 때마다 사용할 수 있습니다.
	<br><br>
	<span class="red">특정 설정값을 변경할 경우 현재 게임에서 일부 업적과 코인을 획득하지 못할 수 있습니다.</span> 플레이 중 치트 옵션을 한 번이라도 활성화할 경우 남은 회차 동안 어떠한 업적도 획득할 수 없게 됩니다. 해당 설정들을 변경하려 할 경우 경고 메시지가 출력됩니다.
	<br><br>
	어떤 업적들은 조건을 달성하자마자 획득 표시가 뜨지만, 또 다른 업적들은 게임 내 시간이 다음 시간으로 넘어가야 표시됩니다. 그럼 즐거운 수집 시간 되시길 바랍니다!
<</widget>>

<<widget "featSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsToggleIndent">
	Degrees of Lewdity를 플레이하며 다양한 임무를 완수함으로써 <span class="gold">업적</span>을 얻게 됩니다. 더 많은 업적을 얻을수록 더 많은 <span class="gold">브렐 코인</span>을 얻습니다. 새로운 게임을 시작할 때 가장 최근에 불러온 세이브에 저장된 코인들을 사용해 <span class="gold">업적 부스터</span>를 구매할 수 있습니다. 이 부스터들은 다음 게임 시 보너스를 제공합니다.
				<br><br>
				업적들은 하나의 게임 회차 내에서 누적되어 달성됩니다. 만약 이전의 세이브 파일로 되돌아가거나 다른 회차로 전환할 경우, <span class="red">아래의 링크를 사용해 모든 업적을 불러오지 않는 한 달성한 업적과 브렐 코인을 모두 잃게 됩니다.</span> 업적 불러오기 실행 시 업적 부스터들은 초기화됩니다.
				<span id="explain">
					<<link "자세히 알아보기...">>
						<<replace #featExplanation>><<featExplanation>><</replace>>
						<<toggleclass '#explain' 'hidden'>>
					<</link>>
				</span>
				<span id="featExplanation"></span>
		</div>
			<div class="settingsToggleIndent">
				<<link "모든 업적 불러오기:">>
					<<replace #settingsStart>>
						<<loadAllFeats>>
					<</replace>>
				<</link>>
				<span class="green"> 장치 내 여러 로컬 세이브 파일들에서 달성된 모든 업적을 확인하여, 당신이 획득한 브렐 코인과 잠금 해제된 업적 부스터들을 병합합니다.</span>
			</div>
			<<if $feats.allSaves.points isnot undefined or $feats.allSaves.points isnot 0>>
				<div class="settingsToggleIndent">
				<<link "모든 업적 초기화:">>
					<<set $feats to {
						"locked":false,
						"soft":false,
						"allSaves":{},
						"currentSave":{},
						"filter":"All"
					}>>
					<<script>>
						localStorage.removeItem("dolFeats");
					<</script>>
					<<setupFeatBoosts true>>
					<<displaySettings "featSettings">>
				<</link>>
				<span class="red"> 이는 지금까지 획득한 모든 업적을 삭제하며, 처음부터 업적들을 전부 다시 수집해야 함을 의미합니다.</span>
				</div>
			<</if>>
				<hr>

				<<set _upgradeNames to Object.keys($featsBoosts.upgrades)>>
				<<set _visibleUpgradeNames to []>>
				<<set _visibleUpgradeIDs to []>>
				<<for _i to 0; _i lt _upgradeNames.length; _i++>>
					<<if $featsBoosts.upgradeDetails[_upgradeNames[_i]].max>>
						<<set _visibleUpgradeNames.push($featsBoosts.name[_upgradeNames[_i]])>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<<else>>
						<<set _visibleUpgradeNames.push("?????")>>
						<<set _visibleUpgradeIDs.push(clone(_i))>>
					<</if>>
				<</for>>
				<div id="featsPointsMenu">
					<<featsPointsMenu>>
				</div>
				<<featsPointsMenuReset>>
	</div>
<</widget>>

<<widget "gameMode">>
	<span class="gold">게임 모드:</span>
	<br>
	<label><mouse class="tooltip green">노말 모드<span>위험한 세계에서 살아남으세요.</span></mouse>
		<<if ($ironmanmode is true and $gamemode is "hard") and $passage != "Start">>
			<input id="radiobutton-gamemode-8" name="radiobutton-gamemode" type="radio" tabindex="0" class="macro-radiobutton" disabled>
		<<else>>
			<<radiobutton "$gamemode" "normal" autocheck>>
		<</if>>
	</label> |
	<label><mouse class = "tooltip blue">이지 모드<span> 가볍고 음란한 모험을 선호하는 분들을 위한 모드입니다. 하지만 여전히 게임 내 어두운 부분이 존재할 수 있습니다.<br><i class="red normal">이 기능은 실험적이며 게임 진행을 막는 버그가 포함되어 있을 수 있습니다. 추후 변경되거나 삭제될 예정입니다. 설정에서 이지 모드를 유지하면 노말 모드로 변경할 때까지 업적을 획득할 수 없습니다. 이 모드를 사용하면 이 세이브 파일에서 영구적으로 일부 업적을 획득할 수 없게 됩니다.</i></span></mouse>
		<<if ($ironmanmode is true and ["hard","normal"].includes($gamemode) is true) and $passage != "Start">>
			<input id="radiobutton-gamemode-8" name="radiobutton-gamemode" type="radio" tabindex="0" class="macro-radiobutton" disabled>
		<<else>>
			<<radiobutton "$gamemode" "soft" autocheck>>
		<</if>>
	</label> |
	<<if $intro is 1 or $gamemode is "hard">>
		<label><mouse class = "tooltip purple">하드 모드<span> 음란한 스탯(음란, 노출증, 이상성욕)의 자연 감소를 제거하여 트라우마와 통제력 관리를 점점 더 어렵게 만듭니다. 게임 시작 시에만 선택할 수 있으며 정신병원에 수감되면 노말 모드로 돌아갑니다.<br><i class="red normal">이 기능은 실험적이며 추후 변경되거나 삭제될 예정입니다.</i></span></mouse>
			<<if $ironmanmode is true and $passage != "Start">>
				<input id="radiobutton-gamemode-8" name="radiobutton-gamemode" type="radio" tabindex="0" class="macro-radiobutton" disabled>
			<<else>>
				<<radiobutton "$gamemode" "hard" autocheck>>
			<</if>>
		</label>
	<</if>>
	<br>
	<<if $ironmanmode and $passage isnot "Start">>
		<span class="red">철인 모드 중에는 치트를 활성화할 수 없습니다.</span>
	<<else>>
		<<if $passage is "Start">>
			<label data-target="settingscheatsenabledtoggle" data-disabledif="V.settings.cheatsEnabledToggle===true">
				<input id="checkbox-ironmanmode" onclick="IronMan.UI.checkBox()" name="checkbox-ironmanmode" type="checkbox" tabindex="0" class="macro-checkbox"> <mouse class="tooltip white">철인 모드<span>세이브 로드 꼼수 등 이런 부류의 행위를 방지하기 위해 마련되었습니다.<br><br>저장할 수 있고 그러면 시작 메뉴로 이동하게 됩니다. 그 뒤 이 세이브 파일을 불러올 수 있지만 이후에는 자동 삭제됩니다.<br><br>또한 해당 세이브 파일을 잃을 경우를 대비해 게임 내에서 4-8일마다 추가 저장이 진행됩니다.</span></mouse>&nbsp;<i class="ironman-clarify">(게임 시작 후에는 해제할 수 없습니다)</i>
				<<run IronMan.UI.checkBox(`init`)>>
			</label>
			<br>
		<</if>>
		<label data-target="ironmanmode" data-disabledif="V.ironmanmode===true">
			<<checkbox "$settings.cheatsEnabledToggle" false true autocheck>> <mouse class="tooltip red">치트 모드<span>설정에서 치트를 활성화한 상태로 유지하면 세이브에서 업적을 획득할 수 없습니다.</span></mouse>&nbsp;<i class="ironman-clarify">(치트 버튼이 사이드바에 표시됩니다)</i>
		</label>
	<</if>>
<</widget>>

<<widget "gameSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItem">
				<span class="gold">무작위 설정:</span><br>

				<<link "게임플레이">><<presets "randomize" "gameSettings" `randomizeSettings('gameplay')`>><</link>>
				<mouse class="tooltip linkBlue">(?)<span>조우 확률, 의상 가격, 작물 수확량, 베일리의 집세 등 일반 게임플레이에 관련된 모든 설정을 무작위로 바꿉니다.</span></mouse> |
				<<link "조우">><<presets "randomize" "gameSettings" `randomizeSettings('encounter')`>><</link>>
				<mouse class="tooltip linkBlue">(?)<span>일반 NPC와 관련된 모든 설정을 무작위로 바꿉니다.</span></mouse>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">개별 옷장:</span> <mouse class="tooltip linkBlue">(?)<span class="red">이 기능은 실험적이며 향후 변경되거나 삭제될 수 있습니다. 게임 플레이 중에도 설정을 바꿀 수는 있지만 권장하지 않습니다. 비활성화 시 특정 옷에 접근할 수 없게 되고, 활성화 시엔 입을 게 타월밖에 없는 상황에 갇힐 위험이 있습니다.</span></mouse>
				<br>
				<label><<radiobutton "$settings.multipleWardrobes" false autocheck>> 공용 옷장 하나만 사용</label> |
				<label><<radiobutton "$settings.multipleWardrobes" "isolated" autocheck>> 고립된 장소는 자체 옷장을 가짐</label>
				<br>
				<<if $debug is 1>>
					<!--This setting will not be ready on initial release-->
					<label><<radiobutton "$settings.multipleWardrobes" "all" autocheck>> 모든 옷장에 개별 적용</label>
					<br>
				<</if>>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">스킬 판정 표시:</span> <mouse class = "tooltip linkBlue">(?)<span>게임과 상호작용할 때, 특정 스킬이 일정 기준을 넘어야만 성공하는 행동들이 있습니다. 행동을 취하기 전 요구되는 스킬과 성공 확률을 보여주도록 선택할 수 있습니다.</span></mouse>
				<br>
				<label>정확한 성공 확률(%) 표시 <<radiobutton "$settings.skillCheckStyle" "percentage" autocheck>></label> |
				<label>대략적인 성공 확률 표시 <<radiobutton "$settings.skillCheckStyle" "words" autocheck>></label> |
				<label>요구되는 스킬 이름만 표시 <<radiobutton "$settings.skillCheckStyle" "skillname" autocheck>></label>
				<br>
				<label>
				<<checkbox "$settings.blindStatsEnabled" false true autocheck>> <mouse class = "tooltip linkBlue">블라인드 스탯 활성화<span>블라인드 스탯을 켜고 플레이하면 스탯이 변할 때 아무런 표시가 뜨지 않으며, 특정 이벤트의 성공을 위해 어떤 스킬이 필요한지도 알 수 없고, 상황에 따른 위험 경고도 받지 못합니다. 오직 직감만으로 살아남으십시오.<i class="red normal"><br>초보자에게는 권장하지 않습니다. 이 기능은 실험적이며 향후 변경되거나 삭제될 수 있습니다.</i></span></mouse>
				</label>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">조우 확률:</span>
				<div class="small-description">기본값은 1.0. 매력이 조우 확률에 미치는 영향력을 곱셈합니다.</div>
				<div class="small-description"><span class="red">이 값을 1 미만으로 설정하면, 이 세이브에서는 일부 업적을 영원히 얻을 수 없게 되며 최소 1로 다시 올리기 전까지 다른 업적들도 얻을 수 없습니다.</span></div>
				<div id="sliderAllureMode">
					<<numberslider "$settings.allureModifier" $settings.allureModifier 0.2 2 0.1 $ironmanmode>>
				</div>
			</div>
		</div>
	</div>
	<hr>
	<div id="startTabSettings">
		<<allSettings>>
	</div>
	<div id="subsectionDiv">
		<<humanSettings>>
	</div>
	<br>
	<<link "<span class='fa-icon fa-up-arrow'></span>페이지 맨 위로">>
		<<script>>
			document.body.scrollTop = 0;
			document.documentElement.scrollTop = 0;
		<</script>>
	<</link>>
<</widget>>

<<widget "subsectionSettingsTabButton">>
	<div @class="_subsection is _args[1] ? 'gold buttonSettingsSelected' : 'buttonSettings'" >
		<<button _args[0]>>
			<<if _subsection isnot _args[1]>>
				<<set _subsection to _args[1]>>
				<<displaySubsection `_args[1] + "Settings"`>>
				<<replace #startTabSettings>><<allSettings>><</replace>>
			<</if>>
		<</button>>
	</div>
<</widget>>

<<widget "allSettings">>
	<<if _subsection is undefined>><<set _subsection to "human">><</if>>
	<div id="containerStart" class="containerWrap">
		<div id="settingsHuman">
			<<subsectionSettingsTabButton "일반 NPC 설정" "human">>
		</div>

		<div id="settingsNPC">
			<<subsectionSettingsTabButton "네임드 NPC 설정" "npc">>
		</div>

		<div id="settingsBeast">
			<<subsectionSettingsTabButton "짐승 설정" "beast">>
		</div>

		<div id="settingsFetish">
			<<subsectionSettingsTabButton "페티시 설정" "fetish">>
		</div>

		<div id="settingsPrice">
			<<subsectionSettingsTabButton "비용 및 획득량 설정" "price">>
		</div>

		<div id="settingsPregnancy">
			<<subsectionSettingsTabButton "임신 설정" "pregnancy">>
		</div>
		<<if $passage isnot "Start">>
			<div id="settingsSizeLimits">
				<<subsectionSettingsTabButton "신체 부위 크기 제한" "sizeLimits">>
			</div>
		<</if>>
	</div>
<</widget>>

<<widget "genericGenders">>
	<div class="numberslider-inline maleChance">
		<<numberslider "$settings.maleChance" $settings.maleChance 0 100 1 {
			value: v => {
				switch (v) {
					case 0:
						return `<span class="small-description">NPC 전원이 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`;
					case 50:
						return `<span class="small-description">NPC의 성비가 <span class='blue inline-colour'>남성</span>과 <span class='pink inline-colour'>여성</span>으로 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
					case 100:
						return `<span class="small-description">NPC 전원이 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
					default:
						return v > 50
							? `<span class="small-description">NPC의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`
							: `<span class="small-description">NPC의 <span class='gold inline-colour'>${100 - v}%</span>가 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`
				}
			},
		}>>
	</div>
<</widget>>

<<widget "beastGenders">>
	<<set _beasts to $settings.monsterChance is 100 ? "수인" : "짐승">>
	<div class="numberslider-inline beastmalechance">
		<<numberslider "$settings.beastMaleChance" $settings.beastMaleChance 0 100 1 {
				value: v => {
				const beasts = V.settings.monsterChance === 100 ? "수인" : "짐승";
				const Beasts = beasts;
				switch (v) {
					case 0:
						return `<span class="small-description"><span class='gold inline-colour'>모든</span> ${beasts}이 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`;
					case 50:
						return `<span class="small-description">${Beasts}은 <span class='blue inline-colour'>수컷</span>과 <span class='pink inline-colour'>암컷</span>의 성비가 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
					case 100:
						return `<span class="small-description"><span class='gold inline-colour'>모든</span> ${beasts}이 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`;
					default:
						return v > 50
							? `<span class="small-description">${beasts}의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>수컷</span>이 됩니다.</span>`
							: `<span class="small-description">${beasts}의 <span class='gold inline-colour'>${100 - v}%</span>가 <span class='pink inline-colour'>암컷</span>이 됩니다.</span>`
				}
			},
		}>>
	</div>
<</widget>>

<<widget "monsterSettings">>
	<div class="numberslider-inline">
		<span class="gold">수인 출현 확률:</span>
		<<numberslider "$settings.monsterChance" $settings.monsterChance 0 100 1 {
			value: v => {
				switch (v) {
					case 0:
						return `<span class="small-description">짐승은 환각 상태에서 허용된 경우가 아니라면 <span class='gold inline-colour'>절대</span> 수인으로 나타나지 않습니다.</span>`;
					case 50:
						return `<span class="small-description">전체 짐승의 <span class='gold inline-colour'>절반</span>이 수인으로 대체됩니다.</span>`;
					case 100:
						return `<span class="small-description">짐승은 <span class='gold inline-colour'>항상</span> 수인으로 나타납니다.</span>`;
					default:
						return `<span class="small-description">짐승의 <span class='gold inline-colour'>${v}%</span>가 수인으로 대체됩니다.</span>`
				}
			},
		}>>
	</div>
	<label>
		<<checkbox "$settings.monsterHallucinationsOnly" false true autocheck>> 수인은 환각 상태에서만 출현합니다
	</label>
<</widget>>

<<widget "npcAttractionSettings">>
	<div id="simpleGenders" @class="(V.settings.maleChanceSplit === true ? ' hidden' : '')">
		<span class="gold">일반 NPC 성별:</span>
		<<genericGenders>>
	</div>
	<div id="splitGenders" @class="(V.settings.maleChanceSplit === false ? ' hidden' : '')">
		<<maleChanceSplitControls>>
	</div>
	<span id="humanSplitByFull"><<humanSplitByFull>></span>
<</widget>>

<<widget "beastAttractionSettings">>
	<div id="simpleBeastGenders" @class="(V.settings.beastMaleChanceSplit === true ? ' hidden' : '')">
		<span class="gold"><<= $settings.monsterChance is 100 ? "수인" : "짐승">> 성별:</span>
		<<beastGenders>>
	</div>
	<div id="splitBeastGenders" @class="(V.settings.beastMaleChanceSplit === false ? ' hidden' : '')">
		<<beastMaleChanceSplitControls>>
	</div>
	<span id="beastSplitByFull"><<beastSplitByFull>></span>
<</widget>>

<<widget "humanSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 성별
			</div>
			<div class="settingsToggleItem">
				<<npcAttractionSettings>>
			</div>
			<div class="settingsToggleItem">
				<div class="numberslider-inline malevictimchance">
					<span class="gold">다른 피해자:
						<mouse class="tooltip linkBlue">(?)<span>타협을 강요받거나 학대받는 상황에 처한 NPC들의 성별을 조정합니다.</span></mouse>
					</span>
					<<numberslider "$settings.maleVictimChance" $settings.maleVictimChance 0 100 1 {
						value: v => {
							switch (v) {
								case 0:
									return `<span class="small-description">당신이 조우하는 다른 피해자 전원이 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`;
								case 50:
									return `<span class="small-description">당신이 조우하는 다른 피해자의 성비가 <span class='blue inline-colour'>남성</span>과 <span class='pink inline-colour'>여성</span>으로 <span class='gold inline-colour'>균등하게</span> 나뉩니다.</span>`;
								case 100:
									return `<span class="small-description">당신이 조우하는 다른 피해자 전원이 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`;
								default:
									return v > 50
										? `<span class="small-description">당신이 조우하는 다른 피해자의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성</span>이 됩니다.</span>`
										: `<span class="small-description">당신이 조우하는 다른 피해자의 <span class='gold inline-colour'>${100 - v}%</span>가 <span class='pink inline-colour'>여성</span>이 됩니다.</span>`
							}
						},
					}>>
				</div>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 신체 부위
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">여성 NPC 평균 가슴 크기:
				<mouse class="tooltip linkBlue">(?)<span>숫자가 클수록 세계의 가슴 크기가 커집니다. 12일 경우 모두가 거대한 가슴을 갖게 됩니다. -12일 경우 모두가 납작한 가슴을 갖게 됩니다. 기본값은 0이며, 넓은 범위의 크기가 나타납니다.</span></mouse>
				</span>
				<<numberslider "$settings.breastModifier" $settings.breastModifier -12 12 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">NPC 평균 자지 크기:
				<mouse class="tooltip linkBlue">(?)<span>숫자가 클수록 세계의 자지 크기가 커집니다. 8일 경우 모두가 거대한 자지를 갖게 됩니다. -8일 경우 모두가 아주 작은 자지를 갖게 됩니다. 기본값은 0이며, 넓은 범위의 크기가 나타납니다.</span></mouse>
				</span>
				<<numberslider "$settings.penisModifier" $settings.penisModifier -8 8 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">자지가 있는 여성의 비율:</span>
				<<numberslider "$settings.femaleNPCPenisChance" $settings.femaleNPCPenisChance 0 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">보지가 있는 남성의 비율:</span>
				<<numberslider "$settings.maleNPCVaginaChance" $settings.maleNPCVaginaChance 0 100 1>>
			</div>
			<div class="settingsToggleItemWide numberslider-inline">
				<span class="gold">페니스 밴드를 한 여성의 비율:</span>
				<<numberslider "$settings.straponChance" $settings.straponChance 0 100 1>>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				NPC 특성
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">청년 NPC가 처녀/동정일 확률:
				<mouse class="tooltip linkBlue">(?)<span>네임드 NPC에게는 영향을 미치지 않습니다. 각 부위의 순결은 개별적으로 생성되므로, 다양한 조합이 가능합니다.</span></mouse>
				</span>
				<<numberslider "$settings.npcVirginChanceStudent" $settings.npcVirginChanceStudent 0 100 1>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold">성인 NPC가 처녀/동정일 확률:
				<mouse class="tooltip linkBlue">(?)<span>네임드 NPC에게는 영향을 미치지 않습니다. 각 부위의 순결은 개별적으로 생성되므로, 다양한 조합이 가능합니다.</span></mouse>
				</span>
				<<numberslider "$settings.npcVirginChanceAdult" $settings.npcVirginChanceAdult 0 100 1>>
			</div>
			<div class="settingsToggleItemWide numberslider-inline">
				<span class="gold">어두운 피부를 가진 NPC일 확률:</span>
				<<numberslider "$settings.darkSkinChance" $settings.darkSkinChance 0 100 1>>
			</div>
		</div>
	</div>
<</widget>>

<<widget "maleChanceSplitControls">>
	<div class="numberslider-inline maleChanceMale">
		<span class="gold">남성에게 끌리는 일반 NPC 비율 <mouse class="tooltip linkBlue">(?)<span>마을에서 보이는 남/남 커플의 수에 영향을 줍니다. <i class="blue none">만약 당신이 남성처럼 보인다면, 당신에게 이끌리는 NPC들은 이 설정을 따르게 됩니다.</i></span></mouse></span>
		<div class="numberSliderCompare">
			<<numberslider "$settings.maleChanceMale" $settings.maleChanceMale 0 100 1 {
			value: v => {
				switch (v) {
					case 0:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span> 전원과 <span class='blue inline-colour'>남성</span> <span class='gold inline-colour'>0%</span>가 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
					case 100:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span> <span class='gold inline-colour'>0%</span>와 <span class='blue inline-colour'>남성</span> 전원이 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
					default:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>남성</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
				}
			},
		}>>
		</div>
	</div>

	<div class="numberslider-inline maleChanceFemale">
		<span class="gold">여성에게 끌리는 일반 NPC 비율: <mouse class="tooltip linkBlue">(?)<span>마을에서 보이는 여/여 커플의 수에 영향을 줍니다. <i class="pink none">만약 당신이 여성처럼 보인다면, 당신에게 이끌리는 NPC들은 이 설정을 따르게 됩니다.</i></span></mouse></span>
		<div class="numberSliderCompare">
			<<numberslider "$settings.maleChanceFemale" $settings.maleChanceFemale 0 100 1 {
			value: v => {
				switch (v) {
					case 0:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span> 전원과 <span class='blue inline-colour'>남성</span> <span class='gold inline-colour'>0%</span>가 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
					case 100:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span> <span class='gold inline-colour'>0%</span>와 <span class='blue inline-colour'>남성</span> 전원이 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
					default:
						return `<span class="small-description"><span class='pink inline-colour'>여성</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>남성</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
				}
			},
		}>>
		</div>
	</div>
<</widget>>

<<widget "beastSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				<<= $settings.monsterChance is 100 ? "수인" : "짐승">> 설정
			</div>
			<div class="settingsToggleItem">
				<<beastAttractionSettings>>
			</div>
			<div class="settingsToggleItem">
				<<monsterSettings>>
			</div>
		</div>
		<hr>
		<div class="settingsToggleIndent">
			<span class="red">수간을 비활성화하더라도 몬스터 소녀 및 소년과의 야한 이벤트는 발생할 수 있습니다.</span>
		</div>
		<div class="settingsGrid">
			<div class="settingsHeader">
				짐승 설정
			</div>
			<div class="settingsToggleButton" class="link-internal macro-button">
				<<run beastTogglesCheck()>>
				<<button `"모든 짐승 " + (_anyBeastOn ? "비활성화" : "활성화")`>>
					<<script>>
						let val = T.anyBeastOn ? false : true;
						T.beastVars.forEach(x => V.settings[x] = val);
					<</script>>
					<<displaySubsection "beastSettings">>
				<</button>>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.bestialityEnabled" false true autocheck>> 수간 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.swarmsEnabled" false true autocheck>> 군집체(장어 등) 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.parasitesEnabled" false true autocheck>> 기생충 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.tentaclesEnabled" false true autocheck>> 촉수 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.slimesEnabled" false true autocheck>> 슬라임 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.voreEnabled" false true autocheck>> 소프트 보어물(집어삼키기) 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.spidersEnabled" false true autocheck>> 거미 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.slugsEnabled" false true autocheck>> 민달팽이 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.waspsEnabled" false true autocheck>> 말벌 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.beesEnabled" false true autocheck>> 벌 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.lurkersEnabled" false true autocheck>> 럴커 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.horsesEnabled" false true autocheck>> <<= $settings.monsterChance is 100 ? "켄타우로스" : $settings.monsterChance is 0 ? "말" : "말과 켄타우로스">> 활성화
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.plantsEnabled" false true autocheck>> 식물 수인 활성화
				</label>
			</div>
		</div>
	</div>
<</widget>>

<<widget "beastMaleChanceSplitControls">>
	<div class="numberslider-inline beastMaleChanceMale">
		<span class="gold">남성에게 끌리는 짐승 <mouse class="tooltip linkBlue">(?)<span>목격되는 수컷/수컷 짐승 짝짓기의 빈도에 영향을 미칩니다. <i class="blue none">당신이 남성으로 보일 경우, 당신에게 끌리는 NPC들은 이 패턴을 따르게 됩니다.</i></span></mouse></span>
		<div class="numberSliderCompare">
			<<numberslider "$settings.beastMaleChanceMale" $settings.beastMaleChanceMale 0 100 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description"><span class='gold inline-colour'>모든</span> <span class='pink inline-colour'>암컷 짐승</span>은 남성에게 끌리지만, <span class='blue inline-colour'>수컷 짐승</span>은 <span class='gold inline-colour'>아무도</span> <span class='blue inline-colour'>남성에게 끌리지 않습니다</span>.</span>`;
						case 100:
							return `<span class="small-description"><span class='pink inline-colour'>암컷 짐승</span>은 <span class='gold inline-colour'>아무도</span> 남성에게 끌리지 않지만, <span class='gold inline-colour'>모든</span> <span class='blue inline-colour'>수컷 짐승</span>은 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
						default:
							return `<span class="small-description"><span class='pink inline-colour'>암컷 짐승</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>수컷 짐승</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='blue inline-colour'>남성에게 끌립니다</span>.</span>`;
					}
				},
			}>>
		</div>
	</div>
	<div class="numberslider-inline beastMaleChanceFemale">
		<span class="gold">여성에게 끌리는 짐승 <mouse class="tooltip linkBlue">(?)<span>목격되는 암컷/암컷 짐승 짝짓기의 빈도에 영향을 미칩니다. <i class="pink none">당신이 여성으로 보일 경우, 당신에게 끌리는 NPC들은 이 패턴을 따르게 됩니다.</i></span></mouse></span>
		<div class="numberSliderCompare">
			<<numberslider "$settings.beastMaleChanceFemale" $settings.beastMaleChanceFemale 0 100 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description"><span class='gold inline-colour'>모든</span> <span class='pink inline-colour'>암컷 짐승</span>은 여성에게 끌리지만, <span class='blue inline-colour'>수컷 짐승</span>은 <span class='gold inline-colour'>아무도</span> <span class='pink inline-colour'>여성에게 끌리지 않습니다</span>.</span>`;
						case 100:
							return `<span class="small-description"><span class='pink inline-colour'>암컷 짐승</span>은 <span class='gold inline-colour'>아무도</span> 여성에게 끌리지 않지만, <span class='gold inline-colour'>모든</span> <span class='blue inline-colour'>수컷 짐승</span>은 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
						default:
							return `<span class="small-description"><span class='pink inline-colour'>암컷 짐승</span>의 <span class='gold inline-colour'>${100 - v}%</span>와 <span class='blue inline-colour'>수컷 짐승</span>의 <span class='gold inline-colour'>${v}%</span>가 <span class='pink inline-colour'>여성에게 끌립니다</span>.</span>`;
					}
				},
			}>>
		</div>
	</div>
<</widget>>

<<widget "fetishSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.analEnabled" false true autocheck>> 애널 활성화
			</label>
		</div>

		<div class="settingsToggleItem" role="group" aria-labelledby="settingsAnalingusHead">
			<span id="settingsAnalingusHead">애널링구스:</span>
			<label>
				<<checkbox "$settings.analingusGivingEnabled" false true autocheck>> 하기
			</label>

			<label>
				<<checkbox "$settings.analingusReceivingEnabled" false true autocheck>> 받기
			</label>
		</div>

		<div class="settingsToggleItem" role="group" aria-labelledby="settingsDoubleHead">
			<span id="settingsAnalingusHead">이중 삽입:</span>
			<label>
				<<checkbox "$settings.vaginalDoubleEnabled" false true autocheck>> 보지
			</label>
			<label data-target="settingsanalEnabled" data-disabledif="V.settings.analEnabled===false">
				<<checkbox "$settings.analDoubleEnabled" false true autocheck>> 애널
			</label>
			<mouse class="tooltip linkBlue">(?)<span>이중 애널 삽입은 애널이 활성화되어 있어야 합니다.
			<br>여기서 "이중 삽입"은 플레이어의 동일한 구멍에 두 개의 남근이 삽입되는 것을 의미합니다.</span></mouse>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.pubicHairEnabled" false true autocheck>> 음모 성장 활성화
			</label>
		</div>

		<div class="settingsToggleItem" role="group">
			변신:
			<label><<checkbox "$settings.transformAnimalEnabled" false true autocheck>> 동물화</label>
			<label><<checkbox "$settings.transformDivineEnabled" false true autocheck>> 신성화</label>
			<mouse class="tooltip linkBlue">(?)<span>신성화와 동물화 변신은 각각 1개씩 동시에 가질 수 있습니다.</span></mouse>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.breastFeedingEnabled" false true autocheck>> 수유 활성화
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.watersportsEnabled" false true autocheck>> 워터스포츠(방뇨) 활성화
				<mouse class="tooltip linkBlue">(?)<span>워터스포츠는 소변을 보는 것과 관련된 성적 행위를 뜻합니다.</span></mouse>
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.footFetishEnabled" false true autocheck>> 발 페티시 활성화
				<mouse class="tooltip linkBlue">(?)<span>비활성화해도 플레이어의 발 자체가 사라지지는 않습니다.</span></mouse>
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.facesitEnabled" false true autocheck>> 얼굴에 앉기(안면승마) 활성화
				<mouse class="tooltip linkBlue">(?)<span>비활성화해도 커닐링구스(보지핥기)가 방지되지는 않습니다.</span></mouse>
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.hypnosisEnabled" false true autocheck>> 최면 활성화
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.forcedCrossdressingEnabled" false true autocheck>> 강제 크로스드레싱 활성화
			</label>
		</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$settings.ruinedOrgasmEnabled" false true autocheck>> 망가진 절정 활성화
				<mouse class="tooltip linkBlue">(?)<span>귀 슬라임 전용입니다.</span></mouse>
			</label>
		</div>

		<div class="settingsToggleItem" role="group" aria-labelledby="settingsToysHead">
			<span id="settingsSexToysHead">섹스 토이:</span>
			<br>
			<label>
				<<checkbox "$settings.toyDildoEnabled" false true autocheck>> 딜도
			</label>
			<label>
				<<checkbox "$settings.toyWhipEnabled" false true autocheck>> 채찍
			</label>
			<label>
				<<checkbox "$settings.toyMultiplePenetrationEnabled" false true autocheck>> 장난감 동시 삽입
			</label>
			/*<label>
				<<checkbox "$toyvirginitydisable" "t" "f" autocheck>> Take virginity
			</label>*/
			<mouse class="tooltip linkBlue">(?)<span>"딜도"는 딜도, 애널 비즈 등 삽입형 장난감을 뜻합니다. 페니스 밴드(스트랩온)는 비활성화되지 않습니다.<br>"채찍"은 승마용 채찍과 일반 채찍을 포함합니다. 스팽킹 장면에서는 채찍이 제거되지 않습니다.<br>"장난감 동시 삽입"을 켜면, 성행위 중 장난감이 함께 삽입될 수 있습니다. (예: 보지에 자지와 딜도가 동시에 삽입됨)</span></mouse>
		</div>

		<div class="settingsToggleItem">
			몸 낙서:
			<<numberslider "$settings.bodyWritingLevel" $settings.bodyWritingLevel 0 3 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description">NPC가 당신의 몸에 낙서할 수 <span class='green inline-colour'>없습니다</span>.</span>`;
						case 1:
							return `<span class="small-description">NPC가 몸에 낙서해도 되는지 <span class='blue inline-colour'>물어볼 수 있습니다</span>.</span>`;
						case 2:
							return `<span class="small-description">NPC가 당신의 몸에 <span class='purple inline-colour'>강제로</span> 낙서할 수 있습니다.</span>`;
						case 3:
							return `<span class="small-description">NPC가 당신의 몸에 <span class='red inline-colour'>강제로</span> 낙서하거나 <span class='red inline-colour'>문신</span>을 새길 수 있습니다.</span>`;
						default:
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
		</div>

		<div class="settingsToggleItem">
			질식:
			<<numberslider "$settings.asphyxiaLevel" $settings.asphyxiaLevel 0 4 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description">목은 건드리지 마세요!</span>`;
						case 1:
							return `<span class="small-description">NPC가 당신의 목을 <span class='blue inline-colour'>붙잡을 수 있습니다</span>. 호흡을 방해하지는 않습니다.</span>`;
						case 2:
							return `<span class="small-description">NPC가 합의된 성관계 중 당신을 <span class='purple inline-colour'>조르려 할 수 있습니다</span>.</span>`;
						case 3:
							return `<span class="small-description">NPC가 비동의 성관계 중 당신의 <span class='red inline-colour'>목을 조르려 할 수 있습니다</span>.</span>`;
						case 4:
							return `<span class="small-description">NPC가 비동의 성관계 중 <span class='red inline-colour'>자주</span> 당신의 <span class='red inline-colour'>목을 조르려 할 수 있습니다</span>.</span>`;
						default:
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
		</div>

		<div class="settingsToggleItem">
			<<if !$femininityModifier>><<set $femininityModifier to {}>><</if>>
			나체 성별 외형:
			<<numberslider "$settings.nudeGenderPerception" $settings.nudeGenderPerception 0 2 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description">NPC는 당신의 성별 외형을 판단할 때 성기를 <span class='blue inline-colour'>무시합니다</span>.</span>`;
						case 1:
							return `<span class="small-description">NPC는 당신의 성별 외형을 판단할 때 성기를 <span class='purple inline-colour'>고려합니다</span>.</span>`;
						case 2:
							return `<span class="small-description">NPC는 당신의 성별 외형을 성기에 따라 <span class='red inline-colour'>판단합니다</span>.</span>`;
						default:
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
		</div>
		</div>
	</div>
<</widget>>

<<widget "priceSettings">>
	<div class="solidBorderContainer clothes-price-container">
		<div class="settingsGrid">
			<div class="settingsHeader">
				베일리의 상납금
			</div>
			<div class="settingsToggleItemWide">
				<div class="small-description">
					베일리가 매주 요구하는 상납금의 액수를 조절합니다. 기본값은 100%입니다. <br>
					<span class="red">이 값을 100% 미만으로 설정하면 해당 세이브에서 업적을 얻을 수 없게 됩니다.</span>
				</div>
				<div class="ironman-slider" id="sliderRentMode">
					<<numberslider "$settings.rentCostModifier" $settings.rentCostModifier 0.1 3 0.1 $ironmanmode>>
				</div>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				상점 물가
			</div>
			<div class="settingsToggleItem">
				<div>
					<span class="gold">의류 가격:</span>
					<div class="small-description">의류 아이템의 비용을 조절합니다. 이는 구매, 자동 재구매, 그리고 수선 비용을 모두 포함합니다. 수건은 항상 무료입니다.</div>
				</div>
				<hr style="border-top:1px solid var(--700)">
				<div>
					<span class="gold">모든 의류 가격:</span>
					<div class="small-description">하드 모드로는 200%를 추천합니다.</div>
					<<numberslider "$settings.clothingCostModifier" $settings.clothingCostModifier 1 10 0.5>>
				</div>
			</div>
			<div class="settingsToggleItem">
				<div>
					<span class="gold">속옷 가격:</span>
					<<numberslider "$settings.underwearCostModifier" $settings.underwearCostModifier 1 2 0.1>>
				</div>
				<hr style="border-top:1px solid var(--700)">
				<div>
					<span class="gold">학교 교복 가격:</span>
					<<numberslider "$settings.schoolClothingCostModifier" $settings.schoolClothingCostModifier 1 2 0.1>>
				</div>
				<hr style="border-top:1px solid var(--700)">
				<div>
					<span class="gold">음란한 옷 가격:</span>
					<<numberslider "$settings.lewdClothingCostModifier" $settings.lewdClothingCostModifier 0.1 2 0.1>>
				</div>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold">가구 가격:</span>
				<div class="small-description">가구의 가격을 조절합니다.</div>
				<div class="ironman-slider" id="slider-furniture-price-factor">
					<<numberslider "$settings.furnitureCostModifier" $settings.furnitureCostModifier 0.6 5 0.2 $ironmanmode>>
				</div>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				작물 수확량
			</div>
			<div class="settingsToggleItemWide">
				<div class="small-description">수확되는 작물의 양을 조절합니다. 기본값은 500%입니다. 100%는 (기존) 하드 모드입니다.</div>
					<span class="red">이 값을 500%보다 높게 설정하면 해당 세이브에서 위업을 달성할 수 없습니다.</span>
				<div class="ironman-slider" id="sliderTendingYieldFactor">
					<<numberslider "$settings.tendingYieldModifier" $settings.tendingYieldModifier 1 10 1 $ironmanmode>>
				</div>
			</div>
		</div>
	</div>
		<!-- Make it show % instead of fractions and add some colour -->
		<<run $(() => { $('.clothes-price-container input').on('input change', e => {
				let valSpan = $(e.currentTarget).siblings().first();
				let value = valSpan.text();

				valSpan.text((i, value) => Math.round(value * 100) + '%');

				if (value > 1)
					valSpan.css('color', 'gold');
				else if (value < 1)
					valSpan.css('color', 'green');
				else
					valSpan.css('color', 'unset');
			}).trigger('change') })>>
		<!-- Set the initial minimum -->
		<<run $(() => {
			let newmin = parseFloat((Math.ceil(10 / $('#numberslider-input-settingsclothingcostmodifier').val()) * 0.1).toFixed(1));
			let oldval = V.settings.lewdClothingCostModifier;
			$('#numberslider-input-settingslewdclothingcostmodifier').attr('min', newmin).val(oldval).trigger('change');
		})>>
		<!-- Limit lewd slider so that all coef * lewd coef >= 100% -->
		<<run $(() => {
			$('#numberslider-input-settingsclothingcostmodifier').on('input change', e => {
				let newmin = parseFloat((Math.ceil(10 / $(e.currentTarget).val()) * 0.1).toFixed(1));
				let oldval = V.settings.lewdClothingCostModifier;
				$('#numberslider-input-settingslewdclothingcostmodifier').attr('min', newmin).val(oldval).trigger('change');
			})
		})>>
<</widget>>

<<widget "incompletePregnancy">>
	<<checkbox "$settings.incompletePregnancyEnabled" false true autocheck>> 미완성 임신 콘텐츠 활성화
	<<if _foundPregnancy>>
		<mouse class="tooltip linkBlue">(!!!)<span>네임드 NPC가 임신 중일 때는 비활성화할 수 없습니다.</span></mouse>
	<<else>>
		<mouse class="tooltip linkBlue">(?)<span>
			<div>활성화하면, 플레이어는 임신 가능한 모든 네임드 NPC를 임신시키거나 NPC에게 임신신 당할 수 있게 됩니다. 이는 임신 관련 상호작용이 없는 NNPC도 포함합니다. 비활성화하면, 콘텐츠가 미완성인 NNPC는 설정에서 임신 관련 토글이 회색으로 비활성화됩니다.</div>
			<div class="red">경고: 이로 인해 네임드 NPC가 플레이어의 임신이나 자신의 임신에 반응하지 않는 상황이 발생할 수 있으며, 기존 세이브 파일이 향후 업데이트될 콘텐츠를 건너뛰게 될 수 있습니다.</div>
		</span></mouse>
	<</if>>
<</widget>>

<<widget "fertilityCycles">>
	<<checkbox "$settings.fertilityCycleEnabled" false true autocheck>> 배란 주기 활성화
	<mouse class="tooltip linkBlue">(?)<span>
		<div>활성화하면, 플레이어의 월경 주기가 임신 가능 여부를 결정합니다.</div>
		<div>비활성화하면 가임률이 항상 최고치로 유지됩니다. 발정기가 더 이상 적용되지 않습니다. 가임 촉진제로 인한 발정과 흥분은 영향을 받지 않습니다.</div>
	</span></mouse>
<</widget>>

<<widget "pregnancyType">>
	<label><<radiobutton "$settings.pregnancyType" "realistic" autocheck>> <mouse class="tooltip green">현실적<span>임신이 바로 진행되지 않으며, 임신이 되었는지 즉시 알 수 없습니다. 임신 테스트기를 사용해야 할 수도 있으며, 처음에는 아버지가 누구인지 모를 수 있습니다. 수 시간 안에 씻어내지 않으면 보지 바깥에 묻은 정액으로도 임신할 수 있습니다.</span></mouse></label> |
	<label><<radiobutton "$settings.pregnancyType" "fetish" autocheck>> <mouse class="tooltip pink">페티시<span>정액이 몸 안에 들어가는 즉시 임신이 될 수 있습니다. 임신이 되는 순간 바로 알 수 있으며, 아버지가 누구인지 즉시 알 수 있습니다.</span></mouse></label>
<</widget>>

<<widget "pregnancySettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="red">이 설정들을 변경하더라도 현재 진행 중인 임신이 중단되거나 플레이어가 자식들과 상호작용하는 것을 막지는 못합니다.</span>
			</div>
			<div class="settingsHeader">
				임신 확률
			</div>
			<div class="settingsToggleItem numberslider-inline basePlayerPregnancyChance-container">
				<span class="gold">기본 플레이어 임신 확률:</span>
				<<numberslider "$settings.basePlayerPregnancyChance" $settings.basePlayerPregnancyChance 0 100 1>>
				<div class="small-description">가임력이 최고조일 때, 하루마다 정액 한 회분이 당신을 임신시킬 확률입니다. 한 회분의 정액은 남아있는 동안 계속 확률을 유지하므로 매일 다시 판정합니다. 일부 이벤트로 인해 두 회분 이상의 정액이 남을 수도 있습니다.<br>
				<span class="green">현실적</span> 모드에서는 배란 주기 등 다른 요소들이 가임력을 변화시켜 임신 확률을 늘리거나 줄일 수 있습니다. 안전한 날에는 이 설정을 높여도 확률이 여전히 0에 가까울 수 있습니다.<br>
				<span class="pink">판타지</span> 모드에서는 정액 한 회분이 몸에 닿는 순간의 수정 확률을 뜻합니다. 끄지 않는 한 피임약과 배란 주기는 여전히 적용됩니다.</div>
			</div>
			<<run $(() => { $('.basePlayerPregnancyChance-container input').on('input change', e => {
				let valSpan = $(e.currentTarget).siblings().first();
				let value = valSpan.text();

				valSpan.text((i, value) => value + "%");
			}).trigger('change') })>>

			<div class="settingsToggleItem numberslider-inline basenpcpregnancychance-container">
				<span class="gold">기본 NPC 임신 확률:</span>
				<<numberslider "$settings.baseNpcPregnancyChance" $settings.baseNpcPregnancyChance 0 100 1>>
				<div class="small-description">가임력이 최고조일 때 삽입 사정으로 NPC가 임신할 확률입니다. <br>
				참고: 일부 NNPC는 피임약이나 가임 촉진제를 복용할 수 있으며, 이는 이 확률에 영향을 줍니다.</div>
			</div>
			<<run $(() => { $('.basenpcpregnancychance-container input').on('input change', e => {
				let valSpan = $(e.currentTarget).siblings().first();
				let value = valSpan.text();

				valSpan.text((i, value) => value + "%");
			}).trigger('change') })>>
			<div class="settingsToggleItem">
				<label>
					임신 유형:
					<<pregnancyType>>
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<fertilityCycles>>
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.playerPregnancyHumanEnabled" false true autocheck>> 플레이어의 인간 아이 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.playerPregnancyBeastEnabled" false true autocheck>> 플레이어의 짐승 아이 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.npcPregnancyEnabled" false true autocheck>> 일반 NPC 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.nnpcPregnancyEnabled" false true autocheck>> 네임드 NPC/러브 인터레스트 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">플레이어 항문 임신:</span> <mouse class="tooltip linkBlue">(?)<span>
					<div>기본적으로 비활성화되어 있습니다. 켜면 플레이어 캐릭터가 항문으로 임신하고 출산할 수 있게 됩니다. 끄면 항문으로는 임신할 수 없습니다. "특수한 상황"으로 설정하면, 게임 내의 특정 방법을 통해서만 항문 임신이 가능합니다.</div>
					<div><div class="red">참고: 이것은 기생체와는 별개의 토글입니다. 기생체는 이 설정을 끄지 않는 한 질/항문으로 여전히 당신을 임신시킬 수 있습니다.</div></div>
				</span></mouse>
				<br>
				<label><<radiobutton "$settings.analPregnancy" "exceptional" autocheck>> 특수한 상황</label> |
				<label><<radiobutton "$settings.analPregnancy" "always" autocheck>> 켜짐</label> |
				<label><<radiobutton "$settings.analPregnancy" false autocheck>> 꺼짐</label>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">NPC 항문 임신:</span> <mouse class="tooltip linkBlue">(?)<span>
					<div>기본적으로 비활성화되어 있습니다. 켜면 NPC가 항문으로 임신할 수 있게 되며, 세계는 이를 일반적인 임신처럼 취급합니다. 끄면 항문 임신이 불가능합니다. 항문 임신은 네임드 NPC별로 각자의 설정에서 개별적으로 켜고 끌 수도 있습니다.</div>
					<div><div class="red">참고: 항문 임신이 작동하려면 임신 자체도 켜져 있어야 합니다. 미완성 임신 콘텐츠도 켜야 할 수 있습니다. 질을 가진 NPC도 설정에서 끄지 않는 한 항문으로 임신될 수 있습니다.</div></div>
				</span></mouse>
				<br>
				<label><<radiobutton "$settings.npcAnalPregnancyEnabled" true autocheck>> 켜짐</label> |
				<label><<radiobutton "$settings.npcAnalPregnancyEnabled" false autocheck>> 꺼짐</label>
			</div>
			<<set _foundPregnancy to !!Object.values($NPCName).find(npc => npc.pregnancy && npc.pregnancy.enabled && getActivePregnancies(npc.fullDescription).length && !setup.pregnancy.canBePregnant.includes(npc.fullDescription))>>
			<span data-target='["settingsincompletepregnancyenabled", "settingsnnpcpregnancyenabled", "settingsplayerpregnancyhumanenabled", "settingsplayerpregnancybeastenabled"]' data-disabledif="(T.foundPregnancy&&V.settings.incompletePregnancyEnabled===true)||(!V.settings.nnpcPregnancyEnabled&&!V.settings.playerPregnancyHumanEnabled&&!V.settings.playerPregnancyBeastEnabled)">
				<div class="settingsToggleItem humanPregnancyMonths-container">
					<label>
						<<incompletePregnancy>>
					</label>
				</div>
			</span>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				임신 기간
			</div>
			<<if playerPregnancyProgress() gte 0.9>>
				<span class="red">현재 임신 막바지에 다다랐기 때문에, 임신 기간 설정을 변경할 수 없습니다.</span>
			<</if>>
				<div class="settingsToggleItem numberslider-inline humanPregnancyMonths-container" data-target="humanPregnancyMonths" @data-disabledif="playerPregnancyProgress() gte 0.9">
					<span class="gold">인간 임신 기간:</span>
					<<numberslider "$settings.humanPregnancyMonths" $settings.humanPregnancyMonths 1 9 1 { value: (v) => v + "개월" }>>
				</div>
				<div class="settingsToggleItem numberslider-inline wolfPregnancyWeeks-container" data-target="wolfPregnancyWeeks" @data-disabledif="playerPregnancyProgress() gte 0.9">
					<span class="gold">늑대 임신 기간:</span>
					<<numberslider "$settings.wolfPregnancyWeeks" $settings.wolfPregnancyWeeks 2 12 1 { value: (v) => v + "주" }>>
				</div>
				<<run $(() => { $('.humanPregnancyMonths-container input, .wolfPregnancyWeeks-container input').on('input change', e => {
					if(V.feats.pregnancyLocked){
						$('#pregnancyFeatsDisabled').text("일부 임신 업적이 비활성화되었습니다.");
						$('#pregnancyFeatsDisabled').css('display', 'block');
					} else if(V.settings.humanPregnancyMonths < 3 || V.settings.wolfPregnancyWeeks < 4){
						$('#pregnancyFeatsDisabled').text("일부 임신 업적이 비활성화됩니다.");
						$('#pregnancyFeatsDisabled').css('display', 'block');
					} else{
						$('#pregnancyFeatsDisabled').text("");
						$('#pregnancyFeatsDisabled').css('display', 'none');
					}
				}).trigger('change') })>>
				<div id="pregnancyFeatsDisabled" class="red"></div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				임신 설정 토글
			</div>
			<div class="settingsToggleItem">
				콘돔
				<<numberslider "$settings.condomLevel" $settings.condomLevel 0 3 1 {
				value: v => {
					switch (v) {
						case 0:
							return `<span class="small-description"><span class='red inline-colour'>모두가 라텍스와 안전한 성관계에 알레르기가 있습니다.</span></span>`;
						case 1:
							return `<span class="small-description">오직 <span class='green inline-colour'>당신</span>만이 콘돔을 사용할 수 있습니다. NPC에게 콘돔을 줄 수는 있습니다.</span>`;
						case 2:
							return `<span class="small-description">NPC들은 그들과 플레이어 사이에 <span class='blue inline-colour'>임신</span>이 가능할 때만 콘돔을 소지합니다.</span>`;
						case 3:
							return `<span class="small-description">NPC들은 <span class='pink inline-colour'>그들이 원할 때마다</span> 콘돔을 소지하고 사용할 수 있습니다.</span>`;
						default:
							return `<span class="small-description">오류: 잘못된 값: " + ${v}`;
					}
				}
			}>>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.parasitePregnancyEnabled" false true autocheck>> 기생충 임신 켜기
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.playerPregnancyEggLayingEnabled" false true autocheck>> 산란 켜기
					<mouse class="tooltip linkBlue">(?)<span>매와 하피를 임신시키거나 임신하기 위해 필요합니다.</span></mouse>
				</label>
			</div>
			<div class="settingsToggleItem">
				<label>
					<<checkbox "$settings.pregnancySpeechEnabled" false true autocheck>> 수정/가임 언급 켜기
					<mouse class="tooltip linkBlue">(?)<span>PC가 임신하거나 다른 사람을 임신시키는 것에 대한 언급을 허용합니다. 비활성화하더라도 다른 임신 설정이 켜져 있을 경우 임신과 관련된 모든 언급이 사라지지는 않습니다.</span></mouse>
				</label>
			</div>
			<<if $debug is 1>>
				디버그:
				<br>
				<span class="gold">NPC들이 콘돔을 소지할 확률</span>
				<br>
				<<numberslider "$settings.condomChance" $settings.condomChance 0 100 1>>
				<br><br>

				<span class="gold">NPC들이 요청받지 않아도 콘돔을 사용할 확률...</span>
				<br>
				...강간 중
				<<numberslider "$settings.condomUseChanceRape" $settings.condomUseChanceRape 0 100 1>>
				<br>
				...합의된 성관계 중
				<<numberslider "$settings.condomUseChanceConsensual" $settings.condomUseChanceConsensual 0 100 1>>
				<br>
			<</if>>
		</div>
	</div>
<</widget>>

<<widget "skinColourVariableCombine">>
	<<set $player.skin.color to _skinTone + _skinShade>>
<</widget>>

<<widget "sizeLimitsSettings">>
	<div class="settingsGrid">
		<div class="settingsHeader">
			신체 부위 크기 제한 <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>음란한 행위나 경험에 참여함에 따라, 신체 부위가 커지거나 작아질 수 있습니다. 수술, 알약, 기생충 등이 크기에 영향을 줄 수 있는 조건 중 일부입니다.</span>">(?)</span>
		</div>

		<div class="settingsToggleItemWide">
			<span class="gold">가슴 크기 제한:</span> <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>이미 최소 크기보다 작은 가슴은 자동으로 커지지 않습니다.">(?)</span>
			<br>
			<<rangeslider "$breastsizemin" "$breastsizemax" $breastsizemin $breastsizemax 0 12 1
				{
					minClamp: 5,
					minClampMessage: `<span class="red">최소 크기를 더 이상 올릴 수 없습니다.</span>`
				}
				{
					value: (v1, v2) => {
						const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 12, 0));
						const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 12, 0));
						var name = ["납작한", "아주 작은", "작은", "봉긋한", "볼륨있는", "글래머한", "꽉 찬", "풍만한", "큰", "커다란", "거대한", "엄청난", "어마어마한"];
						return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
					},
				}
			>>
		</div>

		<div class="settingsToggleItemWide">
			<span class="gold">엉덩이 크기 제한:</span> <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>이미 최소 크기보다 작은 엉덩이는 자동으로 커지지 않습니다.</span>">(?)</span>
			<br>
			<<rangeslider "$bottomsizemin" "$bottomsizemax" $bottomsizemin $bottomsizemax 0 8 1
				{
					minClamp: 3,
					minClampMessage: `<span class="red">최소 크기를 더 이상 올릴 수 없습니다.</span>`
				}
				{
					value: (v1, v2) => {
						const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 8, 0));
						const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 8, 0));
						var name = ["납작한", "아담한", "둥근", "부드러운", "통통한", "꽉 찬", "풍만한", "큰", "거대한"];
						return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
					},
				}
			>>
		</div>

		<<if ($passage is "Start" and $player.sex isnot "f") or $player.penisExist>>
			<div class="settingsToggleItemWide">
			<span class="gold">자지 크기 제한:</span> <span class="tooltip-anchor linkBlue" tooltip="<span class='linkBlue'>이미 최소 크기보다 작은 자지는 자동으로 자라지 않습니다.</span>">(?)</span>
			<<rangeslider "$penissizemin" "$penissizemax" $penissizemin $penissizemax 0 6 1
				{
					minClamp: 2,
					minClampMessage: `<span class="red">최소 크기를 더 이상 올릴 수 없습니다.</span>`
				}
				{
					value: (v1, v2) => {
						const color1 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v1, 6, 0));
						const color2 = ColourUtils.interpolateMultiple(["--teal", "--pink"], normalise(v2, 6, 0));
						var name = ["매우 작은","약간 작은", "작은", "보통", "큰", "매우 큰", "거대한"];
						return `<span style="color: ${color1}">${name[v1]}</span> - <span style="color: ${color2}">${name[v2]}</span>`;
					},
				}

			>>
			</div>
		<</if>>
	</div>
<</widget>>

<<widget "gallerySettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settings-intro">
		갤러리 옵션은 세이브 데이터에 아무런 영향을 주지 않습니다.
		<hr>
		<<if version.major gt 2 or version.minor gt 29>>
			<span class="bold">
				<<link [[캐릭터 뷰어|Clothes Testing]]>>
					<<set $lastPassage to $passage>>
				<</link>>
			</span>
			- 캐릭터 스프라이트를 가지고 놀 수 있습니다.
			<br>
		<</if>>
		<br>
		<<if $passage isnot "Start">>
			<span class="bold">
				<<link [[장면 뷰어|Scene Viewer]]>>
					<<set $lastPassage to $passage>>
					<<seenPassageChecks>>
				<</link>>
			</span>
			- 잠금 해제한 장면들을 다시 볼 수 있습니다.
			<br>
		<<else>>
			<span class=" red bold">장면 뷰어</span> - 시작 페이지에서는 접근할 수 없습니다. 게임을 진행하며 특별한 장면들을 해금할 수 있습니다. 해금된 장면들은 침실의 <span class="gold">게임플레이 설정</span> 링크를 통해 갤러리의 장면 뷰어에 들어가 다시 재생할 수 있습니다.
			<br>
		<</if>>
		/*<br>
		<span class="bold">
			<<link [[Test Renderer|Renderer Test Page]]>>
				<<set $lastPassage to $passage>>
			<</link>>
		</span>
		- This will check your browser's capabilities required for new renderer.
		<br>*/
		<br>
		<span class="bold">
			<<link [[도움말 갤러리|Tips]]>>
				<<set $lastPassage to $passage>>
			<</link>>
		</span>
	- Degrees of Lewdity에서 제공하는 힌트와 팁의 전체 목록을 확인합니다. 게임을 진행하는 동안 사이드바에 이 팁들이 무작위로 나타나며, <span class="gold">옵션</span> 버튼을 통해 비활성화할 수도 있습니다.
		</div>
	</div>
<</widget>>

<<widget "faceVariantSettings">>
	<<set _variants = Object.entries(setup.faceVariantOptions[$facestyle])>>
	<<for _i, _variant range _variants>>
		<label><<= _variant[0]>> <<radiobutton "$facevariant" _variant[1] autocheck>></label>
		<<= _i < _variants.length - 1 ? "|" : "">>
	<</for>>
<</widget>>

<<widget "npcSettings">>
	<div class="solidBorderContainer settings-container">
		<div class="settingsToggleIndent">
			<span class="gold">네임드 NPC에게 무작위 할당:</span> <mouse class="tooltip linkBlue">(?)<span>설정은 일반 NPC 설정을 기반으로 생성됩니다.</span></mouse>
			<br>
			<<link "성별">>
				<<initnpcgender "genders">>
				<<updatePersistentNPCs "genders">>
				<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
			<</link>>
			|
			<<link "자지 크기">>
				<<initnpcgender "penis">>
				<<updatePersistentNPCs "penis">>
				<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
			<</link>>
			|
			<<link "가슴 크기">>
				<<initnpcgender "breasts">>
				<<updatePersistentNPCs "breasts">>
				<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
			<</link>>
			|
			<<link "피부색">>
				<<initnpcskin "skincolour">>
				<<updatePersistentNPCs "skincolour">>
				<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
			<</link>>
			<<if $debug is 1>>
				|
				<<link "머리색과 눈색 초기화 (기본 색상을 가진 NPC에게만 영향을 미침)">>
					<<generateNPCNameHairAndEyeColors "default">>
					<<displaySettings>>
				<</link>>
			<</if>>
		</div>
		<div class="settingsToggleIndent">
			<<foldout false "_gender">>
				<span class="gold">모든 네임드 NPC에게 할당:</span>
				성별:
				<<link "남성">><<assignAllNPCs "pronoun" "m">><</link>> | <<link "여성">><<assignAllNPCs "pronoun" "f">><</link>>
				<br>
				생식기:
				<<link "자지">><<assignAllNPCs "gender" "m">><</link>> | <<link "보지">><<assignAllNPCs "gender" "f">><</link>>
				<br>
				자지 크기:
				<<set _penisNames to ["", "작은", "보통", "큰", "거대한"]>> /* the empty first element is necessary because _j starts at 1 */
				<<for _j to 1; _j lt _penisNames.length; _j++>>
					<<capture _j>>
						<<link _penisNames[_j]>><<assignAllNPCs "penissize" _j>><</link>>
						<<if _j isnot _penisNames.length -1>>|<</if>>
					<</capture>>
				<</for>>
				<br>
				가슴 크기:
				<<set _breastNames to ["납작한", "아주 작은", "작은", "봉긋한", "볼륨있는", "글래머한", "꽉 찬", "풍만한", "큰", "커다란", "거대한", "엄청난", "어마어마한"]>>
				<<for _k to 0; _k lt _breastNames.length; _k++>>
					<<capture _k>>
						<<link _breastNames[_k]>><<assignAllNPCs "breastsize" _k>><</link>>
						<<if _k isnot _breastNames.length -1>>|<</if>>
					<</capture>>
				<</for>>
				<br>
				피부색:
				<<link "창백함">><<assignAllNPCs "skincolour" "white">><</link>> | <<link "어두움">><<assignAllNPCs "skincolour" "black">><</link>>
			<</foldout>>
		</div>
		<hr>
		<<if _npcId is undefined>>
			<<set _npcId to 25>> /* Should be set to the index of the NPC that is at the top of the list when sorted alphabetically by name */

			<<set _breastDescription to ["납작한", "봉긋한", "볼륨있는", "글래머한", "꽉 찬", "풍만한"]>>
            <<set _breastDescriptionNPC to ["유두", "봉긋한 가슴", "볼륨있는 가슴", "글래머한 가슴", "꽉 찬 가슴", "풍만한 가슴"]>>
            <<set _breastsDescriptionNPC to ["유두", "봉긋한 가슴", "볼륨있는 가슴", "글래머한 가슴", "꽉 찬 가슴", "풍만한 가슴"]>>

			<<set _hairColorNPC to ["빨간색","검은색","갈색","밝은 갈색","금발","플래티넘 블론드","스트로베리 블론드","적갈색", "회갈색"]>>
			<<set _hairColorNPCData to ["red","black","brown","lightbrown","blond","platinumblond","strawberryblond","ginger", "mousy"]>>
			<<set _hairColorNPCText to ["red","black","brown","lightbrown","gold","platinum","strawberry","tangerine", "mousy"]>>

			<<set _eyeColorNPC to ["보라색","진한 파란색","밝은 파란색","호박색","헤이즐","초록색","라임 그린","빨간색","분홍색","회색","밝은 회색"]>>
			<<set _eyeColorNPCData to ["purple","dark blue","light blue","amber","hazel","green", "lime green","red","pink","grey", "light grey"]>>
			<<set _eyeColorNPCText to ["purple","blue","lblue","tangerine","brown","green","lime-green","red","pink","grey", "light-grey"]>>
		<</if>>

		<<if _npcList is undefined>>
			<<set _npcList to {}>>
			<<set _sortedNPCList to clone($NPCNameList).sort()>>

			<<for $_i to 0; $_i lt _sortedNPCList.length; $_i++>>
				<<set _npcList[_sortedNPCList[$_i]] to $NPCNameList.indexOf(_sortedNPCList[$_i])>>
			<</for>>

			<<if $passage is "Start" or !$wraithIntro>>
				<<run delete _npcList["Ivory Wraith"]>>
				<<run _sortedNPCList.delete("Ivory Wraith")>>
			<</if>>

			<<set _npcListKr to {}>>
			<<for $_i to 0; $_i lt _sortedNPCList.length; $_i++>>
				<<set _npcListKr[window.KR.gatPersonNameDictKR(_sortedNPCList[$_i])] to _npcList[_sortedNPCList[$_i]]>>
			<</for>>
		<</if>>

		/* Reseeds named NPC cycle data in case the incomplete pregnancy content setting changed */
		<<npcPregnancyUpdater>>
		<div id="npcSettingsMenu">
			<<npcSettingsMenu>>
		</div>

		<<if $passage isnot "start" and $per_npc and Object.keys($per_npc).length gt 0>>
			<<run
				if (!T.perNPCLock) {
					$(".passage").on('change', '#perNPCSettingsMenu .macro-listbox', function (e) {
						new Wikifier(null, '<<replace #perNPCSettingsMenu>><<perNPCSettingsMenu>><</replace>>');
					});

					T.npcKeys = {};
					T.npcKeyNames = [];
					const allowed_npcs = ["steed", "guard", "inmate", "panty_thief", "school_nurse", "pinch", "black_dog", "hacker", "bishop", "bishop_right_hand", "bishop_left_hand", "manager", "alexs_parent1", "alexs_parent2", "whitneys_auncle", "whitney_parent_flat"];
					setup.pNpcNameKr = {
						"scarred_inmate": "흉터난 수감자",
						"veteran_guard": "베테랑 경비원",
						"anxious_guard": "불안한 경비원",
						"relaxed_guard": "느긋한 경비원",
						"tattooed_inmate": "문신한 수감자",
						"methodical_guard": "체계적인 경비원",
						"farm_tower_guard": "농장 탑 경비원",
						"saddled_steed": "안장 얹은 탈것",
						"chalets_manager": "산장 관리자",
						"black_dog": "검은 개",
						"manager": "관리자",
						"hacker": "해커",
						"bishop": "비숍",
						"bishop_right_hand": "비숍의 오른팔",
						"bishop_left_hand": "비숍의 왼팔",
						"school_nurse": "학교 간호사",
						"panty_thief": "팬티 도둑",
						"pinch": "핀치",
						"alexs_parent1": "알렉스의 부모1",
						"alexs_parent2": "알렉스의 부모2",
						"whitneys_auncle": "휘트니의 삼촌/이모",
						"whitney_parent_flat": "휘트니의 부모"
					};
					Object.keys(V.per_npc).forEach(k => {
						for (const j of allowed_npcs){
							if (k.includes(j)){
								T.npcKeyNames.push(k);
								const displayName = setup.pNpcNameKr[k] || toTitleCase(k.replace(/_/g, ' '));
								T.npcKeys[displayName] = k;
								break
							}
						}
					});
					T.perNPCLock = true;
				}
			>>
			<<if T.npcKeyNames and T.npcKeyNames.length>>
				<hr>
				<div id="perNPCSettingsMenu">
					<<perNPCSettingsMenu>>
				</div>
			<</if>>
		<</if>>

		<<if _listActive isnot true>>
			<<NPCSettingsReset>>
			<<set _listActive to true>>
		<</if>>
	</div>
<</widget>>

<<widget "assignAllNPCs">>
	<<set $_characteristic to _args[0]>>
	<<set $_value to _args[1]>>
	<<for $_i to 0; $_i lt $NPCName.length; $_i++>>
		<<set $NPCName[$_i][$_characteristic] to $_value>>
		<<if $_characteristic is "breastsize">>
			<<set $NPCName[$_i].breastdesc to $_i > 0 ? setup.breastsizes[$_value] + " breast" : "nipple">>
			<<set $NPCName[$_i].breastsdesc to $_i > 0 ? setup.breastsizes[$_value] + " breasts" : "nipples">>
		<</if>>
	<</for>>
	<<if $passage isnot "start" and $per_npc and Object.keys($per_npc).length gt 0>>
		<<for $_i range Object.keys($per_npc)>>
			<<set $per_npc[$_i][$_characteristic] to $_value>>
			<<if $_characteristic is "breastsize">>
				<<set $per_npc[$_i].breastdesc to $_i > 0 ? setup.breastsizes[$_value] + " breast" : "nipple">>
				<<set $per_npc[$_i].breastsdesc to $_i > 0 ? setup.breastsizes[$_value] + " breasts" : "nipples">>
			<</if>>
		<</for>>
	<</if>>
	<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
<</widget>>

<<widget "exportsettings">>
	<div class="solidBorderContainer settings-container">
	<div class="settings-intro">
	<span class="yellow">"세이브/옵션" 오버레이의 설정도 함께 불러오거나 내보냅니다.</span>
	<hr>
	<h4 class="gold">설정 파일 불러오기/내보내기</h4>

	<<if SugarCube.Browser.isMobile.any() is true>>
		현재 안드로이드에서는 파일에서 저장하고 불러오는 기능이 작동하지 않으니 주의하세요.
	<<else>>
		파일에서 불러오기: <input id="saveImport" type="file" value="파일에서 불러오기" onchange="importSettings(this.files, 'file')">
		<br><br>
		<<if $ironmanmode is true>>
			<input type="button" value="파일로 저장" disabled>
		<<else>>
			<input type="button" value="파일로 저장" onclick="exportSettings(null,'file')">
		<</if>>
	<</if>>
	<hr>
	<h4 class="gold">설정 텍스트 내보내기/불러오기</h4>

	<ul>
	<li>현재 설정을 저장하려면 "설정 데이터 내보내기"를 클릭한 후, 필요한 곳에 데이터를 복사해서 붙여넣으세요.</li>
	<li>현재 설정을 불러오려면, 설정 데이터를 붙여넣고 "설정 데이터 불러오기"를 클릭하세요.</li>
	<li>안드로이드와 데이터를 주고받으려면, 이메일이나 pastebin 같은 서비스를 사용하는 것을 권장합니다. 문제가 발생하지 않도록 세이브 데이터의 시작과 끝이 정확한지 확인하세요.</li>
	<li>현재 내용을 복사하려면 "텍스트 영역 복사하기"를 클릭하세요. 기기나 브라우저가 지원하지 않을 경우 버튼 이름이 "복사 오류"로 변경됩니다.</li>
	</ul>
	<textarea id="settingsDataInput" rows="4" cols="40" onClick="if(V.disableAutoSelect == false)this.select();" onfocus="V.tempDisable = true;" onblur="V.tempDisable = false;"></textarea>
	<br>
	<input type="button" value="텍스트 상자 비우기" onclick="clearTextBox('settingsDataInput')"/>
	<input type="button" value="텍스트 상자 맨 위로" onclick="topTextArea('settingsDataInput')"/>
	<input type="button" value="텍스트 상자 맨 아래로" onclick="bottomTextArea('settingsDataInput')"/>
	<input type="button" value="설정 데이터 내보내기" onclick="exportSettings(null,'text')"/>
	<input type="button" value="설정 데이터 불러오기" onclick="importSettings(null,'text')"/>
	<input id="CopyTextArea" type="button" value="텍스트 복사" onclick="copySavedata('settingsDataInput')">
	<input id="LoadExternalExportFile" type="button" value="외부 내보내기 파일 불러오기" onclick="loadExternalExportFile()">

	<br><br>

	<label>
		<<checkbox "$disableAutoSelect" false true autocheck>>
		자동 선택을 비활성화합니다.
	</label>
	</div>
	</div>
<</widget>>

<<widget "startDescriptions">>
	<div class="solidBorderContainer settings-container">
		<div class="settings-intro">
			<<switch _args[0]>>
				<<case "default">><span class="gold bold">기본 시작:</span> 난이도 설정, 사전 설정된 페티시, NPC 성별에 <span class="teal">전반적인 변경</span>을 적용할 수 있습니다. 모든 NPC는 이 설정에 따라 <span class="teal">무작위로</span> 생성됩니다. <i class="teal">초보자에게 권장합니다.</i>
				<<case "custom">><span class="gold bold">커스텀 시작:</span> 페티시 토글, 난이도 설정, NPC 성별을 포함한 <span class="teal">모든 설정</span>을 자유롭게 조정하여 원하는 플레이를 만들 수 있습니다.
				<<case "random">><span class="gold bold">무작위 시작:</span> 캐릭터 외형, 캐릭터 특성, 난이도 설정을 포함한 <span class="teal">모든 설정</span>을 무작위로 정해 게임을 시작합니다. 새로운 플레이를 위해 당신의 캐릭터와 모든 NPC도 <span class="teal">무작위로</span> 생성됩니다. <i><span class="teal">게임 시작 전에 특정 설정만 무작위로 정하고 싶다면, </span> <span class="gold">커스텀 시작</span><span class="teal">을 선택하세요.</span></i>
			<</switch>>
		</div>
	</div>
<</widget>>

<<widget "npcSettingsMenu">>
	<div class="settingsToggleIndent">
		<span class="gold">특정 NPC로 이동: </span>
		<<listbox "_npcId" autoselect>>
			<<optionsfrom _npcListKr>>
		<</listbox>>
	</div>
	<div class="settingsGrid">
		<div class="settingsHeader">
			<<= window.KR.gatPersonNameDictKR($NPCName[_npcId].nam)>> - <span style="text-transform: capitalize;"><<= window.KR.getNpcTitleKr($NPCName[_npcId].title)>></span>
			<span style="font-size:80%">
				<br>
				<<link "이전">>
					<<set _sortedId to _sortedNPCList.indexOf($NPCNameList[_npcId])>>
					<<if _sortedId is 0>>
						<<set _sortedId to $NPCNameList.length - 2>>
					<<else>>
						<<set _sortedId-->>
					<</if>>
					<<set _npcId to _npcList[_sortedNPCList[_sortedId]]>>
					<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
				<</link>> <span style="color:white">|</span>
				<<link "다음">>
					<<set _sortedId to _sortedNPCList.indexOf($NPCNameList[_npcId])>>
					<<if _sortedId gte $NPCNameList.length - 1>>
						<<set _sortedId to 0>>
					<<else>>
						<<set _sortedId++>>
					<</if>>
					<<set _npcId to _npcList[_sortedNPCList[_sortedId]]>>
					<<replace #npcSettingsMenu>><<npcSettingsMenu>><</replace>>
				<</link>>
			</span>
		</div>
		<<if getActivePregnancies(V.NPCName[T.npcId].nam).length>>
			<div class="settingsToggleItemWide">
				이 NPC는 현재 임신 중입니다. 임신 기간 동안에는 일부 설정을 변경할 수 없습니다.
			</div>
		<</if>>
		<div class="settingsToggleItem">
			<span class="gold">성별:</span>
			<br>
			<span data-target="npcname-npcidpronoun" data-disabledif="V.NPCName[T.npcId].pronoun==='i'">
			<label><<radiobutton "$NPCName[_npcId].pronoun" "f" autocheck>> 여성</label> |
			<label><<radiobutton "$NPCName[_npcId].pronoun" "m" autocheck>> 남성</label>
			</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">생식기:</span>
			<br>
			<span data-target="npcname-pregnancy" data-disabledif="getActivePregnancies(V.NPCName[T.npcId].nam).length">
				<label><<radiobutton "$NPCName[_npcId].gender" "f" autocheck>> 보지</label> |
				<label><<radiobutton "$NPCName[_npcId].gender" "m" autocheck>> 자지</label>
				<<if $debug is 1>>| <label><<radiobutton "$NPCName[_npcId].gender" "h" autocheck>> 양성</label><</if>>
			</span>
		</div>
		<div class="settingsToggleItem">
			<<set _penisNames to ["", "작은", "보통", "큰", "거대한"]>> /* the empty first element is necessary because _j starts at 1 */
			<span data-target="npcname-npcidgender" data-disabledif="V.NPCName[T.npcId].gender==='f'">
				<span class="gold">자지 크기:</span>
				<br>
				<<for _j to 1; _j lt _penisNames.length; _j++>>
					<label>	<<radiobutton "$NPCName[_npcId].penissize" _j autocheck>><<= _penisNames[_j]>></label>
					<<if _j isnot _penisNames.length -1>>|<</if>>
				<</for>>
			</span>
		</div>
		<div class="settingsToggleItem">
		<span class="gold">가슴 크기:</span>
		<br>
		<<numberslider "$NPCName[_npcId].breastsize" $NPCName[_npcId].breastsize 0 12 1 {
			onInputChange: v => {
				V.NPCName[_npcId].breastdesc = (v > 0) ? setup.breastsizes[v] + " breast" : "nipple";
				V.NPCName[_npcId].breastsdesc = (v > 0) ? setup.breastsizes[v] + " breasts" : "nipples";
			},
			value: v => {
				return (v > 0) ? window.KR.getBreastSizeKr(setup.breastsizes[v]) + " 가슴" : "유두";
			}
		}>>
		</div>
		<div class="settingsToggleItem">
			<span data-target="npcname-pregnancy" data-disabledif="!V.settings.nnpcPregnancyEnabled||setup.pregnancy.infertile.includes(V.NPCName[T.npcId].nam)||V.NPCName[T.npcId].pregnancy.enabled===undefined||getActivePregnancies(V.NPCName[T.npcId].nam).length||!setup.pregnancy.typesEnabled.includes(V.NPCName[T.npcId].type)">
				<span class="gold">NPC 임신 활성화:</span>
				<mouse class="tooltip linkBlue">(?)<span>"NNPC/LI 임신" 토글이 활성화되어 있어야 합니다. "미완성 임신 콘텐츠" 토글도 활성화해야 할 수 있습니다. 비활성화해도 이미 진행 중인 임신은 중단되지 않습니다.</span></mouse>
				<br>
				<label><<radiobutton "$NPCName[_npcId].pregnancy.enabled" true autocheck>> 활성</label> |
				<label><<radiobutton "$NPCName[_npcId].pregnancy.enabled" false autocheck>> 비활성</label>
			</span>
		</div>
		<div class="settingsToggleItem">
			<span data-target="npcname-analpregnancy" data-disabledif="!V.settings.nnpcPregnancyEnabled||!V.settings.npcAnalPregnancyEnabled||setup.pregnancy.infertile.includes(V.NPCName[T.npcId].nam)||V.NPCName[T.npcId].pregnancy.enabled===undefined||getActivePregnancies(V.NPCName[T.npcId].nam).length||!setup.pregnancy.typesEnabled.includes(V.NPCName[T.npcId].type)">
				<span class="gold">NPC 항문 임신 활성화:</span>
				<mouse class="tooltip linkBlue">(?)<span>"NNPC/LI 임신"과 "NPC 항문 임신" 토글이 전역 게임 설정에서 활성화되어 있어야 작동합니다. "미완성 임신 콘텐츠" 토글도 활성화해야 할 수 있습니다. 이 NPC의 임신 토글도 함께 활성화되어 있어야 합니다. 보지가 있는 NPC는 이 옵션을 켜면 질과 항문 모두로 임신할 수 있게 됩니다.</span></mouse>
				<br>
				<label><<radiobutton "$NPCName[_npcId].pregnancy.analEnabled" true autocheck>> 활성</label> |
				<label><<radiobutton "$NPCName[_npcId].pregnancy.analEnabled" false autocheck>> 비활성</label>
			</span>
		</div>


		<div class="settingsToggleItem">
			<span class="gold">피부색:</span>
			<br>
			<<if $NPCName[_npcId].nam is "Black Wolf">>/*disable skin colour toggle when player has BW set to 'always a beast'*/
				<span data-target="blackwolfmonster" data-disabledif="V.blackwolfmonster===0">
				<label><<radiobutton "$NPCName[_npcId].skincolour" "white" autocheck>> 창백함</label> |
				<label><<radiobutton "$NPCName[_npcId].skincolour" "black" autocheck>> 어두움</label>
				</span>
			<<elseif $NPCName[_npcId].nam is "Great Hawk">>/*disable skin colour toggle when player has GH set to 'always a beast'*/
				<span data-target="greathawkmonster" data-disabledif="V.greathawkmonster===0">
				<label><<radiobutton "$NPCName[_npcId].skincolour" "white" autocheck>> 창백함</label> |
				<label><<radiobutton "$NPCName[_npcId].skincolour" "black" autocheck>> 어두움</label>
				</span>
			<<elseif $NPCName[_npcId].nam is "Night Monster">>/*disable skin colour toggle when player has NM set to 'always a beast'*/
				<span data-target="nightmonstermonster" data-disabledif="V.nightmonstermonster===0">
				<label><<radiobutton "$NPCName[_npcId].skincolour" "white" autocheck>> 창백함</label> |
				<label><<radiobutton "$NPCName[_npcId].skincolour" "black" autocheck>> 어두움</label>
				</span>
			<<else>>
				<span data-target="npcname-npcidskincolour" data-disabledif="V.NPCName[T.npcId].skincolour==='ghost'">
				<label><<radiobutton "$NPCName[_npcId].skincolour" "white" autocheck>> 창백함</label> |
				<label><<radiobutton "$NPCName[_npcId].skincolour" "black" autocheck>> 어두움</label>
				</span>
			<</if>>
		</div>

		<<if $NPCName[_npcId].nam is "Black Wolf">>
			<div class="settingsToggleItemWide">
				<span class="gold">야수 유형:</span>
				<br>
				<label><<radiobutton "$blackwolfmonster" 0 autocheck>> 항상 야수</label> |
				<label><<radiobutton "$blackwolfmonster" 1 autocheck>> 조건 충족 시 수인</label> |
				<label><<radiobutton "$blackwolfmonster" 2 autocheck>> 항상 수인</label>
			</div>
		<<elseif $NPCName[_npcId].nam is "Great Hawk">>
			<div class="settingsToggleItemWide">
				<span class="gold">야수 유형:</span>
				<br>
				<label><<radiobutton "$greathawkmonster" 0 autocheck>> 항상 야수</label> |
				<label><<radiobutton "$greathawkmonster" 1 autocheck>> 조건 충족 시 수인</label> |
				<label><<radiobutton "$greathawkmonster" 2 autocheck>> 항상 수인</label>
			</div>
		<<elseif $NPCName[_npcId].nam is "Night Monster">>
			<div class="settingsToggleItemWide">
				<span class="gold">야수 유형:</span>
				<br>
				<label><<radiobutton "$nightmonstermonster" 0 autocheck>> 항상 야수</label> |
				<label><<radiobutton "$nightmonstermonster" 1 autocheck>> 조건 충족 시 수인</label> |
				<label><<radiobutton "$nightmonstermonster" 2 autocheck>> 항상 수인</label>
			</div>
		<</if>>
	</div>
	<div style="clear:both;"></div>

	<<if $debug is 1>>
		디버그:
		<br>
		<div class="settingsToggleItemWide">
			<span class="gold">머리색:</span>
			<br>
			<<for _j to 0; _j lt _hairColorNPC.length; _j++>>
				<label>
					<<print '<<radiobutton "$NPCName['+_npcId+'].hairColour" "'+_hairColorNPCData[_j]+'" ' + ($NPCName[_npcId].hairColour is _hairColorNPCData[_j] ? "checked" : "") + '>>'>>
					<span @class="_hairColorNPCText[_j]">_hairColorNPC[_j]</span>
				</label> |
			<</for>>
		</div>

		<div class="settingsToggleItemWide">
			<span class="gold">눈색:</span>
			<br>
			<<for _j to 0; _j lt _eyeColorNPC.length; _j++>>
				<label>
					<<print '<<radiobutton "$NPCName['+_npcId+'].eyeColour" "'+_eyeColorNPCData[_j]+'" ' + ($NPCName[_npcId].eyeColour is _eyeColorNPCData[_j] ? "checked" : "") + '>>'>>
					<span @class="_eyeColorNPCText[_j]">_eyeColorNPC[_j]</span>
				</label> |
			<</for>>
		</div>
		<div style="clear:both;"></div>
	<</if>>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "perNPCSettingsMenu">>
	<div class="settingsToggleIndent">
		<span class="gold">특정 지속성 NPC로 이동: </span>
		<<listbox "_pNPCId" autoselect>>
			<<optionsfrom _npcKeys>>
		<</listbox>>
	</div>
	<<switch _pNPCId>>
		<<case "scarred_inmate">>
			<<if $per_npc[_pNPCId].description isnot "scarred">>
				<<generate_scarred_inmate 0>>
				<<clearsinglenpc 0>>
			<</if>>
		<<case "veteran_guard">>
			<<if $per_npc[_pNPCId].description isnot "veteran">>
				<<generate_veteran_guard 0>>
				<<clearsinglenpc 0>>
			<</if>>
	<</switch>>
	<<set _npcIndex to _npcKeyNames.indexOf(_pNPCId)>>
	<div class="settingsGrid">
		<<if $per_npc[_pNPCId] eq null>>
			<<error {
			message : `pNPC의 주어진 ID가 사용 가능한 pNPC와 일치하지 않습니다: ${_pNPCId}.`,
			source	: _pNPCId
			}>>
		<<else>>
			<div class="settingsHeader">
				<<if $per_npc[_pNPCId].name_known or _pNPCId is "farm_tower_guard">>
					<<= window.KR.gatPersonNameDictKR($per_npc[_pNPCId].name)>> - <<= setup.pNpcNameKr[_pNPCId] || toTitleCase(_pNPCId.toUpperFirst().replace(/_/g, ' '))>>
				<<elseif _pNPCId is "hacker">>
					해커 미키
				<<elseif _pNPCId is "bishop">>
					비숍
				<<elseif _pNPCId is "bishop_right_hand">>
					비숍의 오른팔
				<<elseif _pNPCId is "bishop_left_hand">>
					비숍의 왼팔
				<<elseif _pNPCId is "alexs_parent1">>
					<<if $per_npc[_pNPCId].pronoun is "m">>
						알렉스의 강인한 아버지
					<<else>>
						알렉스의 강인한 어머니
					<</if>>
				<<elseif _pNPCId is "alexs_parent2">>
					<<if $per_npc[_pNPCId].pronoun is "m">>
						알렉스의 계산적인 아버지
					<<else>>
						알렉스의 계산적인 어머니
					<</if>>
				<<elseif _pNPCId is "whitneys_auncle">>
					<<if $per_npc[_pNPCId].pronoun is "m">>
						휘트니의 삼촌
					<<else>>
						휘트니의 이모
					<</if>>
				<<elseif _pNPCId is "whitney_parent_flat">>
					<<if $per_npc[_pNPCId].pronoun is "m">>
						휘트니의 아버지
					<<else>>
						휘트니의 어머니
					<</if>>
				<<else>>
					<<= setup.pNpcNameKr[_pNPCId] || toTitleCase(_pNPCId.toUpperFirst().replace(/_/g, ' '))>>
				<</if>>
				<span style="font-size:80%">
					<br>
					<<if $per_npc[_pNPCId].name_known and $debug is 1>>
						<<link "이름 바꾸기">>
							<<if $per_npc[_pNPCId].pronoun is "f">>
								<<set $per_npc[_pNPCId].name to $NPC_names_f.random()>>
							<<else>>
								<<set $per_npc[_pNPCId].name to $NPC_names_m.random()>>
							<</if>>
							<<replace #perNPCSettingsMenu>><<perNPCSettingsMenu>><</replace>>
						<</link>>
						|
					<</if>>
					<<link "이전">>
						<<set _npcIndex to (_npcIndex is 0 ? _npcKeyNames.length - 1 : --_npcIndex)>>
						<<set _pNPCId to _npcKeyNames[_npcIndex]>>
						<<replace #perNPCSettingsMenu>><<perNPCSettingsMenu>><</replace>>
					<</link>> |
					<<link "다음">>
						<<set _npcIndex++>>
						<<set _pNPCId to _npcKeyNames[_npcIndex]>>
						<<replace #perNPCSettingsMenu>><<perNPCSettingsMenu>><</replace>>
					<</link>>
				</span>
			</div>
			<div class="settingsToggleItem">
				<span data-target="pernpc-npcidpronoun" data-disabledif="V.per_npc[T.pNPCId].pronoun==='i'||V.per_npc[T.pNPCId].pronoun==='t'">
				<span class="gold">성별:</span>
				<br>
				<label><<radiobutton "$per_npc[_pNPCId].pronoun" "f" autocheck>> 여성</label> |
				<label><<radiobutton "$per_npc[_pNPCId].pronoun" "m" autocheck>> 남성</label>
				</span>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">생식기:</span>
				<br>
				<label><<radiobutton "$per_npc[_pNPCId].gender" "f" autocheck>> 보지</label> |
				<label><<radiobutton "$per_npc[_pNPCId].gender" "m" autocheck>> 자지</label>
			</div>
			<div class="settingsToggleItem">
				<<set _penisNames to ["", "작은", "보통", "큰", "거대한"]>> /* the empty first element is necessary because _j starts at 1 */
				<span data-target="pernpc-npcidgender" data-disabledif="V.per_npc[T.pNPCId].gender==='f'">
					<span class="gold">자지 크기:</span>
					<br>
					<<for _j to 1; _j lt _penisNames.length; _j++>>
						<label>
							<<radiobutton "$per_npc[_pNPCId].penissize" _j autocheck>>
							<<print _penisNames[_j]>>
						</label>
						<<if _j isnot _penisNames.length -1>>|<</if>>
					<</for>>
				</span>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">가슴 크기:</span>
				<br>
				<<numberslider "$per_npc[_pNPCId].breastsize" $per_npc[_pNPCId].breastsize 0 12 1 {
					onInputChange: v => {
						V.per_npc[_pNPCId].breastdesc = (v > 0) ? setup.breastsizes[v] + " breast" : "nipple";
						V.per_npc[_pNPCId].breastsdesc = (v > 0) ? setup.breastsizes[v] + " breasts" : "nipples";
					},
					value: v => {
						return (v > 0) ? window.KR.getBreastSizeKr(setup.breastsizes[v]) + " 가슴" : "유두";
					}
				}>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">피부색:</span>
				<br>
				<label><<radiobutton "$per_npc[_pNPCId].skincolour" "white" autocheck>> 밝음</label> |
				<label><<radiobutton "$per_npc[_pNPCId].skincolour" "black" autocheck>> 어두움</label>
			</div>
		<</if>>
	</div>
	<<run settingsDisableElement()>>
<</widget>>

<<widget "saveNameSection">>
	<div class="my-1">
		<span class="gold bold">세이브 이름:</span> <i>(선택 사항)</i>
	</div>
	<<textbox "$saveName" $saveName>>
	<div class="small-description">
		세이브 파일은 브라우저 캐시에 저장됩니다. 세이브를 잃지 않도록 자주 내보내기하세요.
	</div>
<</widget>>

<<widget "loadAllFeats">>
	<div id="featsBeginLoadingText">
		몇 가지 기본 확인을 실행하는 중...
		<br>
	</div>
	<div id="featsBeginButton" class="hidden">
		<span id="featsBeginText"></span> "시작"을 클릭한 후에는 게임을 새로고침하지 마세요. 그렇지 않으면 과정을 다시 실행해야 합니다.
		<br><br>
		내보낸 세이브는 먼저 불러와서 로컬 세이브로 만들지 않는 한 이 과정에서 제외됩니다.
		<br>
		<<link "시작">>
			<<replace "#startCaption">><</replace>>
			<<replace "#settingsStart">><<loadingAllFeats>><</replace>>
		<</link>>
	</div>
	<<run $(() => {wikifier("featsMergePre")})>>
	<br><br>
	<<link "취소">>
		<<replace "#settingsStart">><<settingsStart>><</replace>>
	<</link>>
<</widget>>

<<widget "loadingAllFeats">>
	<div id="featsLoadingMeter" class="meter">
		<div class="greenbar" style="width:0%"></div>
		<span id="featsLoadingText">_saveDataImportCount개의 세이브 중 0개 확인됨.</span>
	</div>
	<br><br>
	<div id="featsFinishButton" class="hidden">
		<<link "다음">>
			<<setupFeatBoosts true>>
			<<replace "#startCaption">><<startCaption>><</replace>>
			<<replace "#settingsStart">><<settingsStart>><</replace>>
		<</link>>
	</div>
	<<run $(() => {wikifier("featsMerge")})>>
<</widget>>

:: Settings [exitCheckBypass]
<<settings>>

:: Attitudes
<<attitudes>>
<<set $attitudesControl.showGoldLink to "false">>
<div class="settingsGrid">
	<<button [[확인|$attitudesExitPassage]]>>
		<<unset $attitudesExitPassage>>
		<<run DefaultActions.save(T.defaultActions)>>
		<<if $LIChanged>>
			<<unset $LIChanged>>
			<<set $stress += 2000>><<set $trauma += 600>>
		<</if>>
	<</button>>
</div>
<br>
