:: Social [widget]

<<widget "social">>
	<div id="relation-display">
		<<silently>>
			<<script>>
				if (V.wolfpackharmony) C.npc["Black Wolf"].harmony = V.wolfpackharmony;
				if (V.wolfpackferocity) C.npc["Black Wolf"].ferocity = V.wolfpackferocity;
				/*data config for non-standard NPCs boxes, allows for different stat configs, custom display data, and dynamic requirements*/
				T.npcConfig = {
					"Robin" : {
						important : true,
						dom : { name : "자신감", activeIcon : "img/ui/sym-confidence.png", color: "blue" }
					},
					"Whitney" : {
						important : true,
						love : { maxValue : 30 },
						dom : { maxValue: 20 }
					},
					"Eden" : {
						important : true,
						love : { maxValue: 200 },
						dom : { maxValue: 150 } /*false always hides this stat*/
					},
					"Kylar" : {
						important : true,
						rage : { name : "질투심", activeIcon : "img/ui/sym-jealousy.png", color: "green" }
					},
					"Avery" : {
						important : true,
						rage : { requirements : V.averyragerevealed, inactiveIcon : 'img/ui/sym-rage-empty.png' }
					},
					"Great Hawk" : {
						important : true,
					},
					"Black Wolf" : {
						important : true,
						love : { maxValue : 150 },
						harmony : { name : "무리의 화합", maxValue: 20, activeIcon : "img/ui/sym-harmony.png" },
						ferocity : { name : "무리의 흉포함", maxValue: 20, activeIcon : "img/ui/sym-ferocity.png" }
					},
					"Sydney" : {
						important : true,
						love : { maxValue: 150 },
						purity : { requirements : V.NPCName[28].purity > 0, maxValue : 100, minValue : 0 },
						corruption : { requirements : V.NPCName[28].corruption > 0, maxValue : 50, minValue : 0 }
					},
					"Alex" : {
						important : true,
						love : { maxValue : 100 },
						lust : { maxValue : 100 },
						dom : { maxValue : 100 }
					},
					"Gwylan" : {
						important: V.gwylanSeen?.includes("yearning"),
						love : { maxValue : (getSpecialSets(sets => sets.shop.includes("forest")).length * 2),
								activeIcon: V.gwylanSeen?.includes("yearning") ? "img/ui/sym-love-green.png" : "img/ui/sym-love.png",
								color: 'green' },
						dom : { name : "갈망", activeIcon : "img/ui/sym-yearning.png", requirements : V.gwylanSeen?.includes("yearning"), maxValue : 150, color: 'forest-green' }
					},

					"Mason" : {
						love : { maxValue : 50 }
					},
					"Darryl" : {
						love : { maxValue : 50 }
					},
					"Doren" : {
						dom : { name : "보호 본능", activeIcon : "img/ui/sym-confidence.png", color: "teal" }
					},
					"River" : {
						love : { maxValue : 50 }
					},
					"Sam" : {
						love : { maxValue : 50 }
					},
					"Charlie" : {
						love : { maxValue : 50 }
					},
					"Wren" : {
						love : { maxValue : 50 }
					},
					"Zephyr" : {
						love : { maxValue : 100 },
						dom : { maxValue : 50 }
					},
					"Ivory Wraith" : {
						lust : { name: "집착", activeIcon : (V.wraith && (V.wraith.state == "haunt" || V.wraith.state == "despair") ? "img/ui/sym-obsession-blood.png" : "img/ui/sym-obsession.png"), inactiveIcon : "img/ui/sym-obsession-empty.png", maxValue : 20 }
					}
				};

				/* This list dictates the order that the important NPCs will show up in on the social menu screen */
				T.importantNpcOrder = ["Robin", "Whitney", "Eden", "Kylar", "Sydney", "Avery", "Great Hawk", "Black Wolf", "Alex"];
				if (V.gwylanSeen?.includes("yearning")) T.importantNpcOrder.pushUnique("Gwylan");
				T.specialNPCs = ["Ivory Wraith"];

				/* this list is sorted */
				T.importantNPCs = T.importantNpcOrder.map(name => V.NPCName[V.NPCNameList.indexOf(name)]);

				/* this list is unsorted */
				T.otherNPCs = V.NPCName.filter(npc => !T.importantNpcOrder.includes(npc.nam) && !T.specialNPCs.includes(npc.nam));

				/* sorting takes the lower value and puts it first, so if a < b, a goes first. */
				/* yes, this works on words, somehow. it's math shit, but it works. read a book if necessary. */
				T.otherNPCs.sort((a,b) => a.nam - b.nam);
			<</script>>
		<</silently>>

		<br>
		<span class="gold">주요 관계</span>
		<div id="npc-relations" class="relation-box-list">
			<<set _initNPC to 0>>
			<<for _k = 0; _k lt _importantNPCs.length; _k++>>
				<<relation-box _importantNPCs[_k] _npcConfig[_importantNPCs[_k].nam]>>
				<<set _initNPC += _npcData.init>>
			<</for>>
		</div>
		<<if _initNPC is 0>>
			//주요 관계 없음//
			<br>
		<</if>>

		<br>
		<span class="gold">관심 인물</span>
		<div id="secondary-npcs" class="relation-box-list">
			<<set _initNPC to 0>>
			<<for _k= 0; _k lt _otherNPCs.length; _k++>>
				<<relation-box _otherNPCs[_k] _npcConfig[_otherNPCs[_k].nam]>>
				<<set _initNPC += _npcData.init>>
			<</for>>
			<<for _ik= 0; _ik lt _specialNPCs.length; _ik++>>
				<<set $_npc to $NPCName[$NPCNameList.indexOf(_specialNPCs[_ik])]>>
				<<relation-box $_npc _npcConfig[_specialNPCs[_ik]]>>
				<<set _initNPC += _npcData.init>>
			<</for>>
		</div>
		<<if _initNPC is 0>>
			//부가 관계 없음//
			<br>
		<</if>>

		<br>
		<span class="gold">평판</span>
		<div id="faction-reputations" class="relation-box-list">
			<<silently>>
				/* Police config */
				<<set _policeCrimeConfig = { currentValue : crimeSumHistory(), states : [
					{ requiredValue: 0, color: 'green', description: '경찰은 당신에게 관심이 없으며,'},
					{ requiredValue: 1000, color: 'teal', description: '경찰은 당신을 기록하고 있으며,'},
					{ requiredValue: 2000, color: 'lblue', description: '경찰은 당신을 관심 인물로 간주하고 있으며,'},
					{ requiredValue: 3000, color: 'blue', description: '경찰은 당신을 문제아로 간주하고 있으며,'},
					{ requiredValue: 5000, color: 'purple', description: '경찰은 당신을 범죄자로 간주하고 있으며,'},
					{ requiredValue: 10000, color: 'pink', description: '경찰은 당신에 대한 전담 문서를 가지고 있으며,'},
					{ requiredValue: 30000, color: 'red', description: '경찰은 당신 전담 서류함까지 따로 두고 있으며,'}
					]}>>
				<<set _policeEvidenceConfig = { currentValue : crimeSumHistory(), secondaryValue : crimeSumCurrent(), preText: '당신을 범죄와 연결할 ', states : [
					{ requiredValue: 0, secondaryStates : [
					{ requiredValue: 0, color: 'green', description: '어떤 증거도 가지고 있지 않다.'},
					{ requiredValue: 1, color: 'teal', description: '약간의 증거를 가지고 있지만 체포하기에는 부족하다.'}, ]},
					{ requiredValue: 1000, secondaryStates : [
					{ requiredValue: 0, color: 'green', description: '증거가 거의 없다.'},
					{ requiredValue: 1000, color: 'pink', description: '충분한 증거를 가지고 있으며, 체포할 수 있다.'},
					{ requiredValue: 5000, color: 'red', description: '차고 넘치는 증거를 가지고 있으며, 당신을 체포할 수 있다.'},
				 ]}
				]}>>
				<<set _policeBoxConfig = { name : "경찰", icon : "img/misc/icon/police.png", description: "<<relation-text _policeCrimeConfig>> <<relation-text _policeEvidenceConfig>>"}>>

				/* Orphanage */
				<<set _orphanageMoodConfig = { currentValue: $orphan_hope, secondaryValue: $orphan_reb, preText: '고아원의 분위기는 ', states : [
					{ requiredValue: -100, secondaryStates : [
					{ requiredValue: -100, color: 'pink', description: '절망적이다.'},
					{ requiredValue: -40, color: 'pink', description: '풀이 죽어 있다.'},
					{ requiredValue: -10, color: 'pink', description: '불행하다.'},
					{ requiredValue: 10, color: 'pink', description: '앙심을 품고 있다.'},
					{ requiredValue: 40, color: 'def', description: '복수심에 불탄다.'},
					]},
					{ requiredValue: -40, secondaryStates : [
					{ requiredValue: -100, color: 'purple', description: '우울하다.'},
					{ requiredValue: -40, color: 'purple', description: '의기소침하다.'},
					{ requiredValue: -10, color: 'purple', description: '체념한 상태다.'},
					{ requiredValue: 10, color: 'purple', description: '말을 안 듣는다.'},
					{ requiredValue: 40, color: 'def', description: '통제가 안 된다.'},
					]},
					{ requiredValue: -10, secondaryStates : [
					{ requiredValue: -100, color: 'blue', description: '순종적이다.'},
					{ requiredValue: -40, color: 'blue', description: '고분고분하다.'},
					{ requiredValue: -10, color: 'blue', description: '차분하다.'},
					{ requiredValue: 10, color: 'blue', description: '반항적이다.'},
					{ requiredValue: 40, color: 'def', description: '도전적이다.'},
					]},
					{ requiredValue: 10, secondaryStates : [
					{ requiredValue: -100, color: 'teal', description: '견뎌내고 있다.'},
					{ requiredValue: -40, color: 'teal', description: '저항하지 않는다.'},
					{ requiredValue: -10, color: 'teal', description: '낙관적이다.'},
					{ requiredValue: 10, color: 'teal', description: '반항적이다.'},
					{ requiredValue: 40, color: 'def', description: '반란을 꾀하고 있다.'},
					]},
					{ requiredValue: 40, secondaryStates : [
					{ requiredValue: -100, color: 'green', description: '친절하다.'},
					{ requiredValue: -40, color: 'green', description: '우호적이다.'},
					{ requiredValue: -10, color: 'green', description: '희망에 차 있다.'},
					{ requiredValue: 10, color: 'green', description: '이상적이다.'},
					{ requiredValue: 40, color: 'def', description: '혁명적이다.'},
					]},
				]}>>
				<<set _orphanageBoxConfig = { name : "고아원", icon : "img/misc/icon/orphanage.png", description: "<<relation-text _orphanageMoodConfig>>"}>>

				/* School config */
				<<set _teacherRepConfig = { currentValue: $delinquency, preText: '교사들은 당신을 ', postText: '【으로로】 간주한다.', states : [
					{ requiredValue: 0, color: 'green', description: '모범생'},
					{ requiredValue: 10, color: 'teal', description: '평범한 학생'},
					{ requiredValue: 200, color: 'lblue', description: '불량 학생'},
					{ requiredValue: 400, color: 'blue', description: '비행 청소년'},
					{ requiredValue: 600, color: 'purple', description: '비행 청소년'},
					{ requiredValue: 800, color: 'pink', description: '비행 청소년'},
					{ requiredValue: 1000, color: 'red', description: '골칫거리'}
				]}>>
				<<set _studentRepConfig = { currentValue: $cool, preText: '동급생들은 당신을 ', states : [
					{ requiredValue: 0, color: 'red', preText: '동급생들은 당신을 ', description: '피한다.'},
					{ requiredValue: 40, color: 'pink', description: '특이하다고 생각한다.'},
					{ requiredValue: 80, color: 'purple', description: '괴짜라고 생각한다.'},
					{ requiredValue: 120, color: 'blue', description: '괜찮다고 생각한다.'},
					{ requiredValue: 160, color: 'lblue', description: '멋지다고 생각한다.'},
					{ requiredValue: 240, color: 'teal', description: '아주 멋지다고 생각한다.'},
					{ requiredValue: 400, color: 'green', preText: '동급생들은 당신과 ', description: '어울리고 싶어 한다.'}
				]}>>
				<<set _teacherBoxConfig = { name : "교사", icon : "img/misc/icon/school.png", description: "<<relation-text _teacherRepConfig>> <<statbar 0 $delinquency 1000>>"}>>
				<<set _studentBoxConfig = { name : "학생", icon : "img/misc/icon/school-building.png", description: "<<relation-text _studentRepConfig>> <<statbarinverted $cool $coolmax>>"}>>

				/*Crossdressing*/
				<<if $schoolrep.crossdress neq 0>>
					<<set _crossdressing to $player.gender isnot $player.sex ? "크로스드레싱 의혹" : "크로스드레싱">>
					<<set _knows to $player.gender isnot $player.sex ? "믿고 있다" : "알고 있다">>
					<<set _crossdressRepConfig = { currentValue: $schoolrep.crossdress, states : [
						{ requiredValue: 1,	color: 'lblue',		description: `학교의 몇몇 무리가 당신의 ${_crossdressing}에 대해 수군거린다. 믿는 사람은 거의 없다.`},
						{ requiredValue: 2,	color: 'blue',		description: `학교에 소문이 뿌리내렸다. 몇몇은 당신이 크로스드레싱을 한다고 말한다.`},
						{ requiredValue: 3,	color: 'purple',	description: `학생들이 당신의 ${_crossdressing}에 대해 떠들어댄다. 다만 대부분은 그저 농담이라고 생각한다.`},
						{ requiredValue: 4,	color: 'pink',		description: `학교의 모두가 당신의 ${_crossdressing}에 대한 소문을 들었다.`},
						{ requiredValue: 5,	color: 'red',		description: `교사들을 포함해 학교의 모두가 당신이 크로스드레싱을 한다고 ${_knows}.`}
					]}>>
					<<set _crossdressBoxConfig = { name : "크로스드레싱", description : '<<relation-text _crossdressRepConfig>>'}>>
				<</if>>

				/*Herm*/
				<<if $schoolrep.herm neq 0>>
					<<set _hermRepConfig = { currentValue: $schoolrep.herm, states : [
						{ requiredValue: 1, color: 'lblue', description: '학교의 몇몇 무리에서 남자와 여자의 성기를 모두 가진 학생에 대한 소문이 돌고 있다. 믿는 사람은 거의 없다.'},
						{ requiredValue: 2, color: 'blue', description: '남자와 여자의 성기를 모두 가진 학생에 대한 소문이 학교 전체에 퍼졌다.'},
						{ requiredValue: 3, color: 'purple', description: '학교는 남자와 여자의 성기를 모두 가진 학생에 대한 소문으로 가득하다.'},
						{ requiredValue: 4, color: 'pink', description: '학교의 모든 사람들이 당신의 독특한 성기에 대한 소문을 들었다.'},
						{ requiredValue: 5, color: 'red', description: '교사들을 포함해 학교의 모든 사람이 당신의 독특한 성기에 대해 알고 있다.'}
					]}>>
					<<set _hermBoxConfig = { name : "성기", description : '<<relation-text _hermRepConfig>>'}>>
				<</if>>

				/* Prison */
				<<if $prison>>
					<<set _prisonMoodConfig = { currentValue: $prison.hope, secondaryValue: $prison.reb, preText: '교도소의 분위기는 ', states : [
						{ requiredValue: 0, secondaryStates : [
							{ requiredValue: 0, color: 'pink', description: '절망적이다.'},
							{ requiredValue: 20, color: 'pink', description: '풀이 죽어 있다.'},
							{ requiredValue: 40, color: 'pink', description: '불행하다.'},
							{ requiredValue: 60, color: 'pink', description: '앙심을 품고 있다.'},
							{ requiredValue: 80, color: 'def', description: '복수심에 불탄다.'},
													]},
						{ requiredValue: 20, secondaryStates : [
							{ requiredValue: 0, color: 'purple', description: '우울하다.'},
							{ requiredValue: 20, color: 'purple', description: '의기소침하다.'},
							{ requiredValue: 40, color: 'purple', description: '체념한 상태다.'},
							{ requiredValue: 60, color: 'purple', description: '말을 안 듣는다.'},
							{ requiredValue: 80, color: 'def', description: '통제가 안 된다.'},
													]},
						{ requiredValue: 40, secondaryStates : [
							{ requiredValue: 0, color: 'blue', description: '순종적이다.'},
							{ requiredValue: 20, color: 'blue', description: '고분고분하다.'},
							{ requiredValue: 40, color: 'blue', description: '차분하다.'},
							{ requiredValue: 60, color: 'blue', description: '반항적이다.'},
							{ requiredValue: 80, color: 'def', description: '도전적이다.'},
													]},
						{ requiredValue: 60, secondaryStates : [
							{ requiredValue: 0, color: 'teal', description: '견뎌내고 있다.'},
							{ requiredValue: 20, color: 'teal', description: '저항하지 않는다.'},
							{ requiredValue: 40, color: 'teal', description: '낙관적이다.'},
							{ requiredValue: 60, color: 'teal', description: '반항적이다.'},
							{ requiredValue: 80, color: 'def', description: '반란을 꾀하고 있다.'},
						]},
						{ requiredValue: 80, secondaryStates : [
							{ requiredValue: 0, color: 'green', description: '관용적이다.'},
							{ requiredValue: 20, color: 'green', description: '참을성이 있다.'},
							{ requiredValue: 40, color: 'green', description: '희망에 차 있다.'},
							{ requiredValue: 60, color: 'green', description: '이상적이다.'},
							{ requiredValue: 80, color: 'def', description: '혁명적이다.'},
						]},
					]}>>
					<<set _guardRepConfig = { currentValue: $prison.guards, preText: '경비원들은 당신을 ', states : [
						{ requiredValue: 0, color: 'red', description: '항상 감시하고 있다.'},
						{ requiredValue: 15, color: 'pink', description: '문제아로 간주한다.'},
						{ requiredValue: 30, color: 'purple', description: '지켜보고 있다.'},
						{ requiredValue: 45, color: 'blue', description: '주시하고 있다.'},
						{ requiredValue: 60, color: 'lblue', description: '문제를 일으키지 않을 거라 예상한다.'},
						{ requiredValue: 80, color: 'teal', description: '못 본 척 넘겨준다.'},
						{ requiredValue: 100, color: 'green', description: '여기에 있다는 사실조차 잊고 있다.'}
					]}>>
					<<set _inmateRepConfig = { currentValue: $prison.inmates, preText: '대부분의 동료 죄수들은 당신을 ', states : [
						{ requiredValue: 0, color: 'red', description: '고깃덩어리로 본다.'},
						{ requiredValue: 15, color: 'pink', description: '육변기라고 생각한다.'},
						{ requiredValue: 30, color: 'purple', description: '암캐로 간주한다.'},
						{ requiredValue: 45, color: 'blue', description: '그들 중 하나로 본다.'},
						{ requiredValue: 60, color: 'lblue', description: '좋게 평가한다.'},
						{ requiredValue: 80, color: 'teal', description: '존중한다.'},
						{ requiredValue: 100, color: 'green', description: '보스라고 생각한다.'}
					]}>>
					<<set _prisonBoxConfig = { name : "교도소 분위기", icon : "img/misc/icon/prison-cell.png", description: "<<relation-text _prisonMoodConfig>>"}>>
					<<set _guardBoxConfig = { name : "교도소 경비원", icon : "img/misc/icon/prison-cell.png", description: "<<relation-text _guardRepConfig>>"}>>
					<<set _inmateBoxConfig = { name : "교도소 죄수", icon : "img/misc/icon/prison-cell.png", description: "<<relation-text _inmateRepConfig>>"}>>
				<</if>>
				/*Docks */
				<<if $docks.hired>>
					<<set _dockRepConfig = { currentValue: $docks.status, preText: '다른 노동자들은 당신을 ', states : [
						{ requiredValue: 0, color: 'red', description: '경멸스럽게 바라본다.'},
						{ requiredValue: 20, color: 'purple', description: '의심스럽게 바라본다.'},
						{ requiredValue: 40, color: 'blue', description: '용인한다.'},
						{ requiredValue: 60, color: 'lblue', description: '받아들인다.'},
						{ requiredValue: 80, color: 'teal', description: '존중한다.'},
						{ requiredValue: 100, color: 'green', description: '존경한다.'}
					]}>>
					<<set _dockBoxConfig = { name : "부두", icon : "img/misc/icon/docks.png", description : '<<relation-text _dockRepConfig>>'}>>
				<</if>>
				/*Pirates */
				<<set _pirateStatusConfig = { currentValue: $pirate_rank, secondaryValue: $pirate_status, preText: '해적들은 당신을 ', states : [
						{ requiredValue: 0, secondaryStates : [
							{ requiredValue: 0, color: 'red', description: '역겨운 쓰레기로 본다.'},
							{ requiredValue: 10, color: 'pink', description: '쓸모없는 쓰레기로 본다.'},
							{ requiredValue: 30, color: 'pink', description: '한심한 쓰레기로 본다.'},
							{ requiredValue: 50, color: 'pink', description: '엉성한 쓰레기로 본다.'},
							{ requiredValue: 70, color: 'pink', description: '귀여운 쓰레기로 본다.'},
							{ requiredValue: 90, color: 'purple', description: '더 이상 쓰레기가 아니라고 본다.'},
						]},
						{ requiredValue: 1, secondaryStates : [
							{ requiredValue: 0, color: 'blue', description: '쓰레기 같은 동료로 본다.'},
							{ requiredValue: 10, color: 'blue', description: '쓸모없는 동료로 본다.'},
							{ requiredValue: 30, color: 'blue', description: '검증되지 않은 동료로 본다.'},
							{ requiredValue: 50, color: 'blue', description: '2급 동료로 본다.'},
							{ requiredValue: 70, color: 'blue', description: '훌륭한 동료로 본다.'},
							{ requiredValue: 90, color: 'lblue', description: '1급 동료로 본다.'},
						]},
					]}>>
					<<set _pirateBoxConfig = { name : "해적 계급", icon : "img/misc/icon/mer.png", description: "<<relation-text _pirateStatusConfig>>"}>>
			<</silently>>
			<<relation-box-simple _policeBoxConfig>>
			<<relation-box-simple _orphanageBoxConfig>>
			<<relation-box-simple _teacherBoxConfig>>
			<<relation-box-simple _studentBoxConfig>>
			<<if $schoolrep.crossdress neq 0>>
				<<relation-box-simple _crossdressBoxConfig>>
			<</if>>
			<<if $schoolrep.herm neq 0>>
				<<relation-box-simple _hermBoxConfig>>
			<</if>>
			<<if $prison>>
				<<relation-box-simple _guardBoxConfig>>
				<<relation-box-simple _inmateBoxConfig>>
				<<relation-box-simple _prisonBoxConfig>>
			<</if>>
			<<if $docks.hired>>
				<<relation-box-simple _dockBoxConfig>>
			<</if>>
			<<if $pirate_rank gte 0>>
				<<relation-box-simple _pirateBoxConfig>>
			<</if>>
				<<relation-box-wolves>>

		</div>
		<<if $farm_stage gte 2>>
			<<silently>>
				/* Farm Animals */
				/*Horses*/
				<<switch $settings.beastMaleChance>>
					<<case 100>>
						<<set _people to "boys">>
						<<set _cowpeople to "bullboys">>
					<<case 0>>
						<<set _people to "girls">>
						<<set _cowpeople to "cowgirls">>
					<<default>>
						<<set _people to "people">>
						<<set _cowpeople to "cowgirls and bullboys">>
				<</switch>>
								<!-- These values apply if the current value is "Greater than or equal to" the specified value. So:
					-30 to -21 	: Fucktoy
					-20 to -6 	: Little respect
					-5 to 4 	: Wary
					5 to 19		: Trust
					20 to 30	: Respect
					 -->
				<<set _farmHorseRepConfig = { currentValue: $farm.beasts.horses, preText: `${$settings.monsterChance is 100 ? '켄타우로스들' : '말들'}【은는】 당신을 `, postText: '', states: [
					{ requiredValue: -100, color: 'pink', description: '육변기로 본다.'},
					{ requiredValue: -20, color: 'purple', description: '존중하지 않는다.'},
					{ requiredValue: -5, color: '', description: '경계한다.'},
					{ requiredValue: 5, color: 'lblue', description: '신뢰한다.'},
					{ requiredValue: 20, color: 'green', description: '존중한다.'}
				]}>>
				/*Pigs*/
				<<set _farmPigRepConfig = { currentValue: $farm.beasts.pigs, preText: `${$settings.monsterChance is 100 ? '돼지 수인들' : '돼지들'}【은는】 당신을 `, postText: '', states: [
					{ requiredValue: -100, color: 'pink', description: '육변기로 본다.'},
					{ requiredValue: -20, color: 'purple', description: '존중하지 않는다.'},
					{ requiredValue: -5, color: '', description: '경계한다.'},
					{ requiredValue: 5, color: 'lblue', description: '신뢰한다.'},
					{ requiredValue: 20, color: 'green', description: '존중한다.'}
				]}>>
				/*Cattle*/
				<<set _farmCattleRepConfig = { currentValue: $farm.beasts.cattle, preText: `${$settings.monsterChance is 100 ? '소 수인들' : '소들'}【은는】 당신을 `, postText: '', states: [
					{ requiredValue: -100, color: 'pink', description: '귀찮은 존재로 본다.'},
					{ requiredValue: -20, color: 'purple', description: '존중하지 않는다.'},
					{ requiredValue: -5, color: '', description: '경계한다.'},
					{ requiredValue: 5, color: 'lblue', description: '신뢰한다.'},
					{ requiredValue: 20, color: 'green', description: '존중한다.'}
				]}>>
				/*Dogs*/
				<<set _farmDogRepConfig = { currentValue: $farm.beasts.dogs, preText: `${$settings.monsterChance is 100 ? '개 수인들' : '개들'}【은는】 당신을 `, postText: '', states: [
					{ requiredValue: -100, color: 'pink', description: '육변기로 본다.'},
					{ requiredValue: -20, color: 'purple', description: '존중하지 않는다.'},
					{ requiredValue: -5, color: '', description: '경계한다.'},
					{ requiredValue: 5, color: 'lblue', description: '신뢰한다.'},
					{ requiredValue: 20, color: 'green', description: '존중한다.'}
				]}>>
				<<set _farmHorseBoxConfig =		{ name: "말",	icon : "img/misc/icon/horse.png", description : '<<relation-text _farmHorseRepConfig>>'}>>
				<<set _farmPigBoxConfig =		{ name: "돼지",		icon : "img/misc/icon/pig.png", description : '<<relation-text _farmPigRepConfig>>'}>>
				<<set _farmCattleBoxConfig =	{ name: "소",	icon : "img/misc/icon/cow.png", description : '<<relation-text _farmCattleRepConfig>>'}>>
				<<set _farmDogBoxConfig =		{ name: "개",		icon : "img/misc/icon/dog.png", description : '<<relation-text _farmDogRepConfig>>'}>>

				<<if $farm_stage gte 5>>
					/* Farm Sabotage */
					<<set _farmSabotageConfig = { currentValue: $farm.aggro, states: [
						{ requiredValue: 0, color: 'green', description: '농장은 평화롭다.'},
						{ requiredValue: 1, color: 'teal', description: '낯선 사람들이 농장을 주시하는 것이 목격되었다.'},
						{ requiredValue: 10, color: 'lblue', description: '농장 주변에서 침입 흔적이 발견되었다.'},
						{ requiredValue: 20, color: 'blue', description: '무언가가 농장의 짐승들을 겁주어 쫓아내고 있다.'},
						{ requiredValue: 40, color: 'purple', description: '농장이 밤에 사보타주를 당하고 있다.'},
						{ requiredValue: 60, color: 'pink', description: '농장이 밤낮을 가리지 않고 사보타주를 당하고 있다.'},
						{ requiredValue: 100, color: 'red', description: '레미의 폭력배들이 공개적으로 활동하며 농장과 사업을 방해하고 있다.'},
					]}>>
					<<set _farmSabotageBoxConfig = { name: "농장 안전", icon : "img/misc/icon/barn.png", description : '<<relation-text _farmSabotageConfig>>'}>>
				<</if>>
			<</silently>>

			<br>
			<span class="gold">농장 상태</span>
			<div id="farm-status" class="relation-box-list">
				<<relation-box-simple _farmHorseBoxConfig>>
				<<relation-box-simple _farmPigBoxConfig>>
				<<relation-box-simple _farmCattleBoxConfig>>
				<<relation-box-simple _farmDogBoxConfig>>
				<<if $farm_stage gte 5>>
				<<relation-box-simple _farmSabotageBoxConfig>>
				<</if>>
			</div>
		<</if>>

		<br>
		<span class="gold">명성</span>
		<div id="global-recognition" class="relation-box-list">
			<<silently>>
				<<set _fameStates = [
					{ requiredValue: 0,		color: 'green',		description: ' 알려지지 않음'},
					{ requiredValue: 30,	color: 'teal',		description: ' 잘 모름'},
					{ requiredValue: 100,	color: 'lblue',		description: ' 조금 알려짐'},
					{ requiredValue: 200,	color: 'blue',		description: ' 알려짐'},
					{ requiredValue: 400,	color: 'purple',	description: ' 잘 알려짐'},
					{ requiredValue: 600,	color: 'pink',		description: ' 유명함'},
					{ requiredValue: 1000,	color: 'red',		description: ' 악명 높은 _config.flavorText'}
				]>>
				<<set _inverseFameStates = [
					{ requiredValue: 0,		color: 'red',		description: ' 알려지지 않음'},
					{ requiredValue: 30,	color: 'pink',		description: ' 잘 모름'},
					{ requiredValue: 100,	color: 'purple',	description: ' 조금 알려짐'},
					{ requiredValue: 200,	color: 'blue',		description: ' 알려짐'},
					{ requiredValue: 400,	color: 'lblue',		description: ' 잘 알려짐'},
					{ requiredValue: 600,	color: 'teal',		description: ' 유명함'},
					{ requiredValue: 1000,	color: 'green',		description: ' 명망 높은 _config.flavorText'}
				]>>

				<<set _sexFameConfig =				{ currentValue: $fame.sex,				preText: '섹스:',			flavorText: '걸레',				states: _fameStates }>>
				<<set _prostitutionFameConfig =		{ currentValue: $fame.prostitution,		preText: '매춘:',	flavorText: '창녀',			states: _fameStates }>>
				<<set _rapeFameConfig =				{ currentValue: $fame.rape,				preText: '강간:',			flavorText: '육변기',			states: _fameStates }>>
				<<if $settings.bestialityEnabled>>
					<<set $_pre to "수간:">>
					<<set $_flavor to "암캐">>
				<<else>>
					<<set $_pre to "몬스터:">>
					<<set $_flavor to "몬스터 박이">>
				<</if>>
				<<set _bestialityFameConfig =		{ currentValue: $fame.bestiality,		preText: $_pre,				flavorText: $_flavor,			states: _fameStates }>>
				<<set _exhibitionismFameConfig =	{ currentValue: $fame.exhibitionism,	preText: '노출:',	flavorText: '노출광',			states: _fameStates }>>
				<<if $fame.pregnancy gte 600>>
					<<set $_name to "번식모">>
				<<elseif $fame.pregnancy gte 200>>
					<<set $_name to "번식자">>
				<<else>>
					<<set $_name to "어머니">>
				<</if>>
				<<set _pregnancyFameConfig =		{ currentValue: $fame.pregnancy,		preText: '임신:',		flavorText: $_name,				states: _fameStates }>>
				<<if $fame.impreg gte 600>>
					<<set $_name to "씨뿌리는 자">>
				<<elseif $fame.impreg gte 200>>
					<<set $_name to "씨내리">>
				<<else>>
					<<set $_name to "수정자">>
				<</if>>
				<<set _impregFameConfig =			{ currentValue: $fame.impreg,			preText: '임신:',		flavorText: $_name,				states: _fameStates }>>
				<<set _combatFameConfig =			{ currentValue: $fame.scrap,			preText: '전투:',			flavorText: '싸움꾼',			states: _inverseFameStates }>>
				<<set _kindnessFameConfig =			{ currentValue: $fame.good,				preText: '선행:',		flavorText: '선행꾼',		states: _inverseFameStates }>>
				<<set _businessFameConfig =			{ currentValue: $fame.business,			preText: '사업:',		flavorText: '사업가',		states: _inverseFameStates }>>
				<<set _socialFameConfig =			{ currentValue: $fame.social,			preText: '사교:',		flavorText: '아첨꾼',		states: _inverseFameStates }>>
				<<set _modelFameConfig =			{ currentValue: $fame.model,			preText: '모델:',		flavorText: '자랑꾼',			states: _inverseFameStates }>>
				<<set _overallFameConfig = { currentValue: fameTotal(), preText: '종합:', flavorText: '', states: [
					{ requiredValue: 0, color: 'green', description: ' 알려지지 않음'},
					{ requiredValue: 100, color: 'teal', description: ' 무명'},
					{ requiredValue: 500, color: 'lblue', description: ' 조금 알려짐'},
					{ requiredValue: 1000, color: 'blue', description: ' 알려짐'},
					{ requiredValue: 2000, color: 'purple', description: ' 잘 알려짐'},
					{ requiredValue: 3000, color: 'pink', description: ' 유명함'},
					{ requiredValue: 4000, color: fameSum('business', 'good', 'social', 'model') > 4000 ? 'green' : 'red', description: fameSum('business', 'good', 'social', 'model') > 4000 ? ' 명망 높음' : ' 악명 높음' }
				]}>>

				<<set _sexFameBoxConfig =			{ description : '<<relation-text _sexFameConfig>>' }>>
				<<set _prostitutionFameBoxConfig =	{ description : '<<relation-text _prostitutionFameConfig>>' }>>
				<<set _rapeFameBoxConfig =			{ description : '<<relation-text _rapeFameConfig>>' }>>
				<<set _bestialityFameBoxConfig =	{ description : '<<relation-text _bestialityFameConfig>>' }>>
				<<set _exhibitionismFameBoxConfig =	{ description : '<<relation-text _exhibitionismFameConfig>>' }>>
				<<set _pregnancyFameBoxConfig =		{ description : '<<relation-text _pregnancyFameConfig>>' }>>
				<<set _combatFameBoxConfig =		{ description : '<<relation-text _combatFameConfig>>' }>>
				<<set _kindnessFameBoxConfig =		{ description : '<<relation-text _kindnessFameConfig>>' }>>
				<<set _businessFameBoxConfig =		{ description : '<<relation-text _businessFameConfig>>' }>>
				<<set _socialFameBoxConfig =		{ description : '<<relation-text _socialFameConfig>>' }>>
				<<set _modelFameBoxConfig =			{ description : '<<relation-text _modelFameConfig>>' }>>
				<<set _overallFameBoxConfig =		{ description : '<<relation-text _overallFameConfig>>' }>>
			<</silently>>

			<<relation-box-simple _sexFameBoxConfig>>
			<<relation-box-simple _prostitutionFameBoxConfig>>
			<<relation-box-simple _rapeFameBoxConfig>>
			<<relation-box-simple _bestialityFameBoxConfig>>
			<<relation-box-simple _exhibitionismFameBoxConfig>>
			<<if $fame.model gte 1>>
				<<relation-box-simple _modelFameBoxConfig>>
			<</if>>
			<<relation-box-simple _pregnancyFameBoxConfig>>
			<<relation-box-simple _combatFameBoxConfig>>
			<<relation-box-simple _kindnessFameBoxConfig>>
			<<relation-box-simple _businessFameBoxConfig>>
			<<relation-box-simple _socialFameBoxConfig>>
			<<relation-box-simple _overallFameBoxConfig>>

			<div class="relation-box" @style="(_boxConfig.style || '')">
				<div class="relation-description">
				사람들은 당신을 <span class="teal"><<overworld_nickname>></span>【으로로】 알고 있다. 범죄자들은 당신을 <span class="pink"><<underworld_nickname>></span>【이】라고 부른다.
				</div>
			</div>

		</div>

		<br>
	</div>
	<br>
<</widget>>
