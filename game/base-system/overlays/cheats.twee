:: Cheats [widget]
<<widget "cheats">>
	<<link [[확인|$passage]]>><<set $cheatReload to true>><</link>>
	<br>
	이벤트 중이거나 주변에 NPC가 있을 때 확인하면 문제가 발생할 수 있습니다.
	<br>
	치트가 현재 씬에 즉시 적용되기를 원할 때만 필요합니다.
	<hr>
	<div id="cheatsShown"><<cheats-characterStats>></div>

	<div class="settingsGrid">
		<input type="button" class="toTop options" value="페이지 맨 위로" onclick="$('#customOverlayContent').scrollTop(0)"/>
	</div>
<</widget>>

<<widget "cheatVirginityToggle">>
	<<set _type to _args[0]>>
	<<set _id to `stats${_type}virginity`>>
	<<capture _type _id>>
		<span @id="_id"><<= ($player.virginity[_type] is true ? "보존됨" : "상실됨: " + ($player.virginity[_type] is false ? "알 수 없음" : window.KR.gatPersonNameDictKR($player.virginity[_type])))>></span> |
		<span @id="_id + 'link'"><<link `($player.virginity[_type] is true and !$player?.virginityDetails?.[_type]?.taker ? "상실 처리" : "복구")`>>
			<<if $player.virginity[_type] is true>>
				<<set $player.virginity[_type] to (_virginity[_type] is true ? false : _virginity[_type])>>
				<<if $player.virginity[_type] is false and $player?.virginityDetails?.[_type]?.taker>><<set $player.virginity[_type] to $player.virginityDetails[_type].taker>><</if>>
				<<if $player.virginity.temple isnot false and ["penile", "vaginal"].includes(_type)>><<set $player.virginity.temple to "unknown">><</if>>
			<<else>>
				<<set $player.virginity[_type] to true>>
				<<if $player.virginity.temple isnot false and ["penile", "vaginal"].includes(_type)>><<set $player.virginity.temple to true>><</if>>
			<</if>>
			<<run $(`#${_id}link .link-internal`).html($player.virginity[_type] is true and !$player?.virginityDetails?.[_type]?.taker ? "상실 처리" : "복구")>>
			<<run $(`#${_id}`).html($player.virginity[_type] is true ? "보존됨" : "상실됨: " + ($player.virginity[_type] is false ? "알 수 없음" : window.KR.gatPersonNameDictKR($player.virginity[_type])))>>
		<</link>></span>
	<</capture>>
<</widget>>

<<widget "cheatParasiteToggle">>
	<<set _bodypart to _args[0]>>
	<<set _parasiteTypes to setup.parasiteTypesPerBodypart[_bodypart]>>

	<<print window.KR.getBodypartKr(_bodypart)>>:
	<<capture _bodypart, _parasiteTypes, _i, _temp>>
		<<for _i = 0; _i < _parasiteTypes.length; _i++>>
			<span @id="_parasite" @class="_parasiteTypes[_i] is $parasite[_bodypart].name || _parasiteTypes[_i] is 'none' and !$parasite[_bodypart].name ? 'goldLink' : 'link' ">
				<<link `(_parasiteTypes[_i] is 'none' ? '없음' : window.KR.getCreatureTypeKr(_parasiteTypes[_i]))`>>
					<<removeparasite _bodypart>>
					<<set _temp to _parasiteTypes[_i]>>
					<<set _parasiteTypes[_i] to _parasiteTypes[0]>>
					<<set _parasiteTypes[0] to _temp>>
					<<if _temp isnot "none">>
						<<parasite _bodypart _temp>>
					<</if>>
					<<updatesidebarimg>>
					<<replace `"#"+ _bodypart`>><<cheatParasiteToggle _bodypart>><</replace>>
				<</link>>
			</span>
			<<if _i < _parasiteTypes.length - 1>> |<</if>>
		<</for>>
	<</capture>>
<</widget>>

<<widget "cheatBodyLiquid">>
	<<set _semen to _args[0]>>
	<<set _label to _semen is "goo" ? "slime" : _semen>>
	<div class="settingsToggleItem">
		<span class="gold"><<print window.KR.getFluidKr(_semen)>></span>
		<br>

		<<capture _type _semen>>
			<<link `'모두 추가: ' + window.KR.getFluidKr(_semen)`>>
				<<for _type range ["neck","rightarm","leftarm","thigh","bottom","tummy","chest","face","hair","feet","vaginaoutside","vagina","penis","anus","mouth"]>>
					<<bodyliquid _type _semen 5>><<run $(`#stats${_type}${_semen}`).html(Math.trunc($player.bodyliquid[_type][_semen]))>>
				<</for>>
				<<updatesidebarimg>>
				<<set _id to "#cheatLiquids-" + _semen>>
				<<replace _id>><<cheatBodyliquidElement _semen>><</replace>>
			<</link>>
		<</capture>> |

		<<capture _type _semen>>
			<<link `'모두 제거: ' + window.KR.getFluidKr(_semen)`>>
				<<for _type range ["neck","rightarm","leftarm","thigh","bottom","tummy","chest","face","hair","feet","vaginaoutside","vagina","penis","anus","mouth"]>>
					<<bodyliquid _type _semen -5>><<run $(`#stats${_type}${_semen}`).html(Math.trunc($player.bodyliquid[_type][_semen]))>>
				<</for>>
				<<updatesidebarimg>>
				<<set _id to "#cheatLiquids-" + _semen>>
				<<replace _id>><<cheatBodyliquidElement _semen>><</replace>>
			<</link>>
		<</capture>>
		<br>
		<<set _id to "cheatLiquids-" + _semen>>
		<span @id="_id">
			<<cheatBodyliquidElement _semen>>
		</span>
	</div>
<</widget>>

<<widget "cheatBodyliquidElement">>
	<<set _semen to _args[0]>>
	<<set _options to {
			max: 5,
			step: 1,
			values: [_semen],
			activeButtons: ["single", "minMax"],
			percentage: false,
			reverse: true,
			css: {display: "inline-block", "margin-bottom": "0"}
		}>>
	<<numberStepper "목" $player.bodyliquid.neck[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.neck[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "오른팔" $player.bodyliquid.rightarm[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.rightarm[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "왼팔" $player.bodyliquid.leftarm[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.leftarm[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "허벅지" $player.bodyliquid.thigh[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.thigh[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "엉덩이" $player.bodyliquid.bottom[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.bottom[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "배" $player.bodyliquid.tummy[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.tummy[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "가슴" $player.bodyliquid.chest[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.chest[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "얼굴" $player.bodyliquid.face[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.face[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "머리카락" $player.bodyliquid.hair[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.hair[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "발" $player.bodyliquid.feet[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.feet[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "음순" $player.bodyliquid.vaginaoutside[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.vaginaoutside[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "보지" $player.bodyliquid.vagina[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.vagina[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "자지" $player.bodyliquid.penis[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.penis[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "애널" $player.bodyliquid.anus[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.anus[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
	<<numberStepper "입" $player.bodyliquid.mouth[_semen] {...T.options, callback: (value, arr) => { V.player.bodyliquid.mouth[arr[0]] = value; Wikifier.wikifyEval("<<updatesidebarimg>>") }}>>
<</widget>>

<<widget "cheats-characterStats">>
	<div class="settingsGrid">
		<div class="settingsHeader options">플레이어</div>
		<div class="settingsToggleItemWide">
			<span class="gold">기타</span>
			<br>
			<<numberStepper "돈" $money {
				activeButtons: ["single", "double", "triple"],
				step: 1000,
				max: 10000000000,
				colorArr:["--yellow"],
				percentage: false,
				valueFormat: (value) => `<b>${formatMoney(value)}</b>`,
				callback: (value) => {
					const difference = value - V.money;
					V.moneyStats.cheats.earned += difference;
					V.money = value;
				}
			}>>

			<<if $location is "prison">>
				<<set $prison.teeth to $prison.teeth or 0>>
				<<numberStepper "치아" $prison.teeth {callback: (value) => V.prison.teeth = value, disableMinMax: true, step: 1, max: 1000000, colorArr:["--yellow"], percentage: false}>>
			<</if>>

			무한 스프레이: <span id="statsinfinitespray"><<= ($infinitespray ? "켜짐" : "꺼짐")>></span> |
			<<link "변경">>
				<<if $infinitespray is 1>>
					<<set $infinitespray to 0>>
				<<else>>
					<<spray 5>>
					<<set $infinitespray to 1>>
				<</if>>
				<<replace "#statsinfinitespray">><<= ($infinitespray ? "켜짐" : "꺼짐")>><</replace>>
			<</link>>
			<br>

			<<if $debug is 1>>
				페로몬 (디버그): <span id="statsalluretest"><<= $alluretest ? "켜짐" : "꺼짐">></span> |
				<<link "변경">>
					<<if $alluretest is 1>>
						<<set $alluretest to 0>>
					<<else>>
						<<set $alluretest to 1>>
					<</if>>
					<<replace "#statsalluretest">><<= $alluretest>><</replace>>
				<</link>>
				<br>
			<</if>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">신체</span> <mouse class="tooltip linkBlue">(?)<span>플레이어의 생식기를 변경하면 플레이어에게 묻어있는 음란한 체액을 씻어내고, 생식기 기생충을 제거하여 존재하지 않는 신체 부위에 남아있지 않도록 합니다.</span></mouse>
			<br>
			생식기:
			<span id="statsGender">
				<<cheatsSex>>
			</span>
			<br>
			<<set _gender_body_words to {"m": "남성적", "f": "여성적", "a": "어느쪽도 아님"}>>
			체형: <mouse class="tooltip linkBlue">(?)<span>얼마나 여성적이거나 남성적으로 보이는지에 기여합니다. 일반적인 게임 플레이에서, 특수 의류를 통해 여성화되거나 남성화되지 않는 한, 플레이어의 체형은 성별 외형에 기여하지 않습니다.</span></mouse>:
			<span id="statsBodyType">
				<<cheatsBody>>
			</span>
			<br>
			<<set _bodysize_words to ["아주 작음","작음","보통","큼"]>>
			체격:
			<span id="statsBodySize">
				<<cheatsBodySize>>
			</span>
			<br>
			몸매:
			<span id="statsBodyShape">
				<<cheatsBodyShape>>
			</span>
			<<if setup.faceStyleOptions.length gt 1>>
				<br>
				얼굴 스타일:
				<span id="statsFaceStyle">
					<<cheatsFaceStyle>>
				</span>
			<</if>>
			<br>
			태도:
			<span id="statsDemeanour">
				<<cheatsDemeanour>>
			</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">첫 경험</span>
			<br>
			<<set _virginity to clone($player.virginity)>>
			<<if $player.vaginaExist or $player.virginity.vaginal isnot true>>
				질: <<cheatVirginityToggle "vaginal">>
				<br>
			<</if>>
			<<if $player.penisExist or $player.virginity.penile isnot true>>
				자지: <<cheatVirginityToggle "penile">>
				<br>
			<</if>>
			애널: <<cheatVirginityToggle "anal">>
			<br>
			입: <<cheatVirginityToggle "oral">>
			<br>
			손잡기: <<cheatVirginityToggle "handholding">>
			<br>
			첫 키스: <<cheatVirginityToggle "kiss">>
			<<if $temple_rank isnot undefined and $temple_rank isnot "prospective">>
				<br>
				신전 서약: <<cheatVirginityToggle "temple">>
			<</if>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">상태</span>
			<br>
			<<set _state to ["pain", "arousal", "tiredness", "stress", "trauma", "drunk", "drugged", "hallucinogen"]>>

			<<link "새로고침">>
				<<set $control = 1000>><<clamp>>
				<<for _i range _state>>
					<<set V[_i] to 0>><<clamp>>
				<</for>>
				<<replace "#cheatstate">><<cheatSection "state">><</replace>>
				<<updatesidebarimg>>
			<</link>> |

			<<link "망가뜨리기">>
				<<set $control = 0>><<clamp>>
				<<for _i range _state>>
					<<set V[_i] to 20000>><<clamp>>
				<</for>>
				<<replace "#cheatstate">><<cheatSection "state">><</replace>>
				<<updatesidebarimg>>
			<</link>>
			<br><br>
			<div id="cheatstate">
				<<cheatSection "state">>
			</div>
		</div>
		<div class="settingsToggleItem">
			<span class="gold">체액:</span>
			<<link "다시 채우기">>
				<<set $semen_amount to $semen_volume>>
				<<set $milk_amount to $milk_volume>>
				<<replace "#fluids">><<cheats-fluids>><</replace>>
			<</link>> | <<link "비우기">>
				<<set $semen_amount to 0>>
				<<set $milk_amount to 0>>
				<<replace "#fluids">><<cheats-fluids>><</replace>>
			<</link>>
			<br>
<span class="gold">모유 분비:</span> <span id="statslactatingspray"><<= ($lactating is 1 ? "예" : "아니요")>></span> | <<link "전환">><<set $lactating to ($lactating is 1 ? 0 : 1)>><<set $lactation_pressure to $lactating * 100>><<replace "#statslactatingspray">><<= ($lactating is 1 ? "예" : "아니요")>><</replace>><<updatesidebarimg>><</link>>
			<br><br>
			<span id="fluids"><<cheats-fluids>></span>
			<<numberStepper "모유량" $milk_volume {
				callback: value => {
					V.milk_volume = value;
					V.milk_amount = Math.min(V.milk_amount, V.milk_volume);
					Wikifier.wikifyEval("<<replace '#fluids'>><<cheats-fluids>><</replace>>");
				},
				step: 10,
				valueFormat: value => Math.round(value) + "ml",
				percentage: false, min: 24, max: (V.cow >= 6 ? 6000 : 3000)
			}>>
			<<if $player.penisExist>>
				<<numberStepper "정액량" $semen_volume {
					callback: value => {
						V.semen_volume = value;
						V.semen_amount = Math.min(V.semen_amount, V.semen_volume);
						Wikifier.wikifyEval("<<replace '#fluids'>><<cheats-fluids>><</replace>>");
					},
					step: 10,
					valueFormat: value => Math.round(value) + "ml",
					percentage: false, max: (V.cow >= 6 ? 4000 : 3000)
				}>>
			<</if>>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader options">의류</div>
		<div class="settingsToggleItemWide">
			<<link "모든 특수 의류 해금">>
				<<run for(const c in V.specialClothes) {if (V.specialClothes[c].unlocked === 0) V.specialClothes[c].unlocked = 1}>>
			<</link>>
			<br>
			<span class="description">옷의 내구도가 0이 되면 찢어집니다. 이 상태로 치트 메뉴를 닫으면 옷이 완전히 파괴되며, 다시는 복구할 수 없습니다.</span>
			<br>
		</div>
		<<set _cl_slots to ["upper", "lower", "under_upper", "under_lower", "over_upper", "over_lower", "genitals"]>>
		<<if $worn.face.type.includesAny("face_covering", "gag", "mask")>>
			<<run _cl_slots.push("face")>>
		<</if>>
		<<set $_clothes to []>>

		<<if $worn.over_upper.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.over_upper "over_upper">><<= $worn.over_upper.name.toUpperFirst()>> 내구도:</span>

				<<set _overupperintegritymax to getSetupClothing('over_upper', $worn.over_upper)?.integrity_max || 200>>
				<<numberslider "$worn.over_upper.integrity" `Math.min($worn.over_upper.integrity, _overupperintegritymax)` 0 _overupperintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.over_upper, "over_upper") || `<span class="green">최대</span>`
				}>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.over_upper "over_upper">><<= $worn.over_upper.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$overupperwet" $overupperwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('overupperwet', value),
					value: v => wetnessWord('overupper')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("겉옷 상의")>>
		<</if>>
		<<if $worn.over_lower.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<<set _overlowerintegritymax to getSetupClothing('over_lower', $worn.over_lower)?.integrity_max || 200>>
				<span class="gold"><<clothingicon $worn.over_lower "over_lower">><<= $worn.over_lower.name.toUpperFirst()>> 내구도:</span>
				<<numberslider "$worn.over_lower.integrity" `Math.min($worn.over_lower.integrity, _overlowerintegritymax)` 0 _overlowerintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.over_lower, "over_lower") || `<span class="green">최대</span>`
				}>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.over_lower "over_lower">><<= $worn.over_lower.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$overlowerwet" $overlowerwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('overlowerwet', value),
					value: v => wetnessWord('overlower')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("겉옷 하의")>>
		<</if>>

		<<if $worn.upper.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.upper "upper">><<= $worn.upper.name.toUpperFirst()>> 내구도:</span>
				<<set _upperintegritymax to getSetupClothing('upper', $worn.upper)?.integrity_max || 200>>
				<<numberslider "$worn.upper.integrity" `Math.min($worn.upper.integrity, _upperintegritymax)` 0 _upperintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.upper, "upper") || `<span class="green">최대</span>`
				}>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.upper "upper">><<= $worn.upper.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$upperwet" $upperwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('upperwet', value),
					value: v => wetnessWord('upper')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("상의")>>
		<</if>>

		<<if $worn.lower.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.lower "lower">><<= $worn.lower.name.toUpperFirst()>> 내구도:</span>
				<<set _lowerintegritymax to getSetupClothing('lower', $worn.lower)?.integrity_max || 200>>
				<<numberslider "$worn.lower.integrity" `Math.min($worn.lower.integrity, _lowerintegritymax)` 0 _lowerintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.lower, "lower") || `<span class="green">최대</span>`
				}>>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.lower "lower">><<= $worn.lower.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$lowerwet" $lowerwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('lowerwet', value),
					value: v => wetnessWord('lower')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("하의")>>
		<</if>>

		<<if $worn.under_lower.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.under_lower "under_lower">><<= $worn.under_lower.name.toUpperFirst()>> 내구도:</span>
				<<set _underlowerintegritymax to getSetupClothing('under_lower', $worn.under_lower)?.integrity_max || 200>>
				<<numberslider "$worn.under_lower.integrity" `Math.min($worn.under_lower.integrity, _underlowerintegritymax)`  0 _underlowerintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.under_lower, "under_lower") || `<span class="green">최대</span>`
				}>>
				<br>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.under_lower "under_lower">><<= $worn.under_lower.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$underlowerwet" $underlowerwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('underlowerwet', value),
					value: v => wetnessWord('underlower')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("속옷 하의")>>
		<</if>>

		<<if $worn.under_upper.integrity gte 1>>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.under_upper "under_upper">><<= $worn.under_upper.name.toUpperFirst()>> 내구도:</span>
				<<set _underupperintegritymax to getSetupClothing('under_upper', $worn.under_upper)?.integrity_max || 200>>
				<<numberslider "$worn.under_upper.integrity" `Math.min($worn.under_upper.integrity, _underupperintegritymax)` 0 _underupperintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.under_upper, "under_upper") || `<span class="green">최대</span>`
				}>>
				<br>
			</div>
			<div class="settingsToggleItem numberslider-inline">
				<span class="gold"><<clothingicon $worn.under_upper "under_upper">><<= $worn.under_upper.name.toUpperFirst()>> 젖음도:</span>
				<<numberslider "$underupperwet" $underupperwet 0 200 1 {
					onInputChange: (value) => cheatsShowWetness('underupperwet', value),
					value: v => wetnessWord('underupper')
				}>>
			</div>
		<<else>>
			<<set $_clothes.push("속옷 상의")>>
		<</if>>

		<<if $worn.genitals.integrity gte 1>>
			<div class="settingsToggleItemWide numberslider-inline">
				<span class="gold"><<clothingicon $worn.genitals "genitals">><<= $worn.genitals.name.toUpperFirst()>> 내구도:</span>
				<<set _genitalsintegritymax to getSetupClothing('genitals', $worn.genitals)?.integrity_max || 200>>
				<<numberslider "$worn.genitals.integrity" `Math.min($worn.genitals.integrity, _genitalsintegritymax)` 0 _genitalsintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.genitals, "genitals") || `<span class="green">최대</span>`
				}>>
				<br>
			</div>
		<<else>>
			<<set $_clothes.push("정조대")>>
		<</if>>

		<<if $worn.face.type.includesAny("face_covering", "gag", "mask")>>
			<div class="settingsToggleItemWide numberslider-inline">
				<span class="gold"><<clothingicon $worn.face "face">><<= $worn.face.name.toUpperFirst()>> 내구도:</span>

				<<set _faceintegritymax to getSetupClothing('face', $worn.face)?.integrity_max || 200>>
				<<numberslider "$worn.face.integrity" `Math.min($worn.face.integrity, _faceintegritymax)` 0 _faceintegritymax 1 {
					onInputChange: value => wikifier("<<updatesidebarimg false>>"),
					value: () => integrityWord(V.worn.face, "face") || `<span class="green">최대</span>`
				}>>
				<br>
			</div>
		<<else>>
			<<set $_clothes.push("가면 또는 재갈")>>
		<</if>>
		<div class="settingsToggleItemWide">
			당신은 <span class="gold"><<= $_clothes.join(", ")>></span>【을를】 입고 있지 않습니다.

			<br>
			<label>자동 수선 <<checkbox "$cheatClothes" false true autocheck>></label> |
			/* Don't show links if player doesn't have anything to fix/destroy */
			<<if $_clothes.length lt 8>>
				<<link "모두 고치기">>
					<<run _cl_slots.forEach((slot) => {
						if (V.worn[slot].name === "naked") return;
						V.worn[slot].integrity = clothingData(slot, V.worn[slot], "integrity_max");
						cheatsUpdateSlider(
							`#numberslider-input-worn${slot.replace('_', '-')}integrity`,
							V.worn[slot].integrity
						);
					})>>
					<<updatesidebarimg>>
				<</link>> |
				<<link "모두 망가뜨리기">>
					/* not using ruined widgets to avoid side effects until confirmation */
					<<run _cl_slots.forEach((slot) => {
						if (V.worn[slot].name === "naked") return;
						V.worn[slot].integrity = 0;
						cheatsUpdateSlider(
							`#numberslider-input-worn${slot.replace('_', '-')}integrity`,
							V.worn[slot].integrity
						);
					})>>
					<<updatesidebarimg>>
				<</link>>
			<</if>>
			/* Don't show unless the player is wearing clothes that can be drenched or dried */
			<<if !$_clothes.includesAll("겉옷 상의", "겉옷 하의", "상의", "하의", "속옷 하의", "속옷 상의")>>
				| <<link "모두 말리기">>
					<<dry_full>>
					<<run _cl_slots.slice(0, 4).forEach((slot) => {
						if (V.worn[slot].name === 'naked') return;
						const wetnessProp = slot.replace('_', '') + 'wet';
						V[wetnessProp + 'stage'] = 0;
						cheatsUpdateSlider(`#numberslider-input-${wetnessProp}`, V[wetnessProp]);
					})>>
					<<updatesidebarimg>>
				<</link>> |
				<<link "모두 적시기">>
					<<run _cl_slots.slice(0, 4).forEach((slot) => {
						if (V.worn[slot].name === 'naked') return;
						const wetnessProp = slot.replace('_', '') + 'wet';
						V[wetnessProp] = 200;
						V[wetnessProp + 'stage'] = 3;
						cheatsUpdateSlider(`#numberslider-input-${wetnessProp}`, V[wetnessProp]);
					})>>
					<<updatesidebarimg>>
				<</link>>
			<</if>>
			<br><br>
			<span class="gold">구속구:</span>
			<br>
			<span class="description"> 팔을 결박하면 손에 든 아이템이 파괴됩니다. 발에 족쇄를 채우면 신발이 파괴됩니다.</span>
			<br>
			<<icon "clothes/gag.png">><<link "재갈">><<facewear "gag">><<updatesidebarimg>><</link>> | <<link "눈가리개">><<facewear "blindfold">><<updatesidebarimg>><</link>> | <<link "재갈과 눈가리개">><<facewear "gag and blindfold">><<updatesidebarimg>><</link>> | <<link "팔 결박">><<bind>><<updatesidebarimg>><</link>> | <<link "발 족쇄">><<shackle_feet>><<updatesidebarimg>><</link>>
			<br>
			<<undobindingsicon>> <<link "모든 구속 풀기">><<unbind>><<if $worn.face.type.includes("gag") or $worn.face.type.includes("blindfold")>><<set $worn.face.type.push("broken")>><<faceruined>><</if>><<updatesidebarimg>><</link>>

			<<if $debug is 1>>
				<br><br>
				<span class="gold">옷장에 추가:</span>
				<br>
				<span class="description">디버그: 입력된 ID의 의류를 옷장으로 보냅니다.</span>
				<br>
				<<listbox "_slot" autoselect>>
					<<optionsfrom Object.fromEntries(setup.clothingLayer.body.map(s => [window.KR.getClothingSlotKr(s), s]))>>
				<</listbox>>
				<<set _clothesID to 1>>
				<<numberbox "_clothesID" 1>>
				<br>
				<<link "보내기">>
					<<if !between(_clothesID, 1, setup.clothes[_slot].length - 1)>>
						<<replace "#ClothesSendResult">>작동하지 않았습니다!<</replace>>
					<<else>>
						<<shopbuyv2 _slot "buy" "send" _clothesID 1>>
						<<replace "#ClothesSendResult">><<= setup.clothes[_slot][_clothesID].name>>【을를】 옷장에 보냈습니다!<</replace>>
					<</if>>
				<</link>>
				<br>
				<span id="ClothesSendResult"></span>
			<</if>>
		</div>
	</div>
	<hr>
	<div class="cheatsGrid">
		<div class="settingsHeader options">특성</div>
		<div class="settingsToggleItem">
			<<set _core to ["purity", "beauty", "physique", "willpower", "awareness", "promiscuity", "exhibitionism", "deviancy"]>>
