			<span class="gold">핵심 특성</span>
			<br>
			<<link "모두 0으로 설정">>
				<<for _i range _core>>
					<<set V[_i] to 0>><<clamp>>
				<</for>>
				<<replace "#characteristics">><<cheatSection "characteristics">><</replace>>
			<</link>>
			|
			<<link "모두 최대로 설정">>
				<<for _i range _core>>
