					<<set $orgasmtrait to -1>>
				<</if>>
				<<replace "#statsorgasmtrait">>
					<<set _orgasmtrait to _traitValue[$orgasmtrait.toString()]>>
					<<= _orgasmtrait>>
					<<changeCheatClass "#statsorgasmtrait" _orgasmtrait>>
				<</replace>>
			<</link>>
			<br>

