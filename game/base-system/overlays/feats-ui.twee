:: FeatsUI [widget]
<<widget "feats">>
	<<updateFeats>>
	<br>
Degrees of Lewdity를 플레이하며 다양한 임무를 완수함으로써 <span class="gold">업적</span>을 얻게 됩니다. 더 많은 업적을 얻을수록 더 많은 <span class="gold">브렐 코인</span>을 얻습니다. 새로운 게임을 시작할 때 브렐 코인을 이용해 <span class="gold">업적 부스터</span>를 구매할 수 있습니다. 이 부스터들은 다음 게임 시 다양한 보너스를 제공합니다.
	<br><br>
	이 탭은 <span class="gold">가장 최근에 불러온 세이브</span>에서 해금된 모든 업적들을 보여주며, 이 정보는 다음 게임으로 인계됩니다. 브렐 코인은 하나의 게임 회차 내에서 누적되어 얻어집니다. <span class="red">여러 세이브 파일들을 넘나들며 플레이할 경우 획득한 코인과 잠금 해제된 업적들이 초기화되어 사라질 수 있습니다.</span>
	<br><br>
	모든 업적을 달성하기 위해서는 여러 번의 플레이가 필요합니다. 각기 다른 업적을 달성한 여러 세이브 파일이 존재한다면, 새로운 게임을 시작할 때 업적 부스터 창에 위치한 <span class="gold">모든 업적 불러오기</span> 버튼을 통해 여러 업적들을 병합할 수 있습니다. 100% 달성을 노리고 계시다면 참고해 주시길 바랍니다!
	<br><br>
	어떤 업적들은 조건을 달성하자마자 획득 표시가 뜨지만, 또 다른 업적들은 게임 내 시간이 다음 시간으로 넘어가야 표시됩니다. 그럼 즐거운 수집 시간 되시길 바랍니다!
	<br><br>

	<<if $feats.locked>>
		<span class="red">플레이 도중 치트를 사용한 기록이 있어 업적을 달성할 수 없습니다.</span>
	<<elseif $debug is 1>>
		<span class="red">디버그 모드 중에는 업적을 달성할 수 없습니다.</span>
	<<elseif $replayScene isnot undefined>>
		<span class="red">리플레이 모드 중에는 업적을 달성할 수 없습니다.</span>
	<<elseif $feats.soft or $feats.pregnancyLocked>>
		<span class="red">현재 게임에서는 몇몇 업적들의 해금이 제한됩니다.</span>
	<<else>>
		<span class="green">업적을 달성할 수 있습니다.</span>
	<</if>>
	<br><br>
	<<set _keysSetup to Object.keys(setup.feats)>>
	<<set _keysSave to Object.keys($feats.currentSave)>>
	<<set _keysAll to Object.keys($feats.allSaves).filter(f => !["points", "specialClothes"].includes(f))>>
	현재 <<if $feats.allSaves.point is undefined>><span class="gold"><<print $feats.allSaves.points>></span><<else>><span class="red">0</span><</if>>개의 <<pluralise $feats.allSaves.points "브렐 코인" "브렐 코인">>【을를】 소지하고 있습니다.
	달성한 업적:
	<<if _keysSave.length gte 1>>현재 세이브 파일에서 총 <span class="gold"><<print _keysSave.length>></span>개의 <<pluralise _keysSave.length "업적" "업적">>【을를】 달성했으며, <</if>>
	전체 <span class="gold"><<print _keysSetup.length>></span>개 중 총 <<if _keysAll.length gte 1>><span class="gold"><<print _keysAll.length>></span><<else>><span class="red">0</span><</if>>개의 <<pluralise _keysAll.length "업적" "업적">>【을를】 해금했습니다.
	<br><br>
	<<set $feats.filter to "General">>
	필터 적용:
	<select id="featTypes" name="featTypes" onchange="V.feats.filter = this.value; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')">
		<option value="General" selected>일반</option>
		<option value="Stats">스탯</option>
		<option value="Social">사교</option>
		<option value="Transformation">신체 변화</option>
		<option value="Discoveries-Town">발견 - 시내</option>
		<option value="Discoveries-Other">발견 - 시외</option>
		<option value="Special">특수</option>
		<option value="Pregnancy">임신</option>
		<option value="All">모두 보기</option>
		<option value="General" hidden="hidden" selected="selected">일반</option>
	</select>
	<br>
	<<set $feats.sort to "None">>
	정렬 기준:
	<select id="featSort" name="featSort" onchange="V.feats.sort = this.value; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')">
		<option value="None" selected>없음</option>
		<option value="Date">날짜순</option>
		<option value="None" hidden="hidden" selected="selected">없음</option>
	</select>
	<br>
	<<set $feats.shownew to true>>
	<input type="checkbox" checked name="showNew" onchange="V.feats.shownew = this.checked; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')" /> 신규 표시 |
	<<set $feats.showold to true>>
	<input type="checkbox" checked name="showOld" onchange="V.feats.showold = this.checked; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')" /> 기존 표시 |
	<<set $feats.showmissing to true>>
	<input type="checkbox" checked name="showMissing" onchange="V.feats.showmissing = this.checked; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')" /> 미달성 표시
	<br><br>
	<div id="featsList">
		<<featsList>>
	</div>
<</widget>>

<<widget "featsList">>
	<<set _skip to []>>
	<<set _sorting to []>>
	<<for _i to 0; _i lt _keysSetup.length; _i++>>
		<<set _setup to setup.feats[_keysSetup[_i]]>>
		<<if !_setup.filter.includes($feats.filter)>>
			<<continue>>
		<</if>>
		<<if _keysSave.includes(_keysSetup[_i])>>
			<<if !$feats.shownew>><<continue>><</if>>
			<<set _owned to 2>>
			<<set _date to new Date($feats.currentSave[_keysSetup[_i]])>>
		<<elseif _keysAll.includes(_keysSetup[_i])>>
			<<if !$feats.showold>><<continue>><</if>>
			<<set _owned to 1>>
			<<set _date to new Date($feats.allSaves[_keysSetup[_i]])>>
		<<else>>
			<<if !$feats.showmissing>><<continue>><</if>>
			<<if _setup.hidden or _skip.includes(_setup.series)>>
				<<continue>>
			<</if>>
			<<if _setup.series isnot "">>
				<<set _skip.push(_setup.series)>>
			<</if>>
			<<set _owned to 0>>
			<<set _date to 0>>
		<</if>>
		<<set _sorting.push( { key: _keysSetup[_i], owned: _owned, date: _date } )>>
	<</for>>
	<<if $feats.sort is "Date">>
		<<set _sorting to _sorting.sort(function(a, b) { return b.date - a.date; })>>
	<</if>>
	<<for _i to 0; _i lt _sorting.length; _i++>>
		<<set _feat to _sorting[_i]>>
		<<set _setup to setup.feats[_feat.key]>>
		<div class="feat">
			<div class="featImage">
				<<if _feat.owned gt 0>>
					<<set _featType to ["copper", "silver", "gold", "platinum", "jeweled"][_setup.difficulty - 1]>>
					<img @src="'img/ui/coin-'+_featType+(_feat.owned is 1 ? '-dull':'')+'.png'" class="featCoin" @style="(_feat.owned is 1 ? 'filter:brightness(65%) contrast(85%);':'')">
				<<else>>
					<img class="dot">
				<</if>>
			</div>
			<div class="featText">
				<<if ($feats.pregnancyLocked and _setup.pregnancyLockable) or ($feats.soft and _setup.softLockable) or $feats.locked or ($gamemode is "soft" or $settings.allureModifier lt 1)>>
					<<set _titleColor to " red">>
				<<else>>
					<<set _titleColor to "">>
				<</if>>
				<<if _feat.owned gt 0 or _setup.hint is undefined>>
					<span @class="'title' + _titleColor"><<print (Scripting.evalTwineScript(_setup.altCond ?? "false") && _feat.owned is 2) ? _setup.alt : _setup.title>></span>
					<span class="text"><<print _setup.desc>></span>
				<<else>>
					<span @class="'title' + _titleColor">?????</span>
					<span class="text"><<print _setup.hint>></span>
				<</if>>
				<br>
				<<if _feat.owned is 2>>
					<span class="text">달성 일시: <<print _feat.date.toLocaleString(returnTimeFormat())>></span>
				<<elseif _feat.owned is 1>>
					<span class="text">최초 달성 일시: <<print _feat.date.toLocaleString(returnTimeFormat())>></span>
				<</if>>
			</div>
		</div>
	<</for>>
<</widget>>

/*Feat Points Menu*/
<<widget "featsPointsMenu">>
	<div id="featsStats" class="settingsToggleIndent">
		<<if $feats.allSaves.points is undefined or $feats.allSaves.points is 0>>
			당신은 평생 총 <span class="red">0 브렐 코인</span>을 얻었으며, 위업 부스터를 구매할 수 없습니다.
			<br>
			<span class="black small-description">이 내용이 잘못되었다면, 마지막 세이브를 로드하고 다시 시작해 주십시오.</span>
		<<else>>
			당신은 평생 총 <span class="green"><<print $feats.allSaves.points>> <<pluralise $feats.allSaves.points "브렐 코인" "브렐 코인">></span>【을를】 얻었습니다.
		<</if>>
	</div>
	/*Have to do this due to the `????` names*/
	<<set _listbox to '<<listbox "_upgradeNameID" autoselect>>'>>
	<<for $_i to 0; $_i lt _upgradeNames.length; $_i++>>
		<<if !$featsBoosts.hidden[_upgradeNames[$_i]]>>
			<<set _listbox += '<<option _visibleUpgradeNames[' + $_i + '] _visibleUpgradeIDs[' + $_i + ']>>'>>
		<</if>>
	<</for>>
	<<set _upgradeName to _upgradeNames[_upgradeNameID or 0]>>
	<<set _listbox += '<</listbox>>'>>
	<span class="gold settingsToggleIndent">위업 부스트:</span>
	<<print _listbox>>

	<div class="settingsGridFeats">
		<div class="settingsHeader">
			<span id="featName"><<featName>></span>
			<br>
			<span style="font-size:80%;">
				<<link "이전">>
					<<set _upgradeNameID-->>
					<<if _upgradeNameID lt 0>>
						<<set _upgradeNameID to _upgradeNames.length - 1>>
					<</if>>
					<<if $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]>>
						<<for _upgradeNameID; $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]; _upgradeNameID-->>
						<</for>>
					<</if>>
					<<set _upgradeName to _upgradeNames[_upgradeNameID]>>
					<<updateFeatsPointsMenu>>
					<<updateFeatName>>
				<</link>> |
				<<link "다음">>
					<<set _upgradeNameID++>>
					<<if _upgradeNameID gte _upgradeNames.length>>
						<<set _upgradeNameID to 0>>
					<</if>>
					<<if $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]>>
						<<for _upgradeNameID; $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]; _upgradeNameID++>>
							<<if (_upgradeNameID + 1) gte _upgradeNames.length>>
								<<set _upgradeNameID to 0>>
								<<break>>
							<</if>>
						<</for>>
					<</if>>
					<<set _upgradeName to _upgradeNames[_upgradeNameID]>>
					<<updateFeatsPointsMenu>>
					<<updateFeatName>>
				<</link>>
			</span>
		</div>
		/*<<set _upgradeName to _upgradeNames[_upgradeNameID]>>*/
		<div @id="'feats-' + _upgradeName" class="settingsToggleItem">
			<<featsMenu _upgradeName>>
			<<if $featsBoosts.pointsUsed isnot 0>>
				<hr>
				구매한 위업 부스트:
				<ul>
					<<for $_i to 0; $_i lt _upgradeNames.length; $_i++>>
						<<if $featsBoosts.upgrades[_upgradeNames[$_i]] gt 0>>
							<li>
							<<switch _upgradeNames[$_i]>>
								<<case "randomClothing">>
									<<= ($featsBoosts.clothingGender is "Either" ? "남녀 공용" : $featsBoosts.clothingGender is "Male" ? "남성용" : "여성용")>> <<print $featsBoosts.name[_upgradeNames[$_i]]>>: <span class="gold"><<print $featsBoosts.upgrades[_upgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_upgradeNames[$_i]] "코인" "코인">>
								<<case "specialClothing">>
									특수 의류: <span class="gold"><<print $featsBoosts.upgrades[_upgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_upgradeNames[$_i]] "코인" "코인">>
									<br>
										<<foldout false "_unlockedSets">>
											<span class="gold">해금된 세트</span>
											<span class="descriptunlocked-hint">
												<<= Object.keys($featsBoosts.specialClothesSets)
												.filter(k => $featsBoosts.specialClothesSets[k])
												.map(k => `${setup.specialClothesSets[k].text}: <span class="gold">${setup.specialClothesSets[k].featCost}</span> 코인`)
												.join("<br>")>>
											</span>
										<</foldout>>
								<<case "seeds">>
									시작 씨앗: <span class="gold"><<print $featsBoosts.upgrades[_upgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_upgradeNames[$_i]] "코인" "코인">>
									<br>
										<<foldout false "_unlockedSeed">>
											<span class="gold">해금된 씨앗</span>
											<span class="descriptunlocked-hint">
												<<= Object.keys($featsBoosts.seeds)
												.filter(k => $featsBoosts.seeds[k])
												.map(k => `${setup.foodstuff[k].name}: <span class="gold">${setup.foodstuff[k].tending.featCost}</span> 코인`)
												.join("<br>")>>
											</span>
										<</foldout>>
								<<default>>
									<<= $featsBoosts.name[_upgradeNames[$_i]]>>: <span class="gold"><<print $featsBoosts.upgrades[_upgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_upgradeNames[$_i]] "코인" "코인">>
							<</switch>>
							</li>
						<</if>>
					<</for>>
				</ul>
				<<set _pointsRemaining to $feats.allSaves.points - $featsBoosts.pointsUsed>>
				당신에게는 위업 부스트에 사용할 수 있는 <span class="green"><<print _pointsRemaining>> <<pluralise _pointsRemaining "브렐 코인" "브렐 코인">></span>【이가】 남아 있습니다.
			<</if>>
		</div>
	</div>
<</widget>>

<<widget "updateFeatName">>
	<<replace #featName>>
		<<featName>>
	<</replace>>
<</widget>>

<<widget "featName">>
	<<set _details to $featsBoosts.upgradeDetails[_upgradeName]>>
	<<if _details.max gte 1>>
		<<switch _upgradeName>>
			<<case "money">>
				<span class="gold">시작 소지금</span>
			<<case "grades">>
				<span class="gold">시작 학교 성적</span>
			<<case "purity">>
				<span class="gold">일일 순결함 상승치 증가</span>
			<<case "impurity">>
				<span class="gold">일일 순결함 감소치 증가</span>
			<<case "newLife">>
				<span class="gold">새로운 삶</span>
			<<case "aNewBestFriend">>
				<span class="gold">새로운 친구</span>
			<<case "randomClothing">>
				<span class="gold">무작위 옷 세트</span>
			<<case "tattoos">>
				<span class="gold">시작 문신</span>
			<<case "specialClothing">>
				<span class="gold">특수 의상</span>
			<<case "seeds">>
				<span class="gold">시작 씨앗</span>
			<<case "sexToys">>
				<span class="gold">섹스 토이</span>
			<<case "skulduggery">>
				<span class="gold">시작 속임수 등급</span>
			<<case "dancing">>
				<span class="gold">시작 춤 등급</span>
			<<case "tending">>
				<span class="gold">시작 관리 등급</span>
			<<case "swimming">>
				<span class="gold">시작 수영 등급</span>
			<<case "athletics">>
				<span class="gold">시작 체육 등급</span>
			<<case "seduction">>
				<span class="gold">시작 유혹 등급</span>
			<<case "housekeeping">>
				<span class="gold">시작 가사 등급</span>
			<<default>>
				<span class="gold" style="text-transform: capitalize;">시작 _upgradeName 등급</span>
		<</switch>>
	<<else>>
		<span class="red">?????</span>
	<</if>>
<</widget>>

<<widget "featsMenu">>
	<<set _name to _args[0]>>
	<<capture _name>>
		<<set _details to $featsBoosts.upgradeDetails[_name]>>
		<<set _maxUpgrades to _details.max>>
		<<set _purchasedUpgrades to _details.purchased>>
		<<if _maxUpgrades>>
			<<if !$feats.allSaves.points>>
				<span class="red">이 위업 부스트를 구매하려면 브렐 코인을 획득하세요!</span>
			<<else>>
				<<switch _name>>
					<<case "money">>
						당신은 <span class="green"> £<<= 5 + _purchasedUpgrades * _maxUpgrades * 25>>.00</span>의 자금으로 게임을 시작합니다.
					<<case "grades">>
						당신은
						<<switch _details.purchased>>
							<<case 2>><span class="lblue">B</span>
							<<case 1>><span class="blue">C</span>
							<<default>><span class="purple">D</span>
						<</switch>>
						학점으로 게임을 시작합니다.
					<<case "purity">>
						<<if !_purchasedUpgrades>>
							당신은 항상 매일 <span class="green">1</span>점의 순결도를 얻습니다. 구매한 순결도 부스트는 일일 순결도 획득량을 증가시킵니다. <i>당신의 행동에 따라 순결도 획득이 상쇄되거나 증폭될 수 있습니다.</i>
						<<else>>
							당신은 항상 매일 <span class="green"><<print 1 + _purchasedUpgrades>></span>점의 순결도를 얻습니다. <i>당신의 행동에 따라 순결도 획득이 상쇄되거나 증폭될 수 있습니다.</i>
						<</if>>
					<<case "impurity">>
						<<switch _purchasedUpgrades>>
							<<case 0>>
								당신은 항상 매일 <span class="green">1</span>점의 순결도를 얻습니다. 구매한 불결함 부스트는 이 일일 순결도 획득량을 상쇄시킵니다. <i>당신의 행동에 따라 순결도 감소가 상쇄되거나 증폭될 수 있습니다.</i>
							<<case 1>>
								당신은 항상 매일 <span class="red">1</span>점의 순결도를 잃습니다. 이는 정상적이라면 자정에 얻었을 일일 순결도 1점을 상쇄합니다. <i>당신의 행동에 따라 순결도 감소가 상쇄되거나 증폭될 수 있습니다.</i>
							<<default>>
								당신은 항상 매일 <span class="red"><<= _purchasedUpgrades - 1>></span> 점의 순결도를 잃습니다. <i>당신의 행동에 따라 순결도 감소가 상쇄되거나 증폭될 수 있습니다.</i>
						<</switch>>
					<<case "newLife">>
						당신은
						<span @class="$featsBoosts.upgrades.newLife ? 'green' : 'red'">
							<<= $featsBoosts.upgrades.newLife ? "기생충과 함께" : "기생충 없이">>
						</span>
						게임을 시작합니다.
					<<case "aNewBestFriend">>
						당신은
						<<switch $featsBoosts.upgrades.aNewBestFriend>>
							<<case 0>>귀 슬라임 <span class='red'>없이</span> 게임을 시작합니다.
							<<case 10>>귀 슬라임 <span class='green'>한 마리와 함께</span> 게임을 시작합니다.
							<<case 20>>귀 슬라임 <span class='green'>두 마리와 함께</span> 게임을 시작합니다.
						<</switch>>
					<<case "randomClothing">>
						무작위 의류 아이템 <span class="gold"><<= 3 * _purchasedUpgrades>></span>개를 가지고 게임을 시작합니다.
					<<case "tattoos">>
						<<if _purchasedUpgrades is 0>>
							문신이 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<<elseif _purchasedUpgrades is 1>>
							문신 <span class="green">1</span>개를 가지고 게임을 시작합니다.
						<<else>>
							문신 <span class="green">_purchasedUpgrades</span>개를 가지고 게임을 시작합니다.
						<</if>>
					<<case "specialClothing">>
						<<if _purchasedUpgrades is 0>>
							숲속 상점의 특수 의류가 <span class='red'>잠긴</span> 상태로 게임을 시작합니다.
						<<elseif _purchasedUpgrades is 1>>
							다른 세이브 파일에서 숲속 상점의 특수 의류 세트를 해금한 적이 있다면, <span class="teal">최대 절반</span>까지 구매하여 <span class="green">해금된</span> 상태로 게임을 시작할 수 있습니다.
						<<else>>
							다른 세이브 파일에서 숲속 상점의 특수 의류 세트를 해금한 적이 있다면, <span class="teal">원하는 만큼</span> 구매하여 <span class="green">해금된</span> 상태로 게임을 시작할 수 있습니다.
						<</if>>
					<<case "seeds">>
						<<if _purchasedUpgrades is 0>>
							씨앗이 <span class='red'>하나도 없는</span> 상태로 게임을 시작합니다.
						<<elseif _purchasedUpgrades is 1>>
							다른 세이브 파일에서 씨앗을 해금한 적이 있다면, <span class="teal">최대 절반</span>까지 구매하여 <span class="green">해금된</span> 상태로 게임을 시작할 수 있습니다.
						<<else>>
							다른 세이브 파일에서 씨앗을 해금한 적이 있다면, <span class="teal">원하는 만큼</span> 구매하여 <span class="green">해금된</span> 상태로 게임을 시작할 수 있습니다.
						<</if>>
					<<case "sexToys">>
						당신은
						<<if _purchasedUpgrades>>
							섹스 토이 <span class="green"><<print 3 * _purchasedUpgrades>></span>개를 가지고 게임을 시작합니다.
						<<else>>
							섹스 토이가 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<</if>>
					<<case "skulduggery">>
						<<switch _purchasedUpgrades>>
							<<case 1>><span class="pink">F+</span> 등급의 속임수 기술을 가지고 게임을 시작합니다.
							<<case 2>><span class="purple">D</span> 등급의 속임수 기술을 가지고 게임을 시작합니다.
							<<case 3>><span class="purple">D+</span> 등급의 속임수 기술을 가지고 게임을 시작합니다.
							<<case 4>><span class="blue">C</span> 등급의 속임수 기술을 가지고 게임을 시작합니다.
							<<default>>속임수 기술에 대한 숙련도가 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<</switch>>
					<<case "dancing">>
						<<switch _purchasedUpgrades>>
							<<case 1>><span class="pink">F+</span> 등급의 춤 기술을 가지고 게임을 시작합니다.
							<<case 2>><span class="purple">D</span> 등급의 춤 기술을 가지고 게임을 시작합니다.
							<<case 3>><span class="purple">D+</span> 등급의 춤 기술을 가지고 게임을 시작합니다.
							<<case 4>><span class="blue">C</span> 등급의 춤 기술을 가지고 게임을 시작합니다.
							<<default>>춤 기술에 대한 숙련도가 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<</switch>>
					<<case "tending">>
						<<switch _purchasedUpgrades>>
							<<case 1>><span class="pink">F+</span> 등급의 관리 기술을 가지고 게임을 시작합니다.
							<<case 2>><span class="purple">D</span> 등급의 관리 기술을 가지고 게임을 시작합니다.
							<<case 3>><span class="purple">D+</span> 등급의 관리 기술을 가지고 게임을 시작합니다.
							<<case 4>><span class="blue">C</span> 등급의 관리 기술을 가지고 게임을 시작합니다.
							<<default>>관리 기술에 대한 숙련도가 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<</switch>>
					<<case "swimming">>
						<<switch _purchasedUpgrades>>
							<<case 1>><span class="pink">F+</span> 등급의 수영 기술을 가지고 게임을 시작합니다.
							<<case 2>><span class="purple">D</span> 등급의 수영 기술을 가지고 게임을 시작합니다.
							<<case 3>><span class="purple">D+</span> 등급의 수영 기술을 가지고 게임을 시작합니다.
							<<case 4>><span class="blue">C</span> 등급의 수영 기술을 가지고 게임을 시작합니다.
							<<default>>수영 기술에 대한 숙련도가 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<</switch>>
					<<case "athletics">>
						<<switch _purchasedUpgrades>>
							<<case 1>><span class="pink">F+</span> 등급의 체육 기술을 가지고 게임을 시작합니다.
							<<case 2>><span class="purple">D</span> 등급의 체육 기술을 가지고 게임을 시작합니다.
							<<case 3>><span class="purple">D+</span> 등급의 체육 기술을 가지고 게임을 시작합니다.
							<<case 4>><span class="blue">C</span> 등급의 체육 기술을 가지고 게임을 시작합니다.
							<<default>>체육 기술에 대한 숙련도가 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<</switch>>
					<<case "seduction">>
						<<switch _purchasedUpgrades>>
							<<case 1>><span class="pink">F+</span> 등급의 유혹 기술을 가지고 게임을 시작합니다.
							<<case 2>><span class="purple">D</span> 등급의 유혹 기술을 가지고 게임을 시작합니다.
							<<case 3>><span class="purple">D+</span> 등급의 유혹 기술을 가지고 게임을 시작합니다.
							<<case 4>><span class="blue">C</span> 등급의 유혹 기술을 가지고 게임을 시작합니다.
							<<default>>유혹 기술에 대한 숙련도가 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<</switch>>
					<<case "housekeeping">>
						<<switch _purchasedUpgrades>>
							<<case 1>><span class="pink">F+</span> 등급의 가사 기술을 가지고 게임을 시작합니다.
							<<case 2>><span class="purple">D</span> 등급의 가사 기술을 가지고 게임을 시작합니다.
							<<case 3>><span class="purple">D+</span> 등급의 가사 기술을 가지고 게임을 시작합니다.
							<<case 4>><span class="blue">C</span> 등급의 가사 기술을 가지고 게임을 시작합니다.
							<<default>>가사 기술에 대한 숙련도가 <span class="red">없는</span> 상태로 게임을 시작합니다.
						<</switch>>
							<<default>>
						<<print _name>> 기술에 대한 숙련도가 <span class="red">없는</span> 상태로 게임을 시작합니다.
				<</switch>>
				<<if _name is "randomClothing">>
					<br>
					<span class="gold bold">의류 종류: </span>
					<label><<print '<<radiobutton "$featsBoosts.clothingGender" "Either" ' + ($featsBoosts.clothingGender is "Either" ? "checked" : "") + '>>'>> 남녀 공용</label> |
					<label><<print '<<radiobutton "$featsBoosts.clothingGender" "Male" ' + ($featsBoosts.clothingGender is "Male" ? "checked" : "") + '>>'>> 남성용</label> |
					<label><<print '<<radiobutton "$featsBoosts.clothingGender" "Female" ' + ($featsBoosts.clothingGender is "Female" ? "checked" : "") + '>>'>> 여성용</label>
					<br>
					<span class="gold bold">커스텀 색상 활성화 (터무니없는 결과가 나올 수 있음): </span>
						<label><<print '<<radiobutton "$featsBoosts.clothingCustomColors" false ' + ($featsBoosts.clothingCustomColors is false ? "checked" : "") + '>>'>> 아니오</label> |
						<label><<print '<<radiobutton "$featsBoosts.clothingCustomColors" true ' + ($featsBoosts.clothingCustomColors is true ? "checked" : "") + '>>'>> 예</label>
				<</if>>
				<<if !_details.exclusive or $featsBoosts.upgrades[_details.exclusive] is 0>>
					<<featsPointsMenuButtons _name _details>>
				<<else>>
					<span class="red">이 업그레이드를 사용하려면 
						<<switch _details.exclusive>>
							<<case "purity">>순결도
							<<case "impurity">>불결함
							<<default>><<print _details.exclusive>>
						<</switch>> 업그레이드를 제거하세요.
					</span>
				<</if>>

				<<if _name is "tattoos">>
					<<set _totalTattoos to $featsBoosts.upgrades.tattoos / _details.cost>>
					<<if _tattooNumber is undefined or _tattooNumber gt _totalTattoos>>
						<<set _tattooNumber to Math.clamp(_totalTattoos, 1, $featsBoosts.upgradeDetails.tattoos.max)>>
					<</if>>

					<<if _totalTattoos gt 0>>
						<div class="settingsGrid" style="margin:10px 0px">
							<div class="settingsHeader">문신 <<print _tattooNumber>>
							<br>
								<<if _tattooNumber gte 1 and _totalTattoos gt 1>>
								<span style="font-size:80%;">
									<<link "이전 문신">>
										<<set _tattooNumber-->>
										<<if _tattooNumber lte 0>>
											<<set _tattooNumber to _totalTattoos>>
										<</if>>
										<<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>
									<</link>> |
									<<link "다음 문신">>
										<<set _tattooNumber++>>
										<<if _tattooNumber gt _totalTattoos>>
											<<set _tattooNumber to 1>>
										<</if>>
										<<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>
									<</link>>
								</span>
								<</if>>
							</div>
							<div class="settingsToggleItem">
								<span class="listMargin">
									<span class="gold">문신 종류:</span>
									<<set _penOptions to {"문신":"Tattoo", "낙인":"Brand"}>>
									<<listbox `"$featsBoosts.tattoos["+_tattooNumber+"].pen"` autoselect>>
										<<optionsfrom _penOptions>>
									<</listbox>>
								</span>
							</div>
							<div class="settingsToggleItem">
								<span class="gold">문신 부위:</span>
								<<set _bodyPartOptions to {"이마":"Forehead", "왼쪽 뺨":"Left cheek", "오른쪽 뺨":"Right cheek", "왼쪽 어깨":"Left shoulder", "오른쪽 어깨":"Right shoulder", "등":"Back", "가슴":"Breasts", "왼쪽 엉덩이":"Left bottom", "오른쪽 엉덩이":"Right bottom", "왼쪽 허벅지":"Left thigh", "오른쪽 허벅지":"Right thigh", "음부":"Pubic"}>>
								<<for _l to 1; _l lte _totalTattoos; _l++>>
									<<if _tattooNumber is _l>>
										<<continue>>
									<</if>>
									<<run Object.keys(_bodyPartOptions).forEach(k => { if(_bodyPartOptions[k] === $featsBoosts.tattoos[_l].bodypart) delete _bodyPartOptions[k]; })>>
								<</for>>
								<<listbox `"$featsBoosts.tattoos["+_tattooNumber+"].bodypart"` autoselect>>
									<<option "무작위" "Random">>
									<<optionsfrom _bodyPartOptions>>
								<</listbox>>
							</div>
							<div @id="_tattooNumber + 'tattooFilter'" class="settingsToggleItem">
								<<tattooFilter>>
							</div>
							<div @id="_tattooNumber + 'tattooList'" class="settingsToggleItem">
								<<tattooList>>
							</div>
						</div>
						<<run $(() => {
						const currentList = '#' + _tattooNumber + 'tattooList';
						const currentFilterId = '#' + _tattooNumber + 'tattooFilter';
							$(currentFilterId + ' select').on('input change', e => {
							new Wikifier(null, `<<print "${currentList}">> <<replace "${currentList}">><<tattooList>><</replace>>`);
							}).trigger('change');
						})>>
					<</if>>
				<</if>>
				<<if _name is "sexToys">>
					<div id="sexToys"><<sexToysFeatUI>></div>
				<</if>>
				<<if _name is "aNewBestFriend" and $featsBoosts.upgradeDetails.aNewBestFriend.purchased gte 2>>
					<div id="aNewBestFriend">
						<label>귀 슬라임 시작 유형:
							<<listbox "$featsBoosts.earSlimeType" autoselect>>
								<<option "미성숙하고 수동적" "immaturePassive">>
								<<option "미성숙하고 공격적" "immatureAggressive">>
								<<option "부분적으로 성장하고 공격적" "grownAggressive">>
							<</listbox>>
						</label>
					</div>
				<</if>>
				<<if _name is "specialClothing">>
					<div id="specialClothing"><<specialClothingFeatUI>></div>
				<</if>>
				<<if _name is "seeds">>
					<div id="seeds"><<seedsFeatUI>></div>
				<</if>>
			<</if>>
		<<else>>
			<span class="red"><<print $featsBoosts.missing[_name]>></span>
		<</if>>
	<</capture>>
<</widget>>

<<widget "tattooFilter">>
	<span class="gold">도안 필터:</span>
	<<set _tattooFilters = {
		"모두" : "all",
		"이미지" : "object",
		"텍스트" : "text",
		"남성적" : "m",
		"여성적" : "f",
		"수간" : "bestiality",
		"가축" : "cattle",
		"전투" : "combat",
		"범죄" : "criminal",
		"노출" : "exhibitionism",
		"매춘" : "prostitution",
		"강간" : "rape",
		"섹스" : "sex",
		"폭력" : "violence",
		"임신" : "pregnancy",
		"수정" : "impreg",
		}>>
	<<listbox `"$tattooFilter"+_tattooNumber` autoselect>>
		<<optionsfrom _tattooFilters>>
	<</listbox>>
<</widget>>

<<widget "tattooList">>
	<span class="gold">문신 도안:</span>
	<<featsTattooOptions>>
	<<listbox `"$featsBoosts.tattoos["+_tattooNumber+"].tattoo"` autoselect>>
		<<option "무작위" "Random">>
		<<optionsfrom _featsTattooOptions>>
	<</listbox>>
<</widget>>

<<widget "featsTattooOptions">>
	<<if _featsTattooAll is undefined>>
		<<set _featsTattooAll to []>>
		<<for _value range setup.bodywriting>>
			<<if _value.featSkip is true>>
				<<continue>>
			<</if>>
			<<run _featsTattooAll.push(_value.writingKr || _value.writing)>>
		<</for>>
	<</if>>
	<<set _featsTattooOptions to []>>
	<<switch _tattooNumber>>
		<<case 1>><<set _tattooFilter to $tattooFilter1>>
		<<case 2>><<set _tattooFilter to $tattooFilter2>>
		<<case 3>><<set _tattooFilter to $tattooFilter3>>
		<<case 4>><<set _tattooFilter to $tattooFilter4>>
		<<case 5>><<set _tattooFilter to $tattooFilter5>>
	<</switch>>
	<<for _value range setup.bodywriting>>
		<<if (_tattooFilter is "all" and _value.featSkip)
		or (_tattooFilter is "object" and (_value.featSkip or _value.type isnot _tattooFilter))
		or (_tattooFilter is "text" and (_value.featSkip or _value.type isnot _tattooFilter))
		or (_tattooFilter is "m" and (_value.featSkip or _value.gender isnot _tattooFilter))
		or (_tattooFilter is "f" and (_value.featSkip or _value.gender isnot _tattooFilter))
		or (_tattooFilter isnot "all" and _tattooFilter isnot "object" and _tattooFilter isnot "text" and _tattooFilter isnot "m" and _tattooFilter isnot "f" and (_value.featSkip or _value.special isnot _tattooFilter))>>
			<<continue>>
		<</if>>
		<<run _featsTattooOptions.push(_value.writingKr || _value.writing)>>
	<</for>>
<</widget>>

<<widget "featsPointsMenuButtons">>
	<<set _type to _args[0]>>
	<<set _details to _args[1]>>
	<<set _cost to _details.cost>>
	<<set _maxUpgrades to _details.max>>
	<<set _purchasedUpgrades to _details.purchased>>
	<<set _remainingUpgrades to _maxUpgrades - _purchasedUpgrades>>
	<<set _availableCoins to $feats.allSaves.points - $featsBoosts.pointsUsed>>
	<br><br>
	<span class="gold bold">업그레이드:</span>
	<br>
	<div style="margin-bottom:10px;">
	<<switch _type>>
		<<case "money">>
			각 업그레이드를 구매할 때마다 시작 자금에 <span class="green">£<<print _maxUpgrades * 25>></span>【이가】 추가됩니다.
		<<case "grades">>
			각 업그레이드를 구매할 때마다 시작 학점이 <span class="green">한 단계씩</span> 올라갑니다.
		<<case "purity">>
			각 업그레이드를 구매할 때마다 매일 획득하는 순결도가 레벨당 1점씩 증가합니다.
		<<case "impurity">>
			각 업그레이드를 구매할 때마다 매일 감소하는 순결도가 레벨당 1점씩 증가합니다.
		<<case "newLife">>
			<<if _maxUpgrades is 2>>
				첫 번째 업그레이드를 구매하면 자웅동체 촉수 기생충과 함께 게임을 시작합니다. 두 번째 업그레이드를 구매하면 완벽한 활동성을 부여합니다. 그렇지 않으면 활동성이 무작위로 결정됩니다.
			<<else>>
				첫 번째 업그레이드를 구매하면 무작위 활동성을 가진 자웅동체 촉수 기생충과 함께 게임을 시작합니다. 완벽한 활동성을 부여하려면 두 번째 무리어미 위업을 달성하십시오.
			<</if>>
		<<case "aNewBestFriend">>
			이 업그레이드를 구매하면 귀 슬라임 기생충과 함께 게임을 시작합니다.
		<<case "randomClothing">>
			각 업그레이드를 구매할 때마다 지정한 성별의 무작위 의류 아이템 3개를 받습니다.
		<<case "tattoos">>
			각 업그레이드를 구매할 때마다 원하는 시작 문신이나 낙인을 하나 얻을 수 있습니다.
		<<case "specialClothing">>
			<<if _maxUpgrades is 2>>
				첫 번째 업그레이드를 선택하면 이전에 해금한 특수 의류를 최대 절반까지 구매할 수 있습니다. 두 번째 랭크를 구매하면 이전에 해금한 특수 의류를 수량 제한 없이 구매할 수 있습니다.
			<<else>>
				첫 번째 업그레이드를 선택하면 이전에 해금한 특수 의류를 최대 절반까지 구매할 수 있습니다. 수량 제한 없이 구매하려면 비밀 위업을 달성하십시오.
			<</if>>
		<<case "seeds">>
			<<if _maxUpgrades is 2>>
				첫 번째 업그레이드를 선택하면 이전에 해금한 씨앗을 최대 절반까지 구매할 수 있습니다. 두 번째 랭크를 구매하면 씨앗을 더 많이 구매할 수 있습니다.
			<<else>>
				첫 번째 업그레이드를 선택하면 이전에 해금한 씨앗을 최대 절반까지 구매할 수 있습니다. '품종 개량가' 위업을 달성하면 씨앗을 더 많이 구매할 수 있습니다.
			<</if>>
		<<case "sexToys">>
			각 업그레이드를 구매할 때마다 원하는 시작 섹스 토이 3개를 받습니다.
		<<case "skulduggery">>각 업그레이드를 구매할 때마다 속임수 레벨이 한 등급씩 상승합니다.
		<<case "dancing">>각 업그레이드를 구매할 때마다 춤 레벨이 한 등급씩 상승합니다.
		<<case "tending">>각 업그레이드를 구매할 때마다 관리 레벨이 한 등급씩 상승합니다.
		<<case "swimming">>각 업그레이드를 구매할 때마다 수영 레벨이 한 등급씩 상승합니다.
		<<case "athletics">>각 업그레이드를 구매할 때마다 운동 레벨이 한 등급씩 상승합니다.
		<<case "seduction">>각 업그레이드를 구매할 때마다 유혹 레벨이 한 등급씩 상승합니다.
		<<case "housekeeping">>각 업그레이드를 구매할 때마다 가사 레벨이 한 등급씩 상승합니다.
		<<default>>
			각 업그레이드를 구매할 때마다 _type 레벨이 <span class="green">한 등급씩</span> 상승합니다.
	<</switch>>
	</div>
	<<capture _type _cost>>
		<div class="featButtonContainer">
			<<if _purchasedUpgrades gte 1>>
				<div class="featButton roundl">
					<<button "<span class='fa-icon fa-left'></span><span class='fa-icon fa-left'></span>">>
						<<set $featsBoosts.upgradeDetails[_type].purchased to 0>>
						<<set _cost to (-1 * _purchasedUpgrades * _cost)>>
						<<updateFeatsPointsMenu _type _cost>>
					<</button>>
				</div>
				<div class="featButton">
					<<button "<span class='fa-icon fa-left'></span>">>
						<<set $featsBoosts.upgradeDetails[_type].purchased-->>
						<<set _cost to (-1 * _cost)>>
						<<updateFeatsPointsMenu _type _cost>>
					<</button>>
				</div>
			<<else>>
				<div class="featButtonGrey roundl">
					<<button "<span class='fa-icon fa-left'></span><span class='fa-icon fa-left'></span>">>
					<</button>>
				</div>
				<div class="featButtonGrey">
					<<button "<span class='fa-icon fa-left'></span>">>
					<</button>>
				</div>
			<</if>>
			<div class="gold featButton buttonDisable">
				<<button "_purchasedUpgrades / _maxUpgrades">>
				<</button>>
			</div>
			<<if _purchasedUpgrades lt _maxUpgrades and (_availableCoins gte _cost)>>
				<div class="featButton">
				<<button "<span class='fa-icon fa-right'></span>">>
					<<set $featsBoosts.upgradeDetails[_type].purchased++>>
					<<updateFeatsPointsMenu _type _cost>>
				<</button>>
				</div>
			<<else>>
				<div class="featButtonGrey">
					<<button "<span class='fa-icon fa-right'></span>">>
					<</button>>
				</div>
			<</if>>
			<<if _purchasedUpgrades lt _maxUpgrades and (_availableCoins gte (_remainingUpgrades * _cost))>>
				<div class="featButton roundr">
				<<button "<span class='fa-icon fa-right'></span><span class='fa-icon fa-right'></span>">>
					<<set $featsBoosts.upgradeDetails[_type].purchased to _maxUpgrades>>
					<<set _cost to (_remainingUpgrades * _cost)>>
					<<updateFeatsPointsMenu _type _cost>>
				<</button>>
				</div>
			<<else>>
				<div class="featButtonGrey roundr">
					<<button "<span class='fa-icon fa-right'></span><span class='fa-icon fa-right'></span>">>
					<</button>>
				</div>
			<</if>>
		</div>
		<<if _type isnot "specialClothing">>
			<div class=" black small-description" style="margin-top:10px;">
				(업그레이드당 <span class="gold">_details.cost <<pluralise _details.cost "브렐 코인" "브렐 코인">></span>)
			</div>
		<</if>>

		<<if _type is "tending">>
			<div style="margin-top:10px;">
				<span class="green">원예가</span> - 비료를 사용할 때 작물이 더 풍성해지고 썩지 않습니다. 비료 1개를 가지고 시작합니다.
				<div class="featButton roundl roundr" style="margin-top:5px;">
					<<if $feats.allSaves.points - $featsBoosts.pointsUsed gte $featsBoosts.upgradeDetails.greenThumb.cost and !$featsBoosts.upgrades.greenThumb>>
						<<button "이 특성으로 시작">>
							<<updateFeatsPointsMenu "greenThumb" $featsBoosts.upgradeDetails.greenThumb.cost>>
						<</button>>
					<<elseif $featsBoosts.upgrades.greenThumb>>
						<<button "이 특성 제거">>
							<<updateFeatsPointsMenu "greenThumb" $featsBoosts.upgradeDetails.greenThumb.cost "subtract">>
						<</button>>
					<</if>>
				</div>
			</div>
			<div class=" black small-description" style="margin-top:10px;">(<span class="gold"><<print "$featsBoosts.upgradeDetails.greenThumb.cost">> <<pluralise $featsBoosts.upgradeDetails.greenThumb.cost "브렐 코인" "브렐 코인">></span> 필요)</div>
		<</if>>
	<</capture>>
<</widget>>

<<widget "sexToysFeatUI">>
	<<set _totalToys to $featsBoosts.upgrades.sexToys / 10>>
	<<if _toyNumber is undefined or _toyNumber gt _totalToys>>
		<<set _toyNumber to 0>>
	<</if>>
	<<if _toys is undefined>>
		<<set _toys to {}>>
		<<run Object.values(setup.sextoys.filter(item => !item.shop.includes("forest"))).forEach(toy => T.toys[toy.namecap] = toy.index)>>
	<</if>>
	<<if _totalToys gt 1>>
		<div class="settingsGrid" style="margin:10px 0px">
			<div class="settingsHeader">장난감 <<print _toyNumber+1>>
			<br>
				<<if _toyNumber gte 0 and _totalToys gt 1>>
				<span style="font-size:80%;">
					<<link "이전 장난감">>
						<<set _toyNumber-->>
						<<if _toyNumber lt 0>>
							<<set _toyNumber to _totalToys-1>>
						<</if>>
						<<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>
					<</link>> |
					<<link "다음 장난감">>
						<<set _toyNumber++>>
						<<if _toyNumber+1 gt _totalToys>>
							<<set _toyNumber to 0>>
						<</if>>
						<<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>
					<</link>>
				</span>
				<</if>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">섹스 토이:</span>
				<div id="sexToysFeatUIIndex">
					<<listbox "$featsBoosts.sexToys[_toyNumber].index" autoselect>>
						<<option "무작위" -1>>
						<<optionsfrom _toys>>
					<</listbox>>
				</div>
			</div>
			<div id="sexToysFeatUIColour">
				<<sexToysFeatUIColour>>
			</div>
		</div>
		<<run $(() => { $('#sexToysFeatUIIndex select').on('input change', e => {
			new Wikifier(null, "<<replace '#sexToysFeatUIColour'>><<sexToysFeatUIColour>><</replace>>");
		}).trigger('change') })>>
	<</if>>
<</widget>>

<<widget "sexToysFeatUIColour">>
	<<if $featsBoosts.sexToys[_toyNumber].index isnot undefined and $featsBoosts.sexToys[_toyNumber].index isnot -1>>
		<<set _toyColours to {}>>
		<<set _selectedToy to Object.values(setup.sextoys).find(toy => toy.index === V.featsBoosts.sexToys[T.toyNumber].index)>>
		<<if _selectedToy and _selectedToy.colour_options and _selectedToy.colour_options.length>>
			<<run _selectedToy.colour_options.forEach(colour => _toyColours[setup.colourName(colour)] = colour)>>
		<</if>>
	<<else>>
		<<set _toyColours to {}>>
	<</if>>
	<<if Object.values(_toyColours).length gt 1>>
		<div class="settingsToggleItem">
			<span class="gold">색상:</span><br>
			<<listbox "$featsBoosts.sexToys[_toyNumber].colour" autoselect>>
				<<option "무작위" -1>>
				<<optionsfrom _toyColours>>
			<</listbox>>
		</div>
	<</if>>
<</widget>>

<<widget "specialClothingFeatUI">>
	<<if $featsBoosts.upgradeDetails.specialClothing.purchased>>
		<<set _totalSpecialClothesSets to getSpecialSets(set => set.feat)>>
		<<set _totalUnlockedSets to $feats.allSaves.specialClothes>>
		<<set _totalUnlockedSetsLimit to $featsBoosts.upgradeDetails.specialClothing.purchased gte 2 ? _totalUnlockedSets.length : Math.ceil(_totalUnlockedSets.length / 2)>>
		<<if !Object.values($featsBoosts.specialClothesSets).length>>
			<!-- Populate object -->
			<<for $_labelPop, $_valuePop range _totalSpecialClothesSets>>
				<<set $featsBoosts.specialClothesSets[$_valuePop] to false>>
			<</for>>
		<</if>>
		<<run $(() => { $('[data-limit-group]').first().trigger('change.macros') })>>
		<br>
		<div class="settingsHeader" style="margin-bottom: 0.5em">해금할 세트</div>
		<form>
			<fieldset>
				<legend>최대 _totalUnlockedSetsLimit개의 세트 선택</legend>
					<div class="red" style="padding-left: 10px">해금되어야 할 특정 세트가 해금되지 않는다면, 세트가 해금된 세이브 파일을 로드하여 다른 장소로 이동한 후 저장해 보십시오.</div>
					<div class="settingsGridSmall">
						<<for $_labelC, $_valueC range $featsBoosts.specialClothesSets>>
							<label>
								<div class="settingsToggleItem" id="specialClothesFeatBooster">
									<<capture $_labelC>>
										<<set $_clothingObject to clone(setup.specialClothesSets[$_labelC])>>
										<<set $_listFromSets to []>><<set $_hints to []>>
										<<set $_clothesToPush to setup.specialClothes.filter(fromSets => fromSets.sets.includes($_labelC))>>
										<<run $_clothesToPush.forEach(clothing => $_listFromSets.push(clothing.name.toUpperFirst()))>>
										<<set $_canAfford to ($feats.allSaves.points - $featsBoosts.pointsUsed) - $_clothingObject.featCost gte 0>>
										<<set $_costDisplay to "<<print setup.specialClothesSets[$_labelC].featCost>>"+ ($options.images is 1 ? " <img class='imgButton' src='img/ui/coin-gold.gif'/>" : " 브렐 코인")>>

										<<if _totalUnlockedSets.includes($_labelC)>>
											<<if $_canAfford or $featsBoosts.specialClothesSets[$_labelC]>>
												<<set $_listText to "포함: <span class='green'>" + formatList($_listFromSets, '그리고', true) + "</span>">>
												<<checkbox "$featsBoosts.specialClothesSets[$_labelC]" false true autocheck "specialClothingFeatSets" _totalUnlockedSetsLimit "<span class='red'>선택 한도에 도달했습니다!</span>">>
											<<else>>
												<<set $_listText to "<span class='red'>브렐 코인이 부족합니다!</span><br> 포함: <span class='green'>" + formatList($_listFromSets, '그리고', true) + "</span>">>
												<input type="checkbox" class="black tooltip-anchor" @tooltip="포함: $_listText" disabled>
											<</if>>
												<<if $_clothingObject.icon is "clothes">>
													<<set $_cIcon to clone(setup.clothes[$_clothingObject.iconSlot][$_clothingObject.iconIndex])>>
													<<set $_cIcon.colour to $_clothingObject.iconColor>><<set $_cIcon.accessory_colour to $_clothingObject.iconAccColor>>
													<<clothingicon $_cIcon $_clothingObject.iconSlot>>
												<<else>>
													<<set $_cIcon to $_clothingObject.icon>>
													<<icon $_cIcon>>
												<</if>>
												<span class="gold tooltip-anchor" @tooltip="$_listText"><<print setup.specialClothesSets[$_labelC].text>></span>
												<div class="gold" style="display:inline-block">($_costDisplay)</div>
										<<else>>
												<<if setup.specialClothesSets[$_labelC].subsetOf>>
													<<run setup.specialClothesSets[$_labelC].subsetOf.forEach(subset => {
														if (setup.specialClothesSets[subset].hint) $_hints.pushUnique(setup.specialClothesSets[subset].hint);
													})>>
												<</if>>
												<<if setup.specialClothesSets[$_labelC].hint>>
													<<set $_hints.pushUnique(setup.specialClothesSets[$_labelC].hint)>>
												<</if>>
												<<set $_hintText to $_hints.length ? "<br><span class='black'>힌트: " + formatList($_hints, '또는', true).toUpperFirst() + "</span>" : "">>
												<<set $_listText to "<span class='red'>아직 획득하지 못했습니다!</span><br> 포함: <span class='black'>" + formatList($_listFromSets, '그리고', true) + "</span>" + $_hintText>>
												<input type="checkbox" class="black tooltip-anchor" @tooltip="포함: $_listText" disabled>
												<<lockicon>>
												<span class="gold tooltip-anchor" @tooltip="$_listText"><<print setup.specialClothesSets[$_labelC].text>></span>
												<div class="black" style="display:inline-block">($_costDisplay)</div>
										<</if>>
									<</capture>>
								</div>
							</label>
						<</for>>
					</div>
			</fieldset>
		</form>
			<<run $(document).off("change.specialClothesFeat").on("change.specialClothesFeat",
				'input[type="checkbox"][data-limit-group="specialClothingFeatSets"]',
				function () {
					const id = $(this).attr("id").replace(/^checkbox-featsboostsspecialclothessets-/, "").replace(/-/g, "_");
					if ($(this).prop("checked")) {
						new Wikifier(null, `<<updateFeatsPointsMenu "specialClothing" setup.specialClothesSets["${id}"].featCost>>`);
					} else {
						new Wikifier(null, `<<updateFeatsPointsMenu "specialClothing" setup.specialClothesSets["${id}"].featCost "subtract">>`);
					}
				}
			);
		>>
	<</if>>
<</widget>>

<<widget "seedsFeatUI">>
	<<if $featsBoosts.upgradeDetails.seeds.purchased>>
		<<set _totalSeeds to Object.keys(setup.foodstuff).filter(food => setup.foodstuff[food].tending?.featCost)>>
		<<set _totalUnlockedSeeds to $feats.allSaves.seeds>>
		<<set _totalUnlockedSeedsLimit to $featsBoosts.upgradeDetails.seeds.purchased gte 2 ? Math.ceil(_totalUnlockedSeeds.length / 1) : Math.ceil(_totalUnlockedSeeds.length / 2)>>
		<<if !Object.values($featsBoosts.seeds).length>>
			<<for $_labelPop, $_valuePop range _totalSeeds>>
				<<set $featsBoosts.seeds[$_valuePop] to false>>
			<</for>>
		<</if>>
		<<run $(() => { $('[data-limit-group]').first().trigger('change.macros') })>>
		<br>
		<div class="settingsHeader" style="margin-bottom: 0.5em">해금할 씨앗</div>
		<form>
			<fieldset>
				<legend>최대 _totalUnlockedSeedsLimit개 선택</legend>
					<div class="red" style="padding-left: 10px">해금되어 있어야 할 특정 씨앗이 해금되지 않은 경우, 해당 씨앗이 해금된 세이브를 불러온 후 패시지를 한 번 이동하고 다시 저장해 보세요.</div>
					<div class="settingsGridSmall">
						<<for $_labelC, $_valueC range $featsBoosts.seeds>>
							<label>
								<div class="settingsToggleItem" id="specialClothesFeatBooster">
									<<capture $_labelC>>
										<<set $_seed to clone(setup.foodstuff[$_labelC])>>
										<<set $_canAfford to ($feats.allSaves.points - $featsBoosts.pointsUsed) - $_seed.tending.featCost gte 0>>
										<<set $_costDisplay to "<<print $_seed.tending.featCost>>"+ ($options.images is 1 ? " <img class='imgButton' src='img/ui/coin-gold.gif'/>" : " 브렐코인")>>

										<<if _totalUnlockedSeeds.includes($_labelC)>>
											<<if $_canAfford or $featsBoosts.seeds[$_labelC]>>
												<<checkbox "$featsBoosts.seeds[$_labelC]" false true autocheck "seedsFeatSelect" _totalUnlockedSeedsLimit "<span class='red'>선택 한도에 도달했습니다!</span>">>
												<<icon `"tending/" + $_seed.icon`>>
												<span class="gold"><<print $_seed.name.toUpperFirst()>></span>
											<<else>>
												<<set $_listText to "<span class='red'>브렐코인이 부족합니다!</span>">>
												<input type="checkbox" class="black tooltip-anchor" @tooltip="$_listText" disabled>
												<<icon `"tending/" + $_seed.icon`>>
												<span class="gold tooltip-anchor" @tooltip="$_listText"><<print $_seed.name.toUpperFirst()>></span>
											<</if>>
											<div class="gold" style="display:inline-block">($_costDisplay)</div>
										<<else>>
											<<set $_hints to []>>
											<<set $_hintText to $_hints.length ? "<br><span class='black'>힌트: " + formatList($_hints, '또는', true).toUpperFirst() + "</span>" : "">>
											<<set $_listText to "<span class='red'>획득하지 못함</span>" + $_hintText>>
											<input type="checkbox" class="black tooltip-anchor" @tooltip="$_listText" disabled>
											<<lockicon>>
											<span class="black tooltip-anchor" @tooltip="$_listText"><<print $_seed.name.toUpperFirst()>></span>
											<div class="black" style="display:inline-block">($_costDisplay)</div>
										<</if>>
									<</capture>>
								</div>
							</label>
						<</for>>
					</div>
			</fieldset>
		</form>
			<<run $(document).off("change.specialClothesFeat").on("change.specialClothesFeat", /* ???? */
				'input[type="checkbox"][data-limit-group="seedsFeatSelect"]',
				function () {
					const id = $(this).attr("id").replace(/^checkbox-featsboostsseeds-/, "").replace(/-/g, "_"); /* featsboostsseeds is $featsBoosts.seeds[$_labelC] */
					if ($(this).prop("checked")) {
						new Wikifier(null, `<<updateFeatsPointsMenu "seeds" setup.foodstuff["${id}"].tending.featCost>>`);
					} else {
						new Wikifier(null, `<<updateFeatsPointsMenu "seeds" setup.foodstuff["${id}"].tending.featCost "subtract">>`);
					}
				}
			);
		>>
	<</if>>
<</widget>>

<<widget "updateFeatsPointsMenu">>
	<<set _cost to _args[2] is "subtract" ? _args[1] * -1 : _args[1]>>
	<<if $feats.allSaves.points - $featsBoosts.pointsUsed gte _cost or _cost lt 0>>
		<<set $featsBoosts.upgrades[_args[0]] += _cost>>
		<<set $featsBoosts.pointsUsed += _cost>>
		<<set $featsBoosts.pointsUsed = Math.max(0, $featsBoosts.pointsUsed)>>
	<</if>>
	<<replace #featsPointsMenu>>
		<<featsPointsMenu>>
	<</replace>>
<</widget>>

/* Fake feats, for when you want to gaslight the player. Used for the Wraith, primarily */
<<widget "displayFeatFake">>
	<<if _args[0] and $feats.locked is false and $cheatsEnabled is false and $debug is 0 and $gamemode isnot "soft" and $settings.allureModifier gte 1>>
		<<silently>>
			<<if _featsCount is undefined>>
				<<set _featsCount to 0>>
			<<else>>
				<<set _featsCount++>>
			<</if>>
		<</silently>>
		<div @id="'feat-' + _featsCount" class="feat feat-overlay">
			<div class="featImage">
				<<switch setup.feats[_args[0]].difficulty>>
					<<case 1>><img src="img/ui/coin-copper-fake.gif" class="featCoin">
					<<case 2>><img src="img/ui/coin-silver-fake.gif" class="featCoin">
					<<case 3>><img src="img/ui/coin-gold-fake.gif" class="featCoin">
					<<case 3>><img src="img/ui/coin-platinum-fake.gif" class="featCoin">
					<<case 3>><img src="img/ui/coin-jeweled-fake.gif" class="featCoin">
				<</switch>>
			</div>
			<div class="featText">
				<<switch _args[0]>>
					<<case "It Belongs in a Museum">>
						<span class="title">박물관으로 가야 해?</span>
					<<default>>
						<<if setup.feats[_args[0]].title.endsWith("?")>>
							<span class="title"><<print setup.feats[_args[0]].title>></span>
						<<else>>
							<span class="title"><<print setup.feats[_args[0]].title>>?</span>
						<</if>>
				<</switch>>
				<br>
				<<switch _args[0]>>
					<<case "No More Control">>
						<span class="text">여기서 더 음란해질 수는 없겠지... 안 그래?</span>
					<<case "Teachers Nightmare">>
						<span class="text">너는 골칫거리잖아... 안 그래?</span>
					<<case "Anti-Social Moth">>
						<span class="text">친구 따위 누가 필요하겠어... 안 그래?</span>
					<<default>>
						<<if setup.feats[_args[0]].desc.endsWith(".")>>
							<span class="text"><<print setup.feats[_args[0]].desc>>... 안 그래?</span>
						<<else>>
							<span class="text"><<print setup.feats[_args[0]].desc>>... 안 그래?</span>
						<</if>>
				<</switch>>
			</div>
			<div @id="'closeFeat-' + _featsCount" class="closeFeat" @onclick="'closeFeats('+ _featsCount +')'"></div>
		</div>
	<</if>>
<</widget>>
