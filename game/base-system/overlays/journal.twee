:: Widgets Journal [widget]
<<widget "journal">>
	<br>
	<<print getFormattedDate(Time.date) + "입니다.">>
	<ul class="journal">
	<<if Time.days lt 0>>
		<<if Time.days lt -365>>
			<<set _yearsBefore = Math.floor(Time.startDate.year - Time.year)>>
			<li>게임이 시작되기 전, 대략 <span class="gold"><<print _yearsBefore>></span>년 전입니다.</li>
		<<else>>
			<<set _daysBefore = Time.days * -1>>
			<li>게임이 시작되기 전, <span class="gold"><<print _daysBefore>></span>일 전입니다.</li>
		<</if>>
	<<else>>
		<li>게임이 시작된 지 <span class="gold"><<print Time.days>></span>일이 지났습니다.</li>
		<<if $hardmodedays isnot undefined>>
			<li>하드 모드에서 <span class="gold">$hardmodedays</span>일을 생존했습니다.</li>
			<br>
		<</if>>
		<li>게임은 <<print window.KR.getSeasonKr(Time.getSeason(new DateTime($startDate)))>>에 시작되었습니다.</li>
		<li>지금은 <<print window.KR.getSeasonKr(Time.season)>>입니다.</li>
		<li><<schoolterm>></li>
	<</if>>
	</ul>

	<<if $options.images is 1>>
		<div class="map">
			<<if Weather.isSnow>>
				<img id="world_map" src="img/misc/world-map-winter.png">
			<<else>>
				<img id="world_map" src="img/misc/world-map.png">
			<</if>>
		</div>
	<</if>>

	<<if $hc>>
		<hr>
		<h1 class="header gold bold">절망의 굴레</h1>
		<<if $tags.includes("ending")>>
			모든 이야기에는 끝이 있어야 합니다.
		<<elseif Time.isBloodMoon()>>
			붉은 달이 떠오릅니다. 바로 지금입니다.
		<<else>>
			<<set $_daysUntilBloodMoon to Time.lastDayOfMonth - Time.monthDay>>
			<<if $_daysUntilBloodMoon is 0>>
				붉은 달의 밤입니다.
			<<elseif $_daysUntilBloodMoon is 1>>
				붉은 달까지 하루 남았습니다.
			<<else>>
				붉은 달까지 <<Number $_daysUntilBloodMoon>>일 남았습니다.
			<</if>>
			<br>
			<<if $prisonerEvents.includes("health")>>
				<ul class="journal">
					<<if $hc.nightBreakIn is "heard">>
						<li>누군가가 밤늦게 <<= window.KR.gatPersonNameDictKR($prisoner.name)>>의 독방에 몰래 들어갈 계획입니다.</li>
					<</if>>
					<<if $prisonerEvents.includes("raped") and !$prisonerEvents.includes("rapedReported")>>
						<li>기도실에서 <<= window.KR.gatPersonNameDictKR($prisoner.name)>>【이가】 더럽혀진 사실을 핸드에게 알릴 수 있습니다.</li>
					<</if>>
					<<if $prisonerEvents.includes("brand")>>
						<li><<= window.KR.gatPersonNameDictKR($prisoner.name).toUpperFirst()>>의 화상은 정원의 허브와 <i>깨끗한</i> 물로 치료할 수 있습니다.</li>
					<</if>>
					<<if $hc.dogs>>
						<li>정원에 로밀리 가문의 개들이 있습니다.</li>
					<</if>>
					<<if $hc.wellTainted>>
						<li>우물물은 썩었습니다. 대신 숲의 호수에서 물을 얻을 수 있습니다.</li>
					<</if>>
				</ul>
			<</if>>
			<<if Object.values($hcChallenge).count(true)>>
				<<if $hcChallengeRandom.blind>>
					<<if $hcChallengeRandom.min is $hcChallengeRandom.max>>
						<<number Object.values($hcChallenge).count(true)>>개의 <span class="blue">알 수 없는</span> 챌린지를 선택했습니다.
					<<else>>
						<<number $hcChallengeRandom.min>>개에서 <<number $hcChallengeRandom.max>>개 사이의 <span class="blue">알 수 없는</span> 챌린지를 선택했습니다.
					<</if>>
				<<else>>
					<<hcChallengeSummary "journal">>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if $statFreeze>>
		<<exit>>
	<</if>>

	<<if $rentday isnot undefined || $rentmoney isnot undefined>>
		<hr>
		<h1 class="header gold bold">중요 알림</h1>
		<ul class="journal">
			<<if $avery_mansion>>/* Is Avery paying for the PC? */
				<<if $avery_mansion.rage.assess gte 9 or C.npc.Avery.state is "dismissed">>
					<<set _avery_pay to false>>
				<<else>>
					<<set _avery_pay to true>>
				<</if>>
			<<else>>
				<<set _avery_pay to false>>
			<</if>>
			<<if !_avery_pay>>
				<<if $rentday isnot undefined>>
					<<if $renttime lte 0>>
						<li>베일리가 당신을 찾고 있습니다. 당장 <<printmoney $rentmoney>><<babyRentDisplay " (고아원 아이 돌봄 명목 " " 포함)" "gold">>【을를】 내놓으라고 요구합니다.</li>
					<<else>>
						<li>베일리는 <<rentday>>까지 <<printmoney $rentmoney>><<babyRentDisplay " (고아원 아이 돌봄 명목 " " 포함)" "gold">>【을를】 상납하라고 요구하고 있습니다.</li>
					<</if>>
				<<elseif $rentmoney isnot undefined>>
					<li>베일리가 요구하는 금액은 <<printmoney $rentmoney>><<babyRentDisplay " (고아원 아이 돌봄 명목 " " 포함)" "gold">>입니다.</li>
				<</if>>
			<</if>>

			<<if $bailey_confiscation and $bailey_confiscation.items and $bailey_confiscation.items.length gt 0>> /* Bailey Confiscation System */
				<<set _rentDueDate to getFormattedDate(new DateTime(Time.date).addDays(($bailey_confiscation.day + 7) - Time.days), true)>>
				<<set _discardDate to getFormattedDate(new DateTime(Time.date).addDays(($bailey_confiscation.day + 8) - Time.days), true)>>
				<li>베일리가 당신의 <<baileyConfiscationListFull>>【을를】 압수했습니다. <span class="gold"><<print _rentDueDate>></span>까지 집세를 내거나 <span class="gold"><<print _discardDate>></span> 전에 물건을 되사지 않으면, <<nnpc_he "Bailey">>【은는】 그것들을 전당포에 넘길 것입니다.</li>
			<</if>>

			<<if $syndromeeden is 1 and $edenfreedom gte 1 and $location isnot "cabin">>/* Another parameter is planned, something like $edenpunishment. It is meant to only trigger the journal note after the player has been given a reason to be wary of breaking Eden's rules. */
				<<if edenFreedomStatus() is 0>>
					<li>당신은 에덴의 오두막으로
					<<if $edenfreedom is 1>>
						<<if $edendays is 2>>
							<span class="pink">오늘 밤 자정 전까지</span>
						<<else>> /* $edendays is 1 */
							늦어도 <span class="gold">내일 밤까지는</span>
						<</if>>
					<<else>> /* $edenfreedom is 2 or more */
						<<if $edendays is 7>>
							<span class="pink">오늘 밤 자정 전까지</span>
						<<elseif $edendays is 6>>
							늦어도 <span class="gold">내일 밤까지는</span>
						<<else>> /* $edendays is between 1 and 5 */
							늦어도 <span class="gold"><<print ["7", "6", "5", "4", "3", "2"][$edendays]>></span>일 안에는
						<</if>>
					<</if>>
					돌아가야 합니다.</li>
				<<elseif edenFreedomStatus() is 1 and (($edenfreedom is 1 and $edendays lt 4) or ($edenfreedom is 2 and $edendays lt 10))>> /* Warning lasts for one day on freedom 1 and two days on freedom 2 */
					<li>당신은 에덴에게 <span class="red">돌아가지 않았습니다</span>. <<nnpc_He "Eden">>【이가】 알아차렸을 것입니다.</li>
				<</if>>
			<</if>>

			<<if $avery_mansion?.schedule isnot "away" and $averydate is 1 and Time.hour lte 21 and $averydatedone isnot 1>>
				<li><span class="pink"><<this_saturday>></span><<if Time.weekDay isnot 6>>에<</if>> 에이버리와의 데이트가 예정되어 있습니다. <<nnpc_He "Avery">>【은는】 <span class="gold"><<ampm 20 00>></span>에서 <span class="gold"><<ampm 21 00>></span> 사이에 <<= $avery_mansion ? "차고에서" : "도무스 가에서">> 당신을 기다릴 것입니다.</li>
			<</if>>

			<<if $avery_valentines?.invite and !$avery_valentines?.done and !$avery_valentines?.missed_approach and !$avery_valentines_missed>>
				<<if $avery_mansion>>
					<li>에이버리가 당신을 <span class="pink">발렌타인 데이(<<= getFormattedDate(new DateTime(Time.year, 2, 14))>>)에 데이트에 초대했습니다.</span> <<nnpc_He "Avery">>【은는】 <span class="gold"><<ampm 21 00>></span>부터 저택 차고에서 당신을 기다릴 것입니다.</li>
				<<else>>
					<li>에이버리가 당신을 <span class="pink">발렌타인 데이(<<= getFormattedDate(new DateTime(Time.year, 2, 14))>>)에 데이트에 초대했습니다.</span> <<nnpc_He "Avery">>【은는】 <span class="gold"><<ampm 20 00>></span>부터 도무스 가에서 당신을 기다릴 것입니다.</li>
				<</if>>
			<</if>>

			<<if $harper_appointments.enabled or $schoolPsych is 1>>
				<li>당신은
				<<if Time.weekDay is 6>>
					<<if $daily.harperVisit is 1>>
						다음 주 <span class="gold">금요일</span>에
					<<else>>
						<span class="gold">오늘</span>
					<</if>>
				<<else>>
					<span class="gold">금요일</span>에
				<</if>>
				하퍼 의사와의 상담 예약이 <<if $harper_appointments.enabled>>있습니다<<else>>있을 수도 있습니다<</if>>.</li>
			<</if>>

			<<if $brothelshowdata.type isnot "none" and $brothelshowdata.intro>>
				<li>당신은
				<<if Time.weekDay is 6>>
					<<if $brothelshowdata.done>>
						다음 주 <span class="gold">금요일</span>에
					<<else>>
						<span class="gold">오늘</span>
					<</if>>
				<<else>>
					<span class="gold">금요일</span>에
				<</if>>
				창관에서 <<print ({flirt:"유혹 연극",gangbang:"윤간 연극",pig:"돼지",swarm:"생물 테라리움",machine:"섹스 머신",tentacles:"섹스 머신, 촉수 모드",horse:"말",bukkake:"붓카케 게임",virginity:"처녀 판매"})[$brothelshowdata.type] || $brothelshowdata.type>> 쇼 공연을 하기로 되어 있습니다.</li>
			<</if>>

			<<if $brothel_escortjob isnot undefined>>
				<<if ($brothel_escortjob.done is undefined or $brothel_escortjob.escape is undefined) and $brothel_escortjob.accept is true and $brothel_escortjob.missed isnot true>>
					<<set _date to new DateTime($brothel_escortjob.date)>>
					<li>에스코트 일정이 잡혀 있습니다. 당신은
					<<if Time.monthDay is _date.day>>
						<span class="pink">오늘</span>
					<<elseif Time.date.dayDifference(_date) is 1>>
						<span class="gold">내일</span>
					<<elseif Time.date.dayDifference(_date) gte 7>>
						다음 주 <span class="gold">_date.weekDayName요일</span>
					<<else>>
						<span class="gold">_date.weekDayName요일</span>
					<</if>>
					<span class="gold"><<ampm _date.hour>></span>에 창관 앞에 도착해야 합니다.</li>
				<</if>>
			<</if>>

			<<if $community_service gte 1>>
				<<if $community_service_done is 1>>
					<li><span class="lblue">오늘 사회 봉사를 마쳤습니다.</span></li>
				<<elseif ["asylum","prison"].includes($location)>>
					<li>당신의 사회 봉사 명령은 <<if $location is "prison">>수감 중이라<<else>>치료 중이라<</if>> 보류되었습니다.</li>
				<<elseif Time.hour gte 21>>
					<li>사회 봉사를 하기엔 너무 늦었습니다.</li>
				<<elseif Time.hour lt 6>>
					<li>경찰서는 나중에 당신이 일일 사회 봉사를 하러 오기를 기다리고 있습니다.</li>
				<<else>>
					<li>경찰서는 당신이 일일 사회 봉사를 하러 오기를 기다리고 있습니다.</li>
				<</if>>
				<<if $community_service is 1>>
					<li>사회 봉사 기간이 <span class="purple">하루</span> 남았습니다.</li>
				<<else>>
					<li>사회 봉사 기간이 <span class="pink">$community_service</span>일 남았습니다.</li>
				<</if>>
			<</if>>

			<<if $wrenHeist is true and Time.hour lte 20 and $wrenHeistDance.attended isnot true>>
				<li><span class="pink">오늘 밤</span> <span class="gold"><<ampm 19 00>></span>에서 <span class="gold"><<ampm 21 00>></span> 사이에 렌과 만나기로 되어 있습니다. <<nnpc_He "Wren">>【은는】 당신에게 다뉴브 가의 저택으로 가는 길을 알려주었습니다.</li>
			<</if>>

			<<if $smuggler_known is 1 and $smuggler_timer gte 0>>
				<li>
					<<if $smuggler_timer is 0>>
						<span class="pink">오늘 밤</span> 자정 전,
					<<elseif $smuggler_timer is 1>>
						<span class="gold">내일</span> 자정 전,
					<<else>>
						<<nDays $smuggler_timer>> 자정 전,
					<</if>>
					밀수업자들이 값진 물건을
					<<if $smuggler_location is "forest">>
						숲을 통해 시내로 들여올 예정입니다.
					<<elseif $smuggler_location is "sewer">>
						옛 하수도를 통해 시내로 들여올 예정입니다.
					<<elseif $smuggler_location is "beach">>
						해변 근처의 바위에 상륙시킬 예정입니다.
					<<elseif $smuggler_location is "bus">>
						버스로 몰래 들여올 예정입니다.
					<</if>>
				</li>
			<</if>>

			<<if $farm_stage gte 7>>
				<li>
					<<if $farm_attack_timer is 0>>
						<span class="pink">오늘 밤</span> 레미가 농장을 습격할 것입니다.
					<<else>>
						<<nDays $farm_attack_timer>>, 레미가 농장을 습격할 것입니다.
					<</if>>
					<<nnpc_He Remy>>【은는】 <span class="gold"><<ampm 21 00>></span>부터 <span class="gold">자정</span> 사이에 도착할 것입니다.
				</li>
			<</if>>

			<<if $temple_rank is "initiate" or $temple_rank is "monk" or $temple_rank is "priest">>
				<li>당신은 신전의 <<print $temple_rank is "initiate" ? "수습생" : "<<temple_title>>">>입니다.
					<<if $temple_chastity_timer lte 0>>
						<span class="pink">오늘 정조대 검사를 받아야 합니다.</span>
					<<elseif $temple_chastity_timer is 1>>
						<span class="purple">내일</span> 정조대 검사를 받아야 합니다.
					<<else>>
						<<nDays $temple_chastity_timer>>, 정조대 검사를 받아야 합니다.
					<</if>>
					검사를 통과하면 <span class="gold">용돈</span>을 받을 수 있습니다.
				</li>
			<</if>>

			<<if $studyBooks isnot undefined and ($studyBooks?.rented isnot "none" or $studyBooks?.stolen isnot "none")>>
				<li>
					<<if $studyBooks.rented isnot "none">>
						<<switch $studyBooks.rented>>
							<<case "Pinch">>
								<<if $per_npc.pinch isnot undefined>>
									<<set _book to `"${$per_npc.pinch.pronoun is "m" ? "핀치 씨" : "핀치 선생"}가 어떻게 크리스마스를 더듬었는가\" 사본`>>
								<<else>>
									<<set _book to "올리브색 책">>
								<</if>>
							<<case "Raul and Janet">>
								<<set _book to `"라울과 자넷\" 사본`>>
							<<case "English">>
								<<set _book to "영어 교과서">>
							<<case "science">>
								<<set _book to "과학 교과서">>
							<<case "maths">>
								<<set _book to "수학 교과서">>
							<<case "history">>
								<<set _book to "역사 교과서">>
						<</switch>>
						<<if Time.schoolTerm>>
							<<if $book_rent_timer is 0>>
								<span class="blue">반납 기한이 다 된 _book【을를】 가지고 있습니다.</span>
							<<elseif $book_rent_timer lt 0>>
								<span class="red">연체된 _book【을를】 가지고 있습니다.</span>
							<<else>>
								<span class="gold">$book_rent_timer</span>일 안에 _book【을를】 반납해야 합니다.
							<</if>>
						<</if>>
					<</if>>
					<<if $studyBooks.stolen isnot "none">>
						<<set _colour to $bookStolenKnown gte 3 ? "red" : $bookStolenKnown is 2 ? "pink" : "white">>
						<<switch $studyBooks.stolen>>
							<<case "Pinch">>
								<<if $per_npc.pinch isnot undefined>>
									<span @class=_colour>"<<= $per_npc.pinch.pronoun is "m" ? "핀치 씨" : "핀치 선생">>【이가】 어떻게 크리스마스를 더듬었는가" 사본을 훔쳤습니다.</span>
								<<else>>
									<span @class=_colour>올리브색 책을 훔쳤습니다.</span>
								<</if>>
							<<case "Raul and Janet">>
								<span @class=_colour>"라울과 자넷" 사본을 훔쳤습니다.</span>
							<<case "English">>
								<span @class=_colour>영어 교과서를 훔쳤습니다.</span>
							<<case "science">>
								<span @class=_colour>과학 교과서를 훔쳤습니다.</span>
							<<case "maths">>
								<span @class=_colour>수학 교과서를 훔쳤습니다.</span>
							<<case "history">>
								<span @class=_colour>역사 교과서를 훔쳤습니다.</span>
							<<default>>
						<</switch>>
					<</if>>
					<<if !Time.schoolTerm and $studyBooks.rented isnot "none">>
						<<if $studyBooks.rented>>_book【을를】 대출했습니다.<</if>>
						<span class="blue">방학 중에는 반납 기한이 없습니다!</span>
					<</if>>
				</li>
			<</if>>

			<<if $gwylanSeen?.includes("ritual_beast")>>
				<li>
					<<run statusCheck("Gwylan")>>
					<<if $gwylan.timer.ritual and Time.date.dayDifference(new DateTime(V.gwylan.timer.ritual)) > 0>>
						<<set _ritualDays to Time.date.dayDifference(new DateTime(V.gwylan.timer.ritual))>>
						<<if isGwylanAbsent() is "nobody">>누군가<<else>>그윌란이<</if>> <span class="gold"><<number _ritualDays>></span>일 후에 다른 의식을 치를 준비가 될 것입니다.
					<<elseif _gwylanStatus.includes("badEndReady") or $gwylan.hunting is 3>>
						<span class="red"><<if isGwylanAbsent() is "nobody">>누군가<<else>>그윌란이<</if>> 당신과 다른 의식을 치르기 위해 기다리고 있습니다.</span>
					<<else>>
						<span class="pink"><<if isGwylanAbsent() is "nobody">>누군가<<else>>그윌란이<</if>> 다른 의식을 치를 준비가 되었습니다.</span>
					<</if>>
				</li>
			<</if>>

			<<if $pubfame?.status>>
				<li>
					<<if $pubfame.status is "finished" or $pubfame.status is "hidingKnown">>
						미키는 <span class="gold"><<number $pubfame.timer>></span>일 후에 당신을 만날 준비가 될 것입니다.
					<<elseif $pubfame.status is "ready">>
						<span class="gold">미키가 당신의 명성 관리를 도와줄 준비가 되었습니다</span>.
					<<elseif $pubfame.status is "accepted">>
						미키의 의뢰를 맡았습니다.
					<<elseif $pubfame.status is "done">>
						미키의 의뢰를 완료했습니다.
					<</if>>
				</li>
			<</if>>
		</ul>
	<</if>>

	<<if !$statFreeze and (($location is "asylum" and ($eden_asylum_window is 1 or ($daily.eden.distract gte 1 and Time.hour lt 21))) || $temple_spear_mission gte 1 || $docks.hired || ($brothelshowdata.intro and $brothelshowdata.type is "none") || $exhibitionismrun || $robindebtevent gte 1 and $robinmissing isnot 0 || $pubtask2 is 1 || $pubtask || $police_hack is 1 || $pub_hack_job gte 1 || $pubfame ||( $earSlime.event and !_tempEventHide) || $earSlime.forcedCommando isnot undefined || $earSlime.forcedDressing isnot undefined || $temple_rank is "prospective" || $chef_state gte 4 || $mason_pond gte 1 || ($brothel_machine_repair gte 1 and $brothel_machine_repair lte 3) || ($harpy gte 6 and $birdFly isnot 1) || getChildrenAt("inventory").filter(child => child.species === "hawk").length gt 0 || $adultshopgrandopening || ($adultshopintro is 1 and $adultshopunlocked is undefined) || $gwylan?.request.event)>>
		/*TODO: streamline during eventual Journal UI Overhaul bc lol. lmao, even. */
		<hr>
		<h1 class="header gold bold">약속</h1>
		<ul class="journal carry">
			<<if $temple_spear_mission is 1>>
				<li><<islandicon>> 조던은 유물 창을 회수해달라고 당신에게 부탁했습니다. 그것은 신비한 섬에 있다고 합니다.
					<<if $temple_spear_mission_winter is undefined>>
						조던은 지역 박물관의 역사학자가 정보를 더 가지고 있을지 모른다고 말했습니다.
					<<else>>
						윈터에 따르면, 하수도에 있는 비밀 술집에서 섬에 대해 알고 있는 사람을 찾을 수 있을지도 모릅니다.
					<</if>>
				</li>
			<</if>>
			<<if $eden_asylum_window is 1 and $location is "asylum">>
				<<if Time.hour lt 22>>
					<li><<asylumicon "cell">> 에덴은 <span class="pink">오늘 밤</span> <<ampm 20 00>>에 정신병원을 지켜보고 있을 것입니다.</li>
				<<else>>
					<li><<asylumicon "cell">> 에덴이 정신병원을 지켜보며 당신이 방을 표시하기를 기다리고 있습니다.</li>
				<</if>>
			<</if>>

			<<if $daily.eden.distract gte 1 and $location is "asylum">>
				<<if Time.hour lt 21>>
					<li><<asylumicon "cell">> 에덴은 <span class="pink">오늘 밤</span> <<ampm 21 00>>에 소란을 피울 것입니다.</li>
				<</if>>
			<</if>>

			<<if $docks.hired>>
				<<if $docks.fakeID is "shown">>
					<li><<docksicon>> 부두 근무는 <<ampm 7 00>>에 시작합니다. 빠르면 <<ampm 6 00>>부터 입장할 수 있고, 늦어도 <<ampm 8 00>> 전에는 도착해야 합니다.</li>
				<<else>>
					<li><<docksicon>> 부두 근무는 등교일을 제외한 매일 <<ampm 7 00>>에 시작합니다. 빠르면 <<ampm 6 00>>부터 입장할 수 있고, 늦어도 <<ampm 7 15>> 전에는 도착해야 합니다.</li>
				<</if>>
			<</if>>

			<<if $brothelshowdata.intro and $brothelshowdata.type is "none">>
				<li><<brothelicon "stage">> 창관 쇼에 출연할 수 있습니다.</li>
			<</if>>

			<<if $exhibitionismrun>>
				<<if $exhibitionismrun is "danube" and $exhibitionismrunon is 0>>
					<li><<danubeicon>>수수께끼의 쪽지가 다뉴브 가의 스파 뒤편 떡갈나무 옆에서 옷을 벗으면 <<printmoney 10000>>【을를】 주겠다고 제안합니다.</li>
				<<elseif $exhibitionismrun is "danube" and $exhibitionismrunon is 1>>
					<li><<danubeicon>>수수께끼의 쪽지가 다뉴브 가의 스파 뒤편 떡갈나무 옆에서 옷을 벗고 자위해 절정하면 <<printmoney 30000>>【을를】 주겠다고 제안합니다.</li>
				<<elseif $exhibitionismrun is "starfish">>
					<li><<starfishicon>>수수께끼의 쪽지가 스타피시 가의 차량들을 향해 15분 동안 엉덩이를 드러내면 <<printmoney 50000>>【을를】 주겠다고 제안합니다.</li>
				<<elseif $exhibitionismrun is "cliff">>
					<li><<clifficon>>수수께끼의 쪽지가 알몸으로 클리프 가에서 하이가까지 왕복으로 달리면 <<printmoney 100000>>【을를】 주겠다고 제안합니다.</li>
				<</if>>
			<</if>>

			<<if $pubtask2 is 1>>
				<li><<crimeicon "black box">> 술집의 랜드리에게 블랙박스를 반납해야 합니다.</li>
			<<elseif $pubtask>>
				<li><<crimeicon "black box">> 랜드리가 <<= $pubtask is "forest" ? "숲" : $pubtask is "moor" ? "황야" : $pubtask is "sewers" ? "하수도" : $pubtask>>에서 블랙박스를 찾아오길 바랍니다.</li>
			<</if>>

			<<if $farm_manors_usb gte 1>>
				<li><<techicon "usb">> 농장의 저택에서 찾은 기밀 정보가 담긴 USB를 가지고 있습니다.</li>
			<</if>>

			<<if $police_hack is 1>>
				<li><<techicon "computer">> 랜드리가 잠긴 경찰 컴퓨터에 대해 도움을 줄 수 있을지도 모릅니다.</li>
			<<elseif $pub_hack_job is 1>>
				<li><<investigateicon>> 랜드리는 당신이 도무스 가의 고아원에 사는 '미키'라는 이름의 해커를 찾기를 바랍니다.</li>
			<<elseif $pub_hack_job is 2>>
				<li><<socialiseicon>> 미키를 설득해 당신과 협력하도록 만드세요.</li>
			<<elseif $pub_hack_job is 3>>
				<<if !$hacker_tasks.includes("bailey")>>
					<li><<techicon "email">> 미키는 베일리가 로그인해 있는 동안 베일리의 컴퓨터에 장치를 설치하기를 원합니다.</li>
				<</if>>
				<<if !$hacker_tasks.includes("leighton")>>
					<li><<crimeicon "safe">> 미키는 당신이 레이튼의 책상 아래에 있는 금고에서 메모리 카드를 훔쳐오기를 원합니다.</li>
				<</if>>
				<<if $hacker_tasks.length gte 2>>
					<li><<socialiseicon>>랜드리에게 미키에 대해 이야기해야 합니다.</li>
				<</if>>
			<</if>>

			<<if $pubfame>>
				<<if $pubfame.status is "accepted">>
					<li>
						<<switch $pubfame.task>>
							<<case "river">>
								<<investigateicon>> 미키는 학교 수학 교사인 리버에 대해 조사해주기를 원합니다.
							<<case "gwylan">>
								<<icon "snowgsnowglobelobe.gif">> 미키는 <<if $forest_shop_intro is 1>>그윌란의 상점<<else>>숲 외곽에 있는 상점<</if>>에서 특정한 스노우 글로브를 찾기를 원합니다.
							<<case "temple">>
								<<templeicon>> 미키는 안쪽 표지에 비밀번호가 적혀 있는 건축학 관련 책을 신전에서 찾기를 원합니다.
							<<case "kylar">>
								<<icon "manila-envelope.png">>
								<<if C.npc.Kylar.state is "prison">>
									미키는 카일라에게 전달하도록 경찰서에 편지를 맡겨주기를 원합니다.
								<<else>>
									미키는 <<if C.npc.Kylar.init isnot 1>>학교 학생인 <</if>>카일라에게 편지를 전달해주기를 원합니다.
								<</if>>
							<<case "wren">>
								<<icon "manila-envelope.png">> 미키는 편지를 전달해주기를 원합니다 <<if $wren_intro is undefined>>렌이라는 이름의 <<nnpc_gender "Wren">>에게. <<nnpc_He "Wren">>【은는】 황야의 레미의 사유지나, 밤에 부두에서 찾을 수 있습니다<<else>>렌에게<</if>>.
							<<case "hospital">>
								<<icon "access-card.png">>
								미키는 당신이 병원에서 카드키를 훔쳐오기를 원합니다.
								<<if $location is "asylum">>
									하지만, 이 장소의 카드키도 그들이 좋아할지 모른다고 생각합니다.
								<</if>>
							<<case "morgan">>
								<<techicon "usb">> 미키는 옛 하수도에서 USB 드라이브를 회수해 주기를 원합니다. 그들은 <<if $sewersintro is 1>>모건<<else>>그 아래에 있는 누군가가<</if>> 가지고 있을 것이라 생각합니다.
							<<case "niki">>
								<<photographystudioicon>> 미키는 니키의 사진관에서 <<hairmapcolourtext $pubfame.niki.hair>> 머리의 <<print window.KR.getDescriptionKr($per_npc.pubfame_model.fullDescription)>> 사진을 가져와 달라고 합니다.
							<<case "bailey">>
								<<techicon "usb">> 미키는 베일리가 로그인해 있는 동안 베일리의 컴퓨터에 장치를 심기를 원합니다.
							<<case "briar">>
								<<techicon "usb">> 미키는 브라이어의 창관 컴퓨터에 장치를 심기를 원합니다.
							<<case "office">>
								<<if $avery_fate is "ascended">>
									<<skyscrapericon>> 미키는 에이버리의 고층 건물에 편지를 전달해주기를 원합니다
								<<else>>
									<<officebuildingicon>> 미키는 사무실 건물에 편지를 전달해주기를 원합니다
								<</if>>.
							<<case "remy">>
								<!-- intentionally does not include the password -->
								<<steedicon>> 미키는 레미의 승마 학교<<if $ridingschoolintro is undefined>>, 하베스트 가를 지난 시골에 있는<</if>>의 연락책에게서 패키지를 회수해주기를 원합니다.
							<<case "compound">>
								<<techicon "vcam">> 미키는 엘크 가의 시설 주변에 카메라를 설치해주기를 원합니다.
								<<if $pubfame.compound.cameras.length gte 1>>
									당신은 이미 <<print formatList($pubfame.compound.cameras.map(getCompoundCameraLocationKr), "그리고", true)>>에 카메라를 숨겼습니다.
								<</if>>
						<</switch>>
						이를 완료하면 당신의 <<fameProse $pubfame.target>>【이가】 <<if $pubfame.goal.includes("perm")>>영구적으로<<else>>일시적으로<</if>> <<if $pubfame.goal.includes("Raise")>>상승<<else>>하락<</if>>할 것입니다.
					</li>
				<<elseif $pubfame.status is "done">>
					<li><<socialiseicon>> 미키에게 부탁받은 일을 마쳤다고 보고할 수 있습니다.</li>
				<</if>>
			<</if>>

			<<if $robindebtevent gte 1 and $robinmissing is "docks" and $docksrobinintro isnot 1>>
				<li><<docksicon>> 로빈이 사라졌습니다. <<nnpc_He "Robin">>【은는】 메르 가의 부두로 끌려갔습니다.</li>
			<</if>>

			<<if $robindebtevent gte 1 and $robinmissing is "landfill" and $mistrobinintro isnot 1 and $robinmistknown>>
				<li><<landfillicon>> 로빈이 사라졌습니다. <<nnpc_He "Robin">>【은는】 엘크 가의 쓰레기 매립지로 끌려갔습니다.</li>
			<</if>>

			<<if $robindebtevent gte 1 and $robinmissing is "pillory" and $robinPillory.known is 1>>
				<li><<pilloryicon>> 로빈이 사라졌습니다.
					<<if Time.hour lte 14>>
						<<nnpc_Hes "Robin">> 클리프 가의 형틀에 <<ampm 15 00>>에 매달릴 예정입니다.
					<<else>>
						<<nnpc_Hes "Robin">> 현재 형틀에 있습니다. 당신은 <<nnpc_him "Robin">>에게 어떤 일이 일어날지 모릅니다.
					<</if>>
				</li>
			<</if>>

			<<if $earSlime.event and !_tempEventHide and !$hypnosis_traits.silence gte 1>>
				<<switch $earSlime.event>>
					<<case "get sperm into your anus" "get sperm into your vagina" "get sperm into your anus completed" "get sperm into your vagina completed">>
						<li class="lewd"><<socialiseicon "ask">> 머릿속의 슬라임이 당신의 <<print $player.vaginaExist ? "vagina" : "anus">>에 정액을 넣으라고 명령했습니다.</li>
					<<case "get your own sperm into your anus" "get your own sperm into your vagina" "get your own sperm into your anus completed" "get your own sperm into your vagina completed">>
						<li class="lewd"><<socialiseicon "ask">> 머릿속의 슬라임이 당신의 <<print $player.vaginaExist ? "vagina" : "anus">>에 당신 자신의 정액을 넣으라고 명령했습니다.</li>
					<<case "only sleep naked from now on" "only wear feminine clothes for a while" "only wear masculine clothes for a while">> /* Show nothing */
					<<default>>
						<li class="lewd"><<bedicon>> 머릿속의 슬라임이 당신에게 <<print $earSlime.event>> 하라고 명령했습니다<<if $earSlime.noSleep>>. 명령을 따르기 전에는 잠을 잘 수 없습니다<</if>>.</li>
				<</switch>>
			<</if>>
			<<if $earSlime.forcedCommando isnot undefined and !$hypnosis_traits.silence gte 1>>
				<li class="lewd"><<icon "cross.png" "infront">><span class="clothes-white"><<icon "clothes/plain-panties.png">></span> 머릿속의 슬라임이 속옷을 입지 말라고 명령했습니다.</li>
			<</if>>
			<<if $earSlime.forcedDressing isnot undefined and !$hypnosis_traits.silence gte 1>>
				<li class="lewd"><<if $earSlime.forcedDressing.type is "f">><<femaleicon>><<else>><<maleicon>><</if>> 머릿속의 슬라임이 더 <<print $earSlime.forcedDressing.type is "f" ? "여성스러운" : "남성스러운">> 옷만 입으라고 명령했습니다.</li>
			<</if>>

			<<if $temple_rank is "prospective">>
				<li><<templeicon>> 조던이 신전에 자리를 제안했지만, 먼저 순결의 시험을 통과해야 합니다.</li>
			<</if>>

			<<if $chef_state is 4>>
				<li><<nightingaleicon>> 샘이 나이팅게일 거리의 어느 주소로 방문해 달라고 요청했습니다.</li>
			<<elseif $chef_state is 7 and $chef_rework lte 0>>
				<li><<cafeicon>> 오션 브리즈의 리모델링이 끝났습니다.</li>
			<<elseif $chef_state is 7 and $chef_rework lte 30>>
				<li><<cafeicon>> 오션 브리즈가 리모델링으로 인해 휴업 중입니다. 공사는 <<nDays $chef_rework>><<if $chef_rework gte 2>>에<</if>> 끝납니다.</li>
			<<elseif $chef_state is 7>>
				<<set _timer to $chef_rework - 30>>
				<li><<cafeicon>> 오션 브리즈가 리모델링을 위해 <<nDays _timer>><<if _timer gte 2>>에<</if>> 문을 닫습니다.</li>
			<<elseif $chef_state is 8>>
				<li><<cafeicon>> 샘은 당신이 저녁 <<ampm 18 00>>에서 <<ampm 21 00>> 사이 아무 날이나 오션 브리즈의 재개업 행사에 참석하기를 원합니다.</li>
			<</if>>

			<<if $mason_pond is 1>>
				<li><<socialiseicon "ask">> 메이슨이 도무스 거리 아래에 온천으로 만들 수 있는 지하수가 흐른다고 언급했습니다. 하지만 베일리의 허가가 먼저 필요합니다.</li>
			<<elseif $mason_pond is 2>>
				<li><<birdicon "wallet">> 베일리가 고아원 정원에 온천을 짓는 비용으로 <<printmoney 500000>>【을를】 요구했습니다.</li>
			<<elseif $mason_pond is 3>>
				<li><<watericon "waterside_wolfcave">> 고아원 정원에 온천을 건설하는 중입니다.</li>
			<<elseif $mason_pond is 4>>
				<li><<watericon "waterside_wolfcave">> 고아원 정원의 온천이 완성되었을 것입니다.</li>
			<</if>>

			<<if $brothel_machine_repair is 1>>
				<li><<socialiseicon "ask">> 브라이어에게 무대 뒤의 섹스 머신에 대해 물어보십시오.</li>
			<<elseif $brothel_machine_repair is 2>>
				<li><<symbol "lust">> 창관 섹스 머신의 연료를 채워야 합니다. 거기에는 값비싼 핑크 젤이 쓰입니다. 브라이어가 쓰레기장을 찾아보라고 제안했습니다. 그곳의 압축기 근처 깊숙한 곳에 있을 것입니다.</li>
			<<elseif $brothel_machine_repair is 3>>
				<li><<symbol "lust">> 브라이어가 섹스 머신에 필요하다고 했던 핑크 젤을 가지고 있습니다.</li>
			<</if>>

			<<if $harpy gte 6 and $birdFly isnot 1>>
				<li><<birdicon "prepare_hunt_day">> 날개는 튼튼해졌지만, 아직 나는 법을 모릅니다. 거대 매가 가르쳐 줄 수 있을 것입니다.</li>
			<</if>>
			<<set _eggIcon to getChildrenAt("inventory").filter(child => child.species === "hawk").length>>
			<<if _eggIcon gt 0>>
				<li><<birdicon "eggs">> 당신은 수정된 새알 <<number _eggIcon>>개를 가지고 있습니다. 알을 부화시키려면 황야의 <<if $syndromebird>>둥지<<else>>탑<</if>>으로 가져가야 합니다.</li>
			<</if>>

			<<if $farm_stage gte 5 and $estate_fence is undefined>>
				<li><<mooricon "remy">> 레미가 황야의 저택을 거점으로 알렉스의 농장을 침범하고 있습니다.</li>
			<<elseif $farm_stage gte 5 or isPubfameTaskAccepted("wren")>>
				<<if $estate_fence is "quest" and currentSkillValue('skulduggery') lt 800>>
					<li><<mooricon "remy">> 레미의 저택에 침입할 수 있게 도와줄 사람을 찾으십시오. 뒷골목과 연줄이 있거나 황야에 대해 잘 아는 사람이어야 합니다.</li>
				<<elseif $estate_fence is "bird">>
					<li><<mooricon "remy">> 레미 저택의 울타리에서 거대 매가 만들어둔 입구를 찾으십시오.</li>
				<<elseif $estate_fence is "landry">>
					<li><<mooricon "remy">> 레미 저택의 울타리에서 랜드리의 전문가가 만들어둔 입구를 찾으십시오.</li>
				<</if>>
			<</if>>

			<<if $farm>>
				<<if $farm.tower gte 1 and !$farm.tower_guard>>
					<li><<investigateicon>> 농장의 감시탑을 지킬 사람이 없습니다. 하베스트 거리의 펍에서 적당한 지원자를 찾을 수 있습니다.</li>
				<</if>>
			<</if>>

			<<if $photo>>
				<<if $photo.job is "kaiju" and $photo_high_money>>
					<li><<photographystudioicon>> 니키에게 하이 스트리트에서 완료한 작업의 급여를 받을 수 있습니다.</li>
				<<elseif $photo.job is "kaiju">>
					<li><<photographystudioicon>> 이번 주에 니키를 위한 고객 의뢰를 완료했습니다.</li>
				<</if>>
			<</if>>

			<<if $jordan_ritual_dance is 1>>
				<li><<danubeicon>> 조던은 다뉴브 가에 있는 저택 중 한 곳을 조사해 달라고 부탁했습니다. 그곳에 일하러 갔던 신도 중 한 명이 실종되었다고 합니다. 찰리와 댄서로서의 신분을 이용해 접근할 수 있습니다.</li>
			<<elseif $jordan_ritual_dance is 2>>
				<li><<templeicon>> 다뉴브 가의 저택에서 기묘한 의식을 목격했습니다. 신전의 최고 <<nnpc_title "Jordan">>인 조던에게 알려주십시오.</li>
			<</if>>

			<<if $farm>>
				<<if $farm.build>>
				<li>
					<<switch $farm.build>>
						<<case "parasites 1">>
							<<farmicon 'parasitebarn'>> 기생충 축사가 지어지고 있습니다.
						<<case "parasites 2">>
							<<farmicon 'parasitebarn'>> 기생충 축사가 확장되고 있습니다.
						<<case "wall 1">>
							<<choreicon "fix">> 담장을 대대적으로 수리하는 중입니다.
						<<case "wall 2">>
							<<choreicon "fix">> 담장을 보강하고 있습니다.
						<<case "wall 3">>
							<<choreicon "fix">> 돌담 위에 금속 울타리가 설치되고 있습니다.
						<<case "wall 4">>
							<<choreicon "fix">> 울타리 위에 철조망을 두르는 중입니다.
						<<case "tower 1">>
							<<skyscrapericon "construction">> 들판의 가장자리에 감시탑이 세워지고 있습니다.
						<<case "tower 2">>
							<<techicon "torch">> 감시탑 위에 탐조등이 설치되고 있습니다.
						<<case "kennel 1">>
							<<farmicon "kennel">> 경비견 훈련 시설이 건설 중입니다.
						<<case "barn 1" "barn 2">>
							<<farmicon "barn">> 헛간을 확장하고 있습니다.
						<<case "woodland 1" "woodland 2" "woodland 3">>
							<<choreicon "fix">> 근처 숲 둘레에 울타리를 짓는 중입니다.
						<<case "stable 1">>
							<<farmicon "barn">> 마구간을 확장하고 있습니다.
						<<case "coop 1" "coop 2">>
							<<farmicon "barn">> 닭장을 확장하고 있습니다.
						<<case "irrigation">>
							<<gardenicon "plot">> 들판에 관개 시설이 설치되고 있습니다.
						<<case "nursery">>
							<<childicon "crib">> 농장 저택에 유아 방이 만들어지고 있습니다.
					<</switch>>
					<<nDays $farm.build_timer>>에 완공될 것입니다.
				</li>
				<</if>>
			<</if>>

			<<if $adultshopgrandopening is true>>
				<li><<shopicon "adult">> 시리스의 성인용품점의 그랜드 오픈이 <span class="pink">오늘</span> 엘크 가에서 진행됩니다.</li>
			<<elseif $adultshopintro is 1 and $adultshopunlocked is undefined>>
				<<set $_theshop to "성인용품점">>
				<li>
					<<if $adultshopprogress gte 22>>
						<<shopicon "adult">> $_theshop의 공식 개업일은 내일입니다.
					<<elseif $adultshopprogress gte 18>>
						<<shopicon "dilapidated">> $_theshop【이가】 곧 완공됩니다.
					<<elseif $adultshopprogress gte 14>>
						<<shopicon "dilapidated">> $_theshop【은는】 공사 절반쯤 왔습니다.
					<<elseif $adultshopprogress gte 7>>
						<<shopicon "dilapidated">> $_theshop【은는】 모양새를 갖춰가기 시작했습니다.
					<<elseif $adultshopprogress gte 2>>
						<<shopicon "dilapidated">> $_theshop【은는】 낡았습니다.
					<<else>>
						<<shopicon "dilapidated">> $_theshop【은는】 무너질 듯 낡았습니다.
					<</if>>
					<<if $adultshopprogress lt 22>>
						엘크 가에서 금요일 <<ampm 16>> 이후에 시드니를 도울 수 있습니다.
					<</if>>
				</li>
			<</if>>

			<<if $avery_mansion?.landry is 1 and !$avery_fate>>
				<li><<harvesticon>> 누군가가 에이버리의 저택 밖에 메모를 남겨두어, 당신이 하베스트 가의 술집으로 찾아오기를 원합니다.</li>
			<</if>>

			<<if $gwylan?.request?.event and !($gwylan?.timer?.nobody gte Time.date.timeStamp)>>
				<<switch $gwylan.request.event>>
					<<case "meetAtShop">>
						<li><<shopicon "forest">>그윌란은 숲속 상점에서 <<nnpc_him "Gwylan">>【을를】 만나자고 부탁했습니다.</li>
					<<case "meetAtCafe">>
						<li><<cafeicon>>그윌란은 카페에서 <<ampm 7 20>>【와과】 <<ampm 9 20>> 사이에 <<nnpc_him "Gwylan">>【을를】 만나자고 부탁했습니다.</li>
					<<case "yearning">>
						<li><<shopicon "forest">>그윌란은 제대로 사과하고 싶다며 숲속 상점에서 <<nnpc_him "Gwylan">>【을를】 만나자고 부탁했습니다.</li>
					<<case "clothing">>
						<li><<shopicon "forest">>그윌란은 숲속 상점에 올 때 <<if $gwylan.request.items.length gt 1>>옷 몇 벌<<else>>옷가지<</if>>【을를】 입고 와달라고 부탁했습니다.</li>
						<<gwylanJournalItems>>
					<<case "ingredients">>
						<li><<icon "tending/basket.png">>그윌란은 당신에게 재료를 모아달라고 부탁했습니다.</li>
						<<gwylanJournalItems>>
					<<case "sample">>
						<li><<iconUi "sym-lust-empty.png">> 그윌란은 당신에게 샘플을 채취해달라고 부탁했습니다.</li>
						<<gwylanJournalItems>>
					<<case "recipe">>
						<li><<icon "tending/basket.png">>그윌란은 당신에게 <span class="blue">$gwylan.request.special</span>을 만들 아이템들을 구해달라고 부탁했습니다.</li>
						<<gwylanJournalItems>>
					<<case "samplePlayer">>
						/* ToDo: Gwylan */
					<<case "preen">>
						<<if $gwylan.request.special is "harpy">>
							<li><<tficon "bird">> 그윌란은 당신의 날개를 손질해주겠다고 요청했습니다.
							<<if $harpy lt 6>>
								<span class="blue">당신은 더 이상 날개가 없습니다. 아마 매 깃털로도 충분할 것입니다.</span>
							<</if>>
							</li>
						<<else>>
							<<set $_featherCount to $gwylan.request.items.find(feather => feather.name === "feathers").need>>
							<li><<birdicon "feathers">> 그윌란은 매의 깃털 <span class="gold"><<number $_featherCount>></span>개를 구해달라고 부탁했습니다.</li>
							<<if $bird?.materials?.feathers>>당신은 <span class="blue"><<number $bird.materials.feathers>></span>개의 깃털을 가지고 있습니다.<</if>>
							<<if $harpy gte 6>>
								<span class="gold">어쩌면 <<nnpc_he "Gwylan">>【이가】 당신의 날개를 직접 손질해 줄 수도 있습니다...</span>
							<</if>>
						<</if>>
					<<case "cream">>
						<li><<foodstufficon "cream">><span class="lewd">그윌란이 어떤 크림이 포함된 야한 제안을 했습니다...</span></li>
					<<case "robin">>
						/* ToDo: Gwylan */
					<<case "chastity">>
						<li>
						<<if playerChastity()>><<lockicon>><<else>><<lockicon "unlock">><</if>>
						<<if $gwylan.request.command is true>>
							그윌란이 당신의 정조대를 벗으라고 <<if $hypnosis_traits.devotion gte 3>>명령했습니다<<else>>원하고 있습니다<</if>>.
						<<else>>
							그윌란이 당신의 정조대를 벗는 것을 도와주겠다고 제안했습니다.
						<</if>>
						<<if playerChastity() and $gwylan.request.items>>
							<<nnpc_He "Gwylan">>【은는】 도움을 줄 몇 가지 물건이 필요합니다.
						<</if>>
						</li>
						<<if !playerChastity()>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<if $worn.genitals.name is "gold chastity belt" or $gwylan.request.details?.gold>>
							<<antiqueicon "chastity">>
						<<else>>
							<<icon "clothes/chastity-belt.png">>
						<</if>>
						정조대를 <span class="red">벗는다</span>
						<<if playerChastity() and $gwylan.request.items>>
							<br><span class="blue">또는</span><br>
							<<gwylanJournalItems>>
						<</if>>

					<<default>>
						<li><span class="red">그윌란이 당신에게 무언가 부탁했지만 이 작업에는 일지 설명이 없습니다! 이 버그를 보고해 주십시오.</span></li>
				<</switch>>
			<</if>>
		</ul>
	<</if>>

	<<if ["requested", "ready"].includes($daily?.fishing?.baitShopRequest) and Time.hour lt 19>>
		<hr>
		<h1 class="header gold bold">낚시</h1>
		<ul class="journal">
			<<icon `"fish/" + $daily.fishing.baitShopRequestFish + ".png"`>> 미끼 상점 주인이 갓 잡은 <span class="gold"><<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>></span>【을를】 원합니다. <<ampm 19 00>>에 문을 닫기 전까지 가져다주세요.
			<<if $daily.fishing.baitShopRequest is "ready">>
				<span class="green">건네줄 물고기를 잡았습니다.</span>
			<</if>>
		</ul>
	<</if>>

	<<if ($valentines is 1) or $halloween is 1 or $christmas is 1>>
		<hr>
		<h1 class="header gold bold">특별한 날</h1>
	<</if>>
	<<if $valentines is 1>>
		<ul class="journal">
			<li>발렌타인 데이가 <<if Time.monthDay is 14>><span class="gold">오늘</span><<else>><<= getFormattedDate(new DateTime(Time.year, 2, 14))>>에<</if>> 열립니다. 특별한 누군가와 시간을 보내면 무척 보람을 느낄 것 같습니다.</li>
			<<if $valentines_eden is 1 and !$valentines_eden_bought>>
				<li>에덴을 축하하기 위해 선물을 살 수 있습니다.</li>
			<<elseif $valentines_eden_bought is 1>>
				<li>발렌타인 데이 <<ampm 17 00>>에 에덴을 위한 목욕을 준비할 수 있습니다.</li>
			<</if>>
		</ul>
	<</if>>

	<<if $halloween is 1>>
		<ul class="journal">
			<li>할로윈은 <<= getFormattedDate(new DateTime(Time.year, 10, 31))>>에 열립니다.</li>
			<<if $halloween_whitney is 1 and C.npc.Whitney.state isnot "dungeon">>
				<li>휘트니가 <<ampm 19 00>>부터 도무스 가에서 사탕 얻기 놀이를 할 것입니다.</li>
			<</if>>
			<<if $halloween_robin is 1 and $robinmissing is 0>>
				<li>로빈이 <<ampm 16 00>>에서 <<ampm 19 00>> 사이에 사탕 얻기 놀이를 하러 가고 싶어 합니다.</li>
			<</if>>
			<<if $halloween_kylar is 1 and C.npc.Kylar.state isnot "prison">>
				<li>카일라가 <<ampm 21 00>> 이후에 공원에서 만나자고 부탁했습니다.</li>
			<</if>>
			<<if $halloween_eden is 1>>
				<li>에덴의 할로윈을 축하하기 위해 간식을 살 수 있습니다.</li>
			<</if>>
			<<if $halloween_lake is 1>>
				<li>학생들이 호수에서 <<ampm 18 00>>부터 자정까지 파티를 열 것입니다.</li>
				<<if $halloweenWolves>>
					<li>그곳에서 늑대 무리 중 한 마리가 다쳤습니다.</li>
				<</if>>
			<</if>>
		</ul>
	<</if>>

	<<if $christmas is 1>>
		<ul class="journal">
			<li>
				<<if Time.monthDay is 25 and Time.hour lte 20>>
					고아들이 크리스마스를 축하하고 있습니다.
				<<else>>
					고아들은 <span class="gold">25일</span>에 자신들만의 크리스마스를 기념할 것입니다.
				<</if>>
				<<if $christmas_gift is undefined>>
					쇼핑 센터에서 선물을 사 줄 수 있습니다.
				<<elseif $christmas_gift is "clothes_unwrapped">>
					고아원의 당신 방에서 선물을 포장할 수 있습니다.
				<</if>>
			</li>

			<<if $christmas_gift_robin is undefined and C.npc.Robin.init is 1>>
				<li>쇼핑 센터<<if $forest_shop_intro is 1>>나 숲속 상점<</if>>에서 로빈에게 줄 선물을 살 수 있습니다.</li>
			<<elseif $christmas_gift_robin and $christmas_gift_robin_wrapped isnot 1 and C.npc.Robin.init is 1>>
				<li>로빈의 선물을 방에서 포장할 수 있습니다.</li>
			<</if>>
			<<if !$christmas_wrap>>
				<li>쇼핑 센터에서 포장지를 판매할 것입니다.</li>
			<</if>>

			<<if $syndromeeden gte 1>>
				<<if Time.monthDay is 25>>
					<<if Time.hour lte 20>>
						<li> <span class="pink">오늘</span> 에덴과 함께크리스마스를 기념할 수 있습니다.</li>
					<</if>>
				<<else>>
					<li>크리스마스가 다가옵니다. 에덴과 함께 기념할 수 있습니다.</li>
				<</if>>
				<<if $christmas_gift_eden is undefined>>
					<li>쇼핑 센터에서 에덴에게 줄 선물을 살 수 있습니다.</li>
				<</if>>
				<<if $edenmeal is 1>>
					<li>에덴이 <<ampm 18 00>>에 크리스마스 만찬에 초대했습니다.</li>
				<</if>>
			<</if>>
			<<if $fake_artefact is "pc" and $avery_fate isnot "ascended">>
				<li>랜드리가 에이버리의 저택 금고에 있는 소원의 돌을 자신이 준 가짜로 바꿔치기 하기를 원합니다. 그렇게 하면 에이버리를 <<nnpc_himself "Avery">>로부터 구할 수 있다고 합니다.</li>
			<</if>>
		</ul>
	<</if>>

	<<if $avery_mansion and C.npc.Avery.state isnot "dismissed">>
		<hr>
		<h1 class="header gold bold">에이버리의 요구</h1>
		<ul class="journal carry">
			<li><<foodicon "eat">><span @class="between(Time.weekDay,2,6) ? 'gold' : ''">평일 <<ampm 21 00>></span>까지 저녁을 준비해 주기를 원합니다.</li>
			<<if $avery_mansion.food isnot "none">>
				<li>
					<<foodstufficon $avery_mansion.food>>
					<<set $_averyMissedColor to ["","purple","pink","red"][Math.clamp($avery_mansion.rage.dinner_missed,0,3)]>>
					<<set $_averyDishAmount to $foodstuff[$avery_mansion.food].amount>>
					<<set $_averyDishAmountColour to $foodstuff[$avery_mansion.food].amount ? "green" : "red">>
					<span @class="$_averyMissedColor">저녁 메뉴로 <<recipe_name $avery_mansion.food "article">>【을를】 대접해야 합니다.</span> (<span @class="$_averyDishAmountColour"><<print $_averyDishAmount>></span>개 보유 중)
				</li>
			<</if>>
			<<if !($avery_tower.stage is 3 and $avery_mansion.stopPartyAfterTower) and !["missed", "started"].includes($avery_mansion.party_state)>>
				<li><<icon "front-gate.png">> <span @class="Time.weekDay is 1 ? 'gold' : ''"><<if ["first sunday skip", "finished", "skipped"].includes($avery_mansion.party_state)>>다음 주<<else>>이번 주<</if>> 일요일 <<ampm 18>></span>에 열리는 파티에 참석해야 합니다. 귀빈은 <<print window.KR.gatPersonNameDictKR($avery_mansion.guest)>>입니다.</li>
			<</if>>
			<<if $avery_mansion.fox.task and !$avery_fate>>
				<li><<icon "clothes/fox-mask.png">>
				<<if $avery_mansion.fox.task_complete is "success">>
					<span class="green">갈색 여우의 의뢰를 완수했습니다.</span>
				<<elseif $avery_mansion.fox.task_complete is "fail">>
					<span class="red">갈색 여우의 의뢰를 완수하지 못했습니다.</span>
				<<elseif $avery_mansion.fox.task isnot $avery_mansion.guest and $avery_mansion.fox.task isnot "heist">>
					<span class="purple">갈색 여우의 의뢰를 끝마치지 못했습니다.</span>
				<<else>>
					<<switch $avery_mansion.fox.task>>
						<<case "heist">>갈색 여우는 당신에게 직접 소원의 돌을 훔쳐낼 만큼의 신뢰를 보내며, 에이버리가 자리를 비웠을 때 정원에서 보낼 신호를 알려주었습니다.
						<<case "Jordan">>
							갈색 여우는 조던이 저택에 올 때 변장한 수련생 두 명에게 전갈을 전하고<<if $avery_mansion.fox.task_detail is "ascend">> 그들이 공사를 방해하지 못하게 막아달라고<</if>> 요청했습니다.
						<<case "Quinn">>갈색 여우는 다음 파티에서 퀸에게 정신이 팔린 포섭 요원의 주의를 돌려놓고 수신호를 보내달라고 요청했습니다.
						<<case "Remy">>
							<<if $brownFoxWounded or $fake_artefact is "Avery">>
								<<if $avery_mansion.fox.task_detail is "descend">>
									갈색 여우로부터 레미의 수행원 두 명이 파티에서 일찍 빠져나가도록 유도해 달라는 부탁을 받았습니다.
								<<else>>
									갈색 여우로부터 레미의 수행원 두 명이 파티에 계속 남아 있도록 붙잡아 달라는 부탁을 받았습니다.
								<</if>>
							<<else>>
								갈색 여우는 에이버리의 다음 파티에 나타날 예정입니다.
							<</if>>
						<<case "Briar">>
							<<if $avery_mansion.fox.task_detail is "descend">>
								갈색 여우로부터 다음 파티에서 브라이어가 탑 공사를 적극적으로 훼방 놓게 만들라는 부탁을 받았습니다.
							<<else>>
								갈색 여우로부터 다음 파티에서 브라이어가 탑 공사를 돕도록 설득해 달라는 부탁을 받았습니다.
							<</if>>
						<<case "Harper">>갈색 여우로부터 다음 파티에서 하퍼의 약병을 바꿔치기해 달라는 부탁을 받았습니다.
					<</switch>>
				<</if>>
				</li>
			<</if>>
			/* Reworked, left in while in construction
			<<if $avery_mansion.landry gte 2 and $auriga_artefact is "Avery">>
				<li>Landry will give you <span class="gold">£10000</span> if you can bring <<nnpc_him "Landry">> the <span class="pink">wishing stones</span> from Avery's mansion.</li>
				<<if $avery_mansion.mickey>>
					<li>Mickey suggests making Avery feel more dominant would cause them to reveal the stones' location. Alternatively, helping Avery reach their goals could bring them into the open.</li>
				<</if>>
				<<if $avery_mansion.jobs.includes("dungeon")>>
					<li>Avery revealed a dungeon containing a vault. It seems a likely place for the stones.</li>
				<</if>>
				<<if $avery_mansion.fake_stones is 2>>
					<li>Optionally, replace Avery's wishing stones with the fakes Mickey gave you.</li>
				<</if>>
			<<elseif $avery_mansion.landry gte 2 and $auriga_artefact is "pc">>
				<li>Landry will give you <span class="gold">£10000</span> if you can bring <<nnpc_him "Landry">> the <span class="pink">wishing stones</span> that are in your possession.</li>
			<</if>>
			<<if $avery_mansion.fake_stones is 1>>
				<li><<investigateicon>> Find a convincing fake to swap for the wishing stones.</li>
			<<elseif $avery_mansion.fake_stones is 2>>
				<li><<icon "avery-vault.png">> Leave the fake wishing stones in Avery's vault.</li>
			<</if>>*/
			<<if $avery_mansion.jobs.filter(job => !job.includes("dungeon")).length>>
				<li>
					<<icon "avery-garage.png">>퇴근 후 예의 바르게 맞이하길 원합니다.
					<<if $avery_mansion.jobs.includes("maid")>>
						<br>
						<<if $worn.upper.type.includes("maid") or $worn.lower.type.includes("maid") or $worn.head.type.includes("maid")>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<iconUi "clothes/traits/maid.png">>메이드복을 입고 맞이합니다.
					<<elseif $avery_mansion.jobs.includes("formal")>>
						<br>
						<<if $worn.upper.type.includes("formal") or $worn.lower.type.includes("formal") or $worn.head.type.includes("formal")>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<iconUi "clothes/traits/formal.png">>격식을 차린 옷을 입고 맞이합니다.
					<</if>>
					<<if $avery_mansion.jobs.includes("knees")>>
						<br>
						<<if $avery_mansion.kneel isnot "refuse">>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<sneakicon>>무릎을 꿇고 인사합니다.
					<<elseif $avery_mansion.jobs.includes("bow")>>
						<br>
						<<if $avery_mansion.bow>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<sneakicon>><<= $player.gender_appearance is "f" ? "메이드처럼 인사 하여" : "집사처럼 인사 하여">> 맞이합니다.
					<</if>>
					<<if $avery_mansion.jobs.includes("meek")>>
						<br>
						<<if $speech_attitude is "meek" or $speech_attitude_avery>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<socialiseicon>>순종적인 태도를 보입니다.
					<</if>>
					<<if $avery_mansion.jobs.includes("hairlength")>>
						<br>
						<<if $hairlength lt 400>>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<icon "scissors.png">>머리 길이를 어깨 위로 유지합니다.
					<</if>>
					<<if $avery_mansion.jobs.includes("hairstyle")>>
						<br>
						<<if $hairtype is "neat">>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<icon "comb.png">>'깔끔한' 헤어스타일을 유지합니다.
					<</if>>
					<<if ["lounge", "dining", "bedroom", "pool", "garden", "display", "kitchen", "bathroom"].includesAny($avery_mansion.jobs)>>
						<br>
						<<avery_mansion_housework_total>>
						<<set $_averyCleanColor to ["","purple","pink","red"][Math.clamp(Math.floor((_avery_mansion_housework_total) / 3),0,3)]>>
						<<if $_averyCleanColor is "">>
							<span class='fa-icon fa-selected'></span>
						<<else>>
							<span class='fa-icon fa-unselected'></span>
						<</if>>
						<<icon "clothes/feather-duster.png">><span @class="$_averyCleanColor">저택 내부를 청결하게 관리합니다.</span>
					<</if>>
				</li>
			<</if>>
			<<if $avery_tower>>
				<<if $avery_tower.stage is 3 and !$avery_fate>>
					<li><<skyscrapericon "bloodmoon">> 에이버리는 <span class="gold">다음 붉은 달이 뜰 때</span> 고층 빌딩 개장식에 참석하기 위해 자신의 저택에서 만나기를 기대하고 있습니다.
					</li>
				<</if>>
			<</if>>
		</ul>
	<</if>>

	<<if $scienceproject is "ongoing">>
		<hr>
		<h1 class="header gold bold">과학 박람회</h1>
		<<if $scienceprojectdays is 0>>
			과학 박람회는 클리프 가의 마을 회관에서 <span class="pink">오늘</span> <<ampm 9 00>>에서 <<ampm 18 00>>까지 열립니다.
			<br>
		<<else>>
			과학 박람회는 클리프 가의 마을 회관에서 <<nDays $scienceprojectdays>>에 열릴 예정입니다.
			<br>
		<</if>>
		<<if $avery_mansion and $scienceproject is "ongoing" and ($sciencephalluschance gte 1 or $sciencelichenchance gte 1 or $scienceshroomchance gte 1) and !$avery_mansion.attend.science and $avery_fate isnot "fallen" and $avery_fate isnot "kicked">>
			<span class="blue">에이버리에게 참석해달라고 부탁하는 것을 고려해보세요.</span>
			<br>
		<</if>>
		당신에게는 다음과 같이 진행 중인 과학 프로젝트가 있습니다. 박람회에 출품할 하나를 골라야 합니다.
		<br><br>
		<<if $sciencelichenknown is 1>>
			<span class="gold bold">지역의 이끼</span>
			<br>
			<<if $sciencechance is undefined>>
				<<set $sciencechance to []>>
			<</if>>
			<<if $sciencelichenpark is 1>>
				<<if $sciencelichenparkready is 1>>
					<<run $sciencechance.pushUnique("Lichen")>>
					<span class='fa-icon fa-selected'></span> 공원에 있는 이끼를 프로젝트에 추가했습니다.
					<br>
				<<else>>
					<span class='fa-icon fa-unselected'></span> 공원에 있는 이끼를 조사했습니다. 집이나 도서관에서 내용을 정리해야 합니다.
					<br>
				<</if>>
			<<else>>
				<span class='fa-icon fa-unselected'></span><span class="black"> 공원에 있는 하얀 이끼를 조사해야 합니다.</span>
				<br>
			<</if>>
			<<if $sciencelichentemple is 1>>
				<<if $sciencelichentempleready is 1>>
					<<run $sciencechance.pushUnique("Temple")>>
					<span class='fa-icon fa-selected'></span> 신전에 있는 이끼를 이끼를 프로젝트에 추가했습니다.
					<br>
				<<else>>
					<span class='fa-icon fa-unselected'></span> 신전에 있는 이끼를 조사했습니다. 집이나 도서관에서 프로젝트에 추가해야 합니다.
					<br>
				<</if>>
			<<else>>
				<span class='fa-icon fa-unselected'></span><span class="black"> 신전에 있는 분홍빛 이끼를 조사해야 합니다.</span>
				<br>
			<</if>>
			<<if $sciencelichendrain is 1>>
				<<if $sciencelichendrainready is 1>>
					<<run $sciencechance.pushUnique("Drain")>>
					<span class='fa-icon fa-selected'></span> 배수구에 있는 이끼를 이끼를 프로젝트에 추가했습니다.
					<br>
				<<else>>
					<span class='fa-icon fa-unselected'></span> 배수구에 사는 이끼를 조사했습니다. 집이나 도서관에서 프로젝트에 추가해야 합니다.
					<br>
				<</if>>
			<<else>>
				<span class='fa-icon fa-unselected'></span><span class="black"> 바다로 흘러나가는 배수구에 있는 보랏빛 이끼를 조사해야 합니다.</span>
				<br>
			<</if>>
			<<if $sciencelichenlake is 1>>
				<<if $sciencelichenlakeready is 1>>
					<<run $sciencechance.pushUnique("Ruin")>>
					<span class='fa-icon fa-selected'></span> 호수의 폐허에 있는 이끼를 프로젝트에 추가했습니다.
					<br>
				<<else>>
					<span class='fa-icon fa-unselected'></span> 호수 폐허에 있는 이끼를 관찰했습니다. 집이나 도서관에서 프로젝트에 반영해야 합니다.
					<br>
				<</if>>
			<<else>>
				<span class='fa-icon fa-unselected'></span><span class="black"> 호수 폐허에 있는 보라색 이끼를 조사해야 합니다.</span>
				<br>
			<</if>>
			이 프로젝트가 박람회에서 우승할 확률은 <span @class="($sciencechance.length is 0 ? 'red' : $sciencechance.length is 1 ? 'pink' : $sciencechance.length is 2 ? 'purple' : $sciencechance.length is 3 ? 'teal' : $sciencechance.length is 4 ? 'green' : '')"><<print ($sciencelichenparkready * 25 + $sciencelichenlakeready * 25 + $sciencelichendrainready * 25 + $sciencelichentempleready * 25)>>%</span>입니다. 이 프로젝트로 우승한다면 트라우마가 크게 줄어들며 교사들에게 좋은 인상을 심어줄 수 있습니다.
			<br><br>
		<<else>>
			<span class="black">????????????</span>
			<br>
			새로운 것을 찾아 탐험하세요.
			<br><br>
		<</if>>
		<<if $scienceshroomknown is 1>>
			<span class="gold bold">지역의 버섯</span>
			<br>
			<span @class="($scienceshroomheart is 5 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span><span @class="$scienceshroomheart is 0 and $scienceshroomheartready is 0 ? 'black' : ''"> 하트 버섯을 $scienceshroomheart/5개 발견했습니다.</span>
			<br>
			<span @class="($scienceshroomheartready is 5 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span><span @class="$scienceshroomheart is 0 and $scienceshroomheartready is 0 ? 'black' : ''"> 하트 버섯 $scienceshroomheartready/5개를 프로젝트에 추가했습니다.</span>
			<<if $scienceshroomheart gt $scienceshroomheartready>>
				집이나 도서관에서 버섯을 프로젝트에 추가하세요.
			<</if>>
			<br>
			<span @class="($scienceshroomwolf is 5 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span><span @class="$scienceshroomwolf is 0 and $scienceshroomwolfready is 0 ? 'black' : ''"> 늑대 버섯을 $scienceshroomwolf/5개 발견했습니다.</span>
			<br>
			<span @class="($scienceshroomwolfready is 5 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span><span @class="$scienceshroomwolf is 0 and $scienceshroomwolfready is 0 ? 'black' : ''"> 늑대 버섯 $scienceshroomwolfready/5개를 프로젝트에 추가했습니다.</span>
			<<if $scienceshroomwolf gt $scienceshroomwolfready>>
				집이나 도서관에서 버섯을 프로젝트에 추가하세요.
			<</if>>
			<br>
			<<set $scienceshroomchance to ($scienceshroomwolfready * 10 + $scienceshroomheartready * 10)>>
			박람회에서 우승할 확률이 <span @class="$scienceshroomchance gte 100 ? 'green' : $scienceshroomchance gte 80 ? 'teal' : $scienceshroomchance gte 60 ? 'lblue' : $scienceshroomchance gte 40 ? 'purple' : $scienceshroomchance gte 20 ? 'pink' : $scienceshroomchance gte 0 ? 'red' : ''"><<print $scienceshroomchance>>%</span>입니다. 이 프로젝트로 우승하면 트라우마가 크게 줄어들며 학생들 사이에서 유명해집니다.
			<br><br>
		<<else>>
			<span class="black">????????????</span>
			<br>
			새로운 것을 찾아 숲을 탐험하세요.
			<br><br>
		<</if>>
		<<if $sciencephallusknown is 1>>
			<span class="gold bold">지역의 남근 <mouse class="tooltip gold">(?)<span>날씨가 좋은 날, 해변에서 참가자를 찾아보세요.</span></mouse></span>
			<br>
			<span @class="($sciencephallus is 10 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span> $sciencephallus/10개의 남근을 측정했습니다.
			<br>
			<span @class="($sciencephallusready is 10 ? 'fa-icon fa-selected' : 'fa-icon fa-unselected')"></span> $sciencephallusready/10개의 남근을 프로젝트에 추가했습니다.
			<<if $sciencephallus gt $sciencephallusready>>
				집이나 도서관에서 프로젝트에 남근 기록을 추가하세요.
			<</if>>
			<br>
			이 프로젝트가 박람회에서 우승할 확률은 <span @class="$sciencephallusready gte 10 ? 'green' : $sciencephallusready gte 8 ? 'teal' : $sciencephallusready gte 6 ? 'lblue' : $sciencephallusready gte 4 ? 'purple' : $sciencephallusready gte 2 ? 'pink' : $sciencephallusready gte 0 ? 'red' : ''"><<print ($sciencephallusready * 10)>>%</span>입니다. 우승하면 트라우마가 크게 줄어들며 훨씬 유명해질 수 있습니다.
			<br>
		<<else>>
			<span class="black">????????????</span>
			<br>
			음란도가 높으면 발견할 수 있습니다.
			<br>
		<</if>>
	<</if>>


	<<if $mathsproject is "ongoing">>
		<<set $mathschance = Math.clamp($mathschance, 0, 100)>>
		<hr>
		<h1 class="header gold bold">수학 경시대회</h1>
		<<if $mathsprojectdays is 0>>
			수학 경시대회가 <span class="pink">오늘</span> 클리프 가의 시청에서 <<ampm 9 00>>에서 <<ampm 18 00>>까지 열립니다.
			<br>
		<<else>>
			수학 경시대회가 <span class="gold">$mathsprojectdays</span>일 후 클리프 가의 시청에서 열립니다.
			<br>
			그전까지 해답을 준비해야 합니다. 고아원이나 학교 도서관에서 프로젝트를 진행할 수 있습니다.
			<br>
		<</if>>
		<<if $avery_mansion and $mathsproject is "ongoing" and $mathschance gte 1 and !$avery_mansion.attend.maths and $avery_fate isnot "fallen" and $avery_fate isnot "kicked">>
			<span class="blue">에이버리에게 참석해달라고 부탁하는 것을 고려해보세요.</span>
			<br>
		<</if>>
		<<if $mathschance is 0>>
			<span class="black"> 아직 연구를 시작하지 않았습니다. 대회에서 이길 확률은 $mathschance%입니다.</span>
		<<elseif $mathschance lte 10>>
			<span class="pink"> 이제 막 해답을 구하기 시작했습니다. 대회에서 이길 확률은 $mathschance%입니다.</span>
		<<elseif $mathschance lte 30>>
			<span class="purple">당신의 답은 부족하지만, 무언가 있습니다. 대회에서 이길 확률은 $mathschance%입니다.</span>
		<<elseif $mathschance lte 50>>
			<span class="blue">해답에 약간의 내용이 생겼지만, 아직 갈 길이 멉니다. 대회에서 우승할 확률은 $mathschance%입니다.</span>
		<<elseif $mathschance lte 80>>
			<span class="lblue">당신의 해결책이 모양새를 갖추고 있지만 개선할 여지가 있습니다. 대회에서 우승할 확률은 $mathschance%입니다.</span>
		<<elseif $mathschance lte 99>>
			<span class="teal">당신의 풀이는 완벽하지 않지만, 훌륭합니다. 이만큼 도달한 사람이 있을 것이라고 상상할 수 없습니다. 대회에서 우승할 확률은 $mathschance%입니다.</span>
		<<else>>
			<span class="green">당신의 풀이는 완벽합니다. 우승할 확률이 $mathschance%입니다.</span>
		<</if>>
		<br><br>
		<span class="gold">$mathsinfo</span>개의 힌트를 가지고 있습니다.
		<<if $stimdealerknown is 1>>
			<span class="gold">$mathsstim</span>개의 각성제를 가지고 있습니다.
			<br>
			옥스퍼드 가에 있는 거래상들에게서 각성제를 살 수 있습니다.
			<br>
		<</if>>
	<</if>>

	<<if $englishPlay is "ongoing">>
		<hr>
		<h1 class="header gold bold">영어 연극</h1>
		<<if $englishPlayDays is 0>>
			학교 연극이 클리프 가에 있는 마을 회관에서 <span class="pink">오늘 밤</span> <span class="gold"><<ampm 17 00>></span>부터 <span class="gold"><<ampm 21 00>></span>까지 열릴 것입니다.
		<<else>>
			학교 연극이 클리프 가에 있는 마을 회관에서 <span class="gold">$englishPlayDays</span>일 뒤에 열릴 것입니다.
		<</if>>
		/*
		<<if $avery_mansion and $englishPlay is "ongoing" and $englishPlayReadiness gte 1 and !$avery_mansion.attend.english_play and $avery_fate isnot "fallen" and $avery_fate isnot "kicked">>
			<span class="blue">Consider asking Avery to attend.</span>
			<br>
		<</if>>
		 */
		<<if $englishPlayRoles.Player isnot "none">>
			<ul class="journal">
			<li>당신은 <<= window.KR.gatPersonNameDictKR($englishPlayRoles.Player)>>의 역할을 맡았습니다. 고아원에서 혼자 연습할 수 있습니다.</li>
			<<if $englishPlayRoles.Kylar isnot "none" and $englishPlayRoles.KylarKnown>>
				<li>카일라는 <<= window.KR.gatPersonNameDictKR($englishPlayRoles.Kylar)>>의 역할을 맡았습니다. 방과 후 <<if Weather.precipitation !== "none">>학교 도서관<<else>>학교 뒷마당<</if>>에서 <<nnpc_him "Kylar">>【와과】 연습할 수 있습니다.</li>
			<<elseif $englishPlayKylarReplace>>
				<li>연극에서 카일라의 역할은 다른 학생이 맡아야 할 것입니다.</li>
			<</if>>
			<<if $englishPlayRoles.SydneyKnown>>
				<li>시드니는 <<= window.KR.gatPersonNameDictKR($englishPlayRoles.Sydney)>>의 역할을 맡았습니다. 방과 후 영어 교실에서 <<nnpc_him "Sydney">>【와과】 연습할 수 있습니다.</li>
			<</if>>
			<<if !$englishPlayRoles.SydneyKnown and !$englishPlayRoles.KylarKnown>>
				<li>방과 후 영어 교실에서 파트너들을 만날 수 있습니다.</li>
			<<elseif !$englishPlayRoles.SydneyKnown or (!$englishPlayRoles.KylarKnown and !$englishPlayKylarReplace and $englishPlayRoles.Kylar isnot "none")>>
				<li>방과 후 영어 교실에서 다른 파트너를 만날 수 있습니다.</li>
			<</if>>
			</ul>
			<br>
			<<playReadiness>>
			연기를 잘 하면 사교 명성이 퍼지고 학교 상태가 크게 상승할 것입니다.
		<<else>>
			<<if $englishPlayLate>>
				역할을 선택할 수 있는 기한이 <<number $englishPlayLate>>일 남았습니다. 방과 후 영어 교실에서 신청하거나, 아니면 그냥 다른 학생들의 리허설을 도울 수 있습니다.
			<<else>>
				역할을 맡기에는 너무 늦었지만, 여전히 다른 학생들의 리허설을 돕고 관객과 함께 연극을 관람할 수 있습니다.
			<</if>>
		<</if>>
	<</if>>

	<<set _foodstuffKeys to Object.keys($foodstuff)>>
	<<set _hasProduce to Object.keys($foodstuff).some(key => $foodstuff[key].amount >= 1)>>
	<<set _carrying to [$antiquemoney, $blackmoney, $phials_held, $lurkers_held, $popcorn, $milkshake, $panties_held, $prison?.teeth].some(i => i >= 1)>>
	<<if _carrying or _hasProduce>>
		<hr>
		<h1 class="header gold bold">인벤토리</h1>
	<</if>>
	<<if $livestock.lock.keys is true and $location is "farm" and !$bus.includes("farm")>>
		보관 중인 물품:
		<ul class="journal carry">
			<li><<lockicon "bronze key">> 감옥 안에 있는 <span class="green">열쇠 꾸러미</span>. 열쇠 꾸러미를 사용해 탈출할 수 있지만, 들키지 않도록 조심해야 합니다.</li>
		</ul>
		<br>
	<</if>>
	<<if _carrying or _hasProduce>>
		소지 중인 물품:
		<ul class="journal carry">
			<<if ["prison", "prison_beach"].includes($location) and $prison.teeth gte 1>>
				<li><<icon "tending/sharks-teeth.png">> 상어 이빨 <span class="green"><<number $prison.teeth>></span>개.
				<<if $prison_wren_intro isnot 1>>
					금요일 점심 식사 후 마당에서 렌을 찾을 수 있습니다.
				<</if>>
				</li>
			<</if>>
			<<if $antiquemoney gt 0>>
				<li><<museumicon>><span class="green">£<<print $antiquemoney>></span>어치 골동품. 박물관에 팔 수 있습니다.</li>
			<</if>>
			<<if $blackmoney gt 0>>
				<li><<highicon>><span class="green">£<<print $blackmoney>></span>어치 장물. 암시장에서 팔 수 있습니다.</li>
			<</if>>
			<<if $phials_held gt 0>>
				<li><<icon "aphrodisiac.png">> 최음제 <span class="green">$phials_held</span>병. 엘크 가에서 팔 수 있습니다.</li>
			<</if>>
			<<if $lurkers_held gt 0>>
				<li><<birdicon "lurkers">>럴커 <span class="green">$lurkers_held</span>마리.</li>
			<</if>>
			<<if $milkshake gt 0>>
				<li><<foodicon "milkshake">> 밀크쉐이크 <span class="green">$milkshake</span>개.</li>
			<</if>>
			<<if $popcorn gt 0>>
				<li><<foodicon "popcorn">> 팝콘 <span class="green">$popcorn</span>봉지.</li>
			<</if>>
			<<if $panties_held gt 0>>
				<li><span class="clothes-white"><<icon "clothes/plain-panties.png">></span> 훔친 속옷 <<if $panties_held is 1>>한 벌<<else>><span class='green'>$panties_held</span>벌<</if>>【을를】 가지고 있습니다. 점심시간에 학교 뒤뜰에서 팔 수 있습니다.</li>
			<</if>>
			<<if $fertiliser.current gt 0>>
				<li><<gardenicon "fertiliser">> 비료 <span class="green">$fertiliser.current</span>포대.</li>
			<</if>>
			<<if _hasProduce>>
				<li><<stallicon "open">> 판매용 <span class="green">물품</span>. 새벽에 콘누다투스 가에서 노점을 빌려 팔 수 있습니다.</li>
			<</if>>
		</ul>

		<<if _hasProduce>>
			<br>
			<details class="journal">
				<summary class="journal">물품</summary>
				<<set $_types to []>>
				<<for _t to 0; _t lt _foodstuffKeys.length; _t++>>
					<<set _foodstuff to setup.foodstuff[_foodstuffKeys[_t]]>>
					<<set _foodstuffType to ((_foodstuff?.category) === "dish" ? "food" : _foodstuff?.category)>>
					<<if _foodstuffType isnot undefined>>
						<<set $_types.pushUnique(_foodstuffType)>>
					<</if>>
				<</for>>
				<<set $_types.sort()>>
				<<if $_types.length>>
					<div style="padding: 0.25rem 0.5rem;">
						표시:
						<<set _typeLabels to {}>><<set _typeKr to {"food": "요리", "flower": "꽃", "fruit": "과일", "ingredient": "재료", "meat": "고기", "mushroom": "버섯", "produce": "농산물", "seafood": "해산물", "vegetable": "채소"}>>
						<<for _tv range $_types>>
							<<set _typeLabels[_typeKr[_tv] || _tv] to _tv>>
						<</for>>
						<<listbox "_invDisplay" autoselect>>
							<<option "전체" "all">>
							<<optionsfrom _typeLabels>>
						<</listbox>>
					</div>
				<</if>>
				<div class="itemInventory" id="journalInv">
					<<journalInventory _invDisplay>>
				</div>
				<<run jQuery(document).on("change", "#listbox--invdisplay", function (e) {
					Wikifier.wikifyEval("<<replace #journalInv>><<journalInventory " + T.invDisplay.toLowerCase() + ">><</replace>>");
				});>>
			</details>
		<</if>>
	<</if>>


	<<if Object.keys($plots).length gte 1>> /* display plot readiness */
		<hr>
		<h1 class="header gold bold">텃밭</h1>
		<<for $_plotToDisplay range ["garden", "farm", "wolf", "eden", "asylum"]>>
			<<set $_currentPlot to $plots[$_plotToDisplay]>>
			<<if $_currentPlot and $_currentPlot.filter(()=>true).length>>
				<<set $_plotsToWater to $_currentPlot.filter(plot => plot.stage >= 1 && plot.stage < 5 && plot.bed !== "water" && plot.water === 0).length>>
				<<set $_plotsToPick  to $_currentPlot.filter(plot => plot.stage >= 5 ).length>>
				<<set $_plotsEmpty   to $_currentPlot.filter(plot => !(plot.stage >= 1)).length>>
				<<set $_plotsGrowing to ($_currentPlot.length - $_plotsEmpty - $_plotsToPick - $_plotsToWater)>>
				<<set $_descriptors to [
					$_plotsEmpty  ?`<span class="gold">$_plotsEmpty곳</span>은 비어있`:``,
					$_plotsToWater?`<span class="gold">$_plotsToWater곳</span>은 말라있`:``,
					$_plotsToPick ?`<span class="gold">$_plotsToPick곳</span>은 수확 가능하`:``,
				].filter(str=>str.length)>>
				<ul class="journal">
					<li>
						<<switch $_plotToDisplay>>
							<<case "garden">> 고아원 <<if $alex_greenhouse gte 3>>온실<<else>>텃밭<</if>>에
							<<case "farm">>   알렉스의 농장에
							<<case "wolf">>   늑대 굴에
							<<case "eden">>   에덴의 오두막 근처 공터에
							<<case "asylum">> 당신의 수용소에
							<<default>> 텃밭 $_plotToDisplay에
						<</switch>>
						<<if $_currentPlot.length gt 1>>
							<<number $_currentPlot.length>>개의
							<<switch $_currentPlot[0].size>>
								<<case "small">> <span class="lblue">화단</span>이 있으며,
								<<case "medium">><span class="teal"> 텃밭</span>이 있으며,
								<<default>>      <span class="green">밭</span>이 있으며,
							<</switch>>
							<<if $_plotsGrowing == $_currentPlot.length>>
								<span class="teal">건강하게</span> 자라고 있습니다. /* rephrase to show that the plants on the plots are growing/thriwing */
							<<elseif $_plotsEmpty == $_currentPlot.length>>
								비어 있습니다.
							<<elseif $_plotsToWater == $_currentPlot.length>>
								<span class="lblue">물을 줘야</span> 합니다.
							<<elseif $_plotsToPick == $_currentPlot.length>>
								<span class="green">수확할 준비</span>가 되었습니다.
							<<else>>
								그 중 <<print $_descriptors.map((str, idx) => idx === $_descriptors.length - 1 ? (str.endsWith("하") ? str.slice(0, -1) + "합니다" : str + "습니다") : str + "고, ").join("")>>.
							<</if>>
						<<elseif $_currentPlot.length is 1>>
							<<switch $_currentPlot[0].size>>
								<<case "small">> <span class="lblue">화단</span>이 있고,
								<<case "medium">> <span class="teal">텃밭</span>이 있고,
								<<default>>       <span class="green">밭</span>이 있고,
							<</switch>>
							<<if $_plotsEmpty>>비어 있습니다<<elseif $_plotsToWater>>물을 줘야 합니다<<elseif $_plotsGrowing>>자라는 중입니다<<elseif $_plotsToPick>>수확할 준비가 되었습니다<</if>>.
						<</if>>
					</li>
				</ul>
			<</if>>
		<</for>>
	<</if>>

	<<if $museumintro is 1 or $plants_known.length gte 0>>
		<hr>
		<h1 class="header gold bold">수집품</h1>
		<<if $museumintro is 1>>
			<<museumAntiqueText>><<museumPaintingText>>
			<<if $museumAntiqueJournalHints.length gte 1 || Object.values(V.museumAntiques.paintings).includes("found")>>
				<<set _hintslist to clone($museumAntiqueJournalHints).reverse()>>
				<<if $museumAntiqueJournalHints.length gte 1>>
					윈터는 박물관에서 없어진 물품들에 대해 언급한 적이 있습니다.
				<</if>>
				<ul class="journal">
					<<for _hint range _hintslist>>
						<<if _museumAntiqueText[_hint]>>
							<<if ["found", "talk"].includes($museumAntiques.antiques[_hint])>>
								<li><<= _museumAntiqueText[_hint].name.toLowerCase()>>【을를】 윈터에게 보여줘야 합니다.</li>
							<<else>>
								<li><<print _museumAntiqueText[_hint].journal>></li>
							<</if>>
						<<else>>
							<li><span class="red">경고: 골동품 "_hint"에 대한 힌트가 없습니다. 모드가 설치된 버전에서 세이브를 가져왔습니까?</span></li>
							<<set $museumAntiqueJournalHints.delete(_hint)>>
						<</if>>
					<</for>>
					<<for $_labelP, $_valueP range $museumAntiques.paintings>>
						<<if $_valueP is "found">>
							<li><<= _museumPaintingText[$_labelP].journalName.toLowerCase()>>【을를】 윈터에게 보여줘야 합니다.</li>
						<</if>>
					<</for>>
				</ul>
				<br>
			<</if>>
			<<set $_antiquesFound to Object.values($museumAntiques.antiques).filter(status => status !== "notFound").length>>
			<<set $_paintingsFound to Object.values($museumAntiques.paintings).filter(status => status !== "notFound").length>>
			<<set $_totalFound to $_antiquesFound + $_paintingsFound>>
			<<if $_totalFound is 0>>
				아직 박물관에 줄 아이템을 하나도 찾지 못했습니다. 세상을 더 탐험하여 골동품을 발견합시다.
			<<elseif $_antiquesFound is $museumAntiques.maxCount and !$museum_paintings_intro>>
				박물관에 골동품이 <span class="gold"><<= $_antiquesFound>></span>점 있습니다.
				박물관에 줄 <span class="green">모든</span> 골동품을 찾았습니다.
			<<elseif $_totalFound is $museumAntiques.maxCount + Object.values($museumAntiques.paintings).length>>
				박물관에 <span class="gold"><<= $_antiquesFound>></span>점의 골동품과 <span class="gold"><<= $_paintingsFound>></span>점의 그림이 있습니다.
				박물관에 줄 <span class="green">모든</span> 아이템을 찾았습니다.
			<<else>>
				박물관에 기증할 골동품 <span class="gold"><<= $_antiquesFound>></span>점<<if $museum_paintings_intro>>【와과】 그림 <span class="gold"><<= $_paintingsFound>></span>점<</if>>을 찾았습니다.
				<<set _antiquesMissing to $museumAntiques.maxCount - $_antiquesFound>>
				<<set _paintingsMissing to Object.values($museumAntiques.paintings).length - $_paintingsFound>>
				<<if $_antiquesFound is $museumAntiques.maxCount>>
					골동품은 <span class="green">모두</span> 찾았지만, <span class="gold"><<= _paintingsMissing>></span>점의 그림을 발견하지 못했습니다.
				<<elseif _paintingsMissing is 0>>
					그림은 <span class="green">모두</span> 찾았지만,
						<span class="gold"><<= _antiquesMissing>></span>개의 골동품을 발견하지 못했습니다.
				<<else>>
					골동품 <span class="gold"><<= _antiquesMissing>></span>점<<if $museum_paintings_intro>>【와과】 그림 <span class="gold"><<= _paintingsMissing>></span>점<</if>>을 찾지 못했습니다.
				<</if>>
			<</if>>
			<br><br>
			<details class="journal">
				<summary class="journal">박물관 전시품</summary>
				<<if $museum_paintings_intro>>
					<span class="gold bold m-2">골동품</span>
					<br>
				<</if>>
				<div class="itemCollectible">
					<<for _labelM, _valueM range $museumAntiques.antiques>>
						<<set _antique to $museumAntiqueJournalHints.includes(_labelM) ? _museumAntiqueText[_labelM]?.journalName || _museumAntiqueText[_labelM].name.toLowerCase().toUpperFirst() : _museumAntiqueText[_labelM].name.toLowerCase().toUpperFirst()>>
						<<if $museumAntiqueJournalHints.includes(_labelM)>>
							<<switch _valueM>>
								<<case "notFound">>
									<div class="item unknown" @tooltip="_antique">
										<<icon "museum-empty.png">>
									</div>
								<<default>>
									<div class="item" @tooltip="_antique">
										<<icon _museumAntiqueText[_labelM].icon>>
									</div>
							<</switch>>
						<<else>>
							<<switch _valueM>>
								<<case "notFound">>
									<div class="item unknown" tooltip="알 수 없는 골동품.">
										<<mysteryicon>>
									</div>
								<<default>>
									<div class="item" @tooltip="_antique">
										<<icon _museumAntiqueText[_labelM].icon>>
									</div>
							<</switch>>
						<</if>>
					<</for>>
				</div>
				<<if $museum_paintings_intro>>
					<hr>
					<span class="gold bold m-2">그림</span>
					<br>
					<div class="itemPainting">
						<<for _labelP, _valueP range $museumAntiques.paintings>>
							<<set _painting to _valueP isnot "museum" ? _museumPaintingText[_labelP].journalName : _museumPaintingText[_labelP].name>>

							<<switch _valueP>>
								<<case "museum" "recovered">>
									<<if _labelP is "paintingward">>
										<<if $bleedingWardCheckpoint>>
											<<set _painting += ": 50% 들음">>
										<</if>>
									<<elseif _labelP is "paintingsnake">>
										<<set _painting to `<div style='text-align:center'>${_museumPaintingText[_labelP].name}`>>
										<<if $hcEndings.length is 0>>
											<<set _painting += "<br><span class='gold'>0/7 엔딩:</span><br><span class='black'>S|A|B|C|D|E|F</span>">>
										<<else>>
											<<set _painting += `<br><span class='gold'>${$hcEndings.length}/7 엔딩:</span><br>`>>
											<<set _painting += `<span class=${$hcEndings.includes('S') ? 'gold' : 'black'}> ${$hcEndings.includes('S') ? 'S' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('A') ? 'green' : 'black'}> ${$hcEndings.includes('A') ? 'A' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('B') ? 'teal' : 'black'}> ${$hcEndings.includes('B') ? 'B' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('C') ? 'blue' : 'black'}> ${$hcEndings.includes('C') ? 'C' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('D') ? 'purple' : 'black'}> ${$hcEndings.includes('D') ? 'D' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('E') ? 'pink' : 'black'}> ${$hcEndings.includes('E') ? 'E' : '?'}</span>,`>>
											<<set _painting += `<span class=${$hcEndings.includes('F') ? 'red' : 'black'}> ${$hcEndings.includes('F') ? 'F' : '?'}</span>`>>
										<</if>>
										<<if $hcChallengesCompleted and Object.values($hcChallengesCompleted).count("") isnot Object.values($hcChallengesCompleted).length>>
											<<set _painting += `<br><span class='blue italic'>완료한 도전과제:</span><br>`>>
											<<set _painting += `<span style="color: ${ColourUtils.interpolateMultiple(["--red", "--pink", "--purple", "--blue", "--teal", "--green", "--gold"], normalise(Object.values($hcChallengesCompleted).count("S"), Object.values($hcChallengesCompleted).length, 0))}">${Object.values($hcChallengesCompleted).count("S")}/${setup.hopelessCycleChallenges.length}</span>`>>
										<</if>>
										<<set _painting += `</div>`>>
									<</if>>
									<div class="item" @tooltip="_painting">
										<img class="icon" @src="'img/misc/prop/' + _museumPaintingText[_labelP].inlineFull" width="120" height="120">
										<<switch _labelP>>
											<<case "paintingsnake">><<set _percent to (Math.round($hcEndings.length) / 7 * 100)>>
											<<case "paintingward">><<set _percent to $bleedingWardCheckpoint ? 50 : 100>>
											<<default>><<set _percent to 100>>
										<</switch>>
										<div class="paintingProgress" @style="'--progress: ' + _percent + '%;'">
											<<if $options.images>>
												<div class="progress">
													<span class="starBar">
														<img class="active-icon-img" src="img/ui/star-gold.png">
														<img class="inactive-icon-img" src="img/ui/star-empty.png">
													</span>
												</div>
											<<else>>
												<div class="meter">
													<div class="goldbar" @style="'width:' + _percent + '%'"></div>
												</div>
											<</if>>
										</div>
									</div>
								<<case "talk">>
									<<set $_tooltipPainting to `윈터에게 ${_museumPaintingText[_labelP].journalName.toLowerCase()}에 대해 물어봐야 합니다.`>>
									<div class="item" @tooltip="$_tooltipPainting">
										<img class="icon" @src="'img/misc/prop/' + _museumPaintingText[_labelP].inlineFull" width="120" height="120">
									</div>
								<<case "notFound">>
									<div class="item" tooltip="알 수 없는 그림.">
										<img class="icon" src="img/misc/prop/curtain.png" width="120" height="120">
									</div>
								<<default>>
									<div class="item" @tooltip="_painting">
										<img class="icon" @src="'img/misc/prop/' + _museumPaintingText[_labelP].inlineRaw" width="120" height="120">
									</div>
							<</switch>>
						<</for>>
					</div>
				<</if>>
			</details>
			<br>
		<</if>>

		<<if $plants_known.length gte 0>>
			<<set _foodstuffKeys to Object.keys(setup.foodstuff)>>
			<<set _collection to 0>>
			<<for _i to 0; _i lt $plants_known.length; _i++>>
				<<if Object.keys(setup.foodstuff).includes($plants_known[_i])>>
					<<set _collection += 1>>
				<</if>>
			<</for>>
			<<set _total to 0>>
			<<for _i to 0; _i lt _foodstuffKeys.length; _i++>>
				<<if setup.foodstuff[_foodstuffKeys[_i]]?.tending?.has_seeds>>
					<<set _total += 1>>
				<</if>>
			<</for>>
			<<if _collection is 0>>
				심을 수 있는 씨앗이 없습니다. 세상을 더 탐험하여 씨앗을 발견합시다.
			<<else>>
				<span class="gold"><<= _collection>></span>종류의 식물을 키울 수 있습니다.
				<<if _collection is _total>>
					<span class="green">모든</span> 씨앗을 찾았습니다.
				<<else>>
					<<set _seedsMissing to _total - _collection>>
					<span class="gold"><<= _seedsMissing>></span>개의 씨앗을 찾지 못했습니다.
				<</if>>
			<</if>>
			<br><br>
			<details class="journal">
				<summary class="journal">씨앗</summary>
				<div class="itemCollectible">
					<<for _i to 0; _i lt _foodstuffKeys.length; _i++>>
						<<set _seedItem to setup.foodstuff[_foodstuffKeys[_i]]>>
						<<set _seedName to _seedItem?.tending?.seed_name>>
						<<set _seedPlural to _seedItem?.plural or "">>
						<<set _tooltip to _seedName ? _seedName.toUpperFirst() : (_seedPlural[0].toUpperCase() + _seedPlural.substring(1))>>
						<<set _icon to _seedItem?.icon>>
						<<if _seedItem?.tending?.has_seeds>>
							<<if $plants_known.includes(_foodstuffKeys[_i])>>
								<div class="item" @tooltip="_tooltip">
									<<icon `"tending/" + _icon`>>
								</div>
							<<else>>
								<div class="item unknown" tooltip="미확인 씨앗.">
									<<mysteryicon>>
								</div>
							<</if>>
						<</if>>
					<</for>>
				</div>
			</details>
		<</if>>
		<<if $fishing.locationsFound.length>>
			<br>
			<<set _fishingLocations to ["fishingPier", "fishingBeach", "fishingCoastPath", "fishingForestLake", "fishingMoor"]>>
			<<set _fishKeys to Object.keys(setup.fishing.lootTables.fish)>>
			<<set _fishDiscovered to _fishKeys.filter(k => $fishing.record[k]).length>>
			<<if $fishing.locationsFound.length gte _fishingLocations.length and _fishDiscovered gte _fishKeys.length>>
				<span class="green">모든</span> 낚시터와 <span class="green">모든</span> 물고기 종을 발견했으며, 총 <span class="gold"><<= numberOfFishCaught()>></span>마리의 물고기를 낚았습니다.
			<<elseif $fishing.locationsFound.length gte _fishingLocations.length>>
				<span class="green">모든</span> 낚시터를 발견했고, 물고기 종은 <span class="gold"><<= _fishKeys.length>></span>종 중 <span class="gold"><<= _fishDiscovered>></span>종을 발견했으며, 총 <span class="gold"><<= numberOfFishCaught()>></span>마리의 물고기를 낚았습니다.
			<<elseif _fishDiscovered gte _fishKeys.length>>
				낚시터는 <span class="gold"><<= _fishingLocations.length>></span>곳 중 <span class="gold"><<= $fishing.locationsFound.length>></span>곳을 발견했고, <span class="green">모든</span> 물고기 종을 발견했으며, 총 <span class="gold"><<= numberOfFishCaught()>></span>마리의 물고기를 낚았습니다.
			<<else>>
				낚시터는 <span class="gold"><<= _fishingLocations.length>></span>곳 중 <span class="gold"><<= $fishing.locationsFound.length>></span>곳을, 물고기 종은 <span class="gold"><<= _fishKeys.length>></span>종 중 <span class="gold"><<= _fishDiscovered>></span>종을 발견했으며, 총 <span class="gold"><<= numberOfFishCaught()>></span>마리의 물고기를 낚았습니다.
			<</if>>
			<br><br>
			<details class="journal">
				<summary class="journal">낚시</summary>
				<div class="itemCollectible">
					<<for _location range _fishingLocations>>
						<<if $fishing.locationsFound.includes(_location)>>
							<div class="item" @tooltip="fishingLocationDisplayName(_location)">
								<<if _location is "fishingCoastPath">>
									<<icon "cliff-dock.png">>
								<<elseif _location is "fishingForestLake">>
									<<icon "lake-rock.png">>
								<<elseif _location is "fishingMoor">>
									<<icon "moor.png">>
								<<elseif _location is "fishingBeach">>
									<<icon "beach.gif">>
								<<elseif _location is "fishingPier">>
									<<icon "mer-pier.png">>
								<</if>>
							</div>
						<<else>>
							<div class="item unknown" tooltip="알 수 없는 낚시터.">
								<<mysteryicon>>
							</div>
						<</if>>
					<</for>>
				</div>
				<<for _location range _fishingLocations>>
					<<if $fishing.locationsFound.includes(_location)>>
						<details class="journal" style="margin: .5rem 0.5rem 0;">
							<summary class="journal"><<= fishingLocationDisplayName(_location)>></summary>
							<div class="itemCollectible">
								<<set _locationFish to _fishKeys.filter(fish => setup.fishing.lootTables.fish[fish].locations[_location] > 0)>>
								<<for _fishKey range _locationFish>>
									<<set _fishName to setup.foodstuff[_fishKey].name>>
									<<if $fishing.record[_fishKey]?.foundIn.includes(_location)>>
										<div class="item" @tooltip="_fishName.toUpperFirst()">
											<<icon `"fish/" + _fishKey + ".png"`>>
										</div>
									<<else>>
										<div class="item unknown" tooltip="알 수 없는 물고기.">
											<<mysteryicon>>
										</div>
									<</if>>
								<</for>>
							</div>
						</details>
					<</if>>
				<</for>>
				<details class="journal" style="margin: .5rem;">
					<summary class="journal">기록</summary>
					<div class="fishingRecords">
						<<for _fishKey range _fishKeys>>
							<<set _fishName to setup.foodstuff[_fishKey].name>>
							<<set _fishRecord to $fishing.record[_fishKey]>>
							<<if _fishRecord and _fishRecord.numCaught gt 0>>
								<<set _fishConfig to setup.fishing.lootTables.fish[_fishKey]>>
								<<set _largestSizePercent to (_fishRecord.largest - _fishConfig.minSize) / (_fishConfig.maxSize - _fishConfig.minSize)>>
								<div class="fishingRecord">
									<div class="item" @tooltip="_fishName.toUpperFirst()">
										<<icon `"fish/" + _fishKey + ".png"`>>
									</div>
									<div>
										<span class="gold bold"><<= _fishName.toUpperFirst()>></span><br>
										포획 수: <<= _fishRecord.numCaught>><br>
										최대 크기: <<= _fishRecord.largest>>cm
										<<if _largestSizePercent gte 1>>
											<span class="journalFishingRecordStar" tooltip="최대 크기 달성!"><<iconUi "star-gold.png">></span>
										<</if>>
									</div>
								</div>
							<<else>>
								<div class="fishingRecord">
									<div class="item unknown" tooltip="알 수 없는 물고기.">
										<<mysteryicon>>
									</div>
								</div>
							<</if>>
						<</for>>
					</div>
				</details>
			</details>
		<</if>>
	<</if>>
	<br>
<</widget>>

<<widget "journalInventory">>
	<<set $_filter to _args[0] || "all">>
	<<for _t to 0; _t lt _foodstuffKeys.length; _t++>>
		<<set _foodstuffKey to _foodstuffKeys[_t]>>
		<<set _foodstuff to setup.foodstuff[_foodstuffKey]>>
		<<set _item to $foodstuff[_foodstuffKey]>>
		<<set _foodstuffType to ((_foodstuff?.category) === "dish" ? "food" : _foodstuff?.category)>>
		<<if _item?.amount gte 1>>
			<<if $_filter is "all" or _foodstuffType is $_filter>>
				<<set _formatter = new Intl.NumberFormat('en-gb', { roundingMode: 'trunc', notation: 'compact' })>>
				<<set _amount = _formatter.format(_item.amount)>>
				<<if _item.amount === 1>>
					<<set _itemName to _foodstuff.singular>>
				<<else>>
					<<set _itemName to _foodstuff.plural>>
				<</if>>
				<<set _tooltip to `${_itemName} <span class="green">${_item.amount}${_foodstuff.counter || "개"}</span>`>>

				<div class="item" @tooltip="_tooltip">
					<<foodstufficon _foodstuffKey>>
					<hr>
					<<= _amount>>
				</div>
			<</if>>
		<</if>>
	<</for>>
<</widget>>

<<widget "journalNotes">>
	<<if $journalNotes is undefined>>
		<<set $journalNotes to {"default":""}>>
		<<set $options.notesAutoSave to true>>
		<<set _currentPage to "default">>
	<</if>>
	<<if !_currentPage>><<set _currentPage to "default">><</if>>
	<<set _listPageName to _currentPage>>
	<<foldout false "_journalFoldout">>
		<span>기타</span>
		페이지:
		<<listbox "_listPageName" autoselect>>
			<<optionsfrom Object.keys($journalNotes)>>
		<</listbox>>
		<<link "로드">>
			<<journalNotesTextareaSave>>
			<<set _currentPage to _listPageName>>
			<<replace "#journalNotesTextarea">><<journalNotesTextarea>><</replace>>
		<</link>> |
		<<link "삭제">>
			<<if _listPageName is "default">>
				<<set $journalNotes.default to "">>
			<<else>>
				<<run delete $journalNotes[_listPageName]>>
			<</if>>
			<<if !$journalNotes[_currentPage]>><<set _currentPage to "default">><</if>>
			<<replace "#customOverlayContent">><<journalNotes>><</replace>>
		<</link>> |
		<<if $debug is 1>>
			<<link "디버그: 코드 실행 <<=($options.enableJournalDebugTwee ? '비활성화' : '활성화')>>">>
				<<if $options.enableJournalDebugTwee>>
					<<set delete $options.enableJournalDebugTwee>>
				<<else>>
					<<set $options.enableJournalDebugTwee to true>>
				<</if>>
				<<replace "#customOverlayContent">><<journalNotes>><</replace>>
			<</link>>
			<mouse class="tooltip linkBlue">(?)<span>
				일지 노트를 Twee 코드로 실행할 수 있게 합니다.
			</span></mouse> |
		<</if>>
		<br><br>

		새 페이지 이름: <<textbox "_pageName" "">>
		<<link "새 페이지">>
			<<journalNotesTextareaSave>>
			<<set _newName to journalNotesReplacer(_pageName).slice(0,20)>>
			<<if $journalNotes[_newName] is undefined>>
				<<set $journalNotes[_newName] to "">>
				<<set _currentPage to _newName>>
				<<replace "#customOverlayContent">><<journalNotes>><</replace>>
			<<else>>
				<<replace "#journalNotesMessage">><span class="red">고유한 이름이 필요합니다.</span><</replace>>
			<</if>>
		<</link>>
		<mouse class="tooltip linkBlue">(?)<span>
			페이지 이름은 A-Z, 숫자, 밑줄(_), 대시(-), 공백만 포함할 수 있습니다.
		</span></mouse>
		<div id="journalNotesMessage"></div>
	<</foldout>>
	<br>
	<div id="journalNotesTextarea"><<journalNotesTextarea>></div>
<</widget>>

<<widget "journalNotesTextarea">>
	<<if $options.enableJournalDebugTwee and $debug is 1>>
		<div class="settingsToggleItemWide">
			<<foldout true "_journalDebugTweeFoldout">>
				<span style="font-size:large">출력</span>
				<span id='journalDebugTweeOutput'>@@color:red;wiki&lpar;&rpar;는 아래의 텍스트 영역에서 Twee 코드를 실행합니다.@@<br></span>
			<</foldout>>
			<hr>
			<<button "@@color:red;.wiki&lpar;'_currentPage'&rpar;@@">>
				<<journalNotesTextareaSave>>
				<<replace "#journalDebugTweeOutput">><<script>>$(output).wiki(T.displayedTextArea);<</script>><</replace>>
				<<replace "#journalDebugTweeCopyButton">>
					<<button '클립보드에 복사'>>
						<<run _txt = $('#journalDebugTweeOutput')[0].innerHTML>>
						<<run navigator.clipboard.writeText(_txt.replaceAll('<br>','\n'))>>
					<</button>>
					<<button [[패시지 다시 불러오기|$passage]]>><<set $cheatReload to true>><</button>>
				<</replace>>
			<</button>>
			<span id='journalDebugTweeCopyButton'></span>
		</div>
		<br>
	<</if>>
	<<button `'<span class="fa-icon fa-save"></span> 저장 (' + _currentPage + ')'`>>
		<<journalNotesTextareaSave>>
	<</button>>
	<label><<checkbox "$options.notesAutoSave" false true autocheck>> 자동 저장</label>
	<mouse class="tooltip linkBlue">(?)<span>
		<div>오버레이를 닫거나 탭을 변경하면 노트가 저장됩니다. 글자 수는 페이지당 3000자로 제한됩니다.</div>
		<div class="red">오래된 세이브 파일을 불러오면 최근 변경 사항이 반영되지 않습니다. 과도한 사용은 세이브 파일 크기를 비대하게 만듭니다.</div>
	</span></mouse>
	<<textarea "_displayedTextArea" `LZString.decompress($journalNotes[_currentPage])`>>

	<<run $(() => {
		var notesTimer = null;
		$('#textarea--displayedtextarea').on('input change', e => {
			if (notesTimer) clearTimeout(notesTimer);
			if (V.options.notesAutoSave) notesTimer = setTimeout(saveText, 1000);
		});
		$('#textarea--displayedtextarea').attr('maxlength','3000');
		var saveText = () => {
			new Wikifier (null, "<<journalNotesTextareaSave>>");
		}
	})>>
<</widget>>

<<widget "journalNotesTextareaSave">>
	<<set _noteElement to jQuery('#textarea--displayedtextarea')[0]>>
	<<if _noteElement and _noteElement.value>>
		<<set $journalNotes[_currentPage] to LZString.compress(_noteElement.value)>>
		/* put notes into save data immediately without the need to change passage */
		<<run State.history[State.activeIndex].variables.journalNotes = clone(V.journalNotes)>>
	<</if>>
<</widget>>

<<widget "nDays">><<silently>>
	<<switch _args[0]>>
		<<case 0>><<set $_text_output to '<span class="gold">오늘</span>'>>
		<<case 1>><<set $_text_output to '<span class="gold">내일</span>'>>
		<<default>><<set $_text_output to '<span class="gold"><<= _args[0]>></span>일 뒤'>>
	<</switch>>
<</silently>><<print $_text_output>><</widget>>
