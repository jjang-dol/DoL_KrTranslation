:: Statistics [widget]
<<widget "statistics">>
	<<foldout false "_virginitiesFoldout">>
		<span class="gold">첫 경험</span>
		<<run ["vaginal", "penile", "anal", "oral", "handholding", "kiss"].forEach(type => {
			if ($player.virginity[type] is true) {
				T[type + "VirginityColour"] = "gold";
			} else if (isPossibleLoveInterestVirginity($player.virginity[type])) {
				T[type + "VirginityColour"] = "lewd";
				if ($player.virginityDetails and $player.virginityDetails?.[type]?.consensual is false) T[type + "VirginityColour"] = "red";
			} else if ($player.virginityDetails and $player.virginityDetails?.[type]?.consensual isnot undefined) {
				T[type + "VirginityColour"] = $player.virginityDetails?.[type]?.consensual ? "green" : "red";
			} else {
				T[type + "VirginityColour"] = "";
			}
		})>>
		<<if $player.vaginaExist or $player.virginity.vaginal isnot true>>
			질 첫 경험: <span @class="_vaginalVirginityColour"><<print ($player.virginity.vaginal is true ? "없음" : ($player.virginity.vaginal is false ? "알 수 없는 이" : window.KR.getDescriptionKr($player.virginity.vaginal)) + "【이가】 " + ($player.virginityDetails?.vaginal?.consensual is false ? "빼앗김" : "가져감"))>></span>
			<<virginityToolTip $player.virginityDetails.vaginal $player.virginity.vaginal "pc" "vaginal">>
			<br>
		<</if>>
		<<if $player.penisExist or $player.virginity.penile isnot true>>
			자지 동정: <span @class="_penileVirginityColour"><<print ($player.virginity.penile is true ? "없음" : ($player.virginity.penile is false ? "알 수 없는 이" : window.KR.getDescriptionKr($player.virginity.penile)) + "【이가】 " + ($player.virginityDetails?.penile?.consensual is false ? "빼앗김" : "가져감"))>></span>
			<<virginityToolTip $player.virginityDetails.penile $player.virginity.penile "pc" "penile">>
			<br>
		<</if>>

		항문 첫 경험: <span @class="_analVirginityColour"><<print ($player.virginity.anal is true ? "없음" : ($player.virginity.anal is false ? "알 수 없는 이" : window.KR.getDescriptionKr($player.virginity.anal)) + "【이가】 " + ($player.virginityDetails?.anal?.consensual is false ? "빼앗김" : "가져감"))>></span>
		<<virginityToolTip $player.virginityDetails.anal $player.virginity.anal "pc" "penile">>
		<br>
		입 첫 경험: <span @class="_oralVirginityColour"><<print ($player.virginity.oral is true ? "없음" : ($player.virginity.oral is false ? "알 수 없는 이" : window.KR.getDescriptionKr($player.virginity.oral)) + "【이가】 " + ($player.virginityDetails?.oral?.consensual is false ? "빼앗김" : "가져감"))>></span>
		<<virginityToolTip $player.virginityDetails.oral $player.virginity.oral "pc" "oral">>
		<br>
		첫 손잡기: <span @class="_handholdingVirginityColour"><<print ($player.virginity.handholding is true ? "없음" : ($player.virginity.handholding is false ? "알 수 없는 이" : window.KR.getDescriptionKr($player.virginity.handholding)) + "【이가】 " + ($player.virginityDetails?.handholding?.consensual is false ? "빼앗김" : "가져감"))>></span>
		<<virginityToolTip $player.virginityDetails.handholding $player.virginity.handholding "pc" "handholding">>
		<br>
		첫 키스: <span @class="_kissVirginityColour"><<print ($player.virginity.kiss is true ? "없음" : ($player.virginity.kiss is false ? "알 수 없는 이" : window.KR.getDescriptionKr($player.virginity.kiss)) + "【이가】 " + ($player.virginityDetails?.kiss?.consensual is false ? "빼앗김" : "가져감"))>></span>
		<<virginityToolTip $player.virginityDetails.kiss $player.virginity.kiss "pc" "kiss">>
		<br>
		<<if $temple_rank isnot undefined and $temple_rank isnot "prospective">>
			신전의 맹세: <<print ($player.virginity.temple is true ? "깨지지 않음" : ($player.virginity.temple is false ? "알 수 없는 이에게 깨짐" : window.KR.getDescriptionKr($player.virginity.temple) + "에게 깨짐"))>>
			<br>
		<</if>>
		<br>
	<</foldout>>

	<<foldout false "_virginitiesTakenFoldout">>
		<span class="gold">빼앗은 첫 경험</span>
		총계: <<print Object.values(V.virginTaken).flat().length>>
		<br>

		<!-- For each individual virginity type, the number is named and unnamed combined, but the list of names has unnamed npcs filtered out. -->
		<<run ["vaginal", "penile", "anal", "oral", "handholding", "kiss"].forEach((virginity) => {
			const virginityNamed = `${virginity}Named`;
			T[virginityNamed] = []; /* _vaginalNamed, _penileNamed, ... */
			for (const name of V.virginTaken[virginity]) {
				if (!V.NPCNameList.includes(name)) continue;
				const details = C.npc[name].virginityDetails?.[virginity];
				let colour = '';
				if (setup.loveInterestNpc.includes(name) && (!details || details.consensual !== false)) {
					colour = "lewd";
				} else if (details && details.consensual != null) {
					colour = details.consensual ? "green" : "red";
				}
				const nameText = `<span class="${colour}">${window.KR.gatPersonNameDictKR(name)}</span>`;
				const detailsArg = details
					? `\`C.npc['${name}'].virginityDetails.${virginity}\``
					: '';
				T[virginityNamed].push(`${nameText}<<virginityToolTip ${detailsArg} "${name}" "npc" ${virginity}>>`);
			}
		})>>

		보지: $virginTaken.vaginal.length명<<print (_vaginalNamed.length gte 1 ? " (" + _vaginalNamed.join(', ') + " 포함)" : "")>>
		<br>
		자지: $virginTaken.penile.length명<<print (_penileNamed.length gte 1 ? " (" + _penileNamed.join(', ') + " 포함)" : "")>>
		<br>
		항문: $virginTaken.anal.length명<<print (_analNamed.length gte 1 ? " (" + _analNamed.join(', ') + " 포함)" : "")>>
		<br>
		입: $virginTaken.oral.length명<<print (_oralNamed.length gte 1 ? " (" + _oralNamed.join(', ') + " 포함)" : "")>>
		<br>
		첫 손잡기: $virginTaken.handholding.length명<<print (_handholdingNamed.length gte 1 ? " (" + _handholdingNamed.join(', ') + " 포함)" : "")>>
		<br>
		첫 키스: $virginTaken.kiss.length명<<print (_kissNamed.length gte 1 ? " (" + _kissNamed.join(', ') + " 포함)" : "")>>
		<br><br>
	<</foldout>>

	<<foldout false "_jobsFoldout">>
		<span class="gold">일</span>
		춤춘 횟수: $dancestat
		<br>
		음료 서빙 횟수: $drinksservedstat
		<br>
		테이블 서빙 횟수: $tablesservedstat
		<br>
		몸을 판 횟수: $prostitutionstat
		<br>
		<<if $gamemode isnot "soft">>
			강제로 팔린 횟수: $forcedprostitutionstat
			<br>
		<</if>>
		<<if statChange.timeTrackingTotal("docks")>>
			부두에서 일한 시간: <<print statChange.timeTrackingTotal("docks")>>
			<br>
		<</if>>
		빵 판매 횟수: $bunstat
		<br>
		최대 생산 "크림": <<print parseFloat($creamstat.toFixed(1))>> mL
		<br>
		밀수업자 저지 횟수: $smuggler_stolen_stat
		<br>
		펍 작업 횟수: $pub_task_stat
		<br>
		수확물 판매: $produce_sold
		<br>
		<<if $farmersProduce>>
			수확물 대량 판매: $farmersProduce.totalSold
			<br>
		<</if>>
		비료 사용량: $fertiliser.used
		<br>
		농장 노동 시간: <<print Math.trunc($farm_shift / 60)>>
		<br>
		소젖을 짠 횟수: $cattle_milked
		<br>
		안마 접대 손님: $masseur_stat
		<br>
		야생 식물 채집 횟수: $wild_plant_stat
		<br>
		최음제 판매 횟수: $stat_aphrodisiacs_sold
		<br>
		<<if $brothelVending and $brothelVending.total>>
			창관 상품 판매 횟수: $brothelVending.total
			<br>
		<</if>>
		<<if $confessionsDone>>
			고해성사 횟수: $confessionsDone
			<br>
		<</if>>
		<<if $confessionsTaken>>
			고해성사 청취 횟수: $confessionsTaken
			<br>
		<</if>>
		<br>
	<</foldout>>

	<<foldout false "_sexFoldout">>
		<span class="gold">섹스</span>
		절정 횟수: $orgasmstat
		<br>
		마지막 절정: <<statisticsTimeCompare $orgasmTimeStat>>
		<br>
		<<if $ruinedOrgasmStat>>
			망가진 절정 횟수: $ruinedOrgasmStat
			<br>
			마지막 망가진 절정: <<statisticsTimeCompare $ruinedOrgasmTimeStat>>
			<br>
		<</if>>
		<<if $settings.asphyxiaLevel gte 2>>
			질식 절정: $chokeorgasm
			<br>
		<</if>>
		<<if $player.penisExist or $penilestat>>
			관통 횟수: $penilestat
			<br>
			마지막 관통: <<statisticsTimeCompare $penileTimeStat>>
			<br>
		<</if>>
		<<if $straponstat>>
			밴드로 관통한 횟수: $straponstat
			<br>
		<</if>>
		<<if $player.penisExist or $penileejacstat>>
			남에게 사정한 횟수: $penileejacstat
			<br>
			마지막 사정: <<statisticsTimeCompare $penileEjacTimeStat>>
			<br>
		<</if>>
		<<if $player.vaginaExist>>
			보지 삽입 횟수: $vaginalstat
			<br>
			마지막 보지 삽입: <<statisticsTimeCompare $vaginalTimeStat>>
			<br>
			보지 안 사정 횟수: $vaginalejacstat
			<br>
			마지막 보지 내 사정: <<statisticsTimeCompare $vaginalEjacTimeStat>>
			<br>
		<</if>>
		<<if $settings.analEnabled>>
			항문 삽입 횟수: $analstat
			<br>
			마지막 항문 삽입: <<statisticsTimeCompare $analTimeStat>>
			<br>
			항문 안 사정 횟수: $analejacstat
			<br>
			마지막 항문 내 사정: <<statisticsTimeCompare $analEjacTimeStat>>
			<br>
		<</if>>
		입 삽입 횟수: $oralstat
		<br>
		입 안 사정 횟수: $oralejacstat
		<br>
		<<if $cunnilingusstat>>
			커닐링구스: $cunnilingusstat
			<br>
		<</if>>
		<<if $cunnilingusejacstat>>
			커닐링구스 사정: $cunnilingusejacstat
			<br>
		<</if>>
		삼킨 정액: <<print Math.floor($semenswallowedstat)>> mL
		<<if $settings.bestialityEnabled>>
			<br>
			삼킨 동물 정액: <<print Math.floor($animalsemenswallowedstat)>> mL
		<</if>>
		<br>
		핸드잡 횟수: $handstat
		<br>
		핸드잡 중 사정: $handejacstat
		<br>
		<<if $settings.footFetishEnabled>>
			풋잡 횟수: $feetstat
			<br>
			풋잡 중 사정: $feetejacstat
			<br>
		<</if>>
		마사지 횟수: $thighstat
		<br>
		마사지중 사정: $thighejacstat
		<br>
		파이즈리 횟수: $cheststat
		<br>
		파이즈리 중 사정: $chestejacstat
		<br>
		스마타 횟수: $bottomstat
		<br>
		스마타 중 사정: $bottomejacstat
		<br>
		머리카락에 사정 횟수: $hairejacstat
		<br>
		배에 사정 횟수: $tummyejacstat
		<br>
		목에 사정 횟수: $neckejacstat
		<br>
		<<if $player.vaginaExist>>
			보지에 사정 횟수: $vaginalentranceejacstat
			<br>
		<</if>>
		얼굴에 사정 횟수: $faceejacstat
		<br>
		몸 위/안 사정 총 횟수: $ejacstat
		<br>
		봉사한 글로리홀: $gloryholestat
		<br>
		자위 횟수: $masturbationstat
		<br>
		마지막 자위: <<statisticsTimeCompare $masturbationTimeStat>>
		<br>
		자위 절정 횟수: $masturbationorgasmstat
		<br>
		마지막 자위 절정: <<statisticsTimeCompare $masturbationOrgasmTimeStat>>
		<br>
		자위 시간(분): <<print Math.trunc($secondsSpentMasturbating / 60)>>
		<br>
		<<if $settings.breastFeedingEnabled>>
			마신 모유: <<print Math.floor($milk_drank_stat)>> mL
			<br>
			모유 생산량: <<print Math.floor($milk_produced_stat)>> mL
			<br>
		<</if>>
		<<if $settings.plantsEnabled>>
			넥타르 섭취량: <<print Math.floor($nectar_drank_stat)>> mL
			<br>
		<</if>>
		<<if $player.penisExist or $semen_produced_stat>>
			정액 생산량: <<print Math.floor($semen_produced_stat)>> mL
			<br>
		<</if>>
		<<if $player.vaginaExist>>
			야한 체액 생산량: <<print Math.floor($lube_produced_stat)>> mL
			<br>
		<</if>>
		<<if $player.penisExist or $settings.breastFeedingEnabled or $fluid_forced_stat>>
			강제 착유 체액: <<print Math.floor($fluid_forced_stat)>> mL
			<br>
		<</if>>
		<<if $knot_stat isnot undefined>>
			노팅: $knot_stat
			<br>
		<</if>>
		<<if $sextoystat isnot undefined>>
			타인에게 사용한 섹스 토이: $sextoystat
		<</if>>
		<br>
		<<if $settings.analDoubleEnabled and $analdoublestat isnot undefined>>
			항문 이중 삽입 횟수: $analdoublestat
			<br>
		<</if>>
		<<if $settings.vaginalDoubleEnabled and $vaginaldoublestat isnot undefined>>
			보지 이중 삽입 횟수: $vaginaldoublestat
			<br>
		<</if>>
		<<if $settings.watersportsEnabled>>
			오줌 맞은 횟수: $urinestat
			<br>
		<</if>>
		<br>
	<</foldout>>

	<<if $gamemode isnot "soft">>
		<<foldout false "_violenceFoldout">>
			<span class="gold">폭력</span>
			추행: $moleststat
			<br>
			마지막 추행: <<statisticsTimeCompare $molestTimeStat>>
			<br>
			강간: $rapestat
			<br>
			마지막 강간: <<statisticsTimeCompare $rapeTimeStat>>
			<br>
			<<if $settings.bestialityEnabled>>
				동물에게 강간: $beastrapestat
				<br>
			<<else>>
				몬스터 인물에게 강간: $beastrapestat
				<br>
			<</if>>
			<<if $settings.tentaclesEnabled>>
				촉수 몬스터에게 강간: $tentaclerapestat
				<br>
			<</if>>
			<<if $settings.voreEnabled>>
				삼켜짐: $swallowedstat
				<br>
			<</if>>
			<<if $settings.parasitesEnabled>>
				숙주가 된 기생충: $parasitestat
				<br>
			<</if>>
			맞음: $hitstat
			<br>
			때림: $attackstat
			<br>
			페퍼 스프레이 사용: $spraystat
			<br>
			<<if C.npc.Eden.init>>
				에덴과 연습 사격: $stat_shoot
				<br>
			<</if>>
			작동을 멈춘 기계: $machine_stat
			<br>
			<<if $settings.lurkersEnabled>>
				포획한 럴커: $stat_lurkers_captured
				<br><br>
			<</if>>
		<</foldout>>
	<</if>>

	<<foldout false "_datesFoldout">>
		<span class="gold">데이트</span>
		<<if $dateCount.Total lte 0>>
			데이트를 한 적이 없습니다!<br>
		<<else>>
			총 데이트: $dateCount.Total
			<br>
			<<if $dateCount.Robin gte 1>>
				로빈과 데이트: $dateCount.Robin
				<br>
			<</if>>
			<<if $dateCount.Whitney gte 1>>
				휘트니와 데이트: $dateCount.Whitney
				<br>
			<</if>>
			<<if $dateCount.Kylar gte 1>>
				카일라와 데이트: $dateCount.Kylar
				<br>
			<</if>>
			<<if $dateCount.Eden gte 1>>
				에덴과 데이트: $dateCount.Eden
				<br>
			<</if>>
			<<if $dateCount.Avery gte 1>>
				에이버리와 데이트: $dateCount.Avery
				<br>
			<</if>>
			<<if $dateCount.BlackWolfHunts gte 1>>
				검은 늑대와 사냥: $dateCount.BlackWolfHunts
				<br>
			<</if>>
			<<if $dateCount.GreatHawkHunts gte 1>>
				거대 매와 사냥: $dateCount.GreatHawkHunts
				<br>
			<</if>>
			<<if $dateCount.GreatHawkCasual gte 1>>
				거대 매와 평범한 비행: $dateCount.GreatHawkCasual
				<br>
			<</if>>
			<<if $dateCount.Alex gte 1>>
				알렉스와 데이트: $dateCount.Alex
				<br>
			<</if>>
			<<if $dateCount.Sydney gte 1>>
				시드니와 데이트: $dateCount.Sydney
				<br>
			<</if>>
			<<if $dateCount.Gwylan gte 1>>
				그윌란과 데이트: $dateCount.Gwylan
				<br>
			<</if>>
			<<if $dateCount.GwylanSex gte 1>>
				그윌란과 친밀한 의식: $dateCount.GwylanSex
				<br>
			<</if>>
		<</if>>
		<br>
	<</foldout>>

	<<foldout false "_pregnancyFoldout">>
		<span class="gold">임신</span>
		출산 횟수: <<print playerNormalPregnancyTotal()>>
		<br>
		<<if $pregnancyStats.playerVirginBirths.length>>
			처녀 출산 총합: <<print $pregnancyStats.playerVirginBirths.length>>
			<br>
		<</if>>
		낳은 아이 총합: <<print $pregnancyStats.playerChildren>>
		<br>
		아빠 확인된 아이 총합: <<print $pregnancyStats.npcChildren>>
		<br>
		임신 인지 일수: <<print Math.floor($pregnancyStats.totalDaysPregnancyKnown)>>
		<br>
		인간 아이 총합: <<print $pregnancyStats.humanChildren>>
		<br>
		늑대 아이 총합: <<print $pregnancyStats.wolfChildren>>
		<br>
		매 아이 총합: <<print $pregnancyStats.hawkChildren>>
		<br>
		아이와 상호작용: <<print $pregnancyStats.childInteractions>>
		<br>
		<!-- ToDo: Pregnancy - Move outside of commented area when interactions are added
		Breastfed interactions: <<print $pregnancyStats.childBreastfedInteractions>>
		<br>
		Bottlefed interactions: <<print $pregnancyStats.childBottlefedInteractions>>
		<br>
		First Word interaction: <<print $pregnancyStats.childFirstWordInteractions>>
		<br>
		-->
		고아원 기증 우유병: <<print $pregnancyStats.orphanageMilkBottlesTotal>>
		<br>
		사후피임약 복용: <<print $pregnancyStats.aftermorningpills>>
		<br>
		임신 테스트기 사용: <<print $pregnancyStats.pregnancyTestsTaken>>
		<br>
		<<if $player.vaginaExist>>
			질 기생충 출산: <<print $sexStats.vagina.pregnancy.parasiteBirthEvents>>
			<br>
		<</if>>
		항문 기생충 출산: <<print $sexStats.anus.pregnancy.parasiteBirthEvents>>
		<br><br>
	<</foldout>>

	<<foldout false "_gamblingFoldout">>
		<span class="gold">도박</span>
		블랙잭 판 수: $estatePersistent.totalGamesPlayed
		<br>
		베팅 블랙잭 판 수: $estatePersistent.totalGamesPlayedWithBetting
		<br>
		블랙잭 승리/패배/무승부 판 수: $estatePersistent.totalRoundsWon/$estatePersistent.totalRoundsLost/$estatePersistent.totalRoundsTied
		<br>
		블랙잭 승리/패배/무승부 판 수 (베팅 포함): $estatePersistent.totalBetRoundsWon/$estatePersistent.totalBetRoundsLost/$estatePersistent.totalBetRoundsTied
		<br>
		블랙잭 수익: <<printmoney $estatePersistent.totalBetMoneyMade>>
		<br>
		블랙잭 손실: <<printmoney $estatePersistent.totalBetMoneyLost>>
		<br>
		블랙잭 압수 금액: <<printmoney $estatePersistent.totalMoneyConfiscated>>
		<br>
		블랙잭 팁: <<printmoney $estatePersistent.totalTipMoneyMade>>
		<br>
		속임수 발각 횟수: $estatePersistent.totalCaughtCheating
		<br>
		블랙잭 최고 연승: $estatePersistent.winStreakHighScore
		<<if $blackjack_played gt 0 or $blackjack_won gt 0>>
			<br>
			예전 블랙잭 플레이/승리 횟수: $blackjack_played/$blackjack_won
		<</if>>
		<<if $blackjack_streak_high and $blackjack_streak_high gt 0>>
			<br>
			예전 블랙잭 최고 연승: $blackjack_streak_high
		<</if>>
		<br><br>
	<</foldout>>

	<<foldout false "_detailedTablesFoldout">>
		<span class="gold">상세 통계</span>
		<span id="moneyButton" @class="_openedTable is 'money' ? 'gold': ''">
			<<button "돈">>
				<<set _openedTable to "money">>
				<<replace "#detailedStatsDiv">><<statisticsDetailedTables>><</replace>>
				<<addclass "#moneyButton" "gold">>
				<<removeclass "#produceButton" "gold">>
				<<removeclass "#badEndsButton" "gold">>
			<</button>>
		</span>
		<span id="produceButton" @class="_openedTable is 'produce' ? 'gold': ''">
			<<button "생산물">>
				<<set _openedTable to "produce">>
				<<replace "#detailedStatsDiv">><<statisticsDetailedTables>><</replace>>
				<<removeclass "#moneyButton" "gold">>
				<<addclass "#produceButton" "gold">>
				<<removeclass "#badEndsButton" "gold">>
			<</button>>
		</span>
		<span id="badEndsButton" @class="_openedTable is 'badEnd' ? 'gold': ''">
			<<if $badEndStats.length>>
				<<button "배드 엔딩">>
					<<set _openedTable to "badEnd">>
					<<replace "#detailedStatsDiv">><<statisticsDetailedTables>><</replace>>
					<<removeclass "#moneyButton" "gold">>
					<<removeclass "#produceButton" "gold">>
					<<addclass "#badEndsButton" "gold">>
				<</button>>
			<</if>>
		</span>

		<div id="detailedStatsDiv"><<statisticsDetailedTables>></div>
	<</foldout>>

	<<foldout false "_miscFoldout">>
		<span class="gold">기타</span>
		<<if $gamemode isnot "soft">>
			구조됨: $rescued
			<br>
		<</if>>
		옷이 벗겨짐: $clothesstripstat
		<br>
		옷이 망가짐: $clothesruinstat
		<br>
		기절함: $passoutstat
		<br>
		마지막 기절: <<statisticsTimeCompare $passoutTimeStat>>
		<br>
		상장 수: $distinction_stat
		<br>
		수면 시간: $sleepStat
		<br>
		속옷 도난 수: $stat_panties_stolen
		<br>
		사회 봉사 선고: $stat_police.community
		<br>
		형틀 선고: $stat_police.pillory
		<br>
		수감 일수: $stat_police.prison
		<br>
		최면: $hypnotised
		<<if $wraith.possessCount>>
			<br>
			빙의 횟수: $wraith.possessCount
		<</if>>
		<br>
		총 결석 수업: <<print Object.values($schoolLessonsMissed).reduce((x, y) => x + y)>>
		<mouse class="tooltip linkBlue">(?)<span>이전 버전 게임의 오류로 인해 '0.4.0.0' 버전 이전의 통계는 부정확할 수 있습니다</span></mouse>
		<br>
		과학 결석 수: $schoolLessonsMissed.science
		<br>
		수학 결석 수: $schoolLessonsMissed.maths
		<br>
		가사 결석 수: $schoolLessonsMissed.housekeeping
		<br>
		영어 결석 수: $schoolLessonsMissed.english
		<br>
		역사 결석 수: $schoolLessonsMissed.history
		<br>
		수영 결석 수: $schoolLessonsMissed.swimming
		<br>
		<<if $earSlimeDaysStat>>
			귀 슬라임 동거일: $earSlimeDaysStat
			<br>
		<</if>>
		<<if $earSlime.days>>
			현재 슬라임 동거일: $earSlime.days
			<br>
		<</if>>
		<<if $earSlimePassiveDaysStat>>
			수동 슬라임 최장 동거일: $earSlimePassiveDaysStat
			<br>
		<</if>>
		<<if $whitney_smoke gte 1>>
			흡연 횟수: $whitney_smoke
			<br>
		<</if>>
		<<if $bird and $bird.lurkersEaten>>
			럴커 섭취 수: $bird.lurkersEaten
			<br>
		<</if>>
		<<if $gwylan?.requestCount>>
			그윌란 의뢰 완료 수: $gwylan.requestCount
			<br>
		<</if>>
		<<if $world_corruption_reduced and ($temple_confessor_intro or $gwylanSeen?.includes("ritual_beast"))>>
			세계 타락 정화 총합: $world_corruption_reduced
			<br>
		<</if>>
		베일리 지불 총액: <<printmoney `$moneyStats.baileyRent?.spent or 0`>>
		<mouse class="tooltip linkBlue">(?)<span>'0.4.5.X' 및 이전 버전에서는 추적되지 않음</span></mouse>
		<br>
		<<if $baileyRefusedToPayTotal>>
			베일리 미지불 총액: <<printmoney $baileyRefusedToPayTotalStat "red">>
			<mouse class="tooltip linkBlue">(?)<span>'0.4.5.X' 및 이전 버전에서는 추적되지 않음</span></mouse>
			<br>
		<</if>>
		<br>
	<</foldout>>


	<<foldout false "_saveFoldout">>
		<span class="gold">세이브 상세 정보</span>
		<<if $passageCount>>
			총 패시지 로드 수: $passageCount
			<mouse class="tooltip linkBlue">(?)<span>새 패시지가 로드된 총 횟수 (대부분의 경우 링크 클릭 시). 설정 등 일부 패시지는 제외됩니다. '0.3.12.X' 및 이전 버전에서는 추적되지 않음</span></mouse>
			<br>
		<</if>>
		<<if $passageChangesCount>>
			총 패시지 변경 수: $passageChangesCount
			<mouse class="tooltip linkBlue">(?)<span>새 패시지로 이동한 총 횟수 (대부분의 경우 링크 클릭 시). 설정 등 일부 패시지는 제외됩니다. '0.3.12.X' 및 이전 버전에서는 추적되지 않음</span></mouse>
			<br>
		<</if>>
		<<if $saveDetails isnot undefined>>
			일반 세이브 수: <<print $saveDetails.slot.count>>
			<br>
			내보낸 세이브 수: <<print $saveDetails.exported.count>>
			<br>
			자동 저장 횟수: <<print $saveDetails.auto.count>>
			<br>
			로드 횟수: <<print $saveDetails.loadCount || 0>>
			<mouse class="tooltip linkBlue">(?)<span>세이브가 로드된 총 횟수, 동일 세이브의 반복적인 로드는 추적하지 않습니다. '0.3.12.X' 및 이전 버전에서는 추적되지 않음</span></mouse>
			<br>
			플레이 시간: <<print msToTime(($saveDetails.playTime ? $saveDetails.playTime : 0) + ($saveDetails.loadTime ? new Date() - $saveDetails.loadTime : 0))>>
			<mouse class="tooltip linkBlue">(?)<span>'h:mm:ss' 형식입니다. 게임을 장시간 켜둔 후 저장하면 그 시간도 기록되니 주의하세요. 이를 피하려면 플레이를 마치기 전 저장하고, 다시 시작할 때 로드하세요. '0.3.13.X' 및 이전 버전에서는 추적되지 않음</span></mouse>
			<br>
		<</if>>
		<<if $saveVersions isnot undefined>>
			플레이한 버전:
			<br>
			<<for _i to 0; _i lt $saveVersions.length; _i++>>
				<<if _i gt 0>>
					<<if $saveVersions[_i].split(".")[2] is $saveVersions[_i - 1].split(".")[2]>>
						--
					<<else>>
						<br>
					<</if>>
				<</if>>
				$saveVersions[_i]
			<</for>>
			<br>
		<</if>>
		<<if $saveVersion>>
			불러온 세이브 버전: $saveVersion
		<</if>>
	<</foldout>>
<</widget>>

<<widget "extraStatisticsWarning">>
	<<if $options.skipStatisticsConfirmation is undefined>><<set $options.skipStatisticsConfirmation to false>><</if>>

	<h3>추가 통계</h3>

	<div id="spoilerWarning">
		정말 확인하시겠습니까? 스포일러가 포함되어 있을 수 있습니다!
		<br>
		<<link "예">>
			<<replace #customOverlayContent>><<extraStatistics>><</replace>>
		<</link>>
		&nbsp;&nbsp;&nbsp;<label><<checkbox "$options.skipStatisticsConfirmation" false true autocheck>> 다시 표시하지 않기</label>
		<!-- ignore the nbsp's, they're just for formatting -->
	</div>
<</widget>>

<<widget "extraStatistics">>
	<div id="spoilerWarningConfirmed">
		<<foldout false "_stateFoldout">>
			<span class="gold">상태</span>
			고통: <<print Math.trunc($pain)>>
			<br>
			흥분: <<print Math.trunc($arousal)>>
			<br>
			피로도: <<print Math.trunc($tiredness)>>
			<br>
			스트레스: <<print Math.trunc($stress)>>
			<br>
			트라우마: <<print Math.trunc($trauma)>>
			<br>
			통제력: <<print Math.trunc($control)>>
			<br>
			매력: <<print Math.trunc($allure)>>
			<br>
			알코올: <<print Math.trunc($drunk)>>
			<br>
			약물: <<print Math.trunc($drugged)>>
			<br>
			환각제: <<print Math.trunc($hallucinogen)>>
			<br><br>
		<</foldout>>

		<<foldout false "_charFoldout">>
			<span class="gold">특징</span>
			순결함: <<print Math.trunc($purity)>>
			<br>
			미모: <<print Math.trunc($beauty)>>
			<br>
			체격: <<print Math.trunc($physique)>>
			<br>
			의지력: <<print Math.trunc($willpower)>>
			<br>
			성지식: <<print Math.trunc($awareness)>>
			<br>
			음란: <<print Math.trunc($promiscuity)>>
			<br>
			노출증: <<print Math.trunc($exhibitionism)>>
			<br>
			이상성욕: <<print Math.trunc($deviancy)>>
			<br>
			타락: <<print Math.trunc($earSlime.corruption)>>
			<br>
			<<if $earSlime.growth>>
				성장: <<print Math.trunc($earSlime.growth)>>
				<br>
			<</if>>
			<<if $temple_rank is "initiate" or $temple_rank is "monk" or $temple_rank is "priest">>
				우아함: <<print Math.trunc($grace)>>
				<br>
			<</if>>
			순종: <<print Math.trunc($submissive)>>
			<br>
			마조히즘: <<print Math.trunc($masochism)>>
			<br>
			사디즘: <<print Math.trunc($sadism)>>
			<br>
			크로스 드레서 진행도:
			<<if $crossdressingTrait isnot undefined>>
				<<print Math.trunc($crossdressingTrait)>> %
			<<else>>
				0
			<</if>>
			<br><br>
			민감도:
			<mouse class="tooltip linkBlue">(?)<span>신체의 해당 부위가 자극받을 때 적용되는 흥분 배율입니다.</span></mouse>
			<ul style="margin-top:0px;margin-left:-5px;">
				<li>입: <<print $mouthsensitivity.toFixed(2)>></li>
				<li>가슴: <<print $breastsensitivity.toFixed(2)>></li>
				<li>성기: <<print $genitalsensitivity.toFixed(2)>></li>
				<li>엉덩이: <<print $bottomsensitivity.toFixed(2)>></li>
			</ul>
			가슴 성장도: <<print Math.trunc(100 - ($breastgrowthtimer / 10))>>%
			<mouse class="tooltip linkBlue">(?)<span>100% 이상에 도달하면 커지고, 0% 이하로 떨어지면 작아집니다.</span></mouse>
			<br>
			<<if $player.breastsize lt $breastsizemax>>
				더 커질 수 있습니다.
			<<else>>
				최대 크기입니다.
			<</if>>
			<br>
			<<if $player.breastsize gt $breastsizemin>>
				더 작아질 수 있습니다.
			<<else>>
				최소 크기입니다.
			<</if>>
			<br>
			<<if $lactating is 1>>
				모유가 분비되고 있습니다.
			<<else>>
				모유가 분비되지 않습니다.
			<</if>>
			<br>
			<<if $lactating is 1>>
				모유량: <<print Math.trunc($milk_amount)>>
				<br>
				모유 용량: <<print Math.trunc($milk_volume)>>
				<br>
			<</if>>
			<<if $player.penisExist>>
				<<if $player.penissize gte 1>>
					<<set $_penisGrowthMin to 0>>
				<<else>>
					<<set $_penisGrowthMin to -400>>
				<</if>>
				<<if $player.penissize gt 0>>
					<<set $_penisGrowthMax to 1000>>
				<<elseif $player.penissize is 2>>
					<<set $_penisGrowthMax to 1200>>
				<<else>>
					<<set $_penisGrowthMax to 1500>>
				<</if>>
				<<set $_penisgrowthtimer to $penisgrowthtimer>>
				<<if $_penisGrowthMin lt 0>>
					<<set $_penisGrowthMax -= $_penisGrowthMin>>
					<<set $_penisgrowthtimer -= $_penisGrowthMin>>
				<</if>>
				<br>
				자지 성장도: <<print Math.trunc(100 - ($_penisgrowthtimer / $_penisGrowthMax * 100))>>%
				<mouse class="tooltip linkBlue">(?)<span>100% 이상에 도달하면 커지고, 0% 이하로 떨어지면 작아집니다.</span></mouse>
				<br>
				<<if $sexStats && $sexStats.pills>>
					<<if $player.penissize lt $penissizemax and ($player.penissize gte 1 or $sexStats.pills["pills"]["penis growth"].overdose - $sexStats.pills["pills"]["penis reduction"].overdose - ($worn.genitals.type.includes("shrinking") ? 20 : 0) gte 20)>>
						더 커질 수 있습니다.
					<<elseif $player.penissize is $penissizemax>>
						최대 크기입니다.
					<<else>>
						더 커질 수 없습니다.
						<<if $player.penissize is 0 and $sexStats.pills["pills"]["penis growth"].overdose - $sexStats.pills["pills"]["penis reduction"].overdose - ($worn.genitals.type.includes("shrinking") ? 20 : 0) lt 20>>
							<mouse class="tooltip linkBlue">(?)<span>성장 알약을 과다 복용하거나 성게 자지 기생충을 사용해야 합니다.</span></mouse>
						<</if>>
					<</if>>
					<br>
					<<if $player.penissize gt $penissizemin and ($player.sex isnot "f" or $player.penissize gt 0) and ($player.penissize gte 2 or $sexStats.pills["pills"]["penis growth"].overdose - $sexStats.pills["pills"]["penis reduction"].overdose - ($worn.genitals.type.includes("shrinking") ? 20 : 0) lte -20)>>
						더 작아질 수 있습니다.
					<<elseif $player.penissize is $penissizemin>>
						최소 크기입니다.
					<<elseif $player.sex is "f" && $player.penissize is 2>>
						더 작아질 수 없습니다. <mouse class="tooltip linkBlue">(?)<span>기생충 자지의 최소 크기입니다.</span></mouse>
					<<else>>
						더 작아질 수 없습니다.
						<<if $player.penissize is 1 and $sexStats.pills["pills"]["penis growth"].overdose - $sexStats.pills["pills"]["penis reduction"].overdose - ($worn.genitals.type.includes("shrinking") ? 20 : 0) gt -20>>
							<mouse class="tooltip linkBlue">(?)<span>축소 알약을 과다 복용하거나 슬라임 자지 기생충을 사용해야 합니다.</span></mouse>
						<</if>>
					<</if>>
					<br>
				<</if>>
				정액량: <<print Math.trunc($semen_amount)>>
				<br>
				정액 용량: <<print Math.trunc($semen_volume)>>
				<br>
			<</if>>
			<br>
			엉덩이 성장도: <<print Math.trunc(100 - ($bottomgrowthtimer / 10))>>%
			<mouse class="tooltip linkBlue">(?)<span>100% 이상에 도달하면 커지고, 0% 이하로 떨어지면 작아집니다.</span></mouse>
			<br>
			<<if $player.bottomsize lt $bottomsizemax>>
				더 커질 수 있습니다.
			<<else>>
				최대 크기입니다.
			<</if>>
			<br>
			<<if $player.bottomsize gt $bottomsizemin>>
				더 작아질 수 있습니다.
			<<else>>
				최소 크기입니다.
			<</if>>
			<br><br>
		<</foldout>>

		<<foldout false "_clothesFoldout">>
			<span class="gold">의류</span>
			<<if $worn.upper.name isnot "naked">>
				상의 젖음 정도: <<print Math.trunc($upperwet)>>
				<br>
				상의 내구도: <<print Math.trunc($worn.upper.integrity)>>
				<br>
			<</if>>
			<<if $worn.lower.name isnot "naked">>
				하의 젖음 정도: <<print Math.trunc($lowerwet)>>
				<br>
				하의 내구도: <<print Math.trunc($worn.lower.integrity)>>
				<br>
			<</if>>
			<<if $worn.under_upper.name isnot "naked">>
				속옷 상의 젖음 정도: <<print Math.trunc($underupperwet)>>
				<br>
				속옷 상의 내구도: <<print Math.trunc($worn.under_upper.integrity)>>
				<br>
			<</if>>
			<<if $worn.under_lower.name isnot "naked">>
				속옷 하의 젖음 정도: <<print Math.trunc($underlowerwet)>>
				<br>
				속옷 하의 내구도: <<print Math.trunc($worn.under_lower.integrity)>>
				<br>
			<</if>>
			<<if $worn.genitals.name isnot "naked">>
				<<print setup.clothes.genitals[clothesIndex('genitals',$worn.genitals)].name_cap>> 내구도: <<print Math.trunc($worn.genitals.integrity)>>
				<br>
			<</if>>
			<br>
		<</foldout>>

		<<foldout false "_socialFoldout">>
			<span class="gold">소셜</span>
			학교 지위: <<print Math.trunc($cool)>>
			<br>
			불량도: <<print Math.trunc($delinquency)>>
			<br>
			방과 후 지도: <<print Math.trunc($detention)>>
			<br>
			범죄: <<print Math.trunc(crimeSumCurrent())>>
			<br>
			고아원 희망: <<print Math.trunc($orphan_hope)>>
			<br>
			고아원 반항도: <<print Math.trunc($orphan_reb)>>
			<br>
			<<if $docks.hired>>
				부두 상태: <<print Math.trunc($docks.status)>>
				<br>
			<</if>>
			<<if $pound and $pound.progress gte 1>>
				유기견 만족도: <<print Math.trunc($stray_happiness)>>
				<br>
			<</if>>
			섹스 명성: <<print Math.trunc($fame.sex)>>
			<br>
			매춘 명성: <<print Math.trunc($fame.prostitution)>>
			<br>
			강간 명성: <<print Math.trunc($fame.rape)>>
			<br>
			수간 명성: <<print Math.trunc($fame.bestiality)>>
			<br>
			노출 명성: <<print Math.trunc($fame.exhibitionism)>>
			<br>
			임신 명성: <<print Math.trunc($fame.pregnancy)>>
			<br>
			수정 명성: <<print Math.trunc($fame.impreg)>>
			<br>
			전투 명성: <<print Math.trunc($fame.scrap)>>
			<br>
			친절 명성: <<print Math.trunc($fame.good)>>
			<br>
			사업 명성: <<print Math.trunc($fame.business)>>
			<br>
			<<if $debug is 1>>
				포주 명성: <<print Math.trunc($fame.pimp)>>
				<br>
			<</if>>
			사교 명성: <<print Math.trunc($fame.social)>>
			<br>
			모델 명성: <<print Math.trunc($fame.model)>>
			<br>
			섬 주민 언어: <<if $islander_language is undefined>>0<<else>><<print Math.trunc($islander_language)>><</if>>
			<br>
			그윌란의 발전: <<if $gwylan?.progress is undefined>>0<<else>><<print $gwylan.progress>><</if>>
			<br><br>
		<</foldout>>

		<<foldout false "_crimeFoldout">>
			<span class="gold">범죄</span>
			<<for $_cr range Object.keys(setup.crimeNames)>>
				<<foldout false $_cr>>
					<span class="gold"><<print toTitleCase(setup.crimeNames[$_cr])>></span>
					<<print "현재: " + Math.trunc($crime[$_cr].current)>>
					<br>
					<<print "누적: " + Math.trunc($crime[$_cr].history)>>
					<br>
					<<print "일일: " + Math.trunc($crime[$_cr].daily)>>
					<br>
					<<print "횟수: " + Math.trunc($crime[$_cr].count)>>
					<br>
					<<print "누적 횟수: " + Math.trunc($crime[$_cr].countHistory)>>
					<br>
				<</foldout>>
			<</for>>
			<<foldout false "_crimeTotalsFoldout">>
				<span class="gold">합계</span>
				<<print "현재: " + crimeSumCurrent()>>
				<br>
				<<print "누적: " + crimeSumHistory()>>
				<br>
				<<print "일일: " + crimeSumDaily()>>
				<br>
				<<print "횟수: " + crimeSumCount()>>
				<br>
				<<print "누적 횟수: " + crimeSumCountHistory()>>
				<br>
			<</foldout>>
			<<foldout false "_crimeEventsFoldout">>
				<span class="gold">범죄 이벤트</span>
				<span id="statscrimeevents"><<listCrimeCheats>></span>
			<</foldout>>
			<br>
		<</foldout>>

		<<foldout false "_transformationFoldout">>
			<span class="gold">변신</span>
			늑대 변이: <<print Math.trunc($wolfbuild)>> (30+ 완전 변신)
			<br>
			늑대 발현 단계: <<print Math.trunc($wolfgirl)>>
			<br>
			고양이 변이: <<print Math.trunc($catbuild)>> (50+ 완전 변신)
			<br>
			고양이 발현 단계: <<print Math.trunc($cat)>>
			<br>
			젖소 변이: <<print Math.trunc($cowbuild)>> (30+ 완전 변신)
			<br>
			젖소 발현 단계: <<print Math.trunc($cow)>>
			<br>
			<<if $hallucinations gte 2 or !$settings.bestialityEnabled>>하피 변이<<else>>새 변이<</if>>: <<print Math.trunc($birdbuild)>> (30+ 완전 변신)
			<br>
			<<if $hallucinations gte 2 or !$settings.bestialityEnabled>>하피<<else>>새<</if>> 발현 단계: <<print Math.trunc($harpy)>>
			<br>
			여우 변이: <<print Math.trunc($foxbuild)>> (30+ 완전 변신)
			<br>
			여우 발현 단계: <<print Math.trunc($fox)>>
			<br>
			천사 변이: <<print Math.trunc($angelbuild)>> (50+ 완전 변신)
			<br>
			천사 발현 단계: <<print Math.trunc($angel)>>
			<br>
			악마 변이: <<print Math.trunc($demonbuild)>> (30+ 완전 변신)
			<br>
			악마 발현 단계: <<print Math.trunc($demon)>>
			<br>
			타락 발현 단계:
			<<print ($fallenangel is undefined ? 0 : Math.trunc($fallenangel))>>
			<br>
			타락 면죄: <<print Math.trunc($fallenbuild)>> (30+ 면죄)
			<br><br>
		<</foldout>>

		<<foldout false "_parasitePregnancyFoldout">>
			<span class="gold">기생충 임신</span>
			<<parasiteSlotBlock "anus">>
			<<if $player.vaginaExist>>
				<<parasiteSlotBlock "vagina">>
			<</if>>
			<br>
		<</foldout>>
		<<set $_menstruation to $sexStats.vagina.menstruation>>
		<<if ($player.vaginaExist or playerCanCarryAnally()) and $settings.fertilityCycleEnabled>>
			<<foldout false "_menstruationFoldout">>
				<span class="gold">월경 주기</span>
				<<if $_menstruation.running>>
					<<set _fertile to menstrualFertileDates()>>
					<br>
					<<if _fertile.passed>>
						/*The next cycle's length and fertile window aren't rolled until it begins, so the span is all that can honestly be given.*/
						이번 주기의 가임기는 이미 지났습니다.
						<br>
						<<if _fertile.nextWindow.min is _fertile.nextWindow.max>>
							다음 가임기는 약 <<print _fertile.nextWindow.min>>일 후에 시작됩니다.
						<<else>>
							다음 가임기는 약 <<print _fertile.nextWindow.min>>~<<print _fertile.nextWindow.max>>일 후에 시작됩니다.
						<</if>>
					<<else>>
						위험한 날: <<if $options.dateFormat is "en-GB">><<print _fertile.risky.replace(/(\d{1,2})\/(\d{1,2})/g, "$2월 $1일").replace(" to ", " ~ ")>><<else>><<print _fertile.risky.replace(/(\d{1,2})\/(\d{1,2})/g, "$1월 $2일").replace(" to ", " ~ ")>><</if>>
						/*Ovulation can be behind the PC while the luteal tail still runs, and a span that is over is not printed.*/
						<<if _fertile.dangerous>>
							<br>
							매우 위험한 날: <<if $options.dateFormat is "en-GB">><<print _fertile.dangerous.replace(/(\d{1,2})\/(\d{1,2})/g, "$2월 $1일").replace(" to ", " ~ ")>><<else>><<print _fertile.dangerous.replace(/(\d{1,2})\/(\d{1,2})/g, "$1월 $2일").replace(" to ", " ~ ")>><</if>>
						<</if>>
					<</if>>
					<br>
					성관계 위험도: <span @class="_fertile.todayColour"><<print _fertile.today>></span>.
					<br>
					현재 주기 날짜: <<print $_menstruation.currentDay>>일
					<br>
					주기 마지막 날: <<print $_menstruation.currentDaysMax>>일
					<br>
				<<else>>
					<br>
					현재 주기가 진행 중이지 않습니다.
					<br>
				<</if>>
				<br>
			<</foldout>>
		<</if>>
		<<foldout false "_extraPregnancyFoldout">>
			<span class="gold">임신</span>
			/* Previously commented out for being a major spoil, but caused players to think a bug had occurred */
			총 임신 일수: <<print Math.floor($pregnancyStats.totalDaysPregnant)>>
			<br>
			임신 인지 일수: <<print Math.floor($pregnancyStats.totalDaysPregnancyKnown)>>
			<br>
			<<if $player.vaginaExist>>
				<<pregnancyStatusBlock "vagina">>
			<</if>>
			<<if getActivePregnancy("pc", "anus") or $sexStats.anus.pregnancy.type is "parasite" or !$player.vaginaExist>>
				<<pregnancyStatusBlock "anus">>
			<</if>>
		<</foldout>>
		<<if $NPCName.find(npc => npc.pregnancy and npc.pregnancy.enabled isnot undefined)>>
			<<foldout false "_npcPregnancyFoldout">>
				<span class="gold">NPC 임신</span>
				<<for $_npc range $NPCName.filter(npc => npc.pregnancy and npc.pregnancy.enabled isnot undefined)>>
					<div>
						<<print window.KR.gatPersonNameDictKR($_npc.nam)>>:
						<<set _active to getActivePregnancies($_npc.nam)[0]>>
						<<if !$_npc.pregnancy.enabled and !_active>>
							플레이어가 NPC 임신을 비활성화했습니다.
						<<elseif !_active>>
							임신하지 않았습니다.
						<<else>>
							<<set _litterCount to getChildrenOf(_active.pregnancyId).length>>
							임신 중인 수: <<print _litterCount>>
							<<extraStatisticsPregnancyType childBaseSpecies(_active.donorSpecies) _litterCount>>
							<<set $_days to pregnancyDaysEta(_active)>>
							<<if $_days lt 1>>
								예상 출산 시점: 언제든지.
							<<elseif $_days>>
								예상 출산까지: <<print $_days>>일.
							<</if>>
						<</if>>
					</div>
				<</for>>
			<</foldout>>
		<</if>>
	</div>
<</widget>>

/* One orifice's parasite slots. _args[0] is "anus" or "vagina". */
<<widget "parasiteSlotBlock">>
	<<set _orifice to _args[0]>>
	<<set _label to _orifice is "anus" ? "항문" : "질">>
	<<set $_pregnancy to $sexStats[_orifice].pregnancy>>
	<<if $_pregnancy.type is "parasite" or ($_pregnancy.type is null and !getActivePregnancy("pc", _orifice))>>
		<<for _i to 0; _i lt maxParasites(_orifice); _i++>>
			<<if $_pregnancy.fetus[_i] isnot undefined>>
				<<if $_pregnancy.fetus[_i].fertilised>>
					_label 슬롯 <<=_i+1>>【은는】 <<print window.KR.getGenderKR($_pregnancy.fetus[_i].stats.gender)>> <<print window.KR.getCreatureTypeKr($_pregnancy.fetus[_i].creature)>>【을를】 임신 중입니다.
					<<if $_pregnancy.fetus[_i].stats.gender is "Hermaphrodite">>
						<<if $pregnancyStats.parasiteDoctorEvents gte 4 and $_pregnancy.fetus[_i].daysLeft is 0>>
							하퍼 박사가 언제든 출산을 도와줄 수 있을 것입니다.
						<<elseif $pregnancyStats.parasiteDoctorEvents gte 4>>
							하퍼 박사가 <<=$_pregnancy.fetus[_i].daysLeft>>일 후 출산을 도와줄 수 있을 것입니다.
						<<else>>
							출산을 위해서는 하퍼 박사를 만나야 합니다.
						<</if>>
					<<else>>
						<<if $_pregnancy.fetus[_i].daysLeft is 0>>
							곧 언제라도 출산할 준비가 될 것입니다.
						<<else>>
							<<=$_pregnancy.fetus[_i].daysLeft>>일 이내에 출산할 준비가 될 것입니다.
						<</if>>
					<</if>>
					<br>
				<<else>>
					_label 슬롯 <<=_i+1>>에 수정될 준비가 된 <<print window.KR.getGenderKR($_pregnancy.fetus[_i].stats.gender)>> <<print window.KR.getCreatureTypeKr($_pregnancy.fetus[_i].creature)>> 알이 있습니다.<br>
				<</if>>
			<<else>>
				_label 슬롯 <<=_i+1>>【은는】 비어 있습니다.<br>
			<</if>>
		<</for>>
	<<else>>
		<<if playerAwareTheyArePregnant()>>
			다른 종류의 <<= _orifice is "anus" ? "항문" : "질">> 임신 중이라 기생체를 품을 수 없습니다.
		<<else>>
			<<for _i to 0; _i lt maxParasites(_orifice); _i++>>
				_label 슬롯 <<=_i+1>>【은는】 비어 있습니다.<br>
			<</for>>
		<</if>>
	<</if>>
<</widget>>

/* Pregnancy status for one orifice. _args[0] is "vagina" or "anus". */
<<widget "pregnancyStatusBlock">>
	<<set _orifice to _args[0]>>
	<<set _menstruation to $sexStats.vagina.menstruation>>
	<<set _record to getActivePregnancy("pc", _orifice)>>
	<<if _record>>
		<<set _litterCount to getChildrenOf(_record.pregnancyId).length>>
		현재 임신 중인 수: <<print _litterCount>>
		<<extraStatisticsPregnancyType childBaseSpecies(_record.donorSpecies) _litterCount>>
		<br>
		<<set _days to pregnancyDaysEta(_record)>>
		<<if _days lt 1>>
			예상 출산 시점: 언제든지.
		<<elseif _days>>
			예상 출산까지: <<print _days>>일.
		<</if>>
		<br>
	<<elseif orificeHasParasites(_orifice)>>
		<<= _orifice is "anus" ? "항문" : "자궁">> 안의 기생체들이 <<= _orifice is "anus" ? "항문" : "질">> 임신이 일어나는 것을 막고 있습니다.
	<<elseif (_orifice is "vagina" and !$player.vaginaExist) or !_menstruation.running>>
		현재 임신할 수 없습니다.
	<<elseif _menstruation.currentState is "recovering">>
		마지막 임신 이후 너무 이른 시기라 임신할 준비가 아직 덜 되었습니다.
	<<else>>
		현재 임신하지 않았습니다.
		<br>
		<<if $harpy gte 4>>
			<<if $harpyEggs>>
				당신은 알 $harpyEggs.count개를 품고 있습니다.
			<<elseif $harpyEggsPrevent>>
				현재 알을 생산할 수 없습니다.
			<<else>>
				알을 생산할 수 있습니다.
			<</if>>
			<br>
		<</if>>
		<<if $settings.pregnancyType is "realistic">>
			<<set _loads to $cumLoads[_orifice].filter(l => loadIsLive(l))>>
			임신 가능성이 있는 <<= _orifice is "vagina" ? "질" : "항문">> 내 정액 수: <<print _loads.length>>
			<br>
			<<if _loads.length>>
				현재 당신 안에 정액이 남아 있는 대상들:
				<ul>
					<<set _donors to _loads.map(l => l.donor).filter((d, i, a) => a.indexOf(d) === i)>>
					<<for _donor range _donors>>
						<<set _count to _loads.filter(l => l.donor === T.donor).length>>
						<li>
							<<print pregnancyNameCorrection(_donor)>>
							<<if _count gt 1>>
								(x<<print _count>>)
							<</if>>
						</li>
					<</for>>
				</ul>
			<<else>>
				<br>
			<</if>>
		<<else>>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "extraStatisticsPregnancyType">>
	<<switch _args[0]>>
		<<case "human">>명 (인간 아기)
		<<case "wolf">>마리 (늑대 새끼)
		<<case "hawk">>개 (매의 알)
	<</switch>>
<</widget>>

<<widget "statisticsTimeCompare">><<silently>>
	<<if $statFreeze is true>>
		<<set $_text_output to "통계가 고정된 동안에는 사용할 수 없음">>
	<<elseif _args[0]>>
		<<set _difference to new DateTime(_args[0]).compareWith(_args[1] or Time.date)>>
		<<set $_text_output to "">>
		<<if _difference.years>>
			<<set $_text_output += `${_difference.years}년`>>
		<</if>>
		<<if _difference.months>>
			<<if $_text_output>><<set $_text_output += ", ">><</if>>
			<<set $_text_output += `${_difference.months}개월`>>
		<</if>>
		<<if _difference.days>>
			<<if $_text_output>><<set $_text_output += ", ">><</if>>
			<<set $_text_output += `${_difference.days}일`>>
		<</if>>
		<<if _difference.hours>>
			<<if $_text_output>><<set $_text_output += ", ">><</if>>
			<<set $_text_output += `${_difference.hours}시간`>>
		<</if>>
		<<if _difference.minutes>>
			<<if $_text_output>><<set $_text_output += ", ">><</if>>
			<<set $_text_output += `${_difference.minutes}분`>>
		<</if>>
		<<if _args[1] and !$_text_output>>
			<<set $_text_output += "차이 없음">>
		<<elseif !$_text_output>>
			<<set $_text_output += "방금 전">>
		<<elseif !_args[1]>>
			<<set $_text_output += " 전">>
		<</if>>
	<<else>>
		<<set $_text_output to "없음">>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "statisticsDetailedTables">>
	<<switch _openedTable>>
		<<case "money">>
			돈 기록 참고 <mouse class="tooltip linkBlue">(?)<span>너무 많은 열을 추가하면 일부 기기에서 읽기 어려워질 수 있습니다. 대부분의 기록은 버전 '0.5.2.x' 이전에는 전혀 기록되지 않았으므로 정확하지 않을 수 있습니다.<<if Object.keys($timeStats).length>> 시간당 수익률은 모든 상황을 추적하기 어려워 대부분 "해당 없음(N/A)"으로 표시됩니다.<</if>></span></mouse>
			<br>
			<<set [_moneyKeys, _moneyStats, _moneyStatsTotal] to moneyStatsProcess(clone($moneyStats))>>
			<<if $moneyStatsSnapshot?.money>>
				<<set [_moneySnapshotKeys, _moneyStatsSnapshot, _moneyStatsSnapshotTotal] to moneyStatsProcess(clone($moneyStatsSnapshot.money))>>
			<</if>>
			<div id="moneyStatsDiv">
				<<moneyStats>>
			</div>
			<<if $debug is 1>>
				<<link "통계 초기화 (디버그)">>
					<<set $moneyStats to {}>>
					<<set $timeStats to {}>>
					<<unset $moneyStatsSnapshot>>
					<<unset _showSnapshot>>
					<<set [_moneyKeys, _moneyStats, _moneyStatsTotal] to moneyStatsProcess(clone($moneyStats))>>
					<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
				<</link>>
			<</if>>
		<<case "produce">>
			농작물 기록 참고: <mouse class="tooltip linkBlue">(?)<span>너무 많은 열을 추가하면 일부 기기에서 읽기 어려워질 수 있습니다. 이러한 항목들은 버전 '0.5.3.x' 이전에는 전혀 기록되지 않았으므로 정확하지 않을 수 있습니다.</span></mouse>
			<br>
			<div id="produceStatsDiv">
				<<produceStats>>
			</div>
		<<case "badEnd">>
			배드 엔딩 참고 <mouse class="tooltip linkBlue">(?)<span>너무 많은 열을 추가하면 일부 기기에서 읽기 어려워질 수 있습니다. 이러한 항목들은 버전 '0.5.2.x' 이전에는 전혀 기록되지 않았으므로 정확하지 않을 수 있습니다. 배드 엔딩이 끝났음에도 계속 진행 중이라고 뜬다면, 세이브 파일과 함께 버그로 신고해 주세요.</span></mouse>
			<br>
			<div id="badEndStatsDiv">
				<<badEndStats>>
			</div>
	<</switch>>
<</widget>>

<<widget "moneyStats">>
	<<set $_moneyStats to (_showSnapshot is "show" ? clone(_moneyStatsSnapshot) : clone(_moneyStats))>>
	<<set $_moneyKeys to (_showSnapshot is "show" ? clone(_moneySnapshotKeys) : clone(_moneyKeys))>>
	<<set $_moneyTotal to (_showSnapshot is "show" ? clone(_moneyStatsSnapshotTotal) : clone(_moneyStatsTotal))>>
	<<link `$moneyStatsSnapshot ? "스냅샷 다시 만들기" : "스냅샷 만들기"`>>
		<<set $moneyStatsSnapshot to {
			date: Time.date.timeStamp,
			money: clone(V.moneyStats),
			time: clone(V.timeStats),
		}>>
		<<set [_moneySnapshotKeys, _moneyStatsSnapshot, _moneyStatsSnapshotTotal] to moneyStatsProcess(clone($moneyStatsSnapshot.money))>>
		<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
	<</link>>
	<<if $moneyStatsSnapshot>>
		| <<link "스냅샷 지우기">>
			<<unset $moneyStatsSnapshot>>
			<<unset _showSnapshot>>
			<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
		<</link>>
	<</if>>
	<br><br>
	<<link `_moneyStatsDetailed ? "세부 정보 줄이기" : "세부 정보 펼치기"`>>
		<<set _moneyStatsDetailed to !_moneyStatsDetailed>>
		<<set [_moneyKeys, _moneyStats, _moneyStatsTotal] to moneyStatsProcess(clone($moneyStats))>>
		<<if $moneyStatsSnapshot?.money>>
			<<set [_moneySnapshotKeys, _moneyStatsSnapshot, _moneyStatsSnapshotTotal] to moneyStatsProcess(clone($moneyStatsSnapshot.money))>>
		<</if>>
		<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
	<</link>> |
	<span @class="_moneyStatsCount ? 'goldLink' : ''">
		<<link `_moneyStatsCount ? "횟수 숨기기" : "횟수 표시하기"`>>
			<<set _moneyStatsCount to !_moneyStatsCount>>
			<<if !_moneyStatsCount and _moneyStatsSorting?.includes("Count")>><<unset _moneyStatsSorting>><</if>>
			<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
		<</link>>
	</span> |
	<span @class="_moneyStatsAverages ? 'goldLink' : ''">
		<<link `_moneyStatsAverages ? "평균 숨기기" : "평균 표시하기"`>>
			<<set _moneyStatsAverages to !_moneyStatsAverages>>
			<<if !_moneyStatsAverages and _moneyStatsSorting?.includes("Average")>><<unset _moneyStatsSorting>><</if>>
			<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
		<</link>>
	</span> |
	<span @class="_moneyStatsDate ? 'goldLink' : ''">
		<<link `_moneyStatsDate ? "날짜 숨기기" : "날짜 표시하기"`>>
			<<set _moneyStatsDate to !_moneyStatsDate>>
			<<if !_moneyStatsDate and _moneyStatsSorting?.includes("Date")>><<unset _moneyStatsSorting>><</if>>
			<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
		<</link>>
	</span> |
	<<if Object.keys($timeStats).length>>
		<span @class="_moneyStatsHourRates ? 'goldLink' : ''">
			<<link `_moneyStatsHourRates ? "시급 숨기기" : "시급 표시하기"`>>
				<<set _moneyStatsHourRates to !_moneyStatsHourRates>>
				<<if !_moneyStatsHourRates and _moneyStatsSorting?.includes("Hour Rates")>><<unset _moneyStatsSorting>><</if>>
				<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
			<</link>>
		</span>
	<</if>>
	<<if $moneyStatsSnapshot>>
		||
		<span @class="_showSnapshot is 'show' ? 'goldLink' : ''">
			<<link `_showSnapshot is "show" ? "스냅샷 숨기기" : "스냅샷 표시하기"`>>
				<<if _showSnapshot is "show">>
					<<unset _showSnapshot>>
				<<else>>
					<<set _showSnapshot to "show">>
				<</if>>
				<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
			<</link>>
		</span>
		|
		<span @class="_showSnapshot is 'compare' ? 'goldLink' : ''">
			<<link `_showSnapshot is "compare" ? "스냅샷 비교 숨기기" : "스냅샷 비교하기"`>>
				<<if _showSnapshot is "compare">>
					<<unset _showSnapshot>>
				<<else>>
					<<set _showSnapshot to "compare">>
				<</if>>
				<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
			<</link>>
		</span>
	<</if>>
	<<if _moneyStatsSorting>>
		| <<link "정렬 초기화">>
			<<unset _moneyStatsSorting>>
			<<replace "#moneyStatsDiv">><<moneyStats>><</replace>>
		<</link>>
		<<run $_moneyKeys.sort((a, b) => {
			if (_moneyStatsSorting.includes("Desc")) {
				const tempSwap = clone(a);
				a = clone(b);
				b = tempSwap;
			}
			switch(_moneyStatsSorting.replace("Desc","")) {
				case "Source":
					if (a.toUpperCase() < b.toUpperCase()) return -1;
					return 1;
					break;
				case "Earned":
					return ($_moneyStats[b].earned || 0) - ($_moneyStats[a].earned || 0);
				case "Spent":
					return ($_moneyStats[b].spent || 0) - ($_moneyStats[a].spent || 0);
				case "Earned Count":
					return ($_moneyStats[b].earnedCount || 0) - ($_moneyStats[a].earnedCount || 0);
				case "Earned Average":
					return ($_moneyStats[b].earned / $_moneyStats[b].earnedCount || 0) - ($_moneyStats[a].earned / $_moneyStats[a].earnedCount || 0);
				case "Hour Rates":
					return (statChange.timeTrackingTotal(b) ? $_moneyStats[b].earned / statChange.timeTrackingTotal(b) : 0) - (statChange.timeTrackingTotal(a) ? $_moneyStats[a].earned / statChange.timeTrackingTotal(a) : 0);
				case "Spent Count":
					return ($_moneyStats[b].spentCount || 0) - ($_moneyStats[a].spentCount || 0);
				case "Spent Average":
					return ($_moneyStats[b].spent / $_moneyStats[b].spentCount || 0) - ($_moneyStats[a].spent / $_moneyStats[a].spentCount || 0);
				case "Date":
					return (Math.max($_moneyStats[b].earnedTimeStamp || 0, $_moneyStats[b].spentTimeStamp || 0)) - (Math.max($_moneyStats[a].earnedTimeStamp || 0, $_moneyStats[a].spentTimeStamp || 0));
			}
		})>>
	<</if>>
	<table class="statsTable">
		<thead>
			<tr>
				<th scope="col"><<moneyStatsTitle "Source">></th>
				<th scope="col"><<moneyStatsTitle "Spent">></th>
				<<if _moneyStatsAverages>>
					<th scope="col"><<moneyStatsTitle "Spent Average">></th>
				<</if>>
				<<if _moneyStatsCount>>
					<th scope="col"><<moneyStatsTitle "Spent Count">></th>
				<</if>>
				<th scope="col"><<moneyStatsTitle "Earned">></th>
				<<if _moneyStatsAverages>>
					<th scope="col"><<moneyStatsTitle "Earned Average">></th>
				<</if>>
				<<if _moneyStatsCount>>
					<th scope="col"><<moneyStatsTitle "Earned Count">></th>
				<</if>>
				<<if _moneyStatsHourRates>>
					<th scope="col"><<moneyStatsTitle "Hour Rates">></th>
				<</if>>
				<<if _moneyStatsDate>>
					<th scope="col"><<moneyStatsTitle "Date">></th>
				<</if>>
			</tr>
		</thead>
		<<if _showSnapshot is "show">><<set _timeTrackingSnapshotOveride to true>><</if>>
		<<for $_key range $_moneyKeys>>
			<<if $_moneyStats[$_key].earned or $_moneyStats[$_key].spent>>
				<tbody class="stat">
					<td data-label="Source"><<moneyStatsNamesKr $_key>></td>
					<td data-label="Spent" @class="$_moneyStats[$_key].spent ? '' : 'mobileHidden'">
						<<if $_moneyStats[$_key].spent>>
							<<printmoney `$_moneyStats[$_key].spent or 0` "red">>
							<<moneyStatsCompare $_key "spent">>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
					<<if _moneyStatsAverages>>
						<td data-label="Spent Average" @class="$_moneyStats[$_key].spent ? '' : 'mobileHidden'">
							<<if $_moneyStats[$_key].spent>>
								<<printmoney `$_moneyStats[$_key].spent / $_moneyStats[$_key].spentCount or 0` "red">>
							<<else>>
								<span class="dash">-</span>
							<</if>>
						</td>
					<</if>>
					<<if _moneyStatsCount>>
						<td data-label="Spent Count" @class="$_moneyStats[$_key].spent ? '' : 'mobileHidden'">
							<<if $_moneyStats[$_key].spentCount>>
								<<print $_moneyStats[$_key].spentCount>>
							<<else>>
								<span class="dash">-</span>
							<</if>>
						</td>
					<</if>>
					<td data-label="Earned" @class="$_moneyStats[$_key].earned ? '' : 'mobileHidden'">
						<<if $_moneyStats[$_key].earned>>
							<<printmoney `$_moneyStats[$_key].earned or 0`>>
							<<moneyStatsCompare $_key "earned">>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
					<<if _moneyStatsAverages>>
						<td data-label="Earned Average" @class="$_moneyStats[$_key].earned ? '' : 'mobileHidden'">
							<<if $_moneyStats[$_key].earned>>
								<<printmoney `$_moneyStats[$_key].earned / $_moneyStats[$_key].earnedCount or 0`>>
							<<else>>
								<span class="dash">-</span>
							<</if>>
						</td>
					<</if>>
					<<if _moneyStatsCount>>
						<td data-label="Earned Count" @class="$_moneyStats[$_key].earned ? '' : 'mobileHidden'">
							<<if $_moneyStats[$_key].earnedCount>>
								<<print $_moneyStats[$_key].earnedCount>>
							<<else>>
								<span class="dash">-</span>
							<</if>>
						</td>
					<</if>>
					<<if _moneyStatsHourRates>>
						<td data-label="Hour Rates">
							<<if statChange.timeTrackingTotal($_key)>>
								<<printmoney `$_moneyStats[$_key].earned / statChange.timeTrackingTotal($_key)`>>
								<<moneyStatsCompareHourly $_key>>
							<<else>>
								<span class="dash">-</span>
							<</if>>
						</td>
					<</if>>
					<<if _moneyStatsDate>>
						<td data-label="Date"><<moneyStatsDate $_moneyStats[$_key].spentTimeStamp $_moneyStats[$_key].earnedTimeStamp>></td>
					<</if>>
				</tbody>
			<</if>>
		<</for>>
		<<unset _timeTrackingSnapshotOveride>>
		<tbody class="total">
			<td data-label="Source">총계</td>
			<td data-label="Spent">
				<<printmoney $_moneyTotal.spent "red">>
				<<if _showSnapshot is "compare">>
					<<print "+<<printmoney `(_moneyStatsTotal.spent or 0) - (_moneyStatsSnapshotTotal.spent or 0)` 'white'>>">>
				<<else>>
					<<moneyStatsCompare "total" "spent">>
				<</if>>
			</td>
			<<if _moneyStatsAverages>>
				<td data-label="Spent Average"><<printmoney `$_moneyTotal.spent / $_moneyTotal.spentCount or 0` "red">></td>
			<</if>>
			<<if _moneyStatsCount>>
				<td data-label="Spent Count"><<print $_moneyTotal.spentCount>></td>
			<</if>>
			<td data-label="Earned">
				<<printmoney $_moneyTotal.earned>>
				<<if _showSnapshot is "compare">>
					<<print "+<<printmoney `(_moneyStatsTotal.earned or 0) - (_moneyStatsSnapshotTotal.earned or 0)` 'white'>>">>
				<<else>>
					<<moneyStatsCompare "total" "earned">>
				<</if>>
			</td>
			<<if _moneyStatsAverages>>
				<td data-label="Earned Average"><<printmoney `$_moneyTotal.earned / $_moneyTotal.earnedCount or 0`>></td>
			<</if>>
			<<if _moneyStatsCount>>
				<td data-label="Earned Count"><<print $_moneyTotal.earnedCount>></td>
			<</if>>
			<<if _moneyStatsHourRates>>
				<td data-label="Hour Rates">-</td>
			<</if>>
			<<if _moneyStatsDate>>
				<td data-label="Date"><<moneyStatsDate $_moneyTotal.spentTimeStamp $_moneyTotal.earnedTimeStamp>></td>
			<</if>>
		</tbody>
		<<if _showSnapshot>>
			<tfoot>
				<tr>
					<td colspan="3">
						<<set _snapShotDate to new DateTime($moneyStatsSnapshot.date)>>
						스냅샷 기준:
						<<switch $options.dateFormat>>
							<<case "en-US">>
								<<print _snapShotDate.month>>월 <<print _snapShotDate.day>>일 <<print _snapShotDate.year>>년
							<<case "zh-CN">>
								<<print _snapShotDate.year>>년 <<print _snapShotDate.month>>월 <<print _snapShotDate.day>>일
							<<default>>
								<<print _snapShotDate.day>>일 <<print _snapShotDate.month>>월 <<print _snapShotDate.year>>년
						<</switch>>
						- <<ampm _snapShotDate.hour _snapShotDate.minute>>
						<br>
						스냅샷 경과 시간: <<statisticsTimeCompare $moneyStatsSnapshot.date>>
					</td>
				</tr>
			</tfoot>
		<</if>>
	</table>
<</widget>>

<<widget "moneyStatsNames">><<silently>>
	<<switch _args[0]>>
		<<case "cafeWaiter">><<set $_text_output to $player.gender_appearance is "m" ? "Cafe Waiter" : "Cafe Waitress">>
		<<case "partyDanceTips">><<set $_text_output to "Party Dance Job Tips">>
		<<case "danubeDanceTips">><<set $_text_output to "Danube Dance Job Tips">>
		<<default>><<set $_text_output to camelCaseToTitle(_args[0])>>
	<</switch>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "moneyStatsTitle">><<silently>>
	<<set $_display to ({ Source: "출처", Spent: "총 지출", "Spent Average": "평균 지출", "Spent Count": "지출 횟수", Earned: "총 수입", "Earned Average": "평균 수입", "Earned Count": "수입 횟수", "Hour Rates": "시급", Date: "날짜" }[_args[0]] || _args[0])>>
	<<if _moneyStatsSorting is _args[0]>>
		<<set $_text_output to ` <<link "${$_display}&#x25B2;">><<set _moneyStatsSorting to "${_args[0]}Desc">><<replace "#moneyStatsDiv">><<moneyStats>><</replace>><</link>>`>>
	<<elseif _moneyStatsSorting is _args[0] + "Desc">>
		<<set $_text_output to ` <<link "${$_display}&#x25BC;">><<unset _moneyStatsSorting>><<replace "#moneyStatsDiv">><<moneyStats>><</replace>><</link>>`>>
	<<else>>
		<<set $_text_output to ` <<link "${$_display}">><<set _moneyStatsSorting to "${_args[0]}">><<replace "#moneyStatsDiv">><<moneyStats>><</replace>><</link>>`>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "moneyStatsCompare">><<silently>>
	<<if _args[0] and _args[1] and _showSnapshot is "compare">>
		<<set $_amount to (_moneyStats[_args[0]][_args[1]] or 0) - (_moneyStatsSnapshot[_args[0]] ? _moneyStatsSnapshot[_args[0]][_args[1]] || 0 : 0)>>
		<<set $_text_output to `+<<printmoney ${$_amount} "white">>`>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "moneyStatsCompareHourly">><<silently>>
	<<if _args[0] and _showSnapshot is "compare">>
		<<if statChange.timeTrackingTotal(_args[0]) and _moneyStats[_args[0]]?.earned and _moneyStatsSnapshot[_args[0]]?.earned>>
			<<set $_current to _moneyStats[_args[0]].earned / statChange.timeTrackingTotal(_args[0])>>
			<<set _timeTrackingSnapshotOveride to true>>
			<<if statChange.timeTrackingTotal(_args[0])>>
				<<set $_previous to _moneyStatsSnapshot[_args[0]].earned / statChange.timeTrackingTotal(_args[0])>>
				<<set $_amount to $_current - $_previous>>
				<<set $_text_output to `${$_amount gt 0 ? "+" : ""}<<printmoney ${$_amount} ${$_amount lt 0 ? "red" : "white"}>>`>>
			<</if>>
			<<unset _timeTrackingSnapshotOveride>>
		<</if>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "moneyStatsDate">><<silently>>
	<<if _args[0] or _args[1]>>
		<<set $_time to new DateTime(Math.max(_args[0] or 0, _args[1] or 0))>>
		<<switch $options.dateFormat>>
			<<case "en-US">>
				<<set $_text_output to `<<print $_time.month>>월 <<print $_time.day>>일 <<print $_time.year>>년`>>
			<<case "zh-CN">>
				<<set $_text_output to `<<print $_time.year>>년 <<print $_time.month>>월 <<print $_time.day>>일`>>
			<<default>>
				<<set $_text_output to `<<print $_time.day>>일 <<print $_time.month>>월 <<print $_time.year>>년`>>
		<</switch>>
		<<set $_text_output += ` - <<ampm $_time.hour $_time.minute>>`>>
	<<else>>
		<<set $_text_output to `<span class="dash">-</span>`>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "virginityToolTip">><<silently>>
	<<if _args[0]?.timestamp and _args[1] isnot true>>
		<<set $_time to new DateTime(_args[0].timestamp)>>
		<<switch $options.dateFormat>>
			<<case "en-US">>
				<<set $_text_output to `빼앗긴 날짜: ${$_time.month}월 ${$_time.day}일 ${$_time.year}년`>>
			<<case "zh-CN">>
				<<set $_text_output to `빼앗긴 날짜: ${$_time.year}년 ${$_time.month}월 ${$_time.day}일`>>
			<<default>>
				<<set $_text_output to `빼앗긴 날짜: ${$_time.day}일 ${$_time.month}월 ${$_time.year}년`>>
		<</switch>>
		<<set $_text_output += ` - ${ampm($_time.hour, $_time.minute)}<br>지난 시간: <<c>><<statisticsTimeCompare _args[0].timestamp>><</c>>`>>
		<<set $_linkColour to "linkBlue">>
		<<if _args[0].consensual isnot undefined>>
			<<set $_text_output += `<br>합의 여부: ${_args[0].consensual ? "예" : "아니요"}`>>
			<<set $_linkColour to _args[0].consensual ? "green" : "red">>
		<</if>>
		<<if _args[0].position>>
			<<set _posKr to { "missionary": "정상위", "doggy": "후배위" }[_args[0].position] || _args[0].position.toUpperFirst()>>
			<<set $_text_output += `<br>체위: ${_posKr}`>>
		<</if>>
		<<if _args[0].playerPenisSize>>
			<<set $_penisSize to ["극소형", "소형", "아주 작음", "작음", "보통", "큼", "거대함"]>>
			<<set $_text_output += `<br>자지 크기: ${$_penisSize[_args[0].playerPenisSize]}`>>
		<<elseif _args[0].npcPenisSize>>
			<<set $_penisSize to ["아주 작음", "보통", "굵음", "거대함", "초거대"]>>
			<<set $_penisDesc to { knotted: "매듭 달린", spiked: "가시 돋친", strange: "기묘한", equine: "말 같은", avian: "새 같은", bovine: "소 같은", arachnid: "거미 같은" }>>
			<<if !_args[0].npcPenisdesc or !["knotted", "spiked", "strange","equine","avian","bovine","arachnid"].includes(_args[0].npcPenisdesc)>>
				<<set $_text_output += `<br>자지${_args[0].npcPenisSize2 ? "들" : ""} 크기: ${$_penisSize[_args[0].npcPenisSize - 1]}`>>
				<<if _args[0].npcPenisSize2>>
					<<set $_text_output += ` 및 ${$_penisSize[_args[0].npcPenisSize2 - 1]}`>>
				<</if>>
			<<else>>
				<<set $_text_output += `<br>자지${_args[0].npcPenisSize2 ? "들" : ""}: ${$_penisSize[_args[0].npcPenisSize - 1]} ${$_penisDesc[_args[0].npcPenisdesc] || _args[0].npcPenisdesc}`>>
				<<if _args[0].npcPenisSize2>>
					<<set $_text_output += ` 및 ${$_penisSize[_args[0].npcPenisSize2 - 1]} ${$_penisDesc[_args[0].npcPenisdesc2] || _args[0].npcPenisdesc2}`>>
				<</if>>
			<</if>>
		<</if>>
		<<switch _args[0].passage>>
			<<case "Tutorial">><<set $_special to "비명 지르는 법도 몰랐음">>
			<<case "Brothel Show Virginity Sex">><<set $_special to "가장 높은 값을 부른 자에게 팔림">>
			<<case "Brothel Show Virginity Rape">><<set $_special to "가장 높은 값을 부른 자에게 빼앗김">>
			<<case "Sydney Temple Pure Sex">>
				<<if _args[2] is 'npc' and setup.loveInterestNpc.includes(_args[1])>>
					<<set $_special to "약속한 상대에게 바침">>
				<<else>>
					<<set $_special to "약속한 상대에게 바침">>
				<</if>>
			<<case "Sydney Temple Corrupt Sex">><<set $_special to "신전에서 더럽혀짐">>
			<<case "Estate Cards Sex">><<set $_special to "도박으로 잃음">>
			<<case "Underground Robin Kiss Intro">>
				<<set $_special to "함께 목줄을 찬 채 빼앗김">>
			<<case "Underground Robin Kiss Molestation">>
				/* This expected this detail to be only visible for the player's virginity */
				<<if _args[2] is "pc">>
					<<set $_sameTime to "">>
					<<set $_asRobins to "">>
					<<set $_eachOther to "로빈">>
					<<set $_otherVirginity to C.npc.Robin?.virginityDetails?.[_args[3]]?.passage is "Underground Robin Kiss Molestation" ? _args[3] : undefined>>
					<<if !$_otherVirginity>>
						<<set $_otherVirginity to C.npc.Robin?.virginityDetails?.vaginal?.passage is "Underground Robin Kiss Molestation" ? "vaginal" : (C.npc.Robin?.virginityDetails?.anal?.passage is "Underground Robin Kiss Molestation" ? "anal" : undefined)>>
					<</if>>
					<<if $_otherVirginity>>
						<<if Math.abs(_args[0]?.timestamp - C.npc.Robin.virginityDetails[$_otherVirginity].timestamp) lte 1000>>
							<<set $_sameTime to "동시에 ">>
						<<else>>
							<<set $_sameTime to "비슷한 상황에서 ">>
						<</if>>
						<<set $_asRobins to `as Robin's ${$_otherVirginity is _args[3] ? "" : ($_otherVirginity + " virginity ")}`>>
						<<set $_eachOther to "서로">>
					<</if>>
					<<set $_special to `${$_sameTime}${$_eachOther}와 입맞추던 중 빼앗김`>>
				<</if>>
			<<case "Moor Phallus Plant Masturbation">>
				<<set $_special to "쾌락에 미쳐버림">>
			<<case "Forest Shop Caught Distract">>
				<<set $_special to "그윌란이 입 가득한 상황에서 빠져나오도록 도움">>
			<<default>>
				<<if _args[0].passage?.includes("Gwylan Ritual Sex")>>
					<<if ["vaginal", "penile"].includes(_args[3]) and $gwylanSeen?.includes("fallen_angel")>>
						<<set $_special to "숲을 정화하기 위해 마녀에게 굴복함">>
					<<elseif _args[3] is "kiss">>
						<<set $_special to "격정 속에서 그윌란의 첫 번째 규칙을 어김">>
					<<else>>
						<<set $_special to "숲을 정화하기 위해 기꺼이 바침">>
					<</if>>
				<<elseif _args[0].npcPenisSize gte 5>>
					<<set $_special to `${_args[3] is "vaginal" ? "가장 잔혹한 방식으로 망가짐" : "가장 잔혹한 방식으로 빼앗김"}`>>
				<<elseif _args[0].npcPenisSize2 isnot undefined>>
					<<set $_special to "한 번에 둘에게 빼앗김">>
				<</if>>
		<</switch>>
		<<if $_special>><<set $_text_output += `<div class="lewd">특수: ${$_special}</div>`>><</if>>
		<<if isPossibleLoveInterestVirginity(_args[1]) and $_linkColour isnot "red">>
			<<set $_linkColour to "lewd">>
		<</if>>
	<</if>>
<</silently>><<if $_text_output>> <mouse @class="'tooltip ' + $_linkColour">(?)<span><<print $_text_output>></span></mouse><</if>>
<</widget>>

<<widget "badEndStats">>
	<<set $_badEndStats to clone($badEndStats)>>
	<<run $_badEndStats.forEach(badEnd => {
		if (badEnd.reasonStart and setup.badEndReasonText[badEnd.reasonStart]) badEnd.reasonStart = setup.badEndReasonText[badEnd.reasonStart];
		if (badEnd.reasonEnd and setup.badEndReasonText[badEnd.reasonEnd]) badEnd.reasonEnd = setup.badEndReasonText[badEnd.reasonEnd];
	})>>
	<span @class="_badEndStatsHowLongAgo ? 'goldLink' : ''">
		<<link `_badEndStatsHowLongAgo ? "얼마나 지났는지 숨기기" : "얼마나 지났는지 표시하기"`>>
			<<set _badEndStatsHowLongAgo to !_badEndStatsHowLongAgo>>
			<<if !_badEndStatsHowLongAgo>><<unset _badEndStatsHowLongAgo>><</if>>
			<<replace "#badEndStatsDiv">><<badEndStats>><</replace>>
		<</link>>
	</span> |
	<span @class="_badEndStatsReasonStart ? 'goldLink' : ''">
		<<link `_badEndStatsReasonStart ? "시작된 이유 숨기기" : "시작된 이유 표시하기"`>>
			<<set _badEndStatsReasonStart to !_badEndStatsReasonStart>>
			<<if !_badEndStatsReasonStart>><<unset _badEndStatsReasonStart>><</if>>
			<<replace "#badEndStatsDiv">><<badEndStats>><</replace>>
		<</link>>
	</span> |
	<span @class="_badEndStatsReasonEnd ? 'goldLink' : ''">
		<<link `_badEndStatsReasonEnd ? "끝난 이유 숨기기" : "끝난 이유 표시하기"`>>
			<<set _badEndStatsReasonEnd to !_badEndStatsReasonEnd>>
			<<if !_badEndStatsReasonEnd>><<unset _badEndStatsReasonEnd>><</if>>
			<<replace "#badEndStatsDiv">><<badEndStats>><</replace>>
		<</link>>
	</span>
	<<if _badEndStatsSorting>>
		| <<link "정렬 초기화">>
			<<unset _badEndStatsSorting>>
			<<replace "#badEndStatsDiv">><<badEndStats>><</replace>>
		<</link>>
		<<run $_badEndStats.sort((a, b) => {
			if (_badEndStatsSorting.includes("Desc")) {
				const tempSwap = clone(a);
				a = clone(b);
				b = tempSwap;
			}
			switch(_badEndStatsSorting.replace("Desc","")) {
				case "Bad End":
					if (a.source.toUpperCase() < b.source.toUpperCase()) return -1;
					return 1;
				case "Started":
					return (b.trackedStart || 0) - (a.trackedStart || 0);
				case "Ended": case "Time since it ended":
					return (b.trackedEnd || 0) - (a.trackedEnd || 0);
				case "Duration":
					return ((b.trackedEnd || 0) - b.trackedStart) - ((a.trackedEnd || 0) - a.trackedStart);
				case "Start Reason":
					if ((a.reasonStart || "").toUpperCase() < (b.reasonStart || "").toUpperCase()) return -1;
					return 1;
				case "End Reason":
					if ((a.reasonEnd || "").toUpperCase() < (b.reasonEnd || "").toUpperCase()) return -1;
					return 1;
			}
		})>>
	<</if>>

	<table class="statsTable">
		<thead>
			<tr>
				<th scope="col"><<badEndStatsTitle "Bad End">></th>
				<th scope="col"><<badEndStatsTitle "Started">></th>
				<th scope="col"><<badEndStatsTitle "Ended">></th>
				<th scope="col"><<badEndStatsTitle "Duration">></th>
				<<if _badEndStatsHowLongAgo>>
					<th scope="col"><<badEndStatsTitle "How Long Ago">></th>
				<</if>>
				<<if _badEndStatsReasonStart>>
					<th scope="col"><<badEndStatsTitle "Start Reason">></th>
				<</if>>
				<<if _badEndStatsReasonEnd>>
					<th scope="col"><<badEndStatsTitle "End Reason">></th>
				<</if>>
			</tr>
		</thead>
		<<for $_badEnd range $_badEndStats>>
			<tbody class="stat">
				<td data-label="Bad End">
					<<badEndProse $_badEnd.source>>
					<<if $_badEnd.notesStart or $_badEnd.notesEnd>>
						<<set $_includesError to $_badEnd?.notesStart?.includes("Not correctly tracked") or $_badEnd?.notesEnd?.includes("Not correctly tracked")>>
						<mouse @class="'tooltip ' + ($_includesError ? 'red' : 'linkBlue')">(?)<span>
							<<if $_badEnd.notesStart>><<print $_badEnd.notesStart>><</if>>
							<<if $_badEnd.notesEnd>>
								<<if $_badEnd.notesStart>><hr><</if>>
								<<print $_badEnd.notesEnd>>
							<</if>>
						</span></mouse>
					<</if>>
				</td>
				<td data-label="Started">
					<<set $_time to new DateTime($_badEnd.trackedStart)>>
					<<switch $options.dateFormat>>
						<<case "en-US">>
							시작됨: $_time.month월 $_time.day일 $_time.year년
						<<case "zh-CN">>
							시작됨: $_time.year년 $_time.month월 $_time.day일
						<<default>>
							시작됨: $_time.day일 $_time.month월 $_time.year년
					<</switch>>
				</td>
				<td data-label="Ended">
					<<if $_badEnd.trackedEnd>>
						<<set $_time2 to new DateTime($_badEnd.trackedEnd)>>
						<<switch $options.dateFormat>>
							<<case "en-US">>
								종료됨: $_time2.month월 $_time2.day일 $_time2.year년
							<<case "zh-CN">>
								종료됨: $_time2.year년 $_time2.month월 $_time2.day일
							<<default>>
								종료됨: $_time2.day일 $_time2.month월 $_time2.year년
						<</switch>>
					<<else>>
						<span class="dash"></span>
					<</if>>
				</td>
				<td data-label="Duration">
					<<if $_badEnd.trackedEnd>>
						<<statisticsTimeCompare $_time $_time2>>
					<<else>>
						진행 중
					<</if>>
				</td>
				<<if _badEndStatsHowLongAgo>>
					<td data-label="How Long Ago">
						<<if $_badEnd.trackedEnd>>
							<<statisticsTimeCompare $_time2>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
				<</if>>
				<<if _badEndStatsReasonStart>>
					<td data-label="Start Reason">
						<<if setup.badEndReasonText[$_badEnd.reasonStart] isnot undefined>>
							<<print setup.badEndReasonText[$_badEnd.reasonStart] or '<span class="dash">-</span>'>>
						<<elseif $_badEnd.reasonStart>>
							<<print $_badEnd.reasonStart>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
				<</if>>
				<<if _badEndStatsReasonEnd>>
					<td data-label="End Reason">
						<<if setup.badEndReasonText[$_badEnd.reasonEnd] isnot undefined>>
							<<print setup.badEndReasonText[$_badEnd.reasonEnd] or '<span class="dash">-</span>'>>
						<<elseif $_badEnd.reasonEnd>>
							<<print $_badEnd.reasonEnd>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
				<</if>>
			</tbody>
		<</for>>
	</table>
<</widget>>

<<widget "badEndStatsTitle">><<silently>>
	<<set $_display to ({ "Bad End": "배드 엔딩", Started: "시작", Ended: "종료", Duration: "지속 시간", "How Long Ago": "지난 시간", "Start Reason": "시작 이유", "End Reason": "종료 이유" }[_args[0]] || _args[0])>>
	<<if _badEndStatsSorting is _args[0]>>
		<<set $_text_output to ` <<link "${$_display}&#x25B2;">><<set _badEndStatsSorting to "${_args[0]}Desc">><<replace "#badEndStatsDiv">><<badEndStats>><</replace>><</link>>`>>
	<<elseif _badEndStatsSorting is _args[0] + "Desc">>
		<<set $_text_output to ` <<link "${$_display}&#x25BC;">><<unset _badEndStatsSorting>><<replace "#badEndStatsDiv">><<badEndStats>><</replace>><</link>>`>>
	<<else>>
		<<set $_text_output to ` <<link "${$_display}">><<set _badEndStatsSorting to "${_args[0]}">><<replace "#badEndStatsDiv">><<badEndStats>><</replace>><</link>>`>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "produceStats">>
	<<set $_produceKeys to Object.keys(clone(setup.foodstuff))>>
	<span @class="_produceStatsCurrent ? '' : 'goldLink'">
		/* Inverted in how it works */
		<<link `_produceStatsCurrent ? "플레이어 통계 표시하기" : "플레이어 통계 숨기기"`>>
			<<set _produceStatsCurrent to !_produceStatsCurrent>>
			<<replace "#produceStatsDiv">><<produceStats>><</replace>>
		<</link>>
	</span> |
	<<if $stall_stats>>
		<<if $daily.stallRented>>
			<span @class="_produceStatsMarket ? 'goldLink' : ''">
				<<link `_produceStatsMarket ? "시장 일일 통계 숨기기" : "시장 일일 통계 표시하기"`>>
					<<set _produceStatsMarket to !_produceStatsMarket>>
					<<replace "#produceStatsDiv">><<produceStats>><</replace>>
				<</link>>
			</span> |
		<</if>>
		<span @class="_produceStatsMarketOverall ? 'goldLink' : ''">
			<<link `_produceStatsMarketOverall ? "시장 전체 통계 숨기기" : "시장 전체 통계 표시하기"`>>
				<<set _produceStatsMarketOverall to !_produceStatsMarketOverall>>
				<<replace "#produceStatsDiv">><<produceStats>><</replace>>
			<</link>>
		</span> |
	<</if>>
	<<if $farmersProduce?.soldData>>
		<span @class="_produceStatsFactory ? 'goldLink' : ''">
			<<link `_produceStatsFactory ? "공장 통계 숨기기" : "공장 통계 표시하기"`>>
				<<set _produceStatsFactory to !_produceStatsFactory>>
				<<replace "#produceStatsDiv">><<produceStats>><</replace>>
			<</link>>
		</span> |
	<</if>>
	<<if _produceStatsSorting>>
		<<link "정렬 초기화">>
			<<unset _produceStatsSorting>>
			<<replace "#produceStatsDiv">><<produceStats>><</replace>>
		<</link>>
		<<run $_produceKeys.sort((a, b) => {
			if (_produceStatsSorting.includes("Desc")) {
				const tempSwap = clone(a);
				a = clone(b);
				b = tempSwap;
			}
			switch(_produceStatsSorting.replace("Desc","")) {
				case "Produce":
					if (a.toUpperCase() < b.toUpperCase()) return -1;
					return 1;
				case "Value":
					return setup.foodstuff[b].shop.sell_price - setup.foodstuff[a].shop.sell_price;
				case "Amount":
					return ($foodstuff[b].amount || 0) - ($foodstuff[a].amount || 0);
				case "Total":
					return (setup.foodstuff[b].shop.sell_price * $foodstuff[b].amount || 0) - (setup.foodstuff[a].shop.sell_price * $foodstuff[a].amount || 0);
				case "Market: Allowed to be sold":
					return $foodstuff[b]?.marketStall ? 1 : -1;
				case "Market: Sold Today":
					return ($stall_stats[b]?.sold.amount || 0) - ($stall_stats[a]?.sold.amount || 0);
				case "Market: Average Today":
					return (($stall_stats[b].sold.total || 0) / ($stall_stats[b]?.sold.amount || 1)) - (($stall_stats[a].sold.total || 0) / ($stall_stats[a]?.sold.amount || 1));
				case "Market: Todays Total":
					return ($stall_stats[b]?.sold.total || 0) - ($stall_stats[a]?.sold.total || 0);
				case "Market: Sold":
					return ($stall_stats[b]?.sold.amountHistory || 0) - ($stall_stats[a]?.sold.amountHistory || 0);
				case "Market: Average":
					return (($stall_stats[b].sold.totalHistory || 0) / ($stall_stats[b]?.sold.amountHistory || 1)) - (($stall_stats[a].sold.totalHistory || 0) / ($stall_stats[a]?.sold.amountHistory || 1));
				case "Market: Total":
					return ($stall_stats[b]?.sold.totalHistory || 0) - ($stall_stats[a]?.sold.totalHistory || 0);
				case "Factory: Sold":
					return ($farmersProduce.soldData[b]?.amount || 0) - ($farmersProduce.soldData[a]?.amount || 0);
				case "Factory: Average":
					return (($farmersProduce.soldData[b]?.total || 0) / ($farmersProduce.soldData[b]?.amount || 1)) - (($farmersProduce.soldData[a]?.total || 0) / ($farmersProduce.soldData[a]?.amount || 1));
				case "Factory: Total":
					return ($farmersProduce.soldData[b]?.total || 0) - ($farmersProduce.soldData[a]?.total || 0);
			}
		})>>
	<</if>>
	<table class="statsTable">
		<thead>
			<tr>
				<th scope="col"><<produceStatsTitle "Produce">></th>
				<th scope="col"><<produceStatsTitle "Value">></th>
				<<if !_produceStatsCurrent>>
					<th scope="col"><<produceStatsTitle "Amount">></th>
					<th scope="col"><<produceStatsTitle "Total">></th>
				<</if>>
				<<if _produceStatsMarket or _produceStatsMarketOverall>>
					<th scope="col"><<produceStatsTitle "Market: Allowed to be sold">></th>
				<</if>>
				<<if _produceStatsMarket>>
					<th scope="col"><<produceStatsTitle "Market: Sold Today">></th>
					<th scope="col"><<produceStatsTitle "Market: Average Today">></th>
					<th scope="col"><<produceStatsTitle "Market: Todays Total">></th>
				<</if>>
				<<if _produceStatsMarketOverall>>
					<th scope="col"><<produceStatsTitle "Market: Sold">></th>
					<th scope="col"><<produceStatsTitle "Market: Average">></th>
					<th scope="col"><<produceStatsTitle "Market: Total">></th>
				<</if>>
				<<if _produceStatsFactory>>
					<th scope="col"><<produceStatsTitle "Factory: Sold">></th>
					<th scope="col"><<produceStatsTitle "Factory: Average">></th>
					<th scope="col"><<produceStatsTitle "Factory: Total">></th>
				<</if>>
			</tr>
		</thead>
		<<for $_key range $_produceKeys>>
			<<set $_produce to clone(setup.foodstuff[$_key])>>
			<<set $_playerProduce to clone($foodstuff[$_key])>>
			<<if $_playerProduce.amount lte 0 and
			!$stall_stats?.[$_key]?.sold.amount and !$stall_stats?.[$_key]?.sold.amountHistory and
			!$farmersProduce?.selling[$_key] and !$farmersProduce?.soldData?.[$_key]>>
				<<continue>>
			<</if>>
			<tbody class="stat">
				<td data-label="Produce">
					<<recipe_name $_key>>
				</td>
				<td data-label="Value">
					<<printmoney `$_produce?.shop?.sell_price ?? 0`>>
				</td>
				<<if !_produceStatsCurrent>>
					<td data-label="Amount">
						<<if $_playerProduce.amount gt 0>>
							<<print $_playerProduce.amount>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
					<td data-label="Total">
						<<if $_playerProduce.amount gt 0>>
							<<printmoney `($_produce?.shop?.sell_price ?? 0) * $_playerProduce.amount`>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
				<</if>>
				<<if _produceStatsMarket or _produceStatsMarketOverall>>
					<td data-label="Market: Allowed to be sold">
						<<if $foodstuff[$_key]?.marketStall isnot undefined>>
							<<print $foodstuff[$_key].marketStall>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
				<</if>>
				<<if _produceStatsMarket>>
					<td data-label="Market: Sold Today">
						<<if $stall_stats[$_key]?.sold.amount gt 0>>
							<<print $stall_stats[$_key].sold.amount>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
					<td data-label="Market: Average Today">
						<<if $stall_stats[$_key]?.sold.amount gt 0>>
							<<printmoney `$stall_stats[$_key].sold.total / $stall_stats[$_key].sold.amount`>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
					<td data-label="Market: Todays Total">
						<<if $stall_stats[$_key]?.sold.total gt 0>>
							<<printmoney $stall_stats[$_key].sold.total>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
				<</if>>
				<<if _produceStatsMarketOverall>>
					<td data-label="Market: Sold">
						<<if $stall_stats[$_key]?.sold.amountHistory gt 0>>
							<<print $stall_stats[$_key].sold.amountHistory>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
					<td data-label="Market: Average">
						<<if $stall_stats[$_key]?.sold.amountHistory gt 0>>
							<<printmoney `$stall_stats[$_key].sold.totalHistory / $stall_stats[$_key].sold.amountHistory`>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
					<td data-label="Market: Total">
						<<if $stall_stats[$_key]?.sold.totalHistory gt 0>>
							<<printmoney $stall_stats[$_key].sold.totalHistory>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
				<</if>>
				<<if _produceStatsFactory>>
					<td data-label="Factory: Sold">
						<<if $farmersProduce.soldData[$_key]?.amount gt 0>>
							<<print $farmersProduce.soldData[$_key].amount>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
					<td data-label="Factory: Average">
						<<if $farmersProduce.soldData[$_key]?.amount gt 0>>
							<<printmoney `$farmersProduce.soldData[$_key].total / $farmersProduce.soldData[$_key].amount`>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
					<td data-label="Factory: Total">
						<<if $farmersProduce.soldData[$_key]?.total gt 0>>
							<<printmoney $farmersProduce.soldData[$_key].total>>
						<<else>>
							<span class="dash">-</span>
						<</if>>
					</td>
				<</if>>
			</tbody>
		<</for>>
	</table>
<</widget>>

<<widget "produceStatsTitle">><<silently>>
	<<set $_display to ({ 
    Produce: "농작물", 
    Value: "가치", 
    Amount: "수량", 
    Total: "판매 합계", 
    "Market: Allowed to be sold": "시장: 판매 허용", 
    "Market: Sold Today": "시장: 오늘 판매량", 
    "Market: Average Today": "시장: 오늘 평균", 
    "Market: Todays Total": "시장: 오늘 매출", 
    "Market: Sold": "시장: 판매량", 
    "Market: Average": "시장: 평균", 
    "Market: Total": "시장: 매출", 
    "Factory: Sold": "공장: 판매량", 
    "Factory: Average": "공장: 평균", 
    "Factory: Total": "공장: 매출" 
	}[_args[0]] || _args[0])>>
	<<if _produceStatsSorting is _args[0]>>
		<<set $_text_output to ` <<link "${$_display}&#x25B2;">><<set _produceStatsSorting to "${_args[0]}Desc">><<replace "#produceStatsDiv">><<produceStats>><</replace>><</link>>`>>
	<<elseif _produceStatsSorting is _args[0] + "Desc">>
		<<set $_text_output to ` <<link "${$_display}&#x25BC;">><<unset _produceStatsSorting>><<replace "#produceStatsDiv">><<produceStats>><</replace>><</link>>`>>
	<<else>>
		<<set $_text_output to ` <<link "${$_display}">><<set _produceStatsSorting to "${_args[0]}">><<replace "#produceStatsDiv">><<produceStats>><</replace>><</link>>`>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>
