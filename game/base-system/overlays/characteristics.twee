:: Characteristics [widget]

<<widget "characteristics">>
	<br>
	당신은
	<<if $wraithSkin>>
		정령
	<<elseif $wolfgirl gte 6 or $cat gte 6 or $cow gte 6 or $harpy gte 6 or $fox gte 6>>
		<<if $angel gte 6>>
			천사 같은
		<<elseif $fallenangel gte 2>>
			타락한
		<<elseif $demon gte 6>>
			악마 같은
		<<elseif $dryad gte 6>>
			파릇파릇한
		<<else>>
		<</if>>
		<<if $wolfgirl gte 6 and ($demon gte 6 or $fallenangel gte 2)>>
			헬하운드
		<<elseif $wolfgirl gte 6 and $angel gte 6>>
			개
		<<elseif $wolfgirl gte 6>>
			늑대
		<<elseif $cat gte 6>>
			고양이
		<<elseif $cow gte 6>>
			<<if $player.gender_appearance is "m">>
				황소
			<<else>>
				젖소
			<</if>>
		<<elseif $harpy gte 6>>
			<<if $hallucinations gte 2 or !$settings.bestialityEnabled>>
				하피
			<<else>>
				새
			<</if>>
		<<elseif $fox gte 6>>
			여우
		<</if>>
	<<else>>
		<<if $angel gte 6>>
			천사
		<<elseif $fallenangel gte 2>>
			타락 천사
		<<elseif $demon gte 6>>
			악마
		<<elseif $dryad gte 6>>
			인간형 식물
		<<else>>
			<<if $player.gender is "n">><</if>>
		<</if>>
	<</if>>
	<<pcGender>>입니다.
	<br><br>

	<<switch $bodysize>>
		<<case 0>>다른 사람들보다 매우 작으며,
		<<case 1>>다른 사람들보다 작으며,
		<<case 2>>보통 키며,
		<<case 3>>다른 사람들보다 크며,
	<</switch>>

	<!-- Eye details -->
	<<print window.buildEyeDetails()>>
	<!-- -->

	피부는 <<skintonetext>>에 <<skincolourtext>>【이】며, 
	<<if $player.breastsize gte 1>>
		<<if $player.breastsize is $player.perceived_breastsize>>
			<<breasts>>【을를】 지녔습니다.
		<<else>>
			<<breasts>>【을를】 지녔지만, 옷에
			<<if $player.perceived_breastsize is 0>>
				가려져서 평평해 보입니다.
			<<elseif $player.perceived_breastsize lt $player.breastsize>>
				가려져서 <<breastsizedesc $player.perceived_breastsize>> 사이즈로 보입니다.
			<<else>> /*if $player.perceived_breastsize gt $player.breastsize*/
				옷에 받쳐져서 <<breastsizedesc $player.perceived_breastsize>> 사이즈로 보입니다.
			<</if>>
		<</if>>
	<<elseif $player.breastsize is 0 and $player.perceived_breastsize gte 1>>
		당신의 가슴은 평평하지만, 옷에 패드가 들어있어 <<breastsizedesc $player.perceived_breastsize>> 사이즈로 보입니다.
	<</if>>
	<<bottom true>>【을를】 지녔으며,
	<<if $player.penisExist and $player.vaginaExist>>
		<<silently>>
			<<penis false true>><<set _penis to _text_output>>
			<<pussy false true>><<set _pussy to _text_output>>
		<</silently>>
		_penis【와과】 _pussy【을를】 지니고 있습니다.
	<<else>>
		지금
		<<if $player.penisExist>>
			<<silently>><<penis false true>><<set _penis to _text_output>><</silently>>
			_penis【을를】 지니고 있습니다.
		<</if>>
		<<if $player.vaginaExist>>
			<<silently>><<pussy false true>><<set _pussy to _text_output>><</silently>>
			_pussy【을를】 지니고 있습니다.
		<</if>>
	<</if>>

	<!--Hair Details-->
	<<set _hairTextConfig = { currentValue : $hairlength, states : [
			{ requiredValue: 0, color: '', preText: '', description: '<<haircolourtext>>', postText: ' 머리는 짧습니다.' },
			{ requiredValue: 100, color: '', preText: '', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 턱 아래까지 내려오며, <<fringedescription>>' },
			{ requiredValue: 200, color: '', preText: '', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 어깨까지 내려오고, <<fringedescription>>' },
			{ requiredValue: 300, color: '', preText: '꽤 긴 ', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 가슴 위까지 내려오며, <<fringedescription>>' },
			{ requiredValue: 400, color: '', preText: '긴 ', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 유두까지 늘어지고, <<fringedescription>>' },
			{ requiredValue: 500, color: '', preText: '긴 ', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 배 위까지 닿으며, <<fringedescription>>' },
			{ requiredValue: 600, color: '', preText: '긴 ', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 배꼽까지 닿으며, <<fringedescription>>' },
			{ requiredValue: 700, color: '', preText: '매우 긴 ', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 허벅지까지 닿으며, <<fringedescription>>' },
			{ requiredValue: 800, color: '', preText: '매우 긴 ', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 무릎까지 닿으며, <<fringedescription>>' },
			{ requiredValue: 900, color: '', preText: '엄청나게 긴 ', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 발목까지 닿으며, <<fringedescription>>' },
			{ requiredValue: 1000, color: '', preText: '걸려 넘어지지 않도록 조심해야 하는 긴 ', description: '<<haircolourtext>>', postText: ' 머리는 풀어두면 바닥에 끌리며, <<fringedescription>>' }
		]
	}>>
	<<characteristic-text _hairTextConfig>>
	<br><br>

	<!--Pregnancy Details-->
	<<set $_menstruation to $sexStats.vagina.menstruation>>
	<<set $_pills to $sexStats.pills>>
	<<set $_knowsTheyCanBecomePregnant to ($settings.playerPregnancyHumanEnabled or $settings.playerPregnancyBeastEnabled) and playerAwareTheyCanBePregnant()>>
	<<set $_heatArousal to playerHeatMinArousal()>>
	<<set $_rutArousal to playerRutMinArousal()>>
	<<set $_heatRutDisplay to ($_heatArousal and playerAwareTheyAreInHeat() ? "heat" : "") + ($_heatArousal and playerAwareTheyAreInHeat() and $_rutArousal ? " and " : "") + ($_rutArousal ? "rut" : "")>>
	<<set _preg to currentBodyPregnancies().find(p => knowsPregnancy(p.pregnancyId, "pc"))>>
	<<if _preg>>
		<<set _progress to pregnancyProgress(_preg)>>
		<<if _progress lte 0.33>>
			<<set _trimester to "초">>
		<<elseif _progress lte 0.66>>
			<<set _trimester to "중">>
		<<else>>
			<<set _trimester to "후">>
		<</if>>
		<<set _litter to getChildrenOf(_preg.pregnancyId)>>
		<<set _species to childBaseSpecies(_preg.donorSpecies)>>
		<<if playerKnowsLitterSpecies(_preg)>>
			<<if playerKnowsLitterDetails(_preg)>>
				<<set $_number to _litter.length>>
			<<elseif _preg.awareOfMultiple>>
				<<set $_number to _litter.length is 1 ? 1 : "more than one">>
			<<else>>
				<<set $_number to "an unknown number of">>
			<</if>>
			<<switch _species>>
				<<case "human">>
					<<if $_number isnot "an unknown number of" and $_number isnot "more than one" and $_number gt 1>>
						<<set _childType to "">>
						<<if _litter[0].identical isnot null and playerKnowsLitterDetails(_preg)>>
							<<set _childType += "identical ">>
						<</if>>
						<<set _childType += ($_number is 3 ? "세쌍둥이" : "쌍둥이")>>
					<<else>>
						<<set _childType to ($_number is 1 || $_number is "more than one" ? "아기" : "아기들")>>
					<</if>>
				<<case "wolf">>
					<<set _childType to ($_number is 1 || $_number is "more than one" ? "늑대 새끼" : "늑대 새끼들")>>
				<<case "hawk">>
					<<set _childType to ($_number is 1 || $_number is "more than one" ? "매 알" : "매 알들")>>
			<</switch>>
			<<if _species is "hawk">>
				당신은 <<number $_number>>마리의 _childType【을를】 품고 있으며,
				<<switch _trimester>>
					<<case "first">><<if $_number is 1>>알을<<else>>알들을<</if>> 낳으려면 아직 멀었습니다.
					<<case "second">>하지만 <<if $_number is 1>>알을<<else>>알들을<</if>> 낳기까지는 아직 시간이 좀 더 걸립니다.
					<<case "third">>곧 <<if $_number is 1>>알을<<else>>알들을<</if>> 낳을 준비가 될 것입니다.
				<</switch>>
			<<else>>
				당신은 임신 _trimester기이며, <<if !["twins", "identical twins", "triplets"].includes(_childType)>>$_number명의 <</if>>_childType【을를】 임신 중입니다.
			<</if>>
		<<else>>
			당신은 자신이 임신 _trimester기라는 것을 알고 있습니다.
		<</if>>
		<<if between(_progress, 0.1, 1) and !$daily.ultrasoundDone>>
			<span class="blue">병원에서 초음파 검사를 받을 수 있습니다.</span>
		<</if>>
		<<if knowsDonor(_preg.pregnancyId, "pc")>>
			아이의 아버지가 <<print pregnancyNameCorrection(_preg.donor)>>【이】라는 것을 압니다.
		<<elseif _preg.possibleDonors.length is 1>>
			아이의 아버지가 <<print pregnancyNameCorrection(_preg.possibleDonors[0].name)>>【이】라는 것을 압니다.
		<<elseif _preg.possibleDonors.length is 2>>
			아이의 아버지가 <<print pregnancyNameCorrection(_preg.possibleDonors[0].name)>> 아니면 <<print pregnancyNameCorrection(_preg.possibleDonors[1].name)>>일 거라고 확신합니다.
		<<elseif _preg.possibleDonors.length is 3>>
			아이의 아버지가 <<print pregnancyNameCorrection(_preg.possibleDonors[0].name)>>, <<print pregnancyNameCorrection(_preg.possibleDonors[1].name)>>, 혹은 <<print pregnancyNameCorrection(_preg.possibleDonors[2].name)>> 중 한 명일 거라고 꽤 확신합니다.
		<<else>>
			아이의 아버지가 누구인지 모르겠습니다.
		<</if>>
		<br><br>
	<<elseif $_knowsTheyCanBecomePregnant and $_pills.pills.contraceptive.doseTaken>>
		<<if $_pills.pills.contraceptive.doseTaken gte 2>>
			피임약을 과다 복용해 임신 확률이 0으로 떨어졌습니다.
		<<else>>
			피임약을 복용해 임신 확률이 거의 0으로 떨어졌습니다.
		<</if>>
		<br><br>
	<<elseif $_knowsTheyCanBecomePregnant and (($sciencetrait gte 4 and $awareness gte 200) or $awareness gte 500)>>
		<<set $_risk to playerPregnancyRisk()>>
		<<if $_risk isnot undefined>>
			<<set _riskLabel to PregnancyConstants.riskMeterLabels[$_risk]>>
			<<set $_pregnancyRisk to _riskLabel.text>>
			<<set $_pregnancyRiskColour to _riskLabel.colour>>

			<<if $_heatArousal or $_rutArousal>>
				<<heatRutDisplay>>
				성관계는 <span @class="$_pregnancyRiskColour">$_pregnancyRisk</span>할겁니다.
			<<else>>
				성관계는 <span @class="$_pregnancyRiskColour">$_pregnancyRisk</span>하다고 생각합니다.
			<</if>>
			<br><br>
		<</if>>
	<<else>>
		<<heatRutDisplay true>>
	<</if>>

	<!--Semen Details-->
	<<if $player.penisExist and $player.penissize gte 1>>
		<<set _semenCapacityTextConfig = { currentValue : $semen_volume, preText: '당신은 ', states : [
{ requiredValue: 0, color: '', description: '정액을', postText: ' 생산하지 않는다.' },{ requiredValue: 1, color: 'red', description: '아주 적은', postText: ' 양의 정액을 생산하며, ' },{ requiredValue: 100, color: 'pink', description: '적은', postText: ' 양의 정액을 생산하며, ' },{ requiredValue: 300, color: 'purple', description: '적당한', postText: ' 양의 정액을 생산하며, ' },{ requiredValue: 500, color: 'blue', description: '꽤 많은', postText: ' 양의 정액을 생산하며, ' },{ requiredValue: 1000, color: 'lblue', description: '많은', postText: ' 양의 정액을 생산하며, ' },{ requiredValue: 1500, color: 'teal', description: '엄청난', postText: ' 양의 정액을 생산하며, ' },{ requiredValue: 2000, color: 'green', description: '경이로운', postText: ' 양의 정액을 생산하며, ' }			]
		}>>
		<<set _semenVolumeTextConfig = { currentValue : $semen_amount, states : [
{ requiredValue: 0, color: 'red', preText: "", description: "완전히 짜내 말랐습니다."},{ requiredValue: 1, color: 'pink', preText: "현재는 ", description: '거의 텅 비었습니다. '},{ requiredValue: ($semen_volume / 7) * 2, color: 'pink', preText: "현재는 ", description: '거의 바닥났습니다. '},{ requiredValue: ($semen_volume / 7) * 3, color: 'purple', preText: "현재는 ", description: '얼마 남지 않았습니다. '},{ requiredValue: ($semen_volume / 7) * 4, color: 'blue', preText: "현재는 ", description: '절반쯤 남아 있습니다. '},{ requiredValue: ($semen_volume / 7) * 5, color: 'lblue', preText: "현재는 ", description: '넉넉히 남아 있습니다. '},{ requiredValue: ($semen_volume / 7) * 6, color: 'teal', preText: "현재는 ", description: '거의 가득 차 있습니다. '},{ requiredValue: $semen_volume, color: 'green', preText: "현재는 ", description: '터질듯 가득 차 있습니다. '}			]
		}>>
		<<characteristic-text _semenCapacityTextConfig>>
		<<if $semen_volume gt 0>>
			<<characteristic-text _semenVolumeTextConfig>>
			<<if $semen_amount gte $semen_volume>>
				<<if $arousal gte ($arousalmax / 5) * 4>>
					이미 가득 차 있지만, <span class="pink">흥분으로 인해 최대 용량이 늘어났습니다.</span>
				<<elseif $arousal gte ($arousalmax / 5) * 3>>
					이미 가득 차 있지만, <span class="purple">흥분으로 인해 최대 용량이 늘어났습니다.</span>
				<</if>>
			<<else>>
				<<if $arousal gte ($arousalmax / 5) * 4>>
					<span class="pink">흥분 덕분에 회복이 빨라지고 있습니다.</span>
				<<elseif $arousal gte ($arousalmax / 5) * 3>>
					<span class="purple">흥분 덕분에 회복이 빨라지고 있습니다.</span>
				<</if>>
			<</if>>
		<</if>>
		<br>
	<</if>>

	<!--Lactation Details-->
	<<if $lactating is 1 and $settings.breastFeedingEnabled>>
		<<set _milkCapacityTextConfig = { currentValue : $milk_volume, preText: '<<breasts>>【은는】 ', postText: ' 양의 모유를 생산하며, ', states : [
{ requiredValue: 0, color: 'red', description: '아주 적은'},{ requiredValue: 100, color: 'pink', description: '적은'},{ requiredValue: 300, color: 'purple', description: '제한적인'},{ requiredValue: 500, color: 'blue', description: '꽤 많은'},{ requiredValue: 1000, color: 'lblue', description: '많은'},{ requiredValue: 1500, color: 'teal', description: '엄청난'},{ requiredValue: 2000, color: 'green', description: '경이로운'}				]
			}>>
		<<set _milkVolumeTextConfig = { currentValue : $milk_amount, states : [
{ requiredValue: 0, color: 'red', preText: "", description: " 완전히 짜내 말랐습니다."},{ requiredValue: 1, color: 'pink', preText: "현재는 ", description: ' 거의 텅 비었습니다.'},{ requiredValue: ($milk_volume / 7) * 2, color: 'pink', preText: "현재는 ", description: ' 거의 바닥났습니다.'},{ requiredValue: ($milk_volume / 7) * 3, color: 'purple', preText: "현재는 ", description: ' 얼마 남지 않았습니다.'},{ requiredValue: ($milk_volume / 7) * 4, color: 'blue', preText: "현재는 ", description: ' 절반쯤 남아 있습니다.'},{ requiredValue: ($milk_volume / 7) * 5, color: 'lblue', preText: "현재는 ", description: ' 넉넉히 남아 있습니다.'},{ requiredValue: ($milk_volume / 7) * 6, color: 'teal', preText: "현재는 ", description: ' 거의 가득 차 있습니다.'},{ requiredValue: $milk_volume, color: 'green', preText: "현재는 ", description: ' 넘칠 듯이 가득 차 있습니다.'}			]
		}>>
		<<characteristic-text _milkCapacityTextConfig>>
		<<characteristic-text _milkVolumeTextConfig>>
		<<if $milkFullPain and $milkFullPain gt 200>>
			오랫동안 가득 차 있어 통증이 느껴집니다.
			<<if !$player.inventory.sextoys["breast pump"] and $milkFullPain gt 225>><span class="gold">약국에서 유축기를 사면 도움이 될 것입니다.</span><</if>>
		<</if>>
		<br>
	<</if>>

	<<set _holeWetnessStates = [
{ requiredValue: 0, color: 'green', description: '말라 있습니다.', postText: ' 삽입은 어려울 것입니다.' },{ requiredValue: 15, color: 'teal', description: '조금 미끈거립니다.', postText: ' 아주 작은 자지가 아니라면 삽입하기 어려울 것입니다.' },{ requiredValue: 30, color: 'lblue', description: '미끈거립니다.', postText: ' 대부분의 자지는 삽입하기 힘들 것입니다.' },{ requiredValue: 45, color: 'blue', description: '축축합니다.', postText: ' 일부 자지는 어려움 없이 삽입할 수 있을 것입니다.' },{ requiredValue: 60, color: 'purple',description: '젖어 있습니다.', postText: ' 대부분의 자지가 쉽게 미끄러져 들어올 수 있을 것입니다.' },{ requiredValue: 75, color: 'pink', description: '뚝뚝 떨어질 만큼 젖어 있습니다.', postText: ' 가장 큰 자지를 제외하면 쉽게 미끄러져 들어올 수 있을 것입니다.' },{ requiredValue: 90, color: 'red', description: '흠뻑 젖어 있습니다.', postText: ' 아무리 큰 자지라도 쉽게 미끄러져 들어올 수 있을 것입니다.' }	]>>
	<!--Vagina Wetness-->
	<<if $player.vaginaExist>>
		<<set _vaginaWetnessTextConfig = { currentValue : $vaginaWetness, preText: '보지는 ', states: _holeWetnessStates}>>
		<<characteristic-text _vaginaWetnessTextConfig>>
		<br>
	<</if>>
	<!--Penis Wetness-->
	<<if $player.penisExist>>
		<<set _penisWetnessTextConfig = { currentValue : $penisWetness, preText: '자지는 ', states: [
{ requiredValue: 0, color: 'green', description: '말라 있습니다.', postText: ($player.penissize >= 4) ? " 삽입하기 어려울 수도 있습니다." : ''},{ requiredValue: 15, color: 'teal', description: '조금 미끈거립니다.', postText: ''},{ requiredValue: 30, color: 'lblue', description: '미끈거립니다.', postText: ''},{ requiredValue: 45, color: 'blue', description: '축축합니다.', postText: ''},{ requiredValue: 60, color: 'purple',description: '젖어 있습니다.', postText: ''},{ requiredValue: 75, color: 'pink', description: '뚝뚝 떨어질 만큼 젖어 있습니다.', postText: ''},{ requiredValue: 90, color: 'red', description: '충분히 윤활되어 있습니다.', postText: ($player.penissize >= 6) ? " 이 정도 크기라도 어디든 미끄러져 들어가는 데 큰 어려움은 없을 것입니다." : ''}		]}>>
		<<characteristic-text _penisWetnessTextConfig>>
		<br>
	<</if>>
	<!--Anal Wetness-->
	<<if $settings.analEnabled>>
		<<set _analWetnessTextConfig = { currentValue : $anusWetness, preText: '항문은 ', states: _holeWetnessStates}>>
		<<characteristic-text _analWetnessTextConfig>>
	<</if>>

	<br><br>
	<<bodywriting>>
	<div id="characteristics-display">

		<br>
		<span class="gold">핵심 특성</span>
		<div id="base-characteristics" class="characteristic-box-list">
			<!--Core skill configurations-->
			<<silently>>

				<!--PURITY-->
				<<if $demon gte 6>>
					<<set _purityIcon='ui/tf-demon'>>
				<<elseif $fallenangel gte 2>>
					<<set _purityIcon='ui/tf-fallen-angel'>>
				<<else>>
					<<set _purityIcon='ui/tf-angel'>>
				<</if>>
				<<set _purityConfig = { name : "순결함", icon : _purityIcon, displayType : "level", currentValue : $purity, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'red', description: '당신은 돌이킬 수 없이 더럽혀졌다.'},{ requiredValue: 1, level: 1, color: 'red', description: '당신은 철저히 더럽혀진 기분을 느낀다.'},{ requiredValue: 500, level: 2, color: 'pink', description: '당신은 더럽혀졌다고 느낀다.'},{ requiredValue: 600, level: 3, color: 'purple', description: '당신은 약간 더럽혀졌다고 느낀다.'},{ requiredValue: 700, level: 4, color: 'blue', description: '당신은 오염된 기분을 느낀다.'},{ requiredValue: 800, level: 5, color: 'lblue', description: '당신은 살짝 오염된 기분을 느낀다.'},{ requiredValue: 900, level: 6, color: 'teal', description: "당신은 자신이 완전히 순수하지는 않다고 느낀다."},{ requiredValue: 1000, level: 7, color: 'green', description: '당신은 천사와도 같다.'}					]
				}>>

				<!--AWARENESS-->
				<<set _awarenessConfig = { name : "성지식", icon : "ui/sym-awareness", displayType : "level", currentValue : $awareness, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: -200, level: 0, color: 'green', description: '당신은 순수하다.'},{ requiredValue: 1, level: 1, color: 'teal', description: '당신은 거의 완전히 순수하다.'},{ requiredValue: 100, level: 2, color: 'lblue', description: '성에 대해 어느 정도 이해하고 있다.'},{ requiredValue: 200, level: 3, color: 'blue', description: '성에 대해 일반적인 수준으로 이해하고 있다.'},{ requiredValue: 300, level: 4, color: 'purple', description: '성적 타락에 대한 지식이 평범한 사람들의 수준을 뛰어넘는다.'},{ requiredValue: 400, level: 5, color: 'pink', description: '당신은 극소수만이 아는 은밀한 것들을 목격했다.'},{ requiredValue: 500, level: 6, color: 'red', description: '당신은 깊은 타락의 심연을 들여다보았다.'},{ requiredValue: 1000, level: 7, color: 'red', description: '당신의 이해는 초월적이다.'}					]
				}>>

				<!--PHYSIQUE-->
				<<set _physiqueConfig = { name : "체격", icon : "ui/sym-physique", displayType : "level", currentValue : $physique, maxValue: $physiquesize, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'red', description: `당신의 몸은 ${$player.bodyshape === "soft" ? "영양실조 상태다" : "여위었다"}.`},{ requiredValue: $physiquesize / 7, level: 1, color: 'pink', description: `당신의 몸은 ${$player.bodyshape === "soft" ? "말랑하다" : "마른 편이다"}.`},{ requiredValue: ($physiquesize / 7) * 2, level: 2, color: 'purple', description: `당신의 몸은 ${$player.bodyshape === "soft" ? "부드럽고 유연하다" : "가냘프다"}.`},{ requiredValue: ($physiquesize / 7) * 3, level: 3, color: 'blue', description: `당신의 몸은 ${$player.bodyshape === "soft" ? "균형 잡혀 있다" : "날씬하다"}.`},{ requiredValue: ($physiquesize / 7) * 4, level: 4, color: 'lblue', description: `당신의 몸은 ${$player.bodyshape === "soft" ? "튼튼하고" : "날씬하며"} 건강하다.`},{ requiredValue: ($physiquesize / 7) * 5, level: 5, color: 'teal', description: `당신의 몸은 ${$player.bodyshape === "soft" ? "다부지고" : "탄탄하고"} 탄력이 있다.`},{ requiredValue: ($physiquesize / 7) * 6, level: 6, color: 'green', description: `당신의 몸은 ${$player.bodyshape === "soft" ? "건장하고" : "탄탄하고"} 강력하다.`}					]
				}>>
				<<if playerBellySize() gte 10 and playerNormalPregnancyTotal() lt 20>>
					<<switch playerNormalPregnancyTotal()>>
						<<case 0>><<set _pregnancyModifier to 36>>
						<<case 1>><<set _pregnancyModifier to 48>>
						<<case 2>><<set _pregnancyModifier to 60>>
						<<case 3 4 5 6 7>><<set _pregnancyModifier to 96>>
						<<default>><<set _pregnancyModifier to 120>>
					<</switch>>
					<<set _physiqueConfig.modifier to Math.floor(_physiqueConfig.modifier * (1 - (playerBellySize() / _pregnancyModifier)))>>
					<<set _physiqueConfig.modTypes.bad.pushUnique(playerAwareTheyArePregnant() ? "임신" : "큰 배")>>
				<</if>>
				<<switch $location>>
					<<case "forest" "moor" "farm" "alex_farm">>
						<<if $worn.feet.type.includes("heels")>>
							<<set _physiqueConfig.modifier to Math.floor(_physiqueConfig.modifier * (1 - ($worn.feet.reveal / 5000)))>>
							<<set _physiqueConfig.modTypes.bad.pushUnique("하이힐")>>
						<</if>>
						<<if $worn.feet.type.includes("rugged")>>
							<<set _physiqueConfig.modifier to Math.floor(_physiqueConfig.modifier * (1 + (currentSkillValue("feetskill") / 10000)))>>
							<<set _physiqueConfig.modTypes.good.pushUnique("튼튼한 신발")>>
						<</if>>
				<</switch>>
				<<if $auriga_artefact is "pc">>
					<<set _physiqueConfig.modifier to Math.floor(_physiqueConfig.modifier * 1.1)>>
					<<set _physiqueConfig.modTypes.good.pushUnique("<i>창백한 백색</i>")>>
				<</if>>

				<!--WILLPOWER-->
				<<set _willpowerConfig = { name : "의지력", icon : "ui/sym-trauma", displayType : "level", currentValue : $willpower, maxValue: $willpowermax, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'red', description: '당신은 소심하다.'},{ requiredValue: $willpowermax / 7, level: 1, color: 'pink', description: '당신은 소극적이다.'},{ requiredValue: ($willpowermax / 7) * 2, level: 2, color: 'purple', description: '당신은 신중하다.'},{ requiredValue: ($willpowermax / 7) * 3, level: 3, color: 'blue', description: '당신은 굳건하다.'},{ requiredValue: ($willpowermax / 7) * 4, level: 4, color: 'lblue', description: '당신은 단호하다.'},{ requiredValue: ($willpowermax / 7) * 5, level: 5, color: 'teal', description: '당신은 집요하다.'},{ requiredValue: ($willpowermax / 7) * 6, level: 6, color: 'green', description: '당신의 의지는 강철 같다.'}					]
				}>>
				<<if numberOfEarSlime() gte 2 and $earSlime.growth gt 50>>
					<<set _willpowerConfig.modifier to Math.floor(_willpowerConfig.modifier * (0.9 - Math.clamp(($earSlime.growth - 50) / 1000, 0, 0.1)))>>
					<<set _willpowerConfig.modTypes.bad.pushUnique("귀 슬라임")>>
				<<elseif numberOfEarSlime() gte 2>>
					<<set _willpowerConfig.modifier to Math.floor(_willpowerConfig.modifier * 0.9)>>
					<<set _willpowerConfig.modTypes.bad.pushUnique("귀 슬라임")>>
				<</if>>

				<!--BEAUTY-->
				<<set _beautyConfig = { name : "미모", icon : "ui/sym-beauty", displayType : "level", currentValue : $beauty, maxValue: $beautymax, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'red', description: '당신은 평범하다.'},{ requiredValue: $beautymax / 7, level: 1, color: 'pink', description: '당신은 귀엽다.'},{ requiredValue: ($beautymax / 7) * 2, level: 2, color: 'purple', description: '당신은 예쁘다.'},{ requiredValue: ($beautymax / 7) * 3, level: 3, color: 'blue', description: '당신은 매력적이다.'},{ requiredValue: ($beautymax / 7) * 4, level: 4, color: 'lblue', description: '당신은 아름답다.'},{ requiredValue: ($beautymax / 7) * 5, level: 5, color: 'teal', description: '당신은 눈부시게 매혹적이다.'},{ requiredValue: ($beautymax / 7) * 6, level: 6, color: 'green', description: '당신의 아름다움은 경이롭다.'}					]
				}>>

				<!--PROMISCUITY-->
				<<set _promiscuityConfig = { name : "음란", icon : "ui/sym-lust", displayType : "level", currentValue : $promiscuity, maxValue: 100, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'green', description: '당신은 정숙하고 순결하다.'},{ requiredValue: 1, level: 1, color: 'teal', description: '당신은 얌전하다.'},{ requiredValue: 15, level: 2, color: 'lblue', description: '당신은 성적으로 호기심이 많다.'},{ requiredValue: 35, level: 3, color: 'blue', description: '성적인 접촉에 대한 생각이 당신을 흥분시킨다.'},{ requiredValue: 55, level: 4, color: 'purple', description: '당신은 성적인 접촉을 갈망한다.'},{ requiredValue: 75, level: 5, color: 'pink', description: '당신은 걸레다.'},{ requiredValue: 95, level: 6, color: 'red', description: '당신의 성욕은 끝이 없다.'}					]
				}>>

				<!--EXHIBITIONISM-->
				<<set _exhibitionismConfig = { name : "노출증", icon : "ui/sym-exhibitionism", displayType : "level", currentValue : $exhibitionism, maxValue: 100, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'green', description: '당신은 수줍음이 많다.'},{ requiredValue: 1, level: 1, color: 'teal', description: '당신은 부끄러움을 탄다.'},{ requiredValue: 15, level: 2, color: 'lblue', description: '당신은 성적인 시선을 즐긴다.'},{ requiredValue: 35, level: 3, color: 'blue', description: '당신은 음란한 시선을 즐긴다.'},{ requiredValue: 55, level: 4, color: 'purple', description: '몸을 노출하는 것에 흥분을 느낀다.'},{ requiredValue: 75, level: 5, color: 'pink', description: '당신은 수치심을 모른다.'},{ requiredValue: 95, level: 6, color: 'red', description: '몸을 드러낸다는 생각만으로도 통제할 수 없는 욕망에 휩싸인다.'}					]
				}>>

				<!--DEVIANCY-->
				<<set _deviancyConfig = { name : "이상성욕", icon : "ui/sym-deviancy", displayType : "level", currentValue : $deviancy, maxValue: 100, modifier: 100, modTypes: { good: [], bad: [] },
					states : [
{ requiredValue: 0, level: 0, color: 'green', description: '당신은 특이한 취향에 거부감을 느낀다.'},{ requiredValue: 1, level: 1, color: 'teal', description: '당신은 평범하다.'},{ requiredValue: 15, level: 2, color: 'lblue', description: '당신의 취향은 약간 독특하다.'},{ requiredValue: 35, level: 3, color: 'blue', description: '당신의 취향은 충격적이다.'},{ requiredValue: 55, level: 4, color: 'purple', description: '당신의 욕망은 터무니없이 스캔들 같다.'},{ requiredValue: 75, level: 5, color: 'pink', description: "남들은 상상도 못 할 짓들을 갈망한다."},{ requiredValue: 95, level: 6, color: 'red', description: '입에 담기도 힘든 행위를 열렬히 갈구한다.'}					]
				}>>

				<!-- Visual indicator for lewd stats being affected by alcohol -->
				<<if $drunk gte 1>>
					<<set _promiscuityConfig.modTypes.good.pushUnique("술기운")>>
					<<set _exhibitionismConfig.modTypes.good.pushUnique("술기운")>>
					<<set _deviancyConfig.modTypes.good.pushUnique("술기운")>>
				<</if>>

				<!-- Visual indicator for lewd stats being affected by heat -->
				<<if playerHeatMinArousal() gte 1>>
					<<set _promiscuityConfig.modTypes.good.pushUnique("발정기")>>
					<<set _deviancyConfig.modTypes.good.pushUnique("발정기")>>
				<</if>>

				<!-- Visual indicator for lewd stats being affected by rut -->
				<<if playerRutMinArousal() gte 1>>
					<<set _promiscuityConfig.modTypes.good.pushUnique("러트")>>
					<<set _deviancyConfig.modTypes.good.pushUnique("러트")>>
				<</if>>

				<!-- MOOR LUCK, at the end so it appears at the end of the mouseover tooltip -->
				<<if $moorLuck gt 0>>
					<<set _physiqueConfig.modifier to Math.floor(_physiqueConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _physiqueConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _willpowerConfig.modifier to Math.floor(_willpowerConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _willpowerConfig.modTypes.good.pushUnique("<i>????</i>")>>
				<</if>>
			<</silently>>

			<<characteristic-box _purityConfig>>
			<<characteristic-box _beautyConfig>>
			<<characteristic-box _physiqueConfig>>
			<<characteristic-box _willpowerConfig>>
			<<characteristic-box _awarenessConfig>>
			<<characteristic-box _promiscuityConfig>>
			<<characteristic-box _exhibitionismConfig>>
			<<characteristic-box _deviancyConfig>>
		</div>

		<!--Common states for skills with grades-->
		<<silently>>
			<<set _basicSkillGrades=[
{ requiredValue: 0, level: "F-", color: 'red'},				{ requiredValue: 1,		level: "F",		color: 'pink'},
				{ requiredValue: 200,	level: "D",		color: 'purple'},
				{ requiredValue: 400,	level: "C",		color: 'blue'},
				{ requiredValue: 600,	level: "B",		color: 'lblue'},
				{ requiredValue: 800,	level: "A",		color: 'teal'},
				{ requiredValue: 1000,	level: "S",		color: 'green'}
			]>>
			<<set _detailedSkillGrades=[
{ requiredValue: 0, level: "F-", color: 'red'},				{ requiredValue: 1,		level: "F",		color: 'pink'},
				{ requiredValue: 100,	level: "F+",	color: 'pink'},
				{ requiredValue: 200,	level: "D",		color: 'purple'},
				{ requiredValue: 300,	level: "D+",	color: 'purple'},
				{ requiredValue: 400,	level: "C",		color: 'blue'},
				{ requiredValue: 500,	level: "C+",	color: 'blue'},
				{ requiredValue: 600,	level: "B",		color: 'lblue'},
				{ requiredValue: 700,	level: "B+",	color: 'lblue'},
				{ requiredValue: 800,	level: "A",		color: 'teal'},
				{ requiredValue: 900,	level: "A+",	color: 'teal'},
				{ requiredValue: 1000,	level: "S",		color: 'green'}
			]>>
		<</silently>>

		<br>
		<span class="gold">스킬</span>
		<div id="base-skills" class="characteristic-box-list" @style="($parasite.left_ear.name == 'slime' || $parasite.right_ear.name == 'slime') ? '--min-width: 30%;' : ''">
			<!--Additional skills configurations-->
			<<silently>>
				<<set _corruptionConfig =	{ name : "오염도",	displayType : "none",	currentValue : $earSlime.corruption,	modifier: 100, modTypes: { good: [], bad: [] },		meterColor: $earSlime.startedThreats ? "purple" : "blue", secondValue: $earSlime.growth / 2, secondMeterColor: "red"}>>
				<<set _skulduggeryConfig =	{ name : "속임수", displayType : "grade",	currentValue : $skulduggery,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _dancingConfig =		{ name : "춤",		displayType : "grade",	currentValue : $danceskill,			modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _swimmingConfig =		{ name : "수영",	displayType : "grade",	currentValue : $swimmingskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _athleticsConfig =	{ name : "체육",	displayType : "grade",	currentValue : $athletics,			modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _tendingConfig =		{ name : "관리",		displayType : "grade",	currentValue : $tending,			modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _housekeepingConfig =	{ name : "가사",displayType : "grade",	currentValue : $housekeeping,		modifier: 100, modTypes: { good: [], bad: [] },		states : _detailedSkillGrades}>>
				<<set _bellySize to playerBellySize()>>
				<<if _bellySize gte 10 and playerNormalPregnancyTotal() lt 20>>
					<<switch playerNormalPregnancyTotal()>>
						<<case 0>><<set _pregnancyModifier to 36>>
						<<case 1>><<set _pregnancyModifier to 48>>
						<<case 2>><<set _pregnancyModifier to 60>>
						<<case 3 4 5 6 7>><<set _pregnancyModifier to 96>>
						<<default>><<set _pregnancyModifier to 120>>
					<</switch>>
					<<set _dancingConfig.modifier to Math.floor(_dancingConfig.modifier * (1 - (_bellySize / _pregnancyModifier)))>>
					<<set _dancingConfig.modTypes.bad.pushUnique(playerAwareTheyArePregnant() ? "임신" : "큰 배")>>
					<<set _swimmingConfig.modifier to Math.floor(_swimmingConfig.modifier * (1 - (_bellySize / _pregnancyModifier)))>>
					<<set _swimmingConfig.modTypes.bad.pushUnique(playerAwareTheyArePregnant() ? "임신" : "큰 배")>>
					<<set _athleticsConfig.modifier to Math.floor(_athleticsConfig.modifier * (1 - (_bellySize / _pregnancyModifier)))>>
					<<set _athleticsConfig.modTypes.bad.pushUnique(playerAwareTheyArePregnant() ? "임신" : "큰 배")>>
				<</if>>
				<<if $transformationParts.traits.chase isnot "disabled">>
					<<set _athleticsConfig.modifier to Math.floor(_athleticsConfig.modifier * 1.10)>>
					<<set _athleticsConfig.modTypes.good.pushUnique("추격의 전율")>>
				<</if>>
				<<if $worn.hands.type.includes("sticky_fingers")>>
					<<set _skulduggeryConfig.modifier to Math.floor(_skulduggeryConfig.modifier * 1.05)>>
					<<set _skulduggeryConfig.modTypes.good.pushUnique("나쁜 손버릇")>>
				<</if>>
				<<if $transformationParts.traits.sharpEyes isnot "disabled">>
					<<set _skulduggeryConfig.modifier to Math.floor(_skulduggeryConfig.modifier * 1.05)>>
					<<set _skulduggeryConfig.modTypes.good.pushUnique("예리한 눈")>>
				<</if>>
				<<if $worn.under_upper.type.includesAny("dance", "naked") and $worn.under_lower.type.includesAny("dance", "naked")
				and $worn.upper.type.includesAny("dance", "naked")and $worn.lower.type.includesAny("dance", "naked")>>
					<<set _dancingConfig.modifier to Math.floor(_dancingConfig.modifier * 1.05)>>
					<<if [$worn.under_upper.type, $worn.under_lower.type, $worn.upper.type, $worn.lower.type].flat().includes("dance")>>
						<<set _dancingConfig.modTypes.good.pushUnique("댄스 복장")>>
					<<else>>
						<<set _dancingConfig.modTypes.good.pushUnique("알몸")>>
					<</if>>
				<</if>>
				<<if $worn.under_upper.type.includesAny("swim", "naked") and $worn.under_lower.type.includesAny("swim", "naked")
				and $worn.upper.type.includesAny("swim", "naked") and $worn.lower.type.includesAny("swim", "naked")>>
					<<set _swimmingConfig.modifier to Math.floor(_swimmingConfig.modifier * 1.05)>>
					<<if $worn.under_upper.type.includes("swim") or $worn.under_lower.type.includes("swim")
					or $worn.upper.type.includes("swim") or $worn.lower.type.includes("swim")>>
						<<set _swimmingConfig.modTypes.good.pushUnique("수영복")>>
					<<else>>
						<<set _swimmingConfig.modTypes.good.pushUnique("알몸")>>
					<</if>>
				<</if>>
				<<if $worn.feet.type.includes("swim")>>
					<<set _swimmingConfig.modifier to Math.floor(_swimmingConfig.modifier * (1 + (currentSkillValue("feetskill") / 10000)))>>
					<<set _swimmingConfig.modTypes.good.pushUnique("오리발")>>
				<<elseif !$worn.feet.type.includes("naked")>>
					<<if $worn.feet.type.includes("heels")>>
						<<set _heels to 0.1>>
						<<set _swimmingConfig.modTypes.bad.pushUnique("하이힐")>>
					<<else>>
						<<set _heels to 0>>
						<<set _swimmingConfig.modTypes.bad.pushUnique("신발")>>
					<</if>>
					<<set _swimmingConfig.modifier to Math.floor(_swimmingConfig.modifier * (0.9 + (currentSkillValue("feetskill") / 10000) - _heels))>>
				<</if>>
				<<switch $location>>
					<<case "forest" "moor" "farm" "alex_farm">>
						<<if $worn.feet.type.includes("heels")>>
							<<set _athleticsConfig.modifier to Math.floor(_athleticsConfig.modifier * (1 - ($worn.feet.reveal / 5000)))>>
							<<set _athleticsConfig.modTypes.bad.pushUnique("하이힐")>>
						<</if>>
						<<if $worn.feet.type.includes("rugged")>>
							<<set _athleticsConfig.modifier to Math.floor(_athleticsConfig.modifier * (1 + (currentSkillValue("feetskill") / 10000)))>>
							<<set _athleticsConfig.modTypes.good.pushUnique("튼튼한 신발")>>
						<</if>>
				<</switch>>
				<<if $worn.feet.type.includes("shackle")>>
					<<set _athleticsConfig.modifier to 0>>
					<<set _athleticsConfig.modTypes.bad.pushUnique("<b>족쇄</b>")>>
					<<set _swimmingConfig.modifier to Math.floor(_swimmingConfig.modifier * 0.5)>>
					<<run _swimmingConfig.modTypes.bad.delete("하이힐","신발")>>
					<<set _swimmingConfig.modTypes.bad.pushUnique("<b>족쇄</b>")>>
					<<set _dancingConfig.modifier to Math.floor(_dancingConfig.modifier * 0.5)>>
					<<set _dancingConfig.modTypes.bad.pushUnique("<b>족쇄</b>")>>
				<</if>>
				<<if $worn.upper.type.includes("heavy") or $worn.lower.type.includes("heavy")>>
					<<set _athleticsConfig.modifier to Math.floor(_athleticsConfig.modifier * (V.physique / V.physiquesize) / 1.5)>>
					<<set _athleticsConfig.modTypes.bad.pushUnique("<b>갑옷</b>")>>
					<<set _swimmingConfig.modifier to Math.floor(_swimmingConfig.modifier * ((V.physique / V.physiquesize) / 3))>>
					<<set _swimmingConfig.modTypes.bad.pushUnique("<b>갑옷</b>")>>
					<<set _dancingConfig.modifier to Math.floor(_dancingConfig.modifier * ((V.physique / V.physiquesize) / 3))>>
					<<set _dancingConfig.modTypes.bad.pushUnique("<b>갑옷</b>")>>
				<</if>>
				<<if $backgroundTraits.includes("plantlover")>>
					<<set _tendingConfig.modifier to Math.floor(_tendingConfig.modifier * (1 + ($trauma / ($traumamax * 2))))>>
					<<if $submissive lte 850>>
						<<set _tendingConfig.modTypes.good.pushUnique("수목애호증")>>
					<<else>>
						<<set _tendingConfig.modTypes.good.pushUnique("식물 애호가")>>
					<</if>>
				<</if>>
				<<if $worn.upper.type.includes("maid")>>
					<<set _housekeepingConfig.modifier to Math.floor(_housekeepingConfig.modifier * 1.05)>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("메이드복")>>
				<</if>>
				<<if $worn.lower.type.includes("maid")>>
					<<set _housekeepingConfig.modifier to Math.floor(_housekeepingConfig.modifier * 1.05)>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("메이드복")>>
				<</if>>
				<<if $worn.head.type.includes("maid")>>
					<<set _housekeepingConfig.modifier to Math.floor(_housekeepingConfig.modifier * 1.05)>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("메이드복")>>
				<</if>>
				<<if $worn.handheld.type.includes("maid")>>
					<<set _housekeepingConfig.modifier to Math.floor(_housekeepingConfig.modifier * 1.05)>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("청소 도구")>>
				<</if>>
				<<if $moorLuck gt 0>>
					<<set _skulduggeryConfig.modifier to Math.floor(_skulduggeryConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _skulduggeryConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _dancingConfig.modifier to Math.floor(_dancingConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _dancingConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _swimmingConfig.modifier to Math.floor(_swimmingConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _swimmingConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _athleticsConfig.modifier to Math.floor(_athleticsConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _athleticsConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _tendingConfig.modifier to Math.floor(_tendingConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _tendingConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _housekeepingConfig.modifier to Math.floor(_housekeepingConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _housekeepingConfig.modTypes.good.pushUnique("<i>????</i>")>>
				<</if>>
			<</silently>>
			<<characteristic-box _skulduggeryConfig>>
			<<characteristic-box _dancingConfig>>
			<<characteristic-box _swimmingConfig>>
			<<characteristic-box _athleticsConfig>>
			<<characteristic-box _tendingConfig>>
			<<characteristic-box _housekeepingConfig>>
			<<if numberOfEarSlime()>>
				<<characteristic-box _corruptionConfig>>
			<</if>>
		</div>

		<br>
		<span class="gold">섹스 스킬</span>
		<!--Sex skills configurations-->
		<<silently>>
			<<set _seductionConfig =	{ name : "유혹",	displayType : "grade",	currentValue : $seductionskill, modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : 0}>>
			<<set _oralConfig =			{ name : "입",		displayType : "grade",	currentValue : $oralskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : $mouthsensitivity}>>
			<<set _chestConfig =		{ name : "가슴",		displayType : "grade",	currentValue : $chestskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : $breastsensitivity}>>
			<<set _handsConfig =		{ name : "손",		displayType : "grade",	currentValue : $handskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : 0}>>
			<<set _buttocksConfig =		{ name : "엉덩이",	displayType : "grade",	currentValue : $bottomskill,	modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : $bottomsensitivity}>>
			<<set _analConfig =			{ name : "애널",		displayType : "grade",	currentValue : $analskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : $bottomsensitivity}>>
			<<set _thighsConfig =		{ name : "허벅지",		displayType : "grade",	currentValue : $thighskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : 0}>>
			<<set _feetConfig =			{ name : "발",		displayType : "grade",	currentValue : $feetskill,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : 0}>>
			<<if $player.penisExist>>
				<<set _penileConfig =	{ name : "자지",		displayType : "grade",	currentValue : $penileskill,	modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : $genitalsensitivity}>>
			<</if>>
			<<if playerHasStrapon()>>
				<<set _penileConfig =	{ name : "페니스 밴드",displayType : "grade",	currentValue : $penileskill,	modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : 0}>>
			<</if>>
			<<if $player.vaginaExist>>
				<<set _vaginalConfig =	{ name : "보지",		displayType : "grade",	currentValue : $vaginalskill,	modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades, 	sensitivity : $genitalsensitivity}>>
			<</if>>
			<<if $earSlime.growth gt 50 and !V.earSlime.defyCooldown>>
				<<set _seductionConfig.modTypes.good.pushUnique("귀 슬라임")>>
				<<set _seductionConfig.modifier to Math.floor(_seductionConfig.modifier * (1 + (($earSlime.growth - 50) / 600)))>>
			<</if>>
			<<if $earSlime.growth gte 100 and $earSlime.focus is "pregnancy">>
				<<if _vaginalConfig>>
					<<set _vaginalConfig.modTypes.good.pushUnique("귀 슬라임")>>
					<<set _vaginalConfig.modifier to Math.floor(_vaginalConfig.modifier * (1 + (($earSlime.growth - 100) / 500)))>>
				<</if>>
				<<if _penileConfig>>
					<<set _penileConfig.modTypes.bad.pushUnique("귀 슬라임")>>
					<<set _penileConfig.modifier to Math.floor(_penileConfig.modifier * (1 - (($earSlime.growth - 100) / 400)))>>
				<</if>>
				<<if !$player.vaginaExist>>
					<<set _analConfig.modTypes.good.pushUnique("귀 슬라임")>>
					<<set _analConfig.modifier to Math.floor(_analConfig.modifier * (1 + (($earSlime.growth - 100) / 500)))>>
				<</if>>
			<</if>>
			<<if $earSlime.growth gte 100 and $earSlime.focus is "impregnation">>
				<<if _vaginalConfig>>
					<<set _vaginalConfig.modTypes.bad.pushUnique("귀 슬라임")>>
					<<set _vaginalConfig.modifier to Math.floor(_vaginalConfig.modifier * (1 - (($earSlime.growth - 100) / 400)))>>
				<</if>>
				<<if _penileConfig>>
					<<set _penileConfig.modTypes.good.pushUnique("귀 슬라임")>>
					<<set _penileConfig.modifier to Math.floor(_penileConfig.modifier * (1 + (($earSlime.growth - 100) / 500)))>>
				<</if>>
			<</if>>
			<<if playerHeatMinArousal()>>
				<<if _vaginalConfig>>
					<<set _vaginalConfig.modTypes.good.pushUnique("발정기")>>
					<<set _vaginalConfig.modifier to Math.floor(_vaginalConfig.modifier * (1 + (Math.clamp(playerHeatMinArousal(), 0, 4000) / 20000)))>>
				<</if>>
				<<if !$player.vaginaExist>>
					<<set _analConfig.modTypes.good.pushUnique(playerAwareTheyCanBePregnant() ? "발정기" : "<i>????</i>")>>
					<<set _analConfig.modifier to Math.floor(_analConfig.modifier * (1 + (Math.clamp(playerHeatMinArousal(), 0, 4000) / 20000)))>>
				<</if>>
			<</if>>
			<<if playerRutMinArousal()>>
				<<set _penileConfig.modTypes.good.pushUnique("러트")>>
				<<set _penileConfig.modifier to Math.floor(_penileConfig.modifier * (1 + (Math.clamp(playerRutMinArousal(), 0, 4000) / 20000)))>>
			<</if>>
		<</silently>>
		<<if $options.images is 1>>
			<div id="player-body">
				<<player-base-body>>
			</div>
			<div id="sex-diagram">

				<div class="characteristic-box-list left-column">
					<div class="sex-diagram-box">
						<<characteristic-box _seductionConfig>>
						<div class="connector-box"></div>
					</div>
					<div class="sex-diagram-box">
						<<characteristic-box _chestConfig>>
						<<connector-box 52 35 5>>
					</div>
					<div class="sex-diagram-box">
						<<characteristic-box _buttocksConfig>>
						<<connector-box 37 50 13>>
					</div>
					<<if $player.vaginaExist>>
						<div class="sex-diagram-box">
							<<characteristic-box _vaginalConfig>>
							<<connector-box 10 -3 0 true>>
						</div>
						<div class="sex-diagram-box">
							<<characteristic-box _thighsConfig>>
							<<connector-box 37 35 7 true>>
						</div>
					<<else>>
						<div class="sex-diagram-box">
							<<characteristic-box _thighsConfig>>
							<<connector-box 0 35 7>>
						</div>
					<</if>>
				</div>
				<div class="characteristic-box-list right-column">
					<div class="sex-diagram-box">
						<<connector-box 73 35 16>>
						<<characteristic-box _oralConfig>>
					</div>
					<div class="sex-diagram-box">
						<<connector-box 74 50 23>>
						<<characteristic-box _handsConfig>>
					</div>
					<<if $player.penisExist or playerHasStrapon()>>
						<div class="sex-diagram-box">
							<<connector-box 34 65 10>>
							<<characteristic-box _penileConfig>>
						</div>
						<div class="sex-diagram-box">
							<<connector-box 2 50 20 true>>
							<<characteristic-box _analConfig>>
						</div>
						<div class="sex-diagram-box">
							<<connector-box 5 50 25 true>>
							<<characteristic-box _feetConfig>>
						</div>
					<<else>>
						<div class="sex-diagram-box">
							<<connector-box 39 65 20>>
							<<characteristic-box _analConfig>>
						</div>
						<div class="sex-diagram-box">
							<<connector-box 40 80 25>>
							<<characteristic-box _feetConfig>>
						</div>
					<</if>>
				</div>
			</div>
		<<else>>
			<div id="sex-skills" class="characteristic-box-list">
				<<characteristic-box _seductionConfig>>
				<<characteristic-box _oralConfig>>
				<<if $player.vaginaExist>>
					<<characteristic-box _vaginalConfig>>
				<</if>>
				<<if $player.penisExist>>
					<<characteristic-box _penileConfig>>
				<</if>>
				<<if playerHasStrapon()>>
					<<characteristic-box _penileConfig>>
				<</if>>
				<<characteristic-box _analConfig>>
				<<characteristic-box _handsConfig>>
				<<characteristic-box _feetConfig>>
				<<characteristic-box _thighsConfig>>
				<<characteristic-box _buttocksConfig>>
				<<characteristic-box _chestConfig>>
			</div>
		<</if>>

		<br>
		<span class="gold">학교 성적</span>
		<div id="school-grades" class="characteristic-box-list">
			<!--School grade configurations-->
			<<silently>>
				<<set _schoolGradeStates= [
					{ requiredValue: -1,	level: 'F',		color: 'red'},
					{ requiredValue: 0,		level: 'D',		color: 'purple'},
					{ requiredValue: 1,		level: 'C',		color: 'blue'},
					{ requiredValue: 2,		level: 'B',		color: 'lblue'},
					{ requiredValue: 3,		level: 'A',		color: 'teal'},
					{ requiredValue: 4,		level: 'A+',	color: 'green'}
				]>>

				<<set _scienceConfig =	{ name : '과학', icon : 'misc/icon/science', displayType : "grade",	currentValue : $sciencetrait,	modifier: 100, modTypes: { good: [], bad: [] },	percent: $science_exam,		showStars: true, starLevel: $science_star,	states : _schoolGradeStates}>>
				<<set _mathsConfig =	{ name : '수학',	icon : 'misc/icon/math',	displayType : "grade",	currentValue : $mathstrait,		modifier: 100, modTypes: { good: [], bad: [] },	percent: $maths_exam,		showStars: true, starLevel: $maths_star,	states : _schoolGradeStates}>>
				<<set _englishConfig =	{ name : '영어', icon : 'misc/icon/english', displayType : "grade",	currentValue : $englishtrait,	modifier: 100, modTypes: { good: [], bad: [] },	percent: $english_exam,		showStars: true, starLevel: $english_star,	states : _schoolGradeStates}>>
				<<set _historyConfig =	{ name : '역사', icon : 'misc/icon/history', displayType : "grade",	currentValue : $historytrait,	modifier: 100, modTypes: { good: [], bad: [] },	percent: $history_exam,		showStars: true, starLevel: $history_star,	states : _schoolGradeStates}>>
				<<if $moorLuck gt 0>>
					<<set _scienceConfig.modifier to Math.floor(_scienceConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _scienceConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _mathsConfig.modifier to Math.floor(_mathsConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _mathsConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _englishConfig.modifier to Math.floor(_englishConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _englishConfig.modTypes.good.pushUnique("<i>????</i>")>>
					<<set _historyConfig.modifier to Math.floor(_historyConfig.modifier * (1 + ($moorLuck / 100)))>>
					<<set _historyConfig.modTypes.good.pushUnique("<i>????</i>")>>
				<</if>>
			<</silently>>

			<<characteristic-box _scienceConfig>>
			<<characteristic-box _mathsConfig>>
			<<characteristic-box _englishConfig>>
			<<characteristic-box _historyConfig>>
		</div>
		<div class="characteristic-box-extras">
			<<set _schoolPerformanceConfig = { currentValue : $school, preText: '당신의 전반적인 학교 성적은 ', modifier: 100, modTypes: { good: [], bad: [] }, states : [
{ requiredValue: 0, color: 'red', description: '끔찍하다.'},{ requiredValue: 1, color: 'pink', description: '매우 나쁘다.'},{ requiredValue: 400, color: 'purple', description: '나쁘다.'},{ requiredValue: 800, color: 'blue', description: '나쁘지 않다.'},{ requiredValue: 1600, color: 'lblue', description: '좋다.'},{ requiredValue: 2800, color: 'teal', description: '훌륭하다.'},{ requiredValue: 4000, color: 'green', description: '모범적이다.'}				]
			}>>
			<<characteristic-text _schoolPerformanceConfig>>
			<br>
		</div>

		<br>
		<span class="gold">무기 스킬</span>
		<div id="prof" class="characteristic-box-list">
			<<silently>>
				<<set _sprayConfig =		{ name : "후추 스프레이",		displayType : "grade",	currentValue : $prof.spray,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
				<<set _netConfig =			{ name : "그물",		displayType : "grade",	currentValue : $prof.net,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
				<<set _batonConfig =		{ name : "봉",		displayType : "grade",	currentValue : $prof.baton,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
				<<set _whipConfig =			{ name : "채찍",		displayType : "grade",	currentValue : $prof.whip,		modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
				<<set _hiddenConfig =		{ name : "<i>????</i>",	displayType : "grade",	currentValue : 0,				modifier: 100, modTypes: { good: [], bad: [] },		states : _basicSkillGrades}>>
			<</silently>>
			<<characteristic-box _sprayConfig>>
			<<if $prof.net isnot undefined>>
				<<characteristic-box _netConfig>>
			<<else>>
				<<characteristic-box _hiddenConfig>>
			<</if>>
			<<if $prof.baton isnot undefined>>
				<<characteristic-box _batonConfig>>
			<<else>>
				<<characteristic-box _hiddenConfig>>
			<</if>>
			<<if $prof.whip isnot undefined>>
				<<characteristic-box _whipConfig>>
			<<else>>
				<<characteristic-box _hiddenConfig>>
			<</if>>
			/*
			<<if $prof.pickaxe isnot undefined>>
				<<characteristic-box _pickaxeConfig>>
			<<else>>
				<<characteristic-box _hiddenConfig>>
			<</if>>*/
		</div>
	</div>

	<br>
	<span class="gold">불안감</span>
	<div class="description">불안감이 커질수록 타인의 시선을 감당하기 어려워지며, 스트레스가 더 크게 쌓이고 통제력을 잃기 쉬워집니다. 자신을 받아들이면 이 효과에 면역이 됩니다.</div>
	<br><br>
	<<set $_penisSize to window.KR.getPenisDescKr(setup.penisSizes[$player.penissize]).toUpperFirst()>>
	<<if insecurityExists("penis_small")>>
		<span class="red">불안감: <<print $_penisSize>> 자지</span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_penis_small/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_penis_small gte 1>>
			<span class="green">수용: <<print $_penisSize>> 자지</span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_penis_small/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>
	<<if insecurityExists("penis_big")>>
		<span class="red">불안감: <<print $_penisSize>> 자지</span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_penis_big/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_penis_big gte 1>>
			<span class="green">수용: <<print $_penisSize>> 자지</span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_penis_big/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>
	<<set $_breastSize to window.KR.getBreastSizeKr(setup.breastsizes[$player.breastsize]).toUpperFirst()>>
	<<if insecurityExists("breasts_small")>>
		<span class="red">불안감: <<print $player.breastsize ? "$_breastSize 가슴" : "평평한 가슴">></span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_breasts_small/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_breasts_small gte 1>>
			<span class="green">수용: <<print $player.breastsize ? "$_breastSize 가슴" : "평평한 가슴">></span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_breasts_small/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>
	<<if insecurityExists("breasts_big")>>
	<span class="red">불안감: <<print $player.gender is "m" ? "남성" : $_breastSize>> 가슴</span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_breasts_big/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_breasts_big gte 1>>
			<span class="green">수용: <<print $player.gender is "m" ? "남성" : $_breastSize>> 가슴</span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_breasts_big/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>
	<<if insecurityExists("pregnancy")>>
		<<set $_bellyText to (playerAwareTheyArePregnant() ? "임신한 배" : "임신처럼 보이는 배")>>
		<span class="red">불안감: <<print $_bellyText>></span>
		<div class="meter">
			<<set _percent=Math.floor(($insecurity_pregnancy/1000)*100)>>
			<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
		</div>
		<<if $acceptance_pregnancy gte 1>>
			<span class="green">수용: <<print $_bellyText>></span>
			<div class="meter">
				<<set _percent=Math.floor(($acceptance_pregnancy/1000)*100)>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			</div>
		<</if>>
	<</if>>

	<br>
<</widget>>

<<widget "heatRutDisplay">><<silently>>
	<<set $_knowsTheyCanBecomePregnant to ($settings.playerPregnancyHumanEnabled or $settings.playerPregnancyBeastEnabled) and playerAwareTheyCanBePregnant()>>
	<<set $_heatArousal to playerHeatMinArousal()>>
	<<set $_rutArousal to playerRutMinArousal()>>
	<<if $_heatArousal or $_rutArousal>>
		<<set $_source to []>>
		<<set $_sourceText to "무언가">>
		<<set $_arousal to []>>
		<<set $_arousedText to "당신을 계속 달아오르게 하고 있다">>

		/* SourceText */
		<<if $wolfgirl gte 2 or $cat gte 2 or $cow gte 2 or $fox gte 2>>
			<<run $_source.push("내면의 짐승")>>
		<</if>>
		<<if $earSlime.growth gt 50 and (($earSlime.focus is "pregnancy" and $_heatArousal) or ($earSlime.focus is "impregnation" and $_rutArousal))>>
			<<run $_source.push("귀 슬라임")>>
		<</if>>
		<<if $_source.length>>
			<<set $_sourceText to formatList($_source, "그리고")>>
		<</if>>

		/* arousedText */
		<<if $_source.length and $_heatArousal and $_knowsTheyCanBecomePregnant>>
			<<run $_arousal.push("발정기")>>
		<</if>>
		<<if $_source.length and $_rutArousal>>
			<<run $_arousal.push("러트")>>
		<</if>>
		<<if $_arousal.length>>
			<<set $_arousedText to "당신을 " + formatList($_arousal, "그리고") + " 상태로 몰아넣고 있다">>
		<</if>>
	<</if>>
	<</silently>><<if $_sourceText>><<print $_sourceText>><<print $_source.length and $_source.length gte 2 ? "들이 " : "【이가】 ">> <<print $_arousedText>>.<<if _args[0]>><br><br><</if>><</if>>
<</widget>>
