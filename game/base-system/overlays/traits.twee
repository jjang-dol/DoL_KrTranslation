					name: () => V.worn.neck.name === "familiar collar" && V.worn.neck.cursed === 1 ? "매료된 헌신" : "매료된 호기심",
					colour: "purple",
					has: V.hypnosis_traits.devotion === 3,
					text: "그윌란과 함께 있으면 편안합니다. 그윌란의 요청을 거절하기가 더 어려워집니다. 이로운 최면 특성이 더 오래 지속됩니다. 학교 성적이 떨어지지 않습니다.",
					meter: {
						has: V.hypnosisTimers.devotion,
						value: V.hypnosisTimers.devotion?.time,
						min: 35,
						max: 55,
						colour: "purplebar glowbar",
					},
				},
				{
					name: () => V.worn.neck.name === "familiar collar" && V.worn.neck.cursed === 1 ? "최면적인 헌신" : "최면적인 호기심",
					colour: "pink",
					has: V.hypnosis_traits.devotion === 4,
					text: "그윌란과 함께 있으면 따뜻함을 느낍니다. 그윌란의 요청을 거절하기가 훨씬 더 어려워집니다. 다른 사람이 당신에게 최면을 걸려는 시도는 실패할 수 있습니다. 이로운 최면 특성이 더 오래 지속됩니다. 학교 성적이 떨어지지 않습니다.",
					meter: {
						has: V.hypnosisTimers.devotion,
						value: V.hypnosisTimers.devotion?.time,
						min: 55,
						max: 75,
						colour: "pinkbar glowbar",
					},
				},
				{
					name: () => V.worn.neck.name === "familiar collar" && V.worn.neck.cursed === 1 ? "숭고한 헌신" : "숭고한 호기심",
					colour: "red",
					has: V.hypnosis_traits.devotion === 5,
					text: "그윌란은 당신을 완전하게 만들어줍니다. 그윌란의 요청은 거절하는 것이 <span class='red'>불가능</span>합니다. 다른 사람이 당신에게 최면을 걸려는 시도는 실패하며, 그들에게 피해를 줄 수 있습니다. <span class='gold'>이로운 최면 특성과 학교 성적이 떨어지지 않습니다.</span>",
					meter: {
						has: V.hypnosisTimers.devotion,
						hide: V.worn.neck.name === "familiar collar" && V.worn.neck.cursed === 1 && V.hypnosisTimers.devotion?.time >= gwylanHypnoMax("value"),
						value: V.hypnosisTimers.devotion?.time,
						min: 75,
						max: 95,
						colour: "redbar glowbar",
					},
				},
				{
					name: () => V.worn.neck.name === "familiar collar" && V.worn.neck.cursed === 1 ? "광란의 헌신" : "광란의 호기심",
					colour: basicHypnoCss(),
					has: V.hypnosis_traits.devotion >= 6,
					text: "???",
					meter: {
						has: V.hypnosisTimers.devotion,
						hide: V.worn.neck.name === "familiar collar" && V.worn.neck.cursed === 1 && V.hypnosisTimers.devotion?.time >= gwylanHypnoMax("value"),
						value: V.hypnosisTimers.devotion?.time,
						min: 95,
						max: 100,
						colour: "redbar glowbar",
					},
				},
				{
					name: "최면의 평화",
					colour: "forest-green",
					has: V.hypnosis_traits.peace gte 1,
					text: "당신의 내면이 평화롭습니다. 변이 부위를 숨겨도 더 이상 트라우마를 유발하지 않습니다.",
					meter: {
						has: V.hypnosisTimers.peace,
						hide: V.hypnosis_traits.devotion >= 5,
						value: V.hypnosisTimers.peace?.time,
						max: V.hypnosisTimers.peace?.max,
						colour: "greenbar glowbar",
					},
				},
				{
					name: "최면의 침묵",
					colour: "purple",
					has: V.hypnosis_traits.silence gte 1,
					text: "당신의 생각은 고독하고 고요합니다. 귀 슬라임이 일시적으로 조용해집니다.",
					meter: {
						has: V.hypnosisTimers.silence,
						hide: V.hypnosis_traits.devotion >= 5,
						value: V.hypnosisTimers.silence?.time,
						max: V.hypnosisTimers.silence?.max,
						colour: "purplebar glowbar",
					},
				},
				{
					name: "최면의 잠",
					colour: "",
					style: `background: linear-gradient(to right,rgb(31, 121, 196) 0%,rgb(77, 74, 247) 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;`,
					has: V.hypnosis_traits.slumber gte 1,
					text: "트라우마가 있을 때 수면이 더 편안해지며, '불면증' 특성이 있다면 억제됩니다.",
					meter: {
						has: V.hypnosisTimers.slumber,
						hide: V.hypnosis_traits.devotion >= 5,
						value: V.hypnosisTimers.slumber?.time,
						max: V.hypnosisTimers.slumber?.max,
						colour: "darkbluebar glowbar",
					},
				},
				{
					name: () => V.awareness >= 300 ? "최면의 무지" : "최면의 통찰",
					colour: "",
					style: `background: linear-gradient(to right,rgb(187, 214, 221) 0%,rgb(255, 252, 217) 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;`,
					has: V.hypnosis_traits.insight gte 1,
					text: "높은 인식은 더 이상 환각을 일으키지 않습니다. 대신 낮은 인식이 환각을 유발합니다.",
					meter: {
						has: V.hypnosisTimers.insight,
						hide: V.hypnosis_traits.devotion >= 5,
						value: V.hypnosisTimers.insight?.time,
						max: V.hypnosisTimers.insight?.max,
						colour: "bluebar glowbar",
					},
				},
			],
		},
		{
			title: "수용 특성",
			traits: [
				{
					name: () => {
						const penisSize = window.KR.getPenisDescKr(setup.penisSizes[$player.penissize]).toUpperFirst();
						return `수용: ${penisSize} 자지`;
					},
					colour: "green",
					has: $acceptance_penis_small gte 1000 and $player.penissize lte 3,
					text: "당신은 작은 자지를 자랑스러워합니다.",
				},
				{
					name: "수용: 보추",
					colour: "green",
					has: $acceptance_tomgirl gte 100 and $acceptance_penis_small gte 1000 and $player.penissize lte 2,
					text: "당신은 보추가 된 것을 자랑스러워합니다.",
				},
				{
					name: () => {
						const penisSize = window.KR.getPenisDescKr(setup.penisSizes[$player.penissize]).toUpperFirst();
						return `수용: ${penisSize} 자지`;
					},
					colour: "green",
					has: $acceptance_penis_big gte 1000 and $player.penissize gte 6,
					text: "당신은 거대한 자지를 자랑스러워합니다.",
				},
				{
					name: "수용: 납작한 가슴",
					colour: "green",
					has: $acceptance_breasts_tiny gte 1000 and $player.breastsize lte 0 and $player.sex is "f",
					text: "당신은 납작한 가슴을 자랑스러워합니다.",
				},
				{
					name: () => {
						const breastSize = window.KR.getBreastSizeKr(setup.breastsizes[$player.breastsize]).toUpperFirst();
						return `수용: ${$player.breastsize ? breastSize + " 가슴" : "납작한 가슴"}`;
					},
					colour: "green",
					has: $acceptance_breasts_small gte 1000 and between($player.breastsize, 0, 4),
					text: "당신은 작은 가슴을 자랑스러워합니다.",
				},
				{
					name: () => {
						const breastSize = window.KR.getBreastSizeKr(setup.breastsizes[$player.breastsize]).toUpperFirst();
						return `수용: ${breastSize} 가슴`;
					},
					colour: "green",
					has: $acceptance_breasts_big gte 1000 and $player.breastsize gte 8,
					text: "당신은 거대한 가슴을 자랑스러워합니다.",
				},
				{
					name: () => playerAwareTheyArePregnant() ? "수용: 임신한 배" : "수용: 임신한 것 같은 배",
					colour: "green",
					has: $acceptance_pregnancy gte 1000 and playerBellySize() gte 8,
					text: () => playerAwareTheyArePregnant() ? "당신은 생명을 품은 배를 자랑스러워합니다." : "당신은 커다란 배를 자랑스러워합니다.",
				},
			],
		},
		{
			title: "???",
			traits: [
				{
					name: "엘크의 흉터",
					colour: "red",
					has: $auriga_scar is 1,
					text: "보이지 않는 상처가 당신의 심장 주위를 맴돕니다. 트라우마와 인식이 시간이 지남에 따라 증가합니다. 순결도가 시간이 지남에 따라 감소합니다.",
					textColour: "red",
				},
				{
					name: "엘크의 낙인",
					colour: "red",
					has: $auriga_scar is 2,
					text: "지지직거리는 상처가 심장을 둘러싸고 있습니다. 당신은 눈에 띄기 어려워지고, 인간으로 인식되기도 힘들어집니다.",
					textColour: "red",
				},
				{
					name: "엘크에게 물림",
					colour: "red",
					has: $auriga_scar is 3,
					text: "구멍이 당신의 검은 심장을 집어삼키려 합니다. 무언가 탈출하려고 합니다.",
					textColour: "red",
				},
				{
					name: "엘크의 파열",
					colour: "red",
					has: $auriga_scar is 4,
					text: "파열이 당신의 뛰지 않는 검은 심장을 끊어냅니다. 파멸이 임박했습니다.",
					textColour: "red",
				},
				{
					name: "엘크의 부산물",
					colour: "red",
					has: $auriga_scar gte 5,
					text: "파멸.",
					textColour: "red",
				},
			],
		},
	]>>

	<div id="traitListsSearch">
		<<traitListsSearch>>
	</div>
	<br>
	<div id="traitLists">
		<<traitLists>>
	</div>
<</widget>>

<<widget "traitListsSearch">>
	<<if $options.traitOverlayFormat is undefined>><<set $options.traitOverlayFormat to "table">><</if>>
	<<set _traitSearch to "">>
	<<foldout false "_traitFilterFoldout">>
		<span>필터</span>
		<label>검색: <<textbox "_traitSearch" _traitSearch>></label>
		<br><br>
		<label>
			표시 형식:
			<<listbox "$options.traitOverlayFormat" autoselect>>
				<<option "표" "table">>
				<<option "축소된 표" "reducedTable">>
				<<option "목록" "list">>
			<</listbox>>
		</label>
		<br><br>
		<<link 갱신>>
			<<replace "#traitLists">><<traitLists>><</replace>>
		<</link>> |
		<<link 초기화>>
			<<set _traitSearch to "">>
			<<replace "#traitListsSearch">><<traitListsSearch>><</replace>>
			<<replace "#traitLists">><<traitLists>><</replace>>
		<</link>> |
	<</foldout>>
<</widget>>

<<widget "traitLists">>
	<<set _traitSearch2 to _traitSearch.toLowerCase()>>
	<<for $_traitList range _traitLists>>
		<<if !$_traitList.traits.find(trait => trait.has &&
			(T.traitSearch2 === "" ||
			(typeof trait.name === "function" && trait.name().toLowerCase().includes(T.traitSearch2)) ||
			(typeof trait.name !== "function" && trait.name.toLowerCase().includes(T.traitSearch2)) ||
			(trait.text && typeof trait.text === "function" && trait.text().toLowerCase().includes(T.traitSearch2)) ||
			(trait.text && typeof trait.text !== "function" && trait.text.toLowerCase().includes(T.traitSearch2)))
		)>>
			<<continue>>
		<</if>>
		<<if ["table","reducedTable"].includes($options.traitOverlayFormat)>>
			<div @class="$options.traitOverlayFormat is 'table' ? 'traitList' : 'traitListReducedText'">
				<div class="traitHeading">
					<<print $_traitList.title>>
				</div>
				<div class="traits">
				<<for $_trait range $_traitList.traits.filter(trait => trait.has &&
					(T.traitSearch2 === "" ||
					(typeof trait.name === "function" && trait.name().toLowerCase().includes(T.traitSearch2)) ||
					(typeof trait.name !== "function" && trait.name.toLowerCase().includes(T.traitSearch2)) ||
					(trait.text && typeof trait.text === "function" && trait.text().toLowerCase().includes(T.traitSearch2)) ||
					(trait.text && typeof trait.text !== "function" && trait.text.toLowerCase().includes(T.traitSearch2)))
				)>>
					<div class="trait">
						<<set $_name to typeof $_trait.name is "function" ? $_trait.name() : $_trait.name>>
						<<set $_colour to typeof $_trait.colour is "function" ? $_trait.colour() : $_trait.colour>>
						<<set $_style to typeof $_trait.style is "function" ? $_trait.style() : $_trait.style>>
						<<set $_text to typeof $_trait.text is "function" ? $_trait.text() : $_trait.text>>
						<<set $_textColour to typeof $_trait.textColour is "function" ? $_trait.textColour() : $_trait.textColour>>
						<<set $_meter to $_trait.meter>>
						<span @class="$_colour" @style="$_style">
							<<print $_name>>
						</span>
						<<if !$_text>>
						<<elseif $options.traitOverlayFormat is "table">>
							- <small @class="$_textColour"><<print $_text>></small>
							<<if $_meter?.has and !$_meter.hide>>
								<<set $_floor to $_meter.min || 0>>
								<<set $_timeTotal to ($_meter.max - $_floor)>>
								<<set $_percent to Math.floor(($_meter.value - $_floor) / $_timeTotal * 100)>>
								<div class="meter">
									<<print '<div @class="$_meter.colour" style="width:' + $_percent + '%"></div>'>>
								</div>
							<</if>>
						<<else>>
							<mouse class="tooltip linkBlue">정보 (?)<span @class="$_textColour"><<print $_text>></span></mouse>
							<<if $_meter?.has and !$_meter.hide>>
								<<set $_floor to $_meter.min || 0>>
								<<set $_timeTotal to ($_meter.max - $_floor)>>
								<<set $_percent to Math.floor($_meter.value / $_timeTotal * 100)>>
								<div class="meter">
									<<print '<div @class="$_meter.colour" style="width:' + $_percent + '%"></div>'>>
								</div>
							<</if>>
						<</if>>
					</div>
				<</for>>
				</div>
			</div>
			<br>
		<</if>>
		<<if $options.traitOverlayFormat is "list">>
			<div>
				<h4>
					<<print $_traitList.title>>
				</h4>
				<<for $_trait range $_traitList.traits.filter(trait => trait.has &&
					(T.traitSearch2 === "" ||
					(typeof trait.name === "function" && trait.name().toLowerCase().includes(T.traitSearch2)) ||
					(typeof trait.name !== "function" && trait.name.toLowerCase().includes(T.traitSearch2)) ||
					(trait.text && typeof trait.text === "function" && trait.text().toLowerCase().includes(T.traitSearch2)) ||
					(trait.text && typeof trait.text !== "function" && trait.text.toLowerCase().includes(T.traitSearch2)))
				)>>
					<div class="trait">
						<<set $_name to typeof $_trait.name is "function" ? $_trait.name() : $_trait.name>>
						<<set $_colour to typeof $_trait.colour is "function" ? $_trait.colour() : $_trait.colour>>
						<<set $_style to typeof $_trait.style is "function" ? $_trait.style() : $_trait.style>>
						<<set $_text to typeof $_trait.text is "function" ? $_trait.text() : $_trait.text>>
						<<set $_textColour to typeof $_trait.textColour is "function" ? $_trait.textColour() : $_trait.textColour>>
						<<set $_meter to $_trait.meter>>
						<span @class="$_colour" @style="$_style">
							<<print $_name>>
						</span>
						<<if $_text>>
							- <span @class="$_textColour"><<print $_text>></span>
							<<if $_meter?.has and !$_meter.hide>>
								<<set $_floor to $_meter.min || 0>>
								<<set $_timeTotal to ($_meter.max - $_floor)>>
								<<set $_percent to Math.floor($_meter.value / $_timeTotal * 100)>>
								<div class="meter">
									<<print '<div @class="$_meter.colour" style="width:' + $_percent + '%"></div>'>>
								</div>
							<</if>>
						<</if>>
					</div>
				<</for>>
			</div>
			<br>
		<</if>>
	<</for>>
<</widget>>
