:: Traits [widget]
<<widget "traits">>
	<<if $sexStats and $sexStats.pills>>
		<<set _pills to $sexStats.pills.pills>>
	<</if>>
	<<set _traitLists to [
		{
			title: "일반 특성",
			traits: [
				{
					name: "순결한",
					colour: "green",
					has: $player.virginity.vaginal is true and $player.virginity.penile is true,
					text: "순결도가 더 빨리 회복됩니다. 당신의 처녀와 동정은 꽤 가치 있을지도 모릅니다.",
				},
				{
					name: "순결 서약",
					colour: "blue",
					has: $player.virginity.temple is true,
					text: "당신의 <<if $player.penisExist>>자지가 감싸지거나<</if>><<if $player.penisExist and $player.vaginaExist>>, 혹은 당신의 <</if>><<if $player.vaginaExist>>보지가 삽입당하면<</if>> 서약을 잃습니다. 신전이 이 사실을 알게 될 것입니다.",
				},
				{
					name: "깨진 서약",
					colour: "red",
					has: $player.virginity.temple isnot true and $temple_rank isnot "prospective" and $temple_rank isnot undefined,
					text: "신전이 이 사실을 알게 될 것입니다.",
				},
				{
					name: "약속의 의식: " + window.KR.gatPersonNameDictKR($templePromised),
					colour: "blue",
					has: $templePromised isnot "" and $player.virginity.temple is true,
					text: "당신은 신전의 다른 인원과 맺어졌습니다. 이 사람과의 섹스는 서약을 깨뜨리지 않습니다.",
				},
				{
					name: "깨진 약속: " + window.KR.gatPersonNameDictKR($templePromised),
					colour: "red",
					has: $templePromised isnot "" and $player.virginity.temple isnot true,
					text: "신전이 이 사실을 알게 될 것입니다.",
				},
				{
					name: "신전의 짐: $temple_burden%",
					colour: "blue",
					has: $temple_burden gte 1,
					text: "당신은 세상에 퍼진 타락의 일부를 몸 안에 짊어지고 있습니다. 체격, 의지력, 체육, 춤, 속임수, 수영, 관리, 가사, 영어 스킬 판정이 $temple_burden% 확률로 자동 실패합니다.",
				},
				{
					name: "순결 부스트",
					colour: "green",
					has: $featsPurityBoost gt 0,
					text: () => {
						let dailyPurity = 1;
						if (V.fallenangel >= 2) dailyPurity -= 10;
						if (V.player.virginity.vaginal === true && V.player.virginity.penile === true) dailyPurity += 2;
						if (dailyPurity + V.featsPurityBoost > 0) return "매일 순결도를 얻고 있습니다.";
						if (dailyPurity + V.featsPurityBoost === 0) return "매일 순결도를 잃지 않고 있습니다.";
						return "매일 순결도를 덜 잃고 있습니다.";
					},
				},
				{
					name: "불결 부스트",
					colour: "red",
					has: $featsPurityBoost lt 0,
					text: () => {
						let dailyPurity = 1;
						if (V.fallenangel >= 2) dailyPurity -= 10;
						if (V.player.virginity.vaginal === true && V.player.virginity.penile === true) dailyPurity += 2;
						if (dailyPurity + V.featsPurityBoost > 0) return "매일 순결도를 덜 얻고 있습니다.";
						if (dailyPurity + V.featsPurityBoost === 0) return "매일 순결도를 얻지 못하고 있습니다.";
						return "매일 순결도를 잃고 있습니다.";
					},
				},
				{
					name: $player.sex isnot $player.gender ? `\"크로스드레서\"` : "크로스드레서",
					colour: $player.sex is "f" ? "lblue" : "pink",
					has: $backgroundTraits.includes("crossdresser"),
					text: `${$player.sex is "f" ? "소년" : "소녀"}처럼 보일 때는 스트레스가 더 빨리 감소하지만, <<pcSex>> 복장일 때는 더 느리게 감소합니다.`,
				},
				{
					name: "호색한",
					colour: "lewd",
					has: $backgroundTraits.includes("lustful"),
					text: "시간이 지날수록 흥분이 오르며 이를 관리해야 합니다.",
				},
				{
					name: "녹색의 손",
					colour: "green",
					has: $backgroundTraits.includes("greenthumb"),
					text: "비료를 사용하면 작물이 더 풍성해지고 부패하지 않습니다.",
				},
				{
					name: () => V.submissive <= 850 ? "나무성애자" : "식물 애호가",
					colour: "lewd",
					has: $backgroundTraits.includes("plantlover"),
					text: "당신에게 식물은 전부입니다. 더 이상 환각 수치가 없어도 인간형 식물과 식물형 촉수를 마주칠 수 있습니다. 트라우마가 증가할수록 관리 스킬에 보너스를 받습니다.",
				},
				{
					name: "넥타르 중독",
					colour: "red",
					has: $backgroundTraits.includes("plantlover"),
					text: "당신은 최음제와 알코올에 더 취약해집니다. 넥타르에서 영양을 얻습니다. 넥타르를 마시면 몸에 활력이 돌아 체력이 상승하고 스트레스가 감소합니다. 오랜 기간 넥타르를 마시지 않으면 몸에 악영향을 미치며, 결국 이 특성과 <<if $submissive lte 850>><span class='lewd'>나무성애자</span><<else>><span class='lewd'>식물 애호가</span><</if>> 특성이 사라집니다.<span class='hidden'></span>",
				},
				{
					name: () => {
						let focusName;
						switch ($earSlime.focus) {
							case "pregnancy": focusName = "임신"; break;
							case "mixed": focusName = "혼합된"; break;
							case "impregnation": focusName = "수정"; break;
							default: focusName = $earSlime.focus;
						}
						return "귀 슬라임의 "  + focusName + " 의지";
					},
					colour: "lewd",
					has: $earSlime.focus and $earSlime.focus isnot "none",
					text: () => {
						let result;
						switch ($earSlime.focus) {
							case "pregnancy":
								result = "임신의 길을 선택했습니다. 귀 슬라임이 임신 관련 특성을 증폭시키고, 다른 특성은 약화시킵니다.";
								break;
							case "mixed":
								result = "임신과 수정 사이의 길을 선택했습니다. 귀 슬라임이 두 관련 특성을 어느 정도 증폭시킵니다.";
								break;
							case "impregnation":
								result = "수정의 길을 선택했습니다. 귀 슬라임이 타인을 임신시키는 관련 특성을 증폭시키고, 다른 특성은 약화시킵니다.";
								break;
						}
						let parasites = [];
						if ($parasite.breasts and $parasite.breasts.name is "parasite") {
							if ($player.breastsize gte 1) {
								parasites.push("가슴");
							} else {
								parasites.push("흉부");
							}
						}
						if (($parasite.clit and $parasite.clit.name is "parasite") or ($parasite.penis and $parasite.penis.name is "parasite")) parasites.push("성기");
						if (parasites.length) result += ` 그 기생충들이 옷처럼 당신의 ${parasites.length === 1 ? parasites[0] : parasites.slice(0, -1).join(", ") + "와 " + parasites[parasites.length - 1]}【을를】 덮고 있습니다.`;
						return result;
					}
				},
				{
					name: "임신",
					colour: "lewd",
					has: playerIsPregnant() and playerAwareTheyArePregnant(),
					text: () => playerBellySize() lt 10 or playerNormalPregnancyTotal() gte 20 ? "임신 중입니다." : "임신 중입니다. 배가 커질수록 일부 스킬에 페널티를 받습니다.",
				},
				{
					name: "초보 어머니",
					colour: "lewd",
					has: playerNormalPregnancyTotal() is 1,
					text: "첫 아이를 출산했습니다. 임신으로 인한 신체적 페널티가 줄어듭니다.",
				},
				{
					name: "두 번째 어머니",
					colour: "lewd",
					has: playerNormalPregnancyTotal() is 2,
					text: "이제 아이를 두 번 출산했습니다. 임신으로 인한 신체적 페널티가 줄어듭니다.",
				},
				{
					name: "어머니",
					colour: "lewd",
					has: between(playerNormalPregnancyTotal(), 3, 7),
					text: "어머니로서 꽤 좋은 경험을 가지고 있습니다. 임신으로 인한 신체적 페널티가 적당히 줄어듭니다.",
				},
				{
					name: "부화장 어머니",
					colour: "lewd",
					has: between(playerNormalPregnancyTotal(), 8, 19),
					text: "아주, 아주 많은 아이를 낳았습니다. 임신으로 인한 신체적 페널티가 크게 줄어듭니다.",
				},
				{
					name: "가이아",
					colour: "gold",
					has: playerNormalPregnancyTotal() gte 20,
					text: "당신은 말 그대로 아이들의 왕국을 낳았습니다. 임신으로 인한 신체적 페널티가 없어집니다.",
				},
				{
					name: "기생충 부화장 어머니",
					colour: "lewd",
					has: $sexStats.anus.pregnancy.motherStatus is 2 or $sexStats.vagina.pregnancy.motherStatus is 2,
					text: "당신은 끝없이 많은 작은 벌레들의 숙주가 되었습니다<<if $sexStats.anus.pregnancy.motherStatus is 2 and $sexStats.vagina.pregnancy.motherStatus is 2>>. <span class='lewd'>당신의 신체 여러 곳에서 말입니다</span><</if>><span class='hidden'></span>.",
				},
				{
					name: "기생충 어머니",
					colour: "lewd",
					has: ($sexStats.anus.pregnancy.motherStatus is 1 or $sexStats.vagina.pregnancy.motherStatus is 1) and !($sexStats.anus.pregnancy.motherStatus is 2 or $sexStats.vagina.pregnancy.motherStatus is 2),
					text: "당신은 작은 벌레들을 출산했습니다<<if $sexStats.anus.pregnancy.motherStatus is 1 and $sexStats.vagina.pregnancy.motherStatus is 1>>. <span class='lewd'>당신의 신체 여러 곳에서 말입니다</span><</if>><span class='hidden'></span>.",
				},
				{
					name: "수유 중",
					colour: "blue",
					has: $lactating gte 1 and $settings.breastFeedingEnabled,
					text: "당신의 가슴은 모유를 짜낼 준비가 되었습니다.",
				},
				{
					name: "우유 공장",
					colour: "blue",
					has: $lactating gte 1 and $settings.breastFeedingEnabled and $milk_volume gte 1000,
					text: "당신의 가슴은 어마어마한 양의 모유를 담을 수 있습니다.",
				},
				{
					name: "정자 은행",
					colour: "blue",
					has: $semen_volume gte 1000 and $player.penisExist,
					text: "당신은 어마어마한 양의 정액을 지니고 있습니다.",
				},
				{
					name: "빙의됨",
					colour: "wraith",
					has: $possessed,
					text: "당신의 몸은 당신의 것이 아닙니다.",
				},
				{
					name: () => V.player.gender is "n" ? "늑대" : "늑대 <<pcGender>>",
					colour: "grey",
					has: $wolfgirl gte 6,
					text: '야생의 정령이 당신 안에 살아 있습니다. 반항적인 선택지와 "요구한다" 행동을 항상 사용할 수 있으며, 이는 스트레스를 감소시킵니다. 지나치게 순종적일 때, 반항적인 행동을 하는 것은 트라우마를 유발하고 통제력을 낮춥니다. 귀와 꼬리가 당신을 더 눈에 띄게 만듭니다.',
				},
				{
					name: () => V.player.gender is "n" ? "고양이" : "고양이 <<pcGender>>",
					colour: "grey",
					has: $cat gte 6,
					text: '크림을 핥아먹고 싶은 충동을 느낍니다. 몸에 야한 체액을 묻힌 채 춤을 출 때 "치장한다" 행동이 해금됩니다. 귀와 꼬리가 당신을 더 눈에 띄게 만듭니다.',
				},
				{
					name: () => {
						if (V.player.gender_appearance is "m") {
							if (V.player.gender is "n") {
								return "황소";
							}
							return "황소 <<pcGender>>";
						} else {
							if (V.player.gender is "n") {
								return "젖소";
							}
							return "젖소 <<pcGender>>";
						}
					},
					colour: "brat",
					has: $cow gte 6,
					text: "당신은 젖이 짜이기를 갈망합니다. 모유와 정액의 생산량이 증가합니다. 특정 신체 부위가 커질 수도 있습니다. 당신의 뿔, 귀, 꼬리가 당신을 더 눈에 띄게 만듭니다.",
				},
				{
					name: () => V.hallucinations gte 2 || !V.settings.bestialityEnabled ? "하피" : V.player.gender is "n" ? "새" : "새 <<pcGender>>",
					colour: "grey",
					has: $harpy gte 6,
					text: "하늘이 부릅니다.",
				},
				{
					name: () => {
						if (V.player.gender_appearance is "m") {
							if (V.player.gender is "n") {
								return "여우";
							}
							return "여우 <<pcGender>>";
						} else {
							return "여우";
						}
					},
					colour: "",
					style: `background: linear-gradient(to right,#fe9000 0%, #ffffff 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;`,
					has: $fox gte 6,
					text: "당신 것이 아닌 걸 가지고 싶은 충동이 듭니다. 귀와 꼬리 덕분에 더 매혹적이고 매력적으로 보입니다.",
				},
				{
					name: "송곳니",
					colour: "def",
					has: !["disabled", "hidden"].includes($transformationParts.traits.fangs),
					text: "깨물기가 두 배로 효과적입니다.",
				},
				{
					name: "날카로운 눈",
					colour: "def",
					has: !["disabled", "hidden"].includes($transformationParts.traits.sharpEyes),
					text: "무언가 당신의 주의를 피해갈 확률이 낮아집니다. 속임수 +5%.",
				},
				{
					name: "오드아이",
					colour: "",
					style: `background: linear-gradient(to right,${setup.colours.eyes_map[$rightEyeColour].canvasfilter.blend} 0%, ${setup.colours.eyes_map[$leftEyeColour].canvasfilter.blend} 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;`,
					has: $heterochromia is 1,
					text: "당신의 양쪽 눈 색깔이 다릅니다.",
				},
				{
					name: "단단한 뿔",
					colour: "def",
					has: $cow gte 2 and $demon lt 2,
					text: "박치기를 해도 더 이상 아프지 않습니다.",
				},
				{
					name: "평생의 반려자",
					colour: "",
					style: `background: linear-gradient(to right,#e646c6 0%, #ffffff 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;`,
					has: !["disabled", "hidden"].includes($transformationParts.traits.mateForLife),
					text: "연인과 잠을 자거나 교미할 때 보너스를 얻습니다. 연인이 바뀌면 스트레스와 트라우마를 유발합니다.",
				},
				{
					name: "추격의 스릴",
					colour: "teal",
					has: !["disabled", "hidden"].includes($transformationParts.traits.chase),
					text: '체육 스킬에 보너스를 받고 스토킹 인카운터 시 "기습" 행동을 사용할 수 있습니다. 추적자에게서 도망치면 스트레스가 감소합니다.',
				},
				{
					name: "타락 천사",
					colour: "black",
					has: $fallenangel gte 4,
					text: '세상은 무척 잔인합니다. 나날이 순수함을 잃어간다고 느끼지만, 스스로를 놓아버리진 않을 것입니다. "비난한다" 행동이 해금됩니다.',
				},
				{
					name: "타락 천사",
					colour: "black",
					has: $fallenangel is 2 or $fallenangel is 3,
					text: "세상은 무척 잔인합니다. 나날이 순수함을 잃어간다고 느낍니다.",
				},
				{
					name: "강철의 의지",
					colour: "silver",
					has: $fallenangel is 4,
					text: "세상의 무게는 무겁지만, 당신은 그것을 견뎌낼 만큼 강합니다. 의지력이 더 이상 감소하지 않습니다.",
				},
				{
					name: "천사",
					colour: "gold",
					has: $angel gte 6,
					text: '당신은 순수함을 내뿜습니다. 인카운터 당 한 번 "용서한다" 행동이 해금되어, 여태 얻은 트라우마를 없앱니다. 주의하세요, 순결을 잃으면 이 특성이 사라지고 당신은 부서질 것입니다.',
				},
				{
					name: () => {
						if(V.player.gender_appearance is "m"){
							if(V.player.sex is "f" and isCrossdressing()){
								return "인큐버스 (♀)";
							}
							return "인큐버스";
						}else{
							if(V.player.sex is "m" and isCrossdressing()){
								return "서큐버스 (♂)";
							}
							return "서큐버스";
						}
					},
					colour: "red",
					has: $demon gte 6,
					text: "당신에겐 순수함이라곤 남아있지 않습니다. 무언가 당신 안에 사정하거나, 당신이 다른 무언가에 사정하면 트라우마가 감소합니다. 촉수는 트라우마 대신 스트레스와 고통을 줄여줍니다. 주의하세요, 순결도가 최하 수치가 아닌 상태로 하루를 마치면 상당한 스트레스를 받을 것입니다.",
				},
				{
					name: "찬란함",
