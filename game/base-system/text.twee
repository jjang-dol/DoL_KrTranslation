<<widget "hairmapcolourtext">>
	<<set _hairMapRecord to setup.guessColourInMap(setup.colours.hair_map, _args[0])>>
	<<if _hairMapRecord>>
		<<print _hairMapRecord.name>>
	<<elseif _args[0] and !_colour>>
		<<print _args[0]>>
	<<else>>
		<<print _colour>>
	<</if>>
<</widget>>

<<widget "haircolourtext">>
	<<if $hairColourStyle == "gradient">>
		<<print "투톤">>
	<<else>>
		<<hairmapcolourtext $haircolour>>
	<</if>>
<</widget>>

<<widget "hairfringecolourtext">>
	<<if $hairFringeColourStyle == "gradient">>
		<<print "투톤">>
	<<else>>
		<<hairmapcolourtext $hairfringecolour>>
	<</if>>
<</widget>>

<<widget "charles">><<silently>>
	<<if $wraith.mimic is "Morgan" and $wraith.state is "haunt" and random(1,3) is 1>>
		<<set _text_output to "도굴꾼">>
	<<else>>
		<<set _text_output to ($player.gender_appearance is "m" ? "찰스" : "샤를린")>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcexposetext">><<silently>>
	<<person>><<set _person to _text_output>>
	<<his>><<set _his to _text_output>>
	<<if $pronoun is "m">>
		<<set _text_output to _person + "【은는】 " + _his + " 바지 지퍼를 내리고, ">>
	<<else>>
		<<set _text_output to _person + "【은는】 " + _his + " 치마를 들어 올리며, ">>
	<</if>>
	<<if $NPCList[0].penis isnot "none">>
		<<set _text_output to _text_output + _his + " 발기한 자지를 드러낸다.">>
