	<<elseif $pronoun is "n">>
		<<set _text_output to "그들의">>
	<<elseif $pronoun is "t">>
		<<set _text_output to "그들의">>
	<<elseif $pronoun>>
		<<set _text_output to `<span class="red">[오류: "Hers"에서 인식할 수 없는 대명사 값 $pronoun]</span>`>>
	<<else>>
		<<set _text_output to `<span class="red">[오류: "Hers"에 정의되지 않은 대명사]</span>`>>
