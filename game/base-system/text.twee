<<widget "he">><<silently>>
	<!-- Add the option to call for named NPCs individually -->
	<<if _args[0]>>
		<<set $pronoun to C.npc[_args[0]].pronoun>>
	<</if>>
	<<if $pronoun is "m">>
		<<set _text_output to "그">>
	<<elseif $pronoun is "f">>
		<<set _text_output to "그녀">>
	<<elseif $pronoun is "i">>
		<<set _text_output to "그것">>
	<<elseif $pronoun is "n">>
		<<set _text_output to "사람">>
	<<elseif $pronoun is "t">>
		<<set _text_output to "그들">>
	<<elseif $pronoun>>
		<<set _text_output to `<span class=\"red\">[에러: \"he\"에서 알 수 없는 대명사 값 $pronoun]</span>`>>
	<<else>>
		<<set _text_output to `<span class=\"red\">[에러: \"he\"에서 정의되지 않은 대명사]</span>`>>
	<</if>>
<</silently>>_text_output<</widget>>

