<<widget "NPCvirginitywarning">>
	<<if $NPCNameList.indexOf(_args[0]) >= 0 and C.npc[_args[0]].virginity[_args[1]] is true and !$settings.blindStatsEnabled>>
		<<if $options.combatControls.includes("ists")>>
			<br>
		<</if>>
		<<if !$combat>> | <</if>>
		<<switch _args[1]>>
			<<case "vaginal">>
				<span class="red"><<if $combat>>(<</if>>이 행동은 <<his>> 처녀를 빼앗습니다<<if $combat>>)<</if>></span>
			<<case "penile">>
				<<if !npcHasStrapon(V.NPCList.findIndex(npc => npc.fullDescription === _args[0]))>>
					<span class="red"><<if $combat>>(<</if>>이 행동은 <<his>> 동정을 빼앗습니다<<if $combat>>)<</if>></span>
				<</if>>
			<<case "anal">>
				<span class="red"><<if $combat>>(<</if>>이 행동은 <<his>> 항문 순결을 빼앗습니다<<if $combat>>)<</if>></span>
			<<case "oral">>
				<span class="red"><<if $combat>>(<</if>>이 행동은 <<his>> 입술 순결을 빼앗습니다<<if $combat>>)<</if>></span>
			<<case "kiss">>
				<span class="red"><<if $combat>>(<</if>>이 행동은 <<his>> 첫 키스가 됩니다<<if $combat>>)<</if>></span>
			<<case "handholding">>
				<span class="red"><<if $combat>>(<</if>>이 행동은 <<his>> 첫 손잡기가 됩니다<<if $combat>>)<</if>></span>
			<<default>>
		<</switch>>
	<</if>>
<</widget>>

