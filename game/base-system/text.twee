	<<elseif $rng gte 61>>
		활강하는
	<<elseif $rng gte 56>>
		미끄러지는
	<<elseif $rng gte 51>>
		버둥거리는
	<<elseif $rng gte 46>>
		꿈틀거리는
	<<elseif $rng gte 41>>
		뒤틀리는
	<<elseif $rng gte 36>>
		경련하는
	<<elseif $rng gte 31>>
		부르르 떠는
	<<elseif $rng gte 26>>
		떨리는
	<<elseif $rng gte 21>>
		흠칫거리는
	<<elseif $rng gte 16>>
		기어다니는
	<<elseif $rng gte 11>>
		퍼덕거리는
	<<elseif $rng gte 6>>
		구불구불 기어다니는
	<<elseif $rng gte 1>>
		미끄러지는
	<</if>>
<</widget>>

<<widget "wallet">><<silently>>
	<<if !isNaN(_args[0]) and $NPCList[_args[0]] and $NPCList[_args[0]].clothes and $NPCList[_args[0]].clothes.set>>
		<<set $_clothesSet to $NPCList[_args[0]].clothes.set>>
	<</if>>
	<<if $location is "island">>
