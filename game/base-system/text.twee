			<span @class="_classList">!노출증 6!</span>
		<<else>>
			<span @class="_classList">노출증 _args[0]</span>
		<</if>>
		<<if _desperateaction>>
			| <span class="red">필사적인 행동</span>
		<</if>>
	<</if>>
<</widget>>

