:: Widgets Text [widget]

<<widget "setLocalPronouns">>
	<<run App.Utils.setLocalPronouns(_args[0], _args[1])>>
<</widget>>

<<widget "capitalise">><<silently>>
	<<set _text_output to _text_output?.toLocaleUpperFirst()>>
<</silently>>_text_output<</widget>>

<<widget "catcall">>
	"<<print either(
		"어이 예쁜이.",
		"어이 아름다운 사람.",
		"보기 좋네.",
		"멋지게 생겼네.",
		"오늘 예뻐 보이네, <<girl>>【아야】.",
		"안녕, 섹시한 <<lady>>【아야】.",
		"와, 진짜 예쁘다.",
		"눈이 참 아름다워, <<girl>>【아야】.",
		"머리 예쁘네, 귀염둥이.",
		"넌 먹음직스럽네, <<girl>>【아야】.",
		"넌 정말 매혹적이야, <<girl>>【아야】.",
		"넌 너무 눈부셔, <<girl>>【아야】.",
		"넌 훌륭해 보여, <<girl>>【아야】.",
		"멋진 <<bottomsimple>>【이】네.",
		"엉덩이랑 다리가 끝내주네.",
		"다리 예쁘다.",
		"널 한 번 맛보고 싶네.",
		"언젠가 그 몸을 내 혀로 훑고 싶네.",
		"언젠가 널 질리도록 박아주마.",
		"혼자 걷기에는 너무 섹시한걸, <<girl>>【아야】.",
		"거기 예쁜이, 그 엉덩이 이리로 가져와.",
		"안녕 <<girl>>【아야】, 나랑 같이 놀래?",
		"안녕 <<girl>>【아야】, 같이 놀래?",
		"섹시한 친구, 전화번호 줄래?",
		"어디 살아, <<girl>>【아야】? 어쩌면 내가 찾아갈지도.",
		"거기 섹시한 년, 이리 와서 놀자.",
		"이리 와서 예쁜 얼굴 좀 보여줘.",
		"여기로 와서 대화나 할까, 섹시?",
		"너, <<partnerfriend>> 있어?",
		"장담컨대 네 <<partnerfriend>>【은는】 나만큼 널 대접해주진 않을걸.",
		"안녕 귀염둥이, 내 <<girlfriend>>【이가】 되어줄래?",
		"네 <<partnerfriend>>【은는】 참 운도 좋네.")>>"
<</widget>>

<<widget "catcalllewd">>
	"<<print either(
		"강간당하고 싶은가 보네.",
		"누가 널 강간해주길 바라는 거지, 그렇지 <<girl>>【아야】?",
