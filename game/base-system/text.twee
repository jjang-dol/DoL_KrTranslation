<</widget>>

<<widget "beast_growls_text">>
	<<set $_type to _args[0] ? _args[0] : $NPCList[_n].type>>
	<<if ["hawk","harpy"].includes($_type)>>
		<<set _text_output to "꽥꽥거린다">>
	<<elseif $_type.includes("pig")>>
		<<set _text_output to "꿀꿀거린다">>
	<<elseif $_type.includes("dolphin")>>
		<<set _text_output to "딸깍거린다">>
	<<elseif $_type.includes("spider")>>
		<<set _text_output to "찍찍거린다">>
	<<elseif $_type.includes("lizard")>>
		<<set _text_output to "쉭쉭거린다">>
	<<elseif ["boar","horse","centaur"].includes($_type)>>
		<<set _text_output to "씩씩거린다">>
	<<else>>
		<<set _text_output to "으르렁거린다">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "beast_growling_text">>
	<<set $_type to _args[0] ? _args[0] : $NPCList[_n].type>>
	<<if ["hawk","harpy"].includes($_type)>>
		<<set _text_output to "꽥꽥거림">>
	<<elseif $_type.includes("pig")>>
		<<set _text_output to "꿀꿀거림">>
	<<elseif $_type.includes("dolphin")>>
		<<set _text_output to "딸깍거림">>
	<<elseif $_type.includes("spider")>>
		<<set _text_output to "찍찍거림">>
	<<elseif $_type.includes("lizard")>>
