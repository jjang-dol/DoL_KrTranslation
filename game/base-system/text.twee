<<widget "daylight">>
	<<if Weather.dayState is "day">>
		<<set _text_output to "햇빛">>
	<<elseif Weather.dayState is "dawn">>
		<<set _text_output to "여명의 빛">>
	<<elseif Weather.dayState is "dusk">>
		<<set _text_output to "황혼의 빛">>
	<<else>>
		<<if Time.hour is 9 or Time.season is "summer">>
			<<set _text_output to "땅거미">>
		<<else>>
			<<set _text_output to "밤바람">>
		<</if>>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "printChastity">>
