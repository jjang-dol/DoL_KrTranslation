<<widget "hisselect">><<silently>>
	<!-- Note calls range from 0-5 corresponding to NPCs 1-6. This was done to simplify FOR loops -->
	<<set _n to _args[0]>>
	<<if $enemytype is "man" and $enemyno gte 2>>
		<<personselect _n>>
		<!-- NPC's name will only appear if they are selected -->
		<<if $NPCList[_n].intro is 1>>
			<<if $npcrow.includes(_n) and $NPCList[_n].name_known is 1>>
				<<set _hisselect_output to window.KR.gatPersonNameDictKR($npc[$npcrow.indexOf(_n)]) + "의">> /* Uses a different temp var to avoid conflicts with inner _text_output temp vars */
			<<else>>
				<<set _hisselect_output to `<<persons>>`>>
			<</if>>
			<<set $NPCList[_n].intro to 0>>
		<<else>>
			<<set _hisselect_output to `<<his>>`>>
		<</if>>
	<<elseif $enemytype is "beast">>
		<<set _hisselect_output to `<<bhis>>`>>
	<<else>>
		<<set _hisselect_output to `<<his>>`>>
	<</if>>
<</silently>><<print _hisselect_output>><</widget>>

<!-- Keeping his1-6 for legacy support as of v2.3 -->
<<widget "his1">>
	<<person1>><<his>>
<</widget>>

<<widget "his2">>
	<<person2>><<his>>
<</widget>>

<<widget "his3">>
	<<person3>><<his>>
<</widget>>

<<widget "his4">>
	<<person4>><<his>>
<</widget>>

<<widget "his5">>
	<<person5>><<his>>
<</widget>>

<<widget "his6">>
	<<person6>><<his>>
<</widget>>

<<widget "himself">><<silently>>
	<!-- Add the option to call for named NPCs individually -->
	<<if _args[0]>>
		<<set $pronoun to C.npc[_args[0]].pronoun>>
	<</if>>
	<<if $pronoun is "m">>
		<<set _text_output to "자기 자신">>
	<<elseif $pronoun is "f">>
		<<set _text_output to "자기 자신">>
	<<elseif $pronoun is "i">>
		<<set _text_output to "자기 자신">>
	<<elseif $pronoun is "n">>
		<<set _text_output to "자기 자신">>
	<<elseif $pronoun is "t">>
		<<set _text_output to "자기 자신">>
	<<elseif $pronoun>>
		<<set _text_output to `<span class=\"red\">[에러: \"himself\"에서 알 수 없는 대명사 값 $pronoun]</span>`>>
	<<else>>
		<<set _text_output to `<span class=\"red\">[에러: \"himself\"에서 정의되지 않은 대명사]</span>`>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "people">><<silently>>
	<<if maleChance() is 100>>
		<<set _text_output to "남자들">>
	<<elseif maleChance() is 0>>
		<<set _text_output to "여자들">>
	<<else>>
		<<set _text_output to "남녀 모두">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "peopley">><<silently>>
	<<if maleChance() is 100>>
		<<set _text_output to "소년들">>
	<<elseif maleChance() is 0>>
		<<set _text_output to "소녀들">>
	<<else>>
		<<set _text_output to "소년 소녀들">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "peopleyv">><<silently>>
	<<if $settings.maleVictimChance is 100>>
		<<set _text_output to "소년들">>
	<<elseif $settings.maleVictimChance is 0>>
		<<set _text_output to "소녀들">>
	<<else>>
		<<set _text_output to "소년 소녀들">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "persony">><<silently>>
	<<rng>>
	<<set _text_output to ($rng lte maleChance()? "소년" : "소녀")>>
<</silently>><<print _text_output>><</widget>>

<<widget "group">><<silently>>
	<<if $enemyno gte 3 or ($combat is 1 and $enemynomax gte 3)>>
		<<for _g to 0; _g lt $NPCList.length; _g++>>
			<<if $NPCList[_g].pronoun is "m">>
				<<set $_group_man to true>>
			<<elseif $NPCList[_g].pronoun is "f">>
				<<set $_group_woman to true>>
			<</if>>
		<</for>>
		<<if $_group_man and $_group_woman>>
			<<set _text_output to ($NPCList[0].teen is 1? "소녀와 소년들" : "여자와 남자들")>>
		<<elseif $_group_man and !$_group_woman>>
			<<set _text_output to ($NPCList[0].teen is 1? "소년들" : "남자들")>>
		<<elseif !$_group_man and $_group_woman>>
			<<set _text_output to ($NPCList[0].teen is 1? "소녀들" : "여자들")>>
		<</if>>
	<<elseif $enemyno is 2 or ($combat is 1 and $enemynomax is 2)>>
		<<if $NPCList[0].pronoun isnot $NPCList[1].pronoun>>
			<<set _text_output to ($NPCList[0].teen is 1? "소녀와 소년" : "여자와 남자")>>
		<<elseif $NPCList[0].pronoun is "m">>
			<<set _text_output to ($NPCList[0].teen is 1? "소년들" : "남자들")>>
		<<elseif $NPCList[0].pronoun is "f">>
			<<set _text_output to ($NPCList[0].teen is 1? "소녀들" : "여자들")>>
		<</if>>
	<<else>>
		<<person>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "fullGroup">><<silently>>
	<<set $_person to []>>
	<<for _fg to 0; _fg lt $enemyno; _fg++>>
		<<personselect _fg>><<person>>
		<<set $_person.push(_text_output)>>
	<</for>>
	<<set _text_output to formatList($_person, "그리고", true)>>
	<<if _args[0] is "cap">><<set _text_output to _text_output.toLocaleUpperFirst()>><</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "enumeratedGroup">><<silently>>
	<<set $_menCount to $NPCList.countWith(npc => npc.pronoun is "m")>>
	<<set $_womenCount to $NPCList.countWith(npc => npc.pronoun is "f")>>
	<<silently>>
		<<number $_menCount>><<set $_men to _text_output + " " + ($_menCount is 1 ? "남자" : "남자들")>>
		<<number $_womenCount>><<set $_women to _text_output + " " + ($_womenCount is 1 ? "여자" : "여자들")>>
	<</silently>>

	<<set [$_first, $_second, $_secondCount] to ($_menCount gte $_womenCount ? [$_men, $_women, $_womenCount] : [$_women, $_men, $_menCount])>>

	<<set _text_output to $_first>>
	<<if $_secondCount gt 0>>
		<<set _text_output += " 그리고 " + $_second>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "EnumeratedGroup">><<silently>>
	<<enumeratedGroup>><<capitalise>>
<</silently>><<print _text_output>><</widget>>

<<widget "gendercheck">>
	<<if !["m", "f"].includes($player.gender_appearance)>><<set _text_output to "<span class=\"red\">오류: 예상치 못한 $$player.gender_appearance 값: [$player.gender_appearance]</span>">><</if>>
<</widget>>

