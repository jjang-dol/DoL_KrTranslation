<<widget "He">><<silently>>
	<<if _args[0]>>
		<!-- Add the option to call for a named NPC's name -->
		<<if $NPCNameList.includes(_args[0])>>
			<<set $pronoun to C.npc[_args[0]].pronoun>>
		<<else>>
			<<if Number.isInteger(_args[0]) and between(_args[0],0,5)>>
				<<personselect _args[0]>>
			<</if>>
		<</if>>
	<</if>>

	<<if $NPCList[$index].intro is 1>>
		<<set $NPCList[$index].intro to 0>>
		<<if $npcrow.includes($index)>>
			<<if $npc.includes("Black Wolf") or $npc.includes("Great Hawk")>>
				<<set _text_output to "그 " + window.KR.gatPersonNameDictKR($npc[$npcrow.indexOf($index)])>>
			<<elseif $npc.includes("Ivory Wraith")>>
				<<set _text_output to "창백한 형체">>
			<<elseif $NPCList[$index].name_known is 0>>
				<<set _text_output to "그 " + window.KR.getDescriptionKr($NPCList[$index].description)>>
			<<else>>
				<<set _text_output to window.KR.gatPersonNameDictKR($npc[$npcrow.indexOf($index)])>>
			<</if>>
		<<else>>
			<<if $enemytype is "beast">>
				<<beasttype>><<set _text_output to "그 " + _text_output>>
			<<elseif $NPCList[$index].name_known is 1>>
				<<set _text_output to window.KR.gatPersonNameDictKR($NPCList[$index].name)>>
			<<elseif $NPCList[$index].role is "normal">>
				<<person>><<set _text_output to "그 " + _text_output>>
			<<else>>
				<<set _text_output to "그 " + window.KR.getDescriptionKr($NPCList[$index].description) + " " + window.KR.getNpcTitleKr($NPCList[$index].role)>>
			<</if>>
		<</if>>
	<<else>>
		<<if $pronoun>>
			<<he>><<capitalise>>
		<<else>>
			<<set _text_output to `<span class="red">[오류: "He"에 정의되지 않은 대명사]</span>`>>
		<</if>>
	<</if>>
<</silently>>_text_output<</widget>>

<!-- Use when you want to force just the pronoun "He" and skip the .intro nonsense.-->
<<widget "He_Short">><<silently>>
	<<if $pronoun>>
		<<he>><<capitalise>>
	<<else>>
		<<set _text_output to `<span class="red">[오류: "He_Short"에 정의되지 않은 대명사]</span>`>>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "His">><<silently>>
	<!-- Add the option to call for named NPCs individually -->
	<<if _args[0]>>
		<<set $pronoun to C.npc[_args[0]].pronoun>>
	<</if>>
	<<if $pronoun is "m">>
		<<set _text_output to "그의">>
	<<elseif $pronoun is "f">>
		<<set _text_output to "그녀의">>
	<<elseif $pronoun is "i">>
		<<set _text_output to "그것의">>
	<<elseif $pronoun is "n">>
		<<set _text_output to "그">>
	<<elseif $pronoun is "t">>
		<<set _text_output to "그들의">>
	<<elseif $pronoun>>
		<<set _text_output to `<span class="red">[오류: "His"에서 인식할 수 없는 대명사 값 $pronoun]</span>`>>
	<<else>>
		<<set _text_output to `<span class="red">[오류: "His"에서 정의되지 않은 대명사]</span>`>>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "Hers">><<silently>>
	<!-- Add the option to call for named NPCs individually -->
	<<if _args[0]>>
		<<set $pronoun to C.npc[_args[0]].pronoun>>
