<</widget>>

<<widget "cow">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="blue">소</span>
	<</if>>
<</widget>>

<<widget "harpy">>
	<<if !$settings.blindStatsEnabled>> |
		<<if $hallucinations gte 2 or !$settings.bestialityEnabled>>
			<span class="gold">하피</span>
		<<else>>
			<span class="gold">새</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "fox">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="orange"><<print ($player.gender_appearance is "m" ? "여우소년" : "여우소녀")>></span>
	<</if>>
<</widget>>

<<widget "angel">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="gold">천사</span>
	<</if>>
<</widget>>

<<widget "angelBanishNote">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="def">추방 ($angelBanish / $angelBanishMax)</span>
	<</if>>
<</widget>>

<<widget "fallenangel">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="black">타락 천사</span>
	<</if>>
<</widget>>

<<widget "demon">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">악마</span>
	<</if>>
<</widget>>

<<widget "sharp_eyes">>
	<<if !$settings.blindStatsEnabled>> |
		<<if hasSharpSenses("sight") is 'sharp eyes'>>
			<span class="gold">날카로운 눈</span>
		<<else>>
			<span class="gold">예리한 눈</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "laugh">><<silently>>
	<<rng>>
	<<if $npcadult isnot 1>>
		<<set _text_output to either("키득거린다", "웃는다")>>
	<<elseif $pronoun is "f">> <!-- female adult -->
		<<set _text_output to either("키득거린다", "빙긋 웃는다", "웃는다")>>
	<<else>> <!-- male adult -->
		<<set _text_output to either("빙긋 웃는다", "웃는다")>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "laughs">><<silently>>
	<<laugh>>
<</silently>><<print _text_output>><</widget>>

<<widget "cursedtext">>
	<<if _args[0] is "collar" or _args[0] is "collar with leash">>
		<span class="blue">경찰이라면 도와줄 수 있을지 모른다.</span>
	<<elseif (_args[0] or _args[1]) is "chastity belt">>
		<span class="blue">신전이라면 도와줄 수 있을지 모른다.</span>
	<</if>>
<</widget>>

<<widget "generateRandomTeacher">><<silently>>
	<<set _position to _args[0] ? _args[0] : 1>>

	<<set _teacherNames to []>>
	<<if C.npc.Sirris.init is 1 and $schoolstate isnot "first">>
		<<run _teacherNames.push("Sirris")>>
	<</if>>
	<<if C.npc.River.init is 1 and $schoolstate isnot "second">>
		<<run _teacherNames.push("River")>>
	<</if>>
	<<if C.npc.Doren.init is 1 and $schoolstate isnot "third">>
		<<run _teacherNames.push("Doren")>>
	<</if>>
	<<if C.npc.Winter.init is 1 and $schoolstate isnot "fourth">>
		<<run _teacherNames.push("Winter")>>
	<</if>>
	<<if C.npc.Mason.init is 1 and $schoolstate isnot "fifth">>
		<<run _teacherNames.push("Mason")>>
	<</if>>

	<<if _teacherNames.length gte 1>>
		<<set _teacher to _teacherNames.random()>>
		<<set _text_output to window.KR.gatPersonNameDictKR(_teacher)>>
		<<switch _teacher>>
			<<case "Sirris">><<npc Sirris _position>>
			<<case "River">><<npc River _position>>
			<<case "Doren">><<npc Doren _position>>
			<<case "Winter">><<npc Winter _position>>
			<<case "Mason">><<npc Mason _position>>
		<</switch>>
	<<else>>
		<<set _teacher to "The teacher">>
		<<set _text_output to "선생님">>
		<<generateNPC _position>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "skincolourtext">>
    <<switch Skin.color.natural>>
        <<case "light" "rlight" "ylight" "glight" "blight">>
            밝은
        <<case "medium" "rmedium" "ymedium" "gmedium" "bmedium">>
            중간
        <<case "dark" "rdark" "ydark" "gdark" "bdark">>
            어두운
        <<case "gyaru" "rgyaru" "ygyaru" "ggyaru" "bgyaru">>
            <<set _textOverride to true>>
    <</switch>>
    <<if _textOverride is true>>
        <<if Skin.color.tan gte 66>>
            어두운
        <<elseif Skin.color.tan gte 33>>
            중간
        <<else>>
            밝은
        <</if>>
        피부색
    <<elseif Skin.color.tan gte 80>> 바탕에 짙게 태닝된 피부색
    <<elseif Skin.color.tan gte 60>> 바탕에 중간 정도로 태닝된 피부색
    <<elseif Skin.color.tan gte 30>> 바탕에 태닝된 피부색
    <<elseif Skin.color.tan gte 10>> 바탕에 옅게 태닝된 피부색
    <<else>> 피부색
    <</if>>
<</widget>>

<<widget "skintonetext">>
    <<switch Skin.color.natural>>
        <<case "light" "medium" "dark" "gyaru">>
            뉴트럴
        <<case "rlight" "rmedium" "rdark" "rgyaru">>
            웜
        <<case "ylight" "ymedium" "ydark" "ygyaru">>
            올리브
        <<case "glight" "gmedium" "gdark" "ggyaru">>
            골드
        <<case "blight" "bmedium" "bdark" "bgyaru">>
            쿨
    <</switch>>
    톤
<</widget>>

<<widget "beasttype">><<silently>>
	<<if typeof _args[0] is "number">>
		<<set _na to _args[0]>>
	<<else>>
		<<set _na to 0>>
	<</if>>
	<<set _text_output to window.KR.getBeastTypeKr($NPCList[_na].type)>>
<</silently>><<print _text_output>><</widget>>

<<widget "beasttypes">><<beasttype>>의<</widget>>

<<widget "beastsplural">><<silently>>
	<<if typeof _args[0] is "number">>
		<<set _na to _args[0]>>
	<<else>>
		<<set _na to 0>>
	<</if>>
	<<if $NPCList[_na].type is "wolf" and $monster isnot 1>>
		<<set _text_output to "늑대들">>
	<<elseif $NPCList[_na].type is "fox" and $monster isnot 1>>
		<<set _text_output to "여우들">>
	<<elseif $NPCList[_na].type is "harpy">>
		<<set _text_output to "하피들">>
	<<elseif $monster isnot 1 or $NPCList[_na].type is "centaur">>
		<<set _text_output to "<<beasttype _na>>들">>
	<<else>>
		<<for _i = 0; _i < $NPCList.length; _i++>>
			<<if $NPCList[_i].pronoun is "m">>
				<<set _malespresent to true>>
			<</if>>
			<<if $NPCList[_i].pronoun is "f">>
				<<set _femalespresent to true>>
			<</if>>
		<</for>>
		<<if (_malespresent isnot true or _femalespresent isnot true)>>
			<<set _text_output to "<<beasttype>>들">>
		<<elseif !$NPCList[2].pronoun>>
			<<set _text_output to window.KR.getBeastTypeKr($NPCList[0].type) + "【와과】 " + window.KR.getBeastTypeKr($NPCList[1].type)>>
		<<else>>
			<<switch $NPCList[_na].type>>
				<<case "lizardgirl" "lizardboy">><<set _text_output to "리자드걸과 리자드보이들">>
				<<case "wolfgirl" "wolfboy">><<set _text_output to "늑대소녀와 늑대소년들">>
				<<case "doggirl" "dogboy">><<set _text_output to "개소녀와 개소년들">>
				<<case "dolphingirl" "dolphinboy">><<set _text_output to "돌고래소녀와 돌고래소년들">>
				<<case "beargirl" "bearboy">><<set _text_output to "곰소녀와 곰소년들">>
				<<case "catgirl" "catboy">><<set _text_output to "고양이소녀와 고양이소년들">>
				<<case "piggirl" "pigboy">><<set _text_output to "돼지소녀와 돼지소년들">>
				<<case "boargirl" "boarboy">><<set _text_output to "멧돼지소녀와 멧돼지소년들">>
				<<case "cowgirl" "bullboy">><<set _text_output to "소 소녀와 소 소년들">>
				<<case "foxgirl" "foxboy">><<set _text_output to "여우소녀와 여우소년들">>
				<<case "spidergirl" "spiderboy">><<set _text_output to "거미소녀와 거미소년들">>
				<<default>><<set _text_output to "생물들">>
			<</switch>>
		<</if>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "beastgender">><<silently>>
	<<if typeof _args[0] is "number">>
		<<set _na to _args[0]>>
	<<elseif $enemyno gte 0>>
		<<set _na to $enemyno-1>>
	<<else>>
		<<set _na to 0>>
	<</if>>
	<<set _text_output to ($NPCList[_na].pronoun is "m" ? "소년" : "소녀")>>
<</silently>>_text_output<</widget>>

<<widget "beastSimple">>
	<<if typeof _args[0] is "string">>
		<<set $_type to _args[0]>>
	<<elseif typeof _args[0] is "number">>
		<<set $_type to $NPCList[_args[0]].type>>
	<<else>>
		<<set $_type to $NPCList[0].type>>
	<</if>>
	<<set $_plural to _args[1]>>
	<<switch $_type>>
		<<case "wolf" "wolfboy" "wolfgirl">>
			<<if $_plural>>
				<<set $_plural to false>>
				<<set _text_output to "늑대들">>
			<<else>>
				<<set _text_output to "늑대">>
			<</if>>
		<<case "fox" "foxboy" "foxgirl">>
			<<if $_plural>>
				<<set $_plural to false>>
				<<set _text_output to "여우들">>
			<<else>>
				<<set _text_output to "여우">>
			<</if>>
		<<case "harpy">>
			<<set _text_output to "새">>
		<<default>>
			/* Centaurs still get called centaurs because they're unique compared to other beasts */
			<<set _text_output to $_type.replace("소년","").replace("소녀","")>>
	<</switch>>
	<<if $_plural>>
		<<set _text_output += "들">>
	<</if>>
	<<exit _text_output>>
<</widget>>

<<widget "slut">><<silently>>
	<<set _text_output to ($player.gender_appearance is "m" ? "변태" : "걸레")>>
<</silently>><<print _text_output>><</widget>>

<<widget "tending_text">>
	<<set $_tendingText to currentSkillValue('tending')>>
	<<if $_tendingText gte 1200>>
		<span class="gold">이제는 전문가 수준이다.</span>
	<<elseif $_tendingText gte 800>>
		<span class="green">아주 능숙하게 해낸다.</span>
	<<elseif $_tendingText gte 600>>
		<span class="teal">꽤 능숙하게 해낸다.</span>
	<<elseif $_tendingText gte 400>>
		<span class="lblue">무난하게 해낸다.</span>
	<<elseif $_tendingText gte 200>>
		<span class="blue">이제 막 감을 잡았다.</span>
	<<else>>
		<span class="purple">아직은 서투르다.</span>
	<</if>>
<</widget>>

<<widget "housekeeping_text">>
<<set $_housekeepingText to currentSkillValue('housekeeping')>>
<<if $_housekeepingText gte 1200>>
	<span class="gold">이제는 전문가 수준이다.</span>
<<elseif $_housekeepingText gte 800>>
	<span class="green">아주 능숙하게 해낸다.</span>
<<elseif $_housekeepingText gte 600>>
	<span class="teal">꽤 능숙하게 해낸다.</span>
<<elseif $_housekeepingText gte 400>>
	<span class="lblue">무난하게 해낸다.</span>
<<elseif $_housekeepingText gte 200>>
	<span class="blue">이제 막 감을 잡았다.</span>
<<else>>
	<span class="purple">아직은 서투르다.</span>
<</if>>
<</widget>>

<<widget "wordify_i">>
	<<switch _args[0]>>
		<<case 0>>
			<<set _text_output to "첫 번째">>
		<<case 1>>
			<<set _text_output to "두 번째">>
		<<case 2>>
			<<set _text_output to "세 번째">>
		<<case 3>>
			<<set _text_output to "네 번째">>
		<<case 4>>
			<<set _text_output to "다섯 번째">>
		<<case 5>>
			<<set _text_output to "여섯 번째">>
		<<case 6>>
			<<set _text_output to "일곱 번째">>
		<<case 7>>
			<<set _text_output to "여덟 번째">>
		<<case 8>>
			<<set _text_output to "아홉 번째">>
		<<case 9>>
			<<set _text_output to "열 번째">>
	<</switch>>
	<<if _text_output is undefined>>
		<<set _text_output to "열한 번째">>
	<</if>>
	<<if _args[1]>>
		<<capitalise>>
	<<else>>
		<<print _text_output>>
	<</if>>
<</widget>>

<<widget "threaten">>
	<<rng>>
	<<if $NPCList[_n].pronoun is "m">>
		<<if $NPCList[_n].penis isnot "none">>
			<<if $player.gender_appearance is "m">>
				<<if $rng gte 81>>
					"네가 비명을 지를 때까지 네 엉덩이를 박아주지."
				<<elseif $rng gte 61>>
					"널 내 <<bitch>>【으로로】 만들어주마."
				<<elseif $rng gte 41>>
					"내 볼일이 끝나면, 넌 내 자지를 숭배하게 될 거다."
				<<elseif $rng gte 21>>
					"널 내 새로운 오나홀로 만들어주마."
				<<else>>
					"네 엉덩이를 가득 채워주마."
				<</if>>
			<<else>>
				<<if $rng gte 81>>
					"네가 비명을 지를 때까지 네 보지에 박아주지."
				<<elseif $rng gte 61>>
					"널 내 <<bitch>>【으로로】 만들어주마."
				<<elseif $rng gte 41>>
					"내 볼일이 끝나면, 넌 내 자지를 숭배하게 될 거다."
				<<elseif $rng gte 21>>
					"네 구멍이란 구멍은 죄다 박아주마."
				<<else>>
					"널 내 새로운 오나홀로 만들어주마."
				<</if>>
			<</if>>
		<<else>>
			<<if $player.gender_appearance is "m">>
				<<if $rng gte 81>>
					"기절할 때까지 네 위에서 허리를 흔들어주마."
				<<elseif $rng gte 61>>
					"네 자지가 항복할 때까지 괴롭혀주지."
				<<elseif $rng gte 41>>
					"남김없이 쥐어짜 주마."
				<<elseif $rng gte 21>>
					"내가 끝낼 때쯤이면 네 자지가 욱신거릴 거다."
				<<else>>
					"넌 내가 원하는 모든 방식으로 내 보지에 봉사하게 될 거다."
				<</if>>
			<<else>>
				<<if $rng gte 81>>
					"네가 비명을 지를 때까지 쑤셔주마."
				<<elseif $rng gte 61>>
					"네 보지가 항복할 때까지 쑤셔주지."
				<<elseif $rng gte 41>>
					"넌 내가 원하는 모든 방식으로 내 보지에 봉사하게 될 거다."
				<<elseif $rng gte 21>>
					"어떻게든 날 가게 만들어야 할 거다."
				<<else>>
					"네 구석구석을 지배해주지."
				<</if>>
			<</if>>
		<</if>>
	<<else>>
		<<if $NPCList[_n].penis isnot "none">>
			<<if $player.gender_appearance is "m">>
				<<if $rng gte 81>>
					"네가 비명을 지를 때까지 네 엉덩이를 박아주지."
				<<elseif $rng gte 61>>
					"널 내 <<bitch>>【으로로】 만들어주마."
				<<elseif $rng gte 41>>
					"내 볼일이 끝나면, 넌 내 자지를 숭배하게 될 거다."
				<<elseif $rng gte 21>>
					"널 내 새로운 오나홀로 만들어주마."
				<<else>>
					"네 엉덩이를 가득 채워주마."
				<</if>>
			<<else>>
				<<if $rng gte 81>>
					"네가 비명을 지를 때까지 네 보지에 박아주지."
				<<elseif $rng gte 61>>
					"널 내 <<bitch>>【으로로】 만들어주마."
				<<elseif $rng gte 41>>
					"내 볼일이 끝나면, 넌 내 자지를 숭배하게 될 거다."
				<<elseif $rng gte 21>>
					"네 구멍이란 구멍은 죄다 박아주마."
				<<else>>
					"널 내 새로운 오나홀로 만들어주마."
				<</if>>
			<</if>>
		<<else>>
			<<if $player.gender_appearance is "m">>
				<<if $rng gte 81>>
					"기절할 때까지 네 위에서 허리를 흔들어주마."
				<<elseif $rng gte 61>>
					"네 자지가 항복할 때까지 괴롭혀주지."
				<<elseif $rng gte 41>>
					"남김없이 쥐어짜 주마."
				<<elseif $rng gte 21>>
					"내가 끝낼 때쯤이면 네 자지가 욱신거릴 거다."
				<<else>>
					"네 정액이 필요해. 한 방울도 남김없이."
				<</if>>
			<<else>>
				<<if $rng gte 81>>
					"네가 비명을 지를 때까지 쑤셔주마."
				<<elseif $rng gte 61>>
					"네 보지가 항복할 때까지 쑤셔주지."
				<<elseif $rng gte 41>>
					"넌 내가 원하는 모든 방식으로 내 보지에 봉사하게 될 거다."
				<<elseif $rng gte 21>>
					"어떻게든 날 가게 만들어야 할 거다."
				<<else>>
					"네 구석구석을 지배해주지."
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "voice">>
	<<switch _args[0]>>
		<<case "plead">>
			<<if $pain lte 60>>
				<<if $rng lte 33>><<set _text_output to "애원한다">>
				<<elseif $rng lte 66>><<set _text_output to "간청한다">>
				<<elseif $wolfgirl gte 4>><<set _text_output to "훌쩍인다">>
				<<elseif $cat gte 4>><<set _text_output to "낑낑댄다">>
				<<elseif $cow gte 4>><<set _text_output to "음매거린다">>
				<<elseif $harpy gte 4>><<set _text_output to "짹짹거린다">>
				<<elseif $fox gte 4>><<set _text_output to "훌쩍인다">>
				<<else>><<set _text_output to "애원한다">><</if>>
			<<else>>
				<<if $rng lte 50>><<set _text_output to "울며 애원한다">>
				<<else>><<set _text_output to "흐느끼며 애원한다">><</if>>
			<</if>>
		<<case "moan">>
			<<if $rng lte 25>>
				<<if $arousal lt ($arousalmax / 5) * 3>><<set _text_output to "신음한다">>
				<<else>><<set _text_output to "헐떡이며 신음한다">><</if>>
			<<elseif $rng lte 50>><<set _text_output to "중얼거린다">>
			<<elseif $rng lte 75>>
				<<if $arousal lt ($arousalmax / 5) * 3>><<set _text_output to "킥킥댄다">>
				<<else>><<set _text_output to "헐떡이며 킥킥댄다">><</if>>
			<<elseif $wolfgirl gte 4>><<set _text_output to "숨을 헐떡인다">>
			<<elseif $cat gte 4>><<set _text_output to "가르랑거린다">>
			<<elseif $cow gte 4>><<set _text_output to "음매거린다">>
			<<elseif $harpy gte 4>><<set _text_output to "짹짹거린다">>
			<<elseif $fox gte 4>><<set _text_output to "깨갱거린다">>
			<<else>><<set _text_output to "신음한다">><</if>>
		<<case "demand">>
			<<if $arousal lt ($arousalmax / 5) * 3>>
				<<if $rng lte 33>><<set _text_output to "말한다">>
				<<elseif $rng lte 66>><<set _text_output to "소리친다">>
				<<elseif $wolfgirl gte 4>><<set _text_output to "짖는다">>
				<<elseif $cat gte 4>><<set _text_output to "하악질한다">>
				<<elseif $cow gte 4>><<set _text_output to "콧김을 뿜는다">>
				<<elseif $harpy gte 4>><<set _text_output to "새액거린다">>
				<<elseif $fox gte 4>><<set _text_output to "비명을 지른다">>
				<<else>><<set _text_output to "침을 뱉는다">><</if>>
			<<elseif $rng lte 50>><<set _text_output to "헐떡인다">>
			<<else>><<set _text_output to "으르렁거린다">><</if>>
		<<default>><<set _text_output to "딸꾹질을 한다">>
	<</switch>>
	<<print _text_output>>
<</widget>>

<<widget "vagina_lube_amount">>
	<<if _vagina_lube_amount gte 12>>
		<span class="red">상당한</span> 양의
	<<elseif _vagina_lube_amount gte 8>>
		<span class="pink">충분한</span> 양의
	<<elseif _vagina_lube_amount gte 5>>
		<span class="pink">많은 양</span>의
	<<elseif _vagina_lube_amount gte 3>>
		<span class="purple">적당한</span> 양의
	<<elseif _vagina_lube_amount gte 2>>
		<span class="purple">빈약한</span> 양의
	<<else>>
		<span class="purple">보잘것없는</span> 양의
	<</if>>
<</widget>>

<<widget "anus_lube_amount">>
	<<if _anus_lube_amount gte 12>>
		<span class="red">엄청난</span> 양의
	<<elseif _anus_lube_amount gte 8>>
		<span class="pink">충분한</span> 양의
	<<elseif _anus_lube_amount gte 5>>
		<span class="pink">많은 양</span>
	<<elseif _anus_lube_amount gte 3>>
		<span class="purple">적당한</span> 양의
	<<elseif _anus_lube_amount gte 2>>
		<span class="purple">빈약한</span> 양의
	<<else>>
		<span class="purple">보잘것없는</span> 양의
	<</if>>
<</widget>>

<<widget "penis_lube_amount">>
	<<if _penis_lube_amount gte 10>>
		<span class="red">엄청난</span> 양의
	<<elseif _penis_lube_amount gte 6>>
		<span class="pink">충분한</span> 양의
	<<elseif _penis_lube_amount gte 4>>
		<span class="pink">많은 양의</span>
	<<elseif _penis_lube_amount gte 3>>
		<span class="purple">적당한</span> 양의
	<<elseif _penis_lube_amount gte 2>>
		<span class="purple">빈약한</span> 양의
	<<else>>
		<span class="purple">형편없는</span> 양의
	<</if>>
<</widget>>

<<widget "vagina_lube_text">>
	<<set _vagina_lube_amount to setup.bodyliquid.combined("vagina") + setup.bodyliquid.combined("vaginaoutside") + Math.max(0, $vaginaArousalWetness - 60) / 5>>
	<<if _vagina_lube_amount lte 0>>
		당신이 얼마나 메말라 있는지에도 불구하고,
	<<else>>
		<<vagina_lube_amount>> 윤활액의 도움을 받아,
	<</if>>
<</widget>>

<<widget "anus_lube_text">>
	<<set _anus_lube_amount to setup.bodyliquid.combined("anus") + setup.bodyliquid.combined("bottom")>>
	<<if _anus_lube_amount lte 0>>
		윤활액이 부족함에도 불구하고,
	<<else>>
		<<anus_lube_amount>> 윤활액의 도움을 받아,
	<</if>>
<</widget>>

<<widget "penis_lube_text">>
	<<set _penis_lube_amount to setup.bodyliquid.combined("penis")>>
	<<if _penis_lube_amount lte 0>>
		윤활액이 부족함에도 불구하고,
	<<else>>
		<<penis_lube_amount>> 윤활액의 도움을 받아,
	<</if>>
<</widget>>

<<widget "small_text">>
	<<if !$settings.blindStatsEnabled>> |
		<<if $physiquesize lte 6000>>
			<span class="teal">매우 작은 몸</span>
		<<elseif $physiquesize lte 9000>>
			<span class="teal">작은 몸</span>
		<<elseif $physiquesize lte 12000>>
			<span class="teal">그다지 크지 않은 몸</span>
		<<else>>
			<span class="teal">그다지 크지 않은 몸</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "large_text">>
		<<if !$settings.blindStatsEnabled>> |
		<<if $physiquesize gte 15000>>
			<span class="teal">거대한 체형</span>
		<<elseif $physiquesize gte 12000>>
			<span class="teal">보통 체형</span>
		<<elseif $physiquesize gte 9000>>
			<span class="teal">너무 작지 않음</span>
		<<else>>
			<span class="teal">너무 작지 않음</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "body_size_text">>
	<<switch $physiquesize>>
		<<case lte 6000>>
			<<set _text_output to either("아주 작은", "가냘픈", "자그마한", "왜소한", "섬세한") + " ">>
		<<case lte 9000>>
			<<set _text_output to either("작은", "아담한", "조그마한", "작은 편인") + " ">>
		<<case lte 12000>>
			<<set _text_output to either("평균적인", "보통의", "평범한") + " ">>
		<<case lte 15000>>
			<<set _text_output to either("큰", "튼튼한", "힘 있는", "당당한") + " ">>
		<<default>>
	<</switch>>
	<<set _text_output to _text_output + either("몸", "체격", "신체", "몸통")>>
	<<print _text_output>>
<</widget>>

<<widget "monster_passage">>
	<!-- Unused widget -->
	<<if _monster_passage is undefined>>
		<<if ($settings.monsterChance gte 1 and $hallucinations gte 1) or ($settings.monsterChance gte 1 and !$settings.monsterHallucinationsOnly)>>
			<<if maleChance() gte 100>>
				<<set _monster_passage to "m">>
			<<elseif maleChance() lte 0>>
				<<set _monster_passage to "f">>
			<<else>>
				<<set _monster_passage to "b">>
			<</if>>
		<<else>>
			<<set _monster_passage to "n">>
		<</if>>
	<</if>>
<</widget>>

<<widget "farm_text_many">>
	<<set $_bgender to _args[1] ? _args[1] : $farm_work[_args[0]].gender_plural>>
	<<set $_bperson to ($farm_work[_args[0]].monster_roll is true and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly))>>
	<<if _args[0] is "horse">>
		<<if $_bperson>>
			<<set _text_output to "켄타우로스들">>
		<<else>>
			<<set _text_output to "말들">>
		<</if>>
	<<elseif _args[0] is "pig">>
		<<if $_bperson>>
			<<if $_bgender is "m">>
				<<set _text_output to "돼지소년들">>
			<<elseif $_bgender is "f">>
				<<set _text_output to "돼지소녀들">>
			<<else>>
				<<set _text_output to "돼지인간들">>
			<</if>>
		<<else>>
			<<set _text_output to "돼지들">>
		<</if>>
	<<elseif _args[0] is "dog">>
		<<if $_bperson>>
			<<if $_bgender is "m">>
				<<set _text_output to "개소년들">>
			<<elseif $_bgender is "f">>
				<<set _text_output to "개소녀들">>
			<<else>>
				<<set _text_output to "개인간들">>
			<</if>>
		<<else>>
			<<set _text_output to "개들">>
		<</if>>
	<<else>>
		<<if $_bperson>>
			<<if $_bgender is "m">>
				<<set _text_output to "황소소년들">>
			<<elseif $_bgender is "f">>
				<<set _text_output to "젖소소녀들">>
			<<else>>
				<<set _text_output to "소들">>
			<</if>>
		<<else>>
			<<if $_bgender is "m">>
				<<set _text_output to "황소들">>
			<<elseif $_bgender is "f">>
				<<set _text_output to "젖소들">>
			<<else>>
				<<set _text_output to "소들">>
			<</if>>
		<</if>>
	<</if>>
	<<print _text_output>>
<</widget>>

<!-- No change for horses and cattle. Pigs, dogs, and cows get called "pigperson", "dogperson", and "cowperson". -->
<<widget "farm_text_neutral">>
	<<set $_bperson to ($farm_work[_args[0]].monster_roll is true and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly))>>
	<<if _args[0] is "horse">>
		<<if $_bperson>>
			<<set _text_output to "켄타우로스">>
		<<else>>
			<<set _text_output to "말">>
		<</if>>
	<<elseif _args[0] is "pig">>
		<<if $_bperson>>
			<<set _text_output to "돼지 수인">>
		<<else>>
			<<set _text_output to "돼지">>
		<</if>>
	<<elseif _args[0] is "dog">>
		<<if $_bperson>>
			<<set _text_output to "개 수인">>
		<<else>>
			<<set _text_output to "개">>
		<</if>>
	<<else>>
		<!-- English doesn't have a genderless singular form for "cattle". Defaulting to "cow" and "cowperson". -->
		<<if $_bperson>>
			<<set _text_output to "소 수인">>
		<<else>>
			<<set _text_output to "소">>
		<</if>>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "farm_text">>
	<<set $_bgender to _args[1] ? _args[1] : $farm_work[_args[0]].gender>>
	<<set $_bperson to ($farm_work[_args[0]].monster_roll is true and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly))>>
	<<if _args[0] is "horse">>
		<<if $_bperson>>
			<<set _text_output to "켄타우로스">>
		<<else>>
			<<set _text_output to "말">>
		<</if>>
	<<elseif _args[0] is "pig">>
		<<if $_bperson>>
			<<set _text_output to ($_bgender is "m" ? "돼지소년" : "돼지소녀")>>
		<<else>>
			<<set _text_output to "돼지">>
		<</if>>
	<<elseif _args[0] is "dog">>
		<<if $_bperson>>
			<<set _text_output to ($_bgender is "m" ? "개소년" : "개소녀")>>
		<<else>>
			<<set _text_output to "개">>
		<</if>>
	<<else>>
		<<if $_bperson>>
			<<set _text_output to ($_bgender is "m" ? "황소 소년" : "젖소 소녀")>>
		<<else>>
			<<set _text_output to ($_bgender is "m" ? "황소" : "젖소")>>
		<</if>>
	<</if>>
	<<print _text_output>>
<</widget>>

