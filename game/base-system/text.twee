<!-- Exhibitionism -->

<<widget "exhibitionist">>
	<<if !$settings.blindStatsEnabled>> |
		<<set _classList to ["","teal","lblue","blue","purple","pink","red"][_args[0]]>>
		<<set _classList += " " + getLargestSexStatModifierCssClasses("exhibitionism", _args[0])>>
