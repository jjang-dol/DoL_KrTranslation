<</silently>><<print _text_output>><</widget>>

<<widget "fadeText">>
	<span class="originalText fade-out">_args[0]</span>
	<span class="changedText" hidden="">_args[1]</span>
	<<set _delay to (_delay ? _delay : []).concat(_args[2] ? _args[2] : 1)>>

	<<script>>
		T.currentPassage = State.passage;

		$(document).one(':passageend', function(ev) {
			const originalTargets = [...document.getElementsByClassName('originalText')];
			const changedTargets = [...document.getElementsByClassName('changedText')];

			originalTargets.forEach((ele, index) => {
				if (ele instanceof HTMLElement) {
					setTimeout(() => {
						if (State.passage === T.currentPassage) {
							ele.remove();
							changedTargets[index].hidden = false;
							changedTargets[index].classList.add('fade-in')
						}
					}, T.delay[index] * 1000);

					ele.addEventListener('animationend', function() {
						ele.style.opacity = '0';
					});
				}
			});
		});
	<</script>>
<</widget>>

<<widget "badEndProse">><<silently>>
	<<switch _args[0]>>
		<<case "Underground Farm">><<set _text_output to "레미의 농장">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Eden">><<set _text_output to "에덴의 오두막">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Kylar Abduction">><<set _text_output to "카일라의 저택">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Underground Dungeon">><<set _text_output to "지하 창관">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Mines">><<set _text_output to "아파트 아래의 동굴">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Asylum">><<set _text_output to "숲속 정신병원">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Prison">><<set _text_output to "교도소">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Pound">><<set _text_output to "유기견 보호소">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Island">><<set _text_output to "근처 섬">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Pirate Ship">><<set _text_output to "해적선">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<case "Wolf Cave">><<set _text_output to "늑대 동굴">><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
		<<default>><<set _text_output to "" + _args[0].toLowerCase()>><<if _args[1] is "at">><<set _text_output to _text_output + "에서">><</if>>
	<</switch>>
	<<if _args[2] is "cap">><<capitalise>><</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "insufficientQuantity">><<silently>>
	/* Args 0-2 are Statement, Color (optional), Icon (optional) */
	/* Pass "" into Icon to not print one. */
	/* Example: <<insufficientQuantity "peaches to accept such an offer">> 											-------------->	would print (in blue): 	'You do not have enough peaches to accept such an offer'*/
	/* Example: <<insufficientQuantity "buckets of animal fluid to satisfy Gwylan :P" "pink" "<<farmicon 'bucket'>>">> 	---------->	would print (in red): 	'You do not have enough [milk-bucket.png] buckets of animal fluid to satisfy Gwylan :P' */
	/* Example: <<insufficientQuantity "beauty, allure, or skill to be noticed" "purple">> 									------>	would print (in purple):'You do not have enough beauty, allure, or skill to be noticed' */

	<<set _color to _args[1] ? _args[1] : "blue">>
	<<set _icon to _args[2] ? _args[2] : "">>

<</silently>><span @class="_color"><<if _icon is not "">><<print _icon>><</if>> _args[0]【이가】 부족합니다.</span><</widget>>

<<widget "insufficientStat">><<silently>>
	/* Args 0-3 are Stat, Task, Color (optional), and Custom Stat (optional, only use when Stat arg is 'custom')*/
	/* Example: <<insufficientStat "promiscuity" "to accept such an offer">> 	---------------------->	would print (in blue): 	'You are not promiscuous enough to accept such an offer'*/
	/* Example: <<insufficientStat "deviancy" "to do as you were told" "red">> 		------------------>	would print (in red): 	'You are not deviant enough to do as you were told' */
	/* Example: <<insufficientStat "housekeeping" "to make arrangements" "purple">> 	-------------->	would print (in purple):'You are not a skilled enough housekeeper to make arrangements' */
	/* Example: <<insufficientStat "custom" "to be worthy" "pink" "pious or graceful">> 	---------->	would print (in pink): 	'You are not pious or graceful enough to be worthy' */
	/* Example: <<insufficientStat "custom" "to be noticed" "green" "beautiful, alluring, or skilled">> would print (in green): 'You are not beautiful, alluring, or skilled enough to be noticed' */

	<<set $_color to _args[2] ? _args[2] : "blue">>
	<<set $_statText to "">>
	<<set $_prefix to _args[1] ? _args[1] + " " : "">>
	<<if _args[0] isnot "custom">>
		<<switch _args[0]>>
			<<case "promiscuity">><<set $_statText to "음란함이">>
			<<case "exhibitionism">><<set $_statText to "노출증이">>
			<<case "deviancy">><<set $_statText to "이상성욕이">>
			<<case "purity">><<set $_statText to "순결함이">>
			<<case "beauty">><<set $_statText to "미모가">>
			<<case "physique">><<set $_statText to "체격이">>
			<<case "willpower">><<set $_statText to "의지력이">>
			<<case "awareness">><<set $_statText to "성지식이">>
			<<case "skulduggery">><<set $_statText to "속임수 실력이">>
			<<case "dancing">><<set $_statText to "춤 실력이">>
			<<case "swimming">><<set $_statText to "수영 실력이">>
			<<case "athletics">><<set $_statText to "체육 실력이">>
			<<case "tending">><<set $_statText to "관리 실력이">>
			<<case "housekeeping">><<set $_statText to "가사 실력이">>
			<<case "science">><<set $_statText to "과학 지식이">>
			<<case "maths">><<set $_statText to "수학 지식이">>
			<<case "english">><<set $_statText to "영어 지식이">>
			<<case "history">><<set $_statText to "역사 지식이">>
			<<case "submissive">><<set $_statText to "반항심이">>
			<<case "trust">><<set $_statText to "신뢰도가">>
			<<default>><<set $_statText to "음란함이">>
		<</switch>>
		<<set $_text_output to $_prefix + $_statText + " 부족합니다.">>
	<<else>> /* Only use this for explicitly non-standard cases, like those that need multiple stats printed */
		<<set $_text_output to $_prefix + _args[3] + " 부족합니다.">>
	<</if>>

	/* Throws an error if 'custom' stat input is being used incorrectly */
	<<if _args[3] and _args[0] isnot "custom">>
        <<set $_color to "red">>
        <<set $_text_output to "구문 오류: \"insufficientStat\" 위젯에서 'custom' 스탯 인수를 사용하지 않고 커스텀 스탯 '_args[3]'【을를】 입력했습니다. 이 문제를 제보해 주십시오.">>
    <<elseif _args[0] is "custom" and !_args[3]>>
        <<set $_color to "red">>
        <<set $_text_output to "구문 오류: \"insufficientStat\" 위젯에서 커스텀 스탯을 입력하지 않고 'custom' 스탯 인수를 사용했습니다. 이 문제를 제보해 주십시오.">>
    <</if>>
<</silently>><<if $_text_output>><span @class="$_color"><<print $_text_output>></span><</if>><</widget>>

<<widget "anxiety_disorder_text">><<if !$settings.blindStatsEnabled>>
	| <span class="red">불안 장애</span>
<</if>><</widget>>

<<widget "severe_anxiety_disorder_text">><<if !$settings.blindStatsEnabled>>
	| <span class="red">중증 불안장애</span>
<</if>><</widget>>
<<widget "ordinalList">><<silently>>
	<<if _args[1] is "cap">>
		<<set $_and to _args[2] or "그리고">>
		<<set $_comma to _args[3] isnot undefined ? _args[3] : true>>
	<<else>>
		<<set $_and to _args[1] or "그리고">>
		<<set $_comma to _args[2] isnot undefined ? _args[2] : true>>
	<</if>>
	<<if typeof _args[0] isnot "object">>
		<<set _text_output to '<span class="red">문법 오류: args0 "' + _args[0] + '"【은는】 배열이 아닙니다.</span>'>>
	<<elseif !_args[0].length>>
		<<set _text_output to '<span class="red">문법 오류: args0 "' + _args[0] + '"【은는】 객체이거나 빈 배열입니다.</span>'>>
	<<else>>
		<<set $_list to []>>
		<<for _i range _args[0]>>
			<<set $_list.push(ordinalWritten(_i))>>
		<</for>>
		<<set _text_output to formatList($_list, $_and, $_comma)>>
		<<if _args[1] is "cap">><<capitalise>><</if>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "hypnosisText">>
	<<if V.options.textAnimsAll && V.options.textAnimsHypno>><<exit '<span @class="basicHypnoCss()">' + _args[0] + '</span>'>><</if>>
	<span @class="basicHypnoCss()"><<hypnosisicon "inline">><<= _args[0]>><<hypnosisicon "inline">></span>
<</widget>>

