			<<set _text_output to "치마">>
		<<else>>
			<<if $worn.under_lower.gender is "f">>
				<<if random(1, 2) is 2>>
					<<set _text_output to "팬티">>
				<<else>>
					<<set _text_output to "속바지">>
				<</if>>
