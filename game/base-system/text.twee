<</widget>>

<<widget "npcPenis">><<silently>>
	<<set $_npcGen to (_args[0] ?? $index)>>
	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcPenis-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].chastity.penis is "chastity cage">>
		<<set _text_output to "구속된 자지">>
	<<elseif $NPCList[$_npcGen].chastity.penis.includes("chastity")>>
		<<set _text_output to $NPCList[$_npcGen].chastity.penis>>
	<<elseif npcHasStrapon($_npcGen)>>
		<<set _text_output to either("페니스 밴드","페니스 밴드")>>
	<<else>>
		<<set _text_output to window.KR.getPenisDescKr($NPCList[$_npcGen].penisdesc)>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcPenisSimple">><<silently>>
	<<if $enemynomax is 1>>
		<<set _args[0] to 0>>
	<</if>>
	<<set $_npcGen to (_args[0] ?? $index)>>
	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcPenisSimple-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].chastity.penis is "chastity cage">>
		<<set _text_output to "구속된 자지">>
	<<elseif $NPCList[$_npcGen].chastity.penis.includes("chastity")>>
		<<set _text_output to $NPCList[$_npcGen].chastity.penis>>
	<<elseif npcHasStrapon($_npcGen)>>
		<<set _text_output to either("페니스 밴드","페니스 밴드")>>
	<<else>>
		<<set _text_output to either("자지","자지","자지","육봉")>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcPenisColored">>
	<<set $_npcGen to (_args[0] ?? $index)>>
	<<set $_ppcolor to "tan">>
	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcPenisColored-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].chastity.penis.includes("chastity")>>
		<<set $_ppcolor to "grey">>
		<<set _text_output to $NPCList[$_npcGen].chastity.penis>>
	<<elseif npcHasStrapon($_npcGen)>>
		<<set $_ppcolor to $NPCList[$_npcGen].strapon.color>>
		<<if $_ppcolor is "fleshy">><<set $_ppcolor to "tan">><</if>>
		<<set _text_output to window.KR.getPenisDescKr($NPCList[$_npcGen].penisdesc)>>
	<<else>>
		<<set _text_output to window.KR.getPenisDescKr($NPCList[$_npcGen].penisdesc)>>
	<</if>>
	<span @class=$_ppcolor><b><<print _text_output>></b></span>
<</widget>>

<<widget "npcVagina">><<silently>>
	<<set $_npcGen to (_args[0] ?? $index)>>
	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcVagina-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].chastity.vagina.includes("chastity")>>
		<<set _text_output to $NPCList[$_npcGen].chastity.vagina>>
	<<else>>
