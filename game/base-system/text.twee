	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcAnus">>
	<<set $_npcGen to (_args[0] ?? $index)>>
	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcAnus-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].chastity.anus.includes("shield")>>
		<<set _text_output to $NPCList[$_npcGen].chastity.anus>>
	<<else>>
		<<set _text_output to "항문">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "npcGenitals">><<silently>>
	<<set $_npcGen to (_args[0] ?? $index)>>
	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcGenitals-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].penis isnot "none" and $NPCList[$_npcGen].vagina isnot "none">>
		<<if _args[1] is "simple">>
			<<set $_text_output to "<<npcPenisSimple $_npcGen>> 그리고 <<npcVagina $_npcGen>>">>
		<<else>>
			<<set $_text_output to "<<npcPenis $_npcGen>> 그리고 <<npcVagina $_npcGen>>">>
		<</if>>
	<<elseif $NPCList[$_npcGen].penis isnot "none">>
		<<if _args[1] is "simple">>
			<<set $_text_output to "<<npcPenisSimple $_npcGen>>">>
		<<else>>
			<<set $_text_output to "<<npcPenis $_npcGen>>">>
		<</if>>
	<<else>>
		<<set $_text_output to "<<npcVagina $_npcGen>>">>
	<</if>>
<</silently>><<print $_text_output>><</widget>>

<<widget "npcChest">><<silently>>
	<<set $_npcGen to (_args[0] ?? $index)>>

	<<if !$NPCList[$_npcGen]>>
		<<set _text_output to `<span class="red">오류-npcChest-${$_npcGen}</span>`>>
	<<elseif $NPCList[$_npcGen].pronoun is "m" or $NPCList[$_npcGen].breastsize is 0>>
		<<set _text_output to "가슴">>
	<<else>>
		<<set _text_output to window.KR.getBreastSizeKr($NPCList[$_npcGen].breastsdesc)>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcHairColour">><<silently>>
	<<if _args[0]>>
		<<if C.npc[_args[0]].hairColour in setup.colours.hair_map>>
			<<set _text_output to setup.colours.hair_map[C.npc[_args[0]].hairColour].name>>
		<<else>>
			<<set _text_output to C.npc[_args[0]].hairColour>>
		<</if>>
	<<else>>
		<<set _text_output to "유령 같은 색입니다. 누군가 npcHairColour 위젯에 NPC를 정의하는 것을 깜빡했으니 Vrelnir에게 알려주세요">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<!-- Argument 0 is the appropriate NPCName or NPCList object.
Argument 1 should be "upper", "lower", or "both"
Argument 2, where appropriate, determines whether it's the player undressing the NPC or the NPC undressing themselves-->
<<widget "npcClothesText">><<silently>>
	<<if _args[0]>>
		<<set $_npc to _args[0]>>
		<<set $_part to (_args[1] ? _args[1] : "both")>>
		<<switch $_part>>
			<<case "both">>
				<<set _text_output to setup.npcClothesSets.find(item => item.name === $_npc.clothes.set).desc>>
			<<case "upper">>
				<<set _text_output to $_npc.clothes.upper.name>>
			<<case "lower">>
				<<set _text_output to $_npc.clothes.lower.name>>
			<<default>>
				<<set _text_output to '<span class="red">오류: 잘못된 NPC 의류 상황입니다. (NPC: $_npc.fullDescription, 호출된 부위: $_part) PurityGuy에게 알려주세요</span>'>>
		<</switch>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcUndressText">><<silently>>
	<<if _args[0]>>
		<<set $_npc to _args[0]>>
		<<set $_part to (_args[1] ? _args[1] : "both")>>
		<<set $_self to (_args[2] ? true : false)>>
		<<set $_his to ($combat is 1 ? "<<hisselect $index>>" : "<<his>>")>>
		<<set _text_output to "">>
		<<if !$_npc.clothes>>
			<<set _text_output += '<span class="red">오류: NPC ($_npc.fullDescription)의 옷 정보가 정의되지 않았습니다. PurityGuy에게 알려주세요</span>'>>
		<<elseif $_part is "both">>
			<<set $_clothesDesc to setup.npcClothesSets.find(item => item.name === $_npc.clothes.set).desc>>
			<<set _text_output += $_his + " " + $_clothesDesc + ($_self ? "【을를】 벗는다" : "【을를】 벗긴다")>>
		<<else>>
			<<set $_clothesAction to setup.npcClothesSets.find(item => item.name === $_npc.clothes.set).clothes[$_part].action>>
			<<switch $_clothesAction>>
				<<case "lift">><<set _actionText to "【을를】 치켜올린다">>
				<<case "pull">><<set _actionText to "【을를】 끌어내린다">>
				<<case "unbutton">><<set _actionText to "의 단추를 푼다">>
				<<case "unzip">><<set _actionText to "의 지퍼를 내린다">>
				<<case "aside">><<set _actionText to "【을를】 옆으로 젖힌다">>
				<<case "open">><<set _actionText to "【을를】 벌린다">>
				<<case "undo">><<set _actionText to "【을를】 푼다">>
				<<case "unwrap">><<set _actionText to "【을를】 벗겨낸다">>
				<<default>><<set _actionText to '<span class="red">오류: 잘못된 NPC 의류 동작입니다. (NPC: $_npc.fullDescription, 호출된 부위: $_part, 동작: $_clothesAction) PurityGuy에게 알려주세요</span>'>>
			<</switch>>
			<<set _text_output += $_his + " " + $_npc.clothes[$_part].name + _actionText>>
		<</if>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "npcRevealText">><<silently>>
	<<set $_npc to _args[0]>>
	<<set $_part to _args[1]>> /* can be "upper" or "lower" */
	<<set $_mod to _args[2]>>

	<<set _prefix to "">>
	<<if $_mod is "name">>
		<<if $NPCNameList.includes($_npc.fullDescription)>>
			<<set _prefix to window.KR.gatPersonNameDictKR($_npc.fullDescription) + "의 ">>
		<<elseif $_npc.name_known is 1>>
			<<set _prefix to window.KR.gatPersonNameDictKR($_npc.name) + "의 ">>
		<<else>>
			<<set _prefix to "그 " + window.KR.getDescriptionKr($_npc.fullDescription) + "의 ">>
		<</if>>
	<<elseif $_mod is "desc">>
		<<if $NPCNameList.includes($_npc.fullDescription)>>
			<<set _prefix to "그 " + window.KR.getDescriptionKr($_npc.description) + "의 ">>
		<<else>>
			<<set _prefix to "그 " + window.KR.getDescriptionKr($_npc.fullDescription) + "의 ">>
		<</if>>
	<<else>>
		<<set _prefix to "<<his>> ">>
	<</if>>

	<<set _text_output to _prefix>>

	<<if ["both","lower"].includes($_part)>>
		<<set _lower_part to "">>
		<<if $_npc.penis isnot "none" and $_npc.vagina isnot "none">>
			<<if $_npc.chastity.penis.includes("chastity")>>
				<<set _lower_part += "$_npc.chastity.penis 안에 있는 " + window.KR.getPenisDescKr($_npc.penisdesc) + " 그리고 <<his>> ">>
			<<else>>
				<<set _lower_part += window.KR.getPenisDescKr($_npc.penisdesc) + " 그리고 <<his>> ">>
			<</if>>
			<<set _lower_part += ($enemyarousal gte 40 ? "젖은 보지" : "보지")>>
		<<elseif $_npc.penis isnot "none">>
			<<if $_npc.penisdesc.includes("strap-on")>>
				<<set _lower_part += window.KR.getPenisDescKr($_npc.penisdesc)>>
				<!-- placeholder -->
			<<else>>
				<<if $_npc.chastity.penis.includes("chastity")>>
					<<set _lower_part += "$_npc.chastity.penis 안에 있는 " + window.KR.getPenisDescKr($_npc.penisdesc)>>
				<<else>>
					<<set _lower_part += "완전히 발기한 " + window.KR.getPenisDescKr($_npc.penisdesc)>>
				<</if>>
			<</if>>
		<<elseif $_npc.vagina isnot "none">>
			<<if $_npc.chastity.vagina.includes("chastity")>>
				<<set _lower_part += "$_npc.chastity.vagina 뒤에 있는 ">>
			<</if>>
			<<set _lower_part += ($enemyarousal gte 40 ? "젖은 보지" : "보지")>>
		<</if>>
	<</if>>

	<<if $_part is "both">>
		<<set $_chest to ($_npc.pronoun is "m" || $_npc.breastsize is 0 ? "가슴" : window.KR.getBreastSizeKr($_npc.breastsdesc))>>
		<<set _text_output += $_chest + " 그리고 " + _lower_part + "【이가】 드러난다">>
	<<elseif $_part is "lower">>
		<<set _text_output += _lower_part + "【이가】 드러난다">>
	<<else>>
		<<set $_chest to ($_npc.pronoun is "m" || $_npc.breastsize is 0 ? "가슴" : window.KR.getBreastSizeKr($_npc.breastsdesc))>>
		<<set _text_output += $_chest + "【이가】 드러난다">>
	<</if>>
	<!-- intentionally omitting a period, for flexibility; do not forget to add one after you use this widget -->
<</silently>>_text_output<</widget>>

<<widget "npcGenitalReaction">>
	<<set $_npc to _args[0]>>
	<<if !$worn.face.type.includes("blindfold")>>
		<<if $_npc.penis isnot "none">>
			<<switch $_npc.penissize>>
				<<case 4>>
					<span class="red"> <<print setup.npcPenisRemarks["big"].random()>></span>
				<<case 1>>
					<span class="green"> <<print setup.npcPenisRemarks["small"].random()>></span>
				<<default>>
			<</switch>>
		<</if>>
		<<if $_npc.vagina isnot "none">>
			<!-- Placeholder -->
