	<<elseif $sydney_toy isnot _args[0]>>
		| <span class="purple">시드니는 원래 있던 <<print window.KR.getToolKr($sydney_toy)>> 대신 <<print window.KR.getToolKr(_args[0])>>【을를】 나중에 쓰려고 간직할 것입니다</span>
	<</if>>
<</widget>>

