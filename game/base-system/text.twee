<<widget "lewdness">>
	<<silently>>
		<<exposure>>

		<<if $exposedRaw gt 0>>
			<<genitals>><<set _genitals_text to _text_output>>
			<<breasts>><<set _breasts_text to _text_output>>

			<<set _text_output to "">>
			<<set _exposed to false>>
			<<set _wet to false>>

			<<if ($worn.upper.exposed gte 1 or $upperwetstage gte 3) and (!$worn.under_upper.type.includes("torso_covering") or ($worn.under_upper.exposed gte 1 or $underupperwetstage gte 3)) and (!$worn.lower.type.includes("overalls") or ($worn.lower.exposed gte 1 or $lowerwetstage gte 3))>>
				<<if $upperwetstage gte 3 or $underupperwetstage gte 3>>
					<<set _text_output += "보이는 ">>
					<<set _wet to true>>
				<<else>>
					<<set _text_output += "노출된 ">>
					<<set _exposed to true>>
				<</if>>

				<<if $player.gender_appearance is "m" and $player.sex is "m" and $worn.lower.exposed lte 0 and $lowerwetstage lt 3>>
					<<set _text_output += "가슴">>
				<<elseif $worn.under_upper.exposed gte 1 or $underupperwetstage gte 3>>
					<<set _text_output += _breasts_text>>
				<<else>>
					<<set _text_output += $worn.under_upper.name>>
				<</if>>
			<</if>>

			<<if ($worn.lower.exposed gte 1 or $lowerwetstage gte 3) and (!$worn.under_lower.type.includes("lower_covering") or ($worn.under_lower.exposed gte 1 or $underlowerwetstage gte 3))>>
				<<if _text_output isnot "">>
					<<set _text_output += " 그리고 ">>
				<</if>>

				<<if _wet is false and ($lowerwetstage gte 3 or $underlowerwetstage gte 3)>>
					<<if _text_output isnot "">>
						<<set _text_output += "당신의 ">>
					<</if>>

					<<set _text_output += "보이는 ">>
				<<elseif !_exposed and $lowerwetstage lt 3 and $underlowerwetstage lt 3>>
					<<if _text_output isnot "">>
						<<set _text_output += "당신의 ">>
					<</if>>

					<<set _text_output += "노출된 ">>
				<</if>>

				<<if $worn.under_lower.exposed gte 1 or $underlowerwetstage gte 3>>
					<<set _text_output += _genitals_text>>
				<<else>>
					<<set _text_output += $worn.under_lower.name>>
				<</if>>
			<</if>>
		<<else>>
			<<set _text_output to "은밀한 곳">>
		<</if>>
	<</silently>>

	<span class="lewd">_text_output</span>
<</widget>>

<<widget "flaunting">>
	<<exposure>>/*Makes sure your clothing state is up to date*/
	<<if $uncomfortable.nude is false>>
		<<if $trauma gte (($traumamax / 5) * 4)>>
			<<if $stress gte (($stressmax / 5) * 4)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					어두운 촉수들이 노출된 당신의 몸을 헤집어 놓을 듯 위협하는 가운데,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					어두운 촉수들이 노출된 당신의 몸을 애무하는 가운데
				<<else>>
					수많은 눈동자가 지켜보고 있다는 느낌에,
				<</if>>
			<<elseif $stress gte (($stressmax / 5) * 1)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					이 자리에서 절정에 달할까 봐 두려워하며,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					수많은 눈동자가 지켜보고 있다는 느낌에,
				<<else>>
					위협을 느끼면서도 흥분한 채,
				<</if>>
			<<else>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					당신 안의 병든 일부가 관객들이 당신의 몸을 마음껏 유린하기를 바라는 가운데
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					포위되어 무방비해진 느낌에,
				<<else>>
					사람들이 보는 것을 마음에 들어 하기를 바라며,
				<</if>>
			<</if>>
		<<elseif $trauma gte (($traumamax / 5) * 1)>>
			<<if $stress gte (($stressmax / 5) * 4)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					한낱 고깃덩이가 된 것 같은 기분으로,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					벌거벗겨지고 무방비해진 채,
				<<else>>
					자신을 노출하는 것이 고통에서 구해 주기를 바라는 가운데
				<</if>>
			<<elseif $stress gte (($stressmax / 5) * 1)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					당신의 몸이 떨리는 가운데
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					흥분되면서도 두려운 마음으로,
				<<else>>
					관심을 갈망하며,
				<</if>>
			<<else>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					흥분으로 몸을 떨며,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					심장이 두근거리는 채로,
				<<else>>
					사람들이 이 광경을 마음에 들어 하기를 바라는 가운데
				<</if>>
			<</if>>
		<<else>>
			<<if $stress gte (($stressmax / 5) * 4)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					긴장하고 흥분한 채로,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					긴장되면서도 짜릿한 기분으로,
				<<else>>
					이 순간을 즐기며,
				<</if>>
			<<elseif $stress gte (($stressmax / 5) * 1)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					야릇한 기분에 빠져,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					자신에게 쏠린 시선을 즐기는 가운데
				<<else>>
					아드레날린이 솟구치는 것을 즐기는 가운데
				<</if>>
			<<else>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					이토록 훤히 노출되었다는 사실에 전율하며,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					기쁨에 몸을 떨며,
				<<else>>
					자랑스럽고 자유롭게,
				<</if>>
			<</if>>
		<</if>>
	<<else>>
		<<if $trauma gte (($traumamax / 5) * 4)>>
			<<if $stress gte (($stressmax / 5) * 4)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					어두운 촉수들이 노출된 당신의 몸을 헤집어 놓을 듯 위협하는 가운데,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					어두운 촉수들이 노출된 당신의 몸을 애무하는 가운데
				<<else>>
					수많은 눈동자가 지켜보고 있다는 느낌에,
				<</if>>
			<<elseif $stress gte (($stressmax / 5) * 1)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					이 자리에서 절정에 달할까 봐 두려워하며,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					수많은 눈동자가 지켜보고 있다는 느낌에,
				<<else>>
					위협을 느끼며 당혹스러운 채로,
				<</if>>
			<<else>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					당신 안의 병든 일부가 관객들이 당신의 몸을 마음껏 유린하기를 바라는 가운데
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					포위되어 무방비해진 느낌에,
				<<else>>
					사람들이 보는 것을 마음에 들어 하기를 바라며,
				<</if>>
			<</if>>
		<<elseif $trauma gte (($traumamax / 5) * 1)>>
			<<if $stress gte (($stressmax / 5) * 4)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					한낱 고깃덩이가 된 것 같은 기분으로,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					벌거벗겨지고 무방비해진 채,
				<<else>>
					자신을 노출하는 것이 고통에서 구해 주기를 바라는 가운데
				<</if>>
			<<elseif $stress gte (($stressmax / 5) * 1)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					당신의 몸이 떨리는 가운데
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					부끄럽고 두려운 채로,
				<<else>>
					관심을 갈망하며,
				<</if>>
			<<else>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					흥분으로 몸을 떨며,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					심장이 두근거리는 채로,
				<<else>>
					사람들이 이 광경을 마음에 들어 하기를 바라는 가운데
				<</if>>
			<</if>>
		<<else>>
			<<if $stress gte (($stressmax / 5) * 4)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					긴장하고 흥분한 채로,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					긴장되면서도 짜릿한 기분으로,
				<<else>>
					이 순간을 즐기며,
				<</if>>
			<<elseif $stress gte (($stressmax / 5) * 1)>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					야릇한 기분에 빠져,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					자신에게 쏠린 시선을 즐기는 가운데
				<<else>>
					아드레날린이 솟구치는 것을 즐기는 가운데
				<</if>>
			<<else>>
				<<if $arousal gte (($arousalmax / 5) * 4)>>
					이토록 훤히 노출되었다는 사실에 전율하며,
				<<elseif $arousal gte (($arousalmax / 5) * 1)>>
					기쁨에 몸을 떨며,
				<<else>>
					얼굴을 붉히며,
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "embarrassment">>
	<<if $arousal gte (($arousalmax / 10) * 9)>>
		부끄러움이 당신의 마음을 지배하며, 당장이라도 이성을 날려버릴 듯하다.
	<<elseif $arousal gte (($arousalmax / 10) * 8)>>
		부끄러움에도 불구하고 야릇한 전율이 온몸을 타고 흐른다.
	<<elseif $arousal gte (($arousalmax / 10) * 7)>>
		부끄러움에 머리가 아찔해진다.
	<<elseif $arousal gte (($arousalmax / 10) * 6)>>
		너무나 부끄러워, 당신의 숨이 턱 막힌다.
	<<elseif $arousal gte (($arousalmax / 10) * 5)>>
		너무나 부끄러워, 당신의 심장 박동이 빨라진다.
	<<elseif $arousal gte (($arousalmax / 10) * 4)>>
		부끄러움에도 불구하고 아랫배에 열기가 차오른다.
	<<elseif $arousal gte (($arousalmax / 10) * 3)>>
		너무나 부끄러워, 심장이 덜컥 내려앉는 듯하다.
	<<elseif $arousal gte (($arousalmax / 10) * 2)>>
		부끄러움에 몸이 떨린다.
	<<elseif $arousal gte (($arousalmax / 10) * 1)>>
		너무나 부끄러워, 얼굴로 피가 쏠린다.
	<<else>>
		부끄러움에 얼굴이 달아오른다.
	<</if>>
<</widget>>

<<widget "covered">>
	<<exposure>>

	<<if $exposed gt 0>>
		<<if pcAreArmsBound("both") and $exposed gte 1>>
			팔이 묶인 채로는, 사람들의 노골적인 시선으로부터 <<lewdness>>【을를】 가리기 위해 할 수 있는 일이 거의 없다.
			<<if !$uncomfortable.nude and $exposed gte 2 and hasSexStat("exhibitionism", 6)>>
				흥분으로 몸이 파르르 떨린다.
			<<elseif !$uncomfortable.nude and $exposed is 1 and hasSexStat("exhibitionism", 4)>>
				흥분으로 몸이 파르르 떨린다.
			<</if>>
		<<elseif ($exposed gte 2 and (!hasSexStat("exhibitionism", 6) or $uncomfortable.nude))
			or ($exposed is 1 and (!hasSexStat("exhibitionism", 4) or $uncomfortable.underwear))>>
			양손으로 <<lewdness>>【을를】 가린다.
		<<else>>
			<<lewdness>>에서 비롯된 흥분으로 몸이 파르르 떨린다.
		<</if>>
		<<embarrassment>>
	<</if>>
<</widget>>

<<widget "passagestrip">>
	<<if $worn.upper.exposed gte 2 and $worn.lower.exposed gte 2 and $worn.under_upper.exposed gte 1 and $worn.under_lower.exposed gte 1>>
	<<else>>
		<<outfitChecks>>
		<<set _clothing_strip_sequence to 0>>
		<<if !_overNaked>>
			<<flaunting>> <<= $worn.over_lower.name isnot "naked" and !_overOutfit ? _top.name + "【와과】 " + _bottom.name : _top.name>>【을를】 벗어, <<if _topUnder>><<= _topUnder.name>><<else>><<breasts>><</if>>【을를】 노출시킨다.
			<<overupperstrip>><<overlowerstrip>>
			<<set _clothing_strip_sequence += 1>><<upperstrip>><<exposure>>
		<</if>>
		<<if $worn.upper.exposed lte 1>>
			<<= _clothing_strip_sequence is 0 ? "<<flaunting>>" : "다음으로,">>
			<<if _middleOutfit is true>>
				$worn.upper.name【을를】 스르르 벗어, <<undertop>>【와과】 <<undies>>【을를】 노출시킨다.
			<<else>>
				$worn.upper.name【을를】 벗어 던져, <<undertop>>【을를】 노출시킨다.
			<</if>>
			<<set _clothing_strip_sequence += 1>><<upperstrip>><<exposure>>
		<</if>>
		<<if $worn.lower.exposed lte 1 and _args[0] isnot "topless">>
			<<if _clothing_strip_sequence is 0>>
				<<flaunting>> $worn.lower.name【을를】 벗어 던져, <<undies>>【을를】 노출시킨다.
			<<else>>
				다음으로는 $worn.lower.name【을를】 벗어, <<undies>>【을를】 노출시킨다.
			<</if>>
			<<set _clothing_strip_sequence += 1>><<lowerstrip>><<exposure>>
		<</if>>
		<<if $worn.under_upper.exposed lte 0 and _args[0] isnot "undies">>
			<<if _underOutfit is true>>
				<<if _clothing_strip_sequence is 0>>
					<<flaunting>> $worn.under_upper.name【을를】 스르르 벗어, <<breasts>>【와과】 <<genitals>>【을를】 드러낸다.
				<<elseif _clothing_strip_sequence is 1>>
					다음으로는 $worn.under_upper.name【을를】 벗어, <<breasts>>【와과】 <<genitals>>【을를】 드러낸다.
				<<else>>
					마침내 $worn.under_upper.name【을를】 훌렁 벗어, <<breasts>>【와과】 <<genitals>>【을를】 드러낸다.
				<</if>>
			<<else>>
				<<if _clothing_strip_sequence is 0>>
					<<flaunting>> $worn.under_upper.name【을를】 벗어 던져, <<breasts>>【을를】 드러낸다.
				<<elseif _clothing_strip_sequence is 1>>
					다음으로는 $worn.under_upper.name【을를】 벗어, <<breasts>>【을를】 드러낸다.
				<<else>>
					<<if $worn.under_lower.exposed lte 0>>
						이어서 $worn.under_upper.name【을를】 벗어, <<breasts>>【을를】 드러낸다.
					<<else>>
						마침내 $worn.under_upper.name【을를】 훌렁 벗어, <<breasts>>【을를】 드러낸다.
					<</if>>
				<</if>>
			<</if>>
			<<set _clothing_strip_sequence += 1>><<underupperstrip>><<exposure>>
		<</if>>
		<<if $worn.under_lower.exposed lte 0 and _args[0] isnot "undies" and _args[0] isnot "topless">>
			<<if _clothing_strip_sequence is 0>>
				<<flaunting>> $worn.under_lower.name【을를】 끌어내려, <<genitals>>【을를】 보여준다.
			<<elseif _clothing_strip_sequence is 1>>
				다음으로는 $worn.under_lower.name【을를】 벗어, <<genitals>>【을를】 보여준다.
			<<else>>
				마침내 $worn.under_lower.name【을를】 훌렁 벗어, <<genitals>>【을를】 보여준다.
			<</if>>
			<<set _clothing_strip_sequence += 1>><<underlowerstrip>><<exposure>>
		<</if>>
	<</if>>
	<<if !$worn.legs.type.includes("naked") and _args[0] isnot "topless">>
		당신은 여전히 $worn.legs.name【을를】 입고 있지만, 어쩐지 이것 때문에 더 노출된 것 같은 기분이 든다.
	<<else>>
	<</if>>
<</widget>>

