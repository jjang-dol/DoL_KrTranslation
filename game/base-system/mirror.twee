:: Widgets Mirror [widget]
<<widget "mirror">>
	<div id="mirror">
		<<if _args[0] isnot undefined>>
			<<mirrorDisplay _args[0]>>
		<<else>>
			<<mirrorDisplay>>
		<</if>>
	</div>
<</widget>>

<<widget "preMirror">>
	<<if (Browser.isMobile).any()>>
		<<set $showMannequins to 0>>
	<<else>>
		<<set $showMannequins to 1>>
	<</if>>
<</widget>>

<<widget "postMirror">>
	<<shopClothingFilterReset>> /* Due to the reusing of shop code */
<</widget>>

<<widget "mirrorDisplay">>
	<<switch $mirrorMenu>>
		<<case "appearance">>
			<<if playerBellyVisible(true) and !playerAwareTheyArePregnant()>>
				<<mirrorAppearancePregnancy>>
			<<else>>
				<<mirrorAppearance>>
			<</if>>
		<<case "body">>
			<<visual-settings>>
		<<case "skin">>
			<<mirrorSkin>>
		<<case "hair">>
			<<mirrorHair>>
		<<case "makeup">>
			<<mirrorMakeup>>
		<<case "transformation">>
			<<mirrorTransformation>>
		<<default>>
			<<mirrorMenu _args[0]>>
	<</switch>>
	<<calchairlengthstage>>
	<br><br>
<</widget>>

<<widget "mirrorwet">><<silently>>
    <<set _text_output to "">>
    <<if _args[1] or _args[2] or _args[3]>>
        <<set $_part to _args[0]>>
        <<set $_semen to _args[1]>>
        <<set $_slime to _args[2]>>
        <<set $_nectar to _args[3]>>
        <<set _text_output to "<br>" + window.KR.getBodypartKr($_part) + "【은는】 ">>
        <<if $_semen gt 0>>
            <<switch Math.clamp($_semen, 1, 5)>>
                <<case 1>> <<set _text_output to _text_output + '<span class="blue">정액으로 촉촉하게</span> 젖어 있다'>>
                <<case 2>> <<set _text_output to _text_output + '<span class="purple">정액으로 젖어</span> 있다'>>
                <<case 3>> <<set _text_output to _text_output + '<span class="purple">정액으로 미끌거린다</span>'>>
                <<case 4>> <<set _text_output to _text_output + '<span class="pink">정액에 흠뻑</span> 젖어 있다'>>
                <<case 5>> <<set _text_output to _text_output + '<span class="red">정액으로 흠뻑</span> 젖어 있다'>>
            <</switch>>
            <<if $_slime gt 0 and $_nectar gt 0>>
                <<set _text_output to _text_output + ", ">>
            <<elseif $_slime gt 0 or $_nectar gt 0>>
                <<set _text_output to _text_output + " 그리고 ">>
            <<else>>
                <<set _text_output to _text_output + ".">>
            <</if>>
        <</if>>
        <<if $_slime gt 0>>
            <<switch Math.clamp($_slime, 1, 5)>>
                <<case 1>> <<set _text_output to _text_output + '<span class="blue">슬라임으로 촉촉하게</span> 젖어 있다'>>
                <<case 2>> <<set _text_output to _text_output + '<span class="purple">슬라임으로 젖어</span> 있다'>>
                <<case 3>> <<set _text_output to _text_output + '<span class="purple">슬라임으로 미끌거린다</span>'>>
                <<case 4>> <<set _text_output to _text_output + '<span class="pink">슬라임에 흠뻑</span> 젖어 있다'>>
                <<case 5>> <<set _text_output to _text_output + '<span class="red">슬라임으로 흠뻑</span> 젖어 있다'>>
            <</switch>>
            <<if $_nectar gt 0>>
                <<set _text_output to _text_output + " 그리고 ">>
            <<else>>
                <<set _text_output to _text_output + ".">>
            <</if>>
        <</if>>
        <<if $_nectar gt 0>>
            <<switch Math.clamp($_nectar, 1, 5)>>
                <<case 1>> <<set _text_output to _text_output + '<span class="blue">넥타로 촉촉하게</span> 젖어 있다'>>
                <<case 2>> <<set _text_output to _text_output + '<span class="purple">넥타로 젖어</span> 있다'>>
                <<case 3>> <<set _text_output to _text_output + '<span class="purple">넥타로 미끌거린다</span>'>>
                <<case 4>> <<set _text_output to _text_output + '<span class="pink">넥타에 흠뻑</span> 젖어 있다'>>
                <<case 5>> <<set _text_output to _text_output + '<span class="red">넥타로 흠뻑</span> 젖어 있다'>>
            <</switch>>
            <<set _text_output to _text_output + ".">>
        <</if>>
    <</if>>
<</silently>>_text_output<</widget>>

<<widget "mirrorMenu">>
	<<set $_mirror to _args[0] || '거울'>>
	당신은 $_mirror【을를】 들여다본다.
	<<if $fallenangel is 2>>
		한심한 모습이
	<<elseif $hallucinogen gte 200>>
		$_mirror【이가】 짙은 검은색 웅덩이로 녹아내려, 당신 앞에 떠오른다.
		<<if $_mirror is '거울'>>
			유리 조각들이 당신의 피부를 스치고 지나가며 공기 중으로 흩어진다.
		<</if>>
		<br>
		당신이 공허를 응시하자, 공허도 당신을
	<<elseif $hallucinogen gte 100>>
		표면이 당신이 이해할 수 없는 각도로 접혀 들어가고, 알아볼 수 없는 무언가가
	<<elseif $hallucinogen gt 0>>
		당신의 존재에 표면이 일렁이고, 어렴풋이 낯익은 <<girl>>【이가】 
	<<elseif $trauma gte $traumamax>>
		초점 없는 눈을 한 <<girl>>【이가】 
	<<else>>
		<<= $pain gte 100 ? "울고 있는" : $pain gte 40 ? "눈물이 고인" : $pain gte 1 ? "찡그리고 있는" : "밝은 표정의">> <<girl>>【이가】 
	<</if>>
	마주 본다.
	<<set _wraithMirror to !_wraithMirror && ["haunt", "despair"].includes($wraith.state) and $hallucinations gte 1 and ((random(1, 100) is 1) or ($controlled is 0 and random(1, 100) lte 5))>>
	<<if _wraithMirror>>
		<span class="fading">뒤에 창백한 형체가 서 있다.</span>
	<</if>>
	<<if $asylum_mirror gte 5 and !$daily.mirror_madness and $awareness lt 200>>
		<<set $daily.mirror_madness to 1>>
		그림자 속에서 반쯤 숨은 미소들이 다정하게 당신을 지켜본다.<<lawareness>><<ltrauma>><<awareness -6>><<trauma -6>>
	<</if>>
	<br><br>
	<<crimeicon "mark">><<link "다른 사람들이 당신을 어떻게 보는지 살펴본다">><<set $mirrorMenu to "appearance">><<replace #mirror>><<mirrorDisplay>><</replace>><<numberify "#passages > .passage">><</link>>
	<br><br>
	<<if !$simpleMirror>>
		__외모__
		<br>
		<<investigateicon>><<link "몸을 살펴본다">><<set $mirrorMenu to "skin">><<replace #mirror>><<mirrorDisplay>><</replace>><<numberify "#passages > .passage">><</link>>
		<br><br>
	<</if>>
	__머리__
	<br>
	<<hairdressericon "hairspray">><<link "머리 모양을 바꾼다">><<set $mirrorMenu to "hair">><<replace #mirror>><<mirrorDisplay>><</replace>><<numberify "#passages > .passage">><</link>>
	<br><br>
	__메이크업__
	<br>
	<<cosmeticsicon>><<link "화장을 한다">><<set $mirrorMenu to "makeup">><<replace #mirror>><<mirrorDisplay>><</replace>><<numberify "#passages > .passage">><</link>>
	<br><br>

	<<if $worn.neck.name is "love locket">>
		__로켓__
		<br>
		<span @class="'clothes-'+$worn.neck.colour.replace(' ','-')"><<icon "locket.png">></span><<link [[로켓 커스터마이즈|Mirror Locket]]>><<set $passage_mirror to $passage>><</link>>
		<br><br>
	<</if>>

	<<if !$simpleMirror>>
		/* only display the tf menu if there's actually some options that can be changed */
		<<set $_tfs to setup.transformations.filter(tf => tf.parts?.some(part => tf.level >= part.tfRequired))>>
		<<if $_tfs.length >= 1>>
			__변신__
			<br>
			/* show the icon of the highest levelled transform with parts unlocked */
			/* assumes maximum of 2 simultaneous transformations */
			<<set $_icon to ($_tfs[1]?.level gt $_tfs[0].level) ? $_tfs[1].name : $_tfs[0].name>>
			<<if !$_icon>><<set $_icon to "angel">><</if>>
			<<tficon $_icon>>
			<<link "내면을 살펴본다">><<set $mirrorMenu to "transformation">><<replace #mirror>><<mirrorDisplay>><</replace>><<numberify "#passages > .passage">><</link>>
		<<else>>
			더 자세히 살펴보려면 이세계의 힘을 얻어야 한다.
		<</if>>
	<</if>>
	<br><br>
<</widget>>

<<widget "mirrorGender">>
	<div class="settingsGrid">
		<div class="settingsHeader">성별 외모</div>
		<<settextcolorfromfemininity $player.femininity>>
		<div class="settingsToggleItem">
			당신은 <span @class="_text_color"><<if playerBellyVisible(true)>>임신한 <</if>><<girl>>처럼 보인다.</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold bold">성별:</span>
			<br>
			<label class="blue">남성 <<radiobutton "$player.gender" "m" autocheck>></label> |
			<label class="pink">여성 <<radiobutton "$player.gender" "f" autocheck>></label> |
			<label class="purple">어느 쪽도 아님 <<radiobutton "$player.gender" "n" autocheck>></label>
			<br>
			<span class="small-description">스스로를 어떻게 바라보는지 설정합니다. 당신의 성기를 바꾸거나 다른 사람들이 당신을 어떻게 인식하는지에 영향을 주지 않습니다.</span>
		</div>
		<div class="settingsToggleItem">
			<span class="gold bold">기여 요소:</span>
			<br>
			<<for _x range $player.gender_appearance_factors>>
				<<if _x.femininity is 0 or !_x.factor>>
					<<continue>>
				<</if>>
				<<settextcolorfromfemininity _x.femininity>>
				<span @class="_text_color">
					_x.factor
					<<if $debug is 1>>
						_x.femininity
					<<else>>
						<<print "+".repeat(
							Math.trunc(Math.clamp(
								Math.abs(_x.femininity) / 100, 0, 10
							))
						)>>
					<</if>>
				</span>
				<br>
			<</for>>
			<<if $debug is 1>>
				<<settextcolorfromfemininity $player.femininity>>
				전체 여성성: <span @class="_text_color">$player.femininity</span>
				<br>
			<</if>>
		</div>
		<div class="settingsToggleItem">
			<span class="gold bold">행동:</span>
			<br>
			<<if $player.gender_posture is "n">>
				당신은 몸을 돌려 스스로를 살펴본다. 마치 <<girl>> 같다. 만약 몸가짐을 다르게 한다면, 사람들의 시선도 바꿀 수 있을지 모른다.
			<<elseif $player.gender_posture is "f">>
				소녀 같은 포즈를 몇 번 취해보고, 최대한 여성스러운 목소리를 내어 본다.
				<br>
				<span class="pink">다른 사람들이 당신을 여자라고 생각할 가능성이 높아집니다.</span>
			<<elseif $player.gender_posture is "m">>
				근육에 힘을 주고 목소리를 조금 굵게 깔아본다.
				<br>
				<span class="lblue">다른 사람들이 당신을 남자라고 생각할 가능성이 높아집니다.</span>
			<</if>>
			<br><br>
			<<set _postures to ["masculine", "feminine", "natural"]>>
			<<set _posturesKr to ["남성적", "여성적", "자연스럽게"]>>
			자세:
			<<capture _i>>
				<<for _i = 0; _i < _postures.length; _i++>>
					<span @class="$player.gender_posture is _postures[_i].charAt(0) ? 'goldLink no-numberify' : 'unselected no-numberify'">
						<<link _posturesKr[_i]>>
							<<set $player.gender_posture to _postures[_i].charAt(0)>>
							<<exposure>>
							<<replace "#mirrorGender">><<mirrorGender>><</replace>>
						<</link>>
					</span> <<= _i lt _postures.length - 1 ? "|" : "">>
				<</for>>
			<</capture>>
		</div>
	</div>
<</widget>>

<<widget "mirrorAppearance">>
	<<mirroricon>><<link "뒤로">><<replace #mirror>><<mirrorMenu>><</replace>><<numberify "#passages > .passage">><<unset $mirrorMenu>><</link>>
	<br><br>
	<span id="mirrorGender">
		<<mirrorGender>>
	</span>
	<hr>

	<div class="settingsGrid">
		<<set _increaseAllure to []>>
		<<set _increaseAttractive to []>>
		<<set _increaseBoth to (name) => {
			_increaseAllure.push(name);
			_increaseAttractive.push(name);
		}>>
		<<if $beauty gte ($beautymax / 7) * 6>>
			<<run _increaseBoth("미모: 신성함 +++++")>>
		<<elseif $beauty gte ($beautymax / 7) * 5>>
			<<run _increaseBoth("미모: 매혹적 ++++")>>
		<<elseif $beauty gte ($beautymax / 7) * 4>>
			<<run _increaseBoth("미모: 아름다움 +++")>>
		<<elseif $beauty gte ($beautymax / 7) * 3>>
			<<run _increaseBoth("미모: 매력적 ++")>>
		<<elseif $beauty gte ($beautymax / 7) * 2>>
			<<run _increaseBoth("미모: 예쁨 +")>>
		<<elseif $beauty gte ($beautymax / 7)>>
			<<run _increaseBoth("미모: 귀여움")>>
		<</if>>
		<<run _increaseBoth(`머리 길이 ${$hairlength gte 333 ? "+".repeat($hairlength gte 666 ? 2 : 1) : ""}`)>>
		<<if $worn.upper.type.includes("naked")>>
			<<if $worn.lower.type.includes("overalls")>>
				<<run _increaseBoth("상의 탈의 (가려짐)")>>
			<<else>>
				<<run _increaseBoth("상의 탈의")>>
			<</if>>
		<<elseif $worn.upper.reveal gte 500>>
			<<run _increaseBoth("노출도 높은 상의")>>
		<</if>>
		<<if $worn.lower.type.includes("naked")>>
			<<run _increaseBoth("하의 없음")>>
		<<elseif $worn.lower.reveal gte 500>>
			<<run _increaseBoth("노출도 높은 하의")>>
		<</if>>
		<<if $worn.under_lower.type.includes("naked")>>
			<<run _increaseBoth("팬티 없음")>>
		<<elseif $worn.under_lower.reveal gte 500>>
			<<run _increaseBoth("섹시한 속옷")>>
		<</if>>
		<<if $wolfgirl gte 6>>
			<<run _increaseBoth(`늑대형 ${"+".repeat(2 - ["ears", "tail"].filter(p => $transformationParts.wolf[p] is "hidden").length)}`)>>
		<</if>>
		<<if $cat gte 6>>
			<<run _increaseBoth(`고양이형 ${"+".repeat(2 - ["ears", "tail"].filter(p => $transformationParts.cat[p] is "hidden").length)}`)>>
		<</if>>
		<<if $cow gte 6>>
			<<run _increaseBoth(`소형 ${"+".repeat(2 - Math.ceil(["ears", "tail", "horns"].filter(p => $transformationParts.cow[p] is "hidden").length / 2))}`)>>
		<</if>>
		<<if $harpy gte 6>>
			<<run _increaseBoth(`하피형 ${"+".repeat(2 - Math.ceil(["tail", "eyes", "malar", "plumage", "wings"].filter(p => $transformationParts.bird[p] is "hidden").length / 3))}`)>>
		<</if>>
		<<if $fox gte 6>>
			<<run _increaseAttractive.push(`여우형 ${"+".repeat(3 - ["ears", "tail"].filter(p => $transformationParts.fox[p] is "hidden").length)}`)>>
			<<run _increaseAllure.push(`여우같은 매력 ${"+".repeat(3 - ["ears", "tail"].filter(p => $transformationParts.fox[p] is "hidden").length)}`)>>
		<</if>>
		<<if $angel gte 6>>
			<<run _increaseBoth(`천사 ${"+".repeat(2 - ["halo", "wings"].filter(p => $transformationParts.angel[p] is "hidden").length)}`)>>
		<</if>>
		<<if $fallenangel gte 2>>
			<<run _increaseBoth(`타락 천사 ${"+".repeat(2 - ["halo", "wings"].filter(p => $transformationParts.fallenAngel[p] is "hidden").length)}`)>>
		<</if>>
		<<if $demon gte 6>>
			<<run _increaseBoth(`악마 ${"+".repeat(2 - Math.ceil(["horns", "tail", "wings"].filter(p => $transformationParts.demon[p] is "hidden").length / 2))}`)>>
		<</if>>
		<<if $earSlime.growth gt 50>>
			<<run _increaseAllure.push(`귀 슬라임 페로몬${$earSlime.growth gt 75 ? " " + "+".repeat(Math.ceil(($earSlime.growth - 75) / 25)): ""}`)>>
		<</if>>
		<<if $makeup.lipstick != 0 or $makeup.eyeshadow != 0 or $makeup.mascara != 0 or $makeup.blusher != 0>>
			<<run _increaseAllure.push("선정적인 화장")>>
			<<run _increaseAttractive.push("매력적인 화장")>>
		<</if>>
		<<if $worn.upper.reveal + $worn.lower.reveal gte 50>>
			<<set $_outfit to "의상">>
			<<run _increaseAllure.push(`선정적인 ${$_outfit} ${"+".repeat(Math.floor(($worn.upper.reveal + $worn.lower.reveal) / 400))}`)>>
			<<run _increaseAttractive.push(`매력적인 ${$_outfit} ${"+".repeat(Math.floor(($worn.upper.reveal + $worn.lower.reveal) / 400))}`)>>
		<</if>>
		<<if $worn.head.reveal gte 50>>
			<<run _increaseAllure.push(`선정적인 머리 장식 ${"+".repeat(Math.floor($worn.head.reveal / 200))}`)>>
			<<run _increaseAttractive.push(`매력적인 머리 장식 ${"+".repeat(Math.floor($worn.head.reveal / 200))}`)>>
		<</if>>
		<<if $worn.face.reveal gte 50>>
			<<run _increaseAllure.push(`선정적인 얼굴 장식 ${"+".repeat(Math.floor($worn.face.reveal / 200))}`)>>
			<<run _increaseAttractive.push(`매력적인 얼굴 장식 ${"+".repeat(Math.floor($worn.face.reveal / 200))}`)>>
		<</if>>
		<<if $worn.neck.reveal gte 50>>
			<<run _increaseAllure.push(`선정적인 목 장식 ${"+".repeat(Math.floor($worn.neck.reveal / 200))}`)>>
			<<run _increaseAttractive.push(`매력적인 목 장식 ${"+".repeat(Math.floor($worn.neck.reveal / 200))}`)>>
		<</if>>
		<<if $worn.legs.reveal gte 50>>
			<<run _increaseAllure.push(`선정적인 양말류 ${"+".repeat(Math.floor($worn.legs.reveal / 200))}`)>>
			<<run _increaseAttractive.push(`매력적인 양말류 ${"+".repeat(Math.floor($worn.legs.reveal / 200))}`)>>
		<</if>>
		<<if $worn.feet.reveal gte 50>>
			<<run _increaseAllure.push(`선정적인 신발 ${"+".repeat(Math.floor($worn.feet.reveal / 200))}`)>>
			<<run _increaseAttractive.push(`매력적인 신발 ${"+".repeat(Math.floor($worn.feet.reveal / 200))}`)>>
		<</if>>
		<<if Weather.dayState is "night">>
			<<run _increaseAllure.push("밤")>>
		<</if>>
		<<if $exposed gte 1>>
			<<run _increaseAllure.push("노출")>>
		<</if>>
		<<if $liquidcount gte 1>>
			<<run _increaseAllure.push("음란한 체액 냄새")>>
		<</if>>
		<<if $liquidcount gte 10>>
			<<run _increaseAllure.push("음란한 체액 범벅")>>
		<</if>>
		<<if $liquidcount gte 30>>
			<<run _increaseAllure.push("음란한 체액에 흠뻑 젖음")>>
		<</if>>
		<<if Time.isBloodMoon()>>
			<<run _increaseAllure.push("보름달")>>
		<</if>>
		<<if $auriga_scar gte 1>>
			<<run _increaseAllure.push(`엘크 흉터 ${"+".repeat($auriga_scar)}`)>>
		<</if>>
		<<set _negLabels = [
			{ threshold: 1000, class: "red", label: "악명 높은" },
			{ threshold: 600, class: "pink", label: "유명한" },
			{ threshold: 400, class: "purple", label: "알려진" },
			{ threshold: 200, class: "blue", label: "인지된" },
			{ threshold: 100, class: "lblue", label: "눈에 띄지 않는" },
			{ threshold: 30, class: "teal", label: "무명" }
		]>>
		<<set _posLabels = [
			{ threshold: 1000, class: "green", label: "악명 높은" },
			{ threshold: 600, class: "teal", label: "유명한" },
			{ threshold: 400, class: "lblue", label: "알려진" },
			{ threshold: 200, class: "blue", label: "인지된" },
			{ threshold: 100, class: "purple", label: "눈에 띄지 않는" },
			{ threshold: 30, class: "pink", label: "무명" }
		]>>
		<<set _neg = [
			{ type: "sex", name: "걸레" },
			{ type: "prostitution", name: "창녀" },
			{ type: "rape", name: "육변기" },
			{ type: "bestiality", name: $settings.bestialityEnabled ? "암캐" : "괴물박이" },
			{ type: "exhibitionism", name: "노출광" },
			{ type: "pregnancy", name: $fame.pregnancy gte 1000 ? "번식모" : ($fame.pregnancy gte 400 ? "번식용" : "어미") },
			{ type: "impreg", name: $fame.impreg gte 1000 ? "만인의 아버지" : ($fame.impreg gte 400 ? "씨내리" : "수정자") },
		]>>
		<<set _pos = [
			{ type: "scrap", name: "싸움꾼" },
			{ type: "good", name: "선행꾼" },
			{ type: "business", name: "사업가" },
			{ type: "social", name: $fame.social gte 1000 ? "아첨꾼" : "사교계 인사" },
			{ type: "model", name: $fame.model gte 1000 ? "자랑꾼" : "모델" },
		]>>
		<<set _decreaseAllure to _pos.some(fame => (_posLabels.some(status => $fame[fame.type] >= status.threshold)))>>

		<div class="settingsHeader">외모</div>
		<div class="settingsToggleItemWide">
			<i>외모</i>는 당신의 외모를 당신에게 유리하게 활용할 수 있는 능력을 수치화한 것입니다.
			<br>
			등급:
			<<if $attractiveness gte 5000>>
				<span class="green">S</span>
			<<elseif $attractiveness gte 4000>>
				<span class="teal">A</span>
			<<elseif $attractiveness gte 3000>>
				<span class="lblue">B</span>
			<<elseif $attractiveness gte 2000>>
				<span class="blue">C</span>
			<<elseif $attractiveness gte 1000>>
				<span class="purple">D</span>
			<<else>>
				<span class="pink">F</span>
			<</if>>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold bold">기여 요소:</span>
			<br>
			<span class="green">
				<<for _item range _increaseAttractive>>
					<<= _item>>
					<br>
				<</for>>
			</span>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<div class="settingsHeader">매력</div>
		<div class="settingsToggleItemWide">
			<i>매력</i>은 외모의 어두운 면으로, 사람들이 당신을 얼마나 추행하고 싶어 하는지를 나타냅니다.
			<br>
			현재 상태:
			<<if $allure gte 6000 * $settings.allureModifier>>
				<span class="red">당장이라도 무참히 유린당할 것처럼 보인다.</span>
			<<elseif $allure gte 4000 * $settings.allureModifier>>
				<span class="pink">당신은 변태를 부를 것처럼 보인다.</span>
			<<elseif $allure gte 3000 * $settings.allureModifier>>
				<span class="purple">당신은 음란해 보인다.</span>
			<<elseif $allure gte 2000 * $settings.allureModifier>>
				<span class="blue">당신은 눈에 띈다.</span>
			<<elseif $allure gte 1500 * $settings.allureModifier>>
				<span class="lblue">당신은 이목을 끈다.</span>
			<<elseif $allure gte 1000 * $settings.allureModifier>>
				<span class="teal">사람들이 당신을 힐끗거린다.</span>
			<<else>>
				<span class="green">당신은 평범해 보인다.</span>
			<</if>>
		</div>
		<div @class="_decreaseAllure ? 'settingsToggleItem' : 'settingsToggleItemWide'">
			<span class="gold bold">매력 상승 요소:</span>
			<br>
			<span class="red">
				<<for _item range _increaseAllure>>
					<<= _item>>
					<br>
				<</for>>
			</span>
			<<if !["island"].includes($location)>>
				<<for _fame range _neg>>
					<<set _famous = _negLabels.find(status => $fame[_fame.type] >= status.threshold)>>
					<<if _famous>>
						<span @class="_famous.class">명성: <<= _famous.label>> <<= _fame.name>> <<= "+".repeat([30, 100, 200, 400, 600, 1000].indexOf(_famous.threshold))>></span>
						<br>
					<</if>>
				<</for>>
			<</if>>
		</div>
		<<if _decreaseAllure>>
			<div class="settingsToggleItem">
				<span class="gold bold">매력 하락 요소:</span>
				<br>
				<<if !["island"].includes("location")>>
					<<for _fame range _pos>>
						<<set _famous = _posLabels.find(status => $fame[_fame.type] >= status.threshold)>>
						<<if _famous>>
							<span @class="_famous.class">명성: <<= _famous.label>> <<= _fame.name>> <<= "+".repeat([30, 100, 200, 400, 600, 1000].indexOf(_famous.threshold))>></span>
							<br>
						<</if>>
					<</for>>
				<</if>>
				<<if $moorLuck gt 5>>
					<span class="green">????</span>
					<br>
				<<elseif $moorLuck gt 0>>
					<span class="lblue">????</span>
					<br>
				<</if>>
			</div>
		<</if>>
	</div>
<</widget>>

<<widget "mirrorAppearancePregnancy">>
	당신은 마치 <span class="lewd">임신한 <<girl>>처럼 보인다...</span>
	<<if !$hourly.mirrorPregArousal>>
		<<set $hourly.mirrorPregArousal to true>>
		<<garousal>><<gstress>><<arousal 300>><<stress 10>>
	<</if>>
	<br><br>

	<<set _preg to getPlayerPregnancy()>>
	<<pregnancyFatherHint _preg>>
	<<run setPlayerLearnedPregnancyFrom("mirror")>>
<</widget>>

<<widget "mirrorBodywriting">>
	<<set _array to _args[0] is "visible" ? _skin_array : _hidden_writing>>
	<<for _index, _active_bodypart range _array>>
		<<if $skin[_active_bodypart].writing>>
			<<silently>><<bodypart _active_bodypart>><</silently>>
			<<= _text_output.toUpperFirst()>>: 
			<<if isLoveInterest($skin[_active_bodypart].special)>>
				<<set _colour to "lewd">>
			<<elseif $skin[_active_bodypart].special isnot "none">>
				<<set _colour to "red">>
			<<elseif $skin[_active_bodypart].lewd is 1>>
				<<set _colour to "pink">>
			<<else>>
				<<set _colour to "purple">>
			<</if>>
			<<if $skin[_active_bodypart].type is "text">>
				<<set _written to "적혀">>
				"<span @class="_colour"><<= window.KR.getBodywritingKr($skin[_active_bodypart].writing).toUpperFirst()>></span>"【이가】 
			<<else>>
				<<set _written to "그려져">>
				<span @class="_colour"><<= window.KR.getBodywritingKr($skin[_active_bodypart].writing)>></span> 그림이 
			<</if>>
			<<if $skin[_active_bodypart].arrow is 1>>
				<<if _active_bodypart is "left_cheek" or _active_bodypart is "right_cheek">>
					입을 가리키는 화살표와 함께 
				<<elseif _active_bodypart is "left_bottom" or _active_bodypart is "right_bottom" or _active_bodypart is "back">>
					항문을 가리키는 화살표와 함께 
				<<elseif _active_bodypart is "pubic" or _active_bodypart is "left_thigh" or _active_bodypart is "right_thigh">>
					<<genitals true>>【을를】 가리키는 화살표와 함께 
				<</if>>
			<</if>>
			<<switch $skin[_active_bodypart].pen>>
				<<case "marker">>
					유성 마커로 <<= _written>> 있다.
				<<case "magic">>
					세겨져 있다. (<span class="pink">봉인</span>)
				<<case "pen">>
					일반 펜으로 <<= _written>> 있다.
				<<case "lipstick">>
					립스틱으로 <<= _written>> 있다.
				<<case "mud">>
					진흙으로 <<= _written>> 있다.
				<<case "tattoo" "brand">>
					(<span class="red"><<= $skin[_active_bodypart].pen is "tattoo" ? "문신" : "낙인">></span>)
				<<default>>
					<<= $skin[_active_bodypart].pen>>【으로로】 <<= _written>> 있다.
			<</switch>>
			<<= _index lt _array.length - 1 ? "<br>" : "">>
		<</if>>
	<</for>>
<</widget>>

<<widget "visual-settings">>
	<<mirroricon>><<link "뒤로">><<replace #mirror>><<mirrorMenu>><</replace>><<numberify "#passages > .passage">><<unset $mirrorMenu>><</link>>
<</widget>>

<<widget "faceStyleOptions">>
	현재 당신의 얼굴 스타일:
	<<listbox "_facestyle" autoselect>>
		<<optionsfrom setup.faceStyleOptions>>
	<</listbox>>
	<br>
	<<link "적용">>
		<<if $facestyle isnot _facestyle>>
			<<set $facestyle to _facestyle>>
			<<set $facevariant to "default">>
			<<replace "#visualsFaceVariantRadios">><<faceVariantOptions>><</replace>>
			<<updatesidebarimg true>>
		<</if>>
	<</link>>
<</widget>>

<<widget "faceVariantOptions">>
	<<if Object.keys(setup.faceVariantOptions[$facestyle]).length gt 1>>
		선택한 인상:
		<<listbox "$facevariant" autoselect>>
			<<optionsfrom setup.faceVariantOptions[$facestyle]>>
		<</listbox>>
		<br>
		<<run $(() => {
			$("#listbox-facevariant").on("change", () => {
				Wikifier.wikifyEval('<<updatesidebarimg true>>');
			});
		})>>
	<<else>>
		현재
		<mouse class = "gold tooltip-small" style="border-bottom-color:white">
			사용 가능한 다른 표정 옵션이 없습니다.
			<span class="blue">
				다른 얼굴 스타일을 선택하면 추가적인 표정을 사용할 수 있게 될 수도 있습니다.
			</span>
		</mouse>
	<</if>>
<</widget>>

<<widget "mirrorSkin">>
	<<mirroricon>><<link "뒤로">><<updatesidebarimg>><<replace #mirror>><<mirrorMenu>><</replace>><<numberify "#passages > .passage">><<unset $mirrorMenu>><</link>>
	<br><br>

	<div class="settingsGrid">
		<div class="settingsHeader">피부</div>
		<div class="settingsToggleItem">
			<span class="gold bold">태닝:</span>
			<br>
			선택한 피부 타입:
			<<listbox "$settings.tanningDifficulty" autoselect>>
				<<option "매우 잘 탐" 0>>
				<<option "잘 탐" 1>>
				<<option "보통으로 탐" 2>>
				<<option "잘 안 탐" 3>>
				<<option "거의 안 탐" 4>>
			<</listbox>>
			<br><br>
			<span id="sunscreenDescription">
				<<sunscreenDesc>>
			</span>
			<span id="sunscreenLinks">
				<<sunscreenLinks>>
			</span>
			<br>
			<label data-target="options.images" data-disabledif="V.options.images===0">
				<<checkbox "$options.tanLines" false true autocheck>> 옷에 의한 태닝 자국 활성화
			</label>
			<mouse class="tooltip-small linkBlue">(?)<span>태닝 자국의 시각적 요소를 비활성화합니다. 사이드바에만 적용됩니다.</span></mouse>
		</div>
		<div class="settingsToggleItem">
			<span class="gold bold">신체 액체:</span>
			<<if $liquidcount gt 0>>
				<<mirrorwet "neck" $player.bodyliquid.neck.semen $player.bodyliquid.neck.goo $player.bodyliquid.neck.nectar>>
				<<mirrorwet "right arm" $player.bodyliquid.rightarm.semen $player.bodyliquid.rightarm.goo $player.bodyliquid.rightarm.nectar>>
				<<mirrorwet "left arm" $player.bodyliquid.leftarm.semen $player.bodyliquid.leftarm.goo $player.bodyliquid.leftarm.nectar>>
				<<mirrorwet "thighs" $player.bodyliquid.thigh.semen $player.bodyliquid.thigh.goo $player.bodyliquid.thigh.nectar>>
				<<mirrorwet "bottom" $player.bodyliquid.bottom.semen $player.bodyliquid.bottom.goo $player.bodyliquid.bottom.nectar>>
				<<mirrorwet "tummy" $player.bodyliquid.tummy.semen $player.bodyliquid.tummy.goo $player.bodyliquid.tummy.nectar>>
				<<mirrorwet "chest" $player.bodyliquid.chest.semen $player.bodyliquid.chest.goo $player.bodyliquid.chest.nectar>>
				<<mirrorwet "face" $player.bodyliquid.face.semen $player.bodyliquid.face.goo $player.bodyliquid.face.nectar>>
				<<mirrorwet "hair" $player.bodyliquid.hair.semen $player.bodyliquid.hair.goo $player.bodyliquid.hair.nectar>>
				<<mirrorwet "feet" $player.bodyliquid.feet.semen $player.bodyliquid.feet.goo $player.bodyliquid.feet.nectar>>
				<<mirrorwet "labia" $player.bodyliquid.vaginaoutside.semen $player.bodyliquid.vaginaoutside.goo $player.bodyliquid.vaginaoutside.nectar>>
				<<mirrorwet "vagina" $player.bodyliquid.vagina.semen $player.bodyliquid.vagina.goo $player.bodyliquid.vagina.nectar>>
				<<mirrorwet "penis" $player.bodyliquid.penis.semen $player.bodyliquid.penis.goo $player.bodyliquid.penis.nectar>>
				<<mirrorwet "anus" $player.bodyliquid.anus.semen $player.bodyliquid.anus.goo $player.bodyliquid.anus.nectar>>
				<<mirrorwet "mouth" $player.bodyliquid.mouth.semen $player.bodyliquid.mouth.goo $player.bodyliquid.mouth.nectar>>
			<<else>>
				<br>
				피부가 <span class="green">깨끗합니다</span>.
			<</if>>

		</div>
	</div>
	<hr>
	<div class="settingsGrid">
		<<bodywritingExposureCheck true true>>
		<<bodywritingHiddenCheck true true>>
		<div class="settingsHeader">신체</div>
		<<if _bodywriting_exposed is 1 and _bodywriting_hidden is 1>>
			<div class="settingsToggleItem">
				<span class="gold bold">눈에 띄는 낙서:</span>
				<br>
				<<mirrorBodywriting "visible">>
				<br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">가려진 낙서:</span>
				<br>
				<<mirrorBodywriting "hidden">>
				<br>
			</div>
		<<elseif _bodywriting_exposed is 1 || _bodywriting_hidden is 1>>
			<div class="settingsToggleItemWide">
				<<if _bodywriting_exposed is 1>>
					<span class="gold bold">눈에 띄는 낙서:</span>
					<br>
					<<mirrorBodywriting "visible">>
					<br>
				<<elseif _bodywriting_hidden is 1>>
					<span class="gold bold">가려진 낙서:</span>
					<br>
					<<mirrorBodywriting "hidden">>
					<br>
				<</if>>
			</div>
		<</if>>

		<div class="settingsToggleItemWide">
			<<if $bodyWritingSelected is null>>
				<<unset $bodyWritingSelected>>
			<</if>>
			<<if $bodyWritingSelected isnot undefined>>
				당신은
				<<if isLoveInterest($skin[$bodyPartSelected].special)>>
					"<span class="lewd"><<print $bodyWritingSelected>></span>"
				<<elseif $skin[$bodyPartSelected].special isnot "none">>
					"<span class="red"><<print $bodyWritingSelected>></span>"
				<<elseif $skin[$bodyPartSelected].lewd is 1>>
					"<span class="pink"><<print $bodyWritingSelected>></span>"
				<<else>>
					"<span class="purple"><<print $bodyWritingSelected>></span>"
				<</if>>
				라는 문구를 <<bodypart $bodyPartSelected>>에 적는다.
				<<unset $bodyWritingSelected>>
				<<unset $bodyPartSelected>>
				<hr>
			<</if>>

			<<bodywritingOptions>>

			/*Needs to be last*/
			<div class="mirrorContainer">
				<<bodywritingMenuLinks>>
			</div>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold bold">체형:</span>
			<mouse class="tooltip-small linkBlue">(?)<span>이것은 외형적인 변화이며, 성별 묘사에 영향을 주지 않습니다.</span></mouse>
			<br>
			선택한 체형:
			<span class="capitalize">
				<<set _bodyShapeLabelsKr to {
					"classic": "평범한",
					"slender": "슬림한",
					"curvy": "잘록한",
					"soft": "푹신한"
				}>>
				<<set _bodyShapeOptions to {}>>
				<<for _s range setup.bodyShapes>>
					<<set _bodyShapeOptions[_bodyShapeLabelsKr[_s] || _s] to _s>>
				<</for>>
				<<listbox "$player.bodyshape" autoselect>>
					<<optionsfrom _bodyShapeOptions>>
				<</listbox>>
			</span>
			<br>
			<<run $(() => {
				$("#listbox-playerbodyshape").on("change", () => {
					Wikifier.wikifyEval('<<updatesidebarimg true>>');
				});
			})>>
		</div>
	</div>
	<hr>
	<div class="settingsGrid">

		<div class="settingsHeader">얼굴 설정</div>
		<<if setup.faceStyleOptions.length gt 1>>
			<div id="visualsFaceStyle" class="settingsToggleItem">
				<span class="gold bold">얼굴 스타일:</span><br>
				<<faceStyleOptions>>
			</div>
		<</if>>

		<div id="visualsFaceVariants" @class="setup.faceStyleOptions.length gt 1 ? 'settingsToggleItem' : 'settingsToggleItemWide'">
			<span class="gold bold">인상:</span>
			<br>
			<div id="visualsFaceVariantRadios">
				<<faceVariantOptions>>
			</div>
		</div>
	</div>
<</widget>>

<<widget "sunscreenLinks">>
	<<if Skin.Sunscreen.isApplied()>>
		<br>
		<<cosmeticsicon "sunscreen">><<link "선크림 지우기">>

			<<set Skin.Sunscreen.autoApply to false>>
			<<replace #sunscreenDescription>><<sunscreenApply "remove">><</replace>>
			<<replace #sunscreenLinks>><<sunscreenLinks>><</replace>>
		<</link>> <<note `'남은 횟수: ' + Skin.Sunscreen.usesLeft + '회'`>>
	<<else>>
		<<if Skin.Sunscreen.usesLeft gt 0>>
			<br>
			<<cosmeticsicon "sunscreen">><<link "선크림 바르기">>

				<<replace #sunscreenDescription>><<sunscreenApply>><</replace>>
				<<replace #sunscreenLinks>><<sunscreenLinks>><</replace>>
			<</link>> <<note `'남은 횟수: ' + Skin.Sunscreen.usesLeft + '회'`>>
		<</if>>
	<</if>>
	<br>
	<<if Skin.Sunscreen.usesLeft gt 0>>
		<<ind>><<link `Skin.Sunscreen.autoApply ? "자동 바르기 중지" : "필요할 때 자동으로 바르기"`>>
			<<set Skin.Sunscreen.autoApply to !Skin.Sunscreen.autoApply>>
			<<replace #sunscreenLinks>><<sunscreenLinks>><</replace>>
		<</link>>
	<</if>>
<</widget>>

<<widget "sunscreenDesc">>
	당신의 피부는 지금
	<<if Skin.Sunscreen.isApplied()>>
		<mouse class = "gold tooltip-small" style="border-bottom-color:white">
			햇빛으로부터 보호받고 있습니다
			<span class="black">
				선크림 덕분에 피부가 타지 않고 있습니다.
				<<if Skin.Sunscreen.usesLeft is 0>>
					<br>
					<i class="blue">선크림은 상점에서 구할 수 있습니다</i>
				<</if>>
			</span>
		</mouse>
		<<set $_timeLeft to Math.floor(Skin.Sunscreen.timeLeft / 60)>>
		(<<print getTimeString($_timeLeft)>> 남음).
	<<else>>
		<mouse class = "gold tooltip-small" style="border-bottom-color:white">
			햇빛으로부터 보호받지 못하고 있습니다.
			<span class="black">
				햇빛에 노출되면 피부가 타게 됩니다.
				<<if Skin.Sunscreen.usesLeft is 0>>
					<br>
					<i class="blue">선크림은 화장품 가게에서 구할 수 있습니다</i>
				<</if>>
			</span>
		</mouse>
	<</if>>
<</widget>>

<<widget "sunscreenApply">>
	<<if !pcAreArmsBound("any")>>
		<<if _args[0] is "remove">>
			<<run Skin.Sunscreen.remove()>>
		<<else>>
			<<run Skin.Sunscreen.apply()>>
		<</if>>
	<</if>>
	<<if pcAreArmsBound("both")>>
		<span class="red">양팔이 모두 묶여 있어</span>, 이런 상태로는 당신의 피부에 어떤 조치도 취하기가 어렵다.
		<hr>
	<<elseif _args[0] is "remove">>
		<<wearProp "rag" "white">><<updatesidebarimg>>
		당신은 젖은 수건으로 피부를 문질러서, 선크림의 마지막 흔적까지 닦아낸다.
		<hr>
	<<else>>
		<<wearProp "sunscreen">><<updatesidebarimg>>
