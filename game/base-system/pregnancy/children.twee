		<<switch $childRecords[$_id].species>>
			<<case "human">><<set $_text_output to "머리카락">>
			<<case "wolf" "wolfboy" "wolfgirl">><<set $_text_output to "털">>
			<<case "hawk">><<set $_text_output to "깃털">>
		<</switch>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

/*args[0] - cry type, args[1] - childId */
<<widget "childcry">><<silently>>
	<<if _args[1] isnot undefined>>
		<<set $_id to _args[1]>>
	<<elseif $childSelected isnot undefined>>
		<<set $_id to $childSelected.childId>>
	<</if>>
	<<if $_id isnot undefined>>
		<<if between(_args[0], 1, 4)>>
			<<set $_cry to _args[0]>>
		<<else>>
			<<set $_cry to 1>>
		<</if>>
		<<switch $childRecords[$_id].species>>
			<<case "human">>
				<<switch $_cry>>
					<<case 1>><<set $_text_output to "훌쩍이고 있다">>
					<<case 2>><<set $_text_output to "울고 있다">>
					<<case 3>><<set $_text_output to "흐느끼고 있다">>
					<<case 4>><<set $_text_output to "울부짖고 있다">>
				<</switch>>
			<<case "wolf" "wolfboy" "wolfgirl">>
				<<switch $_cry>>
					<<case 1>><<set $_text_output to "낑낑거리고 있다">>
					<<case 2>><<set $_text_output to "훌쩍이고 있다">>
					<<case 3>><<set $_text_output to "울고 있다">>
					<<case 4>><<set $_text_output to "하울링하고 있다">>
				<</switch>>
			<<case "hawk">>
				<<switch $_cry>>
					<<case 1>><<set $_text_output to "짹짹거리고 있다">>
					<<case 2>><<set $_text_output to "지저귀고 있다">>
					<<case 3>><<set $_text_output to "떨리는 소리로 울고 있다">>
					<<case 4>><<set $_text_output to "가락 섞인 소리로 울고 있다">>
				<</switch>>
		<</switch>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

/*args[0] - childId*/
<<widget "childtype">><<silently>>
	<<if _args[0] isnot undefined>>
		<<set $_id to _args[0]>>
	<<elseif $childSelected isnot undefined>>
		<<set $_id to $childSelected.childId>>
	<</if>>
	<<if $_id isnot undefined>>
		<<switch $childRecords[$_id].species>>
			<<case "human">><<set $_text_output to "아이">>
			<<case "wolf" "wolfboy" "wolfgirl">><<set $_text_output to "새끼">>
			<<case "hawk">><<set $_text_output to ($childRecords[$_id].features.monster is "monster" ? "nestling" : "chick")>>
		<</switch>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

/*args[0] - child object*/
<<widget "childTypeDisplay">><<silently>>
	<<if _args[0] and _args[0].childId isnot undefined>>
		<<if !(_args[0].species is "wolf" && _args[0].features.monster && _args[0].gender isnot "h")>>
			<<switch _args[0].gender>>
				<<case "m">><<set $_text_output to "♂ ">>
				<<case "f">><<set $_text_output to "♀ ">>
				<<case "h">><<set $_text_output to "⚥ ">>
			<</switch>>
		<<else>>
			<<set $_text_output to "">>
		<</if>>
		<<if _args[0].species isnot "human">>
			<<if _args[0].features.monster>>
				<<switch _args[0].species>>
					<<case "wolf">>
						<<set $_text_output += "늑대">>
						<<switch _args[0].gender>>
							<<case "m">><<set $_text_output += " 소년">>
							<<case "f">><<set $_text_output += " 소녀">>
							<<default>><<set $_text_output += " 아이">>
						<</switch>>
					<<case "hawk">>
						<<set $_text_output += "하피">>
				<</switch>>
			<<else>>
				<<set $_text_output += _args[0].species.toUpperFirst()>>
			<</if>>
		<<else>>
			<<set $_text_output += "인간<<if _args[0].features.beastTransform or _args[0].features.divineTransform>> (<<childTransform _args[0]>>)<</if>>">>
		<</if>>
	<</if>>
<</silently>><<if $_text_output>><span class="gold">종족:</span> <<print $_text_output>><</if>>
<</widget>>

<<widget "childTransform">><<silently>>
	<<if _args[0] and _args[0].childId isnot undefined>>
		<<set $_child to _args[0]>>
	<<elseif _args[0] isnot undefined>>
		<<set $_id to _args[0]>>
		<<set $_child to $childRecords[$_id]>>
	<<elseif $childSelected isnot undefined>>
		<<set $_id to $childSelected.childId>>
		<<set $_child to $childRecords[$_id]>>
	<</if>>
	<<if $_child isnot undefined>>
		<<set $_text_output to "">>
		<<switch $_child.features.divineTransform>>
			<<case "angel">><<set $_text_output += "천사형">>
			<<case "demon">><<set $_text_output += "악마형">>
			<<case "fallen">><<set $_text_output += "타락 천사형">>
		<</switch>>
		<<if $_child.features.divineTransform and $_child.features.beastTransform>><<set $_text_output += " ">><</if>>
		<<switch $_child.features.beastTransform>>
			<<case "cat">><<set $_text_output += "고양이" + ($_child.gender === "m" ? " 소년" : " 소녀")>>
			<<case "cow">><<set $_text_output += "소" + ($_child.gender === "m" ? " 소년" : " 소녀")>>
			<<case "wolf">><<set $_text_output += "늑대" + ($_child.gender === "m" ? " 소년" : " 소녀")>>
			<<case "bird">><<set $_text_output += "새" + ($_child.gender === "m" ? " 소년" : " 소녀")>>
			<<case "fox">><<set $_text_output += "여우" + ($_child.gender === "m" ? " 소년" : " 소녀")>>
		<</switch>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

/*args[0] - childId, args[1] - word*/
<<widget "childFirstWord">><<silently>>
	<<if _args[0] isnot undefined>>
		<<set $_id to _args[0]>>
	<<elseif $childSelected isnot undefined>>
		<<set $_id to $childSelected.childId>>
	<</if>>
	<<if $_id isnot undefined and $childRecords[$_id].development.firstWord>>
		<<set $_text_output to $childRecords[$_id].development.firstWord>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

/*args[0] - location, args[1] - toyid, toy set or toy name, args[2] - option of either "notext" or "lowercase"*/
<<widget "childtoy">><<silently>>
	<<toySelection>>
	<<set _toys to $storedChildrenToys[_args[0]]>>
	<<if _toys>>
		<<if between(_args[1], 0, _toys.length - 1)>>
			<<set _toy to _toys[_args[1]]>>
		<<elseif _args[1]>>
			<<set _toySelect to []>>
			<<for $_i to 0; $_i lt _toys.length; $_i++>>
				<<if _toys[$_i].set is _args[1] or _toys[$_i].name is _args[1]>>
					<<run _toySelect.push($_i)>>
				<</if>>
			<</for>>
			<<if _toySelect.length gt 0>>
				<<set _toyid to _toySelect[random(0,_toySelect.length - 1)]>>
				<<set _toy to _toys[_toyid]>>
			<</if>>
		<<else>>
			<<set _toyid to random(0,_toys.length - 1)>>
			<<set _toy to _toys[_toyid]>>
		<</if>>
		<<if _toy>>
			<<switch _args[2]>>
				<<case "notext">>
				<<case "lowercase">>
					/* .name(영문, 불변)을 카탈로그에서 조회해 name_lower(한글)를 가져옴 */
					<<set $_text_output to getToyNameKr(_toySelection, _toy.name)>>
					<<set _toyName to getToyNameKr(_toySelection, _toy.name)>>
				<<default>>
					<<set $_text_output to getToyNameKr(_toySelection, _toy.name)>>
					<<set _toyName to getToyNameKr(_toySelection, _toy.name)>>
			<</switch>>
		<</if>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

/*args[0] - location*/
<<widget "childSelectRandom">>
	<<set $childSelected to getBornChildren().filter(child => !_args[0] or child.development.location === _args[0]).random()>>
<</widget>>

<<widget "childViewerDisplay">>
	<<set _idList to _args[0]>>
	<<set _listMaxItems to 10>>
	<<set _listPage to 1>>
	<<set _listPageMax to Math.ceil(_idList.length / _listMaxItems)>>
	<<set _childStart to 0>>
	<<set _childEnd to (_childStart + _listMaxItems gt _idList.length ? _idList.length : _childStart + _listMaxItems)>>
	<div id="childViewer">
		<<childViewerDisplayElements>>
	</div>
<</widget>>

<<widget "childViewerPageUpdate">>
	<<set _childStart to _listMaxItems * (_listPage - 1)>>
	<<set _childEnd to (_childStart + _listMaxItems lte _idList.length ? _childStart + _listMaxItems : _idList.length)>>
	<<replace '#childViewer'>>
		<<childViewerDisplayElements>>
	<</replace>>
<</widget>>

<<widget "childViewerDisplayElements">>
	<div class="settingsGrid m-0 childContainer">
		<<for $_i to _childStart; $_i lt _childEnd; $_i++>>
			<<set _childId to _childrenIds[$_i]>>
			<<capture _childId>>
				<div @id="'child-' + _childId">
					<<childViewerElement `_childId`>>
				</div>
			<</capture>>
		<</for>>
	</div>
	<br>
	<div class="childrenUiControls">
		<<set _disabled = _listPage > 1 ? "" : "disabled">>
		<div @class="'div-link btn-pagination prev ' + _disabled">
			<<link "이전">>
				<<if _listPage > 1>>
					<<set _listPage -= 1>>
					<<childViewerPageUpdate>>
				<</if>>
			<</link>>
			<div class="btn-pagination-arrow">&lt;</div>
		</div>
		<div>
			<<print (_listPage) + " / " + _listPageMax>>
		</div>
		<<set _disabled = _listPage < _listPageMax ? "" : "disabled">>
		<div @class="'div-link btn-pagination next ' + _disabled">
			<<link "다음">>
				<<if _listPage < _listPageMax>>
					<<set _listPage += 1>>
					<<childViewerPageUpdate>>
				<</if>>
			<</link>>
			<div class="btn-pagination-arrow">&gt;</div>
		</div>
	</div>
	<<run linkifyDivs('#childViewer')>>
<</widget>>

<<widget "childViewerElement">>
	<<if _children is undefined>>
		<<set _children to {}>>
	<</if>>
	<<capture _args>>
		<div class="childItem m-0 childName">
			<div>
				<label><div><<childrenicon _args[0]>></div><div>Name:</div> <div><<textbox "$childRecords[_args[0]].name" `$childRecords[_args[0]].name`>></div></label>
			</div>
		</div>
		<div class="childItem m-0 childDetails">
			<<childTypeDisplay $childRecords[_args[0]]>>
			<span class="no-numberify">
				| <<link "추가 상세정보">><<childViewerHiddenElementsUnhide _args[0]>><</link>>
			</span>
			<<childViewerHiddenElements _args[0] _args[1]>>
			<<childActivity _args[0]>>
		</div>
	<</capture>>
<</widget>>

<<widget "childViewerHiddenElements">>
	<<if _args[0] isnot undefined>>
		<div @id="'childViewerHidden-'+_args[0]" @class="'childViewerHidden' + (_args[1] ? '' : ' hidden')">
			<span class="gold">어머니:</span>
			<<if knowsCarrier($childRecords[_args[0]].pregnancyId, "pc")>>
				<<print pregnancyNameCorrection(getPregnancyOf($childRecords[_args[0]]).carrier, true)>>
			<<else>>
				????
			<</if>>
			| <span class="gold">아버지:</span>
			<<if knowsDonor($childRecords[_args[0]].pregnancyId, "pc")>>
				<<print pregnancyNameCorrection(getPregnancyOf($childRecords[_args[0]]).donor, true)>>
			<<else>>
				????
			<</if>>
			<br>
			<<if childIsUnhatchedEgg($childRecords[_args[0]])>>
				<<set _laidDate to new DateTime(getPregnancyOf($childRecords[_args[0]]).deliveredDate)>>
				<span class="gold">산란일:</span> <<print getFormattedDate(_laidDate)>>
			<<elseif $childRecords[_args[0]].species is "hawk" or $childRecords[_args[0]].species is "harpy">>
				<<set _laidDate to new DateTime(getPregnancyOf($childRecords[_args[0]]).deliveredDate)>>
				<<set _hatchedDate to new DateTime($childRecords[_args[0]].bornDate)>>
				<span class="gold">산란일:</span> <<print getFormattedDate(_laidDate)>> |
				<span class="gold">부화일:</span> <<print getFormattedDate(_hatchedDate)>>
			<<else>>
				<<set _bornDate to new DateTime($childRecords[_args[0]].bornDate)>>
				<span class="gold">출생일:</span> <<print getFormattedDate(_bornDate)>>
			<</if>>
			<<if $childRecords[_args[0]].development.adoptedDate>>
				<<set _adoptedDate to new DateTime($childRecords[_args[0]].development.adoptedDate)>>
				| <span class="gold">입양일:</span> <<print getFormattedDate(_adoptedDate)>>
			<</if>>
			<br>
			<span class="gold">나이:</span> <<childAge _args[0] "full">>
			<br>
			<span class="gold">크기:</span> <<childKrText "size" $childRecords[_args[0]].features.size>>
			<<if $childRecords[_args[0]].features.hairColour>>
				<<if $childRecords[_args[0]].species.includes("human")>>
					| <span class="gold">머리카락:</span>
				<<elseif $childRecords[_args[0]].species.includes("hawk")>>
					| <span class="gold">깃털:</span>
				<<else>>
					| <span class="gold">털:</span>
				<</if>>
				<<childKrText "hair" $childRecords[_args[0]].features.hairColour>>
			<</if>>
			<<if $childRecords[_args[0]].features.eyeColour>>
				| <span class="gold">눈:</span> <<childKrText "eye" $childRecords[_args[0]].features.eyeColour>>
			<</if>>
			<<if $childRecords[_args[0]].features.skinColour>>
				| <span class="gold">피부:</span> <<childKrText "skin" $childRecords[_args[0]].features.skinColour>>
			<</if>>
			<br>
			<<if $childRecords[_args[0]].identical isnot null>>
				<span class="gold">일란성:</span> 예
				<br>
			<</if>>
			<<if $childRecords[_args[0]].development.interactionsTotal>>
				<span class="gold">총 상호작용:</span> <<print $childRecords[_args[0]].development.interactionsTotal>>
				<br>
			<</if>>
			<span class="no-numberify">
				<span class="gold">이름 변경:</span>
				<<link "무작위 이름">>
					<<set $childRecords[_args[0]].name to generateBabyName(undefined, $childRecords[_args[0]].gender, _args[0])>>
					<<replace `"#child-" + _args[0]`>><<childViewerElement _args[0] true>><</replace>>
				<</link>>
			</span>
			<<if $debug is 1>>
				<br>
				<small>
					ChildId: <<print $childRecords[_args[0]].childId>> |
					saveId: <<print $saveId>>
					<<if $saveName isnot "">>
						| name: <<print $saveName>>
					<</if>>
				</small>
			<</if>>
		</div>
	<</if>>
<</widget>>

<<widget "childViewerHiddenElementsUnhide">>
	<<capture _args>>
		<<if _args[0] isnot undefined>>
			<<toggleclass `'#childViewerHidden-' + _args[0]` "hidden">>
		<</if>>
	<</capture>>
<</widget>>

<<widget "childActivity">>
	<<if _args[0] isnot undefined>>
		<<childAge _args[0]>>
		<<childSelect _args[0]>>
		/*'updateChildActivity' Changes the current event if enough time has passed*/
		<<updateChildActivity _args[0]>>
		<hr>
		<<switch $childRecords[_args[0]].species>>
			<<case "human">><<humanChildActivity _args[0]>>
			<<case "wolf" "wolfboy" "wolfgirl">><<wolfChildActivity _args[0]>>
			<<case "hawk">><<hawkChildActivity _args[0]>>
		<</switch>>
	<</if>>
<</widget>>

/*ToDo: Pregnancy Story Content: Lacking events. Human children events which the place accesses by going to the childrens UI*/
<<widget "humanChildActivity">>
	<<set _activityColour to !$daily.childInteractions or !$daily.childInteractions.includes(_args[0]) ? " childrensActivityGold" : "">>
	<span @class="'no-numberify' + _activityColour">
		<<switch $childRecords[_args[0]].development.activity>>
			<<case "noEvent">>
				<<childHe>>【은는】 곤히 자고 있다.
			<<case "sleeping">>
				<<childHe>>【은는】 곤히 자고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<set _rng to random(1, 6)>>
					<<switch _rng>>
						<<case 1>>
							<<link [[<<childhim>>【을를】 지켜본다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"transfixed", childid:_args[0]}>><</link>>
						<<case 2>>
							<<link [[<<childhim>>【을를】 지켜본다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"stroke", childid:_args[0]}>><</link>>
						<<case 3>>
							<<link [[<<childhim>>【을를】 지켜본다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"yawn", childid:_args[0]}>><</link>>
						<<case 4>>
							<<link [[<<childhim>>【을를】 지켜본다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"murmur", childid:_args[0]}>><</link>>
						<<case 5>>
							<<link [[낮잠을 잔다 (0:30)|Children Activity Events]]>><<pass 30>><<set $childActivityEvent to {event:"cotNap", childid:_args[0]}>><</link>>
						<<default>>
							<<link [[<<childhim>>【을를】 지켜본다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"shiverInCot", childid:_args[0]}>><</link>>
					<</switch>>
				<</if>>
			<<case "restlessSleep">>
				<<childHe>>【은는】 자면서 뒤척이고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[<<childhim>>【을를】 진정시킨다 (0:30)|Children Activity Events]]>><<pass 30>><<set $childActivityEvent to {event:"restlessSleep", childid:_args[0]}>><</link>>
				<</if>>
			<<case "crying">>
				<<childHe>>【은는】 괴로운 듯 울고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<set _rng to random(1, 6)>>
					<<switch _rng>>
						<<case 1>>
							<<link [[달래준다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"holdToShoulder", childid:_args[0]}>><</link>>
						<<case 2>>
							<<link [[달래준다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"melodicLullaby", childid:_args[0]}>><</link>>
						<<case 3>>
							<<link [[달래준다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"foreheadKiss", childid:_args[0]}>><</link>>
						<<case 4>>
							<<link [[달래준다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"objectShow", childid:_args[0]}>><</link>>
						<<case 5>>
							<<link [[달래준다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"carryRevolt", childid:_args[0]}>><</link>>
						<<default>>
							<<link [[달래준다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"rockToSleep", childid:_args[0]}>><</link>>
					<</switch>>
				<</if>>
			<<case "lonely">>
				<<childHe>>【은는】 외로워 보인다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<set _rng to random(1, 10)>>
					<<switch _rng>>
						<<case 1>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"nurseryRhymes", childid:_args[0]}>><</link>>
						<<case 2>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"FeetCup", childid:_args[0]}>><</link>>
						<<case 3>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"shareThoughts", childid:_args[0]}>><</link>>
						<<case 4>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"speakCry", childid:_args[0]}>><</link>>
						<<case 5>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"waveTongue", childid:_args[0]}>><</link>>
						<<case 6>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"handsClap", childid:_args[0]}>><</link>>
						<<case 7>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"peekaboo", childid:_args[0]}>><</link>>
						<<case 8>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"blowRaspberriesHappy", childid:_args[0]}>><</link>>
						<<case 9>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"blowRaspberriesUpset", childid:_args[0]}>><</link>>
						<<default>>
							<<link [[어르고 달랜다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"faceStudy", childid:_args[0]}>><</link>>
					<</switch>>
				<</if>>
			<<case "happy">>
				<<childHe>>【은는】 미소지으며 기분 좋게 옹알이를 하고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[미소 짓고 웃어준다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"smilesAndLaughs", childid:_args[0]}>><</link>>
				<</if>>
			<<case "talking">>
				<<childHe>>【은는】 혼자서 목을 울리며 옹알거리고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[옹알이에 맞장구친다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"talking", childid:_args[0]}>><</link>>
				<</if>>
			<<case "talking2">>
				<<childHe>>【은는】 혼자서 목을 울리며 소리를 내려 애쓰고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[대화에 어울린다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"talking2", childid:_args[0]}>><</link>>
				<</if>>
			<<case "nappyChange">>
				<<childHe>>【은는】 불편해 보이고 냄새가 난다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[정리한다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"nappyChange", childid:_args[0]}>><</link>>
				<</if>>
			<<case "bathe">>
				<<childHe>>【은는】 목욕할 때가 된 것 같다.
				<<if $childRecords[_args[0]].development.event>>
					<<switch random(1, 4)>>
						<<case 1>>
							<<link [[씻긴다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"batheGentle", childid:_args[0]}>><</link>>
						<<case 2>>
							<<link [[씻긴다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"batheShampoo", childid:_args[0]}>><</link>>
						<<case 3>>
							<<link [[씻긴다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"BatheCalm", childid:_args[0]}>><</link>>
						<<case 4>>
							<<link [[씻긴다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"batheTantrum", childid:_args[0]}>><</link>>
						<<default>>
					<</switch>>
				<</if>>
			<<case "thumbSucking">>
				<<childHe>>【은는】 행복하게 <<childhis>> 엄지를 빨고 있다.
			<<case "grumpyChild">>
				<<childHe>>【은는】 짜증을 부리고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[간지럽힌다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"grumpyChild", childid:_args[0]}>><</link>>
				<</if>>
			<<case "crawlingAttempt">>
				<<childHe>>【은는】 배를 깔고 엎드려 팔다리를 버둥거리고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[<<childhim>>【을를】 도와준다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"crawlingAttempt", childid:_args[0]}>><</link>>
				<</if>>
			<<case "crawlingAttempt2">>
				<<childHe>>【은는】 방 안을 천천히 기어 다니고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[<<childhim>>【을를】 도와준다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"crawlingAttempt2", childid:_args[0]}>><</link>>
				<</if>>
			<<case "readingAttempt">>
				<<childHe>>【은는】 동화책을 거꾸로 들고 보고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[책장을 넘겨준다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"readingAttempt", childid:_args[0]}>><</link>>
				<</if>>
			<<case "readingCorrected">>
				<<childHe>>【은는】 동화책을 보고 있다.
			<<case "babyRattle">>
				<<childtoy $location "baby rattles" "notext">>
				<<if _toyid>>
					<<childHe>>【은는】 <<childtoy $location _toyid "lowercase">>【을를】 바라보고 있다.
					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<capture _toyid>><<link [[흔든다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"babyRattle", childid:_args[0], toyid:_toyid}>><</link>><</capture>> |
					<</if>>
				<<else>>
					<<humanChildActivityNoToy _args[0]>>
				<</if>>
			<<case "teddyBear">>
				<<childtoy $location "teddy bears" "notext">>
				<<if _toyid>>
					<<childHe>>【은는】 <<childhis>> 잠자리에서 <<childtoy $location _toyid "lowercase">> 옆을 뒤척이고 있다.
					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<capture _toyid>><<link [[_toyName + " 건네주기 (0:05)"|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"teddyBear", childid:_args[0], toyid:_toyid}>><</link>><</capture>> |
					<</if>>
				<<else>>
					<<humanChildActivityNoToy _args[0]>>
				<</if>>
			<<case "teddyBear2">>
				<<childhis>> <<print $childRecords[_args[0]].development.toy>> 옆에서 곤히 잠들어 있다.
			<<case "toyCar">>
				<<childtoy $location "toy cars" "notext">>
				<<if _toyid>>
					<<childHe>>【은는】 <<childtoy $location _toyid "lowercase">>【을를】 공중에 흔들고 있다.
					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<capture _toyid>><<link [[<<childhim>>【와과】 놀아준다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"toyCar", childid:_args[0], toyid:_toyid}>><</link>><</capture>> |
					<</if>>
				<<else>>
					<<humanChildActivityNoToy _args[0]>>
				<</if>>
			<<case "dummy">>
				<<childtoy $location "dummies" "notext">>
				<<if _toyid>>
					<<set _rng to random(1,4)>>
					<<childHe>>【은는】 <<childcry _rng>>. 근처 바닥에는 <<childtoy $location _toyid "lowercase">>【이가】 놓여 있다.
					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<capture _toyid _rng>><<link [[달랜다 (0:15)|Children Activity Events]]>><<pass 15>><<set $childActivityEvent to {event:"dummy", childid:_args[0], toyid:_toyid, childCry:_rng}>><</link>><</capture>> |
					<</if>>
				<<else>>
					<<humanChildActivityNoToy _args[0]>>
				<</if>>
			<<case "dummySucking">>
				<<childHe>>【은는】 <<childhis>> 공갈젖꼭지를 소리 내어 빨고 있다.
			<<case "clown">>
				<<childtoy $location "clown" "notext">>
				<<if _toyid>>
					<<childHe>>【은는】 미심쩍은 표정으로 <<childtoy $location _toyid "lowercase">>【을를】 바라보고 있다.
					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<capture _toyid>><<link [[<<childhim>>【와과】 놀아준다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"clown", childid:_args[0], toyid:_toyid}>><</link>><</capture>> |
					<</if>>
				<<else>>
					<<humanChildActivityNoToy _args[0]>>
				<</if>>
			<<case "clownHappy">>
				<<if _childTotalDays lt 199>>
					<<childHe>>【은는】 광대 인형과 당신을 번갈아 보며 즐겁게 놀고 있다.
				<<else>>
					<<childHe>>【은는】 광대 인형의 줄을 당겨 이따금 웃음소리가 나게 하며 즐겁게 놀고 있다.
				<</if>>
			<<case "Robin">>
				<<if getRobinLocation() isnot "orphanage" or $location is "alex_cottage">>
					<<childHe>>【은는】 행복하게 <<childhis>> 엄지를 빨고 있다.
				<<else>>
					로빈이 <<childhim>>【을를】 품에 안고 있다.
					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<link [[안아준다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"Robin", childid:_args[0]}>><</link>>
					<</if>>
				<</if>>
			<<case "Wraith">>
				<<childHe>>【은는】 웃으며 보이지 않는 무언가를 향해 손을 뻗고 있다.
				<br>
				<<link [[<<childhim>>【을를】 지켜본다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"Wraith", childid:_args[0]}>><</link>>
			<<default>>
				<<childHe>>【은는】 자신이 비디오 게임 속에 있다는 것을 알아차렸다 (이것은 오류입니다, 제보해 주세요).
				<<print $childRecords[_args[0]].development.activity>>
		<</switch>>
	</span>
<</widget>>

<<widget "humanChildActivityNoToy">>
	<<childHe>>【은는】 곤히 자고 있다.
	<<if $childRecords[_args[0]].development.event>>
		<br>
		<<link [[<<childhim>>【을를】 지켜본다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"shiverInCot", childid:_args[0]}>><<set $child_played.pushUnique(_args[0])>><</link>>
	<</if>>
<</widget>>

/*ToDo: Pregnancy Story Content: Lacking events. Wolf pups events which the place accesses by going to the childrens UI*/
<<widget "wolfChildActivity">>
	<span class="no-numberify">
		<<switch $childRecords[_args[0]].development.activity>>
			<<case "noEvent">>
				<<childHe>>【은는】 곤히 자고 있다.
			<<case "sleeping">>
				<<childHe>>【은는】 혼자 자고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[머리를 쓰다듬는다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"sleepingStroke", childid:_args[0]}>><</link>>
				<</if>>
			<<case "sleepingWithWolf">>
				<<childHe>>【은는】 다른 <<if $monster is 1>>늑대소녀<<else>>암컷 늑대<</if>> 품에 꼭 안겨서 깊이 잠들어 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[곁에 누워 껴안는다 (0:30)|Children Activity Events]]>><<pass 30>><<set $childActivityEvent to {event:"cuddleAndNap", childid:_args[0]}>><</link>>
				<</if>>
			<<case "crying">>
				<<childHe>>【은는】 불안해하며 <<childcry>>.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[<<childhim>>【을를】 달랜다 (0:15)|Children Activity Events]]>><<pass 15>><<set $childActivityEvent to {event:"cryingWolf", childid:_args[0]}>><</link>>
				<</if>>
			<<case "playing">>
				<<childHe>>【은는】 다른 새끼들과 놀고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[같이 논다 (0:15)|Children Activity Events]]>><<pass 15>><<set $childActivityEvent to {event:"playing", childid:_args[0]}>><</link>>
				<</if>>
			<<case "watchingCurious">>
				<<childHe>>【은는】 호기심 가득한 표정으로 당신을 쳐다보고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[호기심을 채워준다 (0:30)|Children Activity Events]]>><<pass 30>><<set $childActivityEvent to {event:"curiousGaze", childid:_args[0]}>><</link>>
				<</if>>
			<<case "watchingLonging">>
				<<childHe>>【은는】 무언가를 갈구하는 표정으로 당신을 바라보고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[귀를 긁어준다 (0:30)|Children Activity Events]]>><<pass 30>><<set $childActivityEvent to {event:"longingGaze", childid:_args[0]}>><</link>>
				<</if>>
			<<case "playFighting">>
				<<childHe>>【은는】 다른 새끼와 투닥거리며 놀고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[<<childhim>>【을를】 진정시킨다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"playFighting", childid:_args[0]}>><</link>>
				<</if>>
			<<case "staringOutside">>
				<<childHe>>【은는】 동굴 밖을 빤히 쳐다보고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[산책을 간다 (0:30)|Children Activity Events]]>><<pass 30>><<set $childActivityEvent to {event:"fieldTrip", childid:_args[0]}>><</link>>
				<</if>>
			<<case "grumpyWolf">>
				<<childHe>>【은는】 홀로 앉아 다가오는 모든 것을 향해 이빨을 딱딱거린다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[기분을 달래준다 (0:15)|Children Activity Events]]>><<pass 15>><<set $childActivityEvent to {event:"grumpyWolf", childid:_args[0]}>><</link>>
				<</if>>
			<<case "hungryWolf">>
				<<childHe>>【은는】 새끼들이 잔뜩 들러붙어 있는 암컷 <<wolf_cave_singular "f">> 앞에서 <<childcry>>.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[젖꼭지 찾는 걸 도와준다 (0:15)|Children Activity Events]]>><<pass 15>><<set $childActivityEvent to {event:"hungryWolf", childid:_args[0]}>><</link>>
				<</if>>
			<<case "gnawing">>
				<<switch random(1,4)>>
					<<case 1>><<set _pupToyText to "떨어진 사슴뿔">><<set $pupToy to "antler">>
					<<case 2>><<set _pupToyText to "사슴 뼈">><<set $pupToy to "bone">>
					<<case 3>><<set _pupToyText to "낡은 고무 장화">><<set $pupToy to "boot">>
					<<case 4>><<set _pupToyText to "마른 나뭇가지">><<set $pupToy to "stick">>
				<</switch>>
				<<childHe>>【은는】 _pupToyText【을를】 잘근잘근 씹고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[줄다리기를 한다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"gnawing", childid:_args[0]}>><</link>>
				<</if>>
			<<case "squeakyToy">>
				<<silently>><<childtoy $location "chew toys" "lowercase">><</silently>>
				<<if _toyName?.includes("squeaky")>>
					<<childHe>>【은는】 호기심 어린 눈빛으로 _toyName【을를】 쳐다보고 있다.

					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<capture _toyName>><<link [[삑삑이 장난감을 건넨다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"squeakyToy", childid:_args[0]}>><<set $phase to _toyName>><</link>><</capture>>
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<wolfChildActivity _args[0]>>
				<</if>>
			<<case "squeakyToy2">>
				<<silently>><<childtoy $location "chew toys" "lowercase">><</silently>>
				<<if _toyName?.includes("squeaky")>>
					<<childHe>>【이가】 _toyName【을를】 킁킁거리며 냄새를 맡더니, 조심스레 앞발로 툭툭 친다.

					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<capture _toyName>><<link [[_toyName 삑삑 소리를 낸다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"squeakyToy2", childid:_args[0]}>><<set $phase to _toyName>><</link>><</capture>>
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<wolfChildActivity _args[0]>>
				<</if>>
			<<case "chewRope">>
				<<silently>><<childtoy $location "chew toys" "lowercase">><</silently>>
				<<if _toyName?.includes("rope")>>
					<<childHe>>【은는】 알록달록한 밧줄 장난감을 씹고 있다.

					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<link [[줄다리기를 한다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"chewRope", childid:_args[0]}>><</link>>
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<wolfChildActivity _args[0]>>
				<</if>>
			<<case "chewRope2">>
				<<silently>><<childtoy $location "chew toys" "lowercase">><</silently>>
				<<if _toyName?.includes("rope")>>
					<<childHe>>【이가】 밧줄 냄새를 맡고는 시험 삼아 한번 살짝 깨물어본다.

					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<link [[밧줄을 당긴다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"chewRope2", childid:_args[0]}>><</link>>
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<wolfChildActivity _args[0]>>
				<</if>>
			<<case "chewBone">>
				<<silently>><<childtoy $location "chew toys" "lowercase">><</silently>>
				<<if _toyName?.includes("bone")>>
					<<if $childRecords[_args[0]].development.event>>
						<<childHe>>【은는】 구멍을 파려고 한다.
						<br>
						<<link [[파는 것을 돕는다 (0:20)|Children Activity Events]]>><<pass 20>><<set $childActivityEvent to {event:"chewBone", childid:_args[0]}>><</link>>
					<<else>>
						<<childHe>>【은는】 자기가 묻어둔 뼈다귀를 지키고 있다.
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<wolfChildActivity _args[0]>>
				<</if>>
			<<case "chewBone2">>
				<<silently>><<childtoy $location "chew toys" "lowercase">><</silently>>
				<<if _toyName?.includes("bone")>>
					<<childHe>>【이가】 뼈의 냄새를 맡더니 핥기 시작한다.

					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<link [[뼈를 살짝 건드린다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"chewBone2", childid:_args[0]}>><</link>>
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<wolfChildActivity _args[0]>>
				<</if>>
			<<case "rollBall">>
				<<silently>><<childtoy $location "chew toys" "lowercase">><</silently>>
				<<if _toyName?.includes("ball")>>
					<<childHe>>【이가】 코로 공을 밀어 당신 곁으로 가져온다.

					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<link [[공을 굴린다 (0:15)|Children Activity Events]]>><<pass 15>><<set $childActivityEvent to {event:"rollBall", childid:_args[0]}>><</link>>
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<wolfChildActivity _args[0]>>
				<</if>>
			<<case "rollBall2">>
				<<silently>><<childtoy $location "chew toys" "lowercase">><</silently>>
				<<if _toyName?.includes("ball")>>
					<<childHe>>【이가】 공을 코로 비비며 땅에 굴린다.

					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<link [[공을 던진다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"rollBall2", childid:_args[0]}>><</link>>
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<wolfChildActivity _args[0]>>
				<</if>>
			<<default>>
				<<childHe>>【은는】 자신이 비디오 게임 속에 있다는 사실을 알아챘다 (오류입니다. 제보해 주세요).
				<<print $childRecords[_args[0]].development.activity>>
		<</switch>>
	</span>
<</widget>>

<<widget "wolfChildActivityNoToy">>
	<<childHe>>【은는】 혼자 자고 있다.
	<<if $childRecords[_args[0]].development.event>>
		<br>
		<<link [[머리를 쓰다듬는다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"sleepingStroke", childid:_args[0]}>><</link>>
	<</if>>
<</widget>>

<<widget "hawkChildActivity">>
	<span class="no-numberify">
		<<switch $childRecords[_args[0]].development.activity>>
			<<case "noEvent">>
				<<childHe>>【은는】 곤히 자고 있다.
			<<case "sleeping">>
				<<childHe>>【은는】 혼자 자고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[머리를 쓰다듬는다 (0:10)|Children Activity Events]]>><<pass 10>><<set $childActivityEvent to {event:"sleepingStrokeHawk", childid:_args[0]} >><</link>>
				<</if>>
			<<case "sleepingWithGreatHawk">>
				<<npc "Great Hawk">>
				<<childHe>>【은는】 <<your_bird_text>>에게 바짝 안겨서 곤히 자고 있다.
				<<if $childRecords[_args[0]].development.event>>
					<br>
					<<link [[끌어안는다 (0:30)|Children Activity Events]]>>
						<<set _otherChildrenIds to []>>
						<<run getBornChildren().forEach(child => {
							if (child.development.location is $location and child.development.activity is "sleepingWithGreatHawk" and child.childId isnot T.args[0]) {
								T.otherChildrenIds.push(child.childId);
							}
						})>>
						<<pass 30>><<set $childActivityEvent to {event:"cuddleAndNapHawk", childid:_args[0], otherChildrenIds:_otherChildrenIds}>>
					<</link>>
				<</if>>
				<<endevent>>
			<<case "crying">>
				<<childHe>>【은는】 괴로운 듯 <<childcry>>.
				<<if $childRecords[_args[0]].development.event>>
					<br>
<<link "<<childhim>>【을를】 달랜다 (0:15)" "Children Activity Events">><<pass 15>><<set $childActivityEvent to {event:"cryingHawk", childid:_args[0]} >><</link>>
				<</if>>
			<<case "reaching">>
				<<childHe>>【은는】 당신을 향해 손을 뻗고 있다.
				<br>
<<link "<<childhim>>【을를】 안아 올린다 (0:15)" "Children Activity Events">><<pass 15>><<set $childActivityEvent to {event:"pickUpHawk", childid:_args[0]} >><</link>>
			<<case "flap">>
				<<childHe>>【은는】 작은 날개를 짧게 퍼덕이고 있다.
				<br>
<<link "<<childhim>>【이가】 나는 시늉을 하도록 돕는다 (0:15)" "Children Activity Events">><<pass 15>><<set $childActivityEvent to {event:"pretendFly", childid:_args[0]} >><</link>>
			<<case "preen">>
				<<childHe>>【은는】 불안한 듯 날개를 쪼아댄다.
				<br>
<<link "<<childhim>>【이가】 깃털을 다듬는 것을 돕는다 (0:15)" "Children Activity Events">><<pass 15>><<set $childActivityEvent to {event:"preen", childid:_args[0]} >><</link>>
			<<case "perch">>
				<<childHe>>【은는】 횃대를 응시하고 있다.
				<br>
<<link "<<childhim>>【을를】 횃대로 데려간다 (0:15)" "Children Activity Events">><<pass 15>><<set $childActivityEvent to {event:"perch", childid:_args[0]} >><</link>>
			<<case "bathe">>
				<<childHe>>【은는】 목욕이 필요해 보인다.
				<br>
<<link "<<childhim>>【을를】 씻긴다 (0:15)" "Children Activity Events">><<pass 15>><<set $childActivityEvent to {event:"bathe", childid:_args[0]} >><</link>>
			<<case "batheSelf">>
				<<childHe>>【은는】 고인 빗물에 다리를 담그고 있다.
				<br>
<<link "<<childhim>>【이가】 씻는 것을 돕는다 (0:15)" "Children Activity Events">><<pass 15>><<set $childActivityEvent to {event:"batheHelp", childid:_args[0]} >><</link>>
			<<case "lurkerEat">>
				<<childHe>>【은는】 
				<<if _childDays lte 180>>
					<<if $cmonster>>
						럴커 고기 조각을 우물거리고 있다.
					<<else>>
						럴커 고기 조각을 쪼고 있다.
					<</if>>
				<<else>>
					<<if $cmonster>>
						럴커를 씹고 있다.
					<<else>>
						럴커를 쪼고 있다.
					<</if>>
				<</if>>
			<<case "swingToy">>
				/* currently unreachable. credit writer as Anonymous when properly added */
				<<silently>><<childtoy $location "hawk toys" "lowercase">><</silently>>
				<<if _toyName?.includes("swing")>>
					<<childHe>>【은는】 그네 위로 기어오르려 하고 있다.

					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<link [[<<childhim>>【이가】 올라가게 돕는다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"swingToy", childid:_args[0]} >><</link>>
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<hawkChildActivity _args[0]>>
				<</if>>
			<<case "preeningToy">>
				/* currently unreachable. credit writer as mochamante when properly added */
				<<silently>><<childtoy $location "hawk toys" "lowercase">><</silently>>
				<<if _toyName?.includes("preening")>>
					<<if _childTotalDays lte 40>>
						<<childHe>>【은는】 어설프게 <<childhimself>>의 깃털을 다듬으려 하고 있다.
					<<else>>
						<<childHe>>【은는】 깃털 장난감을 바라보고 있다.
					<</if>>

					<<if $childRecords[_args[0]].development.event>>
						<br>
						<<link [[깃털 장난감을 준다 (0:05)|Children Activity Events]]>><<pass 5>><<set $childActivityEvent to {event:"preeningToy", childid:_args[0]} >><</link>>
					<</if>>
				<<else>>
					<<set $childRecords[_args[0]].development.activity to "sleeping">>
					<<hawkChildActivity _args[0]>>
				<</if>>
			<<default>>
				<<childHe>>【은는】 자신들이 비디오 게임 속에 있다는 걸 알아챘습니다 (이것은 오류입니다. 보고해 주세요).
				<<print $childRecords[_args[0]].development.activity>>
		<</switch>>
	</span>
<</widget>>

<<widget "childKrText">><<silently>>
	<!-- 
		자녀 화면(children.twee/pregnancy.twee/events.twee) 전용 통합 번역 위젯.
		child.features.* 에는 원문 영어 키(예: "tiny", "dark brown", "grey")가 그대로 저장되며,
		이 위젯은 출력 시점에만 한글로 변환한다 — 세이브에는 절대 번역문을 쓰지 않는다.
		사용법: <<childKrText "size"|"hair"|"eye"|"skin" _rawValue>>
	-->
	<<switch _args[0]>>
		<<case "size">>
			<<switch _args[1]>>
				<<case "tiny">><<set $_text_output to "아주 작음">>
				<<case "small">><<set $_text_output to "작음">>
				<<case "normal">><<set $_text_output to "보통">>
				<<case "large">><<set $_text_output to "큼">>
				<<default>><<set $_text_output to _args[1]>>
			<</switch>>
		<<case "hair">>
			<<set _childKrRecord to setup.guessColourInMap(setup.colours.hair_map, _args[1])>>
			<<set $_text_output to _childKrRecord ? _childKrRecord.name : _args[1]>>
		<<case "eye">>
			<<set _childKrRecord to setup.guessColourInMap(setup.colours.eyes_map, _args[1])>>
			<<set $_text_output to _childKrRecord ? _childKrRecord.name : _args[1]>>
		<<case "skin">>
			<<switch _args[1]>>
				<<case "light" "rlight" "ylight" "glight" "blight">><<set $_text_output to "밝은">>
				<<case "medium" "rmedium" "ymedium" "gmedium" "bmedium">><<set $_text_output to "보통">>
				<<case "dark" "rdark" "ydark" "gdark" "bdark">><<set $_text_output to "어두운">>
				<<case "ghostlyPale" "ghost">><<set $_text_output to "핏기 없이 창백한">>
				<<case "gyaru" "ygyaru" "rgyaru" "ggyaru" "bgyaru">><<set $_text_output to "보통">>
				<<default>><<set $_text_output to _args[1]>>
			<</switch>>
		<<default>>
			<<set $_text_output to _args[1]>>
	<</switch>>
	<</silently>><<print $_text_output>>
<</widget>>

