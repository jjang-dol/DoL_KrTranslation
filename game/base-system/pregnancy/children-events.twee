/*ToDo: Pregnancy Story Content: Lacking events. For events that can be picked when random events can be used during player action, say entering the wolf cave*/
:: ChildrenEvents [widget]

/* The whole bathe-the-child scene: shared intro, one of four flavours
   (gentle/shampoo/calm/tantrum), shared wrap-up, and the right prop for each.
   Optional arg picks the flavour; leave it out for a random one. */
<<widget "childBatheScene">>
	<<set _flavour to _args[0]>>
	<<if !_flavour>>
		<<rng 5>>
		<<switch $rng>>
			<<case 1>><<set _flavour to "gentle">>
			<<case 2>><<set _flavour to "shampoo">>
			<<case 3>><<set _flavour to "calm">>
			<<default>><<set _flavour to "tantrum">>
		<</switch>>
	<</if>>
	<<if _flavour is "shampoo" or _flavour is "calm">>
		<<wearProp "soap">>
	<<else>>
		<<wearProp "rag" "white">>
	<</if>>
	당신은 작은 욕조에 따뜻한 물을 채우고 수건과 새 기저귀를 미리 준비해 둔다. 조심스럽게 <<childname>>【을를】 안아 들고 욕조로 데려가 안전한 자세로 눕힌다.
	<br><br>
	<<switch _flavour>>
		<<case "gentle">>
			그런 다음 한 손으로 <<childhis>> 작은 몸을 잡고, 피부 주름 사이사이를 꼼꼼히 닦으며 따뜻한 물로 <<childname>>【을를】 부드럽게 문질러 씻긴다. 문지를 때 느껴지는 <<childhis>> 부드러운 피부에 당신은 무척이나 편안해진다. 아기는 당신의 손길이 간지러운지 물장구를 치고, 그 물이 당신의 옷과 얼굴로 튄다. 당신은 이 상황에 절로 미소가 지어진다.<<ltrauma>><<trauma -6>>
		<<case "shampoo">>
			그런 다음 유아용 샴푸를 한 움큼 덜어내어 <<childname>>의 머리를 둥글게 원을 그리며 부드럽게 문지른다. 달콤한 딸기 향이 주변을 채우고 물 위에 거품이 일기 시작한다. 아이는 신기한 듯 틈틈이 <<childhis>> 손가락으로 거품을 콕콕 찔러 터뜨린다. <<childhe>>【이가】 욕조의 거품에 정신이 팔린 사이, <<childHis>> 부드러운 웃음소리가 방 안에 울려 퍼진다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
		<<case "calm">>
			그런 다음 아기의 몸에 비누칠을 시도하며 목욕을 시작한다. <<childHe>>【은는】 당신이 <<childhim>>【을를】 씻기려는 걸 즐기기는커녕, 피부에 물이 닿는 느낌조차 싫은 기색이다. 계속 씻기려 하자 <<childname>>【이가】 울음을 터뜨리려 하지만, 당신은 약간의 실랑이 끝에 간신히 <<childhim>>【을를】 진정시킨다. <<childHe>>【은는】 목욕이 끝날 때까지 불만스레 입을 삐죽인다. 목욕을 마친 후, <<childhe>>【은는】 당신이 <<childhim>>【을를】 안고 돌아가는 것도 싫은지, 당신이 들어 올릴 때마다 칭얼거리는 소리를 낸다.<<gstress>><<stress 6>>
		<<case "tantrum">>
			물에 닿자마자 <<childname>>【이가】 끊임없이 날카로운 울음을 터뜨린다. 당신이 제대로 씻겨보려 애쓰는 동안, <<childHe>>【은는】 어떻게든 빠져나가려고 물속에서 <<childhis>> 팔다리를 격렬하게 버둥거린다. 사방으로 튄 물에 당신의 옷이 순식간에 젖어버린다. <<childHe>>【은는】 목욕이 끝날 때까지 발버둥을 치며 떼를 썼고, 결국 당신에게 두통만을 안겨주었다.<<gstress>><<stress 6>>
		<<default>>
			<<run console.warn("childBatheScene: unexpected bath flavour: " + _flavour)>>
	<</switch>>
	<br><br>
	<<childhim>>의 목욕을 마친 후, 당신은 수건 위에 <<childhim>>【을를】 눕히고 더 부드러운 천으로 <<childhis>> 몸의 물기를 살살 닦아준다. 기저귀를 갈아입히고 <<childhim>>【을를】 다시 요람에 눕히며 조심스럽게 목욕 시간을 마무리한다.
	<</widget>>

/*args[0] - location, args[1] - passageExit*/
	<<widget "childrenEvents">>
	<<if _args[0]>>
		<<if _args[0] is "tower">>
			<<getChildrenIds `{location: _args[0], excludeUnhatched: true}` "both">>
		<<else>>
			<<getChildrenIds `{location: _args[0]}`>>
		<</if>>
		<<if _childrenIds.length gt 0>>
			<<set _singleEvents to true>>
		<</if>>
		<!-- Rework these later, they make no sense. Why can't children of different birth IDs interact? -->
		<<if _args[0] is "tower">>
			<<getSameBirthChildrenIds _args[0] 2 undefined "both">>
		<<else>>
			<<getSameBirthChildrenIds _args[0] 2>>
		<</if>>
		<<if Object.keys(_birthChildrenIds).length gt 0>>
			<<set _multipleEvents to true>>
		<</if>>
		<<set _keys to Object.keys(_birthChildrenIds)>>
		<<set $childPassageExit to _args[1]>>
		<<switch _args[0]>>
			<<case "home">>
				<<if _singleEvents is true and (_multipleEvents is false or random(0,100) gt 40)>>
					<<addevent `"homeSingles " + _childrenIds[random(0,_childrenIds.length - 1)]`>>
				<<elseif _multipleEvents is true>>
					<<set $childrenIds to _birthChildrenIds[_keys.random()]>>
					<<addevent `"homeMultiples " + _args`>>
				<</if>>
			<<case "wolf_cave">>
				<<if _singleEvents is true and (_multipleEvents is false or random(0,100) gt 40)>>
					<<addevent `"wolfCaveSingles " + _childrenIds[random(0,_childrenIds.length - 1)]`>>
				<<elseif _multipleEvents is true>>
					<<set $childrenIds to _birthChildrenIds[_keys.random()]>>
					/*<<addevent "wolfCaveMultiple _args">>*/
				<</if>>
			<<case "tower">>
				<<if _singleEvents is true and (_multipleEvents is false or random(0,100) gt 40)>>
					<<addevent `"hawkSingles " + _childrenIds[random(0,_childrenIds.length - 1)]`>>
				<<elseif _multipleEvents is true>>
					<<set $childrenIds to _birthChildrenIds[_keys[random(0,_keys.length - 1)]]>>
					<<addevent `"hawkMultiples " + _args`>>
				<</if>>
		<</switch>>
	<</if>>
<</widget>>

<<widget "homeSingles">>
	<<if _args[0] isnot undefined>>
		<<childSelect _args[0]>>
		<<switch random(0,0)>>
			<<case 0>>
				당신의 아이 <<childname>>【이가】 등을 대고 누운 채, 당신을 향해 <<childhis>> <<childhands>>【을를】 뻗고 바라보는 모습을 발견한다.
				<br><br>
				당신이 <<childhim>>【을를】 안아주자, <<childhe>>【은는】 당신의 얼굴을 비비며 <<childgiggles>>.
				<br><br>
				<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
					<<link [[모유를 먹인다 (0:30)|childBreastFeed]]>><<pass 30>><</link>>
					<br>
				<</if>>
				<<link [[껴안는다 (0:30)|childCuddle]]>><<pass 30>><</link>>
				<br>
				<<link [[말을 건다 (0:15)|childTalk]]>><<pass 15>><</link>>
				<br>
				<<link [[놀아준다 (0:30)|childPlay]]>><<pass 30>><</link>>
				<br>
				<<link [[목욕시킨다 (0:30)|childBathe]]>><<pass 30>><</link>>
		<</switch>>
	<</if>>
	<br>
<</widget>>

<<widget "homeMultiples">>
	<<if $childrenIds>>
		<<switch random(0,0)>>
			<<case 0>>
				아이들인 <<childrenNames $childrenIds>>【이가】 요람 안에서 평온한 표정으로 함께 잠들어 있는 것을 발견한다.
				<br><br>
				<<link [[지켜보기 (0:30)|childCotWatch]]>><<stress -2>><<trauma -2>><<pass 30>><<set $phase to 1>><</link>><<lstress>><<ltrauma>>
				<br>
				<<link [[낮잠 자기 (0:30)|childCotWatch]]>><<stress -2>><<tiredness -2>><<pass 30>><<set $phase to 2>><</link>><<lstress>><<ltiredness>>
		<</switch>>
	<</if>>
<</widget>>

<<widget "wolfCaveSingles">>
	<<if _args[0] isnot undefined>>
		<<childSelect _args[0]>>
		<<set _c to $childRecords[_args[0]]>>
		<<set _cPregnancy to getPregnancyOf(_c)>>
		<<set _hurtEligible to ["wolf","wolfboy","wolfgirl"].includes(_c.species) and (_cPregnancy.carrier is "Black Wolf" or _cPregnancy.donor is "Black Wolf")>>
		<<set _scene to 0>>
		<<if _hurtEligible>>
			<<set _scene to random(0,1)>>
		<</if>>
		<<switch _scene>>
			<<case 0>>
				당신의 <<childtype>>인 <<childname>>【이가】 잠든 <<wolf_cave_singular>> 위에 누운 채로, 당신을 향해 <<childhis>> <<childhands>>【을를】 뻗으며 쳐다보는 것을 발견한다.
				<br><br>
				당신이 <<childhim>>【을를】 들어 올리자, <<childhe>>【은는】 당신의 얼굴에 비비적거리며 <<childgiggles>>.
				<br><br>
				<<if $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
					<<link [[수유하기 (0:30)|childBreastFeed]]>><<pass 30>><</link>>
					<br>
				<</if>>
				<<link [[껴안기 (0:30)|childCuddle]]>><<pass 30>><</link>>
				<br>
				<<link [[이야기한다 (0:15)|childTalk]]>><<pass 15>><</link>>
				<br>
				<<link [[놀아주기 (0:30)|childPlay]]>><<pass 30>><</link>>
			<<case 1>>
				<<childHe>>【은는】 다른 늑대들에게 으르렁거리는 검은 늑대 곁에서 낑낑거리고 있다.
				<br><br>
				<<link [[살펴보기 (0:10)|Wolf Cave Hurt Pup]]>><<pass 10>><</link>>
		<</switch>>
	<</if>>
	<br>
<</widget>>

<<widget "hawkSingles">>
	<<if _args[0] isnot undefined>>
		<<childSelect _args[0]>>
		<<switch random(0,2)>>
			<<case 0 1>>
				당신은 둥지에 누워 당신을 바라보며 <<childhis>> <<childhands>>【을를】 뻗는 당신의 <<childtype>> <<childname>>【을를】 발견한다.
				<br><br>
				<<childhim>>【을를】 안아 올리자, <<childhe>>【은는】 <<childgiggles>>하며 마구 버둥거린다.
				<br><br>

				<<if $cmonster is 1 and $lactating is 1 and $settings.breastFeedingEnabled and $milk_amount gte 1>>
					<<link [[모유를 먹인다 (0:30)|childBreastFeed]]>><<pass 30>><</link>>
					<br>
				<</if>>
				<<link [[껴안는다 (0:30)|childCuddle]]>><<pass 30>><</link>>
				<br>
				<<link [[대화한다 (0:30)|childTalk]]>><<pass 30>><</link>>
				<br>
				<<link [[놀아준다 (0:30)|childPlay]]>><<pass 30>><</link>>
			<<case 2>>
				당신은 둥지에서 뒹구는 <<childname>>【을를】 본다. <<childhe>>【은는】 당신을 발견하자마자 몸을 바로 세우고 <<childgiggles>>. <<childHe>>【은는】 당신을 봐서 기쁜 것 같다! <<stress -12>><<llstress>>
				<br><br>

				<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>
				<br>
		<</switch>>
	<</if>>
	<br>
<</widget>>

<<widget "hawkMultiples">>
	<<if $childrenIds>>
		<<switch random(0,0)>>
			<<case 0>>
				당신은 <<childrenNames $childrenIds>>【이가】 서로의 위를 구르며 뒤엉켜 있는 것을 발견한다.
				<<set _child1 to _childrenIds.pluck()>>
				<<set _child2 to _childrenIds.pluck()>>
				녀석들은 이따금 행동을 멈추고 서로를 빤히 쳐다본다. 잠시 후, <<childname _child1>>【이가】 <<childSelect _child2>><<childname>> 뒤로 다가가 <<childhim>>【을를】 핥아주기 시작한다.
				<br><br>

				<<link [[다음|$childPassageExit]]>><<unset $childrenIds>><<unset $childPassageExit>><<endevent>><</link>>
				<br>
		<</switch>>
	<</if>>
<</widget>>

:: Wolf Cave Hurt Pup
<<set _hurtPupId to $childSelected.childId>>
<<effects>><<clearsinglenpc 0>><<npc "Black Wolf">>
<<childSelect _hurtPupId>>

당신은 살펴보기로 하고 검은 늑대 곁에서 낑낑거리는 당신의 <<childtype>>【을를】 발견한다. 검은 늑대는 공격적인 기색으로 다가오려는 다른 늑대들에게 으르렁거린다. <<bHe>>【은는】 당신에게도 으르렁거리지만, 당신임을 알아채자 이내 조금 진정한다.
<br><br>

<<if $monster is 1>>

	"<<childHe>>【이가】 다쳤어." <<bHe>>【이가】 당신의 <<childtype>>【을를】 가리키며 말한다. "넘어졌어." <<bHe>>【은는】 집요하게 동굴 바닥의 무언가를 가리킨다. 당신의 <<childtype>>에게서 멀지 않은 곳에 뾰족한 바위가 놓여 있다.
	<br><br>

	당신은 무릎을 꿇고 당신의 <<childtype>>【을를】 살핀다. <<childhis>> 발에 긁힌 상처가 있다. 심각하진 않지만 어린 새끼에겐 아플 것이다. 검은 늑대는 둘을 빤히 지켜본다.
	<br><br>

	당신은 가진 것을 동원해 최대한 상처를 닦아주고, 당신의 <<childtype>>【은는】 낑낑거림을 멈춘다. <<childHe>>【은는】 당신에게 몸을 비비며 당신의 손을 핥는다. <<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
	<br><br>

	검은 늑대가 다시 동굴 밖으로 물러날 때까지 셋은 말없이 함께 시간을 보낸다.

<<else>>

	검은 늑대는 동굴 바닥의 무언가로 고개를 돌리며 계속해서 거칠게 콧김을 내뿜는다. <<bHe>>【은는】 당신이 보기를 원한다. 당신의 <<childtype>>【이가】 있는 곳에서 멀지 않은 곳에 뾰족한 바위가 있는 것을 발견한다.
	<br><br>

	당신은 무릎을 꿇고 당신의 <<childtype>>【을를】 살핀다. <<childhis>> 발에 긁힌 상처가 있다. 심각하진 않지만 어린 새끼에겐 아플 것이다. 검은 늑대는 둘의 주위를 맴돈다.
	<br><br>

	당신은 가진 것을 동원해 최대한 상처를 닦아주고, 당신의 <<childtype>>【은는】 낑낑거림을 멈춘다. <<childHe>>【은는】 당신에게 몸을 비비며 당신의 손을 핥는다. <<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
	<br><br>

	검은 늑대가 다시 동굴 밖으로 물러날 때까지 셋은 말없이 함께 시간을 보낸다.

<</if>>
<br><br>

<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childBreastFeed
<<set $pregnancyStats.childBreastfedInteractions++>>
<<if $worn.over_upper.name isnot "naked" or $worn.upper.name isnot "naked" or $worn.upper.name isnot "naked">>
	당신은 <<childhim>>에게 <<breasts>>【을를】 물릴 수 있도록 옷을 바로잡는다.
<<else>>
	당신은 아기의 입술을 가슴에 가져다 댄다.
<</if>>
<br><br>
<<set _rng to random(1, 4)>>
<<switch _rng>>
	<<case 1>>
		<<childHe>>【은는】 당신의 의도를 알아차린 듯 눈을 감은 채 당신의 <<print ["왼쪽","오른쪽"].pluck()>> 가슴을 빤다.<<breastfeed 25>>
	<<case 2>>
		<<childHe>>【은는】 당신의 젖꼭지를 찾는 데 잠시 시간이 걸린다. <<childHe>>【은는】 젖꼭지를 물고 빨기 시작한다. 당신은 아기가 젖을 마시는 것을 보며 평온한 순간을 즐긴다.<<lstress>><<stress -6>><<breastfeed 20>>
	<<case 3>>
		<<childHe>>【은는】 당신의 젖꼭지를 물고 놀라울 정도로 열심히 빨기 시작한다. <<childhis>> 빠는 힘에 당신은 곧 불편함을 느낀다. 젖꼭지가 곧 쓰라려온다.<<gpain>><<pain 4>><<breastfeed 30>>
	<<default>>
		<<childHe>>【은는】 당신의 젖꼭지를 <<childhis>> 입에 무는 것을 거부하며, <<childhis>> 머리를 돌리고 이전보다 더 크게 운다.<<gstress>><<stress 6>>
<</switch>>
<br><br>

<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childCuddle
<<set _rng to random(1, 5)>>
<<switch $childRecords[$childSelected.childId].species>>
	<<case "human">>
		<<switch _rng>>
			<<case 1>>
				<<childHe>>【은는】 당신의 의도를 알아차린 듯, 어깨에 기대며 <<childhis>> <<childhands>>【으로로】 당신의 목을 감싼다.
			<<case 2>>
				당신은 곡조에 맞춰 부드럽게 몸을 흔들며 <<childname>>의 등을 문지르면서, 선율적인 자장가를 흥얼거린다. 당신의 익숙한 목소리가 <<childhis>> 기분을 진정시키는 것 같다. <<childHe>>【이가】 당신에게 옹알거린다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
			<<case 3>>
				당신은 <<childhis>> 이마에 부드럽게 입을 맞추고, 최대한 <<childhim>>【와과】 피부를 맞댄다. 그 행동에 <<childhim>>【은는】 고개를 들고 당신에게 미소로 보답한다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
			<<case 4>>
				당신은 <<childname>>에게 볼 만한 여러 물건을 준다. 당신은 주위에서 보이는 것들의 색, 모양, 질감을 설명해준다. <<childHe>>【은는】 <<childhis>> 환경을 탐색하고 싶어 손을 뻗는다. 당신은 <<childhe>>【이가】 너무 무겁거나 다루기 힘든 것을 잡으려 하지 않도록 살핀다.<<gstress>><<stress 6>>
			<<default>>
				<<childHe>>【은는】 안기는 것에 저항하며 <<childhe>>【이가】 <<childhis>> 다리를 찬다. 당신이 <<childhim>>【을를】 오래 안고 있을수록, <<childhis>> 울음소리는 더 격렬해진다. 몇 번은 제대로 맞는다.<<gpain>><<gstress>><<pain 4>><<stress 6>>
		<</switch>>
	<<case "wolf" "wolfboy" "wolfgirl">>
		<<switch _rng>>
			<<case 1>>
				<<if $cmonster is 1>>
					<<childHe>>【은는】 당신의 의도를 알아차린 듯, 어깨에 기대며 <<childhis>> <<childhands>>【으로로】 당신의 목을 감싼다.
				<<else>>
					<<childHe>>【은는】 당신의 의도를 알아차린 듯, 목덜미에 파고든다.
				<</if>>
			<<case 2>>
				당신은 곡조에 맞춰 부드럽게 몸을 흔들며 <<childname>>의 등을 문지르면서, 선율적인 자장가를 흥얼거린다. 당신의 익숙한 목소리가 <<childhis>> 기분을 진정시키는 것 같다. <<childHe>>【이가】 당신에게 옹알거린다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
			<<case 3>>
				<<if $cmonster is 1>>
					당신은 <<childhis>> 이마에 부드럽게 입을 맞추고, 최대한 <<childhim>>【와과】 피부를 맞댄다. 그 행동에 <<childhim>>【은는】 고개를 들고 당신에게 미소로 보답한다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
				<<else>>
					당신은 <<childhis>> 이마에 부드럽게 입을 맞추고, 최대한 <<childhim>>【와과】 피부와 털을 맞댄다. 그 행동에 <<childhim>>【은는】 고개를 들고 당신에게 <<childhis>> 혀를 내민다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
				<</if>>
			<<case 4>>
				당신은 <<childname>>에게 볼 만한 여러 물건을 준다. 당신은 주위에서 보이는 것들의 색, 모양, 질감을 설명해준다. <<childHe>>【은는】 <<childhis>> 입으로 나뭇가지를 집어 들고 흔들기 시작한다. 당신은 <<childhe>>【이가】 너무 무겁거나 다루기 힘든 다른 것을 잡으려 하지 않도록 살핀다.<<gstress>><<stress 6>>
			<<default>>
				<<childHe>>【은는】 안기는 것에 저항하며 <<childhe>>【이가】 <<childhis>> 다리를 찬다. 당신이 <<childhim>>【을를】 오래 안고 있을수록, <<childhis>> 울음소리는 더 격렬해진다. 몇 번은 제대로 맞는다.<<gpain>><<gstress>><<pain 4>><<stress 6>>
		<</switch>>
	<<case "hawk">>
		<<switch _rng>>
			<<case 1>>
				<<if $cmonster is 1>>
					<<childHe>>【은는】 당신의 의도를 알아차린 듯, 어깨에 기대며 <<childhis>> <<childhands>>【으로로】 당신의 목을 감싼다.
				<<else>>
					<<childHe>>【은는】 당신의 의도를 알아차린 듯, 목덜미에 파고든다.
				<</if>>
			<<case 2>>
				당신은 곡조에 맞춰 부드럽게 몸을 흔들며 <<childname>>의 등을 문지르면서, 선율적인 자장가를 흥얼거린다. 당신의 익숙한 목소리가 <<childhis>> 기분을 진정시키는 것 같다. <<childHe>>【이가】 당신에게 옹알거린다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
			<<case 3>>
				<<if $cmonster is 1>>
					당신은 <<childhis>> 이마에 부드럽게 입을 맞추고, 최대한 <<childhim>>【와과】 피부를 맞댄다. 그 행동에 <<childhim>>【은는】 고개를 들고 당신에게 미소로 보답한다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
				<<else>>
					당신은 <<childhis>> 이마에 부드럽게 입을 맞추고, 최대한 <<childhim>>【와과】 피부와 깃털을 맞댄다. 그 행동에 <<childhim>>【은는】 고개를 들고 당신에게 짹짹거린다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
				<</if>>
			<<case 4>>
				당신은 <<childname>>에게 볼 만한 여러 재료를 준다. 당신은 주위에서 보이는 것들의 색, 모양, 질감을 설명해준다.
				<<if $cmonster is 1>>
					<<childHe>>【은는】 <<childhis>> 주변을 탐색하고 싶은 듯 손을 뻗는다. <<childHe>>【은는】 천 조각을 붙잡는다.
				<<else>>
					<<childHe>>【은는】 당신이 <<childhim>>에게 보여주는 천 조각을 쪼려고 부리를 뻗는다. <<childHe>>【은는】 당신에게서 그것을 빼앗는 데 성공한다.
				<</if>>
				그리고 그것을 마구 흔들기 시작한다. <<childHe>>【은는】 <<childgiggles>>. 하지만 당신은 <<childhe>>【이가】 다른 것을 잡으려 하지 않도록 살핀다. <<gstress>><<stress 6>>
			<<default>>
				<<if $cmonster is 1>>
					<<childHe>>【은는】 안기는 것에 저항하며 <<childhe>>【이가】 <<childhis>> 다리를 찬다. 당신이 <<childhim>>【을를】 오래 안고 있을수록, <<childhis>> 울음소리는 더 격렬해진다. 몇 번은 제대로 맞는다.<<gpain>><<gstress>><<pain 4>><<stress 6>>
				<<else>>
					<<childHe>>【은는】 안기는 것에 저항하다가 당신의 손아귀에서 빠져나간다. <<childHe>>【은는】 둥지 안으로 무사히 떨어지지만, 그 행동에 당신은 깜짝 놀란다. <<ggstress>><<stress 12>>
				<</if>>
		<</switch>>
	<<default>>
		<span class="red">Childtype $childRecords[$childSelected.childId].species를 찾을 수 없습니다. 버그입니다.</span>
<</switch>>
<br><br>

<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childCotWatch
<<childSelect `$childrenIds[random(0,$childrenIds.length - 1)]`>>
<<if $phase is 1>>
	당신은 <<childrenNames $childrenIds>> 곁에 서서 잠든 모습을 지켜본다.
	<<set _rng to random(1, 4)>>
	<<switch _rng>>
		<<case 1>>
			얌전한 숨소리에 맞춰 오르내리는 <<childname>>의 가슴에서 눈을 뗄 수 없다.
		<<case 2>>
			어느새 아이들의 머리를 하나씩 쓰다듬고 있다.
		<<case 3>>
			<<childname>>【은는】 <<childhis>> 입을 크게 벌려 하품을 하고 기지개를 켠다.<<lstress>><<stress -6>>
		<<default>>
			<<childname>>【은는】 나쁜 꿈이라도 꾸는 듯, 웅얼거리며 <<childhis>> 얼굴을 찡그린다.<<gstress>><<stress 6>>
	<</switch>>
	<br><br>
<<elseif $phase is 2>>
	당신은 낮잠을 자기로 하고 아이들 옆 침대에 눕는다.
	<br><br>
	얼마 후 잠에서 깨자 손가락에 무언가 감겨 있다. 아직 잠든 채로, <<childname>>의 <<childhand>>【이가】 당신에게 닿은 모양이다.
	<br><br>
<</if>>

<<link [[다음|$childPassageExit]]>><<unset $childrenIds>><<unset $childPassageExit>><<endevent>><</link>>

:: childTalk
<<set _rng to random(1, 4)>>
<<switch $childRecords[$childSelected.childId].species>>
	<<case "human">>
		<<switch _rng>>
			<<case 1>>
				당신은 옛 기억을 떠올려 동요 몇 곡을 흥얼거려 준다. 당신의 목소리를 듣는 <<childhe>>의 눈빛이 또렷해진다. 목소리 톤을 몇 번 바꾸어 보며 <<childhis>> 반응을 살핀다. 특정 소리를 알아듣고 그에 맞춰 표정을 바꾸는 듯하다. 잠시 후, <<childhe>>【은는】 시선을 돌리더니 엄지손가락을 빤다.
			<<case 2>>
				당신은 <<childname>>의 오른발을 부드럽게 감싸 쥐고 발가락을 꼼지락거리며 센 다음, 반대쪽 발로 넘어간다. 손가락을 발가락 하나하나로 옮겨갈 때마다 <<childhe>>【은는】 눈을 크게 뜬 채 당신을 지켜보며 얌전해진다.
			<<case 3>>
				당신은 <<childname>>에게 말을 걸며, 당신의 생각을 나누고 반응을 기다린다. 하지만 <<childHe>>【은는】 별로 주의를 기울이지 않는 것 같다.<<gstress>><<stress 6>>
			<<default>>
				당신은 <<childname>>에게 말을 걸지만, <<childhis>> 울음소리에 당신의 말이 묻힌다. 당신이 <<childhim>>에게 말을 걸려고 애쓰는 동안, <<childHis>> 얼굴은 점점 더 붉어진다.<<gstress>><<stress 6>>
		<</switch>>
	<<case "wolf" "wolfboy" "wolfgirl">>
		<<switch _rng>>
			<<case 1>>
				당신은 오래전에 기억하던 동요 몇 가지를 읊어준다. <<childHe>>【은는】 당신의 목소리를 들으며 귀를 기울인다. 당신은 몇 가지 다른 톤으로 노래하며 <<childhis>> 반응을 기다린다. <<childhe>>【은는】 특정 소리를 알아듣고 그에 따라 <<childhis>> 표정을 바꾸는 것 같다. 잠시 후, 당신을 향해 <<childhis>> 고개를 갸웃거린다.
			<<case 2>>
				당신은 <<childname>>의
				<<if $cmonster is 1>>
					오른발을 부드럽게 감싸고 <<childhis>> 발가락 수를 센다. 발가락들을 꼼지락거리게 한 뒤, <<childhis>> 다른 쪽 발로 넘어간다. <<childHe>>【은는】 조용해져서, 당신이 손가락을 이 발가락에서 저 발가락으로 옮기는 것을 동그란 눈으로 지켜본다.
				<<else>>
					오른쪽 앞발을 부드럽게 감싸고 <<childhis>> 발가락 수를 센다. 발가락들을 꼼지락거리게 한 뒤, <<childhis>> 다른 쪽 발로 넘어간다. <<childHe>>【은는】 조용해져서, 당신이 손가락을 이 발가락에서 저 발가락으로 옮기는 것을 동그란 눈으로 지켜본다.
				<</if>>
			<<case 3>>
				당신은 <<childname>>에게 말을 걸며, 당신의 생각을 나누고 반응을 기다린다. 하지만 <<childHe>>【은는】 별로 주의를 기울이지 않는 것 같다.<<gstress>><<stress 6>>
			<<default>>
				당신은 <<childname>>에게 말을 걸지만, 입을 열 때마다 <<childhe>>【은는】 당신에게 작게 짖는다. <<childHe>>【은는】 당신의 다리에 머리를 들이받고는, 등을 돌린다.
		<</switch>>
	<<case "hawk">>
		<<switch _rng>>
			<<case 1>>
				당신은 오래전에 기억하던 동요 몇 가지를 읊어준다. <<childHe>>【은는】 당신의 목소리를 들으며 귀를 기울인다. 당신은 몇 가지 다른 톤으로 노래하며 <<childhis>> 반응을 기다린다. <<childhe>>【은는】 특정 소리를 알아듣는 것 같다. 잠시 후, 당신을 향해 <<childhis>> 고개를 갸웃거린다.
			<<case 2>>
				당신은 <<childname>>의
				<<if $cmonster is 1>>
					오른발을 부드럽게 감싸고 <<childhis>> 발가락 수를 센다. 발가락들을 꼼지락거리게 한 뒤, <<childhis>> 다른 쪽 발로 넘어간다. <<childHe>>【은는】 조용해져서, 당신이 손가락을 이 발가락에서 저 발가락으로 옮기는 것을 동그란 눈으로 지켜본다.
				<<else>>
					오른쪽 다리를 부드럽게 감싸고 <<childhis>> 발톱 수를 센다. 발톱들을 꼼지락거리게 한 뒤, <<childhis>> 다른 쪽 다리로 넘어간다. <<childHe>>【은는】 조용해져서, 당신이 손가락을 이 발톱에서 저 발톱으로 옮기는 것을 지켜본다.
				<</if>>
			<<case 3>>
				당신은 <<childname>>에게 말을 걸며, 당신의 생각을 나누고 반응을 기다린다. 하지만 <<childHe>>【은는】 별로 주의를 기울이지 않는 것 같다.<<gstress>><<stress 6>>
			<<default>>
				당신은 <<childname>>에게 말을 걸지만, 입을 열 때마다 <<childhe>>【은는】 당신에게 작게 짹짹거린다. <<childHe>>【은는】 당신의 다리에 머리를 들이받고는, 등을 돌린다.
		<</switch>>
	<<default>>
		<span class="red">Childtype $childRecords[$childSelected.childId].species를 찾을 수 없습니다. 버그입니다.</span>
<</switch>>
<br><br>

<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childPlay
<<set _rng to random(1, 6)>>
<<switch _rng>>
	<<case 1>>
		당신은 <<childname>>【을를】 내려다보며 미소 짓는다. 손을 흔들고 혀를 내밀며, <<childhis>> 관심을 끌기 위해 여러 가지 표정을 지어 보인다. <<childHe>>【은는】 호기심을 갖고 당신의 표정을 살핀다. <<childHe>>【은는】 당신을 따라 하려는 것 같지만, 그저 반사적인 행동인지 확신할 수 없다.
	<<case 2>>
		당신은 <<childname>>의 <<childfeet>>【을를】 <<childhis>> <<childhands>>에 가져다 대고 움직여주며, 가끔씩 박수를 치게 한다. 당신은 <<childhis>> 발가락부터 등, 손가락 끝까지 작은 몸을 부드럽게 마사지해준다. 애정 어린 손길에 당신이 활짝 웃자, <<childHe>>【은는】 미소로 화답한다.
	<<case 3>>
		양손으로 얼굴을 가렸다가, 몇 초 뒤에 손을 뗀다. <<childname>>【이가】 당신을 올려다본다. 눈이 마주치자 <<childHe>>【이가】 미소 짓는다.<<lstress>><<stress -6>>
	<<case 4>>
		당신은 <<childname>>【을를】 간지럽히고 <<childhis>> 배에 입을 대고 부르르 소리를 낸다. 그러자 <<childHe>>【은는】 울음을 멈추고 대신 <<childgiggles>>하며, 기쁨에 겨워 <<childhis>> 팔다리를 버둥거린다.<<lstress>><<stress -6>>
	<<case 5>>
		당신은 <<childname>>【을를】 간지럽히고 <<childhis>> 배에 입을 대고 부르르 소리를 낸다. <<childhe>>【이가】 고개를 좌우로 돌리며 몸부림치자 <<childHis>> 울음소리가 더 커진다. <<childHe>>【은는】 이런 장난이 마음에 들지 않는 것 같다.<<gstress>><<stress 6>>
	<<default>>
		당신은 <<childhe>>【이가】 당신의 얼굴과 이목구비를 살필 수 있도록 <<childname>>에게 더 가까이 다가간다. <<childHe>>【은는】 잠시 울음을 멈추는가 싶더니, 당신의 머리카락을 잡아당긴다.<<gpain>><<pain 4>>
<</switch>>
<br><br>

<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: childBathe
<<childBatheScene>>
<br><br>

<<childhim>>【을를】 다 씻기고 나면, <<childhim>>【을를】 수건 위에 눕히고 더 부드러운 천으로 <<childhis>> 몸을 부드럽게 말려준다. 당신은 아기의 기저귀를 갈아주고 <<childhim>>【을를】 다시 <<childhis>> 침대에 눕혀주며 조심스럽게 마무리한다.
<br><br>

<<link [[다음|$childPassageExit]]>><<unset $childPassageExit>><<endevent>><</link>>

:: Childrens Home
<<effects>>
<<getChildrenIds `{location: $location}`>>
<<switch $location>>
	<<case "home">>
		당신은 고아원 육아실에 있다. 주위에는 요람과 아기 침대가 몇 개 흩어져 있다.
	<<case "wolf_cave">>
		<<switch Time.dayState>>
			<<case "dawn">>
				많은 새끼 늑대들이 아직 잠들어 있다.
			<<case "day">>
				어린 새끼 늑대들이 장난치며 내는 낑낑거리는 소리, 으르렁거리는 소리, 작은 울음소리가 바위벽에 메아리친다.
			<<case "dusk">>
				대부분의 새끼 늑대들은 이미 밤을 보낼 준비를 마쳤다.
			<<case "night">>
				새끼 늑대들이 모두 잠들어 굴 안은 조용하다.
		<</switch>>
	<<case "alex_cottage">>
		당신은 오두막 육아실에 있다.
		<<switch Time.dayState>>
			<<case "dawn">>
				이른 아침 새들이 지저귀는 소리가 방 안을 평온하게 만든다.
			<<case "day">>
				오두막 너머로 농장의 소리가 들려온다.
			<<case "dusk">>
				잔잔한 바람이 커튼 사이로 불어온다.
			<<case "night">>
				방 안은 정적으로 가득하다.
		<</switch>>
	<<case "tower">>
		<<getChildrenIds `{location: $location, excludeUnhatched: true}` "both">>
		당신은 탑 안에 있다. 당신의 아이들을 찾아 주위를 둘러본다.
<</switch>>
<<if Time.dayState isnot "night" and (!$daily.childrenHomeEvent or !$daily.childrenHomeEvent.includes($location)) and random(1) is 1>>
	<<if !$daily.childrenHomeEvent>>
		<<set $daily.childrenHomeEvent to [$location]>>
	<<else>>
		<<run $daily.childrenHomeEvent.push($location)>>
	<</if>>
	<<cleareventpool>>
	<<childrenEvents $location $passage>>
	<<if _eventpool.length>>
		<<runeventpool>>
		<<exit>>
	<</if>>
<</if>>
<br><br>
<<childViewerDisplay _childrenIds>>
<br>
<<if $location isnot "tower">>
	<<if $location is "wolf_cave">>
		<<childicon "rope">>
	<<else>>
		<<childicon "teddy bear">>
	<</if>>
	<<if $player.inventory.childrenToys>>
		<<if !$storedChildrenToys[$location]>><<set $storedChildrenToys[$location] to []>><</if>>
		<<link [[아이들 장난감 보관하기|Childrens Home Toys]]>><</link>>
		<br>
	<<else>>
		이곳에 아이들을 위해 사둔 장난감이 없다. <<= $location is "wolf_cave" ? "애완동물 가게" : "장난감 가게">>에 가보는 것이 좋겠다.
		<br>
	<</if>>
<</if>>
<<if $location is "home">>
	<<foodstufficon "baby_bottle_of_breast_milk">>
	<<if V.foodstuff['baby_bottle_of_breast_milk'] and V.foodstuff['baby_bottle_of_breast_milk'].amount gt 0>>
		<<link [[모유 기부하기|Childrens Donate Milk]]>><</link>>
		<<if $pregnancyStats.orphanageMilkBottles gt 0>>
			(<span class="green"><<print $pregnancyStats.orphanageMilkBottles>></span> 병 남음)
		<<else>>
			(<span class="red"><<print $pregnancyStats.orphanageMilkBottles>></span> 병 남음)
		<</if>>
	<<else>>
		기부할 병에 담긴 모유가 없다.
		<<if $pregnancyStats.orphanageMilkBottles gt 0>>
			(<span class="green"><<print $pregnancyStats.orphanageMilkBottles>></span> 병 남음)
		<<else>>
			(<span class="red"><<print $pregnancyStats.orphanageMilkBottles>></span> 병 남음)
		<</if>>
	<</if>>
	<br>
<</if>>
<<getouticon>><<link [[뒤로|$exitPassage]]>><<unset $exitPassage>><</link>>

:: Childrens Donate Milk
<<effects>>

<label>기부할 우유병 개수: <<numberslider "$donatedMilk" 1 1 `$foodstuff["baby_bottle_of_breast_milk"].amount` 1>></label>

<<link [[기부하기|Childrens Donate Milk 2]]>><</link>>
<br>
<<link [[뒤로|Childrens Home]]>><<unset $childActivityEvent>><<endevent>><</link>>

:: Childrens Donate Milk 2
<<effects>><<wearProp "baby bottle of breast milk">>

<<set $pregnancyStats.orphanageMilkBottles += $donatedMilk>>
<<set $pregnancyStats.orphanageMilkBottlesTotal += $donatedMilk>>
<<set $foodstuff["baby_bottle_of_breast_milk"].amount -= $donatedMilk>>

베일리의 부하 중 한 명에게 아이들을 위한 모유 젖병 $donatedMilk개를 맡기고 떠난다.
<br><br>

<<link [[뒤로|Childrens Home]]>><<unset $donatedMilk>><<unset $childActivityEvent>><<endevent>><</link>>

:: Childrens Home Toys
<<effects>>

<<set _selectedCurrentToy to 0>>
<<set _selectedLocationToy to 0>>

<div id="childrenToysUI">
	<<childrenToysUI>>
</div>

<br>
<<getouticon>><<link [[뒤로|Childrens Home]]>><<unset $childActivityEvent>><<endevent>><</link>>

:: Childrens Home Toys Widgets [widget]

<<widget "childrenToysUI">>
	<<toySelection>>
	<div class="settingsGrid">
		<div>
			<div class="itemInventoryHeader settingsHeader">인벤토리</div>
			<div class="itemInventory itemDetails">
				<<for _i to 0; _i lt 10; _i++>>
					<<set _toy to $player.inventory.childrenToys[_i]>>
					<<if _toy and _i lt 5>>
						<<set _name to window.KR.getToyNameKr(_toySelection, _toy.name)>>
						<<set _icon to _toy.name.toLowerCase().replace(".","")>>
						<<set _index to _i - 1>>
						<div @class="_selectedCurrentToy is _i ? 'item selected' : 'item'" @tooltip="_name" onclick="$(this).siblings().removeClass('selected'); $(this).addClass('selected')">
							<label>
								<<if $options.images is 1>>
									<<childicon _icon>>
								<<else>>
									<span @class="_toy.colour"><<print window.KR.getToyNameKr(_toySelection, _toy.name)>></span>
								<</if>>
								<<radiobutton "_selectedCurrentToy" _i autocheck>>
							</label>
						</div>
					<<else>>
						<<if _i lt 5>>
							<div class="item unknown"><<ind>></div>
						<<else>>
							<div class="item empty"><<ind>></div>
						<</if>>
					<</if>>
				<</for>>
			</div>
			<div class="containerFooter">
				<<if $player.inventory.childrenToys.length gt 0>>
					<div class="tab inventory">
						<<button "<span class='fa-icon fa-trash'></span> 버리기">>
							<<run $player.inventory.childrenToys.deleteAt(_selectedCurrentToy)>>
							<<set _selectedCurrentToy to 0>>
							<<childrenToysUIReplace>>
						<</button>>
					</div>
					<br>
					<<if $storedChildrenToys[$location].length lt 10>>
						<div class="tab inventory">
							<<button "<span class='fa-icon fa-import'></span> 보관">>
								<<run $storedChildrenToys[$location].push($player.inventory.childrenToys[_selectedCurrentToy])>>
								<<run $player.inventory.childrenToys.deleteAt(_selectedCurrentToy)>>
								<<set _selectedCurrentToy to 0>>
								<<childrenToysUIReplace>>
							<</button>>
						</div>
					<</if>>
				<<else>>
					<div class="tab inventory">
						<button class="link-internal macro-button buttonDisabled" disabled><<="<span class='fa-icon fa-trash'></span> 버리기">></button>
					</div>
					<div class="tab inventory">
						<button class="link-internal macro-button buttonDisabled" disabled><<="<span class='fa-icon fa-import'></span> 보관">></button>
					</div>
				<</if>>
			</div>
		</div>
		<div>
			<div class="itemInventoryHeader settingsHeader">
				<<switch $location>>
					<<case "wolf_cave">>늑대 동굴
					<<case "tower">>매의 탑
					<<default>>보육원
				<</switch>>
			</div>
			<div class="itemInventory itemDetails">
				<<for _i to 0; _i lt 10; _i++>>
					<<set _toy to $storedChildrenToys[$location][_i]>>
					<<if _toy>>
						<<set _name to window.KR.getToyNameKr(_toySelection, _toy.name)>>
						<<set _icon to _toy.name.toLowerCase().replace(".","")>>
						<div @class="_selectedLocationToy is _i ? 'item selected' : 'item'" @tooltip="_name" onclick="$(this).siblings().removeClass('selected'); $(this).addClass('selected')">
							<label>
								<<if $options.images is 1>>
									<<childicon _icon>>
								<<else>>
									<span @class="_toy.colour"><<print window.KR.getToyNameKr(_toySelection, _toy.name)>></span>
								<</if>>
								<<radiobutton "_selectedLocationToy" _i autocheck>>
							</label>
						</div>
					<<else>>
						<div class="item unknown"><<ind>></div>
					<</if>>
				<</for>>
			</div>
			<div class="containerFooter">
					<<if $storedChildrenToys[$location].length gt 0>>
						<div class="tab inventory">
							<<button "<span class='fa-icon fa-trash'></span> 버리기">>
								<<run $storedChildrenToys[$location].deleteAt(_selectedLocationToy)>>
								<<set _selectedLocationToy to 0>>
								<<childrenToysUIReplace>>
							<</button>>
						</div>
						<<if $player.inventory.childrenToys.length lt 5>>
							<div class="tab inventory">
								<<button "<span class='fa-icon fa-export'></span> 소지">>
									<<run $player.inventory.childrenToys.push($storedChildrenToys[$location][_selectedLocationToy])>>
									<<run $storedChildrenToys[$location].deleteAt(_selectedLocationToy)>>
									<<set _selectedLocationToy to 0>>
									<<childrenToysUIReplace>>
								<</button>>
							</div>
						<<else>>
							<div class="tab inventory">
								<button class="link-internal macro-button no-numberify buttonDisabled" disabled><span class='fa-icon fa-export'></span> 소지</button>
							</div>
						<</if>>
					<<else>>
						<div class="tab inventory">
							<button class="link-internal macro-button buttonDisabled" disabled><<="<span class='fa-icon fa-trash'></span> 버리기">></button>
						</div>
						<div class="tab inventory">
							<button class="link-internal macro-button buttonDisabled" disabled><<="<span class='fa-icon fa-export'></span> 소지">></button>
						</div>
					<</if>>
			</div>
		</div>
	</div>
<</widget>>

<<widget "childrenToysUIReplace">>
	<<replace "#childrenToysUI">>
		<<childrenToysUI>>
	<</replace>>
<</widget>>

:: Children Activity Events
<<effects>>
<<childSelect $childActivityEvent.childid>>
<<childAge $childActivityEvent.childid>>
<<childInteratedWith>>
<<set $childRecords[$childActivityEvent.childid].development.event to false>>
<<switch $childActivityEvent.event>>
	/*Human Specific*/
	<<case "transfixed">>
		당신은 <<childname>> 곁에 서서 <<childhe>>【이가】 자는 모습을 지켜본다. 부드러운 숨결에 따라 오르내리는 <<childhis>> 가슴에 시선이 고정된다.
	<<case "stroke">>
		당신은 <<childname>> 곁에 서서 <<childhe>>【이가】 자는 모습을 지켜본다. 당신은 어느새 <<childhis>> 머리를 쓰다듬고 있다.
	<<case "yawn">>
		당신은 <<childname>> 곁에 서서 <<childhe>>【이가】 자는 모습을 지켜본다. <<childHe>>【이가】 입을 크게 벌려 하품하며 기지개를 켠다.<<lstress>><<stress -6>>
	<<case "murmur">>
		당신은 <<childname>> 곁에 서서 <<childhe>>【이가】 자는 모습을 지켜본다. <<childHe>>【이가】 나쁜 꿈이라도 꾸는 듯 잠꼬대를 하며 얼굴을 찡그린다.<<gstress>><<stress 6>>
	<<case "cotNap">>
		당신은 낮잠을 자기로 하고 <<childname>> 옆 침대에 눕는다.
		<br><br>
		얼마 후 잠에서 깨니 손가락에 무언가 감겨 있다. 당신이 잠든 사이, <<childname>>의 <<childhand>>【이가】 당신에게 닿은 모양이다.<<ltiredness>><<tiredness -3>>
	<<case "shiverInCot">>
		<<childname>>【은는】 혼자 잠들어, 무의식적인 숨을 쉴 때마다 몸을 떨고 있다. 당신은 근처에 있던 아기 담요로 <<childhim>>【을를】 덮어준다. <<childHe>>【은는】 곧 평화롭게 잠이 든다.<<lstress>><<stress -6>>
	<<case "restlessSleep">>
		<<childname>>【이가】 잠을 설친다. 당신은 <<childhim>> 옆에 누워 <<childhim>>【을를】 가슴에 끌어안는다. <<childhe>>【이가】 진정할 때까지 안아준다. 당신이 일어나려고 하자, <<childhe>>【이가】 작은 손으로 당신의 손가락을 꽉 잡는다. 당신은 잠시 더 껴안고 있다가, <<childhis>> 손아귀에서 조심스럽게 빠져나와 다시 일어선다.<<ltiredness>><<tiredness -6>><<llstress>><<stress -10>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "waveTongue">>
		당신은 <<childname>>에게 미소를 지어 보인다. 시선을 끌어보려고 손을 흔들고 혀를 내밀며 갖가지 우스꽝스러운 표정을 짓는다. <<childhe>>【은는】 신기한 듯 당신의 표정을 뜯어본다. 당신을 따라 해 보려는 것 같지만, 단순한 반사 작용인지는 확실치 않다.
	<<case "handsClap">>
		당신은 <<childname>>의 발을 <<childhis>> 손에 가져다 대고, 이리저리 움직이다가 가끔씩 손뼉을 치게 한다. <<childhis>> 발가락부터 등, 그리고 손가락 끝까지 <<childhis>> 몸을 부드럽게 마사지해준다. 애정 어린 손길로 <<childhis>> 몸을 어루만져준다. <<childHe>>【은는】 당신의 환한 미소에 화답하듯 미소 짓는다.
	<<case "peekaboo">>
		당신은 양손으로 얼굴을 가렸다가 몇 초 뒤에 짠 하고 드러낸다. <<childname>>【이가】 위를 올려다본다. 눈이 마주치자 <<childhe>>【이가】 방긋 웃는다.<<lstress>><<stress -6>>
	<<case "blowRaspberriesHappy">>
		당신은 <<childname>>【을를】 간지럽히고 <<childhis>> 배에 입술을 대고 부르르 소리를 낸다. <<childHe>>【은는】 울음을 그치고 대신 웃으며, 기쁨에 겨워 <<childhis>> 팔다리를 버둥거린다.<<lstress>><<stress -6>>
	<<case "blowRaspberriesUpset">>
		당신은 <<childname>>【을를】 간질이며 배에 입술을 대고 부르르 소리를 낸다. 아이는 고개를 이리저리 돌리고 바둥거리며 피하더니, 울음소리가 더 커진다. 이런 장난이 마음에 들지 않는 모양이다.<<gstress>><<stress 6>>
	<<case "faceStudy">>
		당신은 아이가 얼굴과 생김새를 자세히 볼 수 있도록 <<childname>>에게 더 가까이 다가간다. <<childhe>>【은는】 잠시 울음을 멈추는가 싶더니, 이내 당신의 머리카락을 움켜쥐고 잡아당긴다.<<gpain>><<pain 4>>
	<<case "rockToSleep">>
		당신은 그 <<childtype>>【을를】 팔에 안고 부드럽게 좌우로 흔들며 조용히 허밍을 한다. 곧 <<childhe>>【이가】 진정하고 당신의 팔 안에서 깊이 잠든다. 당신은 <<childhim>>【을를】 조심스럽게 아기 침대에 눕혀 재운다. <<lstress>><<stress -5>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "holdToShoulder">>
		당신은 그 <<childtype>>【을를】 들어 올린다. <<childHe>>【은는】 당신의 의도를 알아차린 듯, 당신의 어깨에 기대며 <<childhis>> <<childhands>>【으로로】 목을 감싼다. 당신이 <<childhim>>【을를】 위아래로 흔들어주자, <<childhe>>【이가】 팔 안에서 잠이 든다.<<lstress>><<stress -5>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "melodicLullaby">>
		당신은 그 <<childtype>>【을를】 안아 올린다. 당신은 선율이 아름다운 자장가를 흥얼거리며, 곡조에 맞춰 부드럽게 몸을 흔들면서 <<childname>>의 등을 문지른다. 익숙한 당신의 목소리가 <<childhis>> 기분을 진정시키는 것 같다. <<childHe>>【은는】 당신을 향해 옹알거린다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
	<<case "foreheadKiss">>
		당신은 그 <<childtype>>【을를】 안아 올린다. <<childhis>> 이마에 부드럽게 입을 맞추고, 가능한 한 많은 피부 접촉을 해준다. 이 행동에 용기를 얻은 <<childhim>>【은는】 고개를 들어 당신에게 미소로 화답한다.<<ltrauma>><<lstress>><<trauma -6>><<stress -6>>
	<<case "objectShow">>
		당신은 그 <<childtype>>【을를】 안아 올린다. 당신은 <<childname>>에게 몇 가지 다른 물건들을 보여준다. 주위에서 볼 수 있는 것들의 색깔, 모양, 질감을 설명해준다. <<childHe>>【은는】 주변 환경을 탐색하고 싶은 호기심에 손을 뻗어 만져보려 한다. 당신은 <<childhe>>【이가】 너무 무겁거나 다루기 힘든 것을 잡지 않도록 주의한다.<<gstress>><<stress 6>>
	<<case "carryRevolt">>
		당신은 그 <<childtype>>【을를】 안아 올린다. <<childHe>>【은는】 안기는 것에 저항하며, <<childhe>>【이가】 다리를 찬다. 당신이 <<childhim>>【을를】 오래 안고 있을수록 <<childhis>> 울음은 더욱 거세진다. <<childhis>> 발길질 중 일부가 당신에게 맞는다.<<gpain>><<gstress>><<pain 4>><<stress 6>>
	<<case "nurseryRhymes">>
		당신은 옛 기억을 떠올려 동요 몇 곡을 흥얼거려 준다. 당신의 목소리를 듣는 <<childhe>>의 눈빛이 또렷해진다. 목소리 톤을 몇 번 바꾸어 보며 <<childhis>> 반응을 살핀다. 특정 소리를 알아듣고 그에 맞춰 표정을 바꾸는 듯하다. 잠시 후, <<childhe>>【은는】 시선을 돌리더니 엄지손가락을 빤다.
	<<case "FeetCup">>
		당신은 <<childname>>의 오른발을 부드럽게 감싸 쥐고 발가락을 꼼지락거리며 센 다음, 반대쪽 발로 넘어간다. 손가락을 발가락 하나하나로 옮겨갈 때마다 <<childhe>>【은는】 눈을 크게 뜬 채 당신을 지켜보며 얌전해진다.
	<<case "shareThoughts">>
		당신은 <<childname>>에게 말을 걸며, 당신의 생각을 나누고 반응을 기다린다. 하지만 <<childHe>>【은는】 별로 주의를 기울이지 않는 것 같다.<<gstress>><<stress 6>>
	<<case "speakCry">>
		당신은 아기에게 말을 걸지만, <<childhis>> 울음소리가 당신의 말을 삼켜버린다. 당신이 <<childhim>>에게 말을 걸려고 애쓰는 매 순간마다 <<childHis>> 얼굴은 더욱 붉어진다.<<gstress>><<stress 6>>
	<<case "smilesAndLaughs">>
		당신은 <<childname>>【을를】 팔에 안고 눈높이까지 들어 올린다. 그 <<childtype>>【은는】 처음에는 변화에 눈을 동그랗게 뜨지만, 이내 미소 짓고 웃는다. 당신은 이것을 여러 번 반복하고, 곧 <<childhim>>【이가】 너무 심하게 웃어서 당신도 웃지 않을 수 없게 된다.<<llstress>><<stress -12>>
	<<case "talking">>
		당신은 <<childname>> 옆에 앉아 <<childhim>>에게 말을 건다. <<childHe>>【은는】 당신을 이해한다는 기색은 없지만, 당신의 존재에 미소 짓고 당신의 목소리에 신이 난 듯하다. 하지만 얼마 지나지 않아, <<childhe>>【은는】 자신의 손에 정신이 팔려 조용해진다. 당신은 다시 일어선다.<<lstress>><<stress -6>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "thumbSucking">>
		<<set $childRecords[$childActivityEvent.childid].development.talking++>>
	<<case "talking2">>
		당신은 <<childname>> 옆에 앉아 <<childhim>>에게 말을 건다. <<childHe>>【은는】 당신을 이해한다는 기색은 없지만, 당신의 존재에 미소 짓고 당신의 소리를 흉내 내려고 한다. 하지만 <<childHe>>【은는】 곧 자신의 손에 정신이 팔려 조용해진다. 당신은 다시 일어선다.<<llstress>><<stress -12>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "thumbSucking">>
	<<case "batheGentle">>
		<<childBatheScene "gentle">>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "batheShampoo">>
		<<childBatheScene "shampoo">>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "BatheCalm">>
		<<childBatheScene "calm">>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "batheTantrum">>
		<<childBatheScene "tantrum">>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "nappyChange">>
		<<wearProp "rag" "white">>
		<<childname>>【이가】 불편해 보인다. 당신은 수상한 냄새를 알아채고, 기저귀를 가져와 <<childhim>>【을를】 똑바로 눕힌다. 헌 기저귀를 벗기고 그 <<childtype>>의 엉덩이를 부지런히 닦아준 후 새 기저귀를 채워준다. 깨끗하게 갈아입은 <<childname>>【은는】 당신을 올려다보며 미소 짓는다.<<lstress>><<stress -3>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "crawlingAttempt">>
		당신은 <<childname>>에게 다가간다. <<childHe>>【은는】 배를 깔고 누워, <<childherself>> 움직이려고 애쓰고 있다. 당신은 <<childhim>> 옆에 앉아, <<childhis>> 손을 잡고 땅에 대주어 지렛대 역할을 해준다. 당신의 도움으로, <<childhe>>【이가】 바닥을 가로질러 <<childhimself>> 몸을 끄는 데 성공하고, <<childhis>> 움직임에 어리둥절해하며 즐거워한다. 잠시 후 <<childHe>>【은는】 요령을 터득하고, 당신은 <<childhim>>【이가】 서툴게 혼자 기어가도록 내버려 둔다.<<lstress>><<stress -6>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
		<<set $childRecords[$childActivityEvent.childid].development.crawling++>>
	<<case "crawlingAttempt2">>
		당신은 그 <<childtype>>의 손을 잡고 <<childhim>>【을를】 들어 올려, <<childhis>> 발만 땅에 닿게 한다. <<childHe>>【은는】 처음에는 혼란스러워하며 <<childhis>> 다리를 허우적거리다가, 발차기로 땅을 박차고 <<childherself>> 앞으로 나아간다. <<childHis>> 눈이 그 발견에 커지고, 곧 약간의 노력과 실패 끝에, 당신은 <<childhim>>【이가】 자신의 다리로 움직이게 한다. 물론, 당신이 <<childhim>>【을를】 똑바로 서 있도록 도와주면서 말이다. 잠시 후 <<childHe>>【은는】 피곤해하고, 당신은 <<childhim>>【을를】 다시 내려놓는다.<<llstress>><<stress -10>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "sleeping">>
	<<case "grumpyChild">>
		<<childname>>【은는】 아기 얼굴에 잔뜩 찌푸린 표정을 짓고 혼자 앉아 있다. 당신이 <<childhim>> 옆에 앉지만, <<childhe>>【이가】 당신을 무시한다. 심술궂은 아이의 표정에 미소 짓지 않을 수 없었던 당신은 <<childhim>>【을를】 간지럽히기 시작한다. <<childHe>>【은는】 간지럼을 타지는 않지만, 당신이 <<childhis>> 옆구리를 장난스럽게 공격하며 내는 우스꽝스러운 소리와 짓궂은 손가락에 즐거워한다. 찌푸린 얼굴은 곧 사라지고, <<childhe>>【이가】 대신 킥킥거리며 웃는다. 성공이다.<<lstress>><<stress -6>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "thumbSucking">>
	<<case "readingAttempt">>
		<<wearProp "open storybook">>
		당신은 <<childname>> 옆에 앉아 <<childhim>>【와과】 거꾸로 든 책을 무릎에 앉힌다. 책을 펼치고 <<childhim>>에게 간단한 단어들을 읽어주기 시작한다. <<childHe>>【은는】 잠시 동안 당신의 목소리와 다채로운 그림을 따라가다가, 이내 정신이 팔려 당신의 무릎에서 굴러떨어진다.<<lstress>><<stress -6>>
		<<set $childRecords[$childActivityEvent.childid].development.activity to "readingCorrected">>
	<<case "babyRattle">>
		<<wearProp "rattle">>
		당신은 <<childname>> 옆에 앉는다. <<childHe>>【은는】 <<childtoy $location $childActivityEvent.toyid "lowercase">>【을를】 내려다보고 있다. 당신은 그것을 손에 들고 흔들어, 시끄러운 딸랑이 소리를 낸다. 그 <<childtype>>【은는】 어리둥절하고 흥미로워하며 이 이상한 물건에 손을 뻗는다. 당신은 그 <<childtype>>【이가】 가지고 실험해볼 수 있도록 <<childtoy $location $childActivityEvent.toyid "lowercase">>【을를】 마지막으로 한 번 흔들어준 후 건네준다.
		<<if _childTotalDays lte 40>>
			<<childHe>>【은는】 그냥 바닥에 떨어뜨린다.
		<<elseif _childTotalDays lte 95 + random(0,20)>>
			<<childHe>>【은는】 딸랑이를 <<childhis>> 입에 넣으려고 하지만, 실패하고 바닥에 떨어뜨린다.
		<<else>>
			<<childHe>>【은는】 킥킥 웃으며 딸랑이를 흔들기 시작한다.
		<</if>>
		<<lstress>><<stress -5>><<ltrauma>><<trauma -2>>
	<<case "teddyBear">>
		당신은 <<childtoy $location $childActivityEvent.toyid "lowercase">>【을를】 <<childname>>의 팔에 안겨준다. <<childHe>>【은는】 그것을 꽉 잡고 코를 비빈다. <<childHe>>【은는】 곧 다시 잠이 든다. 당신은 <<childhim>>【을를】 보며 몇 분간 평온한 시간을 보낸다.<<ltrauma>><<trauma -6>><<lstress>><<stress -6>>
		<<if _toyid>>
