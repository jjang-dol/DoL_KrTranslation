:: Pregnancy [widget]

/* 임의로 추가한 한글 정의*/
<<widget "moveCreature">>
	/*0 -> _pregnancy.fetus[_i] or location (any but portable)*/
	/*1 -> Type*/
	/*2 -> locationId*/
	<<if _args[0] isnot null and _args[1]>>
		<<set _portable to $container.portable>>
		<<set _container to $container[$phase]>>
		<<set $_pregnancy to $sexStats[_args[3] or "anus"].pregnancy>>

		<<set _result to _args[1]>>
		<<switch _args[0]>>
			<<case 0 1 2 3>>
				<!-- With a number as argument 0, it takes the parasite of that argument in your current pregnancy item -->
				<<set _creature to clone($_pregnancy.fetus[_args[0]])>>
			<<default>>
				<!-- With a string as argument 0, it takes a parasite from the container matching the argument. Which parasite it takes corresponds to argument 2 -->
				<!-- Currently only used when transferring parasites for selling in :: Containers, inside a for loop -->
				<<if _args[2] isnot null>>
					<<set _creature to clone($container[_args[0]].creatures[_args[2]])>>
				<</if>>
		<</switch>>

		<<if _creature>>
			<<if _result is "destroy">>
				<!-- Simply gets rid of the parasite -->
				<<set _creature to null>>
				<<removeCreature _args[0] _args[2] _args[3]>>
			<<elseif _result is "portable">>
				<!-- Transfers the parasites for selling. The value of the parasite depends on its growth stat -->
				<<set _portable.creatures.push(clone(_creature))>>
				<<set _value to Math.floor(1000 / _creature.stats.growth)>>
				<<set _portable.value += _value>>
				<<removeCreature _args[0] _args[2] _args[3]>>
			<<elseif _result is "replace" and _args[2] isnot null and _args[0] gte 0 and _args[0] lte 3>>
				<!-- Replaces an existing parasite, for when you birth more than you can currently store -->
				<!-- The replaced parasite gets transferred for selling -->
				<<if _container.creatures[_i] isnot undefined>>
					<<if _container.creatures[_i] isnot null>>
						<<set _portable.creatures.push(clone(_container.creatures[_args[2]]))>>
						<<set _value to Math.floor(1000 / _container.creatures[_args[2]].stats.growth)>>
						<<set _portable.value += _value>>
						<<set _container.creatures[_args[2]] to clone(_creature)>>
						<<set _replaced to true>>
					<</if>>
				<</if>>
				<<if _replaced isnot true>>
					<<set _container.creatures[_args[2]] to clone(_creature)>>
					<<set _container.count += 1>>
				<</if>>
				<<removeCreature _args[0] undefined _args[3]>>
			<<elseif _result is "container">>
				<!-- Keeps the parasite and moves it to the current container -->
				<<set _moveTo to false>>
				<<for _containerSlot to 0; _containerSlot lt _container.maxCount; _containerSlot++>>
					<<if _container.creatures[_containerSlot] is undefined>>
						<<set _moveTo to true>>
					<<elseif _container.creatures[_containerSlot] is null>>
						<<set _moveTo to true>>
					<</if>>
					<<if _moveTo is true>>
						<<set $container[$phase].creatures[_containerSlot] to clone(_creature)>>
						<<set $container[$phase].count += 1>>
						<<removeCreature _args[0] _args[2] _args[3]>>
						<<break>>
					<</if>>
				<</for>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "removeCreature">>
	<<if _args[0] isnot null>>
		<<set $_pregnancy to $sexStats[_args[2] or "anus"].pregnancy>>
		<<switch _args[0]>>
			<<case 0 1 2 3>>
				<!-- With a number as argument 0, it removes the parasite of that argument in your current pregnancy item -->
				<<set $_pregnancy.fetus[_args[0]].toDelete to true>>
				<<set $_pregnancy.parasiteBirthEvents += 1>>
				<<if $_pregnancy.motherStatus is 0 and $_pregnancy.parasiteBirthEvents gte 3>>
					<<set $_pregnancy.motherStatus to 1>>
				<</if>>
			<<default>>
				<!-- With a string as argument 0, it removes a parasite from the container matching the argument. Which parasite it takes corresponds to argument 1 -->
				<<if _args[1] isnot null>>
					<<set $container[_args[0]].creatures[_args[1]] to null>>
					<<set $container[_args[0]].count -= 1>>
				<</if>>
		<</switch>>
	<</if>>
<</widget>>

<<widget "clearToDeleteParasiteFetus">>
	<<if $sexStats.anus.pregnancy.type is "parasite">>
		<<run $sexStats.anus.pregnancy.fetus to $sexStats.anus.pregnancy.fetus.filter(child => child && !child.toDelete)>>
		<<if $sexStats.anus.pregnancy.fetus.length is 0>>
			<<set $sexStats.anus.pregnancy.type to null>>
		<</if>>
	<</if>>
	<<if $sexStats.vagina.pregnancy.type is "parasite">>
		<<run $sexStats.vagina.pregnancy.fetus to $sexStats.vagina.pregnancy.fetus.filter(child => child && !child.toDelete)>>
		<<if $sexStats.vagina.pregnancy.fetus.length is 0>>
			<<set $sexStats.vagina.pregnancy.type to null>>
		<</if>>
	<</if>>
<</widget>>

<<widget "menstruationCycleState">>
	<<set $sexStats.vagina.menstruation.running to $player.vaginaExist or playerCanCarryAnally()>>
<</widget>>

<<widget "menstruationCycle">>
	<<set _menstruation to $sexStats.vagina.menstruation>>

	<<menstruationCycleState>>

	<<if _menstruation.running is true>>
		<<set _pills to $sexStats.pills>>
		<<switch _menstruation.currentState>>
			<<case "normal">>
				<<if !$settings.fertilityCycleEnabled>>
					<<giveHarpyEggs>>
				<<elseif _menstruation.currentDay lt _menstruation.currentDaysMax>>
					/*Continue the cycle again*/
					<<set _ovulating to _menstruation.currentDay gte _menstruation.stages[2] and _menstruation.currentDay lt _menstruation.stages[3]>>
					<<set _menstruation.currentDay += PregnancyConstants.menstrualCycle.cycleDaysPerTick>>
					<<if _ovulating>>
						<<giveHarpyEggs>>
					<</if>>
				<<else>>
					/*Start the cycle again*/
					<<restartMenstruationCycle>>
					<<set _menstruation.periodEnabled to true>>
				<</if>>
			<<case "pregnant">>
				/*To progress as normal so that the heat cycle and pregnancy risk still works as normal, will be reset in the recovering stage*/
				<<if _menstruation.currentDay lt _menstruation.currentDaysMax>>
					<<set _menstruation.currentDay to Math.min(_menstruation.currentDay + PregnancyConstants.menstrualCycle.cycleDaysPerTick, _menstruation.currentDaysMax)>>
				<</if>>
				<<if !playerIsPregnant()>>
					<<restartMenstruationCycle>>
					<<set _menstruation.currentState to "normal">>
					<<set _menstruation.recoveryTime to null>>
					<<set _menstruation.recoveryTimeStart to null>>
					<<set _menstruation.recoveryStage to null>>
				<</if>>
			<<case "recovering">>
				<<set _menstruation.recoveryTime -= 0.5>>
				<<switch _pills.pills["fertility booster"].doseTaken>>
					<<case 1>><<set _menstruation.recoveryTime -= 0.5>>
					<<case 2 3 4>><<set _menstruation.recoveryTime -= 1>>
				<</switch>>
				<<if $skin.pubic.pen is "magic" and $skin.pubic.special is "pregnancy">>
					<<set _menstruation.recoveryTime -= 0.5>>
				<</if>>
				<<if getParasiteObject().totalBirthEvents gt 2>>
					<<set _menstruation.recoveryTime -= 0.5>>
				<</if>>
				<<set _menstruation.recoveryStage to Math.floor((1 - (_menstruation.recoveryTime / _menstruation.recoveryTimeStart))*5)>>
				<<if _menstruation.recoveryTime lte 0>>
					<<set $effectsmessage to 1>>
					<<set $recovered_from_pregnancy to 1>>
					/*Ready to give birth again*/
					<<restartMenstruationCycle>>
					<<set _menstruation.currentState to "normal">>
					<<set _menstruation.recoveryTime to null>>
					<<set _menstruation.recoveryTimeStart to null>>
					<<set _menstruation.recoveryStage to null>>
				<</if>>
		<</switch>>
	<</if>>
<</widget>>

<<widget "rutCycle">>
	<<if $player.penisExist and ($wolfgirl gte 2 or $cat gte 2 or $cow gte 2 or $fox gte 2)>>
		<<if !$player.beastRut>>
			<<set $player.beastRut to 0>>
		<</if>>
		<<set $_pills = $sexStats.pills.pills>>
		<<if $wolfgirl gte 2>>
			<<set $_changeReduction to $wolfbuild>>
		<<elseif $cat gte 2>>
			<<set $_changeReduction to $catbuild>>
		<<elseif $cow gte 2>>
			<<set $_changeReduction to $cowbuild>>
		<<elseif $fox gte 2>>
			<<set $_changeReduction to $foxbuild>>
		<</if>>
		<<set $player.beastRut += 1 + $_pills["fertility booster"].doseTaken>>

		<<if $player.beastRut gte random(30 - Math.ceil($_changeReduction / 5), 120 - Math.clamp($_changeReduction, 0, 100)) or _args[0] or $_pills["fertility booster"].doseTaken gt 2>>
			<<set $player.beastRut to 0>>
		<</if>>
	<<else>>
		<<run delete $player.beastRut>>
	<</if>>
<</widget>>

:: Pregnancy2 [widget]

/*Don't call outside of the menstruationCycle widget*/
<<widget "restartMenstruationCycle">>
	<<set $_menstruation to $sexStats.vagina.menstruation>>
	<<set $_menstruation.currentDay to PregnancyConstants.menstrualCycle.cycleRestartDay>>
	<<set $_menstruation.currentDaysMax to $_menstruation.baseDays + random(0, $_menstruation.baseDaysRng)>>
	<<set $_menstruation.stages to rollMenstrualStages($_menstruation.currentDaysMax)>>
	<<set $_menstruation.fertileLeadDays to random(PregnancyConstants.menstrualCycle.fertileLeadDaysMin, PregnancyConstants.menstrualCycle.fertileLeadDaysMax)>>
<</widget>>

/*_args[0] - pregnancy record (if undefined: renders the wondering line). */
<<widget "pregnancyFatherHint">>
	<<if _args[0] and _args[0].possibleDonors.length is 1>>
		<<set _fatherName to pregnancyNameCorrection(_args[0].possibleDonors[0].name)>>
		<span class="lewd"><<= _args[0].possibleDonors[0].name === "pc" ? "당신이" : _fatherName + "【이가】">> 아버지인 것이 분명합니다.</span>
	<<else>>
		<span class="red">아버지가 누구인지 궁금합니다.</span>
	<</if>>
<</widget>>

<<widget "birthUi">>
	<<if _args[0] is "pc">>
		<<set _pregnancy to getLabouringPregnancy("pc")>>
		<<set _litter to _pregnancy ? getChildrenOf(_pregnancy.pregnancyId) : []>>
	<<elseif getLabouringPregnancy(_args[0])>>
		<<set _pregnancy to getLabouringPregnancy(_args[0])>>
		<<set _litter to getChildrenOf(_pregnancy.pregnancyId)>>
	<</if>>
	<<if _pregnancy>>
		<<run resolvePaternity(_pregnancy.pregnancyId)>>
		<<set $recentBirthId to _pregnancy.pregnancyId>>
	<</if>>
	<<if _litter and _litter.length>>
		<<pregnancyFeats _args[0]>>
		<div>
			<div class="settingsGrid m-0 childContainer">
				<<for _child range _litter>>
					<<capture _child>>
						<div @id="'child-' + _child.childId" class="childUi">
							<<birthChildElement _child>>
						</div>
					<</capture>>
				<</for>>
			</div>
		</div>
		<br>
		<<if _args[4]>>
			<<set _hours to Math.floor(_args[4] / 60)>>
			<<set _minutes to _args[4] % 60>>
			<<set _timeString to " (" + (_hours lt 10 ? "0": "") +_hours+":"+(_minutes lt 10 ? "0": "")+_minutes+")">>
		<</if>>
		<<link [["다음" + (_args[4] ? _timeString : "")|_args[3]]]>>
			<<if _args[0] is "pc">>
				<<endPlayerPregnancy _args[1] _args[2]>>
			<<elseif $NPCNameList.includes(_args[0])>>
				<<endNpcPregnancy _args[0] _args[1] _args[2]>>
			<</if>>
			<<pass _args[4]>>
		<</link>>
	<<else>>
		오류: '<<print $passage>>' 패시지에서 임신 객체를 찾을 수 없습니다. 세이브 파일과 함께 오류를 제보해 주세요.
	<</if>>
<</widget>>

/*args[0] - hatch location, _args[1] - next passage, _args[2] - time passage*/
<<widget "hatchUi">>
	<<set _readyEggs to getChildrenAt(_args[0]).filter(child => childIsUnhatchedEgg(child) and Time.date.timeStamp gte getHatchDate(getPregnancyOf(child)))>>
	<<if _readyEggs.length>>
		<div class="settingsGrid m-0 childContainer">
			<<for _egg range _readyEggs>>
				<<capture _egg>>
					<div @id="'child-' + _egg.childId" class="childUi">
						<<birthChildElement _egg>>
					</div>
				<</capture>>
			<</for>>
		</div>
		<br>
		<<if _args[2]>>
			<<set _hours to Math.floor(_args[2] / 60)>>
			<<set _minutes to _args[2] % 60>>
			<<set _timeString to " (" + (_hours lt 10 ? "0": "") +_hours+":"+(_minutes lt 10 ? "0": "")+_minutes+")">>
		<</if>>
		<<link [["다음" + (_args[2] ? _timeString : "")|_args[1]]]>>
			<<run _readyEggs.forEach(child => {
				if (!child.name) child.name = generateBabyName(undefined, child.gender, child.childId);
				recordBirth(child.childId);
			})>>
			<<pass _args[2]>>
		<</link>>
	<<else>>
		오류: '<<print $passage>>' 패시지에서 자녀 객체를 찾을 수 없습니다. 세이브 파일과 함께 오류를 제보해 주세요.
	<</if>>
<</widget>>

<<widget "birthChildElement">>
	<<if _args[0]?.childId isnot undefined>>
		<<capture _args>>
			<<set _pregnancy to getPregnancyOf(_args[0])>>
			<div class="childItem m-0 childName">
				<div>
					<label><div>이름:</div><div><<print '<<textbox "_args[0].name" `_args[0].name or ""`>>'>></div></label>
				</div>
			</div>
			<div class="childItem m-0 childDetails">
				<<childTypeDisplay _args[0]>>
				<span class="no-numberify">
					|
					<<link "랜덤 이름">>
						<<set _args[0].name to generateBabyName(undefined, _args[0].gender, _args[0].childId)>>
						<<replace `"#child-" + _args[0].childId`>><<birthChildElement _args[0]>><</replace>>
					<</link>>
				</span>
				<hr>
				<span class="gold">어머니:</span>
				<<if knowsCarrier(_pregnancy.pregnancyId, "pc")>>
					<<print pregnancyNameCorrection(_pregnancy.carrier, true)>>
				<<else>>
					????
				<</if>>
				| <span class="gold">아버지:</span>
				<<if knowsDonor(_pregnancy.pregnancyId, "pc")>>
					<<print pregnancyNameCorrection(_pregnancy.donor, true)>>
				<<else>>
					????
				<</if>>
				<br>
				<span class="gold">크기:</span> <<childKrText "size" _args[0].features.size>>
				<<if _args[0].features.hairColour>>
					<<if _args[0].species.includes("human")>>
						| <span class="gold">머리카락:</span>
					<<elseif _args[0].species.includes("hawk")>>
						| <span class="gold">깃털:</span>
					<<else>>
						| <span class="gold">털:</span>
					<</if>>
					<<childKrText "hair" _args[0].features.hairColour>>
				<</if>>
				<<if _args[0].features.eyeColour>>
					| <span class="gold">눈:</span> <<childKrText "eye" _args[0].features.eyeColour>>
				<</if>>
				<<if _args[0].features.skinColour and (_args[0].species.includes("human") or _args[0].features.monster)>>
					| <span class="gold">피부:</span> <<childKrText "skin" _args[0].features.skinColour>>
				<</if>>
				<br>
				<<if _args[0].identical isnot null>>
					<span class="gold">일란성:</span> 예
					<br>
				<</if>>
			</div>
		<</capture>>
	<<else>>
		오류: '<<print $passage>>' 패시지에서 자녀 객체를 찾을 수 없습니다. 세이브 파일과 함께 오류를 제보해 주세요.
	<</if>>
<</widget>>

<<widget "pregnancyFeats">>
	<<if _args[0] is "pc">>
		<<earnFeat "Miracle of Life">>
		<<set $_pregnancy to getLabouringPregnancy("pc")>>
		<<set $_pregnancyLitter to $_pregnancy ? getChildrenOf($_pregnancy.pregnancyId) : []>>
		<<if $_pregnancy and !knowsDonor($_pregnancy.pregnancyId, "pc") and $_pregnancy.possibleDonors.filter(donor => childBaseSpecies(donor.species) === childBaseSpecies($_pregnancy.donorSpecies)).length gte 5>>
			<<earnFeat "Bicycle Mother">>
		<</if>>
		<<if $_pregnancyLitter.length is 3 and $_pregnancyLitter[0].species is "human">>
			<<earnFeat "Life Comes in Threes">>
		<</if>>
		<<if $_pregnancy and $_pregnancy.orifice is "vagina" and $player.virginity.vaginal is true>>
			<<earnFeat "Hail Mary">>
		<</if>>
		<<if !$player.vaginaExist>>
			<<earnFeat "Life begins when you least expect">>
		<</if>>
	<</if>>
	<<if _args[0] isnot "pc">>
		<<set $_pregnancy to getLabouringPregnancy(_args[0])>>
		<<if $_pregnancy and $_pregnancy.carrier isnot "pc" && $_pregnancy.donor is "pc">>
			<<earnFeat "First Fatherhood">>
		<</if>>
	<</if>>
<</widget>>

<<widget "wakingEffects">><<silently>>
	<<if !$sexStats.vagina.menstruation.running>>
	<<elseif _args[0] and $sexStats.vagina.menstruation.currentState is "pregnant" or ($sexStats.vagina.menstruation.currentState is "normal" and ($settings.playerPregnancyHumanEnabled or $settings.playerPregnancyBeastEnabled))>>
		<<set $_pregnancy to getPlayerPregnancy()>>
		<<set _wakingEffect to wakingPregnancyEvent()>>
		<<switch _wakingEffect>>
			<<case "tired">>
				<<set $_text_output to "당신은 푹 쉬기는커녕 더 피곤해진 기분으로 잠에서 깬다.<<tiredness 10>><<ggtiredness>>">>
			<<case "crying">>
				<<set $_text_output to "당신은 눈물을 흘리며 잠에서 깬다. 왜 울고 있는지도 모르겠지만, 감정은 곧 가라앉는다.">>
			<<case "angry">>
				<<set $_text_output to "당신은 화가 난 채로 잠에서 깬다. 갑작스러운 분노에 놀랐지만, 이내 감정은 누그러진다.">>
			<<case "meatCraving">>
				<<set $_text_output to `당신은 고기가 듬뿍 든 무언가를 ${V.wolfgirl >= 2 ? "송곳니로 물어뜯고" : "먹고"} 싶다는 기묘한 갈망과 함께 잠에서 깬다.`>>
			<<case "foodCraving">>
				<<set $_text_output to `당신은 뭔가 ${["달콤한","매콤한","새콤한","짭짤한","쌉쌀한"][random(0,4)]} 것이 먹고 싶다는 기묘한 갈망과 함께 잠에서 깬다.`>>
			<<case "headache">>
				<<set $_text_output to "머리가 지끈거리는 채로 잠에서 깬다. 이 두통의 원인이 무엇인지 확신할 수 없지만, 이내 사라진다.">>
			<<case "sensitiveBreasts">>
				<<set $_text_output to "당신은 <<breasts>>【이가】 평소보다 더 예민해진 것을 느끼며 잠에서 깬다. 다행히 그 감각은 곧 사라진다.">>
			<<case "bloated">>
				<<set $_text_output to "당신은 속이 조금 더부룩한 채로 잠에서 깬다.">>
				<<set $daily.bloated to random(1,2)>>
			<<case "lightHeaded">>
				<<set $_text_output to "당신은 잠에서 깨자마자 잠깐 어지럼증을 느낀다.">>
			<<case "dizzy">>
				<<set $_text_output to "당신은 조금 어지러운 채로 잠에서 깨어나지만, 어지럼증은 금세 사라진다.">>
			<<case "mildNausea">>
				<<set $_text_output to "당신은 조금 메스꺼운 채로 잠에서 깨어나지만, 메스꺼움은 금세 사라진다.">>
			<<case "nausea">>
				<<set $_text_output to "당신은 메스꺼운 채로 잠에서 깨어나지만, 시간이 지나자 메스꺼움은 사라진다.">>
			<<case "dryheaving">>
				<<if $location is "wolf_cave">>
					<<set $_text_output to "당신은 구역질이 나서 서둘러 침대에서 빠져나와 동굴 구석으로 기어간다. 어쩔 수 없이 헛구역질을 한다.<<stress 10>><<gstress>><<pain 1>><<gpain>>">>
				<<elseif $location is "farm">>
					<<set $_text_output to "당신은 구역질이 나서 서둘러 침대에서 빠져나와 축사 구석으로 기어간다. 어쩔 수 없이 헛구역질을 한다.<<stress 10>><<gstress>><<pain 1>><<gpain>>">>
				<<elseif $location is "tower">>
					<<set $_text_output to "당신은 구역질이 나서 서둘러 침대에서 빠져나와 탑 가장자리로 기어간다. 아래쪽으로 어쩔 수 없이 헛구역질을 한다.<<stress 10>><<gstress>><<pain 1>><<gpain>>">>
				<<else>>
					<<set $_text_output to "당신은 구역질이 나서 서둘러 침대에서 빠져나와 근처 쓰레기통으로 기어간다. 그 안에 대고 어쩔 수 없이 헛구역질을 한다.<<stress 10>><<gstress>><<pain 1>><<gpain>>">>
				<</if>>
				<<if $awareness gte 200 and $sciencetrait gte 4 and playerNormalPregnancyTotal() gte 1 and !playerAwareTheyArePregnant()>>
					<<set $_text_output += " <span class='red'>임신 테스트기를 써봐야 할지도 모른다</span>.">>
				<</if>>
			<<case "lightBabyKick">>
				<<set $_text_output to "당신의 <<pregnancyBabyText 'pc'>>【이가】 가볍게 발로 차는 것을 느끼며 잠에서 깬다.<<stress -10>><<lstress>>">>
			<<case "babyKick">>
				<<set $_text_output to "당신의 <<pregnancyBabyText 'pc'>>【이가】 발로 차는 것을 느끼며 잠에서 깬다.<<stress -10>><<lstress>><<pain 1>><<gpain>>">>
			<<case "babyMovement">>
				<<set $_text_output to "당신의 <<pregnancyBabyText 'pc'>>【이가】 안에서 움직이는 것을 느끼며 잠에서 깬다.<<stress -10>><<lstress>>">>
			<<case "babyHiccup">>
				<<set $_text_output to "아기의 딸꾹질을 느끼며 잠에서 깬다.<<stress -10>><<lstress>>">>
			<<case "earlyContractions">>
				<<set $_text_output to "짧고 불규칙한 자궁 수축을 느끼며 잠에서 깬다.<<stress 5>><<gstress>><<pain 1>><<gpain>>">>
			<<case "bellySize">>
				<<set $_text_output to "잠에서 깬 당신은 부풀어 오른 배를 내려다본다. 임신했다는 사실이 마침내 실감 난다.">>
				<<if $_pregnancy.possibleDonors.length is 1>>
					<<set $_fatherName to pregnancyNameCorrection($_pregnancy.possibleDonors[0].name)>>
					<<set $_text_output += " <span class='lewd'>"+ ($_fatherName === "yourself" ? "당신이" : $_fatherName + "【이가】") +" 아이의 아버지임이 분명하다.</span>">>
				<<else>>
					<<set $_text_output += " <span class='red'>아이의 아버지가 누구인지 의문이 든다.</span>">>
				<</if>>
				<<run setPlayerLearnedPregnancyFrom("wakingUp")>>
			<<case "missedPeriod">>
				<<set $_text_output to "잠에서 깬 당신은 문득 깨닫는다. 생리 주기가 늦어지고 있다.">>
				<<if $awareness gte 200 and $sciencetrait gte 4 and playerNormalPregnancyTotal() gte 1 and !playerAwareTheyArePregnant()>>
					<<set $_text_output += " 다시 임신한 건 아닌지 의심이 든다. <span class='red'>테스트를 해보는 것이 좋겠다</span>.">>
				<</if>>
				<<set $sexStats.vagina.menstruation.awareOfPeriodDelay to true>>
			<<case "clothesRemoval">>
				<<set $_text_output to `<span class="red">몸을 짓누르는 무거운 압박감에 잠에서 깬다.</span> `>>
				<<set $_slots to ["genitals","under_upper","upper","under_lower","lower"]>>
				<<set $_broken to []>>
				<<set $_removed to []>>
				<<for $_slot range $_slots>>
					<<if $worn[$_slot].type.includes("constricting")>>
						<<if $worn[$_slot].cursed>>
							<<if $worn[$_slot].name is "gold chastity belt" and $worn[$_slot].integrity gt 0>>
								<<set $_goldenCB to true>>
								<<set $antiquemoney += Math.floor(2000 / ($worn.genitals.integrity / clothingData('genitals',$worn.genitals,'integrity_max')))>>
							<<else>>
								<<set $_broken.pushUnique($worn[$_slot].name)>>
							<</if>>
							<<set $worn[$_slot].type.push("broken")>>
							<<generalRuined $_slot>>
						<<else>>
							<<set $_removed.pushUnique($worn[$_slot].name)>>
							<<generalUndress "wardrobe" $_slot>>
						<</if>>
					<</if>>
				<</for>>
				<<if $_removed.length gte 1>>
					<<set $_text_output += "당신은 허둥지둥 " + formatList($_removed, undefined, true) + "【을를】 벗어던진다. ">>
				<</if>>
				<<if $_broken.length gte 1>>
					<<set $_text_output += "내려다보니 당신의 " + formatList($_broken, undefined, true) + "【이가】 부서져 있다. ">>
				<</if>>
				<<if $_goldenCB>>
					<<set $_text_output += `부풀어 오른 배 때문에 느슨해진 당신의 황금 정조대가, 약간의 힘을 주자 바닥에 쨍그랑 떨어진다. <span class="blue">수집가가 흥미를 가질지도 모른다.</span> `>>
				<</if>>
				<<set $_text_output += `<br><span class="red">임신한 몸은 더 이상 그런 옷을 견디지 못한다.</span> <<pain 2>><<gpain>>`>>
				<<if $vaginalchastityparasite isnot 0>>
					<<set $_text_output += `<br><span class="pink">정조대가 사라지자, 보지에서 ${window.KR.getCreatureTypeKr(String($vaginalchastityparasite).replace(/s$/, ""))}【이가】 떨어진다.</span> `>>
					<<set $vaginalchastityparasite to 0>>
				<</if>>
				<<if $penilechastityparasite isnot 0>>
					<<set $_text_output += `<br><span class="pink">정조대가 사라지자, 자지에서 ${window.KR.getCreatureTypeKr(String($penilechastityparasite).replace(/s$/, ""))}【이가】 떨어진다.</span> `>>
					<<set $penilechastityparasite to 0>>
				<</if>>
				<<if $analchastityparasite isnot 0>>
					<<set $_text_output += `<br><span class="pink">정조대가 사라지자, 항문에서 ${window.KR.getCreatureTypeKr(String($analchastityparasite).replace(/s$/, ""))}【이가】 떨어진다.</span> `>>
					<<set $analchastityparasite to 0>>
				<</if>>
			<<case "eggLaying">>
				<<set $_text_output to `<<playerEggLayEvent>>`>>
			<<case "nothing">>
				<<unset _wakingEffect>>
			<<default>>
				<<unset _wakingEffect>> <!-- Error Case -->
		<</switch>>
	<</if>>
	<</silently>><<if $_text_output>><<print $_text_output>><br><</if>>
<</widget>>

<<widget "pregnancyDailyEvent">><<silently>>
	<<if !["Asylum Sleep","Cabin Sleep","Wolf Cave Sleep","Bird Tower Sleep","Livestock Sleep","Farm Abduction wake 4","Sleep","Avery Hotel Morning","Avery Hotel Trauma Drink 2","Prison Sleep","Robin Trauma Visit Sleep","Pound Sleep","Robin Sleep","Mansion Sleep","Forest Shop Dog Bed Sleep"].includes($passage)>>
		<<set _pregnancyDailyEvent to dailyPregnancyEvent(_rng)>>
		<<switch _pregnancyDailyEvent>>
			<<case "tired">>
				<<set $_text_output to "하품이 나온다. 모든 일이 평소보다 더 많은 힘이 드는 것 같다.<<tiredness 2>><<gtiredness>>">>
			<<case "crying">>
				<<set $_text_output to "당신은 갑자기 눈물을 터뜨린다. 왜 우는지조차 확실치 않지만, 슬픔은 밀려온 것만큼이나 빠르게 지나간다.<<stress 5>><<gstress>>">>
			<<case "angry">>
				<<set $_text_output to "밑도 끝도 없이 화가 난다. 감정 기복이 갑작스럽게 찾아왔지만 이내 사라진다.<<stress 5>><<gstress>>">>
			<<case "meatCraving">>
				<<set $_text_output to `갑작스레, 고기 같은 것에 ${V.wolfgirl >= 2 ? "송곳니를 박아넣고" : "식욕을 느끼고"} 싶다는 묘한 갈망이 치솟는다.`>>
			<<case "foodCraving">>
				<<set $_text_output to `갑작스레, 뭔가 ${["달콤한","매콤한","시큼한","짭짤한","쌉싸름한"][random(0,4)]} 것을 먹고 싶다는 묘한 갈망이 치솟는다.`>>
			<<case "cramping">>
				<<set $_text_output to `아랫배 주위에 쥐어짜는 듯한 통증이 느껴진다.<<stress 5>><<gstress>><<pain 5>><<gpain>>`>>
			<<case "bloated">>
				<<set $_text_output to "배가 조금 더부룩하다.<<stress 3>><<gstress>>">>
				<<set $daily.bloated to random(1,2)>>
			<<case "lightHeaded">>
				<<set $_text_output to "잠시 머리가 조금 핑 도는 기분이 든다.">>
			<<case "dizzy">>
				<<set $_text_output to "조금 어지럼증을 느끼기 시작했지만, 이내 가라앉는다.">>
			<<case "mildNausea">>
				<<set $_text_output to "조금 메스꺼움을 느끼기 시작했지만, 이내 가라앉는다.">>
			<<case "nausea">>
				<<set $_text_output to "메스꺼움을 느끼기 시작했지만, 잠시 후 가라앉는다.">>
			<<case "lightBabyKick">>
				<<set $_text_output to "<<pregnancyBabyText 'pc'>>에게서 오는 가벼운 태동이 느껴진다.<<stress -10>><<lstress>>">>
			<<case "babyKick">>
				<<set $_text_output to "<<pregnancyBabyText 'pc'>>에게서 오는 태동이 느껴진다.<<stress -10>><<lstress>><<pain 1>><<gpain>>">>
			<<case "babyMovement">>
				<<set $_text_output to "<<pregnancyBabyText 'pc'>>【이가】 이리저리 움직이는 것이 느껴진다.<<stress -10>><<lstress>>">>
			<<case "babyHiccup">>
				<<set $_text_output to "아기의 딸꾹질이 느껴진다.<<stress -10>><<lstress>>">>
			<<case "earlyContractions">>
				<<set $_text_output to "짧고 산발적인 수축이 느껴진다.<<stress 5>><<gstress>>">>
		<</switch>>
		<<if _pregnancyDailyEvent>>
			<<run delete $daily.pregnancyEvent>>
		<<else>>
			<<if !$daily.pregnancyEvent>>
				<<set $daily.pregnancyEvent to 0>>
			<</if>>
			<<set $daily.pregnancyEvent += 15>>
		<</if>>
	<</if>>
	<</silently>><<if $_text_output>><<print $_text_output>><br><</if>>
<</widget>>

/*ToDo: Pregnancy Story Content: Lacks content, small unique events for when the player's stress passes out due to their pregnancy*/
<<widget "pregnancyPassout">>
	<<set $_pregnancy to getLabouringPregnancy("pc")>>
	<<if $_pregnancy>>
		<<set $_pregnancy.birthInProgress to true>>
		/*ToDo: Pregnancy - fill out for specific pregnancy passout events*/
		/*Area specific passout text for alternative pregnancy birth events*/
		<<switch _args[0]>>
			<<case "asylum">>
				<<if $asylumstate is "sleep">>
					<<endevent>>
					<<generate1>><<person1>>
					밤이 되어 문이 잠긴 후, 당신은 침대 위에 앉는다. 앉는 순간 축축한 느낌이 든다. 허벅지가 맑은 액체로 뒤덮인 것 같다. 산기가 다가오고 있다.
					<br><br>

					당신은 헛기침을 하며 문 쪽으로 뒤뚱뒤뚱 걸어간다. 문에 난 구멍을 통해 바깥을 향해 외친다. 경비원이 복도를 순찰하고 있으니 그리 오래 걸리진 않을 것이다.
					<br><br>

					당신의 외침은 오랫동안 무시당하고 골반에서 둔중한 통증이 울리기 시작한다. "소등 후엔 조용히 하라고 했지!" 경비원은 당신의 말을 믿지 않는다.
					<br><br>

					당신은 포기하지 않고 손이 아플 때까지 문을 두드린다. 그제서야 경비원이 다가와 안을 들여다본다.
					<br><br>

					"침대에 누워, 하퍼 의사를 불러올 테니." <<he>>【이가】 건조한 어조로 당신에게 지시한다. 당신은 <<he>>【이가】 말한 대로 한다. 깨어 있으려 애쓰면서 몸에 번지는 고통에 움찔거리며 몸을 떤다.
					<br><br>

					의식이 서서히 멀어진다.
				<<else>>
					당신은 중심을 잡으려 애쓰며 침대 위에 앉는다. 앉는 순간 축축한 느낌이 든다. 허벅지가 맑은 액체로 뒤덮인 것 같다. 산기가 다가오고 있다.
					<br><br>

					당신은 문 쪽으로 뒤뚱뒤뚱 걸어가며 비틀거리다 밖으로 나온다. 간호사가 재빨리 당신 곁으로 달려온다. "진정해요. 제가 잡았어요. 천천히 내려갈 거예요, 알겠죠?"
					<br><br>

					간호사는 당신이 앉도록 돕고 도움을 요청한다. 의식이 흐려진다.
				<</if>>
			<<case "asylumOutside">>
				<<endevent>>
				<<generate1>><<person1>>
				"화장실은 진작에 갔어야지." 지나가던 동료 환자가 당신을 비웃는다. 혼란스러워하며 아래를 내려다본다. <<if $worn.lower.type.includes("naked")>>허벅지를 타고 젖은 액체가 떨어지고 있다<<else>>$worn.lower.name에 젖은 얼룩이 지고 있다<</if>>.
				<br><br>

				"<<babyIs>> 나와요." 당신이 헐떡인다. 당신은 예기치 못한 날카로운 고통에 배를 움켜쥔다.
				<br><br>

				지나가던 환자가 멈춰서서 <<his>> 눈을 크게 뜨고 뒤돌아본다. "여기 있어, 사람을 불러올 테니!"
				<br><br>

				곁눈질로 환자가 조무사들에게 달려가는 모습이 보인다. 당신은 고통 속에서도 호흡에 집중하기로 한다.
				<br><br>

				눈을 깜빡인다. 사람들이 당신을 둘러싸고, 바닥에는 들것이 놓여 있다. 부드러운 손길이 당신을 이끈다.
				<br><br>

				의식을 잃어가는 동안 같은 손길이 당신을 지탱한다.
			<<case "asylumCafe">>
				<<endevent>>
				<<generate1>><<person1>>
				당신은 배에 손을 얹은 채 허리를 숙이며 신음한다. 체내에서 무언가 빠져나가는 듯한 느낌이 든다. 맑은 액체가 허벅지를 타고 흐른다.
				<br><br>

				환자들이 돌아서서 당신을 쳐다본다. 몇몇은 다가오고 몇몇은 물러선다. 소동이 일자 경비원들이 더 가까이 다가온다.
				<br><br>

				"<<pShes>> 애를 낳고 있어요!" 한 <<person>>【이가】 소리친다. 경비원들이 환자들을 밀어내며 이제 당신을 향해 달려온다.
				<br><br>

				그들은 당신이 걷는 것을 돕고, 사람들을 밀어내며 당신을 어딘가로 이끈다. 당신은 이내 자신이 어디 있는지 알 수 없게 되고 시야가 흐려진다.
			<<case "asylumLibrary">>
				<<endevent>>
				<<generate1>><<person1>>
				당신이 앉아 있는 의자가 축축하게 느껴지기 시작한다. 손을 뻗어보니 당신에게서 젖은 물기가 나오고 있다. 산기가 다가오고 있다.
				<br><br>

				어느 <<person>>【이가】 젖은 당신의 손가락을 알아챈다. <<He>>【이가】 앞으로 뛰어들어 당신에게서 책을 빼앗는다. "책을 망가뜨리지 마!"<br>
				"그럴 생각 아니었어요. 제- 제 <<babyIs>> 나와요." 심호흡을 하며 진정하려 애쓰면서 당신이 더듬거리며 말한다.
				<br><br>

				그 <<person>>【은는】 당신의 말을 믿지 않는 것 같다. <<He>>【은는】 조무사가 말리러 올 때까지 계속해서 당신을 몰아세운다.
				<br><br>

				조무사가 웅크린 당신을 살펴보고는 욕설을 내뱉는다. <<He>>【은는】 도움을 청하기 위해 더 많은 사람을 부른다. 당신이 도서관 밖으로 옮겨지는 동안 사람들은 그 <<person>>【을를】 제지해야 했다.
				<br><br>

				의식이 흐려진다.
			<<case "asylumHarper">>
				<<endevent>><<npc "Harper">><<person1>>
				의사실로 들어서자 불안감이 밀려온다. 하퍼가 눈치채고 책상 주위를 돌아 당신의 이마를 짚는다. <<He>>【은는】 당신을 진찰하고 몸을 훑어보다 당신의 다리 사이가 점점 젖어가는 것을 알아챈다.
				<br><br>

				"오 이런. 오늘 진료는 미뤄야겠네. 뱃속의 아기가 세상에 나올 준비가 된 것 같군."
				<br><br>

				당신이 가쁘게 숨을 몰아쉬기 시작하자 하퍼는 조무사들을 부른다. 복부에 서서히 통증이 차오른다.
				<br><br>

				하퍼가 말하는 소리는 들리지만 통증에 집중하다 보니 무슨 말인지 뒤죽박죽이 된다.
				<br><br>

				누군가 당신의 팔을 부축해... 어딘가로 이끈다. 모든 것이 아득해진다.
			<<case "forest" "lake">>
				당신은 비틀거리며 커다란 나무통에 간신히 몸을 기댄다. 아래를 내려다보니 다리에 맑은 액체가 흐르고 있다. 산기가 다가오고 있다.
				<br><br>

				당신은 무의식적으로 훌쩍인다. 서 있으려는 노력조차 타는 듯한 고통을 유발한다. 당신의 왼편에서 나뭇가지가 부러진다.
			<<case "bog">>
				<<pass 1 hour>>
				<<if $bogwater is 1>>
					당신은 비틀거리며 간신히 길로 되돌아온다. 끔찍한 압박감이 당신을 관통한다. 산기가 다가오고 있다.
					<br><br>

					당신은 무의식적으로 훌쩍인다. 당신에겐 물에서 빠져나올 힘이 없다. 그저 물 위에 떠 있는 것만으로도 모든 힘이 빠져나간다.
				<<else>>
					당신은 비틀거리며 커다란 나무통에 간신히 몸을 기댄다. 아래를 내려다보니 다리에 맑은 액체가 흐르고 있다. 산기가 다가오고 있다.
					<br><br>

					당신은 무의식적으로 훌쩍인다. 서 있으려는 노력조차 타는 듯한 고통을 유발한다. 당신은 나무 데크 위에 쓰러진다.
				<</if>>
				<br><br>

				시간이 흐른다. 당신은 고통에 소리를 지르기 시작한다. 아드레날린과 공포가 당신을 꿰뚫는다. 도움을 줄 수 있는 누구도 너무 멀리 떨어져 있다. 아무도 당신의 목소리를 듣지 못할 거라는 생각이 공포를 배가시킨다. 이렇게 혼자라는 느낌을 받아본 적이 없다.
				<br><br>

				나무 사이로 형체들이 움직이기 시작한다. 나무판 위를 걷는 발자국 소리. 차마 볼 순 없지만 점점 가까워지고 있다. 당신은 이목구비가 없는 하얀 가면과 마주친다. 검은 후드 위로 뿔이 솟아 있다. 그 이미지가 마음속에 깊이 새겨지는 순간 당신은 기절한다.
			<<case "tentacleworld" "tentacleforest">>
				당신은 고통에 몸을 구부린다. 모든 촉수들이 당신에게서 물러난다. 당신은 무릎을 꿇고 있는 힘껏 바닥을 움켜쥔다.
				<br><br>

				하늘이 번쩍인다. 고통스러운 비명을 지르는 당신을 뒤로하고 환각이 희미해진다.
			<<case "farmroad">>
				몸은 피곤하고 다리는 풀려버린다. 길에서 겨우 몇 센티미터 떨어져 있을 뿐이다. 일어나려 애쓰지만 몸이 말을 듣지 않는다. 액체가 다리를 타고 흐른다. 산기가 다가오고 있다.
				<br><br>
				간신히 몸을 굴려 뒤집은 후, 당신은 허공에 손을 흔들어 지나가는 차를 세워보려 한다. 가끔 경적을 울릴 뿐 아무도 당신에게 눈길을 주지 않는다. 어느 차가 너무 가까이 와서 차에 치이지 않으려 다시 뒤구르기를 해야 했다.
				<br><br>
				눈물이 차오른다. 당신은 이런 끔찍한 곳에서 아기를 낳아야 할지도 모른다는 공포에 휩싸이고 시간이 지날수록 그 공포는 점점 더 현실로 다가온다.
				<br><br>
				<<if $location is "farm" and couldBeDonor($_pregnancy, "Alex") and talkedAboutPregnancy("pc","Alex")>>
					<<npc Alex>><<person1>>
					당신의 몸은 피로에 굴복하기 시작한다. 누군가 당신을 안아들었다는 사실조차 희미하게 느껴진다. 그들이 소리치고 있지만 무슨 말인지 알아들을 수 없다. 머리가 빙빙 돈다.
					<br><br>
					누군지 집중하여 알아차리기까지 시간이 걸린다. <span class="green">알렉스다</span>. 시야가 흐려진 와중에도 <<his>> 얼굴에 서린 두려움을 엿볼 수 있다. 아기와 자신이 좋은 손길에 맡겨졌다는 생각에 당신은 힘을 빼고 의식을 잃는다.
				<<else>>
					<<generate1>><<person1>>
					당신의 몸이 무의식의 문턱을 넘나드는 와중, 차가 다가와 멈추고 문이 열리는 소리가 들린다. 두 손이 당신의 얼굴을 감싼다.
					<br><br>
					그 낯선 사람이 조수석에 앉은 <<his>> 일행에게 소리친다. <<His>> 얼굴은 상냥하고 부드러우며 당신의 몸은 마침내 그에 응한다. 시야가 흐려지고 당신은 의식을 잃는다.
				<</if>>
			<<case "remy">>
				<<if $outside is 1>>
					A
					<<if ($settings.monsterChance gte 1 and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly))>>
						<<set $monster to 1>>
						<<if $settings.maleVictimChance lt random(1, 100)>>cowgirl<<else>>bullboy<</if>>
					<<else>>
						cow
					<</if>>
					당신의 허벅지를 찌르며 음매 하고 운다. 아래를 내려다보니 맑은 액체가 다리에 흐르고 있고 이내 하복부에 짧은 통증이 번진다. 산기가 다가오고 있다.
					<br><br>

					숨을 헐떡이며 당신은 천천히 주저앉는다. 더 많은 <<livestock_cows>>【이가】 소란에 호기심을 느끼고 몰려든다.
					<<if $monster is 1>>
						누군가 외친다. "아기! <<pHer>> <<babyIs>> 나오고 있어!"
					<<else>>
						"저것들 대체 뭐 하는 거야?" 들판 반대편에서 일꾼이 소리친다.
					<</if>>
					<br><br>

					농장 일꾼 두엇이 이상한 낌새를 눈치채고 다가온다. 그들은 당신이 배를 움켜쥔 채 숨을 천천히 쉬고 있는 모습을 발견한다.
					"젠장, 이 녀석 터지기 일보 직전이야! 레미 불러와!" 일꾼이 당신 곁에 웅크려 앉는 동안 고통이 심해지고 당신은 천천히 드러눕는다.
					<br><br>

					시야가 멀어지는 와중 희미하게 풀을 밟는 장화 소리와 여러 외침이 들려온다.
				<<else>>
					<<endevent>>
					<<generate1>><<person1>>
					당신이 앉아 있는 건초가 기분 나쁠 정도로 축축하다. 아래를 내려다보니 더 많은 물기가 새어나오고 있다. 산기가 다가오고 있다.
					<br><br>

					깊고 천천히 심호흡을 하며 진정하려 노력하지만 곧 첫 진통이 찾아오고 당신은 비명을 지른다.
					<br><br>

					"저게 뭐지?"<br>
					"무시해, 관심 끌려는 멍청한 암소일 뿐이야." 농장 일꾼들은 당신을 계속 무시한다.
					<br><br>

					또 다른 진통이 찾아오고 당신은 한 번 더 비명을 지른다. 이번엔 누군가 확인하러 온다.
					"조용히 해야지—" 툴툴거리던 <<he>>【이가】 이내 눈을 크게 뜬다. "레미 데려와! 당장! 이 녀석 터지기 일보 직전이야!"
					세상이 천천히 어둠 속으로 희미해지는 와중 소란이 시작되는 소리가 들린다.
				<</if>>
			<<case "remyAbduction">>
				<<generate1>> <<generate2>>
				진통이 거세지자 당신은 흙바닥에 쓰러져 고통에 신음한다. 머지않아 텐트 천막이 움직이는 소리가 들리더니 짜증이 가득한 표정의 <<person1>><<person>>【이가】 고개를 들이민다.
				<br><br>

				"어이, 무슨 일이야?" <<he>>【이가】 찡그린 얼굴로 말한다. <<He>>【은는】 웅크린 당신과 부푼 배를 훑어보더니 욕설을 내뱉고 텐트를 나선다. 사람들이 깨어나며 웅성거리는 소리가 들린다.
				<br><br>

				길고 고통스러운 몇 분이 지나고, <<person1>><<person>>【이가】 텐트 안으로 다시 들어오며 <<person2>><<person>>【이가】 그 뒤를 바짝 따른다. 그들은 함께 당신을 번쩍 들어 올려 대기 중이던 픽업 트럭으로 옮긴다. 짐칸에 당신을 태우자마자 <<person1>><<person>>【이가】 그 뒤를 따라 올라탄다. 픽업 트럭이 야영지를 빠져나갈 무렵 당신은 의식을 잃는다.
			<<case "remyHarperExam">>
				<<npc Harper>><<person1>>
				테이블 위에 앉으려 하자 시야가 흐려지고 가까스로 모서리를 짚어 버틴다. 하퍼 의사가 기겁하며 다가와 당신의 팔을 붙잡고 앉는 것을 도와준다.
				<br><br>

				하퍼는 굳은 표정으로 당신의 배를 잠시 살펴보더니 레미를 호출한다. "산기", "병원"이라는 단어와 레미의 언짢은 얼굴이 희미하게 스쳐가는 것을 끝으로 시야가 까맣게 암전된다.
			<<case "remyNiki">>
			<<case "moor">>
				<<generate1>><<generate2>>
				허벅지가 축축하다. 배에서 느껴지는 강한 통증에 다리에 힘이 풀린다. 산기가 다가오고 있다.
				<br><br>

				당신은 헐떡이며 무릎을 꿇고 헤더 꽃무리가 넘어지는 것을 받쳐준다. 바닥에 누울 수밖에 없다. "도와주세요!" 당신은 울부짖는다. 목소리가 평원을 메아리친다.
				<br><br>

				고통에 압도되어 주변 풍경이 흐릿해진다. 웅성거리는 목소리와 발소리가 희미하게 들려온다.
				<br><br>

				"그 빌어먹을 유사일 거야, 누군가 또 빠졌나 봐." 한 <<person1>><<person>>【이가】 말한다.
				<br><br>

				"아니야. 저기 봐! <<pHer>> 양수가 터졌어. 우리가 당장 뭔가 하지 않으면 저기서 애를 낳을 거라고!" 다른 <<person2>><<person>>【이가】 다소 당황한 목소리로 지적한다.
				<br><br>

				세상이 암전되며 손들이 당신을 땅에서 들어올리는 것이 느껴진다.
			<<case "castle">>
				<<npc "Great Hawk">>
				고통에 허리를 꺾으니 다리에 맑은 액체가 흐르고 있는 것이 보인다. 산기가 다가오고 있다. 절망적으로 주변을 둘러보며 고통 섞인 비명을 지르다 이내 옆으로 비틀거리며 쓰러진다.
				<br><br>

				눈이 감긴다. 다시 눈을 떴을 때는 <<beasttype>>의 얼굴과 마주한다.
				<<if $monster is 1>>
					<<bHe>>【이가】 무언가 말하지만 알 수 없는 말로만 들린다.
				<<else>>
					<<bHe>>【은는】 호기심과 걱정이 섞인 시선으로 당신을 응시한다.
				<</if>>
				<<bHis>> 날갯짓이 시작된다. 무언가 깃털 달린 것에 실려 올라가는 느낌이 든다. 다시 눈을 떴을 때는 공중에 높이 떠 있다. 당신은 즉시 충격으로 기절한다.
				<br><br>

				몸이 붕 떠오르는 느낌이 든다. 다시 눈을 뜨니 발 아래 병원이 보이고 시야 구석에 깃털이 스친다.
				눈을 깜빡이자 갑자기 내려가는 느낌이 든다. 발이 인도에 닿는다. 거센 바람이 뒤따르고 <<beasttype>>【은는】 사라진다.
			<<case "wraith">>
				고통에 허리를 꺾으니 다리에 맑은 액체가 흐르고 있는 것이 보인다. 산기가 다가오고 있다. 절망적으로 주변을 둘러보며 고통 섞인 비명을 지르다 이내 옆으로 비틀거리며 쓰러진다. 희망도 없이 갇혔다는 느낌이 든다. 귓가에 심장이 고동친다.
				<br><br>

				눈이 감긴다. 다시 눈을 떴을 때는 한 쌍의 <<wraithEyes>> 눈동자가 당신을 응시하고 있다. "<span class="wraith">고통. 생명. 아름답다.</span>"
				<br><br>

				당신의 몸에 그것이 들어오자 저항할 수가 없다. 고통이 즉시 멈춘다. 긴 안도의 한숨을 쉬며 자리에서 일어난다. 당신의 몸이 앞을 향해 힘겹게 걸음을 옮기는 동안 의식이 천천히 멀어져간다.
				<br><br>

				추위가 느껴진다. 다시 따뜻해진다. 그리고 아무것도 없다. 이윽고 눈을 뜨니 병원 앞이다. 고통이 다시 찾아온다. 창백한 얼굴이 당신과 마주한다. "<span class="wraith">아름답다. 안전하게 지켜라.</span>"
			<<case "dungeon">>
				<<endevent>>
				<<generate1>><<npc Robin 2>>
				<<badEndTrackingEnd "Underground Dungeon" { reason: "labour" }>>
				<<dungeonescape>>
				바닥에 주저앉아 몸을 비틀던 중 아래쪽에 고이는 젖은 느낌에 움찔한다. 당신에게서 나오고 있는 것 같다. 산기가 다가오고 있다.
				<br><br>

				공황에 빠진 당신은 도망칠 길을 찾기 위해 황량한 방 안을 둘러본다.
				<<if $undergroundbrothel.robin>>
					유독 강한 수축이 일고, 차가운 바닥에 웅크려 앉아 고통에 신음한다.
					<br><br>

					벽 너머로 로빈의 목소리가 들린다. "괜찮아? 무슨 일이야?" <<person2>><<he>>【이가】 불안한 목소리로 묻는다.
					<br><br>

					<<if $speech_attitude is "meek">>
						"나-나 산기가 왔어. 어떡하지?" 당신이 울먹이며 외친다.
					<<elseif $speech_attitude is "bratty">>
						"때가 됐어," 이빨을 악물며 당신이 답한다. "나 <<pregnancyBabyText "pc">>【을를】 낳으려나 봐."
					<<else>>
						"도와줘! 내 <<babyIs>> 나오고 있어!" 당신이 부르짖는다.
					<</if>>
					<br><br>

					잠시 정적이 흐르고 이윽고 로빈이 상황을 파악하며 비명을 지른다. "산기라고?! 괘-괜찮아, 진정해, 내가 도와줄 사람 불러올게!" <<he>>【이가】 허둥지둥 발소리를 내며 문 쪽으로 달려가는 소리가 들린다. <<He>>【은는】 문을 두드리며 누군가 제발 도와달라고 소리친다.
					<br><br>

					당신은 두 방 사이를 가로막는 벽을 향해 비틀거리며 힘겹게 로빈의 이름을 부른다. 방을 연결하는 틈새로 손가락을 밀어 넣어 있는 힘껏 <<him>>【을를】 향해 뻗는다.
					<br><br>

					복도 바깥에서 다가오는 발소리와 투덜거리는 소리가 들려온다. 의식이 흐려지기 전 마지막으로 로빈의 손가락이 절박하게 당신의 손가락과 맞닿는 것을 느낀다.

				<<else>>
					도리 없이 문을 두드리는 수밖에 없다. "도-도와주세요, 제발! 제 <<babyIs>> 나오고 있어요!" 당신이 문을 쿵쿵 두드리며 소리친다. 누군가 이 소리를 들을지는 알 수 없다.
					<br><br>

					계속 외쳐본다. 자물쇠가 돌아가는 소리가 들리기까지 얼마나 걸렸는지 가늠이 되지 않는다. 잔뜩 언짢은 <<person1>><<person>>【이가】 들어오더니 당신의 곤경을 보고서야 소리치려던 입을 다문다.
					<br><br>

					"기다려," <<he>>【이가】 으르렁거리며 당신을 다시 혼자 둔다. 견디기 힘든 고통에 이끌려 더러운 매트리스까지 기어가 몸을 눕힌다.
				<</if>>
				<br><br>
				문이 삐걱거리며 열리고 의식이 흐릿해진다. <<= $undergroundbrothel.robin ? "마침내" : "또다시">>.
				<<specialClothesUnlock "set" "underground_brothel">>
			<<case "alley">>
				<<generate1>><<person1>>
				<<if $bus is "residential" and $town_projects.thicket gte 4 and random(1,2) is 1>>
					당신은 배를 부여잡고 잔디밭에 무릎을 꿇고 주저앉는다.
				<<elseif random(1,2) is 1>>
					당신은 근처 사다리에 몸을 의지하며 골목길로 비틀거리며 들어간다.
				<<else>>
					당신은 배를 움켜쥔 채 콘크리트 골목에 주저앉는다.
				<</if>>
				다리 사이로 작은 웅덩이가 고이기 시작한다. 산기가 다가오고 있다.
				<br><br>
				<<if random(1,2) is 1>>
					<<if $bus is "residential">>
						<<if $town_projects.thicket gte 4>>
							수풀 근처 벤치에서 식사 중이던 어느 <<personsimple>>【이가】 비틀거리며 일어선다. <<his>> 샌드위치를 내던지며 당신에게 달려온다.
							<br><br>
							당신은 기절하기 직전 <<He>>【이가】 전화를 거는 소리를 간신히 듣는다.
						<<else>>
							희미한 형체들이 골목길을 지나가다 고통스러운 비명에 이끌려 당신에게 달려온다.
							<br><br>
							의식을 잃어가며 본 마지막 풍경은 당신 주변을 에워싼 사람들의 얼굴이다.
						<</if>>
					<<elseif $bus is "industrial">>
						"어이, 여기에 짱박혀 있으면 어떡해!" 어느 <<person>>【이가】 소리치며 발소리도 요란하게 성큼성큼 다가온다.
						<br><br>
						당신이 웅크린 몸을 본 그 <<personsimple>>【이가】 헉 소리를 낸다. <<He>>【은는】 잠시 욕을 중얼대다 전화기에 무언가를 누른다.
						<br><br>
						<<his>> 말은 잘 들리지 않지만 당신은 일말의 안도감을 느끼며 의식을 놓는다.
					<<else>>
						"도-도와주세요! 아무나!" 고통에 무릎을 꿇으며 당신이 울부짖는다.
						<br><br>
						외침을 듣고 몇몇 사람들이 돕기 위해 서둘러 오더니 당신의 상태를 보고 경악하며 당황한 표정을 짓는다.
						<br><br>
						암흑이 내리기 전 당신이 마지막으로 본 것은 당신을 향해 뻗어진 손길들이다.
					<</if>>
				<<else>>
					<<if $bus is "residential">>
						"귀염둥이 아니야?" 한 목소리가 휘파람을 분다. "나야 거부할- 아 시발."
						<br><br>
						외치는 소리에 이어 당신을 향해 달려오는 발소리가 들려온다. 그들은 패닉 상태로 손가락질하며 당신 곁으로 모여든다.
						<br><br>
						당신이 느낀 마지막 감각은 당신의 허리와 다리를 감싸는 손길이었고 이내 기절한다.
					<<elseif $bus is "industrial">>
						당신은 고통에 찬 비명을 내지르지만 시끄러운 기계음이 그 소리를 덮어버린다. 이 골목에서는 아무도 당신의 목소리를 듣지 못할 것이란 두려움에 패닉이 몰려온다.
						<br><br>
						이윽고 당신의 비명 소리에 이끌린 듯 두 사람이 당신의 웅크린 몸 곁으로 다가와 급히 당신을 살핀다.
						<br><br>
						의식이 흐려지기 전 마지막으로 당신의 손을 맞잡는 누군가의 손길이 느껴진다.
					<<else>>
						뒤편에서 문이 쾅 열리는 소리와 함께 한 <<person>>【이가】 외친다. "이봐, 거기 뒹굴거리고 있으면 안 돼, 여긴 그런—"
						<br><br>
						그 <<personsimple>>【은는】 헉 소리를 내고 당신의 웅크린 몸 곁으로 급히 달려온다. <<He>>【은는】 황급히 휴대폰을 꺼내 무언가를 다이얼링 한 뒤 다시 당신을 살핀다.
						<br><br>
						무슨 말인지 알아들을 순 없었지만 암흑 속으로 스러지며 안도감을 느낀다.
					<</if>>
				<</if>>
			<<case "arcade">>
				배를 움켜쥔 채 지저분한 오락실 바닥에 고통스럽게 쓰러진다. 양탄자 위로 작은 물웅덩이가 스며들기 시작한다. 산기가 다가오고 있다.
				<br><br>
				<<if Time.dayState is "night" or Time.dayState is "dawn">>
					<<generateRole 0 0 "repairman/repairwoman">><<person1>>
					"어이!" 누군가 소리친다. "여기 들어오면 안 돼." 아침에 오락실이 열리기 전 기계를 수리하러 온 듯한 <<person>>【을를】 당신이 올려다본다.
				<<else>>
					<<generateRole 0 0 "employee">><<person1>>
					"저기, 괜찮으세요?" 한 <<person>>【이가】 걱정스런 표정으로 다가온다.
				<</if>>
				<br><br>

				당신은 배에 날카로운 고통을 느끼며 신음한다. "제-제 <<babyIs>> 나와요."
				<br><br>

				그 <<personsimple>>【은는】 당신의 말에 경악하며 <<= Time.dayState is "night" or Time.dayState is "dawn" ? "재빨리 <<his>> 휴대폰을 꺼낸다" : "카운터에 있는 누군가에게 소리친다">>.
				<br><br>

				<<He>>【이가】 당신의 손을 잡아주는 것을 느끼지만 이내 암흑으로 서서히 시야가 흐려지며 <<his>> 말소리도 아득해진다.
			<<case "beach">>
				<<generate1>><<person1>>
				비틀거리는 당신은 모래사장에서 갑자기 균형을 잃는다. 뱃속에서 느껴지는 강한 통증에 서 있기조차 힘들다. 산기가 다가오고 있다. 도움을 줄 누군가가 있는지 주변을 둘러보지만 수축이 일며 당신은 비명을 내지른다.
				<br><br>

				당신이 쓰러지려던 찰나 누군가 팔 밑으로 두 손을 밀어넣어 당신을 잡아준다. 올려다보니 한 <<person>>의 얼굴이 간신히 보인다. "무슨 일이야, <<girl>>?" <<he>>【이가】 묻는다.
				<br><br>

				"내 아-아기요." 당신은 간신히 헐떡이며 말한다.
				<br><br>

				그 <<personssimple>>【은는】 걱정에 이마를 찌푸린다. "눕혀 줄 테니까 구급차 불러줄게." <<he>>【이가】 약속한다. <<He>>【은는】 당신을 파라솔로 그늘이 진 비치타월 위로 끈다. <<He>>【이가】 당신을 내려놓자마자 의식이 희미해진다.
			<<case "bus">>
			<<case "docksSneak">>
			<<case "docks">>
			<<case "home">>
				당신은 수축에 휩싸여 바닥으로 쓰러진다.

				<<if ["Bedroom", "Bathroom"].includes($passage)>>
					<<npc Bailey>><<person1>>
					<<= $passage is "Bedroom" ? "침실" : "욕실">> 문이 쾅 열리는 소리와 함께 욕설과 육중한 발소리가 들려온다. 거친 손길이 당신의 몸을 뒤집고, 당신은 그 손을 부여잡는다. 베일리다.
					<br><br>

					"빌어먹을. 병원에 갈 순 없었나 보지?" <<He>>【은는】 짜증 섞인 혀를 차며 전화기에 번호를 누른다. 당신은 시야가 검게 변하기 전 간신히 "구급차"와 "응급상황"이라는 단어를 듣는다.
				<<else>>
					<<generateyv1>><<person1>>
					당신은 배를 움켜쥐고 도와달라고 신음한다. 이윽고 헉 하는 숨소리와 함께 발소리가 서둘러 다가온다. 잠시 후 두 사람의 얼굴이 당신 눈앞에 나타난다. 무슨 말인지 이해할 순 없지만 무언가 대화를 나누고 있다는 것을 알 수 있다. 고아 중 한 명은 도움을 청하러 달려가고 다른 <<personsimple>>【은는】 당신의 곁에 쭈그려 앉는다. <<He>>【은는】 이것저것 물어보려 하지만 당신은 대답할 기력이 없다.
				<</if>>
				<br><br>

				얼마나 시간이 흘렀는지 알 수 없지만 이내 사이렌 소리가 들려온다. 구급대원들이 당신을 들것에 싣고 대기 중이던 구급차 안으로 밀어 넣는다. 구급차가 출발하며 흔들릴 때 모든 것이 까맣게 변한다.
			<<case "hospital">>
				접수처에 다다르기 전, 한 발자국도 더 나아가지 못하고 쓰러진다. 놀란 외침 소리와 함께 다급한 발소리가 몰려든다. 여러 손이 뻗어와 맥박을 재고 체온을 확인한다.
				<br><br>

				"걱정 마세요," 낯선 목소리가 안심시킨다. "우리가 잘 돌봐 드릴 겁니다." 당신은 더 이상 버티지 못하고 기절한다.
			<<case "trash">>
				쓰레기 더미 사이에서 비틀거리다 두 다리의 힘이 갑자기 풀려 쓰러진다. 쓰레기 무더기에 기대어 땅으로 가라앉는다. 따뜻하고 축축한 무언가가 다리를 타고 흘러내린다. 산기가 다가오고 있다!
				<br><br>

				당신은 호흡을 가다듬으며 주변을 살핀다. 악취가 방해한다. <i>이런 곳</i>에서 아기를 낳을 순 없다!
				<br><br>
				<<if $speech_attitude is "meek">>
					"도-도와주세요..." 당신이 훌쩍인다. 대답이 없다. 떨리는 숨을 내쉬며 목소리를 높인다. "도와주세요!!"
				<<elseif $speech_attitude is "bratty">>
					"제... 제 말 들리세요!?" 욕설과 함께 이를 악물고 어떻게든 목소리를 쥐어짜려 해보지만 실패한다. "도움이 필요해요!"
				<<else>>
					"거기 누구...?" 당신의 목소리는 희미하게 잦아들고, 아무런 반응도 없다. 심호흡을 하고 다시 시도한다. "거기 누구 없어요!?"
				<</if>>
				<br><br>

				<<if $rng gte 86 and $hallucinations gte 2>>
					당신이 기대어 있던 쓰레기 무더기가 흔들리자 신음하며 웅크린다. 고개를 들자 외눈박이 눈이 당신을 똑바로 노려보고 있다. <<ghallucinogens>><<set $hallucinogen += 90>>
					<br><br>

					그것은 당신의 몸을 살펴보더니 험악해 보이던 눈길이 조금 부드러워진다. 외눈이 다시 당신의 얼굴을 들여다보고, 그것의 날카로운 응시에 당신의 정신이 마비되고 흐려지는 것을 느낀다. 불안감이 씻은 듯 사라지며, 당신은 기절한 채로 무사히 쓰레기 더미 밖으로 구조될 것이란 확신을 어째선지 느낀다.

				<<elseif $rng gte 71 and Time.dayState is "night">>
					<<npc "Night Monster">>
					근처에서 둔탁한 무언가 내려앉으며 바닥이 진동하자 당신은 신음하며 웅크린다. 본능적으로 배를 보호하듯 껴안는다. <<gstress>><<stress 6>>
					<br><br>

					당신은 거대한 형체가 당신의 얼굴과 배의 냄새를 킁킁대며 맡는 것을 보고 듣는다. 당신은 배를 더욱 꽉 껴안는다. 그것이 물러나고 올려다본 당신 앞엔 커다랗고 뿔이 달린 거대한 비늘 덮인 머리가 나타난다.
					<<if $NPCList[0].monster is "monster">>
						"새끼를 가졌군." <<person1>><<nightMonsterText>>【이가】 부드럽게 으르렁거린다. "이곳은... 새끼에게 나빠."
					<</if>>
					당신의 부른 배를 유심히 보더니, <<bhe>>【은는】 <<= $NPCList[0].monster is "monster" ? "앞다리로 당신을 감싼다" : "부드럽게 으르렁거리곤 조심스레 앞다리로 감싸 안는다">>.
					<br><br>

					<<bHe>>【이가】 당신을 들어 올린다. <<bhe>>【이가】 쓰레기장을 박차고 나이팅게일 거리로 뛰어오르는 동안 어지럽고 구역질이 난다. 눈을 떠 보니 <<bhe>>【이가】 병원 앞에 당신을 조심스레 내려놓고 있다. <<nightMonsterText>>【은는】
					<<if ($beauty gte ($beautymax / 7) * 4) or $nightMonsterIntro gte 2>>
						크고 발톱이 달린 손을 당신의 <<= $NPCList[0].monster is "monster" ? "배에 올린다. \"다음번엔 내 것이다.\"" : "배에 올리고 낮게 그르렁거린다.">> 당신은 몸서리치며 병원 쪽으로 뒷걸음치고 <<bhe>>【은는】
					<</if>>
					당신이 뒤뚱거리며 걸어가는 것을 주시한다. 간신히 정문을 지나쳐 바닥에 비틀거리며 쓰러지고 의식이 옅어진다. 마지막으로 본 것은 그림자 속에서 당신을 노려보는 한 쌍의 빛나는 노란 눈동자다.

				<<else>>
					<<generatey1>><<generatey2>><<generatey3>><<generatey4>><<generatey5>><<generatey6>>
					당신은 무리를 지어 다가오는 <<group>>【을를】 보고 신음하며 웅크린다.<<if $trauma gte ($traumamax / 5) * 2>> 저들이 당신을 약탈하려 온 것이 아니기를 바란다.<</if>>
					<br><br>

					"내가 저쪽에서 소리가 들렸다고 했지!" 한 <<person1>><<person>>【이가】 말한다. "어이, <<girl>>! 괜찮아!?"
					<br>
					<<if $settings.watersportsEnabled>>
						그 무리의 <<person2>><<person>>【이가】 비웃는다. "저 <<pshe>> 오줌 싼 거 아냐?"
					<<else>>
						"저 <<pshe>> 왜 홀딱 젖었지?" 한 <<person2>><<person>>【이가】 묻는다.
					<</if>>
					<br>
					<<if $speech_attitude is "bratty">>
						"나 지금 애 낳기 직전이라고, 이 멍청아!" 당신이 쏘아붙인다. "그러니까 <i>제발</i> 여기서 좀 빠져나가게 도와주지 않을래!?"
						<br>
						"아." 그 <<person2>><<person>>【이가】 눈을 껌뻑인다. "아! 그래, 당연하지!" <<He>>【은는】 친구들을 향해 고개를 돌린다. "내가 어깨 쪽을 잡을 테니, 너희가 다리 쪽을 잡아." <<person3>><<person>>【와과】 <<person4>><<person>>【이가】 고개를 끄덕이고 자세를 고친다.
					<<else>>
						<<person3>><<person>>【이가】 눈알을 굴린다. "임신한 거잖아, 이 바보야!"
						<br>
						"아." 그 <<person2>><<person>>【이가】 눈을 껌뻑인다. "아! 우리가 당장 뭘 좀 해야겠네! 얘를 여기서 구해주자고!"
					<</if>>
					<br><br>

					도움을 주는 이들에게 고맙다는 신음을 짜내 보려 하지만 당신을 옮기려는 그들의 손길이 닿자 날카로운 고통이 온몸을 휘감는다. 의식을 잃어가며 이들이 가장 가까운 출구로 안내하는 과정이 희미하게 귓가를 맴돈다.
					<<famepregnancy 3>>
				<</if>>
			<<case "sea">>
				수영을 하던 중 수축이 당신을 사로잡는다. 고통이 몰려와 허우적대며 살려달라고 외친다. 통증이 악화되고 물에 뜨려고 허우적거린다.
				<<if $rng gte 71>>
					<<generatedolphin1>>
					정신을 잃을 즈음 무언가 부딪혀 황급히 시선을 내린다.
					<br><br>

					시야는 흐릿하지만, <<beasttype>>의 모습이 간신히 눈에 띈다. <<bHes>> 당신을 강 기슭 쪽으로 끈기 있게 밀어준다. 절박하게 <<bhis>> 지느러미를 움켜쥔다.
					<br><br>

					<<beasttype>>【은는】 당신을 모래사장까지 이끌어 내려놓고 안절부절못하며 클릭거리는 소리를 낸다. 멀리서 비치객이 소리치는 소리가 들리더니 <<beasttype>>【은는】 황급히 물속으로 몸을 숨긴다. 뒤따라 달려온 사람들에게 감사 인사를 중얼거리다 눈앞이 캄캄해지며 기절한다.
				<<else>>
					뱃고동 소리가 들리더니 어선이 당신을 향해 미끄러져 들어오는 것이 보인다. 부두에서 목소리들이 웅성거리고, 어망이 몸을 휘감더니 갑판 위로 끌어 올린다. "도움이 꽤 필요해 보이는데," 한 <<generate1>><<person1>><<person>>【이가】 말한다. "무임승차는 안 되지만, 넌- 아. <i>아!</i> 임산부잖아!"
					<br><br>

					<<if $speech_attitude is "meek">>
						"산기가 오고 있어요," 몸을 웅크리고 부른 배를 움켜쥔 채 울먹인다. "제-제발 살려주세요..."
					<<elseif $speech_attitude is "bratty">>
						"그냥 임신이 아니에요. 전—" 강한 수축이 당신을 강타하자 몸을 움찔한다. "나올 것 같아요. 도와줄 건가요 말 건가요?"
					<<else>>
						부두에 웅크리며 간신히 입을 연다. "산기가 와요. 도와주세요, 제발!"
					<</if>>
					<br><br>

					"해안가로 데려다줄 테니 버텨요, 약속할게요," 한 <<person>>【이가】 선원들을 걱정스레 돌아보며 말한다. "알겠죠?" 선원 중 하나가 당신의 손을 잡아주는 사이 시야가 어두워지고 정신을 잃는다.
				<</if>>
			<<case "shop">>
				<<generate1>><<person1>>
				쇼핑센터 한복판에 쓰러진 채 배를 감싸 안고 무릎을 꿇는다. 허벅지를 따라 양수가 흐르기 시작한다. 산기가 다가오고 있다.
				<br><br>
				<<if Time.dayState isnot "night">>
					사람들은 고개를 숙이고 의아한 눈길로 당신을 바라보며 주변을 지나간다. 고통이 걷잡을 수 없게 커지고 결국 비명을 지르기 시작한다.
				<<else>>
					이 야밤엔 주위에 아무도 없지만 보안 요원이 알아주길 절박한 마음으로 소리친다.
				<</if>>
				"제-제발 도와주세요! 구급차를 불러주세요!" 부르짖는다.
				<br><br>

				<<if Time.dayState is "night">>
					"이봐!" 누군가 소리친다. "여기에 있으면 안 되- 아. 아, 이런 썅!" 당신의 손을 잡으며 곁에 무릎을 꿇는다.
				<<else>>
					근처 상점 직원 하나가 당신 곁으로 달려오더니 무릎을 꿇고 당신 손을 덥석 잡는다.
				<</if>>
				<br><br>

				<<He>>【이가】 <<= Time.dayState is "night" ? "무전기" : "전화">>【을를】 꺼내 들고 얘기하지만, 너무 아파서 <<he>>【이가】 무슨 말을 하는지 들리지 않는다.
				<br><br>

				<<He>>【이가】 손을 꽉 쥐어주자 무의식에 빠지면서도 약간의 안정감이 든다.
			<<case "roof">>
				<<generate1>><<person1>>
				당신은 옥상에 풀썩 주저앉는다. 따뜻한 액체가 다리를 타고 흐른다. 산기가 다가오고 있다.
				<br><br>

				사람들 이목을 끌어보려 소리를 꽥 질러본다. 하지만 옥상 문은 굳게 닫혔고 누구 하나 도와주러 올 리 없다는 절망감이 엄습한다.
				<br><br>

				고통스러운 수축이 전신을 후벼파며 당신은 이전보다 더 크게 절규한다. 마침내 옥상 문이 벌컥 열리고 제복 입은 불만투성이의 <<personsimple>>【이가】 나타난다. "뭐 하는 거- <i>이런 시발</i>." <<He>>【은는】 놀란 듯 허둥지둥 달려온다.
				<br><br>

				<<he>>【이가】 휴대폰을 꺼내 통화를 시작하는 걸 지켜본다. 모든 게 새까맣게 멀어지는 와중 안도감이 퍼진다.
			<<case "monsterTower">>
			<<case "street">>
			<<case "compound">>
			<<case "temple">>
				비틀거리다 의자에 부딪혀 간신히 균형을 잡는다. 두 다리가 달달 떨린다. 산기가 다가오고 있다.
				<br><br>

				누군가의 단단한 두 팔이 당신을 번쩍 안아 의자에 가만히 눕혀준다.
				<<if C.npc.Jordan.init is 1>>
					조던의 얼굴이 당신 위로 떠오른다.
				<<else>>
					어두운 로브를 걸친 형체가 걱정스러운 듯 젊은 얼굴을 기울인다. 두건 양옆으로 흘러내린 황금빛 머리칼이 눈에 띈다.
				<</if>>
				자신을 향해 무어라 웅성거리는 소리가 들리지만 알아들을 수 없다. 이내 로브를 걸친 다른 무리도 당신 주변을 둘러싼다.
				<<if _sydney_location is "temple" and C.npc.Sydney.init is 1>>
					시드니가 군중 사이로 비집고 나타나더니 조금 떨어진 곳에 멈춰 선다.
				<</if>>
				<br><br>

				몸이 번쩍 허공으로 들어 올려지는 걸 느낀다.
			<<case "cave">>
				<<if $cave lt 50>>
					물속을 헤쳐 나아가려던 찰나 갑작스런 수축이 밀려와 차가운 물살 앞으로 고꾸라지고 만다. 배의 무게에 수축의 끔찍한 진통이 합쳐져 제대로 설 수도, 헤엄조차 칠 수도 없다.
					<br><br>

					거센 물살이 계속 몸을 들이치고 미끄러운 바닥에서 맥없이 버둥거린다. 조금만 용을 써도 진통은 더욱 날카롭게 몸을 파고든다. 아무런 힘도 못 쓰고 체념한 채 물결이 이끄는 대로 쓸려갈 수밖에 없다.
					<br><br>
					의식을 서서히 잃어가는 와중에 물결에 몸을 맡긴다.
				<<else>>
					갑작스레 날카로운 수축이 당신의 몸을 조인다. 양수가 허벅지를 타고 뚝뚝 떨어지고 무릎이 푹 꺾인다. 파도처럼 밀려오는 극심한 고통이 연이어 들이치며, 자신도 모르게 가쁜 숨만 헐떡인다. 터질 듯 부풀고 묵직한 배를 움켜쥔 채, 차갑고 눅눅한 벽에 기댄 채 스러진다.
					<br><br>
					<<if $pursuit gte 2>>
						희미한 소음이 귓가에 울린다. 쫓아오던 자가 험악한 놈일지 몰라도, 지금은 의사가 먼저다. 목청 높여 소리쳐 부른다.
					<<else>>
						동굴엔 오로지 물방울 떨어지는 소리만이 고요히 울려 퍼질 뿐이다. 주변에 도와줄 사람 하나 없이 혼자라는 사실에 당신은 소리를 질러본다.
					<</if>>
					<<if $speech_attitude is "meek">>
						"도-도와주세요... 거기 누구 없나요? 제발 도와주세요..." 신음을 흘린다. 두려움에 사시나무처럼 떨며 하염없이 눈물을 글썽인다.
					<<elseif $speech_attitude is "bratty">>
						"<<= $pursuit gte 2 ? "누-누구세요?" : "거-거기 누구 있나요?">> 살려주세요! 서둘러요!" 고래고래 악을 쓴다. 한껏 날카롭고 앙칼진 목소리는 고통에 휩싸이자 이내 비명처럼 갈라진다.
					<<else>>
						"도와줘요! 누구 없어요! 제-제발?" 침착하려 노력해도 미친 듯이 덜덜거리는 목소리만큼은 숨길 수 없다.
					<</if>>
					<br><br>

					<<if ($pursuit gte 2 and $rng gte 61) or $pursuit lt 2>>
						<<npc Wren>><<person1>>
						<<if $pursuit gte 2>>
							도움을 요청하는 목소리가 잠잠해지자, 침묵만이 감돈다. 조금 전 들렸던 소음이 환청인 마냥 가끔 뚝뚝 떨어지는 물소리만이 동굴을 울릴 뿐이다.
						<<else>>
							어떤 응답도 돌아오지 않고, 질식할 듯한 침묵뿐이다.
						<</if>>
						벽을 잡고 억지로 발을 내디뎌 보려 하지만, 출산 진통이 지나치게 심하다. 동굴 바닥에 결국 쓰러진다.
						<br><br>

						고요함을 깨뜨리듯 가벼운 발소리가 들려온다. 누군가 당신을 살며시 안아 든다.
						<<if $wrenSeen?.length>>
							한 <<nnpc_gender "Wren">>【이가】 혀를 끌끌 찬다. "다음엔 운이 그리 좋지 못할걸, 작은 도둑님." <<he>>【이가】 말한다. 왠지 낯설지 않은 목소리다.
						<<else>>
							"베일리 그놈은 무슨 꿍꿍이로 임신한 녀석을 여기에 보낸 거야?" 재밌다는 듯 한 <<nnpc_gender "Wren">>【이가】 묻는다.
							<br><br>
						<</if>>
						<br><br>

						눈물 콧물 범벅이 된 채 눈을 가늘게 뜨고 그 사람을 쳐다본다.
						<<if $wrenSeen?.length>>
							<span class="gold">렌이다.</span>
						<<else>>
							<<if $pronoun is "m">>짧은<<else>>어깨 기장의<</if>> 머리를 한 어린 <<woman_npc>>【이】다.
						<</if>>
						<<He>>【이가】 <<his>> 손바닥으로 눈을 가려 시야를 차단한 후 뛰기 시작한다. <<He>>【이가】 포근하게 안아주는 그 품속에, 흔들거리는 안락함마저 느끼며 까무룩 정신을 놓는다.
						<<set $wrenSeen.pushUnique("pregnancy")>>
						<<set $wrenSeenLast to "pregnancy">>
					<<else>>
						<<generatey1>><<generatey2>>
						도움 요청 소리가 머지않아 고통에 찬 신음 소리로 둔갑한다. 터벅대는 발소리에 이어진 웃음소리. "재밌게 노는 소린가 본데!" 한 <<person1>><<person>>【이가】 외친다.
						<br><br>

						"<<pShes>> 꽤 괜찮은 성대를 가졌나 봐," 한 <<person2>><<person>>【이가】 끼어든다. "조금만 손봐주면 목청 찢어지게 신음할 거야." 당신의 둥근 배를 발견한 <<He>>【은는】 그 자리에 굳어버린다. "야, 미친! 저 <<pshe>> 애 낳아?"
						<br><br>

						"지하엔 의사 없단 말야!" <<person1>><<person>>【이가】 당황해서 허둥댄다. "이봐, 같이 좀 옮기자."
						<br><br>

						몸이 붕 뜨는 게 느껴지더니 어둠 속으로 스르르 가라앉는다.
					<</if>>
				<</if>>
			<<case "photo">>
				<<npc Niki>><<person1>>
				비틀대며 간신히 의자에 매달려 균형을 잡는다. 양수가 다리를 타고 줄줄 흐른다. 산기가 다가오고 있다.
				<br><br>

				니키는 눈 하나 깜짝하지 않는다. 무릎을 꿇으며 비명을 지르자 <<he>>【이가】 비로소 컴퓨터에서 눈을 돌려 당신을 힐끗 본다. 살짝 눈이 동그래지더니 후다닥 달려온다. <<He>>【은는】 능숙하게 일으켜 세워 의자에 차분히 앉힌다.
				<br><br>

				"걱정하지 마, 괜찮을 거야," 이미 주머니 속 휴대폰을 만지작거리며 <<he>>【이가】 안심시킨다.
				<br><br>

				어둠이 내리기 직전, 앰뷸런스를 부르는 니키의 목소리가 들린 듯하다.
			<<case "park">>
				가쁘게 숨을 몰아쉬며 <<= either ("벤치 위로 무너지듯 앉는다", "근처 나무에 맥없이 기댄다", "바닥에 털썩 주저앉는다")>>. 따끈한 액체가 허벅지 사이로 끈적하게 배어 나온다. 산기가 다가오고 있다.
				<br><br>
				"도와주세요! 아무나!" 필사적으로 목청을 쥐어짠다. 덮쳐오는 고통에 목소리가 점점 기어들어간다. "아무도 없나요? 제발..."
				<br><br>
				<<if C.npc.Doren.init is 1 and !Time.isWeekEnd() and (Time.hour === 21 && between(Time.minute, 0, 29))>>
					<<npc Doren>><<person1>>
					한 <<= either ("조깅하던 사람", "달리기하던 사람")>>【이가】 즉각 당신에게 다가온다. 도렌이다. <<He>>【이가】 당신이 기댈 수 있도록 똑바로 서는 것을 도와준다.
					<br><br>
					<<He>>【이가】 당신의 어깨를 팔로 감싼다. "<<Lassie>>, 내가 전화해서 곧 올 거야." 청력이 끊겨 <<his>> 단어의 조각들만을 중간중간 잡을 수 있을 뿐이다.
					<br><br>
					눈앞이 새카맣게 멀어지기 전 마지막으로 들은 말은 "내가 네 곁에 있을게"이다.
				<<else>>
					<<generate1>><<person1>>
					한 <<personsimple>>【이가】 당신 곁으로 달려온다. "안녕하세요, 산모가 있어요. 네, 여긴 공원이에요." 통증이 밀려오며 기절할 것 같아 상대가 하는 말이 조각조각 들릴 뿐이다.
					<br><br>
					<<He>>【이가】 팔로 당신의 어깨를 감싼다. "걱정 마, <<girl>>, 구급차가 오고 있으니까. 조금만 버텨."
					<br><br>
					눈앞이 새까매지자, <<He>>【이가】 혼잣말로 중얼거리는 소리가 들린다. "가엾은 <<girl>>. 괜찮을 거다."
				<</if>>
			<<case "prison">>
				무릎을 꿇고 엎어진다. 착각이 아니다, 산기가 오고 있는 거다. 첫 수축이 올 때 당신은 비명을 지른다.
				<br><br>
				<<if $prison.schedule is "lockdown">>
					당신에게 다가오는 군화가 눈에 들어온다. 바로 당신 앞에 멈춘다. 당신은 올려다본다.
					<br><br>

					<<generate_anxious_guard 0>><<person1>>
					<<anxious_guard 0>>【이】다. <<He>>【은는】 인상을 찌푸리며 당신을 내려다본다.
					<br><br>

					"넌 감옥 밖으로 나오면 안 되는데." <<He>>【은는】 불안한 눈빛으로 주위를 둘러본다. "말썽 피우지 말고 조용히 데려갈 테니까 알았어?"
					<br><br>

					<<He>>【은는】 당신이 일어나기를 기다리지만 고통이 너무 크다. <<anxious_guard 0>>【은는】 당신이 고통스러워하고 있다는 걸 파악하는 데 시간이 좀 걸린다. 당신의 불안감이 <<him>>에게 전염된다.
					<br><br>

					"이런 젠장. 여긴 안 돼." <<He>>【은는】 누군가 달려와 자기를 구해 주길 기도하듯 다시금 주변을 둘러본다. "이봐... 움-움직이지 마! 거기 꼼짝 말고 있어!"
					<br><br>

					<<He>>【은는】 당신을 내버려 두고 다급하게 가 버린다. 당신은 배를 파고드는 극심한 통증에 시야가 일렁거리면서도 어떻게든 똑바로 앉으려 버둥거린다. 누군가 고함치는 소리를 듣는 순간 세상이 스러진다.
				<<else>>
					귓가에서 심장이 방망이질 친다. 고통이 수없이 밀려들며 시야가 점점 멀어져 간다. 고개를 들어 보니 사람들에게 에워싸여 있다.
					<br><br>

					"당장 <<phim>> 근처에서 떨어져!" 흐려져 가는 시야 속에서 누군가의 고함이 간신히 들린다. 누군가 당신을 안아 드는 것을 느끼며 세상이 아득해진다.
				<</if>>
			<<case "prisonCell">>
				<<if $prison.schedule is "lockdown">>
					컴컴한 감옥 안에서 침대에 앉는다. 뭔가 축축하다. 다리까지 흥건해졌음을 알아채기까지는 얼마 걸리지 않는다. 산기가 다가오고 있다.
					<br><br>

					공포가 엄습한다.
					<br><br>

					비틀대며 감옥 문을 쾅쾅 두드린다. "도-도와줘!" 경비원의 시선을 끌려 애쓴다.
					얼마 지나지 않아 죄수들이 잠에서 깨어난다. 몇몇은 입 다물라며 호통치고, 몇몇은 무시한다. 누군가는 괜찮냐며 소리친다.
					<br><br>

					<<generate_veteran_guard 0>><<person1>>
					이내 나타난 <<veteran_guard 0 cap>>【이가】 각 방의 문을 두들기며 걸어간다. "소등! 그 말은 주둥이 다물라는 소리야!"
					<br><br>

					결국 당신의 방 앞에 멈춰 선 <<He>>【이가】 미간을 잔뜩 찌푸리며 노려본다.
					"규율 위반 시 받는 징벌이 뭔지 알고—" 다리 사이로 흐르는 오물을 보고 <<He>>【은는】 말문이 막힌다.
					<br><br>

					"제-제발 도와주세요." 시야가 흐릿해지는 와중 당신은 속삭인다.
					<<veteran_guard 0 cap>>【은는】 서둘러 열쇠를 꺼내 문을 연다. 무릎이 풀리며 쓰러지려는 당신을 단단한 팔이 감싼다. 복부에 찌르는 듯한 고통이 퍼진다. 누군가에게 안겨 감옥 밖을 나서는 순간 세상이 까맣게 꺼진다.
				<<else>>
					차디찬 돌바닥 위로 무언가 튀는 소리가 들려온다. 다리 사이가 흥건하다. 산기가 다가오고 있다.
					<br><br>

					당황한 당신은 도움을 요청하러 밖으로 나가보려 한다. 칼로 베이는 듯한 통증에 배를 부여잡은 채 쇠창살에 매달린다.
					<br><br>

					<<generate1>><<person1>>
					"제발 살려주세요!" 복도를 향해 외쳐본다. 다가오며 낄낄대던 어느 죄수가 당신의 상태를 보고 얼어붙는다.
					"시발." <<He>>【은는】 뒤로 주춤거리더니 원래 왔던 길로 냅다 달려간다. 누군가를 부르러 갔기를 바랄 뿐이다.
					<br><br>

					나머지 죄수들은 그냥 무시하고 지나치거나 재미 삼아 구경하려고 걸음을 멈춘다. 돕고 싶어 하는 이들은 소수에 불과하다. 한 사람이 몸을 굽혀 일으켜주려 하지만 누군가 다가오는 것을 보고는 뒤로 슬쩍 물러선다.
					<<endevent>>
					<<generate_methodical_guard 0>><<person1>>
					<<methodical_guard 0 cap>>【이가】 그 죄수를 대동하고 나타난다. <<he>>【이가】 미간을 찌푸리며 노려보자 구경꾼들은 홍해 갈라지듯 자리를 피한다. <<He>>【은는】 무릎을 굽히고 앉아 두 눈으로 꼼꼼히 살핀다.
					<br><br>

					"타이밍 한 번 기가 막히는군," <<he>>【이가】 중얼거린다. "여기엔 출산할 수 있는 설비가 없으니 그냥 여기서 해결할 수밖에."
					<br><br>

					<<methodical_guard 0 cap>>【이가】 일어서며 죄수 두 명에게 당신을 부축하라고 명령한다. 당신은 계단을 내려오며 걷는 둥 마는 둥 질질 끌려간다. 경비원이 무전기로 누군가와 통신하기 시작한다.
					아래층으로 또 내려갈 때 시야가 가물거린다. 무언가 외치는 소리가 들리지만 무슨 말인지 분간도 못한 채 그대로 의식을 잃는다.
				<</if>>
			<<case "prisonLaundry">>
				<<if $prison.schedule is "work">>
					<<generate1>><<person1>>
					뒤편에서 죄수가 키득거리는 소리가 들린다.
					"세탁실이라 다행이네, 엉?" 당신을 힐끗 보며 얄밉게 웃는다. "깨끗하게 빨아줄 손이 좀 필요하겠는데."
					<br><br>

					전율과 함께 아찔한 고통이 몸을 관통한다. 산기가 다가오고 있다. 죄수는 음흉하게 웃으며 슬그머니 다가온다.
					<br><br>

					"어이, 뒤로 물러나. 당장," 누군가 단호하게 지시한다.

					<<generate_relaxed_guard 1>><<person2>>
					당신의 뒤에서 <<relaxed_guard 1 cap>>【이가】 나타나자, 그 죄수는 기분 나쁜 얼굴로 돌아서며 <<person1>>자기 할 일을 하러 자리를 뜬다. <<person2>><<He>>【은는】 당신의 다리를 내려다보지만 질문할 틈도 주어지지 않는다. 고통이 다시 한번 뱃속을 할퀴고 당신은 그대로 몸을 구부린다.
					<br><br>

					"도-도와주세요... 아이가..." 숨을 헐떡이며 웅얼거린다.
					<br><br>

					<<relaxed_guard 1 cap>>【이가】 팔꿈치를 잡아당겨 몸을 세워준다.
					<br><br>

					"아직 형살이를 시작하기엔 좀 너무 어린 놈이네, 엉? 가자고. 스펙스는 네놈이 여기서 조그만 꼬맹이를 낳았다간 가만있지 않을 거야." <<his>> 목소리가 희미하게 귓가를 맴돈다. 지끈거리는 두통을 억누르며 간신히 정신을 부여잡으려 노력한다. 모든 감각이 아스라히 스러진다.
				<<else>>
					<<generate_relaxed_guard 0>><<person1>>
					아래를 내려다보니, 양쪽 다리 사이로 맑은 액체가 방울져 떨어지고 있다. 뱃속에 고통의 응어리가 자란다. 산기가 왔다.
					<br><br>

					"누-누구 없나요?" 비틀대며 문 쪽을 향해 외친다. "도-도움이 필요해요!" 문틀을 꽉 쥔다.
					<br><br>

					"작업 시간 끝났어." <<relaxed_guard 0 cap>>【이가】 다가오며 여전히 주사위 장난을 치고 있다. "나를 재밌게 해 줄 작정이 아니라면 기계는 켜 주지 않을—"
					<br><br>

					<<His>> 눈길이 당신의 다리를 향한다. 이내 무슨 일인지 깨달은 듯 <<His>> 미소가 서서히 거두어진다.
					<br><br>

					"씨발." <<relaxed_guard 0 cap>>【은는】 주위를 잠시 둘러보더니 이내 당신의 허리를 팔로 감는다. "따라와, 144번 죄수 주니어를 여기서 낳을 순 없지."
					<br><br>

					배에 밀려오는 고통에 기절하지 않으려 필사적으로 견딘다. <<relaxed_guard 0 cap>>【이가】 무어라 말하지만 고통에 휩싸여 들리지 않는다. 세상이 아득해지고 마지막으로 누군가의 처절한 외침만이 메아리친다.
				<</if>>
			<<case "prisonCanteen">>
				<<if ["wake", "lunch", "dinner"].includes($prison.schedule)>>
					<<generate1>><<generate_methodical_guard 1>>
					비틀대며 간신히 탁자에 도달해 빈자리에 쓰러진다. 죄수들 두어 명이 노골적인 눈빛으로 위아래를 훑는다. 당신의 다리 사이로 고인 작은 웅덩이가 긴 벤치를 따라 흘러내린다. 산기가 다가오고 있다.
					<br><br>

					배를 움켜쥔 채 엎어진 당신을 보며 한 죄수가 낄낄거린다. "다들 배고프신가 보군." <<He>>【은는】 가랑이를 쥐며 색골 같은 웃음을 흘린다. "내가 바로 밥 먹여 줄—"
					<br><br>

					날카로운 통증에 절규하자 그 놈이 기겁하며 뒤로 내빼버린다.
					<br><br>

					비명을 들은 <<person2>><<methodical_guard 1>>【이가】 성큼성큼 다가온다. <<His>> 시선이 당신의 다리 사이에 멈추자 <<His>> 낯빛이 순식간에 굳어버린다.
					<br><br>

					<<methodical_guard 1 cap>>【이가】 서둘러 당신을 일으켜준다. <<He>>【이가】 뭐라 씨부리긴 하는데, 암흑 속으로 가라앉는 와중이라 무슨 개소리인지도 알아들을 수가 없다.
				<<elseif $prison.schedule is "lockdown">>
					<<generate_anxious_guard 0>><<person1>>
					테이블 쪽으로 비틀비틀 다가가다 벤치에 주저앉는다. "도-도와줘요!" 빈 식당에 당신의 처절한 외침이 울려 퍼지지만, 대답은 없다. 배를 움켜쥔 채 새우등을 하고 발소리가 들릴 때까지 목놓아 부르짖는다. 누군가 플래시 불빛을 비추어 눈부심에 고개를 치켜든다.
					<br><br>

					<<anxious_guard 0>>【이】다. <<He>>【은는】 인상을 찌푸리며 당신을 내려다본다.
					<br><br>

					"방에서 나오면 안 되는 거잖아." <<He>>【은는】 불안한 듯 주위를 둘러본다. "소란 피우지 말고 얌전히 돌아가자, 어?" <<He>>【은는】 당신이 일어나기를 기다리지만, 통증이 너무 극심하다. 잠시 후에야 <<him>>도 상황을 파악한다. "안 돼. 여기서 이러면 안 되는데. 아, 맞다, 소리쳐서 도움을 청하고 있었지..." 누군가 나타나 자신을 구해 주기를 간절히 기도하는 듯, <<He>>【은는】 다시 주위를 둘러본다. "저기... 우, 움직이지 마! 거기 가만히 있어!"
					<br><br>

					<<He>>【은는】 당신을 깜깜하고 텅 빈 식당에 내버려 두고 헐레벌떡 뛰어간다. 뱃속을 파고드는 무자비한 고통에 시야가 어지럽지만 억지로 몸을 일으켜보려 한다. 누군가 내지르는 호통이 귓전을 때리는 찰나 암전된다.
				<<else>>
					<<generate1>><<person1>>
					한 테이블 곁으로 다가가 벤치에 그대로 털썩 주저앉는다. 허벅지를 타고 끈적한 물기가 줄줄 흐른다. 산기가 다가오고 있다.
					<br><br>

					비명 소리에 식당 밖을 지나던 어느 죄수의 눈길을 잡아끈다. 배를 움켜잡고 나뒹구는 모습을 보며 <<He>>【은는】 비웃음을 흘린다. "먹을 게 그리 없었냐?" 색욕에 찬 음흉한 미소와 함께 가랑이를 콱 움켜쥔다. "내가 뭘 좀 먹여 줄—"
					<br><br>

					당신의 찢어지는 비명에 그 새끼도 뒷걸음질을 친다. 몸을 굴려 벤치에서 미끄러진 채 웅크린다. 식당에 하나둘 기어들어 오는 발소리와 수군거림이 희미해져 갈 때쯤, 마침내 의식의 끈이 뚝 끊어진다.
				<</if>>
			<<case "prisonMedical">>
				<<generate_methodical_guard 0>><<person1>>
				뱃속이 요동치자 당신의 입술 사이로 신음이 샌다. 산기가 왔다. 그걸 눈치챈 <<methodical_guard 0>>【이가】 서둘러 뛰어온다.
				<br><br>

				<<He>>【은는】 허비할 시간이 없다. <<methodical_guard 0 cap>>【은는】 당신의 팔뚝을 억세게 잡아채고는 빈 침대 쪽으로 잡아끈다.
				"산기가 왔군," <<he>>【이가】 툭 내뱉는다. 침대에 몸을 누이기도 전에 새로운 고통이 파도처럼 밀려와 배를 부여잡게 만든다.
				<br><br>

				제대로 된 호흡조차 내쉴 수 없을 때 등을 받쳐 주는 침대가 이토록 고마울 수 없다. 깜빵 구석에서 애 낳는 건 피하고 싶었지만 그래도 병실이라는 게 어디란 말인가.
				<br><br>

				극심한 고통에 머리가 핑 돈다. 어찌어찌 몸을 눕힌 뒤 그대로 까무러친다.
			<<case "prisonYard">>
				<<if $prison.schedule is "yard">>
					<<generate_veteran_guard 0>><<person1>>
					당신은 배를 움켜쥔 채 마당 한가운데 쓰러진다. 죄수들이 손가락질하며 쏟아붓는 야유와 비웃음만이 메아리친다. 허벅지를 타고 바닥에 쏟아지는 물방울. 산기가 오고 있는 것이다.
					<br><br>

					"시끄럽게 굴지 마!" 당신을 향해 걸어오며 <<veteran_guard 0>>【이가】 일갈한다. 비명과 함께 당신이 오열하자 그 자리에 못 박힌 듯 멈춰선다. 몇몇 죄수들은 구경하려고 득달같이 달려온다.
					<br><br>

					새로운 고통이 또 한 번 전신을 휩쓸며 당신은 암전 속에 가라앉고 남은 건 귓가에 울리는 <<veteran_guard 0>>의 고함소리뿐이다.
				<<elseif $prison.schedule is "lockdown">>
					<<generate_anxious_guard 0>><<person1>>
					마당 한가운데 쓰러져 버렸다. "살려줘!" 누가 듣건 말건 울부짖는다. 아무 대답이 없다. 발소리가 들릴 때까지 배를 움켜쥐고 소리 없는 눈물만 쏟아낸다. 누군가 비추는 눈부신 플래시 불빛을 마주하며 고개를 든다.
					<br><br>

					<<anxious_guard 0>>【이】다. <<He>>【은는】 인상을 찌푸리며 당신을 내려다본다.
					<br><br>

					"방에서 나오면 안 되는 거잖아." <<He>>【은는】 불안한 듯 주위를 둘러본다. "소란 피우지 말고 얌전히 돌아가자, 어?" <<He>>【은는】 당신이 일어나기를 기다리지만, 통증이 너무 극심하다. 잠시 후에야 <<him>>도 상황을 파악한다. "안 돼. 여기서 이러면 안 되는데. 아, 맞다, 소리쳐서 도움을 청하고 있었지..." 누군가 나타나 자신을 구해 주기를 간절히 기도하는 듯, <<He>>【은는】 다시 주위를 둘러본다. "저기... 우, 움직이지 마! 거기 가만히 있어!"
					<br><br>

					<<He>>【은는】 마당에 덩그러니 남겨둔 채 뒤도 돌아보지 않고 달아난다. 배를 관통하는 어마어마한 고통에 시야가 일렁거리고 제 몸 하나 가누기도 벅차다. 다른 누군가의 고함과 동시에 완전히 기절하고 만다.
				<<else>>
					<<generate1>><<person1>>
					마당 복판에 꼬꾸라진 채 서성이던 죄수들의 호기심 어린 시선을 한 몸에 받는다. 다리 사이로 질척하게 새는 물방울이 땅을 적신다. 산기가 왔다.
					<br><br>

					"누가 엎어졌나 본데?" 죄수 하나가 조롱 섞인 투로 재잘거린다. "보아하니 이 <<bitch>>【은는】 —"
					<br><br>

					배를 감싸며 내지르는 새된 비명에 뒤로 자빠진다. 곁에 있던 놈이 웅덩이를 지적하자 그놈 안색도 시퍼렇게 질려버린다. 이내 죄책감이 치민 듯 꿍얼거린다. "야, 좀 일으켜. 경비 놈들한테 데려다 줘야겠어."
					<br><br>

					희미해져 가는 시야 속에서 두 놈의 목소리도 점점 먹먹해진다. 몸뚱어리가 붕 떠오르는 착각과 함께 깊은 어둠에 잠긴다.
				<</if>>
			<<case "prisonBeach">>
				비틀거리다 해변 위로 처박힌다. 모래사장 위를 축축이 적시는 물방울. 산기가 찾아왔다.
				<br><br>

				<<if (Time.hour is 12 or Time.hour is 14) and !$prison_wren_intro and Time.weekDay is 6>>
					<<npc Wren>><<person1>>
					배 위에서 렌이 호탕하게 소리친다. "폼은 그리 우아하지 못한데?" <<He>>【은는】 키득거린다. "모래사장이 그토록—아, 젠장."
					<br><br>

					쿵 떨어지는 둔탁한 소리가 나더니 이내 당신 머리맡에 렌이 무릎을 굽힌다. 당신의 손목을 홱 채고는 뭐라 지껄이는데 웅웅거릴 뿐 들리지 않는다.
					<br><br>

					아득한 암흑 너머로 몸이 들리는 것을 느낀다.
				<<else>>
					이런 구석진 곳에 처박혀서 누군가 발견은 해줄까, 설령 늦은 게 아닐까 두려움이 엄습한다. 전신을 조각내는 고통에 입술을 질끈 물고 비명을 참는다.
					<br><br>

					참아보려 해도 끝내 비명이 입술을 비집고 찢어질 듯 터져 나온다. 흐르는 눈물은 모래알 사이로 쓸쓸히 스며든다.
					<br><br>

					희미한 형체들이 물속에서 움직이고, 당신은 고통 대신 그 형체들에 집중하려 애쓴다. 시야가 어두워지기 시작하면서 형체들은 시간이 지남에 따라 흐릿해진다.
					<br><br>

					당신은 눈을 감고 텅 빈 무의식 속으로 빠져든다.
				<</if>>
			<<case "prisonShowers">>
				<<if $prison.schedule is "wake">>
					<<generate_veteran_guard 0>><<person1>>
					당신은 다른 죄수들을 지나쳐 비틀거리며 걷다가, 벽에 기대어 몸을 지탱한다. 뚜렷하고 따뜻한 액체가 다리를 타고 흐르기 시작한다. 당신은 진통을 겪고 있다.
					<br><br>

					"어이, 조심해, 이 멍청한 <<bitch>>【아야】!" 한 죄수가 당신을 밀쳐 무릎을 꿇리며 소리친다.
					<br><br>

					수축이 시작되자 당신은 배를 부여잡고 고통에 비명을 지른다. 죄수가 비웃는다. "조금 넘어진 것 가지고 유난 떨지 마. 징징대는 새끼."
					<br><br>

					"그만해," <<veteran_guard 0>>【이가】 두 사람에게 다가오며 말한다. "그리고 너, 이 망할—" <<He>>【은는】 말을 멈추더니, 다른 무언가를 말한다. 당신을 압도하는 고통 때문에 <<his>> 말을 알아들을 수 없다.
					<br><br>

					물이 피부를 때리자 구역질이 나고 방향 감각을 잃기 시작한다. 무의식으로 빠져들기 직전, 누군가의 손이 당신의 어깨를 붙잡고 끌어올린다.
				<<else>>
					<<generate_veteran_guard 0>><<person1>>
					당신은 비틀거리다 타일 바닥에 쓰러진다. 따뜻한 액체가 허벅지를 타고 흐른다. 당신은 진통을 겪고 있다. 수축이 시작되자 고통에 배를 부여잡고 큰 소리로 비명을 지른다.
					<br><br>

					"샤워 시간 끝났다," <<veteran_guard 0>>【이가】 방 안으로 걸어 들어오며 말한다. "가서 생산적인 일이나 해, 안 그러면—" 무거운 발소리가 쓰러진 당신의 몸 쪽으로 다가오고, 고개를 들어보니 <<veteran_guard 0>>【이가】 당신을 내려다보고 있다. <<His>> 입이 움직이지만, 너무 고통스러워서 무슨 말을 하는지 알아들을 수 없다.
					<br><br>

					시야가 흐려지기 시작할 때 단단한 손이 당신의 어깨를 붙잡고, 당신은 의식을 잃고 만다.
				<</if>>
			<<case "pound">>
				<<run delete $pound.door>>
				<<endevent>>
				창살 사이로 밖을 내다보며, 당신은 불편하게 몸을 뒤척인다. 더 많은 액체가 당신 아래 콘크리트 바닥에 고인다. 당신은 진통을 겪고 있다.
				<br><br>

				옆 사육장에서 낑낑거리는 소리가 들린다. 다른 <<pound_text>>【이가】 무슨 일이 일어나고 있는지 냄새로 맡은 것이다.
				<br><br>

				"거기 누구 없어요?" 당신은 사육장의 창살을 부여잡고 소리친다. 여기서 아이를 낳을 수는 없다.
				<br><br>

				몇 분이 지나도 도와주러 오는 사람이 없다. 하반신 전체로 고통이 점차 퍼져나가자 당신의 외침은 더욱 다급해진다.
				주변의 <<pound_text>>【은는】 당신의 고통스러운 헐떡임에 반응하여 점점 더 크게 낑낑거리더니, 급기야 짖고 으르렁거리기 시작한다. 누군가 확인하러 오기에 충분할 정도로 큰 소란이다.
				<br><br>

				<<generate1>><<person1>>
				<<person>>【이가】 사육장 쪽으로 걸어온다. <<He>>【은는】 안쪽을 손전등으로 비추며 소리를 지르고 창살을 내리친다. 당신에게 다다르자 <<he>>【은는】 멈춰 선다.
				<br><br>

				"아, 씨발!" <<he>>【이가】 소리치고는 사육장을 뛰쳐나간다. 구조가 오고 있는 건지 확신할 수 없고, 고통이 너무 심해져서 제정신을 유지하기 어렵다.
				<br><br>

				모든 것이 너무 버겁다. 소란스러운 소리가 귓가에 울리는 가운데 당신의 눈이 스르르 감긴다.
			<<case "edencabin">>
				<!--
				<<if couldBeDonor($_pregnancy, "Eden")>>
					Eden thinks it's his child?
				<<else>>
				<</if>>
				-->
				<<endevent>>
				허벅지가 축축해지고, 날카로운 고통이 느껴지기 시작한다. 당신은 진통을 겪고 있다.
				<<if $edenbed is 1>>
					에덴은 여전히 깊게 잠들어 있다.
				<<elseif Time.hour gte 11 and Time.hour lte 14>>
					에덴은 사냥을 나가서, 지금 당장 당신을 도와줄 수 없다.
				<<else>>
					에덴은 자신의 일을 하느라 바빠서 당신이 패닉에 빠진 것을 눈치채지 못했다.
				<</if>>
				<<if $worn.neck.collared is 1 and $worn.neck.type.includes("leash")>>
					<<detach_leash>>
					당신은 목줄이 끊어지길 바라며 필사적으로 잡아당긴다. 마지막 몇 가닥의 질긴 실들이 버티고 있다. 패닉에 빠진 당신은 실을 물어뜯기 시작한다. 마침내 줄이 끊어지자 안도감이 밀려온다.
				<</if>>
				<br><br>

				수축의 고통이 시작되면서 당신은 비틀거리며 숲으로 들어간다. 어디로 가고 있는지도 모른다.
				<<if $syndromeeden is 1>>
					오두막으로 다시 돌아가려던 찰나, 왼쪽에서 나뭇가지가 부러지는 소리가 난다.
				<<else>>
					알 수 없는 거리만큼 걷다가 아드레날린이 몸에서 빠져나가며 더 이상 계속할 수 없을 정도로 지쳐 멈춰 선다. 왼쪽에서 나뭇가지가 부러지는 소리가 난다.
				<</if>>
			<<case "drain">>
			<<case "school">>
				<<if !["early", "late", "earlynoschool", "latenoschool", "daynoschool"].includes($schoolstate)>>
					<<switch $bus>>
						<<case "schoolfrontcourtyard" "schoolrearcourtyard">>
							<<generatey1>><<person1>>
							당신은 자기 발에 걸려 비틀거리다가 흙바닥에 세게 넘어진다. 옆으로 굴러 누웠지만, 또 다른 수축의 파도가 덮쳐와 일어나려고 발버둥친다.
							<br><br>

							당신이 쓰러지자 학교 운동장에 있던 사람들의 시선이 쏠린다. 당신이 정교한 장난을 치고 있다고 생각하는지 어색한 웃음소리가 희미하게 들린다. 잠시 후 당신이 배를 부여잡고 땅에 계속 누워 있자 운동화 한 켤레가 시야에 들어온다. 당신에게 다가온 <<personsimple>>【은는】 당신의 배를 한 번 쳐다보더니 욕설을 뱉으며 도움을 요청한다.
							<br><br>

							우르르 몰려드는 발소리와 걱정스러운 교사의 목소리 같은 것이 들리더니, 이내 모든 것이 사라진다.
						<<case "schoollibrary">>
							세상이 기울며 비틀거리던 당신은 책장에 세게 부딪힌다. 자신의 몸무게를 지탱하지 못한 채 책장에 등을 기댄 채 바닥으로 미끄러져 내린다. 어떤 소리를 낸 것 같았는데, 헉하는 소리와 함께 발소리가 다가오는 것이 들리기 때문이다. 누군가 달려와 당신 옆에 무릎을 꿇는다. 그들의 말이 쏟아지지만, 시야가 까맣게 변해버려 도무지 무슨 말인지 알아들을 수 없다.
						<<default>>
							<<pregnancyPassout "schoolJanitor">>
					<</switch>>
				<<else>>
					<<pregnancyPassout "schoolJanitor">>
				<</if>>
			<<case "schoolCanteen">>
				<<if Time.schoolDay and !["early", "late", "earlynoschool", "latenoschool", "daynoschool"].includes($schoolstate)>>
					시야가 흐려지고 비틀거리다 식탁 모서리를 짚고 간신히 몸을 가눈다.
					<<= $schoolstate is "lunch" ? "급식실이 아무리 바빠도, 당신은" : "당신은">> 주변 학생들의 시선을 끈다. 무릎이 꺾이자 다급한 발소리가 들린다. 한 학생이 선생님을 부르짖고, 이내 교직원 중 한 명이 서둘러 당신 곁으로 온다.

					<<if $schoolstate is "lunch" and C.npc.Robin.init is 1 and $daily.school.lunchEaten isnot 1>>
						<br><br>
						로빈은 눈을 동그랗게 뜨고, 무리 사이를 뚫고 당신에게 다가오려 한다.
					<</if>>

					기절하기 전 마지막으로 들은 것은 선생님이 구급차를 부르라고 소리치는 목소리다.
				<<else>>
					<<pregnancyPassout "schoolJanitor">>
				<</if>>
			<<case "schoolJanitor">>
				<<generate1>><<person1>>
				수축이 당신을 압도하자 당신은 바닥에 비틀거리며 쓰러진다. 고통에 울부짖지만, 주변에는 아무도 없다. 몸을 둥글게 말고 배를 부여잡은 채, 살려달라고 흐느낀다. 영원처럼 느껴지는 시간이 흐른 후, 당신은 청소부가 <<his>> 헤드폰에서 크게 흘러나오는 노래를 따라 부르며 <<= ["schoolfrontcourtyard", "schoolrearcourtyard"].includes($bus) ? "쓰레기통을 끌고 학교 밖으로 나오는" : "바닥을 대걸레로 닦으며 들어오는">> 것을 본다.
				<br><br>

				<<His>> 시선이 당신에게 머물고, <<he>>【은는】 얼어붙는다. "맙소사..." <<He>>【은는】 헤드폰을 벗어던지고는 더듬거리며 핸드폰을 찾아 구조를 요청한다. 세상이 까맣게 흐려지기 전 마지막으로 들은 것은 전화 교환원에게 욕을 해대는 <<his>> 패닉에 빠진 목소리다.
			<<case "schoolPool">>
				<<npc Mason>><<person1>>
				수축이 몰려오자 헉하고 숨을 들이켜며 팔다리에서 힘이 빠져나간다. 잠시 물속으로 가라앉자 염소 처리된 물이 입안을 가득 채운다. 당신은 물 밖으로 머리를 내밀기 위해 허우적거리며 패닉에 빠진다. 갑자기 강인한 두 팔이 당신을 감싸안아 물 밖으로 끌어올려 미끄러운 타일 위로 눕힌다. 단호하고 흔들림 없는 손길이 당신을 옆으로 눕히자 당신은 기침하며 물을 뱉어낸다.
				<br><br>

				"어이쿠, 무슨 일이야?" 메이슨이 당신 위로 몸을 숙이며 걱정스럽게 묻는다. "좀 더 조심해야지, 만약에..." 당신이 조심스럽게 배를 감싸 쥔 모습을 보자 <<his>> 목소리가 잦아든다. "진통이 온 거야? 지금?" 패닉에 빠진 <<he>>【은는】 고개를 돌려 근처 학생에게 레이튼의 사무실로 뛰어가서 도움을 요청하라고 소리친다.
				<br><br>

				흐릿한 눈으로 학생이 방 밖으로 뛰쳐나가는 것을 지켜보고 있는데, 메이슨이 다시 당신에게 주의를 돌린다. "괜찮을 거다. 나랑 같이 숨을 쉬어 봐, 알겠지?" 메이슨이 호흡법을 지도하려 하지만, 당신은 집중할 수가 없다. 세상이 까맣게 흐려지며 구급차 사이렌 소리가 들려온다.
			<<case "schoolHallways">>
				<<if Time.schoolDay and !["early", "late"].includes($schoolstate)>>
					시야가 어지러워지며 비틀거리던 당신은 쾅 소리를 내며 사물함에 부딪힌다. 그 소리에 주변 학생들의 이목이 쏠린다. 다리에 힘이 풀린 당신은 배를 움켜쥔 채 바닥으로 주저앉는다. 한 학생이 선생님을 부르며 뛰쳐나간다. 다급한 발소리와 여러 명의 패닉에 빠진 목소리가 들리더니 이내 모든 것이 흐려진다.
				<<else>>
					<<pregnancyPassout "schoolJanitor">>
				<</if>>
			<<case "schoolLibrarian">>
				배를 움켜쥐고 흐느끼자, 도서관 사서가 놀란 눈으로 당신의 배를 쳐다본다. "워, 워, 조금만 참아요, 알겠죠? 제가 잡고 있어요. 당장 병원으로 모실게요." 당신은 힘없이 고마운 미소를 지으며 눈을 감는다. 당신은 사서의 품에서 안전하게 기절한다.
			<<case "schoolScience">>
				<<npc Sirris>><<person1>>
				강력한 수축이 당신을 덮치자 당신은 비명을 지른다. 그 고통에 아주 짧은 순간 눈앞이 캄캄해진다. 눈을 떠보니 당신은 교실 바닥에 누워 있고, 시리스가 당신 위를 맴돌고 있다. "진통이 시작되었군요," <<he>>【이가】 주머니에서 휴대폰을 꺼내면서 당신의 손을 잡아준다. "괜찮을 겁니다, 약속하죠." <<He>>【은는】 휴대폰을 귀에 대고 구급차를 부른다.
				<br><br>
				구급차를 기다리는 동안 시리스는 출산의 기적에 대해 강연을 한다. 반 친구들 중 일부는 속이 안 좋아 보이고, 다른 일부는 당신에게서 눈을 떼지 못한다. 기절하기 전 마지막으로 들은 것은 당신의 익은 자궁경부에 대한 <<his>> 열정적인 감탄이다.
			<<case "schoolToilets">>
				갑자기 시야가 흐려지며 당신은 타일 바닥에 쓰러진다. 소리를 쳐보려 하지만, 누군가 들을 수 있을지 확신할 수 없다.
				<br><br>

				부풀어 오른 배를 조심스럽게 감싸안은 채 그렇게 누워 있었고, 마침내
				<<if Time.schoolDay and !["early", "late"].includes($schoolstate)>>
					한 무리의 학생들이 서로 수다를 떨며 밖으로 나선다. 그 중 한 명이 당신을 발견하고는 얼어붙는다. 당신이 살려달라고 흐느낄 때까지 그들은 당신을 내려다본다. 정신을 차린 한 학생이 도움을 청하러 달려가고, 나머지는 바닥에 쓰러진 당신 주위로 몰려든다.
					<br><br>

					마침내 기절하기 전 선생님이 다가오는 것을 본다.
				<<else>>
					<<generate1>><<person1>>
					한 청소부가 대걸레 양동이를 굴리며 들어온다. <<He>>【은는】 당신의 양수가 터져 생긴 액체 웅덩이를 보고 눈살을 찌푸린다. "하나 치우면 또 튀어나온다니까. 요즘 애들은..." <<His>> 시선이 당신에게 닿자 눈이 휘둥그레진다. "씨발. 어, 잠깐, 음—" <<He>>【은는】 더듬거리며 <<his>> 휴대폰을 꺼내 구급차를 부른다.
					<br><br>

					의식의 마지막 끈을 놓기 전 당신은 쉰 목소리로 '감사합니다'라고 내뱉는다.
				<</if>>
			<<case "sewers">>
				<<beastNEWinit 1 lizard>>
				끔찍한 고통이 몸을 관통하고, 다리를 타고 액체가 흐른다. 진통이 시작되었다. 쓰러지면서 당신은 물속의 그림자가 당신 쪽으로 다가오는 것을 본다. 거대한 <<beasttype>>【이가】 나타나 당신을 향해 돌진한다. 금방이라도 덮칠 것 같았지만, 갑자기 <<bhe>>【이가】 멈춰 선다.
				<br><br>

				<<if $monster is 1>>
					"너... 알 품고 있어?" <<bhe>>【이가】 묻는다.
					<br><br>

					<<bHe>>【은는】 당신이 고통에 몸을 웅크리고 흐느끼는 것을 지켜보며 당신의 배를 뚫어져라 쳐다본다. <<beasttype>>【은는】 갈등하는 듯 보이더니, 천천히 다가와 당신의 배에 손을 얹는다. <<bHis>> 얼굴이 일그러지더니, <<bhe>>【은는】 갑자기 허리를 숙여 비교적 쉽게 당신을 안아 올린다.
					<br><br>

					"평범한 알은 아니군," <<bhe>>【이가】 쉭쉭거린다. "다른 인간들은 큰 건물로 가던데. 저 아래 밝은 곳에서 그들이 말하는 걸 들었어." <<beasttype>>【은는】 당신을 사다리로 옮겨서 끌어올린다. 표면에 도착하자 <<bhe>>【은는】 스르륵 빠져나간다.
				<<else>>
					<<bHe>>【은는】 신기한 듯 당신을 바라보며 배를 빤히 쳐다보더니, 천천히 다가와 <<bhis>> 꼬리로 당신을 감싼다. <<bHe>>【은는】 당신을 가장 가까운 사다리로 끌고 가더니 힘겹게 당신을 끌어올린다. 정상에 다다르자, <<bhe>>【은는】 자신이 빠져나갈 수 있을 만큼 열릴 때까지 맨홀 뚜껑에 박치기를 한다.
				<</if>>

				<<bHe>>【은는】 날카롭고 날카로운 쉭쉭 소리를 내며 맨홀 옆에 당신을 내려놓는다.
				<br><br>

				근처에 있던 누군가가 그 소리에 비명을 지르고, 발소리가 다가오는 것이 들린다. <<beasttype>>【은는】 <<= $monster is 1 ? "당신을 힐끗 돌아보고는 맨홀 뚜껑을 닫고 하수도로" : "하수도로">> 후퇴한다.
				<br><br>

				누군가 당신 곁에 쭈그리고 앉자 모든 것이 까맣게 흐려진다.
			<<case "sewersMorgan">>
				<<npc Morgan>><<person1>>
				격렬한 고통이 몸을 관통한다. 또 다른 수축이 시작되면서 당신은 바닥에 비틀거리며 쓰러진다. 패닉에 빠진다. 여긴 출산을 할 만한 곳이 아니다.
				<br><br>
				<<if $morganChased>>
					"오, <<charles>>," 당신을 붙잡으며 모건이 말한다. "널 찾아서 다행이다. 내 손주가 얼마나 걱정됐는지 몰라. 정말 멋져!" <<unset $morganChased>>
				<<else>>
					"오, <<charles>>," 모건이 당신 곁으로 달려오며 말한다. "아기를 낳는구나! 내가 <<grandpa>>【이가】 되다니! 정말 멋져!"
				<</if>>
				<br><br>
				생각만 해도 몸서리쳐지지만, <<he>>【이가】 하수도 안의 다른 벽감으로 이끌어도 아무것도 할 수 없다. 위쪽의 배수구에서 빛이 스며든다. <<= Time.dayState is "night" ? "가로등 빛" : "햇빛">>【이가】 보인다. 부러진 나무 조각과 곰팡이 핀 담요로 만든 작은 요람이 있다. 임시로 만든 침대와 망가지고 더러운 장난감, 인형들도 있다. 꺼림칙하다.<<trauma 12>><<ggtrauma>>
				<br><br>
				"너와 내 손주만을 위한 방을 준비했단다. 마음에 드니?"
				<br><br>
				또 한 번의 수축이 찾아오자 당신은 얼굴을 찡그린다.
				<br><br>
				"이제 걱정하지 마렴, 내가 다 알아서 할 테니까. 여기서 기다리렴. 금방 올게." <<He>>【은는】 떠나기 전 당신의 머리를 토닥여준다.
				<br><br>
				이 끔찍한 곳을 둘러보다가, 빛이 있는 위를 쳐다본다. 배수구 바로 아래 사다리가 있다. 고통 속에서도 당신은 억지로 기어오른다. 여기서 아기를 낳을 수는 없다.<<willpower 1>><<gwillpower>>
				<br><br>
				당신은 위로 올라와 거리에 쓰러진다. 재빨리 주변을 둘러보니 병원 앞 나이팅게일 가이다. 누군가 이미 당신을 발견하고 도와주러 달려온다. 그들이 도착하는 순간 아래쪽 하수도에서 비명 소리가 들린다.<<stress 6>><<gstress>>
			<<case "adultShop">>
				딜도로 가득 찬 선반을 간신히 붙잡고 비틀거린다. 고통에 신음하며 바닥으로 미끄러질 때 배를 감싼다.

				<<if $adultshopstate is "closed">>
					<<generate1>><<person1>>
					남은 힘을 다해 문 쪽으로 기어가려고 애쓴다. 힘없이 손잡이를 향해 손을 뻗어보지만, 바닥에서는 닿지 않는다. 당신은 흐느낀다.
					<br><br>

					문이 활짝 열리고 경비원이 당신을 노려보며 내려다본다. "이게 누구야? 육변기 장난감을 훔쳐 가려는 쥐새끼 도둑인가?" <<he>>【이가】 말한다. <<He>>【이가】 손전등을 비추더니, 당신의 상태를 보고 눈이 휘둥그레진다.
					<br><br>

					"제길," <<he>>【이가】 핸드폰을 꺼내며 중얼거린다. "이번 한 번은 봐주지, 하지만 다음에는 운이 좋지 않을 거다." 마지막으로 들은 것은 <<He>>【이가】 구급차를 부르는 소리였고, 그 후 세상이 까맣게 변한다.

				<<else>>
					뒷방에서 시리스가 당신을 부르는 소리가 들린다. 잠시 후, 시리스가 가게 안으로 들어오는 소리와 함께 <<nnpc_his "Sirris">> 시선이 당신에게 머물자 놀라는 비명 소리가 들린다.
					<br><br>

					순식간에 시리스가 당신 곁에 무릎을 꿇고 귀에 휴대폰을 댄 채 당신의 정신을 붙잡으려 애쓴다.

					<<if $adultshopstate is "sydney">>
						<<nnpc_him "Sirris">> 뒤로 시드니가 걱정스럽게 맴도는 모습이 보인다. 당신은 <<nnpc_him "Sydney">>에게 안심시키듯 미소를 지어보려 하지만, 더 이상 버틸 수 없다. 당신은 기절한다.
					<</if>>
				<</if>>
			<<case "office" "avery_skyscraper">>
			<<case "island">>
				<<endevent>>
				경련 같은 고통이 몸을 뒤틀게 하고, 당신은 비명을 지른다. 당신은 진통을 겪고 있다.
				<br><br>

				나무 사이로 형체들이 나타나고, 무기를 겨누고 있다. 당신의 상태를 보고 무기를 내리더니, 그들의 움직임이 당황한 듯 허둥지둥 변한다.
				<br><br>
				<<if $islander_language gte 100>>
					"이 사람 진통이 시작된 것 같아," 한 섬사람이 말한다.
					<br>
					"젠장! 네 말이 맞아!"
					<br>
					"지금 당장 드루이드들을 데려와!"
				<<elseif $islander_language gte 50>>
					그들은 도움을 요청한다. 이상하게도 고통 속에서도 그들 말의 의미를 거의 파악할 수 있다. 그 의미가 의식의 가장자리에 맴돈다.<<gggcomprehension>><<islander_language 30>>
				<<else>>
					그들이 이해할 수 없는 언어로 무언가 소리친다. 이상하게도, 고통 속에서 그 말의 의미가 느껴진다. 도움을 청하고 있는 것이다.<<gggcomprehension>><<islander_language 30>>
				<</if>>
				<br><br>
				당신이 의식을 잃자 그 형체들이 안개 속으로 흐릿해진다.
			<<default>>
				양수가 터진 상태라 더는 버틸 힘이 없다.
		<</switch>>

		/*Links for alternative pregnancy birth events*/
		<<if _args[0] isnot "schoolJanitor">>
			<br><br>
			<<switch _args[0]>>
				<<case "asylum" "asylumOutside" "asylumCafe" "asylumLibrary" "asylumHarper">>
					<<link [[다음|Pregnancy Birth Asylum]]>><<set $stress -= 5000>><<endevent>><</link>>
				<<case "prison" "prisonCell" "prisonLaundry" "prisonSpire" "prisonCanteen" "prisonMedical" "prisonYard" "prisonBeach" "prisonShowers">>
					<<link [[다음|Pregnancy Birth Prison]]>><<set $stress -= 5000>><<endevent>><</link>>
				<<case "tentacleworld">>
					<<if $tentacleEntrance is "mirror">>
						당신은 침실 거울 앞에 누워있는 자신을 발견한다. 모든 것이 까맣게 흐려진다.
						<br><br>

						<<link [[다음|Pregnancy Birth Hospital Passout]]>><<set $stress -= 5000>><<endevent>><</link>>
					<<else>>
						비명을 지른다. 하지만 돌아오는 건 자신의 메아리뿐이다. 목이 쉴 때까지 몇 번이고 소리친다. <span class="red">아무도 당신을 구하러 오지 않는다.</span> <<trauma 50>><<gggtrauma>>
						<br><br>

						고통과 두려움에 압도되어 당신은 기절한다.
						<br><br>

						<<link [[다음|Pregnancy Birth Asylum]]>><<set $stress -= 5000>><<endevent>><</link>>
					<</if>>
				<<case "tentacleforest" "hookah">>
					<<if _noWake>>
						갑작스러운 통증에 무방비로 당한다. 수축이다. 진통이 시작되었다. 당신은 바닥에 쓰러진다.
						<br><br>

						시야가 빠르게 흐려지고, 다시 돌아왔을 때는 시간이 좀 지난 듯한 느낌이 든다.
						<br><br>
					<<else>>
						응접실에서 번쩍 눈을 뜬다.
					<</if>>
					<<if $hookah_state is 1>>
						<<loadNPC 0 "hookah">><<person1>>
						후카 <<hookah_master>>의 얼굴이 걱정스러운 표정으로 당신 바로 위에 있다. <<He>>【이가】 주위에 소리치며 지시를 내린다.
						<br><br>

						"...그리고 저 창문 좀 열어. 이 아이가 숨 좀 쉬게 환기 좀 시키라고. 자물쇠를 흔들어봐. 원래 열기 힘들게 되어 있다고! 예, 예, 전액 환불해 드릴게요..."
						<br><br>

						진통이 덮쳐오며 시야 구석구석에 어둠이 스며들고, <<His>> 목소리가 멀어진다. 마지막으로 들은 것은 자신의 비명 소리다.
					<<else>>
						누군가 문을 두드리고 있다. 사이렌 소리와 함께 시야가 다시 흐려지기 시작한다.
					<</if>>
					<br><br>

					<<link [[다음|Pregnancy Birth Hospital Rescue]]>><<set $stress -= 5000>><<endevent>><</link>>
				<<case "forest">>
					<<if getLabouringLitter("pc")[0]?.species is "wolf">>
						<<beastNEWinit 1 wolf>>
						<<if $monster is 1>>
							<<beasttype>>【이가】 다가와 서둘러 당신 곁으로 와서는 등 뒤로 <<bhis>> 팔을 넣어 받쳐준다.
							<<if $syndromewolves is 1>>
								전에 동굴에서 <<bhim>>【을를】 본 적이 있다. "<<pPackbrother>>의 새끼들이 나오려고 해," <<bhe>>【이가】 말한다. "서둘러." 집을 향해 뒤뚱거리며 걷는 당신이 <<bhim>>에게 기댈 수 있게 해준다.
							<<else>>
								이유는 모르겠지만, <<bhim>>【와과】 함께라면 안전할 것 같다. "너의 새끼들이 나오려고 해," <<bhe>>【이가】 말한다. "우리 무리와 함께라면 넌 안전할 거야." 당신이 안전할 거라 믿는 곳을 향해 뒤뚱거리며 걷자 <<bhe>>【은는】 당신이 <<bhim>>에게 기댈 수 있게 해준다.
							<</if>>
						<<else>>
							<<beasttype>>【이가】 당신에게 다가와 손에 코를 비빈다.
							<<if $syndromewolves is 1>>
								전에 동굴에서 <<bhim>>【을를】 본 적이 있다. 당신은 <<bhis>> 등에 기대어 다리를 절뚝거리며 집으로 함께 향한다.
							<<else>>
								이유는 모르겠지만, <<bhim>>【와과】 함께라면 안전할 것 같다. 당신은 안전하리라 기대하는 곳을 향해 다리를 절뚝거리며 걷는 동안 <<bhis>> 등에 기댄다.
							<</if>>
						<</if>>
						고통을 참고 계속 움직이기엔 너무 벅차다. 결국 당신의 다리가 풀려 쓰러지고, 이내 시야도 뒤따라 흐려진다,
						<<if $monster is 1>>하지만 튼튼한 팔이 당신을 붙잡아 무사하게 해준다.<<else>>하지만 부드러운 털 위에 살포시 쓰러진다.<</if>>
						<br><br>

						<<link [[다음|Pregnancy Birth Wolf Rescue]]>><<set $stress -= 5000>><<endevent>><</link>>
					<<elseif $hallucinations gte 2 and $forest_shop_intro>>
						희미하게 노랫소리가 들린다.
						<br><br>

						갈색의 흐릿한 형체가 당신의 주변 시야를 스쳐 지나간다. 기운을 차리고 그게 어디로 갔는지 돌아보았을 땐 이미 사라지고 없다.
						<br><br>

						다시 뒤돌아보니, 숲 가장자리에서 빛나는 세 개의 초록색 눈이 당신을 응시하고 있다. 그 눈이 달린 고개가 기울어지자 그에 맞춰 나무들의 잔가지 몇 개도 함께 기운다.
						그것이 조심스레 어둠 속에서 걸어 나오자 그 나뭇가지들이 사실은 뿔이었음이 드러난다. 사슴이나 엘크를 예상했지만, 대신 다리가 길고 몸통은 훨씬 더 긴 거대한 갈색 여우가 나타난다.
						그 세 개의 눈빛에 불안감을 느끼고 한 발짝 물러선다. 기묘하게 생긴 꼬리가 그 뒤로 땅을 끌며 따라온다. 만약 둘로 갈라지지 않고 셋으로 갈라져 있다면 마치 고래 꼬리 지느러미를 어렴풋이 떠올리게 하는 모양새다.
						<br><br>

						이 생물체는 똑바로 쳐다보기조차 힘들다. 그것이 움직일 때마다 그 주변의 공기가 일그러진다.
						당신이 눈을 깜박일 때마다 순간적으로 뿔이 자라는 것처럼 보이는 걸 보면 확실히 엘크에 가까운 실루엣을 하고 있다. <<awareness 12>><<ggawareness>>
						<br><br>

						머릿속은 몸에게 움직이라고, 도망치라고, 뭐라도 하라고 소리치지만, 두 발이 그 자리에 묶인 듯 옴짝달싹할 수 없다.
						그것이 종종걸음으로 다가오더니 당신에게 닿기 직전에 걸음을 늦춘다. 천천히 고개를 낮춰 당신의 <<bellyDescription>>에 머리를 댄다. <span class="blue">무력감은 사라지지만 고통은 그대로다.</span>
						당신을 올려다보던 세 개의 눈이 모두 깜박이더니, 이내 얼굴에서 자리를 바꿔가며 돈다. 그리고 똑바로 일어선다.
						<<switch $bodysize>>
							<<case 0>>네 발로 서 있는데도 그 크기가 당신을 완전히 압도한다.
							<<case 1 2 3>>네 발로 서 있는데도 당신보다 키가 크다.
						<</switch>>
						<br><br>

						그것이 입을 벌려 당신의 목덜미를 물더니, 당신을 휙 던져 자신의 등 위로 올린다.
						당신은 본능적으로 갈색 털을 꽉 붙잡는다. 그 등에는 처음에는 줄무늬인 줄 알았던 피부가 드러난 두 줄기 흔적이 있다. 그것은 마치 무언가를 찾듯 경계하며 고개를 치켜든다.
						잠시 후, 그것이 당신을 태우고 숲을 뚫고 내달리기 시작한다.
						<br><br>

