<</widget>>

<<widget "pregnancyGendersText">><<silently>>
	<<set $_pregnancy to getPlayerPregnancy()>><<set $_litter to getChildrenOf($_pregnancy.pregnancyId)>>
	<<run $_litter.forEach(c => setKnowsGender(c.childId, "pc"))>>
	<<set $_genders to {m:0,f:0,h:0}>>
	<<run $_litter.forEach(b => $_genders[b.gender]++)>>
	<<if $_litter[0].identical isnot null>>
		<<set $_text_output to `"제 생각엔 <<if $_litter.length is 3>>셋 다 일란성 세쌍둥이<<else>>둘 다 일란성 쌍둥이<</if>>인 것 같습니다. 성별도 같고 이목구비도 서로 닮았네요."`>>
	<<elseif ($_genders.m is $_litter.length or $_genders.f is $_litter.length or $_genders.h is $_litter.length) and $_litter.length gt 1>>
		<<set $_text_output to `"같은 성별이긴 하지만, 일란성은 아닌 것 같습니다. 이목구비가 약간 다르게 생겼네요."`>>
	<<else>>
		<<set $_text_output to "당신의 아이는">>
		<<if $_genders.m gt 0>>
			<<switch $_genders.m>>
				<<case 1>><<set $_text_output += " 한">>
				<<default>><<set $_text_output += " " + $_genders.m>>
			<</switch>>
			<<set $_text_output += " 명의 남자아이">><<if $_genders.m gt 1>><<set $_text_output += "들">><</if>>
			<<if $_genders.f gt 0 and $_genders.h gt 0>>
				<<set $_text_output += ",">>
			<<elseif $_genders.f gt 0 or $_genders.h gt 0>>
				<<set $_text_output += " 그리고">>
			<</if>>
		<</if>>
		<<if $_genders.f gt 0>>
			<<switch $_genders.f>>
				<<case 1>><<set $_text_output += " 한">>
				<<default>><<set $_text_output += " " + $_genders.f>>
			<</switch>>
			<<set $_text_output += " 명의 여자아이">>
			<<if $_genders.f gt 1>><<set $_text_output += "들">><</if>>
			<<if $_genders.h gt 0>><<set $_text_output += " 그리고">><</if>>
		<</if>>
		<<if $_genders.h gt 0>>
			<<switch $_genders.h>>
				<<case 1>><<set $_text_output += " 한">>
				<<default>><<set $_text_output += " " + $_genders.h>>
			<</switch>>
			<<set $_text_output += " 명의 양성구유 아이">>
			<<if $_genders.h gt 1>><<set $_text_output += "들">><</if>>
		<</if>>
		<<set $_text_output += "입니다.">>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>>
<</widget>>

<<widget "pregnancyBabyText">><<silently>>
	<<set _preg to getPlayerPregnancy()>>
	<<if _preg and playerKnowsLitterDetails(_preg)>>
		<<set $_num to getChildrenOf(_preg.pregnancyId).length>>
		<<switch childBaseSpecies(_preg.donorSpecies)>>
			<<case "human">>
				<<set $_text_output to ($_num gt 1 ? ($_num is 3 ? "triplets" : "twins") : "baby")>>
			<<case "wolf">>
				<<set $_text_output to ($_num lte 3 ? ($_num is 1 ? "pup" : "pups") : "litter")>>
			<<default>>
				<<set $_text_output to ($_num gt 1 ? "babies" : "baby")>>
		<</switch>>
	<<elseif _preg and _preg.awareOfMultiple and getChildrenOf(_preg.pregnancyId).length gt 1>>
		<<set $_text_output to "babies">>
	<<else>>
		<<set $_text_output to "baby">>
	<</if>>
<</silently>><<print $_text_output>><</widget>>

<<widget "babyIs">>
	<<silently>>
		<<set $_spawn to `<<pregnancyBabyText ${_args[0] || "pc"}>>`>>
		<<set $_spawn += "【이가】">>
	<</silently>>
	<<print $_spawn>>
<</widget>>

<<widget "npcPregnancyUpdater">>
	<<for $_i to 0; $_i lt $NPCNameList.length; $_i++>>
		<<set $_name to $NPCNameList[$_i]>>
		<<if C.npc[$_name].pregnancy is undefined>>
			<<set C.npc[$_name].pregnancy to {}>>
		<</if>>
		<<set $_pregnancy to C.npc[$_name].pregnancy>>
		<<if !setup.pregnancy.infertile.includes($_name) and setup.pregnancy.typesEnabled.includes(C.npc[$_name].type) and
		(($settings.incompletePregnancyEnabled and C.npc[$_name].pregnancy.enabled is undefined and !setup.pregnancy.ignoresIncompleteCheck.includes($_name)) or
		(setup.pregnancy.canBePregnant.includes($_name) and C.npc[$_name].pregnancy.enabled is undefined))>>
			<<set $_pregnancy.enabled to true>>
			<<set $_pregnancy.cycleDaysTotal to random(24,32)>>
			<<set $_pregnancy.cycleDay to random(1,$_pregnancy.cycleDaysTotal)>>
			<<set $_pregnancy.cycleDangerousDay to 10>>
			<<set $_pregnancy.fertileLeadDays to random(PregnancyConstants.menstrualCycle.fertileLeadDaysMin, PregnancyConstants.menstrualCycle.fertileLeadDaysMax)>>
			<<switch $_name>>
				<<case "Kylar">><<set $_pregnancy.pills to "fertility">>
				<<case "Alex" "Wren">><<set $_pregnancy.pills to "contraceptive">>
				<<case "Great Hawk">>
					/* Has a much shorter cycle, when cycleDay is 1, assume the hawk should lay eggs that have not been fertilised*/
					<<set $_pregnancy.cycleDaysTotal to random(12,16)>>
					<<set $_pregnancy.cycleDay to random(1,$_pregnancy.cycleDaysTotal)>>
					<<set $_pregnancy.cycleDangerousDay to $_pregnancy.cycleDaysTotal - 4>>
					<<set $_pregnancy.pills to null>>
				<<default>><<set $_pregnancy.pills to null>>
			<</switch>>
		<<elseif setup.pregnancy.infertile.includes($_name) or (!setup.pregnancy.canBePregnant.includes($_name) and !$settings.incompletePregnancyEnabled)>>
			/*For saves that have the variables set, but have no need to be there*/
			<<set C.npc[$_name].pregnancy to {}>>
		<</if>>
		<<if C.npc[$_name].pregnancy.enabled isnot undefined and C.npc[$_name].pregnancy.analEnabled is undefined>>
			<<set C.npc[$_name].pregnancy.analEnabled to true>>
		<</if>>
			/* 0 = never uses a condom, Kylar has a special exception
			* 50 = Will use a condom, but will refrain if asked
			* 100 = Always uses a condom, will not remove it
			*/
		<<if !C.npc[$_name].pregnancyAvoidance or $objectVersion.pregnancyAvoidance is undefined>>
			<<switch $_name>>
				<<case "Kylar" "Black Wolf" "Great Hawk" "Eden" "Ivory Wraith" "Gwylan">><<set C.npc[$_name].pregnancyAvoidance to 0>>
				<<case "Robin" "Whitney" "Alex" "Wren" "Avery">><<set C.npc[$_name].pregnancyAvoidance to 50>>
				<<default>><<set C.npc[$_name].pregnancyAvoidance to 100>>
			<</switch>>
		<</if>>
	<</for>>
	<<set $objectVersion.pregnancyAvoidance to 1>>
<</widget>>

/*ToDo: Pregnancy Story Content: Not used in events at the moment, add to appropriate story passages, when the player gives birth to their children*/
<<widget "earSlimePregnancy">>
	<<if _args[0] and $earSlime.corruption gte 80>>
		<<switch _args[0]>>
			<<case "human">><<set $_type to _args[1]? '아기들' : '아기'>>
			<<case "wolf">><<set $_type to _args[1] ? '늑대 강아지들' : '늑대 강아지'>>
			<<default>><<set $_type to _args[1] ? '아기들' : '아기'>>
		<</switch>>
		<<set $_babiesText to `아름다운 ${$_type}`>>
		<<if numberOfEarSlime() gte 2>>
			<span class="green">성취감에 찬 온기가 당신을 채운다.</span>
			당신은 세상의 다툼을 거의 잊어버린다. 귀에 있는 슬라임들이 <<print $_babiesText>>【을를】 낳은 것에 대해 당신에게 보상하고 있다는 것을 알 수 있다.
			<<lllcorruption true>><<lltrauma>><<llstress>><<trauma -24>><<stress -24>><<corruption `Math.floor($earSlime.corruption * -0.4)`>>
			<br><br>
		<<elseif numberOfEarSlime()>>
			<span class="green">성취감에 찬 온기가 당신을 채운다.</span>
			당신은 세상의 다툼을 거의 잊어버린다. 귀에 있는 슬라임이 <<print $_babiesText>>【을를】 낳은 것에 대해 당신에게 보상하고 있다는 것을 알 수 있다.
			<<llcorruption true>><<ltrauma>><<lstress>><<trauma -12>><<stress -12>><<corruption `Math.floor($earSlime.corruption * -0.2)`>>
			<br><br>
		<</if>>
	<</if>>
<</widget>>

<<widget "fetishPregnancyImg">>
	<<if _playerIsNowPregnant or _pregnantNpc>>
		<div class="impregnatedGrid">
			<<if _playerIsNowPregnant>>
				<div @class="$options.images is 1 ? 'impregnated' : ''">
					<div>
						<<if _playerIsNowPregnant is "pc">>
							<span class="lewd">당신은 방금 스스로 임신하게 만들었다.</span>
						<<else>>
							<span class="lewd"><<print pregnancyNameCorrection(_playerIsNowPregnant, true)>>【이가】 방금 당신을 임신시켰다.</span>
						<</if>>
					</div>
					<<if $options.images is 1>>
						<<set $_fCum to Math.clamp(setup.bodyliquid.combined(playerLabouringOrifice()),1,5)>>
						<img class="fertilization" @src="'img/sex/fertilisation/impregnate-' + $_fCum + '.gif'">
					<</if>>
				</div>
				<<unset _playerIsNowPregnant>>
			<</if>>
			<<if _pregnantNpc>>
				<div @class="$options.images is 1 ? 'impregnated' : ''">
					<div><span class="lewd"><<print pregnancyNameCorrection(_pregnantNpc)>>【을를】 임신시켰습니다.</span></div>
					<<if $options.images is 1>><img class="fertilization" src="img/sex/fertilisation/impregnate-6.gif"><</if>>
				</div>
				<<earnFeat "First Fatherhood">>
				<<unset _pregnantNpc>>
			<</if>>
		</div>
	<</if>>
<</widget>>

<<widget "giveHarpyEggs">>
	<<if !playerIsPregnant() and $harpy gte 4 and !$harpyEggs and !$harpyEggsPrevent>>
		/* daysTillLaying only applies to unfertilised eggs */
		<<set $harpyEggs to {
			count: rollLitterSize("hawk"),
			daysTillLaying: random(2, 3),
		}>>
		/* Minimum time to prevents eggs from being set */
		<<set $harpyEggsPrevent to 14>>
	<</if>>
<</widget>>
