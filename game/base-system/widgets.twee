<<widget "angelBanishUse">>
	/* Warning: This assumes the player has at least 1 banishment charge, and can thus send it into the negatives */
	<<set $angelBanish -->>

	<<set _multi to $purity gte 1000 ? 2 : 1>>
	<<defiance `($purity / 100) * _multi`>>
<</widget>>

