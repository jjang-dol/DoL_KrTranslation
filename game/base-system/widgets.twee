                <br>
            <<else>>
                <br>
                어항이 바닥에 놓여 있다.
                <br>
            <</if>>
            <<containersLink>>
        <</if>>
    <<else>>
        <<if _args[0] is "icon">>
            <<if _table>>
                <br>
                <<bedroomtablechairicon>> _table.name<<if _chair and _chair.name isnot "의자">>【와과】 _chair.nameSolo 한 개<</if>>【이가】 벽 옆에 놓여 있다.
            <<elseif _chair and _chair.name isnot "의자">>
                <br>
                <<bedroomtablechairicon>> 두 번째 _chair.nameSolo【이가】 벽 옆에 놓여 있다.
            <</if>>
