<<widget "npc_pillory">>
	<<A_pillory_person>>【이가】 마을 형틀에 갇혀 있다.
	<<npc_pillory_release_schedule>>
	<br><br>
	<<endevent>>
<</widget>>

<<widget "npc_pillory_detail">>
	<<get_pillory_npc>>
	<<A_pillory_person>>【이가】 마을 형틀에 갇혀 있다.
	<<npc_pillory_appearance>>
	<br><br>
	<<npc_pillory_abuse>>
	<<npc_pillory_release_schedule>>
	<br><br>
	<<endevent>>
<</widget>>

<<widget "npc_pillory_appearance">>
	<<update_npc_pillory_appearance>>
	/*Desc*/
	<<if Time.dayState is "night">>
		<<if $pillory.tenant.crowd gte 10>>
			거대한 술 취한 무리가 둘러싼다
		<<elseif $pillory.tenant.crowd gte 6>>
			크고 소란스러운 무리가 몰려든다
		<<elseif $pillory.tenant.crowd gte 4>>
			음침한 무리가 모여든다
		<<else>>
			작지만 불길한 집단이 주변을 서성인다
		<</if>>
	<<else>>
		<<if $pillory.tenant.crowd gte 10>>
			흥분하고 조롱하는 무리가 둘러싼다
		<<elseif $pillory.tenant.crowd gte 6>>
			거대한 인파가 밀려든다
		<<elseif $pillory.tenant.crowd gte 4>>
			호기심 어린 무리가 배회한다
		<<else>>
			작은 무리가 지켜본다
		<</if>>
	<</if>>
	형틀에 몸이 잠긴 채 매달린 <<pillory_type>>.
	<<if $pillory.tenant.broken gte 32>>
		<<He>>【은는】 트라우마에 시달리는 듯하다, 아마도 이미 겪은 가혹 행위들로 인해 완전히 부서져 버린 모양이다.
	<<elseif $pillory.tenant.broken gte 16>>
		<<He>>【은는】 이미 겪은 가혹 행위에 눈물을 흘리고 있다.
	<<elseif $pillory.tenant.broken gte 8>>
		<<He>>【은는】 폭력적인 행위에 울먹거린다.
	<<elseif $pillory.tenant.broken gte 4>>
		<<He>>【은는】 명백히 괴로워 보이지만, 그것을 숨기려고 필사적으로 노력하고 있다.
	<<else>>
		<<He>>【은는】 반항하며, 애써 강한 척을 하고 있다.
	<</if>>
	<br>

	/*describe exposure*/
	<<if $pillory.tenant.upperexposed gte 3>>
		<<His>> <<= window.KR.getBreastSizeKr($pillory.tenant.person.breastsdesc)>>【이가】 군중에게 온전히 노출되어 있다.
		<<if $pillory.tenant.spank gte 8>>
			<<His>> 유두는 꼬집히고, 맞고, 빨리고, 물리고, 당겨져서 붉게 달아올라 있다.
		<<elseif $pillory.tenant.spank gte 4>>
			<<His>> 유두는 폭력으로 인해 상처 난 듯 보인다.
		<<elseif $pillory.tenant.spank gte 1>>
			<<His>> 유두는 학대의 흔적을 보여준다.
		<</if>>
	<<elseif $pillory.tenant.upperexposed gte 2>>
		<<if $pronoun is "f">>
			<<His>> 상의가 벗겨져, 오직 브래지어만이 <<his>> <<= window.KR.getBreastSizeKr($pillory.tenant.person.breastsdesc)>>【을를】 군중들로부터 가려주고 있다.
		<<else>>
			<<His>> 상의가 완전히 벗겨져, 군중들 앞에 <<his>> <<= window.KR.getBreastSizeKr($pillory.tenant.person.breastsdesc)>>【을를】 고스란히 노출하고 있다.
			<<if $pillory.tenant.spank gte 8>>
				<<His>> 유두가 꼬집히고, 찰싹 맞고, 물어뜯기고, 당겨져 빨갛다.
			<<elseif $pillory.tenant.spank gte 4>>
				학대로 인해 <<His>> 유두가 욱신거려 보인다.
			<<elseif $pillory.tenant.spank gte 1>>
				<<His>> 유두에서 학대의 흔적이 보인다.
			<</if>>
		<</if>>
	<<elseif $pillory.tenant.upperexposed gte 1>>
		<<His>> 상의가 찢어져, 군중에게 <<his>> <<if $pronoun is "f">>브래지어를<<else>><<= window.KR.getBreastSizeKr($pillory.tenant.person.breastsdesc)>>【을를】<</if>> 부분적으로 드러냈다.
	<</if>>
	<<if $pillory.tenant.lowerexposed gte 2>>
		<<His>> 엉덩이<<if $pillory.tenant.upperexposed gte 1>> 또한 <</if>> 노출되었고, 이로 인해 <<his>> <<if $pillory.tenant.person.gender is "f">>보지<<else>><<= window.KR.getPenisDescKr($pillory.tenant.person.penisdesc)>><</if>>【이가】 모든 사람에게 보일 수 있게 되었다.
		<<if $pillory.tenant.spank gte 5>>
			거칠게 맞은 흔적이 있는 <<His>> 엉덩이는
			<<if $pillory.tenant.fruit gte 5>>
				그리고 <<his>> <<if $pillory.tenant.face gte 1>>정액으로 <<if $pillory.tenant.face gte 4>>뒤덮인<<else>>얼룩진<</if>> <</if>>얼굴은 과일 조각들과 멍들로 난장판이다.
			<<else>>
				벌겋게 달아올라 있다.
			<</if>>
		<<elseif $pillory.tenant.fruit gte 6>>
			<<His>> <<if $pillory.tenant.face gte 1>>정액으로 <<if $pillory.tenant.face gte 4>>덮인<<else>>얼룩진<</if>> <</if>>얼굴은 부서진 과일들과 타박상으로 인해 엉망진창이다.
		<<elseif $pillory.tenant.fruit gte 2>>
			<<His>> <<if $pillory.tenant.face gte 1>>정액으로 <<if $pillory.tenant.face gte 4>>범벅된<<else>>얼룩진<</if>> <</if>>얼굴에는 과일 쪼가리와 타박상의 자국이 있다.
		<</if>>
		<<if $pillory.tenant.ass gte 1>>
			<<His>> 엉덩이가 범해진 가운데
			<<if $pillory.tenant.genital gte 1>>
				<<if $pillory.tenant.ass gte 3>> 한 번 이상 <</if>> 범해졌으며,
				<<if $pillory.tenant.person.gender is "m" and $pillory.tenant.person.strapon is undefined>>
					슬라임이 <<his>> <<print either("생채기가 난","유린당한","처량한")>> 자지를 덮고 있다.
				<<else>>
					정액이 <<his>> <<print either("까진","붉게 달아오른","유린당한")>> 보지에서 <<if $pillory.tenant.genital gte 3>>쏟아져 나온다<<else>>뚝뚝 떨어진다<</if>>.
				<</if>>
			<<else>>
				강간당했다<<if $pillory.tenant.ass gte 3>> 여러 번<</if>>.
			<</if>>
		<<elseif $pillory.tenant.genital gte 3>>
			<<His>> <<if $pillory.tenant.person.gender is "m" and $pillory.tenant.person.strapon is undefined>>자지는<<else>>보지는<</if>> 쓰라리게 강간당했다.
		<<elseif $pillory.tenant.genital gte 1>>
			<<He>>【은는】 강간당했다.
		<</if>>
	<<elseif $pillory.tenant.lowerexposed gte 1>>
		<<His>> <<if $pronoun is "f">>원피스는 허리춤 너머로 말려 올라가<<else>>바지는 밑으로 내려가<</if>>, 사람들에게 속옷을 훤히 내비친다.
	<<elseif $pillory.tenant.wet is 2>>
		비에 젖어 <<His>> 옷이 다 비친다.
	<<elseif $pillory.tenant.wet is 1>>
		축축하고 반투명해진 <<His>> 옷이 점점 말라가고 있다.
	<</if>>
	<<if $pillory.tenant.upperexposed is 0 and $pillory.tenant.lowerexposed is 0 and $pillory.tenant.face is 0 and $pillory.tenant.fruit gte 1>>
		<<if $pillory.tenant.fruit gte 6>>
			<<His>> 얼굴이 타박상과 과일 쪼가리로 인해 엉망진창이다.
		<<elseif $pillory.tenant.fruit gte 2>>
			<<His>> 얼굴에는 과일의 잔해와 멍자국이 남아있다.
		<</if>>
	<</if>>
<</widget>>

<<widget "update_npc_pillory_appearance">>
	/* Event firing chance increases with time.
	last viewed is reset every visit, so a visit every 30 minutes has 50% chance to fire, while a visit every hour has 100%   */
	<<set $_lastViewed to new DateTime($pillory.tenant.lastViewed)>>
	<<set $_firechance to -Time.date.compareWith($_lastViewed, true)/TimeConstants.secondsPerHour>>
	<<rng>>
	<<if $rng lte 100*$_firechance>>

		/*Weather effects*/
		<<if Weather.precipitation is "rain">>
			<<set $pillory.tenant.wet to 2>>
		<<elseif $pillory.tenant.wet is 2>>
			<<set $pillory.tenant.wet to 1>>
		<<else>>
			<<set $pillory.tenant.wet to 0>>
		<</if>>

		/*Chance of abuse based on crowd and time passed*/
		<<if $pillory.tenant.crowd lte 1>><<set $pillory.tenant.crowd to 1>><</if>>
		<<set $_chance to Math.clamp($_firechance, 1, 24)>>
		 /* If you do not visit for a long time, there is a higher chance for at least one event to happen */
		<<if $_chance gte 1>><<set $_chance to $_chance**1.5>><</if>>
		<<set $_chance *= $pillory.tenant.crowd>>

		/*increased by spectacle*/
		<<set $_factor to ($pillory.tenant.upperexposed + $pillory.tenant.lowerexposed + $pillory.tenant.ass + $pillory.tenant.genital + $pillory.tenant.face/2 + $pillory.tenant.fruit/3 + $pillory.tenant.spank/3)>>
		<<if $pillory.tenant.lowerexposed gte 2>>
			<<set $_factor = Math.floor($_factor+$pillory.tenant.spank/3)>>
		<</if>>

		<<if Time.dayState is "night">>
			<<set $_factor += 3>>
		<</if>>
		<<if $pillory.tenant.wet is 2>>
			<<set $_factor += 4>>
		<</if>>
		<<set $_prob to Math.floor($_chance + $_factor)>>
		/*Out of sight changes to tenant */
		<<rng>>
		<<if $rng gte (30 - $_prob)>><<set $pillory.tenant.fruit += 1>><</if>>
		<<rng>>
		<<if $rng gte (50 - $_prob)>><<set $pillory.tenant.crowd += 1>><</if>>
		<<rng>>
		<<if $rng gte (50 - $_prob)>><<set $pillory.tenant.upperexposed += 1>><</if>>
		<<rng>>
		<<if $rng gte (70 - $_prob)>><<set $pillory.tenant.lowerexposed += 1>><</if>>
		<<rng>>
		<<if $rng gte (90 - $_prob)>><<set $pillory.tenant.crowd += 2>><</if>>
		<<rng>>
		<<if $rng gte (90 - $_prob)>><<set $pillory.tenant.upperexposed += 3>><</if>>
		<<rng>>
		<<if $rng gte (90 - $_prob)>><<set $pillory.tenant.fruit += 2>><<set $pillory.tenant.face += 1>><</if>>
		<<rng>>
		<<if $rng gte (90 - $_prob)>><<set $pillory.tenant.spank += 2>><<else>><<set $pillory.tenant.spank += 1>><</if>>
		<<rng>>
		<<if $rng gte (100 - $_prob)>><<set $pillory.tenant.lowerexposed += 2>><</if>>
		<<rng>>
		<<if ($pillory.tenant.special.name is "" or $pillory.tenant.person.virginity.vaginal isnot true or ($pillory.tenant.person.gender is "m" and $pillory.tenant.person.strapon is undefined)) and $rng gte (100 - $_prob)>>
			<<set $pillory.tenant.genital += 1>>
		<</if>>
		<<rng>>
		<<if ($pillory.tenant.special.name is "" or $pillory.tenant.person.virginity.anal isnot true) and $settings.analEnabled and $rng gte (100 - $_prob)>>
			<<set $pillory.tenant.ass += 1>>
		<</if>>

		/*lock down exposure and replenish fruit */
		<<if $pillory.tenant.upperexposed gte 3>><<set $pillory.tenant.upperexposed to 3>><</if>>
		<<if $pillory.tenant.lowerexposed gt 2>><<set $pillory.tenant.lowerexposed to 2>><</if>>
		<<set $pillory.tenant.fruitstock to 3>>
		<<set $pillory.tenant.broken += Math.floor($pillory.tenant.ass + $pillory.tenant.genital + $pillory.tenant.face/2 + $pillory.tenant.fruit/3 + $pillory.tenant.spank/3)>>
	<</if>>
<</widget>>

<<widget "npc_pillory_abuse">>
	/* Event firing chance increases with time.
	last viewed is reset every visit, so a visit every 30 minutes has 50% chance to fire, while a visit every hour has 100%   */
	<<set $_lastViewed to new DateTime($pillory.tenant.lastViewed)>>
	<<set $_firechance to -Time.date.compareWith($_lastViewed, true)/TimeConstants.secondsPerHour>>
	<<rng>>
	<<if $rng lte 100*$_firechance>>
		<<generate2>><<person2>>
		<<if $NPCList[1].pronoun is "f">><<set $_female to true>><<else>><<set $_female to false>><</if>>
		<<set $_ly to either("폭력적으로","노골적으로","분노에 차서","격하게","뻔뻔하게","반복해서","서툴게","거칠게","연극하듯","성실하게","즐겁게","기쁘게","술에 취한 듯","엉성하게")>>
		/* need special case for strap-ons since they don't make sense in some scenes */
		<<set $_haspenis to $pillory.tenant.person.gender isnot "f" and $pillory.tenant.person.strapon?.state is undefined>>
		<<set $_hasvagina to $pillory.tenant.person.gender isnot "m" or $pillory.tenant.person.strapon?.state isnot undefined>>
		/* Minor events scale slowly with crowd */
		<<set $_dangerlow to Math.clamp(2*$pillory.tenant.crowd, 1, 20)>>
		/* Major events need enough crowd to become likely. Some are more likely than others. */
		<<set $_dangerhigh1 to Math.clamp(4*($pillory.tenant.crowd-5), 1, 20)>>
		<<set $_dangerhigh2 to Math.clamp(8*($pillory.tenant.crowd-5), 1, 40)>>
		<<set $_dangerhigh3 to Math.clamp(12*($pillory.tenant.crowd-5), 1, 60)>>
		<<if Time.dayState isnot "night">>
			<<cleareventpool>>
				<<addinlineevent "day shouts" 35>>
