	<<silently>><<set _out to "">>
	<<get_pillory_npc>>
	<<if $pillory.tenant.special.name is "">>
		<<set _out += "<<person>>">>
	<<else>>
		<<set _out += window.KR.gatPersonNameDictKR($pillory.tenant.special.name)>>
	<</if>>
	<</silently>><<print _out>>
<</widget>>

