:: Widgets Kitchen [widget]

<<widget "kitchenDisplay">>
	<div id="kitchenDisplay" class="food_ui no-numberify">
		<div id="body">
			<div id="mainSection">
				<div id="search">
					검색:
					<<textbox "_foodSearch" "">>
					<<run $(() => {
						var foodTimer = null;
						$('#textbox--foodsearch').on('input change keypress', e => {
							_foodSearch = e.target.value;
							clearTimeout(foodTimer);
							foodTimer = setTimeout(updateUI, 300);
						});
						var updateUI = () => {
							Wikifier.wikifyEval('<<if elementExists(\'#itemList\')>><<replace "#itemList">><<kitchenDisplayRecipes>><</replace>><</if>>');
						}
					})>>
					<<link "옵션">>
						<<replace "#altSection">>
							<<kitchenDisplayOptions>>
							<<removeclass "#altSection, #mobileCloser" "mobileHidden">>
						<</replace>>
					<</link>>
				</div>
				<div id="itemList">
					<<kitchenDisplayRecipes>>
				</div>
			</div>
			<div id="altSection" class="mobileHidden">
				<<if $lastRecipeViewed and setup.foodstuff[$lastRecipeViewed] and _recipeKeys.some((x) => x)>>
					<<kitchenDisplayRecipeDetail $lastRecipeViewed>>
				<<else>>
					<<kitchenDisplayOptions>>
				<</if>>
			</div>
			<div id="mobileCloser" class="mobileOnly mobileHidden" onclick="wikifier('addclass', '#altSection', 'mobileHidden'); wikifier('addclass', '#mobileCloser', 'mobileHidden');"></div>
		</div>
	</div>
	<br>
<</widget>>

<<widget "kitchenDisplayOptions">>
	<div id="basket">
		<span class="gold bold">옵션:</span>
		<div class="mobileOnly">
			<<link "닫기">>
				<<addclass "#altSection, #mobileCloser" "mobileHidden">>
			<</link>>
			<br><br>
		</div>
	</div>
	<div id="basketItems" class="info">
		검색:
		<<listbox "$options.ingredientsSearch" autoselect>>
			<<option "전체" "all">>
			<<option "레시피" "recipes">>
			<<option "재료" "ingredients">>
		<</listbox>>
		<<run $(() => {
			$('#listbox-optionsingredientssearch').on('input change', e => {
				Wikifier.wikifyEval('<<replace "#itemList">><<kitchenDisplayRecipes>><</replace>>');
			});
		})>>

		<br><br>
		<label>재료 자동 관리: <<checkbox "$options.ingredientsAutoManage" false true autocheck>></label>
		<<if $chef_state gte 3>>
			<br>
			<label>음란한 재료 자동 관리 허용: <<checkbox "$options.ingredientsAutoManageLewd" false true autocheck>></label>
			<<run $(() => {
				$('#checkbox-optionsingredientsautomanage').on('input change', e => {
					if (!$options.ingredientsAutoManageLewd) Wikifier.wikifyEval('<<replace "#itemList">><<kitchenDisplayRecipes>><</replace>>');
				});
				$('#checkbox-optionsingredientsautomanagelewd').on('input change', e => {
					Wikifier.wikifyEval('<<replace "#itemList">><<kitchenDisplayRecipes>><</replace>>');
				});
			})>>
		<</if>>
	</div>
<</widget>>

<<widget "kitchenDisplayRecipes">>
	<<kitchenFilter>>
	<<set _groupNameMap to {
		"Provided Ingredients": "제공된 재료",
		"ingredients": "재료",
		"sweets": "디저트",
		"savouries": "요리",
		"drinks": "음료",
		"Missing Ingredients": "부족한 재료",
		"Restricted Ingredients": "제한된 재료"
	}>>
	<<if _recipeKeys.some(key => key.group isnot "Provided Ingredients")>>
		<<for _category range _recipesGroups>>
			<<if !_recipeKeys.find(key => key.group is _category)>><<continue>><</if>>
			<<set _categoryVar to "_" + _category.replace(" ", "")>>
			<<foldout false _categoryVar>>
				<span class="gold"><<print _groupNameMap[_category] || _category.toLocaleUpperFirst()>></span>
				<<set _filteredRecipes to _recipeKeys.filter(key => key.group is _category)>>
				<<for $_i, $_keyObject range _filteredRecipes>>
					<div @id="$_keyObject.key" class="item"><<kitchenDisplayRecipe $_keyObject.key>></div>
					<<if $_i < _filteredRecipes.length - 1>><hr><</if>>
				<</for>>
			<</foldout>>
		<</for>>
	<<else>>
		<<if !Object.values(V.foodstuff).some(item => item.knows_recipe)>>
			<div class="info">아직 배운 요리법이 없습니다. 새 레시피를 해금하려면 가사 수업을 들으세요.</div>
		<</if>>
		<<for _category range _recipesGroups>>
			<<if !_recipeKeys.find(key => key.group is _category)>><<continue>><</if>>
			<<set _categoryVar to "_" + _category.replace(" ", "")>>
			<<foldout false _categoryVar>>
				<span class="gold"><<print _groupNameMap[_category] || _category.toLocaleUpperFirst()>></span>
				<<set _filteredRecipes to _recipeKeys.filter(key => key.group is _category)>>
				<<for $_i, $_keyObject range _filteredRecipes>>
					<div @id="$_keyObject.key" class="item"><<kitchenDisplayRecipe $_keyObject.key>></div>
					<<if $_i < _filteredRecipes.length - 1>><hr><</if>>
				<</for>>
			<</foldout>>
		<</for>>
	<</if>>
<</widget>>

<<widget "kitchenDisplayRecipe">>
	<<set $_setupItem to setup.foodstuff[_args[0]]>>
	<div class="details">
		<div>
			<<foodstufficon _args[0]>> <<recipe_name _args[0] "cap">> |
			보유 중: <span class="gold"><<print $foodstuff[_args[0]].amount>></span>
		</div>
		<<set $_group to _recipeKeys.find((obj) => obj.key is _args[0]).group>>
		<<switch $_group>>
			<<case "Missing Ingredients">>
				<div>
					<span class="red">부족:</span>
					<<print $_setupItem.recipe.ingredients.filter(ingredient => {
						return ingredientsTotal(ingredient, _args[0], true) lte 0 and !ingredientsProvided(ingredient, _args[0]);
					}).map(i => (setup.foodstuff[i] && setup.foodstuff[i].name) ? setup.foodstuff[i].name : i.replace(/_/g, " ")).sort().join(", ")>>
				</div>
			<<case "Restricted Ingredients">>
				<div>
					<span class="red">제한됨:</span>
					<<print $_setupItem.recipe.ingredients.filter(ingredient => {
						return !ingredientIsAllowed(ingredient);
					}).map(i => (setup.foodstuff[i] && setup.foodstuff[i].name) ? setup.foodstuff[i].name : i.replace(/_/g, " ")).sort().join(", ")>>
				</div>
		<</switch>>
	</div>
	<div class="recipe">
		<<capture _args[0]>>
			<<if $options.images is 1>>
				<<set _file to setup.foodstuff[_args[0]].kitchen_item_type_icon>>
				<<link "<<iconUi _file>>">>
					<<replace "#altSection">><<kitchenDisplayRecipeDetail _args[0]>><</replace>>
					<<removeclass "#altSection, #mobileCloser" "mobileHidden">>
				<</link>>
			<<else>>
				<<link "상세">>
					<<replace "#altSection">><<kitchenDisplayRecipeDetail _args[0]>><</replace>>
					<<removeclass "#altSection, #mobileCloser" "mobileHidden">>
				<</link>>
			<</if>>
		<</capture>>
	</div>
<</widget>>

<<widget "kitchenDisplayRecipeDetail">>
	<<set $lastRecipeViewed to _recipeKeys.some((obj) => obj.key is _args[0]) ? _args[0] : _recipeKeys[0].key>>
	<<set $_setupItem to setup.foodstuff[$lastRecipeViewed]>>
	<div id="basket">
		<div>
			<<foodstufficon $lastRecipeViewed>>
			<div class="recipeTitle"><<recipe_name $lastRecipeViewed "cap">>:</div>
		</div>
		<div class="mobileOnly">
			<<link "닫기">>
				<<addclass "#altSection, #mobileCloser" "mobileHidden">>
			<</link>>
		</div>
	</div>
	<<set _basketOpen to false>>
	<div id="basketItems">
		보유 중: <span class="gold"><<print $foodstuff[$lastRecipeViewed].amount>></span>
		<<if $_setupItem.recipe?.ingredients.length>>
			<br>
			시간: <span class="gold"><<print $_setupItem.recipe.cook_minutes>></span>분
			<br>
			결과: <span class="gold"><<print $_setupItem.recipe.servings>></span>
			<hr>
		<</if>>
		<div id="requiredForRecipe">
			<<requiredForRecipe $lastRecipeViewed>>
			<<kitchenDisplayRecipeMake>>
		</div>
		<<knownFoodRecipes $lastRecipeViewed>>
	</div>
<</widget>>

<<widget "kitchenDisplayRecipeMake">>
	<<if $phase2>>
		<<wearProp $phase2>>
		<<unset $phase2>>
	<</if>>
	<<set $_setupItem to setup.foodstuff[$lastRecipeViewed]>>
	<<set $_group to _recipeKeys.find((obj) => obj.key is $lastRecipeViewed).group>>
	<div style="margin-top: 16px">
		<<if $_setupItem.recipe?.ingredients.length>>
			<<switch $_group>>
				<<case "Restricted Ingredients">>
					<span class="purple">이 주방에서 사용 불가능한 필수 재료가 있습니다.</span>
				<<case "Missing Ingredients">>
					<span class="purple">필요한 재료가 부족합니다.</span>
				<<default>>
					<<if $tiredness gte C.tiredness.max>>
						<span class="purple">요리하기엔 너무 지쳤습니다.</span>
					<<elseif $_setupItem.recipe.ingredients.every(ingredient => $foodstuff[ingredientUsed(ingredient, $lastRecipeViewed)].amount gte 1 or _ingredientsSupplied?.includes(ingredientUsed(ingredient, $lastRecipeViewed)))>>
						만들기:
						<<set _hours to Math.floor($_setupItem.recipe.cook_minutes / 60)>>
						<<set _minutes to $_setupItem.recipe.cook_minutes % 60>>
						<<set _timeString to " (" + (_hours lt 10 ? "0": "") +_hours+":"+(_minutes lt 10 ? "0": "")+_minutes+")">>
						<<link [["1인분" + _timeString|$passage]]>><<make_recipe $lastRecipeViewed 1>><</link>>
						<<if $_setupItem.recipe.ingredients.every(ingredient => $foodstuff[ingredientUsed(ingredient, $lastRecipeViewed)].amount gte 3 or _ingredientsSupplied?.includes(ingredientUsed(ingredient, $lastRecipeViewed)))>>
							<<set _hours to Math.floor(($_setupItem.recipe.cook_minutes * 3) / 60)>>
							<<set _minutes to ($_setupItem.recipe.cook_minutes * 3) % 60>>
							<<set _timeString to " (" + (_hours lt 10 ? "0": "") +_hours+":"+(_minutes lt 10 ? "0": "")+_minutes+")">>

							/* Prevent passing too much time */
							<<set _futureTime to new DateTime(Time.date.timeStamp)>>
							<<set _futureTime to _futureTime.addHours(_hours)>>
							<<set _futureTime to _futureTime.addMinutes(_minutes)>>

							/* Prevent using limited provided ingredients */
							<<if $bus is "loft_kitchen" and $_setupItem.recipe.ingredients.filter(x => $loftIngredients?.[x] lt 3).length gte 1>>
								<<set _limitedIngredientRestriction to true>>
							<</if>>

							<<if (!_hourRestriction or _futureTime.hour lt _hourRestriction or _futureTime.minute lte 15) and !_limitedIngredientRestriction>>
								| <<link [["3인분" + _timeString|$passage]]>><<make_recipe $lastRecipeViewed 3>><</link>>
							<</if>>
						<</if>>
						<br>
						<<if $_group is "Provided Ingredients">><span class="purple">이 주방에서는 이 재료를 무제한으로 사용할 수 있습니다.</span><</if>>
					<<elseif $_group is "Provided Ingredients">>
						<span class="purple">가진 재료는 없지만, 이 주방에서는 무제한으로 사용할 수 있습니다.</span>
					<<else>>
						<span class="purple">재료가 부족하지만, 대체품을 사용할 수도 있습니다.</span>
					<</if>>
			<</switch>>
		<<else>>
			<<switch $_group>>
				<<case "Provided Ingredients">>
					<span class="purple">이 주방에서는 이 재료를 무제한으로 사용 할 수 있습니다.</span>
				<<case "Restricted Ingredients">>
					<span class="purple">이 주방에서는 이 재료를 사용할 수 없습니다.</span>
				<<case "Missing Ingredients">>
					<<if $_setupItem.shop.available_in?.length>>
						<span class="purple">이 재료를 구하거나 구매할 방법을 찾아야 합니다.</span>
					<<else>>
						<span class="purple">이 재료를 구할 방법을 찾아야 합니다.</span>
					<</if>>
			<</switch>>
		<</if>>
	</div>
<</widget>>

<<widget "requiredForRecipe">>
	<<if setup.foodstuff[_args[0]].recipe?.ingredients.length gt 0>>
		재료:
		<div class="itemSummary">
			<<for $_ingredient range clone(setup.foodstuff[_args[0]].recipe.ingredients).sort()>>
				<<set $_usedIngredient to ingredientUsed($_ingredient, _args[0])>>
				<div class="basketItem">
					<<foodstufficon $_usedIngredient>>
					<<print (setup.foodstuff[$_usedIngredient] && setup.foodstuff[$_usedIngredient].name) ? setup.foodstuff[$_usedIngredient].name : $_usedIngredient.replace(/_/g, " ").toLocaleUpperFirst()>>
					<<if _ingredientsSupplied?.includes($_usedIngredient)>>
						<span class="gold">(∞)</span>
					<<else>>
						<<set _ingredientsUnavailable to $foodstuff[$_usedIngredient].amount gt 0>>
						<span @class="$foodstuff[$_usedIngredient].amount gt 0 ? 'gold' : 'red'">(<<print $foodstuff[$_usedIngredient].amount>>)</span>
					<</if>>
					<<if !$options.ingredientsAutoManage and ingredientsOptions($_ingredient, _args[0]).length gt 1>>
						<<capture $_ingredient _args[0] _args[1]>>
							<<link "〉〉">>
								<<run ingredientsNextAlternative($_ingredient, _args[0])>>
								<<replace "#requiredForRecipe">>
									<<requiredForRecipe _args[0] _args[1]>>
									<<kitchenDisplayRecipeMake>>
								<</replace>>
							<</link>>
						<</capture>>
					<</if>>
				</div>
			<</for>>
		</div>
	<</if>>
<</widget>>

<<widget "learn_recipe">>
	/* checks if object exists in $foodstuff */
	<<if !$foodstuff[_args[0]]>>
		<<set $foodstuff[_args[0]] to {amount: 0}>>
	<</if>>

	<<if $foodstuff[_args[0]].knows_recipe isnot true>>
		<span class="gold"><<recipe_name _args[0] "article">>【을를】 만드는 법을 배웠습니다.</span>
		<<foodstufficon _args[0]>>
	<</if>>
	<<set $foodstuff[_args[0]].knows_recipe to true>>

	<<set _recipes_known to 0>>
	<<set _food_keys_recipes to Object.keys(setup.foodstuff)>>
	<<for _e to 0; _e lt _food_keys_recipes.length; _e++>>
		<<set _food_recipes to _food_keys_recipes[_e]>>
		<<if $foodstuff[_food_recipes]?.knows_recipe is true>>
			<<set _recipes_known++>>
		<</if>>
	<</for>>
	<<if _recipes_known gte 5>>
		<<earnFeat "Chef de Tournant">>
	<</if>>
	<<if _recipes_known gte 20>>
		<<earnFeat "Chef de Partie">>
	<</if>>
	<<if _recipes_known gte 50>>
		<<earnFeat "Sous Chef">>
	<</if>>
<</widget>>

<<widget "learn_recipe_all">>
	<<set _food_keys to Object.keys(setup.foodstuff)>>
	<<for $_i to 0; $_i lt _food_keys.length; $_i++>>
		<<set _food to _food_keys[$_i]>>
		<<if setup.foodstuff[_food].recipe?.ingredients.length gte 1>>
			<<learn_recipe _food>>
		<</if>>
	<</for>>
<</widget>>

<<widget "give_all_foodstuff">>
	<<set _food_keys to Object.keys(setup.foodstuff)>>
	<<for $_i to 0; $_i lt _food_keys.length; $_i++>>
		<<set _food to _food_keys[$_i]>>
		<<if !$foodstuff[_food]>>
			<<set $foodstuff[_food] to { amount: 0 }>>
		<</if>>
		<<set $foodstuff[_food].amount += 20>>
	<</for>>
<</widget>>

<<widget "make_recipe">>
	<<set $_amount to _args[1] or 1>>
	<<tending_give _args[0] `setup.foodstuff[_args[0]].recipe.servings * $_amount`>>
	<<for $_ingredient range setup.foodstuff[_args[0]].recipe.ingredients>>
		<<if !_ingredientsSupplied?.includes($_ingredient) or !_ingredientsSupplied?.includes(ingredientUsed($_ingredient, _args[0]))>>
			<<set $_ingredient to ingredientUsed($_ingredient, _args[0])>>
			<<tending_give $_ingredient `-$_amount`>>
		<<elseif $bus is "loft_kitchen" and Object.keys($loftIngredients).includes($_ingredient)>>
			<<set $loftIngredients[$_ingredient] -= $_amount>>
		<</if>>
	<</for>>
	<<set $phase2 to _args[0]>>
	<<pass `setup.foodstuff[_args[0]].recipe.cook_minutes * $_amount`>>
	<<if $bus is "avery_kitchen" and $avery_mansion.jobs.includes("kitchen") and $_amount gte random(1,3)>>
		<<set $avery_mansion.kitchen_made += $_amount>>
	<</if>>
	<<set $recipeMade to _args[0]>>
<</widget>>

<<widget "knownFoodRecipes">>
	<<if _args[0]>>
		<<set _knownRecipes to []>>
		<<set _possibleRecipes to 0>>
		<<run Object.keys(setup.foodstuff).forEach(item => {
			if (setup.foodstuff[item].recipe?.ingredients.includes(_args[0])) {
				_possibleRecipes++;
				if ($foodstuff[item].knows_recipe) _knownRecipes.pushUnique(item);
			}
		})>>

		<<if _knownRecipes.length>>
			<hr>
			알고 있는 레시피 (_knownRecipes.length / _possibleRecipes):
			<br>
			<<for $_recipe range _knownRecipes>>
				<div class="recipe">
					<div><<foodstufficon $_recipe>></div>
					<div>
						<mouse class="tooltip">
							<<print (setup.foodstuff[$_recipe] && setup.foodstuff[$_recipe].name) ? setup.foodstuff[$_recipe].name : $_recipe.replace(/_/g, " ").toLocaleUpperFirst()>>
							<span>
								재료:
								<ul>
									<<for $_secondaryIngredients range setup.foodstuff[$_recipe].recipe.ingredients>>
										<li>
											<<print (setup.foodstuff[$_secondaryIngredients] && setup.foodstuff[$_secondaryIngredients].name) ? setup.foodstuff[$_secondaryIngredients].name : $_secondaryIngredients.replace(/_/g, " ").toLocaleUpperFirst()>>
											<<if _ingredientsSupplied?.includes($_secondaryIngredients)>>
												<i class="gold">(∞)</i>
											<<else>>
												<i class="gold">(<<print $foodstuff[$_secondaryIngredients].amount>>)</i>
											<</if>>
										</li>
									<</for>>
								</ul>
							</span>
						</mouse>
					</div>
				</div>
			<</for>>
		<<elseif _possibleRecipes isnot 0>>
			<hr>
			이 재료를 사용하는 레시피를 알지 못합니다.
		<</if>>
		<<if setup.foodstuff[_args[0]].category is "dish" and $foodstuff[_args[0]]?.knownFavorite?.length>>
			<hr>
			좋아하는 사람:
				<<for $_npc range $foodstuff[_args[0]].knownFavorite>>
					<br>
					<<iconUi "sym-love.png">><<print window.KR.gatPersonNameDictKR($_npc)>>
				<</for>>
		<</if>>
	<</if>>
<</widget>>

<<widget "ingredientsSupplied">>
	<<set _ingredientsSupplied to []>>
	<<if typeof _args[0] is "object">>
		<<run _args[0].forEach(key => _ingredientsSupplied.pushUnique(key))>>
	<<elseif _args[0]>>
		<<run _args.forEach(key => _ingredientsSupplied.pushUnique(key))>>
	<</if>>
<</widget>>

<<widget "ingredientsExceptions">>
	<<set _ingredientsExceptions to []>>
	<<if _args[0]>>
		<<run _args.forEach(key => _ingredientsExceptions.pushUnique(key))>>
	<</if>>
<</widget>>

/*
Vrel: If I remember right, that's as far as I got with the UI for the PC eating their own food.
Should probably be removed once said feature has been implemented
<<widget "food_list">>
	<summary class="journal"><<print _args[0].toLocaleUpperFirst()>></summary>
	<<set _food_keys to Object.keys(setup.foodstuff)>>
	<<for _i to 0; _i lt _food_keys.length; _i++>>
		<<set _food to _food_keys[_i]>>

		<<if _args[0] is "sweets" and setup.foodstuff[_food].food.tags.includes("sweet") or
		_args[0] is "drinks" and setup.foodstuff[_food].food.tags.includes("drink") or
		_args[0] is "savouries" and !setup.foodstuff[_food].food.tags.includes("sweet") and !setup.foodstuff[_food].food.tags.includes("drink") and setup.foodstuff[_food].category isnot "ingredient">>
			<<set _recipe_go to true>>
		<<else>>
			<<set _recipe_go to false>>
		<</if>>
		<<if $foodstuff[_food].knows_recipe is true and _recipe_go is true>>
		<div class="kitchen-recipe-box">
			<div class="recipe-text"><<foodstufficon _food>><<print _food.toLocaleUpperFirst().replace(/_/g," ")>></div>
			Number owned: <<print $foodstuff[_food].amount>>
			<br>
			<<if _ingredients_available isnot false>>
				<<capture _food>>
					<br>
					<<if $tiredness gte C.tiredness.max>>
						<span class="purple">You're too tired to cook!</span>
					<<else>>
						<<link [[Make|$passage]]>><<make_recipe _food>><</link>>
					<</if>>
				<</capture>>
			<</if>>
			<<set _recipe_known to true>>
		</div>
		<</if>>
	<</for>>
	<<if _recipe_known is false>>
		<span class="blue">You know no recipes!</span> <span class="gold">You can learn them from the housekeeping class at school.</span>
	<</if>>
<</widget>>

<<widget "food_list_all">>
	<<food_list "savouries">>
	<br>
	<<food_list "sweets">>
	<br>
	<<food_list "drinks">>
	<br>
<</widget>>*/

<<widget "housekeeping_exam_select">>
	<<unset $chosen_recipe>>
	<<set _food_keys to Object.keys(setup.foodstuff)>>
	<<set _possible_recipes to []>>
	<<set $_foodOptions to Object.entries(clone(setup.foodstuff)).filter(([key, item]) => !$foodstuff[key]?.knows_recipe and item.recipe?.ingredients.length)>>
	<<for $_difficulty to 1; $_difficulty lt 5; $_difficulty++>>
		<<run $_foodOptions.forEach(([key, item]) => {
			if (item.recipe.difficulty is $_difficulty and item.recipe.ingredients.every(ingredient => !setup.foodstuff[ingredient].recipe?.ingredients.length or $foodstuff[ingredient].knows_recipe)) {
				_possible_recipes.pushUnique(key);
			}
		})>>
		<<if _possible_recipes.length>>
			<<if Object.keys($foodstuff).filter(key => !$foodstuff[key].knows_recipe and setup.foodstuff[key].recipe?.ingredients.length and setup.foodstuff[key].recipe.difficulty is $_difficulty).length
				is Object.keys($foodstuff).filter(key => setup.foodstuff[key].recipe?.ingredients.length and setup.foodstuff[key].recipe.difficulty is $_difficulty).length>>
				<<set _difficultyNotice to $_difficulty>>
			<</if>>
			<<set $chosen_recipe to _possible_recipes.pluck()>>
			<<break>>
		<</if>>
	<</for>>
	<<if !$chosen_recipe>><<set $chosen_recipe to "none">><</if>>
<</widget>>

<<widget "avery_food_select">>
	<<set $avery_mansion.food_last to $gift>>
	<<set $avery_requested_food to $avery_mansion.food>>
	<<unset $chosen_recipe>>
	<<set _food_keys to Object.keys(setup.foodstuff)>>
	<<set _possible_recipes to []>>
	<<set $_foodOptions to Object.entries(clone(setup.foodstuff)).filter(([key, item]) => item.recipe?.ingredients.length && item.category !== "ingredient" && !item.food.tags.includes("drink"))>>

	<<if C.npc.Avery.dom gte 75>>
		<<set $_difficulty to 4>>
	<<elseif C.npc.Avery.dom gte 50>>
		<<set $_difficulty to 3>>
	<<elseif C.npc.Avery.dom gte 25>>
		<<set $_difficulty to 2>>
	<<else>>
		<<set $_difficulty to 1>>
	<</if>>
	<<run $_foodOptions.forEach(([key, item]) => {
		if (item.recipe.difficulty is $_difficulty) {
			_possible_recipes.pushUnique(key);
		}
	})>>
	<<if _possible_recipes.length>>
		<<set $chosen_recipe to _possible_recipes.pluck()>>
	<</if>>

	<<if !$chosen_recipe>><<set $chosen_recipe to "none">><</if>>
	<<set $avery_mansion.food to $chosen_recipe>>

	/* once Avery has chosen a new meal, the player loses the chance to learn the recipes they'd asked to learn prior */
	<<set $avery_mansion.recipe to []>>
<</widget>>

<<widget "reading_nook_recipe">>
	<<unset $chosen_recipe>>
	<<set _food_keys to Object.keys(setup.foodstuff)>>
	<<set _possible_recipes to []>>
	<<set $_foodOptions to Object.entries(clone(setup.foodstuff)).filter(([key, item]) => !$foodstuff[key].knows_recipe and item.recipe?.ingredients.length)>>

	<<if random(0,50) gte 25>>
		<<set $_difficulty to 2>>
	<<else>>
		<<set $_difficulty to 1>>
	<</if>>

	<<run $_foodOptions.forEach(([key, item]) => {
		if (item.recipe.difficulty is $_difficulty and item.recipe.ingredients.every(ingredient => !setup.foodstuff[ingredient].recipe?.ingredients.length or $foodstuff[ingredient].knows_recipe)) {
			_possible_recipes.pushUnique(key);
			}
		})>>
	<<if _possible_recipes.length>>
		<<set $chosen_recipe to _possible_recipes.pluck()>>
	<</if>>

	<<if !$chosen_recipe>><<set $chosen_recipe to "none">><</if>>
	<<if $chosen_recipe is "none">>
		당신은 이미 그 음식을 만드는 방법을 알고 있다.
	<<else>>
		<<learn_recipe $chosen_recipe>>
	<</if>>
<</widget>>

<<widget "food_gift_list">>
	<<set _food_keys to Object.keys(setup.foodstuff)>>
	<<for _i to 0; _i lt _food_keys.length; _i++>>
		<<set _food to _food_keys[_i]>>
		<<if setup.foodstuff[_food].category is "dish">>
			<<if $foodstuff[_food]?.amount gte 1>>
				<<set _food_gift_found to true>>
				<<set _color to $bus is "avery_dining" and _food is $avery_mansion.food ? "gold" : "">>
				<label><<foodstufficon _food>><span @class="_color"><<recipe_name _food "cap">> (<<print $foodstuff[_food].amount>>)</span> <<radiobutton "$gift" _food checked>></label> |
			<</if>>
		<</if>>
	<</for>>
	<<if _food_gift_found isnot true>>
		선물할 수제 음식이 없습니다.
	<</if>>
	<br><br>
<</widget>>

<<widget "give_gift">>
	<<tending_give $gift -1>>
	<<set $daily.giftedFood[_args[0]] to $gift>>
<</widget>>

<<widget "recipe_name">><<silently>>
	<<set $_difficultyColour to _args[1]?.includes("difficulty") ? ["","green","blue","purple","pink","red"][(setup.foodstuff[_args[0]]?.recipe.difficulty)] : "white">>
	<<set $_recipeName to _args[1]?.includes("plural") ? setup.foodstuff[_args[0]].plural : (setup.foodstuff[_args[0]]?.name ? setup.foodstuff[_args[0]].name : (setup.foodstuff[_args[0]]?.recipe?.recipe_name || setup.foodstuff[_args[0]].name.replace(/_/g," ")))>>

	<<if _args[1]?.includes("cap")>>
		<<set $_recipeName to $_recipeName.toUpperFirst()>>
	<</if>>
	<<if !_args[1]>>
		<<set $_recipeName to $_recipeName.replace(/^(a |an |the )/i, "")>>
	<</if>>
<</silently>><span @class=$_difficultyColour><<print $_recipeName>></span><</widget>>

<<widget "saveFavoriteFood">>
	<<if C.npc[_args[0]] and setup.foodstuff[_args[1]].category is "dish">>
		<<if !$foodstuff[_args[1]].knownFavorite>><<set $foodstuff[_args[1]].knownFavorite to []>><</if>>
		<<run $foodstuff[_args[1]].knownFavorite.pushUnique(_args[0])>>
	<</if>>
<</widget>>

<<widget "recipe_exam_description">>
	<<if !setup.foodstuff[_args[0]].recipe?.ingredients.length>>
		<span class="black">음식 항목 "_args[0]"은 조리 가능한 레시피가 아닙니다! 제보해 주세요!</span>
	<<else>>
		<<if _difficultyNotice is 1>>
			"먼저 간단한 레시피부터 시작하지," 리버가 말한다. "만들기는 쉽지만, 그래도 유용하거나 맛있는 것들이다. 첫 레시피는 <<recipe_name _args[0] "difficulty">>【이】다." <<He>>【은는】 목을 가다듬는다.
		<<elseif _difficultyNotice is 2>>
			"이제 한 단계 올라간다," 리버가 말한다. "기초는 알고 있다는 걸 보여줬으니 됐다. 다음 요리들은 더 복잡하다. 오늘은 <<recipe_name _args[0] "difficulty">> 만드는 법을 배울 거다." <<He>>【은는】 목을 가다듬는다.
		<<elseif _difficultyNotice is 3>>
			"오늘은 고급 요리로 넘어간다," 리버가 말한다. "대체로 어려운 요리일수록 만들 가치도 커진다. 물론 주관적인 이야기지만. 첫 고급 시험 레시피는 <<recipe_name _args[0] "difficulty">>【이】다." <<He>>【은는】 목을 가다듬는다.
		<<elseif _difficultyNotice is 4>>
			리버가 손뼉을 쳐서 학생들의 주의를 끈다. "오늘부터는 더 어려운 요리를 배울 거다. 내가 가르칠 수 있는 요리도 이제 많이 남지 않았다. 앞으로 몇 번의 시험은 이 수업에서 치른 것 중 가장 어려울 거다. 그 첫 레시피는 <<recipe_name _args[0] "difficulty">>【이】다." <<He>>【은는】 목을 가다듬는다.
		<<else>>
			"오늘 배울 레시피는 <<recipe_name _args[0] "difficulty">>【이】다," 리버가 말한다.
		<</if>>

		<<switch _args[0]>>
			<<case "apple_crumble">>
				"애플 크리스프와 아주 비슷하지만, 차이는 있다. 핵심은 토핑에 있다."
			<<case "apple_strudel">>
				"직접 만든다면 따뜻할 때 먹는 걸 추천한다. 다행히 식어도 맛은 좋다."
			<<case "arancini">>
				"화상 입지 않게 조심해라. 그래, 뜨거운 기름을 다룰 때마다 이 말을 할 거다. 중요하니까."
			<<case "bakewell_tart">>
				"정확히는 체리 베이크웰 타르트다. 다른 과일은 각자 시간에 실험해 봐도 된다."
			<<case "banana_bread">>
				"펌킨 브레드나 주키니 브레드와 아주 비슷하지만, 학원에서 대량으로 사기엔 바나나가 제일 싸다."
			<<case "bangers_and_mash">>
				"접시가 가득 찼다고 겁먹지 마라. 대부분은 배치하는 일에 가깝다."
			<<case "beef_wellington">>
				"살몬 웰링턴은 기억하겠지. 이것도 아주 비슷하다. 소고기는 연어보다 질겨서 그렇게 섬세하게 다룰 필요는 없지만, 대신 비프 웰링턴은 1인분 크기가 더 커서 그 점이 난이도를 올린다."
			<<case "belgian_bun">>
				"대부분의 페이스트리와 달리, 체리는 선택 사항이 아니다. 다른 베리를 쓰면 더 이상 벨지언 번이 아니게 된다."
			<<case "bread">>
				"집에서 만든 빵은 미리 썰려 나오지 않는다. 그래, 불편하지. 하지만 가게에서 산 것보다 훨씬 맛있다는 걸 알게 될 거다."
			<<case "brownie">>
				"바닐라 아이스크림 한 스쿱을 곁들여 따뜻하게 내는 걸 추천한다. 물론 시험 범위는 아니다."
			<<case "butter">>
				"그 신음 소리 다 들린다. 식료품점에 마가린밖에 없을 때가 오면 나한테 고마워하게 될 거다."
			<<case "carbonara">>
				"이건 스파게티를 기본으로 쓰지만, 거의 모든 파스타가 그렇듯 맛은 소스에 있다. 이번 경우엔 돼지고기도 그렇고."
			<<case "carrot_cake">>
				"이름만 들으면 별로 끌리지 않는다는 건 안다. 하지만 선입견은 접어둬라. 아마 놀라게 될 거다."
			<<case "cauliflower_cheese">>
				"콜리플라워를 칼로 썰지 마라. 손으로 조각내라. 그래야 더 자연스럽게 먹기 좋은 크기가 된다."
			<<case "cheese">>
				"유당불내증이 있는 학생들에게는 미안하지만, 치즈는 많은 요리에 아주 흔하게 쓰이는 재료다."
			<<case "cheese_and_crackers">>
				"손님이 왔을 때 언제나 괜찮은 선택이다. 대단해 보이지는 않지만, 샤르퀴트리 보드에서 몇 단계만 덜어낸 정도다."
			<<case "cheese_topped_trout">>
				"요리계의 흔한 규칙 중 하나는 치즈와 해산물을 같은 접시에 올리면 안 된다는 것이다. 다른 요리 규칙들과 마찬가지로, 충분히 실력 있는 요리사는 그 규칙을 무시할 수 있다."
			<<case "cheeseburger">>
				"햄버거를 만들 수 있다면 이것도 못 만들 이유가 없다. 미리 썰린 치즈는 쓰지 마라. 직접 썰어라. 그만한 가치가 있다."
			<<case "chelsea_bun">>
				"시나몬 번을 먹어본 적 있다면, 이것도 아주 비슷하다. 가장 큰 차이는 첼시 번은 글레이즈가 더 많고, 시나몬 번은 프로스팅이 더 많다는 점이다."
			<<case "chicken_tikka_masala">>
				"티카와 마살라, 혹은 닭고기와 소스는 따로 만든 뒤 합쳐서 끓인다. 서로 다른 두 과정을 동시에 신경 쓸 수 있는지 시험하게 될 거다."
			<<case "chicken_vindaloo">>
				"솔직히 말하겠다. 이건 이 수업에서 배우는 요리 중 아마 가장 매운 요리일 거다. 매운 걸 못 먹는다면, 음, 그건 네 문제라고밖에 할 수 없군."
			<<case "chilli_con_carne">>
				"칠리 콘 카르네는 일반적인 칠리보다 소스가 더 걸쭉하고, 다진 고기 대신 소고기 덩어리를 쓴다. 그래도 기본 원리는 상당 부분 같다."
			<<case "chips">>
				"가장 인기 있는 곁들임 요리 중 하나다. 다 이유가 있지."
			<<case "choc_chip_cookie">>
				"오븐에 넣기 전에 납작하게 누르지 마라. 반죽은 공 모양으로 둬라. 굽는 동안 알아서 퍼진다."
			<<case "chocolate">>
				"이건 그냥 먹으라고 만드는 게 아니라 재료로 쓰기 위한 것이다. 그렇다고 해도, 이 세상에 한 조각도 안 집어먹어 본 요리사는 없다."
			<<case "clam_chowder">>
				"차우더는 단순한 수프가 아니다. 더 걸쭉하고 크리미하다. 스튜와도 다르다. 스튜는 고기 비중이 더 높고, 차우더에 들어가는 크림이 없는 경우가 많다." 설명을 듣고 몇몇 학생이 킥킥거린다. 리버는 무시한다.
			<<case "crumpet">>
				"이건 구멍이 많아서 발라 먹는 것들이 잘 스며든다. 꿀이나 잼과 함께 먹는 걸 추천한다."
			<<case "creme_brulee">>
				"최상의 효과를 내려면 토치가 필요하다는 레시피를 봤을지도 모른다. 사실은 그렇지 않다. 브로일러로 구워도 충분히 잘 된다."
			<<case "fish_and_chips">>
				"마을 어느 펍에 가도 이걸 팔고 있을 거다." <<He>>【은는】 잠시 멈춘다. "일반론을 말한 거다. 펍에 가라는 권유가 아니다."
			<<case "flapjack">>
				"팬케이크가 아니다. 이건 아침식사용이 아니라 간식용으로 만든다."
			<<case "flour">>
				"가장 흥미로운 레시피는 아니라는 건 안다. 하지만 만드는 법은 알아둬야 한다. 밀가루는 수많은 식사의 토대니까."
			<<case "full_english_breakfast">>
				"아침식사라고 부르지만, 하루 중 언제든 먹을 수 있다. 그러면 안 되겠지만. 할 수는 있다."
			<<case "ghostbrew">>
				<!-- failsafe -->
				<<He>>【은는】 잠시 멈춘다. "잠깐. 이건 강의 계획에 없었는데. 너희가 이걸 배우면 안 된다." <<He>>【은는】 혀를 찬다. "<span class="red">시간이 나면 Vrelnir에게 보고해라.</span> 일단은... 계속 진행할 수밖에 없겠군."
			<<case "hamburger">>
				"정석적인 정크푸드다." <<He>>【은는】 희미하게 미소 짓는다. "하지만 너희가 만드는 건 정크푸드가 아니다. <i>진짜</i> 햄버거를 만드는 법을 배우는 거다."
			<<case "honey">>
				"솔직히 말하면, 그냥 꿀을 사는 편이 낫다고 생각한다. 벌집을 찾아다니는 건 디저트 조금 만들자고 하기엔 너무 위험하고 지루하다. 하지만 동네 가게에서 팔지 않으니, 이렇게 됐군."
			<<case "honeyed_pork">>
				"짭짤한 요리에 은은한 단맛을 더하는 건 흔한 요령이다. 다만 이번 경우에는 꿀 소스가 돼지고기에 바르는 글레이즈일 뿐이다."
			<<case "jam">>
				"젤리가 아니다. 잼과 젤리는 별개다. 잼은 과일을 쓰고, 젤리는 과일즙을 쓴다. 보존식품 이야기까지 들어가진 않겠다."
			<<case "jammie_dodger">>
				"모양에 신경 쓰지 않는다면 구멍을 꼭 하트 모양으로 낼 필요는 없다. 하지만 이 시험에서는 미적 요소도 평가할 거다. 명심해라."
			<<case "kedgeree">>
				"일부 순수주의자들은 생선은 해덕만 가능하다고 주장할 거다. 연어나 참치 같은 다른 생선을 쓰면 케저리가 아니라고 말하겠지. 나는 그렇게 생각하진 않는다. 다만 해덕이 다른 생선보다 훨씬 전통적인 것은 사실이다."
			<<case "lasagne">>
				"'파스타 케이크' 농담을 하는 사람은 설거지 당번으로 보낼 거다."
			<<case "lemon_meringue_pie">>
				"이상적인 레몬 머랭 파이는 신맛이 지나치게 강하지 않다. 단맛과 섞인 산뜻한 새콤함에 가깝다."
			<<case "lemonade">>
				"더운 계절에 몸을 식히고 싶다면 훌륭한 음료다. 꿀을 조금 곁들여 따뜻하게 내면 감기 완화에도 그럭저럭 괜찮다."
			<<case "linguine">>
				"링귀네는 해산물이나 알프레도 같은 다른 맛을 위한 베이스로 쓰는 걸 추천한다. 하지만 링귀네 자체가 부실하면, 어떤 소스를 얹어도 그걸 감출 순 없다."
			<<case "macaroni_cheese">>
				"포장지에 적힌 시간보다 덜 삶아라. 오븐 안에서 마저 익을 거다."
			<<case "melting_moment">>
				"달걀 없이 만들 수 있는 드문 페이스트리다."
			<<case "mince_pie">>
				"원래는 민스<i>미트</i> 파이였고, 고기는 결국 레시피에서 빠졌다. 하지만 이름의 '민스' 부분이 실제로 민스미트에서 유래한 건 아니다. 이건 어쩌면 영어 수업에서 다룰 내용이겠군."
			<<case "naan_bread">>
				"곁들임으로 아주 좋다. 특히 갈릭 버터를 듬뿍 바르면 더 그렇다. 하지만 주 요리는 아니다. 많아 봐야 간식 정도다."
			<<case "omelette">>
				"간단한 아침식사다. 원하는 건 뭐든 넣을 수 있지만, 시험에서는 기본 기술에만 집중할 거다."
			<<case "onion_bhaji">>
				"몇몇은 양파에 불만이 있다는 걸 안다. 맛 때문이든 식감 때문이든 말이다. 이 요리가 그걸 극복하는 데 도움이 되길 바란다."
			<<case "orange_juice">>
				"눈 굴리는 거 다 보인다. 방부제로 몸을 채우고 싶다면, 얼마든지 시판 주스를 계속 마셔라."
			<<case "pasta">>
				"수많은 짭짤한 식사의 토대다. 페이스트리와 달콤한 요리가 그런 것처럼."
				<<if $foodstuff.pastry.knows_recipe>>
					<<He>>【은는】 미소 짓는다. "익숙하게 들리나?"
				<</if>>
			<<case "pastry">>
				"수많은 달콤한 식사의 토대다. 파스타와 짭짤한 요리가 그런 것처럼."
				<<if $foodstuff.pasta.knows_recipe>>
					<<He>>【은는】 미소 짓는다. "익숙하게 들리나?"
				<</if>>
			<<case "peach_panzanella">>
				"빵은 깍둑썰기해야 하고, 복숭아는 쐐기 모양으로 썰어야 한다. 요리 자체의 절대 규칙은 아니지만, 이번 시험에서는 요구사항이다. 이번 수업은 주로 칼 다루는 능력을 보는 것이다."
			<<case "pizza">>
				"아쉽지만, 완성되면 약간 기름지긴 할 거다. 치즈를 익히면 원래 그렇게 된다."
			<<case "plum_pudding">>
				"이름과 달리 자두가 꼭 필요한 재료는 아니다. 말린 과일이면 뭐든 된다. 다만 이번 시험에서는 자두를 쓸 거다."
			<<case "poached_pear">>
				"물을 끓는 온도까지 올리지 마라. 포칭은 낮은 온도에서 하는 것이다."
			<<case "porridge">>
				"바쁠 때 먹기 좋은 아침식사다. 맛을 위해 과일이나 꿀을 넣는 걸 추천하지만, 없어도 먹을 수는 있다."
			<<case "potato_pancake">>
				"버블 앤 스퀴크와 아주 비슷하지만, 곁들이는 채소가 없다. 그래서 감자 팬케이크는 아침식사나 간식으로 더 어울린다."
			<<case "prawn_bisque">>
				"새우를 끓이기 전에는 껍질을 벗기지 마라. 그래야 육수에 그냥 잃어버렸을 맛이 많이 우러난다. 껍질은 나중에 걸러낸다."
			<<case "quiche">>
				"아니다, 이건 그냥 짭짤한 파이가 아니다. 정말로 둘의 공통점은 파이 크러스트를 쓴다는 것 정도뿐이다."
			<<case "rich_biscuit">>
				"이걸 차에 담그면 즉시 실격이다." <<he>>【이가】 농담하는 건지 아닌지 알 수 없다.
			<<case "roast_dinner">>
				"여기에 들어가는 것들은 이미 전부 만들 줄 안다. 이제 중요한 건 그것들을 한데 맞춰 내는 것뿐이다."
			<<case "salad">>
				"물론 샐러드에도 여러 종류가 있지만, 대부분은 기본 원리를 공유한다. 가든 샐러드를 만들 수 있다면, 아마 시저 샐러드도 만들 수 있을 거다."
			<<case "salmon_wellington">>
				"오븐에 오래 들어가야 하고, 페이스트리도 미리 식혀야 한다. 하지만 그건 그냥 기다리는 시간일 뿐이니 시험에서는 생략할 거다. 안 그러면 점심시간까지 여기 있어야 하니까."
			<<case "samosa">>
				"모양은 각자 시간에 다양하게 실험해도 된다. 지금은 삼각형으로 만드는 법을 배운다."
			<<case "sausage_roll">>
				"소시지에 대해서는 조금 이야기한 적 있다. 이제 그걸 써먹을 차례다."
			<<case "scone">>
				"맛을 더하지 않은 기본형이지만, 각자 시간에 실험하는 걸 두려워하지 마라. 스콘에는 뭐든 넣을 수 있다." <<He>>【은는】 잠시 멈춘다. "거의 뭐든."
			<<case "shortbread">>
				"이름만 보면 다르게 생각할 수도 있지만, 이건 쿠키의 일종이다. 이걸로 샌드위치를 만들 일은 없을 거다."
			<<case "souffle">>
				"디저트 중에서도 이 레시피는 명성이 괜히 있는 게 아니다. 망치기는 쉽고 완벽하게 만들기는 어렵다. 준비하는 동안 집중해라."
			<<case "spaghetti_bolognese">>
				"다 만들고 나면 월계수 잎을 꼭 빼라. 조리 과정에서 향은 내지만, 그 자체를 먹는 것은 아니다."
			<<case "sponge_cake">>
				"이상적인 스펀지 케이크는 너무 폭신해서 있는지도 거의 못 느낄 정도여야 한다. ...농담이다. 케이크가 있는지 없는지도 모른다면, 아마 아무것도 만들지 못한 거겠지."
			<<case "steak">>
				"분명 많은 학생이 이걸 기다렸을 거다. 솔직히 말하면, 나도 기다렸다."
			<<case "sticky_toffee_pudding">>
				"모든 케이크가 그렇듯, 너무 오래 굽지 않도록 조심해라. 확신이 없으면 이쑤시개 요령을 써라."
			<<case "stuffing">>
				"추수감사절은 해외처럼 여기서 제대로 된 명절은 아니다. 그러니 죄책감 없이 일 년 중 아무 때나 이걸 만들 수 있다는 뜻이다."
			<<case "sweet_and_sour_chicken">>
				"구워내는 게 아니라 볶듯이 튀기는 것이다. 그렇다고 기름에 푹 담가 튀기는 것도 아니다. 우리는 음식을 만드는 거지, 정크푸드를 만드는 게 아니다."
			<<case "swiss_roll">>
				"대부분의 스위스 롤은 초콜릿 때문에 짙은 갈색을 띤다. 하지만 초콜릿은 선택 사항이다. 이번 레시피에서는 생략할 거다."
			<<case "tart">>
				"이름 그대로의 맛이다."
			<<case "turnip_soup">>
				"내가 셀 수 없을 만큼 많이 만들어 본 식사다. 가장 흥미로운 요리는 아니지만, 속을 든든하고 따뜻하게 채워준다."
			<<case "wolfbrew">>
				<!-- failsafe -->
				<<He>>【은는】 잠시 멈춘다. "잠깐. 이건 강의 계획에 없었는데. 너희가 이걸 배우면 안 된다." <<He>>【은는】 혀를 찬다. "<span class="red">시간이 나면 Vrelnir에게 보고해라.</span> 일단은... 계속 진행할 수밖에 없겠군."
			<<case "yorkshire_pudding">>
				"이건 디저트로 먹는 그런 푸딩이 아니다. 로스트비프와 함께 만들 거라면, 고기 육즙을 써서 풍미를 더해라."
			<<case "valentines_chocolate">>
				"작은 하트 모양으로 빚어 과일 필링을 채운 초콜릿이다. 밸런타인 초콜릿이라고 불리며, 적절한 시기에는 많은 사람들이 특별하게 여긴다."
			<<default>>
				"바로 시작하지."
				<<if $debug is 1 or $options.debugdisable is "f">>
					<span class="black">음식 항목 "_args[0]"에는 시험 설명이 없습니다!</span>
				<</if>>
		<</switch>>
		<<if setup.foodstuff[_args[0]].recipe.ingredients.includes("chicken_egg") and !$housekeepingTips.includes("alternativeEgg")>>
			<<set $housekeepingTips.pushUnique("alternativeEgg")>>
			<br><br>
			"대부분의 레시피는 표준 달걀, 즉 닭의 알을 요구한다," <<he>>【이가】 덧붙인다. "하지만 닭의 알이 없다면 <span class="gold">어떤 종류의 알이든 대체 재료로 사용할 수 있다</span>는 점을 기억해라."
		<</if>>
		<<if _args[0] is "lasagne" and !$housekeepingTips.includes("alternativeLasagne")>>
			<<set $housekeepingTips.pushUnique("alternativeLasagne")>>
			<br><br>
			"라자냐는 보통 소고기로 만든다," <<he>>【이가】 덧붙인다. "하지만 소고기가 없거나 다른 맛을 원한다면 <span class="gold">닭고기로 대체할 수도 있다</span>. 돼지고기는 안 된다."
		<</if>>
	<</if>>
	<br><br>
<</widget>>

<<widget "allowLewdIngredients">>
	<<set _allowLewdIngredients to true>>
	<<if !$housekeepingTips.includes("alternativeLewd") and $foodstuff.bottle_of_breast_milk.amount + $foodstuff.bottle_of_semen.amount gte 1>>
		<<set $housekeepingTips.pushUnique("alternativeLewd")>>
		규정이 엄격한 주방이었다면 어림도 없었겠지만, 이 주방은 꽤 자유로워 보인다. 우유나 크림이 부족하다면, <span class="gold">더 음란한 재료로 대체할 수도 있을 것이다</span>.
	<</if>>
<</widget>>

<<widget "kitchenExit">>
	<<unset $recipeMade>>
	<<if $location isnot "avery_mansion">>
		<<handheldon>>
	<</if>>
<</widget>>
