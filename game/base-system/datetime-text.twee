:: Widgets Time Date [widget]
<<widget "sidebarBadEndTimeLabel">>
	<<set _currentBadEnd to $badEndStats.last()>>
	<<if Time.date.hasLostTrackOfTime(_currentBadEnd)>>
		<<if _args[0] is "mobile">>
			<mouse class="tooltip-centertop"><span class="red">?</span><span class="red">당신은 시간 감각을 잃었습니다</span></mouse>
		<<else>>
			<<sidebarDayStateTime>>
		<</if>>
	<<elseif Time.date.hasLostTrackOfMinutes(_currentBadEnd)>>
		<<sidebarHourUnknownMinutes _args[0]>>
	<<else>>
		<<sidebarDefaultTime _args[0]>>
	<</if>>
<</widget>>

<<widget "sidebarDefaultTime">>
	<<switch _args[0]>>
		<<case "desktop">>
			<<ampm>>
		<<case "stats">>
			<<clock>>
			<<ampm>>
		<<case "mobile">>
			<<set _hour to $options.timestyle === "ampm" ? ((Time.hour + 11) % 12) + 1 : Time.hour>>
			<<print _hour.toString().padStart(2, "0")>>
			<br>
			<span class="vertical">:</span>
			<br>
			<<print Time.minute.toString().padStart(2, "0")>>
			<<if $options.timestyle === "ampm">>
				<br>
				<<print Time.hour >= 12 ? "오후" : "오전">>
			<</if>>
		<<default>>
			<<ampm>>
	<</switch>>
<</widget>>

<<widget "sidebarHourUnknownMinutes">>
	<<switch _args[0]>>
		<<case "mobile">>
			<<set _hour to $options.timestyle === "ampm" ? ((Time.hour + 11) % 12) + 1 : Time.hour>>
			<mouse class="tooltip-centertop">
				<span class="red">
					<<print _hour.toString().padStart(2, "0")>>
					<br>
					<span class="vertical">:</span>
					<br>
					??
				</span>
				<span class="red">당신은 시간 감각을 잃었습니다</span>
			</mouse>
		<<case "stats">>
			<span class="obfuscatedTimeClock"><<clock>></span>
			<<set _hour to $options.timestyle === "ampm" ? ((Time.hour + 11) % 12) + 1 : Time.hour>>
			<mouse class="tooltip-centertop"><span class="red"><<print _hour.toString()>>?</span><span class="red">당신은 시간 감각을 잃었습니다</span></mouse>
		<<default>>
			<<set _hour to $options.timestyle === "ampm" ? ((Time.hour + 11) % 12) + 1 : Time.hour>>
			<mouse class="tooltip-centertop"><span class="red"><<print _hour.toString()>>?</span><span class="red">당신은 시간 감각을 잃었습니다</span></mouse>
	<</switch>>
<</widget>>

<<widget "sidebarDayStateTime">>
	<<switch Time.dayState>><<case "dawn">><<set _dayStateText to "새벽">><<case "day">><<set _dayStateText to "낮">><<case "dusk">><<set _dayStateText to "황혼">><<case "night">><<set _dayStateText to "밤">><<default>><<set _dayStateText to Time.dayState>><</switch>>
	<mouse class="tooltip-centertop"><span class="red">_dayStateText?</span><span class="red">당신은 시간 감각을 잃었습니다</span></mouse>
<</widget>>

<<widget "sidebarTime">>
	<<set _currentBadEnd to $badEndStats.last()>>
	<<if _currentBadEnd?.trackedStart and _currentBadEnd.trackedEnd is undefined>>
		<<sidebarBadEndTimeLabel _args[0]>>
	<<else>>
		<<sidebarDefaultTime _args[0]>>
	<</if>>
<</widget>>

<<widget "ampm_text">><<silently>>
	<<if Time.hour is 0>>
