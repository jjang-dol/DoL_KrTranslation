	<<upperruined>><<lowerruined>>
<<elseif $phase is 1>>
	$worn.upper.name
	<<upperruined>>
<<elseif $phase is 2>>
	$worn.lower.name
	<<lowerruined>>
<<elseif $phase is 3>>
	$worn.under_upper.name
	<<underupperruined>><<underlowerruined>>
<<elseif $phase is 4>>
	$worn.under_upper.name
	<<underupperruined>>
<<else>>
	$worn.under_lower.name
	<<underlowerruined>>
<</if>>【을를】 벗어 2층 높이의 화물 컨테이너 더미 위로 던져버린다.
