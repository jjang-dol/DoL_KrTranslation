		<<elseif $docks.status gte 60>>
			<<if _daily_slacked is 1>>
				동료들이 <span class="lblue">당신을 감싸준다.</span>
			<<elseif _daily_slacked is 2>>
				동료들이 <span class="blue">넘어가 준다.</span>
			<<elseif _daily_slacked is 3>>
				동료들이 <span class="purple">점점 참을성을 잃어가고 있다.</span>
			<<elseif $docks.dayType is "busy">>
				동료들은 <span class="red">바쁜 날에 당신이 돕지 않아 화가 났다.</span><<dockstatus -2>><<llcool>>
			<<else>>
				동료들이 <span class="red">당신에 대해 불평한다.</span><<dockstatus -1>><<lcool>>
			<</if>>
		<<elseif $docks.status gte 40>>
			<<if _daily_slacked is 1>>
