:: Widgets Docks [widget]

<<widget "dockclotheson">>
	<<storeon "docks" "check">>
	<<if _store_check is 1>>
		당신은 벗어둔 곳에서 옷을 찾는다.
		<<storeon "docks">>
		<br><br>
	<</if>>
<</widget>>

<<widget "dockunbindoffer">>
	<<endevent>>
	<<generate1>><<person1>><<person>>【이가】 당신에게 미소지으며 다가온다. "밧줄에 얽혔어?" <<he>>【이가】 묻는다. "이리 와, 내가 풀어줄게."
	<br><br>

	<<link [[수락한다|Docks Binding]]>><</link>>
	<br>
	<<link [[거절한다|Docks Binding Refuse]]>><</link>>
	<br>
<</widget>>

<<widget "dockoptions">>
	<<endevent>>

	<<if $docks.returnedToWork>>
		당신은 다시 일하러 돌아가기로 결정한다.<<unset $docks.returnedToWork>>
		<br><br>
	<</if>>

	<<dockstatustext>>

	/* Slacking suspicion display, values set in Docks Work */
	<<if $docks.suspicion gte 4>>
		<span class="red">감독관이 당신의 주위를 따라다닌다.</span>
	<<elseif $docks.suspicion is 3>>
		<span class="purple">감독관이 당신을 주의 깊게 감시한다.</span>
	<<elseif $docks.suspicion is 2>>
		<span class="blue">감독관이 당신을 계속 지켜보고 있다.</span>
	<<elseif $docks.suspicion is 1>>
		<span class="lblue">감독관이 당신을 힐끔거린다.</span>
	<</if>>
	<br><br>

	/* Tracked to display whether slacking will lower coolness.
	The number of slack actions allowed varies based on current $docks.status */
	<<set _daily_slacked to ($docks.dailyHours.shift.slacked + $docks.dailyHours.overtime.slacked)>>

	<<if $docks.dayType is "busy">>
		<<set _fatigue_value to 9>>
	<<elseif $docks.dayType is "slow">>
		<<set _fatigue_value to 3>>
	<<else>>
		<<set _fatigue_value to 6>>
	<</if>>

	/* If the player shows up late, pass enough time until they're back on schedule */
	/* Also locks schedule in again after events that pass variable time, such as sex */
	<<set _time_to_pass to (60 - Time.minute)>>
	<<if _time_to_pass is 60>>
		<<set _time_to_display to "1:00">>
	<<elseif _time_to_pass lt 10>>
		<<set _time_to_display to "0:0" + _time_to_pass>>
	<<else>>
		<<set _time_to_display to "0:" + _time_to_pass>>
	<</if>>

	<<if Time.hour is 11>> /* 11-12 */
		<<icon "food/eat.png">><<link [[점심 식사 (1:00)|Docks Lunch]]>><<stress -6>><</link>><<lstress>>
	<<elseif Time.hour gte 16>> /* 16-19 (3 hours), no overtime on slow days, checked in dockleave */
		<<if hasSexStat("exhibitionism", 5) and !$daily.docksExhibitionism>>
			<<icon "actions/dock-work.png">>
			<<link [["옷을 벗고 일한다 (" + _time_to_display + ")"|Docks Work]]>>
				<<undressclothes "docks">><<dockstatus 1>>
				<<set $phase to 2>><<tiredness _fatigue_value>><<pass _time_to_pass>>
				<<set $docks.dailyHours.overtime.total += 1>><<set $docks.dailyHours.overtime.workedHard += 1>>
				<<if $docks.dayType is "lewd">><<arousal 1200>><</if>>
			<</link>>
			<<exhibitionist5>>
			<<if $docks.dayType is "busy">><<ggtiredness>><<else>><<gtiredness>><</if>>
			<<if $docks.dayType is "lewd">><<gggarousal>><</if>>
			<<gcool>>
			<br>
		<</if>>
		<<icon "actions/dock-work.png">>
		<<link [["초과 근무한다 (" + _time_to_display + ")"|Docks Work]]>>
			<<set $phase to 0>><<tiredness _fatigue_value>><<pass _time_to_pass>>
			<<set $docks.dailyHours.overtime.total += 1>><<set $docks.dailyHours.overtime.workedHard += 1>>
			<<if $docks.dayType is "lewd">><<arousal 900>><</if>>
		<</link>>
		<<if $docks.dayType is "busy">><<ggtiredness>><<else>><<gtiredness>><</if>>
		<<if $docks.dayType is "lewd">><<ggarousal>><</if>>
		<br>
		<<relaxicon>>
		<<link [["농땡이친다 (" + _time_to_display + ")"|Docks Work]]>>
			<<set $phase to 1>><<pass _time_to_pass>>
			<<set $docks.dailyHours.overtime.total += 1>><<set $docks.dailyHours.overtime.slacked += 1>>
			<<if $docks.dayType is "lewd">><<arousal 600>><</if>>
		<</link>>
		/* Displays whether dock status is lowered when slacking as information for the player */
		/* This varies based on current status in 20 status intervals. At high status, the player can get away with more slacking, but supervisors will still disapprove */
		/* $docks.status is decremented in Docks Work to reduce code duplication */
		<<if ($docks.dayType isnot "slow") and ($docks.status lt 20 or ($docks.status lt 40 and _daily_slacked gte 1) or ($docks.status lt 60 and _daily_slacked gte 2) or ($docks.status lt 80 and _daily_slacked gte 3) or _daily_slacked gte 4)>>
			<<if $docks.dayType is "busy">><<llcool>><<else>><<lcool>><</if>>
		<</if>>
		<<if $docks.dayType is "lewd">><<garousal>><</if>>
	<<else>> /* 7-11 (4 hours), then 12-16 (4 hours), so 8 total */
		<<if hasSexStat("exhibitionism", 5) and !$daily.docksExhibitionism>>
			<<skinicon "strip">>
			<<link [["옷을 벗고 일한다 (" + _time_to_display + ")"|Docks Work]]>>
				<<undressclothes "docks">><<dockstatus 1>>
				<<set $phase to 2>><<tiredness _fatigue_value>><<pass _time_to_pass>>
				<<set $docks.dailyHours.shift.total += 1>><<set $docks.dailyHours.shift.workedHard += 1>>
				<<if $docks.dayType is "lewd">><<arousal 1200>><</if>>
			<</link>>
			<<exhibitionist5>>
			<<if $docks.dayType is "busy">><<ggtiredness>><<else>><<gtiredness>><</if>>
			<<if $docks.dayType is "lewd">><<gggarousal>><</if>>
			<<gcool>>
			<br>
		<</if>>
		<<icon "actions/dock-work.png">>
		<<link [["일한다 (" + _time_to_display + ")"|Docks Work]]>>
			<<set $phase to 0>><<tiredness _fatigue_value>><<pass _time_to_pass>>
			<<set $docks.dailyHours.shift.total += 1>><<set $docks.dailyHours.shift.workedHard += 1>>
			<<if $docks.dayType is "lewd">><<arousal 900>><</if>>
		<</link>>
		<<if $docks.dayType is "busy">><<ggtiredness>><<else>><<gtiredness>><</if>>
		<<if $docks.dayType is "lewd">><<ggarousal>><</if>>
		<br>
		<<relaxicon>>
		<<link [["농땡이친다 (" + _time_to_display + ")"|Docks Work]]>>
			<<set $phase to 1>><<pass _time_to_pass>>
			<<set $docks.dailyHours.shift.total += 1>><<set $docks.dailyHours.shift.slacked += 1>>
			<<if $docks.dayType is "lewd">><<arousal 600>><</if>>
		<</link>>
		/* See note on the same if-conditional above */
		<<if ($docks.dayType isnot "slow") and ($docks.status lt 20 or ($docks.status lt 40 and _daily_slacked gte 1) or ($docks.status lt 60 and _daily_slacked gte 2) or ($docks.status lt 80 and _daily_slacked gte 3) or _daily_slacked gte 4)>>
			<<if $docks.dayType is "busy">><<llcool>><<else>><<lcool>><</if>>
		<</if>>
		<<if $docks.dayType is "lewd">><<garousal>><</if>>
	<</if>>
	<br><br>

	<<if Time.hour lte 15>>
		<<docksicon>><<link [[일찍 떠난다|Docks Leave]]>><<storeon "docks">><</link>>
	<<else>>
		<<docksicon>><<link [[떠난다|Docks Leave]]>><<storeon "docks">><</link>>
	<</if>>
	<br>
<</widget>>

/* Used to go to the right widget based on the current time */
<<widget "docklunchprompt">>
	<<if Time.hour is 11>>
		<<if $phase is "prompt">> /* Currently unused, but lets displaying a Next prompt */
			<<foodicon "eat">><<link [[다음|Docks Lunch]]>><</link>>
		<<else>>
			<<docklunchoptions>>
		<</if>>
	<<else>>
		<<dockoptions>>
	<</if>>
<</widget>>

<<widget "docklunchoptions">>
	<<if $arousal gte $arousalmax>>
		<<orgasmLocation "docks">>
	<</if>>

	<<if Time.minute >= 50>>
		점심시간이 거의 끝나간다.
	<<else>>
		점심시간이다.
	<</if>>
	<br><br>

	다른 부두 노동자들은
	<<if $docks.dayType is "busy">>
		과로로 지쳐 보인다. 그들은
	<<elseif $docks.dayType is "slow">>
		지루해 보인다. 그들은
	<<elseif $docks.dayType is "lewd">>
		허둥대는 것 같다. 그들은
	<</if>>
	싸 온 도시락을 먹으며 자기들끼리 잡담을 나눈다.<<if Time.minute >= 50>> 일부는 초조하게 시간을 확인하고 있다.<</if>>
	<br><br>

	<<dockoverhear>>

	<<dockstatus>>

	<<if Time.minute >= 31>>
		<<set _time_to_pass to 60 - Time.minute>>
	<<else>>
		<<set _time_to_pass to 30>>
	<</if>>

	<<if !$worn.face.type.includes("gag")>>
		<<socialiseicon>><<link [["사교 활동 (0:" + _time_to_pass + ")"|Docks Lunch Socialise]]>><<pass _time_to_pass>><</link>>
		<br>
		<<if Time.minute < 50>>
			<<brothelicon>><<link [[추파를 던진다 (0:05)|Docks Lunch Flirt]]>><<pass 5>><</link>><<promiscuous1>>
			<br>
		<</if>>
	<</if>>
	<<walkicon>><<link [["산책한다 (0:" + _time_to_pass + ")"|Docks Lunch Stroll]]>><<pass _time_to_pass>><</link>>
	<br>
	<<if Time.minute < 50>>
		<<bedicon "zzz">><<link [["잠을 잔다 (0:" + _time_to_pass + ")"|Docks Lunch Sleep]]>><<pass _time_to_pass>><</link>><<ltiredness>>
		<br>
		<<if $docks.fakeID is "shown">>
			<<walkicon>><<link [[떠난다|Docks Lunch Leave]]>><</link>>
			<br>
		<</if>>
	<</if>>
<</widget>>


<<widget "docklunchseduce">>
	<<if hasSexStat("promiscuity", 2)>>
		<<link [[유혹한다 (0:01)|Docks Lunch Seduce]]>><<pass 1>><</link>><<promiscuous2>>
	<<else>>
		<<insufficientStat "promiscuity" "더 나아가기엔">>
	<</if>>
	<br>
	<<link [[작별 인사를 한다|Docks Lunch]]>><<endevent>><</link>>
	<br>
<</widget>>

<<widget "dockstatustext">>
	<<set $docks.status to Math.clamp($docks.status, 0, 100)>>
	<<if $docks.status gte 100>>
		<span class="green">다른 노동자들이 당신을 선망의 눈길로 쳐다봅니다.</span>
	<<elseif $docks.status gte 80>>
		<span class="teal">다른 노동자들이 당신을 존중합니다.</span>
	<<elseif $docks.status gte 60>>
		<span class="lblue">다른 노동자들이 당신을 동료로 받아들입니다.</span>
	<<elseif $docks.status gte 40>>
		<span class="blue">다른 노동자들이 당신을 못마땅하지만 참아줍니다.</span>
	<<elseif $docks.status gte 20>>
		<span class="purple">다른 노동자들이 당신을 의심스럽게 바라봅니다.</span>
	<<else>>
		<span class="red">다른 노동자들이 당신을 경멸합니다.</span>
	<</if>>
<</widget>>

<<widget "dockstatus">>
	<<if _args[0]>>
		<<set $docks.status += (_args[0] * 2)>>
		<<set $docks.status to Math.clamp($docks.status, 0, 100)>>
	<</if>>
<</widget>>

<<widget "dockleave">>
	/* Leaving after a shift or overtime */
	<<if Time.hour gte 16>>
		<<if Time.hour gte 19>>
			당신은 장비 치우는 것을 돕고, 저녁 동안 컨테이너가 잠겨 있는지 확인한다.
			<br><br>
		<<elseif $docks.dayType is "slow" and Time.hour gte 16>>
			오늘은 더 이상 옮길 화물이 남지 않았기에, 누구도 야근을 할 수 없다. 당신은 장비 치우는 것을 돕고, 저녁 동안 컨테이너가 잠겨 있는지 확인한다.
			<br><br>
		<</if>>
		<<dockclotheson>>
		당신은 경비원 앞의 대기줄에 합류한다. 퉁명스러운 <<generate1>><<person1>><<personsimple>>【이가】 그날의 일당이 든 갈색 봉투를 나누어 주고 있다.
		<br><br>

		/* Calculating pay. The constant 8 for eight hours of work can't be used since the player can start late */
		<<if $docks.dayType is "busy" or $docks.dayType is "lewd" or (Time.month is 12 and Time.monthDay is 25)>>
			<<set _overtime_multiplier to 2>>
		<<else>>
			<<set _overtime_multiplier to 1.5>>
		<</if>>
		<<set _shift_wage to ($docks.wage * ($docks.dailyHours.shift.total - $docks.dailyHours.shift.unpaid))>>
		<<if _shift_wage lt 0>><<set _shift_wage to 0>><</if>>
		<<if Time.month is 12 and Time.monthDay is 25>> /* All day overtime rates on Christmas */
			<<set _shift_wage to (_shift_wage * _overtime_multiplier)>>
		<</if>>
		<<set _overtime_wage to ($docks.wage * ($docks.dailyHours.overtime.total - $docks.dailyHours.overtime.unpaid) * _overtime_multiplier)>>
		<<if _overtime_wage lt 0>><<set _overtime_wage to 0>><</if>>
		<<set _bonus to 0>>
		<<if $christmas is 1>> /* £25 bonus on Christmas week, £100 bonus on Christmas day */
			<<if $docks.dailyHours.shift.unpaid gte $docks.dailyHours.shift.total>>
				<<set _bonus to 0>>
			<<elseif Time.monthDay is 25>>
				<<set _bonus to 10000>>
			<<else>>
				<<set _bonus to 2500>>
			<</if>>
		<</if>>
		<<set _total_wage to (_shift_wage + _overtime_wage + _bonus)>>
		<<set _shift_wage_display to (_shift_wage / 100)>>
		<<set _overtime_wage_display to (_overtime_wage / 100)>>
		<<set _bonus_display to (_bonus / 100)>>
		<<set _total_wage_display to (_total_wage / 100)>>

		<<if $docks.dailyHours.shift.unpaid gte $docks.dailyHours.shift.total>> /* slacked the entire shift with max suspicion */
			<<if $docks.dailyHours.overtime.unpaid gte $docks.dailyHours.overtime.total>> /* slacked all of overtime with max suspicion */
				당신은 봉투를 받지 못한다<<if $christmas is 1>>, 심지어 크리스마스 보너스조차 없다<</if>>. <span class="red">"일 안 했으면 돈도 없다."</span> <<he>>【이가】 말한다. "<<if $christmas is 1>>여긴 자선 단체가 아니야. 그저 궁둥이 붙이고 앉아만 있다고 보너스를 받을 순 없지.<<else>>일도 안 할 거면서 여긴 왜 온 거냐?<</if>>" <<He>>【은는】 잠시 당신을 훑어보지만, 떠나는 것을 막지는 않는다.
			<<else>>
				야근 수당 <span class="gold">£<<print _overtime_wage_display>></span>【이가】 든 가벼운 봉투를 받는다<<if $christmas is 1>>, 하지만 크리스마스 보너스는 지급이 보류되었다<</if>>. <span class="purple">"우린 교대 근무 시간 중에 일을 하길 기대하는 거다."</span> <<personsimple>>【이가】 말한다. "야근 시간에만 일하는 건 안 쳐줘. 계속 이런 식이면 여기 오래 못 붙어 있을 거다." <<He>>【은는】 잠시 당신을 훑어보지만, 떠나는 것을 막지는 않는다.
				<<wearProp "manila envelope">>
			<</if>>
		<<elseif $docks.dailyHours.overtime.total gte 1 and $docks.dailyHours.overtime.total gt $docks.dailyHours.overtime.unpaid>> /* worked during shift and overtime */
			당신은 기본 근무 수당으로 <span class="gold">£<<print _shift_wage_display>></span>, 추가로 야근 수당 <span class="gold">£<<print _overtime_wage_display>></span>【을를】 받아<<if $christmas is 1>>, 여기에 크리스마스 보너스 <span class="gold">£<<print _bonus_display>></span>까지 합쳐<</if>> 총 <span class="gold">£<<print _total_wage_display>></span>【을를】 번다.
			<<wearProp "manila envelope">>
		<<else>> /* no overtime */
			당신은 <span class="gold">£<<print _shift_wage_display>></span>【을를】 번다<<if $christmas is 1>>. 크리스마스 보너스 <span class="gold">£<<print _bonus_display>></span>【을를】 합쳐서 총 <span class="gold">£<<print _total_wage_display>></span>이다<</if>>.
			<<wearProp "manila envelope">>
		<</if>>
		<<money `_total_wage` "docksWage">>
		<br><br>

		<<if $docks.status gte 60 and $docks.pub.cooldown is 0>>
			<<set $docks.pub.cooldown to 2>> /* reduced in dailyDockEffects() */
			<<generate2>><<person2>>

			당신의 동료 무리가 게이트에 모여 있다. 한 <<person>>【이가】 당신에게 손을 흔들어 부른다. "우린 펍 순례하러 갈 건데," <<he>>【이가】 말한다.
			<<if playerBellyVisible()>>
				"너도 같이 가면 환영이지만, 그런데..."
				<<He>>【은는】 당신의 <<bellyDescription "pc">>【을를】 내려다본다. "네 애가 우리처럼 망가진 채로 태어나길 바라진 않겠지." 그들은 장난기 어린 웃음을 터뜨리며 당신과 함께 웃는다.
				<br><br>

				<<link [[다음|Docks]]>><<endevent>><</link>>
				<br>
			<<else>>
				"같이 갈래?"
				<br><br>

				<<if playerIsPregnant() and playerAwareTheyArePregnant()>>
					<span class="blue">아이를 가졌다는 사실을 알면서 그런 방탕한 밤에 몸을 맡길 수는 없다.</span><br>
				<<elseif $money gte 500>>
					<<pubicon>><<link [[받아들인다 (1:00 £5)|Docks Pub Crawl]]>><<endevent>><<set $docks.pub.count to 0>><<money -500>><<drunk 120>><<dockstatus 1>><<stress -6>><<pass 60>><</link>><<gcool>><<lstress>><<ggdrunk>>
					<br>
				<</if>>
				<<refuseicon>><<link [[거절한다|Docks]]>><<endevent>><</link>>
				<br>
			<</if>>
		<<else>>
			<<link [[다음|Docks]]>><<endevent>><</link>>
			<br>
		<</if>>
	/* Leaving before the end of the shift */
	<<else>>
		당신은 매니저에게 떠나야 한다고 말한다.
		<br><br>

		"경비원들이 널 다시 들여보내 주지 않을 거고, 오늘 일당도 못 받게 될 거다. 정말 확실한가?"
		<br><br>

		<<link [[다시 생각해 본다|Docks Options]]>><<set $docks.returnedToWork to true>><</link>>
		<br>
		<<link [[그래도 떠난다|Docks]]>><<set $daily.docksLeftEarly to true>><</link>>
	<</if>>
<</widget>>

<<widget "dockwork">>
	<<timeTrackingManual "docks" 1>>
	<<if $stress gte $stressmax>>
		<<if isPregnancyEnding()>>
			<<pregnancyPassout "docks">>
		<<else>>
			당신은 무리해서 몸을 혹사했다.
			<br><br>
			<<passout>>

			<<if dangerEvent()>>
				<<link [[다음|Passout Docks]]>><</link>>
				<br>
			<<else>>
				<<ambulance>>
			<</if>>
		<</if>>
	/* Leaving the docks after overtime. To note, this prevents an event from firing during the last hour */
	<<elseif (Time.hour gte 19) or ($docks.dayType is "slow" and Time.hour gte 16)>>
		<<dockleave>>
	<<elseif $docks.status lte 0 and $docks.wage gte 1600>> /* pay cut if status is 0 */
		<<generate1>><<person1>><<person>>【이가】 클립보드를 들고 당신에게 걸어온다. <span class="red">매니저다.</span>
		<br><br>
		<<set $docks.wage to ($docks.wage - 100)>>
		"실적을 검토해 봤는데, 네가 여기서 밥값을 제대로 못 하는 것 같더군. 그래서 <span class="red">네 시급을</span> <span class="gold">£<<print ($docks.wage / 100)>>【으로로】</span> <span class="red">깎기로 했다.</span> 이번 교대가 끝나면 새로 적용된 임금으로 받게 될 거다. 똑바로 해."<<stress 12>><<trauma 12>><<ggstress>><<ggtrauma>>
		<br><br>
		다른 부두 노동자들이 그 이야기를 엿들었다. 몇몇은 꼴좋다며 고소하다는 표정을 지었다. 대다수는 동정 어린 시선을 보내다 다시 일터로 돌아간다.<<dockstatus 30>><<gggcool>>
		<br><br>
		<<endevent>>
		<<dockoptions>>
	<<else>> /* Regular work events */
		<<dockworkevents>>
	<</if>>
<</widget>>

<<widget "dockworkevents">>
	<<cleareventpool>>

	<<addinlineevent "docks_work_container_inspect">>
		당신은 갑판에서 올려진 컨테이너들의 내용물을 검사하는 임무를 맡았다.
		<<rng>>
		<<if $rng gte 81 and $money gte 12000 and !$docks.slave.seen>>
			<<generatey1>><<generate2>><<person2>>컨테이너 중 하나에서 억눌린 듯한 울음소리가 들린다.
			<br><br>
			당신이 키코드를 입력하지만, 문은 열리지 않는다. "그건 아니야," 다른 노동자가 말한다. <<he>>【이가】 문에 인쇄된 이니셜을 가리킨다. "우린 저것들은 검사 안 해." <<he>>【이가】 울음소리를 들었더라도, 그냥 무시하는 듯하다.
			<br><br>
			<<set $lock to 400>>
			<<if currentSkillValue('skulduggery') gte $lock>>
				<<if pcAreArmsBound("both")>>
					<span class="blue">팔이 묶여 있지만 않았다면,</span> 잠금장치를 딸 수 있었을 텐데.
					<br><br>
				<<else>>
					<<wearProp "lockpick">>
					<span class="green">잠금장치를 따기 쉬워 보인다.</span>
					<br><br>
					<<link [[그래도 침입한다 (£100 1:00)|Docks Slave Open]]>><<handheldon>><<set $docks.slave.seen to true>><<crimeUp 1 "trespassing">><</link>><<crime "trespassing">>
					<br>
				<</if>>
			<<else>>
				<span class="red">잠금장치가 너무 정교해서 당신 실력으로는 딸 수 없어 보인다.</span><<skulduggeryrequired>>
				<br><br>
			<</if>>
			<<link [[목소리를 무시한다|Docks Slave Ignore]]>><<handheldon>><</link>>
			<br>
		<<else>>
			<<rng>>
			<<if $rng gte 81>>
				많은 컨테이너 안에는 민간인들이 주문한 상품들이 들어 있다. 그중 하나에 뜯어진 소포가 있고, 안에서 무언가 반짝인다.
				<br><br>
				<<link [[훔친다|Docks Steal]]>><<crimeUp 60 "thievery">><<set $blackmoney += 60>><</link>><<crime "thievery">>
				<br>
				<<link [[훔치지 않는다|Docks Don't Steal]]>><</link>>
				<br>
			<<else>>
				기계가 잔뜩 들어 있다. 무슨 용도인지는 모르겠지만, 모두 제대로 꼬리표가 붙어 있다.
				<br><br>
				<<dockoptions>>
			<</if>>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "docks_work_vessel_guide">>
		한 선박이 부두로 접근하는 것을 도와달라고 요청해 온다. 당신과 <<generate1>><<person1>><<person>>, 그리고 <<generate2>><<person2>><<person>>【이가】 이 일을 맡게 되었다. 작은 배에 올라 그 배를 만나기 위해 출항한다.
		<br><br>

		<<if dangerEvent()>>
			목적지에 절반쯤 도착했을 때, <<person>>【이가】 엔진을 끈다. <<he>>【와과】 <<person1>><<person>>【이가】 당신을 노골적으로 쳐다본다. "싱싱한 <<girl>>【이가】 바다 한가운데에 오도카니 남겨졌네," <<he>>【이가】 이죽거린다. "우리랑 화끈하게 놀아주면, 널 다치게 할 일은 없을 텐데 말이야." <<person>>【이가】 긴 밧줄을 휘두른다.
			<br><br>
			<<link [[고개를 끄덕인다|Docks Rape]]>><<set $molestationstart to 1>><</link>>
			<br>
			<<link [[싸운다|Docks Rape]]>><<set $fightstart to 1>><</link>>
			<br>
			<<link [[보트를 뒤집는다|Docks Rape Capsize]]>><<dockstatus -1>><</link>><<lcool>>
			<br>
		<<else>>
			<<person>>【이가】 선장을 유도하는 동안 당신과 <<person1>><<person>>【은는】 선원들이 계류 밧줄을 묶는 것을 돕는다. <<if $exposed gte 1>>선원들이 대놓고 드러내진 않으려 애쓰면서도, 당신의 벗은 몸을 음흉하게 훑어본다. <</if>>배를 부두에 정박시키는 데 성공한다.
			<br><br>
			<<endevent>>
			<<dockoptions>>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "docks_work_tourist_vessel">>
		관광선 한 척이 부두를 가로질러 오며 다른 배들의 출항을 지연시키고 있다. 교신에도 응답하지 않는다. 당신이 작은 배를 타고 메시지를 전달하러 간다.
		<br><br>
		<<generate1>><<person1>>
		<<if $exposed gte 1>>
			당신이 배에 오른다. 발가벗은 <<girl>>【이가】 배에 나타나자 잘 차려입은 군중 사이에서 웅성거리는 소리가 퍼진다. 선장이 승객 한 명과 시시덕거리고 있는 것을 발견한다. 당신을 본 <<he>>【은는】 들고 있던 잔을 떨어뜨린다.
		<<else>>
			당신이 배에 올라 잘 차려입은 군중을 헤치고 선장을 찾는다. <<him>>【이가】 한 승객과 시시덕거리고 있는 것을 발견한다.
			<br><br>
		<</if>>
		<<if $speech_attitude is "meek">>
			"<<sir>>, 이쪽으로 접근하시면 안 됩니다," 당신이 말한다. "다른 배들의 길을 막고 계십니다."
		<<elseif $speech_attitude is "bratty">>
			"끼어들어서 미안한데요," 당신이 말한다. "당신 그 멍청한 배가 다른 배랑 충돌하기 직전이거든요."
		<<else>>
			"전달할 메시지가 있습니다," 당신이 말한다. "경로가 잘못되었습니다. 배를 물리고 올바른 각도로 접근하셔야 합니다. 다른 배들이 지연되고 있습니다."
		<</if>>
		<br><br>
		"기다리라고 해," <<he>>【이가】 코웃음 친다. "우리 배엔 높으신 분들이 많이 타셨거든. 얼른 육지에 내리고 싶어 하셔." <<he>>【은는】 몸을 돌린다.
		<br><br>
		<<if hasSexStat("promiscuity", 4)>>
			<<link [[<<him>>【을를】 유혹한다|Docks Tourist Seduce]]>><</link>><<promiscuous4>>
			<br>
		<</if>>
		<<if displayDefiantOption(500)>>
			<<link [[승객들을 겁준다|Docks Tourist Intimidate]]>><<dockstatus 3>><<wolfDefiant 500>><</link>><<defianttext 500>><<ggcool>>
			<br>
		<</if>>
		<<link [[부두로 돌아간다|Docks Tourist Return]]>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "docks_work_compound_lorry">>
		당신은 화물차에서 짐을 내리는 일을 맡았다. 근처에서 짐을 내리고 있는 다른 차량을 발견하는데, 작업자들의 제복이 묘하다. <<generate1>><<person1>><<generate2>><<person>>【이가】 그들을 감독하고 있다.
		<br><br>
		"저 놈들은 신경 쓰지 마," 당신 옆에서 일하던 <<person2>><<person>>【이가】 말한다. "자기네 짐은 알아서 처리하니까."
		<br><br>
		<<link [[자세히 보기 위해 몰래 다가간다|Docks Compound]]>><<drugs 240>><<stress -6>><</link>><<garousal>><<lstress>>
		<br>
		<<link [[무시한다|Docks Compound Ignore]]>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "docks_work_data_inconsistency">>
		당신은 화물 정보를 컴퓨터에 기록하는 일을 맡았다. 내역을 확인하던 중 모순되는 부분을 발견한다.
		<br><br>
		<<link [[모순점을 조사한다|Docks Examine]]>><<set $phase to 0>><<stress 6>><</link>><<skill_difficulty `currentSkillValue("maths")` "수학" 1 1000>><<gstress>>
		<br>
		<<if currentSkillValue('skulduggery') gte 400>>
			<<set $skulduggerydifficulty to 500>>
			<<link [[값비싼 물건의 위치를 기록해 둔다|Docks Examine Valuables]]>><<set $phase to 2>><</link>><<skulduggerydifficulty>>
			<br>
		<</if>>
		<<link [[무시한다|Docks Examine]]>><<set $phase to 1>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "docks_work_cleaning_pier">>
		당신은 부두를 청소하는 일을 맡았다.
		<<rng>>
		<<if $rng gte 61>>
			당신은 접근하는 배의 앞쪽 수면에 뭔가 분홍색 형체가 있는 것을 발견한다.
			<br><br>
			<!-- Convert to proper history skill check? -->
			<<link [[조사한다|Docks History]]>><<set $phase to 0>><<stress 6>><</link>><<note "역사" "blue">><<gstress>>
			<br>
			<<link [[무시한다|Docks History]]>><<set $phase to 1>><</link>>
			<br>
		<<else>>
			아무 문제 없이 마쳤다.
			<br><br>
			<<dockoptions>>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "docks_work_moving_crates">>
		차량에 실을 상자들을 옮기는 임무를 맡았다. <<generate1>><<person1>>"지게차가 필요하겠군," 감독관이 말한다. "열쇠 좀 찾아볼게."
		<br><br>
		<<if currentSkillValue('physique') gte 14000>>
			상자가 그리 무거워 보이지 않는다. <<he>>【이가】 돌아왔을 무렵, 당신은 이미 작업을 끝마친 상태다. "보기보다 힘이 장사네," <<he>>【이가】 헛웃음을 짓는다.
			<<gcool>><<dockstatus 1>>
			<br><br>
			<<dockoptions>>
		<<else>>
			당신이 상자를 옮기는 동안 <<he>>【은는】 당신을 지켜보지만, 당신은 문제 없이 작업을 해낸다.
			<br><br>
			<<dockoptions>>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "docks_work_untying_ship">>
		당신은 부두에 정박된 배의 밧줄을 푸는 일을 맡았다. 밧줄이 두껍고 무거우며, 다른 배가 자리를 써야 하므로 서둘러야 한다.
		<br><br>
		<<if currentSkillValue('physique') gte 5000 and $feetuse isnot "bound">>
			시간 내에 끝냈다.
			<br><br>
		<<else>>
			간신히 제시간에 마쳤다. 그야말로 아슬아슬하게.
			<<if $feetuse is "bound">>
				<span class="pink">다리가 묶인 상태에서 그걸 해냈다는 건 기적에 가깝다.</span>
			<</if>>
			<<gtiredness>><<tiredness 6>>
			<br><br>
		<</if>>

		<<if pcAreArmsBound("any") or $feetuse is "bound">>
			<<dockunbindoffer>>
		<<else>>
			<<dockoptions>>
		<</if>>
	<</addinlineevent>>

	<<if $exposed lte 0>>
		<<addinlineevent "docks_work_lubricating_machinery">>
			기계에 윤활유를 바르는 일을 맡았다.
			<<if $docks.status gte 30>>
				아무런 문제 없이 해낸다.
				<br><br>
				<<dockoptions>>
			<<elseif !$worn.over_lower.type.includes("naked")>>
				당신이 크레인 작업을 하던 도중 엔진이 울리며 붐이 솟구친다. 당신의 $worn.over_lower.name에 크레인 갈고리가 꿰인 채 허공으로 끌어 올려진다.
				<br><br>
				<<generate1>><<person1>>크레인이 멈추고 당신은 공중에 대롱대롱 매달린다. 크레인을 조종하던 <<person>>【이가】 빙글빙글 도는 당신을 향해 손을 흔든다. 다른 부두 노동자들도 구경하러 모여들어 휘파람을 불며 손뼉을 친다.
				<br><br>
				<<set $worn.over_lower.integrity -= 10>>
				<<if $worn.over_lower.integrity lte 0 and !$worn.lower.type.includes("naked")>>
					<<overlowerruined>><<exposure>>
					당신의 몸무게 때문에 옷이 찢겨지며 갈고리에서 빠져나온다. <<generate2>><<person2>><<person>>【이가】 당신을 받아낸다. <<he>>【은는】 당신의 <<lewdness>>【을를】 음흉하게 쳐다본다. 다른 사람들도 마찬가지다. <<covered>> 당신은 몸부림치며 풀려나고, 구경꾼들의 야유를 뒤로한 채 안전한 곳으로 뛰어간다. 덮을 만한 천 조각을 찾아낸다.
					<<gtrauma>><<gstress>><<garousal>><<trauma 6>><<stress 6>><<arousal 600>>
					<br><br>
					<<towelup>>
					<<dockoptions>>
				<<else>>
					<<if $worn.over_lower.integrity lte 0>>
						당신의 몸무게 때문에 당신은 <<print $worn.over_lower.name>>에서 찢어지듯 빠져나온다.
					<<else>>
						당신의 몸무게 때문에 갈고리에서 찢어지듯 빠져나온다.
					<</if>>
					<<generate2>><<person2>><<person>>【이가】 당신을 받아냈지만, 당신은 몸부림치며 빠져나온다.
					<<gstress>><<stress 6>>
					<br><br>
					<<link [[화낸다|Docks Angry]]>><<stress -3>><<dockstatus 1>><</link>><<gcool>><<lstress>>
					<br>
					<<link [[걸어간다|Docks Walk]]>><</link>>
					<br>
				<</if>>
			<<else>>
				당신이 크레인 작업을 하던 도중 엔진이 울리며 붐이 솟구친다. 당신의 $worn.lower.name에 크레인 갈고리가 꿰인 채 허공으로 끌어 올려진다.
				<br><br>
				<<generate1>><<person1>>크레인이 멈추고 당신은 공중에 대롱대롱 매달린다. 크레인을 조종하던 <<person>>【이가】 빙글빙글 도는 당신을 향해 손을 흔든다. 다른 부두 노동자들도 구경하러 모여들어 휘파람을 불며 손뼉을 친다.
				<br><br>
				<<set $worn.lower.integrity -= 10>>
				<<if $worn.lower.integrity lte 0>>
					<<lowerruined>><<exposure>>
					당신의 몸무게 때문에 옷이 찢겨지며 갈고리에서 빠져나온다. <<generate2>><<person2>><<person>>【이가】 당신을 받아낸다. <<he>>【은는】 당신의 <<lewdness>>【을를】 음흉하게 쳐다본다. 다른 사람들도 마찬가지다. <<covered>> 당신은 몸부림치며 풀려나고, 구경꾼들의 야유를 뒤로한 채 안전한 곳으로 뛰어간다. 덮을 만한 천 조각을 찾아낸다.
					<<gtrauma>><<gstress>><<garousal>><<trauma 6>><<stress 6>><<arousal 600>>
					<br><br>
					<<towelup>>
					<<dockoptions>>
				<<else>>
					당신의 몸무게 때문에 갈고리에서 찢어지듯 빠져나온다. <<generate2>><<person2>><<person>>【이가】 당신을 받아냈지만, 당신은 몸부림치며 빠져나온다.
					<<gstress>><<stress 6>>
					<br><br>
					<<link [[화낸다|Docks Angry]]>><<stress -3>><<dockstatus 1>><</link>><<gcool>><<lstress>>
					<br>
					<<link [[걸어간다|Docks Walk]]>><</link>>
					<br>
				<</if>>
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<addinlineevent "docks_work_lifting_crates">>
		당신은 정박된 배에서 상자를 들어 올려 부두에 내려놓는다. 다른 짐들에 비하면 작지만 무겁다.
		<<if currentSkillValue('physique') gte 15000 and !pcAreArmsBound("any")>>
			당신은 아무 문제 없이 해낸다. 다른 부두 노동자들이 지쳐 쉴 때도 계속 일을 이어간다.
			<<gcool>><<dockstatus 1>>
			<br><br>
		<<elseif currentSkillValue('physique') gte 5000 and !pcAreArmsBound("any")>>
			어찌어찌 다른 부두 노동자들 속도를 따라잡는다.
			<br><br>
		<<else>>
			너무 무거워서 갑판을 벗어나기도 전에 쉬어야 했다. 다른 노동자들이 몇 번이나 상자를 옮길 동안 당신은 겨우 하나 옮기는 데 그친다.
			<<if pcAreArmsBound("both")>>
				<span class="pink">팔이 묶여 제대로 잡을 수 없어서 훨씬 더 힘들었다.</span>
			<</if>>
			<br><br>
			당신이 두 번째 상자를 옮기려 애쓸 때, 근육질의 부두 노동자가 다가와 당신 손에서 짐을 빼앗아 든다. "마지막 상자다," <<generate1>><<person1>><<he>>【이가】 말한다. <<he>>【은는】 당신을 쳐다보지도 않는다.
			<<lcool>><<dockstatus -1>>
			<br><br>
		<</if>>
		<<endevent>>

		<<if pcAreArmsBound("any") or $feetuse is "bound">>
			<<dockunbindoffer>>
		<<else>>
			<<dockoptions>>
		<</if>>
	<</addinlineevent>>

	<<runeventpool>>
<</widget>>

<<widget "dockoverhear">>
	<<cleareventpool>>

	<<addinlineevent "docks_overhear_new_shipments">>
		"이상한 제복 입은 녀석들은 정체가 뭐야? <<print either("매니저가 입을 꾹 다물고 있어.", "매니저한테서 제대로 된 답을 못 들었어.", "매니저들한테 물어보면 다들 말을 돌리더라구.")>>"
		<br>
		<<if $rng gte 81>>
			"나도 아는 게 없어. 불법적인 일이 아니었으면 좋겠는데."
		<<elseif $rng gte 61>>
			"글쎄. 난 돈만 받으면 장땡이니까 알 바 아니야."
		<<elseif $rng gte 41>>
			"좀 투명하게 알려줬으면 좋겠는데, 모르는 게 약일 수도 있지."
		<<elseif $rng gte 21>>
			"걔들이 다루는 물건에서 단내 같은 게 나는데, 기분이 좀 이상해지더라."
		<<else>>
			"엘크 거리에 있는 건물과 연관돼 있다는 소문도 들었어. 무슨 신종 마약 같은 걸 테스트한다고. 난 좀 억지스럽다 생각하지만."
		<</if>>
	<</addinlineevent>>

	<<if $beauty gte ($beautymax / 7) * 3>>
		<<addinlineevent "docks_overhear_orphan_beautiful">>
			<<if $rng gte 81>>
				"요즘 부두에서 일하는 끝내주는 엉덩이 봤어?"
			<<elseif $rng gte 61>>
				"부두에서 일하는 그 새로운 <<girl>> 봤어? 정말 예쁘더라."
			<<elseif $rng gte 41>>
				"새로 온 그 <<girl>> 존나 꼴리지 않냐."
			<<elseif $rng gte 21>>
				"저기 새로 온 <<girl>>, 나 같은 놈이랑 어울려 줄까?"
			<<else>>
				"여기에 새로 온 안구 정화용 애가 있다고 하던데. 한번 대줄까?"
			<</if>>
			<br>
			<<rng>>
			<<if $rng gte $world_corruption_soft>>
				<<rng>>
				<<if $rng gte 81>>
					"<<print either("손", "발바닥", "손")>> 조심해."
				<<elseif $rng gte 61>>
					"변태 짓 하지 마. 여긴 돈 벌러 온 거지 떡치러 온 게 아니라고."
				<<elseif $rng gte 41>>
					"변태처럼 굴지 마. 쳐다보고 싶으면 스트립 클럽이나 가라구."
				<<elseif $rng gte 21>>
					"<<phim>>【을를】 건들지 마. 저 나이에 부두에서 일할 정도면 이미 꽤 고생했을 테니까."
				<<else>>
					"<<pShes>> 아직 학생이거나 갓 졸업했겠지. 네 또래나 찾아보셔."
				<</if>>
			<<else>>
				<<rng>>
				<<if $rng gte 81>>
					"<<print either("손", "발바닥", "손")>> 조심해. 걘 내 거니까."
				<<elseif $rng gte 61>>
					"어, 걔 꽤 꼴리더라. <<phim>>【이】랑 한번 떡쳐보고 싶네."
				<<elseif $rng gte 41>>
					"스트립 클럽에나 있을 법한 <<girl>>처럼 생겼더라. 종일 <<if $settings.malechance gte random(1, 100)>>내 기둥 위에서 춤추게<<else>>내 위에서 비비게<</if>> 만들 수 있을 텐데."
				<<elseif $rng gte 21>>
					"존나 귀엽네. 부두에서 일할 정도면 꽤나 간절했나 보지. 엄청 간절했겠어."
				<<else>>
					"<<pShes>> 아직 학생이거나 어쩌면 갓 학교를 나왔겠지. 저 순진함을 빼앗아 버리기엔 딱 좋은 시기구만."
				<</if>>
				<<stress 6>><<trauma 6>><<gstress>><<gtrauma>>
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<addinlineevent "docks_overhear_union_question">>
		"당신들 노조 있다고 들었는데. 나도 가입할 수 있나?"
		<br>
		"신분증 보여주고 계약서에 서명해. 조합비는 네 임금의 2%다."
		<br>
		"나쁘지 않네. 가입하면 나한테 뭐가 떨어지는데?"
		<br>
		"공정한 대우랑 단체 교섭권. 자세한 건 노조위원장이 설명해 줄 거야."
	<</addinlineevent>>

	<<addinlineevent "docks_overhear_container_lift" 0.5>>
		"크레인이 들어 올릴 때 컨테이너 안에 있으면 어떨까 상상해 본 적 있어?"
		<br>
		"아니. 끔찍할 거 같은데."
		<br>
		"왜?"
		<br>
		"높은 곳에서 칠흑 같은 어둠 속에 갇힌 데다가 답답하고, 멀미까지..."
		<br>
		"오케이, 무슨 말인지 알겠네."
	<</addinlineevent>>

	<<addinlineevent "docks_overhear_food_request">>
		"먹을 것 좀 남은 거 없어? 마누라가 오늘 점심을 안 싸줬어."
		<br>
		"그래. 반쯤 먹은 <<print either("샌드위치", "과자 봉지", "단백질 바")>> £1에 줄 수 있어."
		<br>
		"<<print either("됐어. 차라리 굶고 말지.", "좋아.", "알았어, 배고파 죽겠으니까 어쩔 수 없지.")>>"
	<</addinlineevent>>

	<<addinlineevent "docks_overhear_pub_crawl">>
		"나중에 우리랑 같이 술집에 안 갈래?"
		<br>
		<<if $rng gte 51>>
			<<if $docks.pub.cooldown gt 0>>
				"또? 지난번에 마신 거 아직 숙취가 안 풀렸는데."
				<br>
				"그럴 만도 하지. 우리 당분간은 술 좀 자제해야겠어."
			<<else>>
				"나? 좋아, 난 완전히 취해볼 생각이야."
				<br>
				"교대 근무 끝나면 애들 모아볼게."
			<</if>>
		<<elseif $rng gte 21>>
			"모르겠어. 난 저녁이 되면 <<print either("완전히 녹초가 되거든", "너무 피곤해")>>."
			<br>
			"야근?"
			<br>
			"어.
			<<if $docks.status lt 20>>
				돈이 필요하거든. 교대 근무 끝나고 남아서 게으름이나 피우는 녀석들 때문에 전혀 도움이 안 돼."<<stress 6>><<gstress>>
			<<else>>
				"돈이 필요하거든."
			<</if>>
		<<elseif $rng gte 11>>
			"미안, 그런 생활은 이제 관뒀어."
			<br>
			"친구들이랑 한잔 즐기기에 너무 늙은 건 아니잖아, 그치?"
			<br>
			"사양할게. 난 술에 안 좋은 추억이 많거든."
		<<else>>
			"미안, 난 술 안 마셔."
			<br>
			"믿을 수가 없군. 술 안 마시는 부두 노동자라니. 유니콘을 본 기분인데."
		<</if>>
	<</addinlineevent>>

	<<if Weather.temperature gte 25>>
		<<addinlineevent "docks_overhear_hot_day" 2>>
			"오늘 <<print either("날씨 덥다", "존나 덥네", "돼지처럼 땀이 쏟아져", "햇볕이 쨍쨍해서 지치네")>>. 마실 거 뭐 없냐?"
			<br>
			"없어. 더우면 옷이나 벗어."
			<<rng>>
			<<if $rng gte 91>>
				<br>
				"근데 나 노팬티로 왔는데."
				<br>
				"아."
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<if Weather.temperature lte 5>>
		<<addinlineevent "docks_overhear_cold_day" 2>>
			"오늘 <<print either("추워", "서늘해", "쌀쌀해", "매섭게 춥네", "존나 춥다", "마녀의 젖꼭지보다 차가워", "우물 파는 놈 엉덩이보다 차갑네", "놋쇠 원숭이 불알이 얼어붙을 만큼 춥다", "너무 추워서 개들이 소화전에 들러붙어")>>. 남는 <<print either("외투", "재킷", "목도리")>>【이나나】 <<print either("아무거나", "뭔가")>> 없냐?"
			<br>
			"<<print either("그래, 차에서 가져다줄게. 금방 돌아올게.", "없어, 남는 게 하나도 없어. 더 열심히 일해봐. 금방 몸이 따뜻해질걸.", "지금은 없지만, 다른 사람한테 있는지 물어봐 줄게.")>>"
		<</addinlineevent>>
	<</if>>

	<<addinlineevent "docks_overhear_students">>
		"요즘 주말에 일하는 학생들이 부쩍 늘었네."
		<br>
		"돈이 궁한 모양이지. 걔들이 우리 속도에 맞춰 따라오긴 해?"
		<br>
		<<if $docks.status gte 100>>
			"그 중 한 명은 우리 중에 일 제일 잘할지도. 나 일자리 뺏길까 봐 슬슬 걱정된다구."
		<<elseif $docks.status gte 80>>
			"걔 중 한 명이 요새 일을 엄청 잘 도와주고 있어서 살맛 난다니까. 다들 저렇게 성실하면 얼마나 좋아."
		<<elseif $docks.status gte 60>>
			"새로 온 <<girl>>【이가】 일 잘하더라구. 요새 엄청 큰 힘이 되고 있어."
		<<elseif $docks.status gte 40>>
			"새로 온 <<girl>>【이가】 지금까지 잘 버티고 있어. 지 몫은 충분히 하더라."
		<<elseif $docks.status gte 20>>
			"대부분 주말 지나면 그만두는데. 너무 빡세거든. 새로 온 저 <<girl>>... 뭐, 내가 본 더 최악인 애들도 있었으니까."
		<<else>>
			"새로 온 <<girl>>【은는】 쓸모없는 골칫거리야. 내가 다 신기할 정도야, <<pshe>>【이가】 아직 <<if $docks.wage gte 1600>>월급 삭감을 안 당했다니<<else>>해고를 안 당했다니<</if>>."<<stress 6>><<gstress>>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "docks_overhear_seagulls">>
		"갈매기들이 갈수록 뻔뻔해진다니까. 며칠 전에는 내 손에서 바로 <<print either("햄버거", "샌드위치")>>【을를】 낚아채려고 하더라!"
		<br>
		"괜히 날아다니는 쥐라고 부르는 게 아니지."
		<br>
		"비둘기 이야기인 줄 알았는데?"
		<br>
		"뭐, 똑같은 골칫덩이들이니까."
	<</addinlineevent>>

	<<addinlineevent "docks_overhear_container_accident">>
		"오늘 누군가 <<print either("컨테이너를 떨어뜨릴", "바다에 짐을 떨어뜨릴")>> <<print either("확률이 얼마나 될 것 같아", "내기 해볼래")>>?"
		<br>
		<<if $rng gte 76>>
			"사고 안 난 지 좀 됐지. 슬슬 한번 날 때가 됐어."
		<<elseif $rng gte 51>>
			"반반이지. 일어나거나 안 일어나거나."
		<<elseif $rng gte 26>>
			"생각보다 꽤 높지. 우리 윗대가리들이 일할 사람 제대로 검증이나 한대냐?"
		<<else>>
			"경영진들이 핏덩이들한테 크레인 조종 좀 그만 시켜야 좀 내려가겠지. 우릴 다 죽이려고 작정한 건가?"
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "docks_overhear_strippers">>
		"클럽의 스트리퍼들 중에 싱글이 있을 것 같냐?"
		<br>
		<<if $rng gte 51>>
			"그딴 질문엔 대답할 가치도 없어."
			<br>
			"왜, 스트리퍼한테 쫄았어?"
			<br>
			"아니, 넌 너무 좆같이 생겨서 그런 걸 따질 처지가 아니란 소리지."
		<<else>>
			"글쎄다. 네가 직접 물어보지 그러냐?"
			<br>
			"부끄럽게 어떻게 물어봐. 그리고 경호원한테 쫓겨나고 싶지 않아."
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "docks_overhear_giant_hawk" 0.5>>
		"황야에 있는 거대한 매에 대해 들어본 적 있어?"
		<br>
		"아니. 무슨 일인데?"
		<br>
		"존나게 크대. 엄청나다고 하더라. 보통 새보다 훨씬 크다나 봐."
		<br>
		"그걸 실제로 본 사람이 있어?"
		<br>
		"이런저런 목격담은 있던데. 나도 사진이나 동영상으로 본 건 없어."
		<br>
		"도시 괴담 같네. 이 마을 사람들 미신 얼마나 믿는지 알잖아."
		<br>
		"응. 네 말이 맞을지도 몰라."
	<</addinlineevent>>

	<<addinlineevent "docks_overhear_exercise">>
		"교대 근무 끝나면 아직도 운동해?"
		<br>
		<<if $rng gte 76>>
			"아니. 여기서 할 건 다 하잖아."
			<br>
			"하체 운동도 안 해? 에어로빅 같은 것도 안 해?"
			<br>
			"출퇴근길에 걷는 걸로 충분해... 뭐, 달리기도 시작해야 할지 모르겠지만."
		<<elseif $rng gte 51>>
			"하체 운동만 해. 뭐 스쿼트나 에어로빅 같은 거... 내 팔은 이대로도 충분히 굵어지거든."
			<br>
			"어떻게 운동할 체력이 나?"
			<br>
			"난 교대 근무 끝나면 무조건 집에 가. 야근했으면 남아 있는 체력도 없었겠지."
		<<elseif $rng gte 26>>
			"어쩔 수 없어. 내 하루는 대부분 크레인 조종하는 일이니까. 차 안에서 하는 사무직 같다고 해야 하나."
			<br>
			"부럽네."
			<br>
			"부러워할 거 없어. 수천 파운드짜리 짐이 파손되면 너 모가지만 날아가는 게 아니라고."
		<<else>>
			"어. 해변에서 수영하거나 날씨 추울 때는 공원에서 뛰어."
			<br>
			"공원? 사람들이 밤에 거기서 발가벗고 뛴다는 소문이 있던데."
			<br>
			"진짜? 난 해지기 전에만 가는데. 이 일은 너무 일찍 시작해서 야행성이 될 틈이 없어."
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "docks_overhear_wage">>
		"너 시간당 얼마 받아?"
		<br>
		<<set _overhear_dock_wage to random(15, 24)>>
		"£<<print _overhear_dock_wage>>."
		<br>
		<<if _overhear_dock_wage gte 23>>
			"와. 부럽다."
			<br>
			"그 돈 받으려고 존나 뺑이쳤어. 농땡이 피우다 걸리면 친구들이 널 추천 안 해 줄 테니까."
		<<elseif _overhear_dock_wage gte 21>>
			"그 정도면 꽤 좋네."
			<br>
			"뼈 빠지게 고생한 보람이 있네."
			<br>
			"나도 슬슬 날 굴려야겠군..."
		<<elseif _overhear_dock_wage gte 19>>
			"헤이, 나랑 엇비슷하구만."
			<br>
			"어, 그게 평균 급여야. 몇 달 짱박혀서 농땡이 피우지 않고 붙어있으면 웬만하면 받을 수 있어."
		<<elseif _overhear_dock_wage gte 17>>
			"그건 좀 적은 거 아니야."
			<br>
			"나도 알아. 근무 시간에 땡땡이 좀 쳤다고 누군가 앙심 품은 것 같은 기분이 들기 시작했어."
		<<else>>
			"주말에 일하는 학생들이 받는 돈이 그 정도잖아."
			<br>
			"어, 이건 다음 직장을 구하기 위한 디딤돌일 뿐이야. 일한 경력이랑 추천서만 멀쩡히 받으면 그걸로 됐지 뭐."
			<br>
			"월급 오르는 거 깔보지 마라. 추가로 받는 돈도 모이면 쏠쏠하거든."
		<</if>>
	<</addinlineevent>>

	<<if $dissociation gte 1>>
		<<addinlineevent "docks_overhear_visibly_disturbed" 2>>
			"저 <<lass>> 한테 뭔가 <<if $dissociation gte 2>>단단히 <</if>>문제가 있는 거 같아."
			<br>
			<<if $docks.status gte 80>>
				"<<phim>>【이가】 불쌍해. 여기서 일 엄청 도와주는데, 언젠가 폭발할 것 같아 무섭더라."
				<br>
				"우리도 뭔가 좀 거들어야 하는 거 아니야?"
				<br>
				"글쎄다. 얜 그냥 놔두는 편이 나을 거 같은데. 이미 골칫거리가 한 다발 있는 것 같잖아."
			<<else>>
				"원인이 뭘 것 같아? 마약? 학대?"
				<br>
				"잘 모르겠지만, 난 거리를 둘 거야. 쟤가 언제 우리한테 성질을 부릴지 누가 알아."<<stress 6>><<trauma 6>><<gstress>><<gtrauma>>
			<</if>>
		<</addinlineevent>>
	<</if>>

	/* Any partial animal transformation that is not hidden */

	<<set _tf to checkTFparts()>>
	<<set _tfPartList to Object.keys(_tf)>>

	<<if _tfPartList.includesAny("birdWings", "cowHorns", "wolfTail", "catTail", "cowTail", "birdTail", "foxTail", "wolfEars", "catEars", "cowEars", "foxEars")>>
		<<addinlineevent "docks_overhear_animal_costume">>
			"새로 온 <<girl>>【은는】 대체 뭐야? 왜 허구한 날 저 동물 코스튬만 입고 있대?"
			<br>
			<<if $fame.bestiality gte 600>>
				"딴 사람한텐 말하지 마, <<pshe>>【이가】 짐승들이랑 잔다는 소문이 돌고 있더라."
				<br>
				"토나오네. 존나 괴물이구만."<<stress 6>><<trauma 6>><<dockstatus -1>><<gstress>><<gtrauma>><<lcool>>
			<<elseif $halloween is 1>>
				<<if Time.monthDay is 31>>
					"까먹었어? 할로윈이잖아. 쟤 아마 나중에 사탕 받으러 돌아다닐지도 몰라."
				<<else>>
					"할로윈 다가오잖아. 쟤 자기 코스튬 자랑하고 있는 걸지도."
				<</if>>
			<<else>>
				"성적 취향 문제일 수도 있지. 너 이 마을 잘 알잖아. 여기 사는 사람들은 괴물들이니까."<<stress 6>><<gstress>>
			<</if>>
		<</addinlineevent>>
	<</if>>

	/* Fame events */

	/* Divides the chance for each fame event by total fame, up to 2200 */
	<<set _fame_total to fameTotal()>>
	<<if _fame_total gte 2200>>
		<<set _fame_total to 2200>>
	<</if>>
	<<set _chance_divisor to (600 / _fame_total)>>

	/* Negative fame events */

	<<if $fame.sex gte 600>>
		<<addinlineevent "docks_overhear_fame_sex" _chance_divisor>>
			"여기서 일하는 저 <<lass>> 봤어? 동네 사람들이랑 다 잤다고 소문났던데."
			<br>
			"난 저딴 <<girl>> 근처에도 안 갈 거다. 완전히 구멍동서잖아."
			<br>
			"근데 침대에서 기술은 엄청 좋을 거 아니야. 생각해 보라—"
			<br>
			"안 들려 임마. 너 혼자 <<phim>>【을를】 실컷 따먹든가."<<stress 6>><<trauma 6>><<gstress>><<gtrauma>>
		<</addinlineevent>>
	<</if>>

	<<if $fame.bestiality gte 600>>
		<<addinlineevent "docks_overhear_fame_deviancy" _chance_divisor>>
			"여기 새로 들어온 직원 중 한 명이
			<<if $rng gte 96>>
				동물들한테 좀 관심이 있나 봐. 그런 놈은 나 하나뿐인 줄 알았더니만..."
				<br>
				"뭐라고?"
				<br>
				"아니, 그 일에 대해 나만 아는 줄 알았다고."
				<br>
				"그렇군."<<stress 6>><<trauma 6>><<gstress>><<gtrauma>>
			<<elseif $rng gte 91>>
				"동물이랑 잔대."
				<br>
				"그거 존나 섹시하네."
				<br>
				"뭐라고?"
				<br>
				"아니, 그 뉴스 완전 핫이슈라고. 다들 그거 들었다며."
				<br>
				"그렇군."<<stress 6>><<trauma 6>><<gstress>><<gtrauma>>
			<<else>>
				"동물이랑 잔대."
				<br>
				"그거 존나 징그럽네."
				<br>
				"그러게? 쟤 움직이는 거면 아무나 다 붙잡고 따먹을 놈이래잖아. 완전 미친놈 아니야."
				<br>
				"왜 감옥에 쳐넣지 않는 건데?"
				<br>
				"내가 어찌 알겠어. 짭새들도 그놈이랑 한패인가 보지 뭐."
				<br>
				"그래. <<pshe>> 돼지들하고도 떡칠지도 몰라. 안 그래?"<<stress 6>><<trauma 6>><<gstress>><<gtrauma>>
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<if $fame.rape gte 600>>
