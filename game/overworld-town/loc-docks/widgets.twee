<</widget>>

<<widget "dockpubdestination">>
	<<if $bus is "high">>
		<<link [[멈춘다|High Street]]>><<endevent>><<set $eventskip to 1>><</link>>
	<<elseif $bus is "harvest">>
		<<link [[멈춘다|Harvest Street]]>><<endevent>><<set $eventskip to 1>><</link>>
	<<elseif $bus is "connudatus">>
		<<link [[멈춘다|Connudatus Street]]>><<endevent>><<set $eventskip to 1>><</link>>
	<<elseif $bus is "barb">>
		<<link [[멈춘다|Barb Street]]>><<endevent>><<set $eventskip to 1>><</link>>
	<<else>>
		<<link [[멈춘다|Mer Street]]>><<endevent>><<set $eventskip to 1>><</link>>
	<</if>>
<</widget>>

<<widget "dockpuboptions">>
	<<endevent>>
	<<if $money gte 500>>
		<<link [[계속한다 (1:00 £5)|Docks Pub Crawl]]>><<set $docks.pub.count to 0>><<money -500>><<drunk 120>><<dockstatus 1>><<stress -6>><<pass 60>><</link>><<gcool>><<lstress>><<ggdrunk>>
		<br>
	<</if>>
	<<dockpubdestination>>
<</widget>>

<<widget "dockpubquiz">>
	<<if $rng gte 81>>

		과학이다.
		<br><br>

		<<link [[동료들에게 맡긴다|Docks Pub Crawl Science]]>><<set $phase2 to 0>><</link>>
		<br>
		<<link [[직접 답한다|Docks Pub Crawl Science]]>><<set $phase2 to 1>><</link>><<skill_difficulty `currentSkillValue("science")` "과학" 1 1000>>
		<br>
		<<link [[틀린 답을 낸다|Docks Pub Crawl Science]]>><<set $phase2 to 2>><</link>>
		<br>

	<<elseif $rng gte 61>>

		산수다. 동료 중 하나가 손가락으로 숫자를 셀 준비를 한다.
		<br><br>

		<<link [[동료들에게 맡긴다|Docks Pub Crawl Maths]]>><<set $phase2 to 0>><</link>>
		<br>
		<<link [[직접 답한다|Docks Pub Crawl Maths]]>><<set $phase2 to 1>><</link>><<skill_difficulty `currentSkillValue("maths")` "수학" 1 1000>>
		<br>
		<<link [[틀린 답을 낸다|Docks Pub Crawl Maths]]>><<set $phase2 to 2>><</link>>
		<br>

	<<elseif $rng gte 41>>

		문학이다.
		<br><br>

		<<link [[동료들에게 맡긴다|Docks Pub Crawl English]]>><<set $phase2 to 0>><</link>>
		<br>
		<<link [[직접 답한다|Docks Pub Crawl English]]>><<set $phase2 to 1>><</link>><<englishdifficulty 1 1000>>
		<br>
		<<link [[틀린 답을 낸다|Docks Pub Crawl English]]>><<set $phase2 to 2>><</link>>
		<br>

	<<elseif $rng gte 21>>

		지역 역사다.
		<br><br>

		<<link [[동료들에게 맡긴다|Docks Pub Crawl History]]>><<set $phase2 to 0>><</link>>
		<br>
		<<link [[직접 답한다|Docks Pub Crawl History]]>><<set $phase2 to 1>><</link>><<skill_difficulty `currentSkillValue("history")` "역사" 1 1000>>
		<br>
		<<link [[틀린 답을 낸다|Docks Pub Crawl History]]>><<set $phase2 to 2>><</link>>
		<br>

	<<else>>

		사랑 나누기다. 그 말에 음탕한 환호성이 터져 나온다. 동료들은 이번엔 거저먹기라며 호언장담한다.
		<br><br>

		<<link [[동료들에게 맡긴다|Docks Pub Crawl Love]]>><<set $phase2 to 0>><</link>>
		<br>
		<<link [[직접 답한다|Docks Pub Crawl Love]]>><<set $phase2 to 1>><<dockstatus 1>><</link>><<skill_difficulty $promiscuity "음란" 1 100>><<gcool>>
		<br>
		<<link [[틀린 답을 낸다|Docks Pub Crawl Love]]>><<set $phase2 to 2>><<dockstatus 1>><</link>><<gcool>>
		<br>

	<</if>>
<</widget>>

<<widget "skul_dock_init">>
	<<if $skul_dock_init is undefined>>
		<<unset $catsuit_spawned>>
		<<set $skul_dock_init to 1>>
		<<set $dock_security to 1>>
		<<set $skul_dock to {}>>
		<<set $skul_dock.NW to {}>>
		<<set $skul_dock.N to {}>>
		<<set $skul_dock.NE to {}>>
		<<set $skul_dock.W to {}>>
		<<set $skul_dock.M to {}>>
		<<set $skul_dock.E to {}>>
		<<set $skul_dock.SW to {}>>
		<<set $skul_dock.S to {}>>
		<<set $skul_dock.SE to {}>>
		<<set _skul_dock_keys to Object.keys($skul_dock)>>
		<<set _count to 0>>
		<<for _i to 0; _i lt _skul_dock_keys.length; _i++>>
			<<rng>>
			<<if $rng gte 100>>
				<<set $skul_dock[_skul_dock_keys[_i]].contents to "gold">>
				<<set _count++>>
			<<elseif $rng gte 96>>
				<<set $skul_dock[_skul_dock_keys[_i]].contents to "aphrodisiacs">>
				<<set _count++>>
			<<elseif $rng gte 76>>
				<<set $skul_dock[_skul_dock_keys[_i]].contents to "electronics">>
				<<set _count++>>
			<<elseif $rng gte 66>>
				<<set $skul_dock[_skul_dock_keys[_i]].contents to "fertiliser">>
				<<set _count++>>
			<<elseif $rng gte 55 and !$catsuit_found and !$catsuit_spawned>>
				<<set $catsuit_spawned to 1>>
				<<set $skul_dock[_skul_dock_keys[_i]].contents to "equipment">>
				<<set _count++>>
			<<elseif $rng gte 61 and $catsuit_found>>
				<<set $skul_dock[_skul_dock_keys[_i]].contents to "mechanisms">>
				<<set _count++>>
			<<else>>
				<<set $skul_dock[_skul_dock_keys[_i]].contents to "none">>
			<</if>>
		<</for>>
		<<if _count lte 1>>
			<<for _i to 0; _i lt _skul_dock_keys.length; _i++>>
				<<if $skul_dock[_skul_dock_keys[_i]].contents is "none">>
					<<rng>>
					<<if $rng gte 96>>
						<<set $skul_dock[_skul_dock_keys.pluck()].contents to "aphrodisiacs">>
						<<set _count++>>
					<<elseif $rng gte 76>>
						<<set $skul_dock[_skul_dock_keys.pluck()].contents to "electronics">>
						<<set _count++>>
					<<elseif $rng gte 66>>
						<<set $skul_dock[_skul_dock_keys.pluck()].contents to "fertiliser">>
						<<set _count++>>
					<</if>>
					<<if _count is 2>>
						<<break>>
					<</if>>
				<</if>>
			<</for>>
			<!--Added in case the variable gets use elsewhere-->
			<<set _skul_dock_keys to Object.keys($skul_dock)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "skul_dock_contents">>
	<<set _skul_dock_keys to Object.keys($skul_dock)>>
	<<for _i to 0; _i lt _skul_dock_keys.length; _i++>>
		<<if $skul_dock[_skul_dock_keys[_i]].contents is _args[0] and $skul_dock[_skul_dock_keys[_i]].state isnot "known">>
			<<set $skul_dock[_skul_dock_keys[_i]].state to "known">>
			<<set _dock_location to _skul_dock_keys[_i]>>
			<<set _dock_contents to $skul_dock[_skul_dock_keys[_i]].contents>>
			<<break>>
		<</if>>
	<</for>>
<</widget>>

<<widget "skul_dock_location">>
	<<switch _args[0]>>
		<<case "NW">>
			<<set _text_output to "계류장">>
		<<case "N">>
			<<set _text_output to "정박된 배">>
		<<case "NE">>
			<<set _text_output to "창고">>
		<<case "W">>
			<<set _text_output to "크레인">>
		<<case "M">>
			<<set _text_output to "가장 높이 쌓인 화물 컨테이너 더미">>
		<<case "E">>
			<<set _text_output to "사무실 건물">>
		<<case "SW">>
			<<set _text_output to "트럭 하역장">>
		<<case "S">>
			<<set _text_output to "정문">>
		<<case "SE">>
			<<set _text_output to "주차장">>
	<</switch>>
	<<print _text_output>>
<</widget>>

<<widget "skul_dock_nav">>
	<<if $bus is "W">>
		<<icon "anchor.png">><<link [[정박된 배 쪽으로 몰래 간다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "NW">><</link>><<skul_dock_state NW>>
		<br>
	<</if>>
	<<if $bus is "N">>
		<<getouticon>><<link [[배에서 몰래 내려간다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "NW">><</link>><<skul_dock_state NW>>
		<br>
	<</if>>
	<<if $bus is "NW">>
		<<icon "anchor.png">><<link [[정박된 배에 몰래 오른다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "N">><</link>><<skul_dock_state N>>
		<br>
	<</if>>
	<<if $bus is "E">>
		<<icon "storage-unit.png">><<link [[창고 쪽으로 몰래 간다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "NE">><</link>><<skul_dock_state NE>>
		<br>
	<</if>>
	<<if $bus is "SW" or $bus is "NW">>
		<<skyscrapericon "construction">><<link [[크레인 쪽으로 몰래 간다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "W">><</link>><<skul_dock_state W>>
		<br>
	<</if>>
	<<if $bus is "E">>
		<<icon "cargo-stack.png">><<link [[가장 높이 쌓인 화물 컨테이너 더미 쪽으로 몰래 간다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "M">><</link>><<skul_dock_state M>>
		<br>
	<</if>>
	<<if $bus is "SE" or $bus is "M" or $bus is "NE">>
		<<officeicon>><<link [[사무실 쪽으로 몰래 간다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "E">><</link>><<skul_dock_state E>>
		<br>
	<</if>>
	<<if $bus is "W" or $bus is "S">>
		<<icon "lorry.png">><<link [[트럭 하역 구역 쪽으로 몰래 간다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "SW">><</link>><<skul_dock_state SW>>
		<br>
	<</if>>
	<<if $bus is "SE" or $bus is "SW">>
		<<lockicon "gate">><<link [[정문 쪽으로 몰래 간다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "S">><</link>><<skul_dock_state S>>
		<br>
		<br>
	<</if>>
	<<if $bus is "S" or $bus is "E">>
		<<icon "carpark.png">><<link [[주차장 쪽으로 몰래 간다 (0:05)|Docks Sneak]]>><<handheldon true>><<pass 5>><<set $bus to "SE">><</link>><<skul_dock_state SE>>
		<br>
	<</if>>
	<<if $bus is "S">>
		<<docksicon>><<link [[떠난다|Docks]]>><<handheldon true>><<set $bus to "mer">><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "skul_dock_state">>
	<<if !$settings.blindStatsEnabled>>
		<<if $skul_dock[_args[0]].state is "known">>
			<<if $skul_dock[_args[0]].contents is "none">>
				<span class="purple">이곳의 컨테이너들에는 당신에게 가치 있는 것이 들어있지 않다.</span>
			<<elseif $skul_dock[_args[0]].contents is "fertiliser" and $tending lt 400>>
				<span class="purple">이곳의 컨테이너들에는 당신에게 가치 있는 것이 들어있지 않다.</span>
			<<else>>
				<span class="teal">이곳의 컨테이너에 가치 있는 <<print $skul_dock[_args[0]].contents>>【이가】 들어있다.</span>
			<</if>>
		<<elseif $skul_dock[_args[0]].state is "empty">>
			<span class="lblue">당신은 이곳을 확인했다.</span>
		<<else>>
			<span class="blue">알 수 없는 내용물.</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "events_skul_dock">>
	<<if $dock_security gte random(1, 4)>>
		<<rng 5>>
		<<if $rng is 1>>
			<<generateSecurity 1>><<person1>>
			발소리가 다가오는 것이 들린다. 당신은 컨테이너 뒤로 몸을 숨기고, 발소리가 지나가기를 기다린다. 당신은 숨을 내쉰다.<<gstress>><<stress 6>>
			<br><br>

			<<link [[다음|Docks Sneak]]>><<endevent>><<set $eventskip to 1>><</link>>
			<br>
		<<elseif $rng is 2>>
			<<generateSecurity 1>><<person1>>
			눈앞의 컨테이너에 손전등 불빛이 비친다. 그것을 들고 있는 자가 가까이, 그리고 점점 더 다가오고 있다.
			<br><br>
			당신은 주변을 둘러본다. 컨테이너들이 빽빽하게 쌓여 있다. 왔던 길로 되돌아 뛸 수도 있지만, 꽤 거리가 있고 당신에겐 시간이 많지 않다.
			<br><br>
			<<set $skulduggerydifficulty to 500>>
			<<link [[숨는다|Docks Hide]]>><</link>><<skulduggerydifficulty>>
			<br>
			<<link [[도망친다|Docks Run]]>><<crimeUp 100 "trespassing">><<tiredness 6>><<dock_security 1>><</link>><<crime "trespassing">><<gtiredness>><<gsecurity>>
			<br>
			<<if $physiquesize lte 6000>>
				<<link [[컨테이너 사이를 파고든다|Docks Squeeze]]>><</link>><<small_text>>
				<br>
			<</if>>
		<<elseif $rng is 3>>
			<!-- Modified for Monster People -->
			컨테이너 줄 너머에서 발소리가 들린다.
			<<beastNEWinit 1 dog>>
			<<set $dock_dog to clone($NPCList[0])>>
			당신은 컨테이너 사이로 엿보고, <<beasttype>>【이가】 <<if $monster is 1>>네발로 기며 <</if>>바닥 냄새를 맡고 있는 것을 본다. 당신이 방금 지나갔던 자리다. <<bHe>>【이가】 당신의 냄새를 맡았다.
			<br><br>
			<<if $monster is 1>>
				"이쪽이야!" <<bhe>>【이가】 외치며, 달리기 시작한다.
			<<else>>
				<<bHe>>【은는】 짖으면서 달리기 시작한다.
			<</if>>
			당신은 경비원 제복을 입은 누군가가 뒤따라오는 것을 얼핏 본다.
			<br><br>
			그들이 곧 당신을 찾아낼 것이다.
			<br><br>

			<<distracticon "blue">><<link [[기습한다|Docks Ambush]]>><<dock_security 1>><</link>><<gsecurity>>
			<br>
			<<if $worn.upper.set is $worn.lower.set>>
				<<clothingicon $worn.upper "upper">><<link [[가짜 흔적을 남기기 위해 입고 있는 옷을 버린다|Docks Sacrifice]]>><<set $phase to 0>><<dock_security -1>><</link>><<lsecurity>>
				<br>
			<<else>>
				<<if $worn.upper.name isnot "naked">>
					<<clothingicon $worn.upper "upper">><<link [[가짜 흔적을 남기기 위해 상의를 버린다|Docks Sacrifice]]>><<set $phase to 1>><<dock_security -1>><</link>><<lsecurity>>
					<br>
				<</if>>
				<<if $worn.lower.name isnot "naked">>
					<<clothingicon $worn.lower "lower">><<link [[가짜 흔적을 남기기 위해 하의를 버린다|Docks Sacrifice]]>><<set $phase to 2>><<dock_security -1>><</link>><<lsecurity>>
					<br>
				<</if>>
			<</if>>
			<<if $worn.under_upper.set is $worn.under_lower.set>>
				<<clothingicon $worn.under_upper "under_upper">><<link [[가짜 흔적을 남기기 위해 속옷 세트를 버린다|Docks Sacrifice]]>><<set $phase to 3>><<dock_security -1>><</link>><<lsecurity>>
				<br>
			<<else>>
				<<if $worn.under_upper.name isnot "naked">>
					<<clothingicon $worn.under_upper "under_upper">><<link [[가짜 흔적을 남기기 위해 위 속옷을 버린다|Docks Sacrifice]]>><<set $phase to 4>><<dock_security -1>><</link>><<lsecurity>>
					<br>
				<</if>>
				<<if $worn.under_lower.name isnot "naked">>
					<<clothingicon $worn.under_lower "under_lower">><<link [[가짜 흔적을 남기기 위해 아래 속옷을 버린다|Docks Sacrifice]]>><<set $phase to 5>><<dock_security -1>><</link>><<lsecurity>>
					<br>
				<</if>>
			<</if>>
			<<if $bus is "NW" or $bus is "N" or $bus is "NE">>
				<<swimicon "dive">><<link [[바다로 뛰어든다|Docks Dive]]>><<endevent>><<set $eventskip to 1>><</link>>
				<br>
			<</if>>

		<<elseif $rng is 4>>
			발밑에서 딸깍 소리가 난다. <span class="red">침입자 감지.</span> 목소리가 울려 퍼진다. "저항하지 마십시오." 해치가 확 열리며, 금속 팔들이 튀어나온다.
			<br><br>

			<<link [[피한다|Docks Machine Dodge]]>><</link>><<dancedifficulty 500 1200>>
			<br>
			<<link [[발버둥친다|Docks Machine Struggle]]>><</link>><<physiquedifficulty 12000 20000>>
			<br>
			<<link [[조용히 받아들인다|Docks Machine Brace]]>><</link>>
			<br>
		<<else>>
			<<generateSecurity 1>><<person1>>
			저 앞 모퉁이에서 경비원 제복을 입은 <<person>>【이가】 나타난다. 당신은 두 컨테이너 사이로 몸을 숨긴다. <<he>>【은는】 당신을 보지 못한 것 같다.
			<<if random(1, 2) is 1>>
				하지만 지나쳐 가는 듯하던 <<he>>【이가】 당신이 숨은 곳으로 손을 불쑥 내민다. "잡았다," <<he>>【은는】 당신의 팔을 움켜쥐고 밖으로 끌어내며 말한다.
				<br><br>
				<<He>>【은는】 무전기로 손을 뻗는다. "망할 놈을 잡았다," <<he>>【은는】 당신을 컨테이너에 밀어붙이며 말한다. "수신 양호." <<He>>【은는】 무전기를 내려놓는다. "지원 병력이 곧 도착할 거다. 기다리는 동안 우리끼리 즐거운 시간 좀 가져보는 건 어때?"
				<br><br>

				<<link [[다음|Docks Sneak Rape]]>><<set $molestationstart to 1>><</link>>
				<br>
			<<else>>
				<<He>>【은는】 보지 못한 채 지나간다.<<gstress>><<stress 6>>
				<br><br>

				<<link [[다음|Docks Sneak]]>><<set $eventskip to 1>><<endevent>><</link>>
				<br>
			<</if>>
		<</if>>
	<<else>>
		<<rng 6>>
		<<if $rng is 1>>
			<span class="red">당신은 미끄러진다!</span> 바닥에 기름처럼 미끈거리는 무언가가 덮여 있다.
			<br><br>

			<<link [[팔을 뻗어 막는다|Docks Slip]]>><<pain 8>><<stress 6>><</link>><<ggpain>><<gstress>>
			<br>
			<<link [[넘어지지 않으려 버틴다|Docks Upright]]>><</link>><<dancedifficulty 400 1200>>
			<br>
		<<elseif $rng is 2>>
			<<if !Weather.isOvercast>>
				달빛이 바다에 반사된다. 그 광경이 잠시 당신의 시선을 사로잡는다.<<lstress>><<stress -6>>
				<br><br>
			<<else>>
				서늘한 바람이 머리칼을 헝클어뜨린다.
				<br><br>
			<</if>>
			<<link [[다음|Docks Sneak]]>><<set $eventskip to 1>><</link>>
			<br>
		<<elseif $rng is 3>>
			<<generateSecurity 1>><<generateSecurity 2>>
			앞에서 말소리가 들린다. 두 명의 경비원이 길을 막고 있다.
			<br><br>

			<<set $skulduggerydifficulty to 500>>
			<<link [[다른 길을 찾는다 (0:10)|Docks Find]]>><<pass 10>><<dock_security 1>><</link>><<gsecurity>>
			<br>
			<<link [[몰래 지나간다|Docks Sneak By]]>><</link>><<skulduggerydifficulty>>
			<br>
		<<elseif $rng is 4>>
			당신은 조용히 어둠 속을 이동했지만, 당신의 흔적을 남기고 말았다. 경비가 더욱 삼엄해진다.<<gsecurity>><<dock_security 1>>
			<br><br>

			<<link [[다음|Docks Sneak]]>><<set $eventskip to 1>><</link>>
			<br>
		<<elseif $rng is 5>>
			<<if currentSkillValue('skulduggery') gte random(1, 1000)>>
				앞에 보안 카메라가 있다. 당신은 카메라를 피한다. <span class="green">제때 발견해서 다행이다.</span>
				<br><br>

				<<link [[다음|Docks Sneak]]>><<set $eventskip to 1>><</link>>
				<br>
			<<else>>
				보안 카메라를 <span class="red">너무 늦게</span> 발견했다. 당신은 황급히 숨지만, 조금이라도 주의를 기울인 사람이라면 당신을 보았을 것이다.<<gsecurity>><<dock_security 1>><<crimeUp 10 "trespassing">><<crime "trespassing">>
				<br><br>

				<<link [[다음|Docks Sneak]]>><<set $eventskip to 1>><</link>>
				<br>
			<</if>>
		<<else>>
			이 컨테이너들은 전부 다 똑같이 생겼다. 컨테이너들이 주위에 높게 쌓여 있다. 잠시 동안 당신은 자신이 어디 있는지조차 확신할 수 없게 된다.<<gstress>><<stress 6>>
			<br><br>

			<<link [[다음|Docks Sneak]]>><<set $eventskip to 1>><</link>>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "dock_security">>
	<<if _args[0]>>
		<<set $dock_security += _args[0]>>
	<</if>>
<</widget>>

<<widget "dock_security_text">>
	<<if $dock_security gte 4>>
		<span class="red">경비원들이 최고 경계 상태입니다.</span>
	<<elseif $dock_security gte 3>>
		<span class="pink">경비원들이 침입자를 인지했습니다.</span>
	<<elseif $dock_security gte 2>>
		<span class="purple">경비원들이 의심하고 있습니다.</span>
	<<else>>
		<span class="teal">경비원들이 안심하고 있습니다.</span>
	<</if>>
<</widget>>

<<widget "dockdogfucked">>
	<<famebestiality 1>>
	<<He>>【은는】 당신에게 손전등을 비추며 웃는다. "바라던 것보다 더 듬뿍 받은 모양이군." 당신은 <<if $dock_knot>>다시 <</if>>일어서려 하지만, <<beasttype 1>>【이가】 체중을 실어 당신을 다시 짓누른다.
	<br><br>

	<<person>>【이가】 무전기에 손을 뻗는다. "그래." <<he>>【이가】 말한다. "침입자를 잡았다. 꽤 볼만할 거야. <span class="red">전부 데려와.</span>"
	<br><br>

	<<if $dock_knot isnot "mouth">>
		<<if $submissive gte 1500>>
			<<link [[애원한다|Docks Beg]]>><<sub 1>><<if $dock_knot>><<unset $dock_knot>><</if>><</link>><<submissivetext>>
			<br>
		<</if>>
		<<link [[간청한다|Docks Plead]]>><</link>>
		<br>
	<</if>>
	<<link [[침묵을 지킨다|Docks Silent]]>><</link>>
	<br>
<</widget>>
