	<<set $bus to "elk">>
<<case 4>>
	<<set $bus to "high">>
<<case 5>>
	<<set $bus to "starfish">>
<<case 6>>
	<<set $bus to "barb">>
<<case 7>>
	<<set $bus to "connudatus">>
<<case 8>>
	<<set $bus to "wolf">>
<<case 9>>
	<<set $bus to "harvest">>
<<case 10>>
	<<set $bus to "oxford">>
<<case 11>>
	<<set $bus to "danube">>
<<case 12>>
	<<set $bus to "mer">>
<<case 13>>
	<<set $bus to "cliff">>
<</switch>>
<<destination>>

:: Bus Chikan End
<<effects>>
<<tiredness 3>>
영원처럼 느껴지던 시간이 흐른 후, 마침내 당신이 내릴 정류장이 시야에 들어온다.
<br><br>
<<link [[다음|Bus chikan safe]]>><</link>>

:: Widgets Bus Chikan [widget]
<<widget "chikanmolestactions">>
	<br><br>
	<<link [[저항한다|Bus Chikan Molest Resist]]>><<def 1>><</link>><<defianttext>><<gsuspicion>>
	<br>
	<<link [[무시한다|Bus Chikan Molest Ignore]]>><<stress 1>><<sub 1>><</link>><<submissivetext>><<gstress>><<lsuspicion>>
	<br>
	<<link [[도와달라고 외친다|Bus Chikan Molest Help]]>><</link>><<gggsuspicion>>
<</widget>>

<<widget "chikanattention">>
	<br><br>
	<<if $passengerAttention lte 1>>
		<span class="teal">무슨 일이 일어나고 있는지 아무도 눈치채지 못한 것 같다.</span>
	<<elseif $passengerAttention lte 5>>
		<span class="purple"><<person2>><<person>>【이가】 호기심 어린 눈빛으로 당신을 힐끗거리고 있다.</span>
		/* switch back to molester */<<person1>>
	<<elseif $passengerAttention lte 9>>
		<span class="red">버스 안의 <<people>>【이가】 자기들끼리 수군거리기 시작했다.</span>
	<</if>>
<</widget>>
