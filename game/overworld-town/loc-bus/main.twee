	<</if>>

<<else>>

	요금을 낼 돈이 부족합니다.
	<br><br>

<</if>>

<<destination>>

:: Bus seat

<<set $outside to 0>><<effects>>
<<set $foresthunt to 0>>
<<if Time.schoolDay and Time.hour gte 7 and Time.hour lte 8>>
	버스는 등교하는 학생들로 붐빈다.
<<elseif Time.schoolDay and Time.hour is 15>>
	버스는 하교하는 학생들로 붐빈다.
<</if>>
<<if Weather.precipitation is "rain">>
	창문에 빗방울이 부딪힌다.
<</if>>
<<if playerBellyVisible()>>
	<<generate1>>당신의 배를 본 버스 맨 앞자리의 <<person1>><<person>>【이가】 재빨리 일어나 <<his>> 자리를 양보한다. <<if !$daily.pregnancyBus>><<set $daily.pregnancyBus to true>><<trauma -3>><<ltrauma>><</if>>
	<<endevent>>
<<else>>
	당신은 자리에 앉아 창밖을 내다본다.
<</if>>
<br><br>
<<if $stress gte $stressmax>>
	<<passoutbus>>
<<elseif $tiredness gte (C.tiredness.max / 5) * 4 and $stress gte (($stressmax / 5) * 4) and !isPregnancyEnding()>>
	얼마 지나지 않아, 당신은 눈을 뜨고 있기 힘들어졌다. 지치고 긴장했던 몸이 서서히 이완되고, 머리가 푹 숙여지며 불안한 선잠에 빠져들기 시작한다.
	<br><br>
	<<link [[잠든다|Passout bus]]>><<tiredness -20>><<set $phase to 1>><</link>><<ltiredness>>
	<br>
	<<link [[깨어있으려 애쓴다|Passout bus]]>><<set $phase2 to 1>><</link>><<willpowerdifficulty 1 $willpowermax>>
	<br>
<<elseif playerBellyVisible() and $rng gte 76 and playerAwareTheyArePregnant()>>
	/* event is only possible if the player knows they are pregnant, and their belly is visible */
	옆자리의 <<generate1>><<person1>><<person>>【이가】 당신의 배를 힐끔힐끔 쳐다본다.
	<br><br>
	<<link [[<<him>>【이가】 배를 만지게 한다|Bus Pregnancy Touch]]>><</link>>
	<br>
	<<link [[정류장까지 그냥 기다린다|Bus Pregnancy Wait]]>><</link>>
	<br>
<<else>>
	/* TODO: replace with eventpool */
	<<if dangerEvent()>>
		<<set $dangerbus to random(1, 2)>>
		<<if $wraith.hunt and Time.isBloodMoon() and $dangerbus is 1>>
			당신은 붉은 달빛에 흠뻑 젖은 창밖 풍경을 바라본다. 유난히 창백한 사람이 멈춰 서서 창문을 통해 당신을 쳐다보는 것을 발견한다.
			<br><br>
			1분도 채 지나지 않아, 길 반대편에서 그것을 다시 본다. 그리고 다음 정류장에서 또. 당신이 눈을 깜빡이자, 그것은 사라졌다.
			<br><br>
			당신은 어깨너머로 돌아본다. 그것이 버스 뒷자리에 앉아 있다.
			<br><br>
			버스가 목적지에 도착하자, 당신은 자리에서 허둥지둥 일어난다. <<stress 12>><<ggstress>>
			<<set $wraith.hunt++>>
			<<destination5>>
		<<elseif $dangerbus is 1>>
			<<generate1>>한 <<person1>><<person>>【이가】 당신 옆에 앉아 다리 위에 손을 올린다.
			<br><br>
			<<if $rng gte 71 - ($allure/100)>>
				<<link [[움직인다|Bus move]]>><<set $molestationstart to 1>><</link>><<gharass>>
				<br>
			<<else>>
				<<link [[자리를 옮긴다|Bus move Safe]]>><</link>><<gharass>>
				<br>
			<</if>>
			<<if $rng gte 91 - ($allure/100)>>
				<<link [[움직이지 않는다|Bus Chikan Start]]>><</link>><<gtrauma>><<gstress>>
				<br><br>
			<<else>>
				<<link [[움직이지 않는다|Bus endure safe]]>><<trauma 6>><<stress 6>><</link>><<gtrauma>><<gstress>>
				<br><br>
			<</if>>
		<<elseif $dangerbus is 2>>
			<<if Time.hour gte 7 and Time.hour lte 8 and Time.schoolDay>>
				<<outfitChecks>>
				몇몇 불량배들이 인기가 없는 학생들을 괴롭히고 있다.
				<br><br>
				<<if $cool lt 80>>
					<<generatey1>><<generatey2>><<generatey3>><<person1>>그들 중 한 명인 <<person>>【이가】 당신 옆에 앉는다. <<his>> 친구 두 명, <<person2>><<person>>【와과】 <<person3>><<person>>【은는】 당신 앞에 앉아 좌석 등받이에 기댄다.
					<br><br>
					"우리 버스를 써도 된다고 한 적 없는데." <<person1>><<person>>【이가】 말한다.
					<br>
					"<<pShe>>【은는】 아마 너무 멍청해서 잘 모를 거야." <<person2>><<person>>【이가】 끼어든다.
					<br>
					<<if $player.gender_appearance is "m" and _topless>>
						"그럴지도. <<pShe>>【은는】 심지어 <<pher>> 셔츠도 잊어버렸잖아."
						<br>
						"아니면 <<pshe>>【은는】 옷 입는 걸 아예 싫어하는지도 모르지. 우리가 옷 벗는 걸 도와주면 좋아할지도."
						<br><br>
						<<if $speech_attitude is "bratty">>
							"꺼져." 당신은 괴롭힘당하지 않으리라 다짐하며 말한다.
						<<elseif $speech_attitude is "meek">>
							당신은 무릎을 내려다보며 고개를 젓는다.
						<<else>>
							"저리 가," 당신이 말한다.
						<</if>>
						<br><br>
						"사양 말고." <<person1>><<person>>【이가】 당신의 _bottom.name【을를】 잡으며 말한다.
						<br><br>
						<<link [[다음|Bus School Strip]]>><<set $molestationstart to 1>><</link>>
						<br>
					<<else>>
						<<person3>><<person>>【이가】 당신을 보며 씩 웃는다. "알겠어." <<he>>【이가】 말한다. "네 _top.name【을를】 <<pullup>>하는 건 어때? 살 좀 보자고."
						<br><br>
						<<link [[응한다|Bus Comply]]>><<trauma 6>><<stress 6>><<sub 1>><</link>><<gtrauma>><<gstress>>
						<br>
						<<link [[거절한다|Bus Refuse]]>><<def 1>><</link>>
						<br>
					<</if>>
				<<else>>
					버스가 목적지에 도착한다.
					<<destination5>>
				<</if>>
			<<elseif Time.hour is 15 and Time.schoolDay>>
				<<outfitChecks>>
				몇몇 불량배들이 인기가 없는 학생들을 괴롭히고 있다.
				<br><br>
				<<if $cool lt 80>>
					<<generatey1>><<generatey2>><<generatey3>><<person1>>그들 중 한 명인 <<person>>【이가】 당신 옆에 앉는다. <<his>> 친구 두 명, <<person2>><<person>>【와과】 <<person3>><<person>>【은는】 당신 앞에 앉아 좌석 등받이에 기댄다.
					<br><br>
					"우리 버스를 써도 된다고 한 적 없는데." <<person1>><<person>>【이가】 말한다.
					<br>
					"<<pShe>>【은는】 아마 너무 멍청해서 잘 모를 거야." <<person2>><<person>>【이가】 끼어든다.
					<br>
					<<if $player.gender_appearance is "m" and _topless>>
						"그럴지도. <<pShe>>【은는】 심지어 <<pher>> 셔츠도 잊어버렸잖아."
						<br>
						"아니면 <<pshe>>【은는】 옷 입는 걸 아예 싫어하는지도 모르지. 우리가 옷 벗는 걸 도와주면 좋아할지도."
						<br><br>

						<<if $speech_attitude is "bratty">>
							"꺼져," 기죽지 않겠다는 마음으로 당신이 쏘아붙인다.
						<<elseif $speech_attitude is "meek">>
							당신은 무릎을 내려다보며 고개를 젓는다.
						<<else>>
							"저리 가," 당신이 말한다.
						<</if>>
						<br><br>
						"사양 말고." <<person1>><<person>>【이가】 당신의 _bottom.name【을를】 잡으며 말한다.
						<br><br>
						<<link [[다음|Bus School Strip]]>><<set $molestationstart to 1>><</link>>
						<br>
					<<else>>
						<<person3>><<person>>【이가】 당신을 보며 씩 웃는다. "알겠어." <<he>>【이가】 말한다. "네 _top.name【을를】 <<pullup>>하는 건 어때? 살 좀 보자고."
						<br><br>
						<<link [[응한다|Bus Comply]]>><<trauma 6>><<stress 6>><<sub 1>><</link>><<gtrauma>><<gstress>>
						<br>
						<<link [[거절한다|Bus Refuse]]>><<def 1>><</link>>
						<br>
					<</if>>
				<<else>>
					버스가 목적지에 도착한다.
					<<destination5>>
				<</if>>
			<<else>>
				<<if $rng gte 81>>
					당신이 버스 뒷자리에 앉아 있을 때, 버스가 갑자기 멈춰 선다.
					<br><br>
					버스 기사가 욕을 하며 앞문으로 나간다. 엔진이 고장 난 것 같다. 버스가 다시 출발하기를 기다리는 동안, 주위 사람들이 술렁이기 시작한다.
					<br><br>

					<<link [[기다린다 (0:15)|Bus Engine Breakdown]]>><<pass 15>><</link>>
					<br>
					<<link [[떠난다|Bus Engine Breakdown End]]>><<set $phase to 1>><</link>>
					<br>
				<<else>>
					<<generate1>><<generate2>>버스 안의 <<people>>【이가】 당신 주위로 몰려드는 것 같다. 몇몇은 더 가까이 오려고 자리를 옮기기까지 한다.
					<br><br>
					<<if Time.dayState is "night" and !isPregnancyEnding()>>
						버스가 목적지에 가까워지지만 속도를 줄이지 않는다. 당신이 기사에게 말하려고 일어서자, <<person1>><<person>>【이가】 길을 막는다. "벌써 가려고?" <<person2>><<person>>【이가】 뒤에서 당신을 붙잡는다. "밤에 돌아다니면 안 된다는 걸 알아야지."
						<br><br>
						<<link [[다음|Bus Seat Rape]]>><<set $molestationstart to 1>><</link>>
						<br>
					<<else>>
						버스가 목적지에 도착한다. 당신이 통로를 걸어 내려가자 <<person1>><<person>>【이가】 당신의 팔을 잡는다. "아직 가지 마, 같이 있어 줘." 당신이 뿌리치자 <<he>>【이가】 말한다. <<catcall>> 당신이 버스에서 내리자 그들이 웃는다.
						<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
						<<endevent>>
						<<destination5>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<<else>>
		버스가 목적지에 도착한다.
		<<destination5>>
	<</if>>
<</if>>

:: Stripped Bus
<<if $phase is 1>><<unset $phase>><</if>>
<<effects>>
<<upperruined>><<lowerruined>><<underupperruined>><<underlowerruined>>

잠에서 깨자 이상한 한기가 느껴진다. 당신은 아직 버스 안에 있다. 자리에서 일어나려던 순간, 당신은 자신이 완전히 알몸이라는 것을 깨닫는다! 미친 듯이 옷을 찾아보지만, 아무것도 찾을 수 없다.<<controlloss>>
<br><br>
당신은 조심스럽게 버스 안을 둘러본다. 아무도 당신의 곤경을 눈치채지 못한 것 같다.
<br><br>
<<if Time.dayState is "night">>
	밖은 어둡고 거리에는 사람이 거의 없다. 다음 정류장에서 창문으로 빠져나갈 수 있을지도 모른다. 아니면 좌석 밑에 숨어 버스가 정류장으로 돌아갈 때까지 기다릴 수도 있다.
	<br><br>
	<<link [[창문으로 나간다 (0:05)|Climb Out Bus]]>><<pass 5>><</link>>
	<br>
	<<link [[기다린다 (0:30)|Bus Station]]>><<pass 30>><</link>>
	<br><br>
<<else>>
	창밖을 엿보니 수많은 보행자가 보인다. 좌석 밑에 숨어 버스가 정류장으로 돌아올 때까지 기다리는 것 외에는 다른 방법이 생각나지 않는다.
	<br><br>
	<<link [[기다린다 (0:45)|Bus Station]]>><<pass 45>><</link>>
	<br><br>
<</if>>

:: Molestation bus
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<generate1>><<molestbusinit>>무언가 당신의 아랫도리를 탐색하는 것이 느껴진다. 눈을 뜨자, 어떤 손이 당신의 입을 틀어막아 비명을 삼키게 한다.
	<br>
<</if>>
<<effects>>
<<effectsman>>
<<alarmstate "<span class='red'>아무도 당신을 도우러 오지 않는다. 버스 안에는 다른 사람이 없다.</span>" 1>>
<<man>>
<<stateman>>
<br><br>
<<actionsman>>
<<if $alarm is 1>>
	<<if $rescue is 1>>
		<span id="next"><<link [[다음|Molestation bus Alarm]]>><</link>></span><<nexttext>>
	<<else>>
		<<set $alarm to 0>>
		<br><br>
		<<if $enemyarousal gte $enemyarousalmax>>
			<span id="next"><<link [[다음|Molestation bus Ejaculation]]>><</link>></span><<nexttext>>
		<<elseif $enemyhealth lte 0>>
			<span id="next"><<link [[다음|Molestation bus Escape]]>><</link>></span><<nexttext>>
		<<else>>
			<span id="next"><<link [[다음|Molestation bus]]>><</link>></span><<nexttext>>
		<</if>>
	<</if>>
<<elseif $enemyarousal gte $enemyarousalmax>>
	<span id="next"><<link [[다음|Molestation bus Ejaculation]]>><</link>></span><<nexttext>>
<<elseif $enemyhealth lte 0>>
	<span id="next"><<link [[다음|Molestation bus Escape]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Molestation bus]]>><</link>></span><<nexttext>>
<</if>>

:: Stranger rescue bus
<<wearProp "chocolate">>
<<generate1>><<person1>>
<<effects>><<pass 1 hour>><<set $hunger -= 500>><<set $thirst -= 500>><<set $stress -= 500>>
누군가 당신의 어깨를 흔드는 것이 느껴진다. 주위를 둘러보니 한 늙은 <<personsimple>>【이가】 당신을 보며 미소 짓고 있다.
<br><br>
<<He>>【은는】 보온병에서 차 한 잔을 따라주고 초콜릿 바를 건네며, 혈당 수치가 너무 낮아지지 않도록 하는 것이 중요하다고 알려준다. <<if $phase is 1>><<He>>【은는】 또한 너무 무리하지 말라고 부드럽게 상기시켜준다.<</if>> 당신은 <<him>>에게 감사 인사를 하고 <<if $phase is 1>>다음 정류장에서 버스를 내린다<<else>>얼마 지나지 않아 버스가 목적지에 도착한다<</if>>.
<br><br>
버스가 계속 나아가자 늙은 <<personsimple>>【은는】 창문에서 손을 흔든다.
<br><br>
<<endevent>>
<<if $phase is 1>>
	<<unset $phase>><<destinationbusrandom>>
<<else>>
	<<destination>>
<</if>>
<<displayLinks>>

:: Bus move
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<maninit>>당신이 <<he>>【을를】 지나치려 하자, <<he>>【은는】 당신의 허리를 잡아 <<his>> 무릎 위에 억지로 앉힌다.
	<br>
	<<enable_rescue>>
<</if>>
<<effects>>
<<effectsman>>
<<alarmstate>>
<<man>>
