:: Brothel Dressing Room
<<effects>><<set $outside to 0>><<set $location to "brothel">>

<<if $brotheljob>>
	<<timeTrackingEndBrothel>>
<</if>>

당신은 창관의 분장실에 있다. 거울이 몇 개 있지만, 현재는 직원들이 머리를 손질하고 화장을 고치는 데 사용하고 있다.
<br><br>

<<if $unbind is 1>>
	<<unset $unbind>>
	<<if $possessed>>
		당신은 결박을 내려다본다. 잡아당기자, 당신의 힘을 견디지 못하고 결박이 풀어진다.
		<br><br>
	<<else>>
		<span class="green">당신은 테이블 모서리에 결박을 문지른다.</span> 약간의 노력이 필요했지만, 결국 재질이 늘어나면서 팔다리가 자유로워진다.
		<br><br>
	<</if>>
	<<unbind>>
<</if>>

<<if breakableSoftBinding()>>
	<<undobindingsicon>><<link [[결박 풀기 (0:10)|Brothel Dressing Room]]>><<set $unbind to 1>><<pass 10>><</link>>
	<br><br>
<</if>>

<<if $brothelVending>>
	<<if $brothelVending.status is "asked" or ($brothelVending.status is "sold" and $brothelVending.weeksEmpty lt 4)>>
		<<condomicon "machine">><span class="gold">쇼핑 센터에서 자판기를 구매하여 여기에 설치할 수 있습니다.</span>
		<br><br>
	<<elseif $brothelVending.status is "sold" and $brothelVending.weeksEmpty gte 4>>
		<<condomicon "machine">><span class="gold">당신의 자판기가 팔렸습니다. 브라이어에게 이야기해야 합니다.</span>
		<br><br>
	<<elseif $brothelVending.status is "bought">>
		<<condomicon "machine">> <<link [[자판기 설치하기 (0:30)|Brothel Dressing Room]]>><<set $brothelVending.status to "set">><<set $weekly.brothelVMCollect to true>><<pass 30>><</link>>
		<br><br>
	<<elseif $brothelVending.status is "set">>
		<<if $brothelVending.products>>
			<<set _outOfStock to []>>
			<<set _full to []>>
			<<set _buyMore to []>>
			<<set _productsAvailable to []>>
			<<set _productsToPurchase to []>>
			<<if $brothelVending.condoms lt 200 and $settings.condomLevel gte 1>>
				<<run _buyMore.push(`<span class="gold">약국</span>에서 콘돔`)>>
			<</if>>
			<<if $brothelVending.lube lt 200>><<run _buyMore.push(`<span class="gold">성인용품점</span>에서 윤활제`)>><</if>>

			<<if $brothelVending.condoms is 0>>
				<<run _outOfStock.push(`콘돔 자판기`)>>
			<<elseif $brothelVending.condoms gte 200>>
				<<run _full.push(`콘돔 자판기`)>>
			<<else>>
				<<run _productsAvailable.push(`콘돔 <span class="gold">$brothelVending.condoms</span>팩`)>>
				<<run _productsToPurchase.push(`콘돔 <span class="blue">$brothelVending.condomsToRefill</span>팩`)>>
			<</if>>
			<<if $brothelVending.lube is 0>>
				<<run _outOfStock.push(`윤활제 자판기`)>>
			<<elseif $brothelVending.lube gte 200>>
				<<run _full.push(`윤활제 자판기`)>>
			<<else>>
				<<run _productsAvailable.push(`윤활제 <span class="gold">$brothelVending.lube</span>병`)>>
				<<run _productsToPurchase.push(`윤활제 <span class="blue">$brothelVending.lubeToRefill</span>병`)>>
			<</if>>

			<<condomicon "machine">> 당신은 자판기의 재고를 확인한다.
			<<if _full.length gte 1>>
				<<print _full.join(" 및 ")>>【은는】 <<print _full.length gte 2 ? " " : " ">><span class="green">가득 찼다</span>.
			<</if>>
			<<if _outOfStock.length gte 1>>
				<<print _outOfStock.join(" 및 ")>>【은는】 <<print _outOfStock.length gte 2 ? " " : " ">><span class="red">비어 있다</span>. <<if _outOfStock.includes("콘돔 자판기") and $settings.condomLevel lt 1>><mouse class="tooltip linkBlue">(?)<span>현재 설정으로는 콘돔을 구매할 수 없습니다. 당신이나 다른 사람이 콘돔을 사용할 수 있도록 임신 설정을 변경하세요.</span></mouse><</if>>
			<</if>>
			<<if _productsAvailable.length gte 1>>
				자판기 안에는 <<print _productsAvailable.join(" 및 ")>>【이가】 있다. <<print _productsToPurchase.join(" 및 ")>>【을를】 더 넣을 공간이 있다.
			<</if>>
			<<if _buyMore.length gte 1>>
				<<print _buyMore.join(" 및 ")>>【을를】 구매할 수 있다.
			<</if>>
			이번 주 수익은 <<print $weekly.brothelVMCollect ? "이미 수금했다" : "아직 수금하지 않았다">>.
			<br>
			<<if $brothelVending.products % 2 and $brothelVending.condoms gte 1>>
				<<condomicon>><<link [[콘돔 구매하기 (£80)|Brothel Vending Machine Buy]]>><<set $phase to 1>><</link>>
				<br>
			<</if>>
			<<if $brothelVending.products gte 2 and $brothelVending.lube gte 1>>
				<<sextoysicon "lube">><<link [[윤활제 구매하기 (£30)|Brothel Vending Machine Buy]]>><<set $phase to 2>><</link>>
				<br>
			<</if>>
			<br>
		<<else>>
			자판기가 설치되어 있다.
			<<if $brothelVending and $brothelVending.status is "set" and $settings.condomLevel gte 1 and !($brothelVending.products % 2)>>
				콘돔 대량 구매에 대해 <span class="gold">약국</span>에 이야기해야 한다.
			<</if>>
			<<if $brothelVending.products lt 2>>
				<<= $adultshopunlocked is undefined ? "성인용품점이 열리면, " : "">><span class="gold">시리스</span>【이가】 윤활제를 할인된 가격에 팔 수도 있다.
			<</if>>
			<br><br>
		<</if>>
	<</if>>
<</if>>

