						<<exhibitionist5>>
				<</switch>>
			<</if>>
		<</if>>
		<br>
	<<else>>
		<<fenceicon>><<link [[울타리 넘기 (0:01)|Garden Fence]]>><<pass 1>><</link>>
		<br>
	<</if>>

	<<main_hall_icon>><<link [[중앙 홀 (0:01)|Orphanage]]>><<pass 1>><</link>>
	<br>

<</if>>

