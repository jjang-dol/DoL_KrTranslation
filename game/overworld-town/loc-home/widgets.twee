:: Widgets Home [widget]
<<widget "home_outside">>
	<<if $exposed gte 1>>
		<<set _ex to ($exposed >= 2 ? (Time.dayState == "night" ? 4 : 5) : (Time.dayState == "night" ? 2 : 3))>>
		<<if hasSexStat("exhibitionism", _ex)>>
			<<if Time.dayState is "night">>
				<<dooricon "orphanage">><<link [[몰래 밖으로 나간다 (0:02)|Home Leave]]>><<pass 2>><</link>>
			<<else>>
				<<dooricon "orphanage">><<link [[몰래 밖으로 나간다 (0:05)|Home Leave]]>><<pass 5>><</link>>
			<</if>>
			<<if $daily.ex.fence isnot 1>>
				<<switch _ex>>
					<<case 2>>
						<<exhibitionist2>>
					<<case 3>>
						<<exhibitionist3>>
					<<case 4>>
						<<exhibitionist4>>
					<<case 5>>
						<<exhibitionist5>>
				<</switch>>
			<</if>>
		<</if>>
		<br>
	<<else>>
		<<if Time.hour gte 18 and Time.hour lte 20 and C.npc.Robin.trauma gte 40 and $robinmissing is 0 and !$robinTraumaVisit>>
			<<dooricon "orphanage">><<link [[고아원을 떠난다 (0:01)|Robin Trauma Visit]]>><<set $phase to 2>><<pass 1>><</link>>
		<<elseif $robinpaid gte 1 and Time.isWeekEnd() and $weekly.robinGift isnot 1 and Time.hour gte 7 and Time.hour lt 9 and C.npc.Robin.trauma lt 80 and random(1, 10) lte 3 and $robin.timer.hurt lt 1 and $robinmissing is 0>>
			<<dooricon "orphanage">><<link [[고아원을 떠난다 (0:01)|Robin Weekend Gift]]>><<pass 1>><<set $weekly.robinGift to 1>><</link>>
		<<else>>
			<<dooricon "orphanage">><<link [[고아원을 떠난다 (0:01)|Domus Street]]>><<pass 1>><</link>>
		<</if>>
	<</if>>
<</widget>>

<<widget "home_effects">>
	<<if $hoursGoneFromHome lte 167>>
		<<set $hoursGoneFromHome to 0>>
	<</if>>
<</widget>>

<<widget "slimeWakeBodyliquid">>
	<<set _liquid to _args[0]>>
	<<if $player.penisExist and $player.virginity.penile isnot true and !playerChastity("penis")>>
		<<bodyliquid "penis" _liquid random(1,3)>>
	<</if>>
	<<if $player.vaginaExist and $player.virginity.vaginal isnot true and !playerChastity("hidden")>>
		<<bodyliquid "vagina" _liquid random(1,3)>>
	<</if>>
	<<if $player.virginity.anal isnot true and !playerChastity("anus") and $settings.analEnabled>>
		<<bodyliquid "anus" _liquid random(1,3)>>
	<</if>>
	<<if $player.virginity.oral isnot true>>
		<<bodyliquid "mouth" _liquid random(1,3)>>
	<</if>>
	<<bodyliquid "hair" _liquid random(1,3)>>
	<<bodyliquid "face" _liquid random(1,3)>>
	<<bodyliquid "neck" _liquid random(1,3)>>
	<<bodyliquid "chest" _liquid random(1,3)>>
	<<bodyliquid "leftarm" _liquid random(1,3)>>
	<<bodyliquid "rightarm" _liquid random(1,3)>>
	<<bodyliquid "thigh" _liquid random(1,3)>>
	<<bodyliquid "feet" _liquid random(1,3)>>
<</widget>>

<<widget "slimeWakeAlleyway">>
	<<set $earSlime.eventTimer to 3>>
	<<silently>><<clotheson>><</silently>>
	<<storeon "bed" "return">>
	<<storeon "Temple Bunk Bed" "return">>
	/* effects and sleepeffects requires due to ending sleep and changing location */
	<<effects>>
	<<sleepeffects>>

	당신은 당황스럽고 혼란스러운 상태로 깨어난다. 마지막으로 기억하는 건 <<if $robinbed is "theirs">>로빈과 함께<<else>>평소처럼<</if>> 잠자리에 든 것이다. 하지만 당신은 분명히 더 이상 그곳에 있지 않다. 귀 슬라임이 어떤 방식으로든 관련되어 있을 것이라는 느낌이 든다.
	<br><br>
	<<if $tutorial or $debug>>
		<<set _newLocation to ["Residential Alleyways", "Commercial Alleyways", "Park", "Industrial Alleyways"].random()>>
		<<set $eventskip to 1>>

		<<if random(0,100) gt 80 and (maleChance() lt 100 or $settings.maleNPCVaginaChance gt 0) and $earSlime.deviancy gte 3>>
			<<set _coveredIn to "slime">>
			<<slimeWakeBodyliquid "goo">>
		<</if>>
		<<if random(0,100) gt 80 and (maleChance() gt 0 or $settings.femaleNPCPenisChance gt 0) and $earSlime.promiscuity gte 3>>
			<<set _coveredIn to (_coveredIn is "slime" ? "슬라임과 정액" : "정액")>>
			<<slimeWakeBodyliquid "semen">>
		<</if>>
		<<if _coveredIn isnot undefined>>
			이 난처한 상황에 더해, 당신은 당신의 몸이 <<print _coveredIn>>【으로로】 뒤덮인 것을 발견한다. 이것이 슬라임의 짓이라면, 그것은 당신이 잠든 동안 당신의 몸을 가지고 분명히 재미를 본 것이다.
			<br><br>
		<</if>>
		주변을 둘러보니, 당신은 왠지 <<print _newLocation.toLocaleLowerCase()>>【으로로】 옮겨진 것 같다고 생각한다.
		<br><br>
		<<link [[다음|_newLocation]]>><</link>>
	<<else>>
		<<set $tutorial to 1>>
		<<generate1>><<person1>>아무런 경고 없이, 지나가던 <<person>>【이가】 당신과 부딪힌다. <<He>>【은는】 비틀거리며 물러나고 분노 어린 눈빛으로 당신을 쳐다보지만, 당신의 모습을 보고 분노는 정욕으로 바뀐다. "내가 이번 주에 본 것 중에서 네가 제일 귀여운데! 이리 와봐."
		<br><br>
		<<link [[다음|Tutorial]]>><<set $molestationstart to 1>><<set $tutorialExit to "Residential Alleyways">><</link>>
	<</if>>
	<<exitAll>>
<</widget>>

<<widget "slimeWakeMasturbation">>
	/* To correct for lost hour */
	<<set $sleephour++>>
	<<set _slimeWakeMasturbation to 0>>
	<<set $weekly.slimeWakeMasturbation to true>>
	<<set _rng to random(0, 100)>>
	<<set _options to 1>>
	<<if $player.penisExist and ($worn.genitals.name is "chastity parasite" or !playerChastity("penis"))>><<set _options++>><</if>>
	<<if $player.vaginaExist and !playerChastity("vagina")>><<set _options++>><</if>>
	<<if $settings.analEnabled and !playerChastity("anus")>><<set _options++>><</if>>

	<<arousal 10000>>
	<<drugs 200>>
	<<silently>><<orgasm>><</silently>>
	당신은 극도로 흥분되고 혼란스러운 상태로 깨어난다. 당신은 일어날 수 없어 자신을 내려다보는데,
	<<if $player.penisExist and ($worn.genitals.name is "chastity parasite" or !playerChastity("penis"))>>
		<<if $worn.genitals.name is "chastity parasite">>
			다리 사이의 기생충을 공격적으로 꽉 쥐는 것을 멈출 수 없다는 것을 발견한다. 몸을 타고 흐르는 쾌락의 파도는 당신을 절정에 도달<<if _deniedOrgasm>>하기 직전까지<<else>>하게<</if>> 만들고, 그 직후 바로 두 번째<<if _deniedOrgasm>>로 실패한<</if>> 오르가즘을 맞이하게 한다.
			<br><br>
			<<orgasm>>
			<<orgasm>>
			<<set _multiple to true>>
		<<else>>
			자지를 공격적으로 문지르는 것을 멈출 수 없다는 것을 발견한다. 그 쾌락은 곧 당신을 절정에 도달<<if _deniedOrgasm>>하기 직전까지<<else>>하게<</if>> 만든다.
			<br><br>
			<<orgasm>>
		<</if>>
	<<elseif $player.vaginaExist and !playerChastity("vagina") and _rng gte 100 / Math.max(_options - 1, 1)>>
		보지를 공격적으로 애무하는 것을 멈출 수 없다는 것을 발견한다. 그 쾌락은 곧 당신을 절정에 도달<<if _deniedOrgasm>>하기 직전까지<<else>>하게<</if>> 만든다.
		<br><br>
		<<orgasm>>
	<<elseif $settings.analEnabled and !playerChastity("anus") and _rng gte 100 / Math.max(_options - 2, 1)>>
		애널을 공격적으로 애무하는 것을 멈출 수 없다는 것을 발견한다. 그 쾌락은 곧 당신을 절정에 도달<<if _deniedOrgasm>>하기 직전까지<<else>>하게<</if>> 만든다.
		<br><br>
		<<orgasm>>
	<<else>>
		유두를 공격적으로 꼬집는 것을 멈출 수 없다는 것을 발견한다. 그 쾌락은 곧 당신을 절정에 도달<<if _deniedOrgasm>>하기 직전까지<<else>>하게<</if>> 만든다.
		<br><br>
		<<orgasm>>
	<</if>>
	마지막<<if _deniedOrgasm>>【으로로】 실패한<</if>> 오르가즘이 가라앉은 후, 당신은 다시 자신의 몸을 통제하게 된다. 당신은 서서히 안정을 되찾고 다시 잠들려고 노력한다.
	<br><br>
	<<link [[다음|$passage]]>><</link>>

	<<exitAll>>
<</widget>>

<<widget "orphanageWard">>
	<<if $debug is 1 or $ward_unlocked>>
		<br>
		<<if inappropriatePlayerState("clothes")>>
			<<childicon "blocks">><span class="pink">복장이 너무 외설스러워서 유아동에 들어갈 수 없습니다.</span>
		<<elseif inappropriatePlayerState("fluids")>>
			<<childicon "blocks">><span class="pink">유아동에 들어가기 전에 몸을 씻어야 합니다.</span>
		<<elseif inappropriatePlayerState("drugs")>>
			<<childicon "blocks">><span class="pink">너무 취해서 유아동에 들어갈 수 없습니다.</span>
		<<else>>
			<<if !$orphanageWardIntro>>
				<<childicon "blocks">><<link [[유아동 (0:01)|Orphanage Ward Intro]]>><<pass 1>><</link>>
			<<elseif !$daily.wardHalloween and $halloween is 1 and Time.hour gte 6 and Time.hour lte 21 and $rng gte 51>>
				<<childicon "blocks">><<link [[유아동 (0:01)|Orphanage Ward Halloween Enter]]>><<pass 1>><</link>>
			<<else>>
				<<childicon "blocks">><<link [[유아동 (0:01)|Orphanage Ward]]>><<pass 1>><</link>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "orphanageWardOptions">>
	<<getChildrenIds `{location: "home", donor: "Ivory Wraith"}`>>
	<<rngWraith 1 "night">>
	<<if _childrenIds.length gte 1 and _wraithEvent and !$possessed and !$daily.wraithNursery>>
		<<childicon "crib">><<link [[유아동|Orphanage Ward Wraith Sing]]>><<set $exitPassage to $passage>><</link>>
		<br>
	<<else>>
		<<childicon "crib">><<link [[유아동|Childrens Home]]>><<set $exitPassage to $passage>><</link>>
		<br>
	<</if>>
	<<if $hallucinations gte 2 and $rng is 100>>
		<<main_hall_icon>><<link [[중앙 홀|Orphanage Ward Door]]>><</link>>
		<br>
	<<else>>
		<<main_hall_icon>><<link [[중앙 홀|Orphanage]]>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "bathroomLink">>
	<<if getRobinLocation() is "bath" and $halloween isnot 1>>
		<<if $robinBathKnown>>
			로빈이 목욕 중이다.
			<br>
		<</if>>
		<<bathroomicon>><<link [[욕실 (0:01)|Robin Bath]]>><<pass 1>><</link>>
	<<else>>
		<<if $robinBathKnown>>
			<<unset $robinBathKnown>>
		<</if>>
		<<bathroomicon>><<link [[욕실 (0:01)|Bathroom]]>><<pass 1>><</link>>
	<</if>>
<</widget>>

<<widget "generateSleepLinks">>
	<<set _sleep_passage to _args[0]>>
	<<set _maxHours to ($sleeptrouble is 1 and $controlled is 0 and !$hypnosis_traits.slumber) ? 10 : 8>>
	<<for _i = _maxHours; _i > 0; _i-->>
		<<if _i is 1>>
			<<link [[1시간 잔다|_sleep_passage]]>><<set $sleephour to 1>><</link>> &#8194;(<<timeAfterXHours 1>>)<<if $tiredness > 0>><<ltiredness>><</if>>
		<<else>>
			<<capture _i>>
				<<link [[_i + " 시간 잔다"|_sleep_passage]]>><<set $sleephour to _i>><</link>> (<<timeAfterXHours _i>>)<<if $tiredness > 0>><<ltiredness>><</if>>
			<</capture>>
		<</if>>
		<br>
	<</for>>
	<<if $tiredness > 0>>
		<<link [[그냥 잔다|_sleep_passage]]>><<set $sleephour to -1>><</link>> (??:??)<<ltiredness>>
		<br>
	<</if>>
	<br>
<</widget>>

<<widget "loft_window_options">>
<<if !_no_options>>
   <<if $loft_gh is 2 and $money gte 100000 and Time.dayState isnot "night">>
       <<highicon>><<link [[장식품 구매 (0:20)|Bird Loft Decor 1]]>><<money -100000 "BayWindowDecor">><<pass 20>><<endevent>><</link>>
       <br>
   <</if>>
   <<if $daily.no_sing>>
       <span class="blue">목소리가 나오지 않는다.</span>
       <br>
   <<else>>
       <<birdicon "sing">><<link [[노래한다 (0:30)|Orphanage Loft Bay Window Sing]]>><<pass 30>><<endevent>><</link>>
       <br>
   <</if>>
   <<if $harpy gte 6 and $transformationParts.bird.wings isnot "hidden">>
       <<birdicon "preen_self">><<link [[날개를 다듬는다 (0:30)|Orphanage Loft Bay Window Preen]]>><<pass 30>><<stress -2>><<endevent>><</link>><<lstress>>
       <br>
   <</if>>
   <<foresticon>><<link [[숲을 바라본다 (1:00)|Orphanage Loft Bay Window Watch]]>><<pass 60>><<endevent>><</link>>
   <br>
<</if>>
<<getouticon>><<link [[떠난다|Orphanage Loft]]>><<endevent>><</link>>
<br>
<</widget>>
