:: Bedroom
<<bedclotheson "bed">>
<<set $outside to 0>><<set $location to "home">><<home_effects>><<effects>><<getTarget true>>
당신은 고아원의 침실에 있다.

/* Wallpaper */
<<set _furniture to $furniture.bedroom>>
<<if _furniture.wallpaper>>
	<br>
	<<set _premadeWall to ["vines", "tentacles", "plain-white", "wavy-white", "cowgirls", "cow-girls", "hearts", "trees", "crosses", "starry", "deep sea", "beach", "crabs", "flames", "stained glass", "audience", "bears"].includes(_furniture.wallpaper.name)>>
	<<if _premadeWall>>
		<<set _wallpaper to "wallpaper-" + _furniture.wallpaper.name.replace(/ /g,"-")>>
	<<elseif ['dol', 'degrees of lewdity'].some(e => _furniture.wallpaper.name.toLowerCase().includes(e))>>
		<<set _wallpaper to "wallpaper-dol">>
	<<else>>
		<<set _wallpaper to "wallpaper-custom">>
	<</if>>

	<<furnitureicon _wallpaper>>
	<<switch _furniture.wallpaper.name>>
		<<case "vines">>
			음란한 녹색 덩굴이 벽에서 꿈틀거린다.
			<<if $backgroundTraits.includes("plantlover")>>
				달콤한 넥타르에 대한 생각이 당신의 마음을 괴롭힌다.
			<</if>>
		<<case "tentacles">>
			보라색 촉수가 벽을 따라 미끄러지듯 움직인다.
			<<if $demon gte 6>>
				쾌락에 대한 생각이 마음을 스쳐 지나간다.
			<</if>>
		<<case "plain-white">>
			평범한 흰색 벽지가 벽을 덮고 있다.
		<<case "wavy-white">>
			흰색 벽지가 물결무늬로 검은색으로 변한다. 음란한 속뜻이라도 있는 걸까?
		<<case "hearts">>
			분홍색 하트가 벽을 뒤덮고 있다.
		<<case "cowgirls" "cow-girls">>
			카우걸들이 벽 위에서 춤을 춘다.
		<<case "trees">>
			푸른 나무들이 숲에 들어온 듯한 기분을 준다.
		<<case "crosses">>
			황금 십자가가 벽을 뒤덮고 있다.
		<<case "starry">>
			별이 빛나는 은하수가 벽을 뒤덮고 있다.
		<<case "deep sea">>
			깊고 푸른 바다가 당신을 둘러싸고 있다.
		<<case "beach">>
			목가적인 해변 풍경이 벽을 뒤덮고 있다.
		<<case "crabs">>
			귀여운 게 무늬가 벽을 뒤덮고 있다.
		<<case "flames">>
			불꽃이 당신을 둘러싸고 있다. 괜찮다.
		<<case "stained glass">>
			스테인드글라스 무늬가 벽을 뒤덮고 있다.
		<<case "audience">>
			실루엣들이 당신을 둘러싸고 있다. 마치 군중이 지켜보는 것 같다.
		<<case "bears">>
			곰돌이처럼 귀여운 무늬가 벽을 뒤덮고 있다.
		<<default>> /* Custom */
			_furniture.wallpaper.name의 이미지가 벽을 뒤덮고 있다.
			<<if _wallpaper is "wallpaper_dol">>
				왠지 모르게 익숙해 보인다.
			<<elseif _furniture.wallpaper.name.startsWith('&lt;&lt')>>
				<span class="black">부정행위를 들킨 것 같은 기분이 든다.</span>
			<</if>>
	<</switch>>
<<else>>
	삭막한 벽이 외부로부터 당신을 보호한다.
<</if>>

/* Misc Furniture */
<<set _desk to Furniture.get('desk')>>
<<if _desk is null>>
	<<set _desk to Furniture.set('desk','desk')>>
<</if>>
<<set _chair to Furniture.get('chair')>>
<<if _chair is null>>
	<<set _chair to Furniture.set('chair','chair')>>
<</if>>
<<deskText "icon">> /* If no desk options (read a book, work on project, etc.) are available, desk and icon appear here */
<<tableText "icon">> /* If no fish tank is available to be placed on an owned table or chairs, table and chairs appear here */

/* Decorations */
<<set _deco to Furniture.get('decoration')>>
<<if _deco>>
	<br>
	<<switch _deco.name>>
		<<case "large bear plushie" "large candy pillow">>
			<<furnitureicon _deco.iconFile>>_deco.name【은는】 구석에 놓여 있다.
		<<default>>
			<<furnitureicon _deco.iconFile>>_deco.name【은는】 벽에 걸려 있다.
	<</switch>>
<</if>>

<<set _owlplush to Furniture.get('owlplushie')>>
<<if _owlplush>>
	<br>
	<<switch _owlplush.id>>
		<<case "owlplushie">>
			<<set _owlplushNameKr to "부엉이 인형">>
			<<furnitureicon _owlplush.iconFile>><<print _owlplushNameKr>>【은는】 어둠 속에 녹아들 듯 옷장 위에서 내려다보고 있다.
	<</switch>>
<</if>>

<<set _windowsill to Furniture.get('windowsill')>>
<<if _windowsill>>
	<br>
	<<switch _windowsill.name>> /* can be expanded further */
		<<case "ominous jar">> /* unused */
			<<furnitureicon _windowsill.iconFile>> _windowsill.nameCap【은는】 창틀 위에 위협적으로 서 있다.
		<<default>>
			<<furnitureicon _windowsill.iconFile>> _windowsill.name【은는】 창틀에 놓여 있다.
	<</switch>>
<</if>>

<<if _furniture.poster>>
	<<set _premadePoster to ["cowgirl", "cow_girl", "cat", "puppy"].includes(_furniture.poster.name)>>
	<<set _poster to _premadePoster ? "poster_" + _furniture.poster.name : ['dol', 'degrees of lewdity'].some(e => _furniture.poster.name.toLowerCase().includes(e)) ? "poster_dol" : "poster">>
	<br>

	<<furnitureicon _poster>>
	<<switch _furniture.poster.name>>
		<<case "cowgirl" "cow_girl">>
			카우걸 포스터가 벽에 걸려 있다.
		<<case "cat">>
			고양이 포스터가 벽에 걸려 있다. 아래에는 "조금만 견뎌!"라고 적혀 있다.
		<<case "puppy">>
			강아지 포스터가 벽에 걸려 있다.
		<<default>> /* Custom */
			_furniture.poster.name 포스터가 벽에 걸려 있다.
			<<if _poster is "poster_dol">>
				이상한 친숙함이 느껴진다.
			<<elseif _furniture.poster.name.startsWith('&lt;&lt;')>>
				<span class="black">부정행위를 들킨 것 같은 기분이 든다.</span>
			<</if>>
	<</switch>>
<</if>>

/* Events */
<br><br>
<<if $robinbed is "yours" and Time.dayState !== "night" and !$possessed>>
	<<unset $robinbed>><<unset $bedGuest>>
	<<npc Robin>><<person1>>로빈이 하품하며 자기 방으로 향한다.<<endevent>>
	<<if Time.hour is 6 and Time.minute lte 20>><<run setRobinLocationOverride("orphanage", 6)>><</if>>
	<br><br>
<</if>>
<<if $unbind is 1>>
	<<unset $unbind>>
	<<if $possessed>>
		당신은 당신의 결박을 내려다본다. 당신이 당기자, 그것들은 당신을 버티지 못하고 부서져 버린다. <<unbind>>
		<br><br>
	<<else>>
		<span class="green">당신은 결박을 <span style="position:relative;top:-5px"><<furnitureicon _desk.iconFile>></span> 책상에 문지른다.</span> 제법 힘이 들지만, 결국 재질이 버티지 못하고 풀려 팔다리가 자유로워진다.
		<br><br>
	<</if>>
<</if>>
<<if $study is 1>>
	<<unset $study>>
	<<if $phase is 1>>
		당신은 과학 교과서를 펼쳐 내용을 읽는다.
		<<scienceskill>>
	<<elseif $phase is 2>>
		당신은 수학 교과서를 펼쳐 내용을 읽는다.
		<<mathsskill>>
	<<elseif $phase is 3>>
		당신은 영어 교과서를 펼쳐 내용을 읽는다.
		<<englishskill>>
	<<elseif $phase is 4>>
		당신은 역사 교과서를 펼쳐 내용을 읽는다.
		<<historyskill>>
	<</if>>
	<<endevent>>
	<br><br>
<</if>>

<<if $nextPassageCheck is "Bedroom">>
	<span class="nextLink"><<link [[달을 바라본다.|Bedroom]]>><</link>></span>
	<br>
<</if>>

<<if $stress gte $stressmax and !$possessed>>
	<<passouthome>>
	<<exit>>
<</if>>

<<if $christmas is 1 and Time.monthDay is 25 and $christmas_robin_visit is undefined and $christmas_robin_gift_received is undefined and Time.dayState isnot "night" and C.npc.Robin.init is 1 and !$possessed>>
	<<set $christmas_robin_visit to true>>
	<<christmas_robin_visit>>
	<<exit>>
<</if>>
<<if $christmas is 1 and !$christmas_wraith>>
	<<rngWraith 1>>
<</if>>

<<if breakableSoftBinding()>>
	<<undobindingsicon>><<link [[결박을 푼다 (0:10)|Bedroom]]>><<set $unbind to 1>><<pass 10>><<unbind>><</link>>
	<br><br>
<</if>>

<<if $worn.face.cursed is 1>>
	<<icon "clothes/gag.png">><<link [[`$worn.face.name【을를】 제거한다 (0:10)`|Bedroom]]>><<pass 10>><<set $worn.face.type.push("broken")>><<faceruined>><</link>>
	<br><br>
<</if>>

<<if $robinpaid is 1 and $robinmissing is 0 and $robinnote isnot 1 and C.npc.Robin.lust gte 10 and C.npc.Robin.love gte 60 and C.npc.Robin.trauma lt 10>>
	<span class="gold">창가에 쪽지가 있다.</span>
	<br>
	<<mysteryicon>><<link [[읽는다|Robin Note]]>><<set $robinnote to 1>><</link>>
	<br><br>
<</if>>

/* Desk */
<<deskText "noicon">> /* If project, study, or Christmas options are available, desk location appears here, in line with bed/wardrobe/etc locations */

창밖에 온도계가 있다. 온도는 <span class="teal"><<print Weather.toSelectedString(Weather.temperature, 0)>></span>라고 표시되어 있다.
<<print setup.WeatherDescriptions.extremeTemperature()>>
<br><br>

/* Bed */
당신의 침대가 방의 대부분을 차지하고 있다.
<<if $gwylanSeen?.includes("fox_plushie")>>
	/* ToDo: Gwylan - convert to use furniture system */
	커다란 여우 봉제인형이 추가 베개 역할을 한다.
<</if>>
<<set _bed to Furniture.get('bed')>>
<<if $nextPassageCheck is "Bed">>
	<br>
	<<if $robinbed is "yours" or $robinbed is "theirs">>
		<span class="nextLink"><<furnitureicon _bed.iconFile>><<link [[로빈.|Bed]]>><</link>></span>
	<<else>>
		<span class="nextLink"><<furnitureicon _bed.iconFile>><<link [[카일라.|Bed]]>><</link>></span>
	<</if>>
	<br>
	<<listsleepoutfits>>
<<elseif !($earSlime.event and $earSlime.noSleep)>>
	<br>
	<<furnitureicon _bed.iconFile>><<link [[옷을 벗고 침대에 들어간다|Bed]]>><<undressSleep "bed">><</link>>
	<br>
	<<listsleepoutfits>>
<<else>>
	<br>
	<<if $possessed>>
		<<ind>><span class="purple">머릿속 슬라임은 조용하다.</span>
	<<else>>
		<<ind>><span class="red">머릿속 슬라임은 잠자리에 들기 전에 <<print $earSlime.event>> 하기를 원한다.</span>
	<</if>>
	<br>
<</if>>

<<if _bed.type.includes("comfy")>>
	<<skinicon "masturbate">><<link [[침대에서 자위한다|Home Masturbation]]>><<set $masturbationstart to 1>><</link>>
	<br>
<</if>>

<<roomoptions>>
<<safehouseEvents>>
<br>
/* Wardrobe */
<<set _wardrobe to Furniture.get('wardrobe')>>
<<if _wardrobe>>
	당신의 옷은 _wardrobe.name 안에 보관되어 있다.
<</if>>
<br>
<<furnitureicon _wardrobe.iconFile>><<link [[옷장|Wardrobe]]>><</link>>
<br>
<<if playerHasSexToys()>>
	<<sextoysicon>><<link [[섹스 토이|Sextoys Inventory]]>><<set $sextoyInvReturnLink to $passage>><</link>>
	<br>
<</if>>
<<if $nextPassageCheck is "Mirror">>
	<span class="nextLink"><<mirroricon>><<link [[거울|Mirror]]>><<preMirror>><</link>></span>
	<br>
<<elseif $christmas is 1 and !$christmas_wraith and _wraithEvent>>
	<<mirroricon "blood">><<link [[거울|Christmas Mirror]]>><<preMirror>><</link>>
	<<note "거울 속에서 낯선 섬광이 비친다." "purple">>
	<br>
<<elseif Time.hour is 3 and $hallucinations gte 2 and $daily.mirrorTentacles isnot 1 and $settings.tentaclesEnabled>>
	<<mirroricon "blood">><<link [[거울|Eerie Mirror]]>><<preMirror>><<set $daily.mirrorTentacles to 1>><<set $phase to 0>><</link>>
	<<note "거울에서 기묘한 빛이 새어 나온다." "purple">>
	<br>
<<else>>
	<<mirroricon "home">><<link [[거울|Mirror]]>><<preMirror>><</link>>
	<br>
<</if>>

/*Table*/
<<tableText "noicon">> /* If fish tank option available, table/chair location appears here, in line with bed/wardrobe locations */

/* Travel */
<br>
바깥 복도는 고아원의 나머지 부분과 연결되어 있다.
<<if $exposedRaw gte 2>>
	<<if Time.dayState isnot "night">>
		<<if hasSexStat("exhibitionism", 5)>>
			<br>
			<span class="purple"><<genitals>>【을를】 드러낸 채 밖에 나간다는 생각이 당신을 흥분시킨다. 조심하기만 하면 괜찮겠지?</span>
			<<orphanageWard>>
			<br>
			<<bathroomLink>>
			<br>
			<<robinroom_link>>
			<br>
			<<home_outside>>
			<br><br>
		<<elseif hasSexStat("exhibitionism", 4)>>
			<br>
			<span class="purple"><<genitals>>【을를】 드러낸 채 밖에 나간다는 생각이 당신을 흥분시킨다. 하지만 이 시간에 들키지 않고 넘어갈 방법은 없다. 어두워진 뒤라면 모를까.</span>
			<br><br>
		<<else>>
			<<orphanageWard>>
			<br>
			<<main_hall_icon>> <span class="red">이런 꼴로는 방을 나갈 수 없다!</span>
			<br><br>
		<</if>>
	<<else>>
		<<if hasSexStat("exhibitionism", 4)>>
			<br>
			<span class="purple"><<genitals>>【을를】 드러낸 채 밖에 나간다는 생각이 당신을 흥분시킨다. 어차피 밤인데, 무슨 일이야 생기겠어?</span>
			<<orphanageWard>>
			<br>
			<<bathroomLink>>
			<br>
			<<robinroom_link>>
			<<main_hall_icon>><<link [[중앙 홀 (0:01)|Orphanage]]>><<pass 1>><</link>>
			<br>
			<<home_outside>>
			<br><br>
		<<else>>
			<<orphanageWard>>
			<br>
			<<main_hall_icon>> <span class="red">이런 꼴로는 방을 나갈 수 없다!</span>
			<br><br>
		<</if>>
	<</if>>
<<elseif $exposedRaw gte 1>>
	<<if Time.dayState isnot "night">>
		<<if hasSexStat("exhibitionism", 3)>>
			<br>
			<span class="purple">그토록 음란한 차림으로 밖에 나간다는 생각이 당신을 흥분시킨다. 조심하기만 하면 괜찮겠지?</span>
			<<orphanageWard>>
			<br>
			<<bathroomLink>>
			<br>
			<<robinroom_link>>
			<br>
			<<home_outside>>
			<br><br>
		<<elseif hasSexStat("exhibitionism", 2)>>
			<br>
			<span class="purple">그토록 음란한 차림으로 밖에 나간다는 생각이 당신을 흥분시킨다. 하지만 이 시간에 들키지 않고 넘어갈 방법은 없다. 어두워진 뒤라면 모를까.</span>
			<br><br>
		<<else>>
			<<orphanageWard>>
			<br>
			<<main_hall_icon>> <span class="red">이런 꼴로는 방을 나갈 수 없다!</span>
			<br><br>
		<</if>>
	<<else>>
		<<if hasSexStat("exhibitionism", 2)>>
			<br>
			<span class="purple">그토록 음란한 차림으로 밖에 나간다는 생각이 당신을 흥분시킨다. 어차피 밤인데, 무슨 일이야 생기겠어?</span>
			<br>
			<<orphanageWard>>
			<br>
			<<bathroomLink>>
			<br>
			<<robinroom_link>>
			<<main_hall_icon>><<link [[중앙 홀 (0:01)|Orphanage]]>><<pass 1>><</link>>
			<br>
			<<home_outside>>
			<br><br>
		<<else>>
			<<orphanageWard>>
			<br>
			<<main_hall_icon>> <span class="red">이런 꼴로는 방을 나갈 수 없다!</span>
			<br><br>
		<</if>>
	<</if>>
<<elseif $worn.under_lower.type.includes("naked")>>
	<<if $underwarningskip is 1>>
		<<orphanageWard>>
		<br>
		<<bathroomLink>>
		<br>
		<<kitchenicon "stove">><<link [[주방 (0:01)|Kitchen]]>><<pass 1>><</link>>
		<br>
		<<robinroom_link>>
		<br>
		<<if Time.hour gte 18 and Time.hour lte 20 and C.npc.Robin.trauma gte 40 and $robinmissing is 0 and !$robinTraumaVisit>>
			<<main_hall_icon>><<link [[중앙 홀 (0:01)|Robin Trauma Visit]]>><<set $phase to 1>><<pass 1>><</link>>
			<br>
		<<else>>
			<<main_hall_icon>><<link [[중앙 홀 (0:01)|Orphanage]]>><<pass 1>><</link>>
			<br>
		<</if>>
		<<home_outside>>
		<br><br>
		<<set _kylar to statusCheck("Kylar")>>
		<<if $kylar_camera is 4>>
			부엉이 봉제인형이 옷장 위에서 당신을 지켜보고 있다. 당신은 그 안에 카메라가 있다는 것을 안다.
			<br>
			<<furnitureicon "owl plushie">><<link [[카일라의 카메라를 어떻게 할지 결정한다 (0:05)|Bedroom Kylar Camera]]>><<pass 5>><</link>>
			<br><br>
		<</if>>
		<<if $kylar_camera is 0>>
			카일라가 선물하려 했던 상자가 침대 발치에 놓여 있다.
			<br>
			<<gifticon "valentine">><<link [[열어본다|Bedroom Kylar Gift Open]]>><</link>>
			<br><br>
		<<elseif $kylar_camera is 1>>
			카일라가 선물하려 했던 상자가 침대 발치에 놓여 있다. 부엉이 봉제인형이 안에 있다.
			<br>
			<<furnitureicon "owl plushie">><<link [[장식으로 둔다|Bedroom Kylar Gift Keep]]>><</link>>
			<br>
			<<gifticon "valentine">><<link [[고아에게 준다|Bedroom Kylar Gift Orphan]]>><<hope 1>><</link>><<ghope>>
			<br><br>
		<</if>>
	<<else>>
		<br>
		<span class="pink">속옷을 입고 있지 않다! 이런 모습으로 밖에 나간다는 생각에 맥박이 빨라진다.</span>
		<br>
		<<link [[상관없겠지|Bedroom]]>><<set $underwarningskip to 1>><</link>>
		<br><br>
	<</if>>
<<else>>
	<<orphanageWard>>
	<br>
	<<bathroomLink>>
	<br>
