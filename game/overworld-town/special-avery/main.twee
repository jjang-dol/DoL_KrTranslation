<<set $outside to 0>><<effects>>
<<set _car to {}>>
<<if $phase2>>
	<<set _car.intro to $phase2>>
<</if>>

당신은 <<= either("차에 올라", "차에 타")>> 앞좌석 조수석에 앉는다. 에이버리는 문을 잠그고 학교로 차를 몬다.
<br><br>
여정은 짧지만, 차가 막혀 시간이 조금 걸린다.

<<set _chats to "에이버리는 잡담을 나누며 " + either(`<<him>>의 옆에 있는 당신을 가끔 흘끗 본다.`,`이따금 당신을 흘끗 본다.`)>>
<<if _car.intro>>
	<<switch _car.intro>>
		<<case 1>>
			<<if $averySeen.includes("meetCafe")>>
				<<He>>【은는】 카페에서 나누던 대화를 다시 이어간다. "학교는 지금까지 어땠나요?" <<he>>【은는】 어느 순간 묻는다.
				<<if $averySeen.includes("meetPark")>>
					"프로젝트는 잘 진행되고 있나요?"
				<<else>>
					"보통 걸어가나요, 아니면 버스를 타나요?"
				<</if>>
			<<else>>
				<<print _chats>> <<He>>【은는】 많은 질문을 하지만, 당신의 질문에는 답을 피한다.
			<</if>>
		<<case 2>>
			<<print _chats>> "이미 당신을 데리러 가고 있으니 말이죠. 일곱 시쯤 밖으로 나오면 됩니다. 나는 여덟 시에 출근해야 하니까요."
		<<default>>
			<<print _chats>> "내 평소 경로에 있습니다. 월요일마다, 그리고 내가 일찍 퇴근하는 다른 날에도 데리러 갈 수 있을 겁니다."
	<</switch>>
<<else>>
	<<print _chats>>
	<br><br>

	<<set _car.event to random(0,4)>>
	<<if _car.event is 4 and (C.npc.Avery.rage gte 20 or (C.npc.Avery.rage gte 10 and $averyragerevealed is 1))>>
		막 교통이 풀리려던 순간,
		<<if C.npc.Whitney.init is 1 and !["pillory","dungeon"].includes(C.npc.Whitney.state) and $rng gte 51>>
			<<set _car.whitney to true>>
			휘트니와 <<nnpc_his "Whitney">> <<= either(`친구들`,`패거리`)>>【이가】
		<<else>>
			<<set _car.whitney to false>>
			학생 무리 하나가
		<</if>>
		<<= either(`차 앞으로`,`교통을 신경 쓰지 않고`)>> 도로 위로 걸어나오면서 다시 차들이 멈춰 선다.
		<<if $averyragerevealed is 1>>
			"씨발, 뭐야!" 에이버리가 소리치며 경적을 울린다.
			<br><br>
			무리는 조금도 동요하지 않는 듯하다. 조롱 섞인 웃음이 터져 나오고,
			<<if _car.whitney is true>>
				<<= either(`휘트니`, `휘트니의 친구 중 하나`)>>【이가】
			<<else>>
				<<generatey2>><<person2>><<person>> 하나가
			<</if>>
			에이버리를 향해 <<= either(`음란한 손짓을 한다`, `천박한 손짓을 한다`, `가운뎃손가락을 치켜든다`)>>.<<person1>>
			<br><br>
			"저급한 쓰레기들." 에이버리가 이를 악문 채 말한다
		<<else>>
			"사랑스럽군요." 에이버리는 거짓으로 밝은 목소리를 내며 <<person1>><<his>> 손가락으로 운전대를 <<= either(`톡톡 두드리기`,`두드리기`)>> 시작한다. "<<= either(`참 생산적인 사회 구성원들이네요.`,`저게 미래의 노동력이라는 건가요?`)>>"
			<br><br>
			그 무리가 인도로 건너가자, 에이버리는 안도의 한숨을 내쉰다
		<</if>>
		.
	<<elseif _car.event is 3 and C.npc.Avery.rage gte 10 or (C.npc.Avery.rage gte 1 and $averyragerevealed is 1)>>
		자전거를 탄 <<generate2>><<person2>><<person>> 하나가 차 가까이로 지나간다.
		<<if $averyragerevealed is 1>>
			에이버리는 창문을 내리고 몸을 내민다. "조심해!" <<person1>><<he>>【은는】 자전거 탄 사람에게 소리친 뒤 다시 몸을 들이고 창문을 닫는다. "<<= either(`병신`,`씹새끼`,`개새끼`)>>."
		<<else>>
			에이버리는 <<person1>><<his>> 숨 아래로 욕을 중얼거리고 운전대를 쥔 손에 힘을 준다. "자전거 타는 사람들은 꽤 성가실 수 있죠." <<he>>【이가】 말한다. "당신도 운전을 시작하면 이해할 겁니다."
		<</if>>
	<<elseif _car.event is 2>> /* Different if the PC lives at their manor. */
		<<= either(
			`"이 차를 며칠 전에 막 세차하고 광택까지 냈습니다." <<he>>【은는】 어느 순간 말한다. "눈치챘나요, <<pcpetname "Avery">>?"`,
			`"며칠 전에 주유소에 들렀습니다." <<he>>【은는】 어느 순간 말한다. "이 차 하나 기름 채우는 데만 £<<= random(69, 163)>>【이가】 들더군요. 믿을 수가 없어요."`,
			`대부분의 운전 시간은 편안한 침묵 속에 흐른다. 이따금 교차로에 멈출 때면, 에이버리가 당신을 바라보는 것을 포착한다. 그럴 때마다 <<he>>【은는】 잠깐 <<= C.npc.Avery.rage gte 20 ? "비웃음" : "미소">>인지 모를 표정을 보인 뒤, 다시 도로를 바라본다.`
		)>>
	<<elseif _car.event is 1>> /* Different if the PC works for Avery */
		<<= either(
			`"직장의 신입들은 정말이지 무능하기 짝이 없습니다." <<he>>【은는】 운전대를 손가락으로 두드리며 말한다. "직업 윤리라는 게 없어요."`,
			`"며칠 전에 임시 직원 하나가 일은 안 하고 근무 중에 술을 마시다 들켰습니다." <<he>>【은는】 운전대를 손가락으로 두드리며 말한다. "대체 어디서 이런 사람들을 데려오는지 모르겠군요. 길거리에서 걸어 들어오는 멍청이는 아무나 채용하는 겁니까? 말도 안 되죠." <<He>>【은는】 코웃음 치고 당신을 흘끗 본다. "당신은 절대 그런 짓 안 하겠죠, <<pcpetname "Avery">>?"`,
			`"직장의 새 인턴이 며칠 전에 중요한 서류 몇 개를 잘못 둔 일이 있었습니다." <<he>>【은는】 운전대를 손가락으로 톡톡 두드리며 말한다. "내가 더 나은 사람이 아니었다면..." <<He>>【은는】 말을 끝내지 않는다.`
		)>>
	<<else>>
		<<set _car.window to random(0,6)>>
		당신은 창밖을 바라본다
		<<if $dissociation gte 1>>
			. 모든 것이 흐릿하게 지나가는 것을 보는 동안, 에이버리의 목소리가 배경 속으로 희미해진다.
		<<elseif _car.window is 1 and $schoolfameblackmail isnot undefined>>
			. 차가 학교에 점점 가까워질수록, 둔하고 서서히 스며드는 불안감이 자리 잡기 시작한다. <<stress 6>><<trauma 3>><<gstress>><<gtrauma>>
		<<elseif _car.window is 2 and $syndromekylar gte 1>>
			. 차가 다뉴브 가를 달리며 카일라의 저택을 지나간다.
		<<elseif _car.window is 3>>
			. 차가 다뉴브 가와 울프 가를 달리는 동안 숲이 스쳐 보이고, 당신은
			<<if $syndromeeden gte 1 or $syndromewolves gte 1>>
				<<if $syndromeeden gte 1 and random(1,2) is 1>>
					에덴이 어떻게 지내는지 생각한다. 어쩌면 곧 <<= $edenshopping is 0 ? '<<nnpc_him "Eden">>에게 보급품을 좀 더 사줘야' : '<<nnpc_him "Eden">>【을를】 찾아가 봐야'>> 할지도 모른다.
				<<elseif $syndromewolves gte 1>>
					검은 늑대와 무리가 어떻게 지내는지, 그리고 그들이 <<if $wolfpackferocity lt $wolfpackharmony>>아직 <</if>>잘 어울리고 있는지 생각한다.
				<<else>>
					에덴이 어떻게 지내는지 생각한다. 어쩌면 곧 <<= $edenshopping is 0 ? '<<nnpc_him "Eden">>에게 보급품을 좀 더 사줘야' : '<<nnpc_him "Eden">>【을를】 찾아가 봐야'>> 할지도 모른다.
				<</if>>
			<<else>>
					그곳 주민들에 대한 이상한 소문들을 떠올린다.
			<</if>>
		<<elseif _car.window is 4 and $temple_rank isnot undefined>>
			. 차가 울프 가를 달리며 신전 옆을 지나간다.
		<<elseif _car.window is 5 and $harper_appointments.enabled>>
			. 차가 나이팅게일 가를 달리며 병원을 지나간다. 당신은 <<= Time.weekDay is 6 ? "오늘" : "이번 금요일">> 하퍼 의사와 약속이 있다는 것을 떠올린다.
		<<elseif _car.window is 6 and isLoveInterest("Avery")>>
			. 모든 것이 지나가는 것을 지켜본다. 당신은 에이버리가 <<= Time.weekDay is 6 ? "내일 데이트" : "토요일의 다음 데이트">>에 당신을 어디로 데려갈지 궁금해진다.
		<<else>>
			. 모든 것이 지나가는 것을 지켜본다. 아직 이른 아침이다. 하지만 다른 학생들도 학교로 향하는 모습이 보인다.
		<</if>>
	<</if>>
<</if>>
<br><br>
