				<</capture>>
				<br>
			<</if>>
		<</for>>
		<<exit>>
	<</if>>
<<else>>
	<<if ["ghostshroom","wolfshroom"].includes($phase) or $phase is "wild_honeycomb" and (!$settings.beesEnabled or !$settings.bestialityEnabled)>>
