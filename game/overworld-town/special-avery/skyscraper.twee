:: Skyscraper Ascend
<<set $location to "avery_skyscraper">><<effects>>
<<set $avery_fate to "ascended">>
<<set C.npc.Avery.title to "crimson hound">>
<<set C.npc.Harper.title to "silver fox">>
<<set C.npc.Remy.title to "high elk">>
