		<br><br>
		<<icon "avery-hallway.png">><<link [[안으로 들어간다 (0:01)|Mansion Chase Hallway 1 W]]>><<pass 1>><<avery_mansion_chase_location>><</link>>
		<br>
		<<icon "avery-garden.gif">><<link [[정원 (0:01)|Mansion Chase Garden]]>><<pass 1>><<avery_mansion_chase_location>><</link>>
		<br>
<</switch>>

