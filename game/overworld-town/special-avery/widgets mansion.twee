<<widget "avery_mansion_chase_run">> /* Moves PC to adjacent room */
	<<set delete $avery_mansion.chase.avery_bus_prev>><<set delete $avery_mansion.chase.bus_prev>>
	<<switch $avery_mansion.chase.avery_bus>>
		<<case "lounge">>
