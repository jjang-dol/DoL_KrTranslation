:: Widgets Avery Mansion [widget]

<<widget "avery_mansion_variables_debug">>
	렌트 시간: $renttime<br>
	/*Avery card gift: <<print $avery_card_gift>><br>*/
	<<if $avery_mansion>>
	저택 부재 일수: <<print $avery_mansion.days_absent>><br>
	에이버리 대사 태도: $speech_attitude_avery<br>
	/*Bailey message: <<print $avery_mansion.bailey_message>><br>*/
	버스: <<print $bus>><br>
	운명: $avery_fate<br>
	저택 화재 시간: $avery_mansion_fire_time<br>
	마천루 화재 시간: $avery_skyscraper_fire_time<br>
	사랑: <<print C.npc.Avery.love>>
	지배: <<print C.npc.Avery.dom>>
	분노: <<print C.npc.Avery.rage>>
	<br>
	<<if $fake_artefact>>
		가짜 유물: <<print $fake_artefact>><br>
	<<else>>
		없음<br>
	<</if>>
	손님: <<print $avery_mansion.guest>><br>
	/*Date: <<print $averydate>><br>*/
	에이버리 통로: $avery_passage<br>
	에이버리 저택 수영장: <<print $avery_mansion.pool>><br>
	에이버리 저택 부엌: <<print $avery_mansion.kitchen>><br>
	에이버리 저택 라운지: <<print $avery_mansion.lounge>><br>
	에이버리 저택 진열장: <<print $avery_mansion.display>><br>
	에이버리 저택 침실: <<print $avery_mansion.bedroom>><br>
	에이버리 저택 욕실: <<print $avery_mansion.bathroom>><br>
	에이버리 저택 다이닝룸: <<print $avery_mansion.dining>><br>
	에이버리 저택 정원: <<print $avery_mansion.garden>><br>


	에이버리 저택 직업: <<print $avery_mansion.jobs>><br>
	에이버리 저택 일정: <<print $avery_mansion.schedule>><br>
	에이버리 저택 상태: <<print $avery_mansion.state>><br>
	에이버리 저택 일수: <<print $avery_mansion.days>><br>
	에이버리 저택 걷기 사이클: <<print $avery_mansion.walk_cycle>><br>
	에이버리 저택 진열 유물: <<print $avery_mansion.display_antiques>><br>
	에이버리 저택 음식: <<print $avery_mansion.food>><br>
	에이버리 저택 최근 음식: <<print $avery_mansion.food_last>><br>
	에이버리 저택 데이트 준비: <<print $avery_mansion.date_ready>><br>

	에이버리 분노 직장: <<print $avery_mansion.rage.work>><br>
	에이버리 분노 사과: <<print $avery_mansion.rage.apologetic>><br>
	에이버리 분노 저녁 놓침: <<print $avery_mansion.rage.dinner_missed>><br>
	에이버리 분노 저녁 마침: <<print $avery_mansion.rage.dinner_done>><br>
	에이버리 분노 저녁 실수: <<print $avery_mansion.rage.dinner_wrong>><br>
	에이버리 분노 타이머: <<print $avery_mansion.rage.timer>><br>
	분노 평가: <<print $avery_mansion.rage.assess>><br>

	에이버리 저택 데이트 보임: <<print $avery_mansion.date_seen>><br>
	에이버리 저택 파티 상태: <<print $avery_mansion.party_state>><br>
	에이버리 저택 세탁소: <<print $avery_mansion.landry>><br>
	에이버리 저택 금고 진행도: <<print $avery_mansion.vault_progress>><br>
	<<if $avery_tower>>
		에이버리 저택 탑 진행도: <<print $avery_tower.progress>><br>
		에이버리 탑 효과: <<print $avery_tower.effects>><br>
		에이버리 탑 단계: <<print $avery_tower.stage>><br>
	<</if>>
	<<if $avery_antiques>>
		에이버리 유물 진행도: <<print $avery_antiques.progress>><br>
		에이버리 유물 볼트: <<print $avery_antiques.bolts>><br>
		에이버리 유물 볼트 진행도: <<print $avery_antiques.bolt_progress>><br>
		에이버리 유물 노출: <<print $avery_antiques.exposed>><br>
		에이버리 유물 도난: <<print $avery_antiques.stolen>><br>
		에이버리 유물 목격: <<print $avery_antiques.noticed>><br>
		에이버리 유물 직면: <<print $avery_antiques.confront>><br>
	<</if>>
	<<set _avery_mansion_chase_test to false>>
	<<if $avery_mansion.chase and _avery_mansion_chase_test>>
		에이버리 추격 게임 상태: <<print $avery_mansion.chase.state>><br>
		에이버리 추격 승리: <<print $avery_mansion.chase.victory>><br>
		에이버리 추격 체력: <<print $avery_mansion.chase.health>><br>
		에이버리 추격 버스: <<print $avery_mansion.chase.bus>><br>
		에이버리 추격 버스_이전: <<print $avery_mansion.chase.bus_prev>><br>
		에이버리 추격 에이버리_버스: <<print $avery_mansion.chase.avery_bus>><br>
		에이버리 추격 에이버리_버스_이전: <<print $avery_mansion.chase.avery_bus_prev>><br>
		에이버리 추격 소리: <<print $avery_mansion.chase.sound>><br>
		에이버리 추격 플레이어_소리: <<print $avery_mansion.chase.player_sound>><br>
		에이버리 추격 열쇠: <<print $avery_mansion.chase.key>><br>
		/*
		Avery chase key_checked: <<print $avery_mansion.key_checked>>
		Avery chase gear: <<print $avery_mansion.gear>><br>
		 */
		에이버리 추격 함정: <<print $avery_mansion.chase.trap>><br>
		에이버리 추격 함정_완료: <<print $avery_mansion.chase.trap_done>><br>
		에이버리 추격 열쇠_위치: <<print $avery_mansion.chase.key_location>><br>
	<</if>>
	<<if $avery_party>>
		에이버리 파티 대사_손님: <<print $avery_party.speech_guest>><br>
		에이버리 파티 대사_에이버리: <<print $avery_party.speech_avery>><br>
		에이버리 파티 손님들: <<print $avery_party.guests>><br>
		에이버리 파티 단계: <<print $avery_party.stage>><br>
		에이버리 파티 현재_대사: <<print $avery_party.current_speech>><br>
		에이버리 파티 기분_손님: <<print $avery_party.mood_guest>><br>
		에이버리 파티 기분_에이버리: <<print $avery_party.mood_avery>><br>
	<</if>>
	<<if $avery_dungeon>>
		에이버리 지하 감옥 도구: <<print $avery_dungeon.tool>><br>
		에이버리 지하 감옥 타이머: <<print $avery_dungeon.timer>><br>
	<</if>>
<</if>>
<</widget>>

<<widget "avery_mansion_init">>
	<<set $avery_mansion to {}>>
	<<set $avery_mansion.version to 5>>

	<<set $avery_mansion.pool to 0>>
	<<set $avery_mansion.kitchen to 0>>
	<<set $avery_mansion.lounge to 0>>
	<<set $avery_mansion.display to 0>>
	<<set $avery_mansion.bedroom to 0>>
	<<set $avery_mansion.bathroom to 0>>
	<<set $avery_mansion.dining to 0>>
	<<set $avery_mansion.garden to 0>>
	<<set $avery_mansion.study to 0>>
	<<set $avery_mansion.garage to 0>>

	<<set $avery_mansion.jobs to []>>
	<<set $avery_mansion.schedule to "home">>
	<<set $avery_mansion.state to "normal">>
	<<set $avery_mansion.days to 0>>
	<<set $avery_mansion.days_absent to 0>>
	<<set $avery_mansion.walk_cycle to 0>>
	<<set $avery_mansion.display_antiques to 0>>
	<<set $avery_mansion.food to "hamburger">>
	<<set $avery_mansion.food_last to "none">>
	<<set $avery_mansion.date_ready to false>>

	<<set $avery_mansion.rage to {}>>
	<<set $avery_mansion.rage.work to false>>
	<<set $avery_mansion.rage.apologetic to false>>
	<<set $avery_mansion.rage.dinner_missed to 0>>
	<<set $avery_mansion.rage.dinner_done to 0>>
	<<set $avery_mansion.rage.dinner_wrong to false>>
	<<set $avery_mansion.rage.assess to 0>>
	<<set $avery_mansion.rage.timer to 0>>

	<<set $avery_mansion.fox to {}>>
	<<set $avery_mansion.fox.progress to 0>>
	<<set $avery_mansion.fox.known to false>>

	<<set $avery_mansion.date_seen to false>>
	<<if Time.weekDay is 1>>
		<<set $avery_mansion.party_state to "first sunday skip">>
	<<else>>
		<<set $avery_mansion.party_state to "waiting">>
	<</if>>
	<<set $avery_mansion.guest to "Bailey">>
	<<set $avery_mansion.landry to 0>>
	<<set $avery_mansion.vault_progress to 0>>

	<<set $avery_mansion.kitchen_stock to {
		normal: ["salt", "vegetable_oil", "bottle_of_milk", "flour", "chicken_egg", "beef", "pork", "truffle", "cream", "tomato", "red_wine", "white_wine", "rice", "chilli_pepper", "banana"],
		requested: []
	}>>
	<<set $avery_mansion.kitchen_made to 0>>
	<<set $avery_mansion.recipe to []>>

	<<set $daily.avery.housekeeping_events to {}>>

	<<set $avery_mansion.attend to {}>>


	<<set $daily.avery.talk to {}>>
	<<set $daily.avery.talk.ignore to false>>
	<<set $daily.avery.talk.limit to false>>
	<<set $daily.avery.talk.flirt to false>>
	<<set $daily.avery.talk.seduce to false>>
	<<set $daily.avery.talk.annoyed to 0>>
	<<set $daily.avery.talk.chat to 0>>
	<<if Time.weekDay is 1 or Time.weekDay is 7>>
		<<set $daily.avery.talk.chat_limit to 6>>
	<<else>>
		<<set $daily.avery.talk.chat_limit to 3>>
	<</if>>

	<<set $daily.avery.ask to {}>>
	<<set $daily.avery.ask.science to false>>
	<<set $daily.avery.ask.maths to false>>
	<<set $daily.avery.ask.play to false>>

	<<set $avery_tower to {}>>
	<<set $avery_tower.progress to 0>>
	<<set $avery_tower.effects to []>>
	<<set $avery_tower.effects.pushUnique("theft")>>
	<<set $avery_tower.stage to 0>>
	<<set $avery_tower.intro to 0>>
	<<set $avery_mansion.stopPartyAfterTower to false>>

	<<avery_antiques_init>>
	<<avery_mansion_start_clothes>>
	<<set $wardrobes.avery_mansion.unlocked to true>>
<</widget>>

<<widget "avery_daily_talk">>
	<<if $daily.avery.talk.chat is undefined>>
		<<set $daily.avery.talk.annoyed to 0>>
		<<set $daily.avery.talk.chat to 0>>
		<<if Time.weekDay is 1 or Time.weekDay is 7>>
			<<set $daily.avery.talk.chat_limit to 6>>
		<<else>>
			<<set $daily.avery.talk.chat_limit to 3>>
		<</if>>
	<</if>>
<</widget>>

<<widget "avery_antiques_init">>
	<<set $avery_antiques to {}>>
	<<set $avery_antiques.progress to 0>>
	<<set $avery_antiques.bolts to 10>>
	<<set $avery_antiques.bolt_progress to 0>>
	<<set $avery_antiques.exposed to []>>
	<<set $avery_antiques.stolen to []>>
	<<set $avery_antiques.noticed to []>>
	<<set $avery_antiques.confront to []>>
<</widget>>

<<widget "avery_antiques_end">>
	<<unset $avery_antiques>>
	<<set $avery_mansion.antiques_stolen to true>>
<</widget>>

<<widget "avery_mansion_food_select">>
	<<avery_food_select>>
	<<if $avery_mansion.food is $avery_mansion.food_last>>
		<<if $avery_mansion.rage.dinner_wrong>>
			"다시 생각해 보니, 방금 건 아주 맛있었어," 에이버리가 말한다. <span class="gold">"다음에도 <<recipe_name $avery_mansion.food "article">>【을를】 원해."</span>
		<<else>>
			"늘 먹던 게 좋겠어. <span class="gold">또 <<recipe_name $avery_mansion.food "article">>【을를】 해 줘.</span>"
		<</if>>
	<<elseif setup.foodstuff[$avery_mansion.food].food.tags.includes("seafood")>>
		"다음엔 해산물이 좋겠군," 에이버리가 말한다. <span class="gold">"<<recipe_name $avery_mansion.food "article">>【이가】 딱 맞을 것 같아."</span>
	<<elseif setup.foodstuff[$avery_mansion.food].food.tags.includes("sweet")>>
		"다음엔 달콤한 게 좋겠군," 에이버리가 말한다. <span class="gold">"<<recipe_name $avery_mansion.food "article">>【이가】 딱 맞을 것 같아."</span>
	<<elseif setup.foodstuff[$avery_mansion.food].food.tags.includes("spicy")>>
		"다음엔 매콤한 게 좋겠군," 에이버리가 말한다. <span class="gold">"<<recipe_name $avery_mansion.food "article">>【이가】 딱 맞을 것 같아."</span>
	<<else>>
		"다음엔 든든한 게 좋겠군," 에이버리가 말한다. <span class="gold">"<<recipe_name $avery_mansion.food "article">>【이가】 딱 맞을 것 같아."</span>
	<</if>>
	<br><br>
	<i>지배도가 높아지면 에이버리가 더 복잡한 요리를 요구할 것이다.</i>
	<br><br>

	<<if $gift isnot $avery_requested_food>>
		<<for _i range setup.foodstuff[$avery_requested_food].recipe.ingredients>>
			<<if $foodstuff[_i].amount is 0 and !$avery_mansion.kitchen_stock.normal.concat($avery_mansion.kitchen_stock.requested).includes(_i)>>
				<<set _missingIngredients to true>>
			<</if>>
		<</for>>
	<</if>>
	<<if _missingIngredients>>
		<<link [[재료가 부족해서 <<recipe_name $avery_requested_food "article">>【을를】 만들 수 없었다고 말한다|Avery Gifts Ingredients]]>><</link>>
		<br>
	<</if>>
	<<if $foodstuff[$avery_mansion.food]?.knows_recipe isnot true>>
		<<link [[요리법을 모른다고 말한다|Avery Gifts Recipe]]>><<unset $avery_requested_food>><</link>>
		<br>
	<</if>>
	<<if $foodstuff[$avery_mansion.food]?.knows_recipe isnot true or _missingIngredients>>
		<<link [[아무 말도 하지 않는다|Mansion Dining]]>><<endevent>><<unset $avery_requested_food>><</link>>
		<br>
	<<else>>
		<<link [[다음|Mansion Dining]]>><<endevent>><<unset $avery_requested_food>><</link>>
		<br>
	<</if>>

<</widget>>

<<widget "avery_mansion_tower">>
	<<if _args[0]>>
		<<set $avery_tower.progress += _args[0]>>
		<<set $avery_tower.progress to Math.clamp($avery_tower.progress, 0, 100)>>
	<</if>>
<</widget>>

<<widget "avery_mansion">>
	<<if $avery_mansion.party_state is "started">>
		<<run throw new Error("avery_mansion_party_end was run when current guest was already marked as 'done'! Please report this error.")>>
	<</if>>

	<<averySchedule>>
	<<if $avery_mansion.schedule is "away" and $avery_mansion.away_timer gte 0 and Time.weekDay is 7 and Time.hour is 20>>
		<<set $averydateattended to 1>>
	<</if>>

	<<if $avery_mansion.schedule isnot "away">>
		<<if $avery_mansion.schedule is "sleep">>
			<<if $avery_mansion.bedroom_state is "off-limits away">>
				<<set $avery_mansion.bedroom_state to "off-limits">>
			<</if>>
		<<else>>
			<<if $avery_mansion.bedroom_state is "off-limits" or $avery_mansion.bedroom_state is "locked">>
				<<set $avery_mansion.bedroom_state to "off-limits away">>
			<<elseif $avery_mansion.bedroom_state is "ignored insisted">>
				<<set $avery_mansion.bedroom_state to "ignored">>
			<<elseif $avery_mansion.bedroom_state is "insisted">>
				<<unset $avery_mansion.bedroom_state>>
			<</if>>
		<</if>>
	<</if>>
	<<if $avery_mansion.schedule is "pool">>
		<<if !Weather.isOvercast and Time.dayState isnot "night">>
			<<set $avery_pool to "sunbathe">>
		<<elseif Weather.precipitation isnot "none">>
			<<set $avery_pool to "coffee">>
		<<else>>
			<<set $avery_pool to "swim">>
		<</if>>
	<<else>>
		<<set $avery_pool to "none">>
	<</if>>
<</widget>>

<<widget "avery_mansion_away">>
	<<set $avery_mansion.schedule to "away">>
	<<set $avery_mansion.timer to 6>>
<</widget>>

<<widget "avery_housework_change">>
	<<if _args[0] and _args[1] and $avery_mansion[_args[0]] isnot undefined>>
		<<set $avery_mansion[_args[0]] += _args[1]>>
		<<set $avery_mansion[_args[0]] = Math.clamp($avery_mansion[_args[0]], 0, 4)>>
	<</if>>
<</widget>>

<<widget "avery_mansion_end_links">>
	<<if $avery_passage is "Mansion Lounge Piano">><<set $avery_passage to "Mansion Lounge">><</if>>
	<<if _args[0] is "housework">>
		<<avery_housework_check>>
		<<if _avery_housework_count gte 1>>
			<<icon "clothes/feather-duster.png">><<link [[청소를 계속한다|Mansion Housework]]>><</link>>
			<br>
			<<refuseicon>><<link [[그만둔다|$avery_passage]]>><</link>>
		<<else>>
			<<if $avery_mansion.bedroom gte 1>>
				<span class="blue">저택은 먼지 한 톨 없이 깨끗하다, <<if $avery_mansion.bedroom_state is "locked">>잠긴 <</if>>침실과<<if $avery_mansion.pool gte 1>> 수영장을<</if>> 제외하고는.</span>
				<<if $avery_mansion.bedroom_state isnot "locked">>
					<br>
					<<socialiseicon "angry">><<link [[에이버리의 경고를 무시하고 침실을 청소한다|Mansion Housework]]>><<set $avery_mansion.bedroom_state to "ignored">><</link>>
					<br>
					<<getouticon>><<link [[손대지 않고 둔다|$avery_passage]]>><<set $avery_mansion.bedroom_state to "off-limits">><</link>>
					<<exit>>
				<</if>>
			<<elseif $avery_mansion.pool gte 1>>
				<span class="blue">수영장을 제외하면 저택은 먼지 한 톨 없이 깨끗하다.</span>
			<<else>>
				<span class="green">저택은 먼지 한 톨 없이 깨끗하다.</span>
			<</if>>
			<br><br>
			<<link [[다음|$avery_passage]]>><</link>>
		<</if>>
		<br>
	<<else>>
		<<if $bus is "avery_dungeon">>
			<<link [[다음|Mansion Bedroom]]>><</link>>
		<<else>>
			<<link [[다음|$avery_passage]]>><</link>>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "avery_current_room_dirty_check">>
	<<if $avery_mansion.jobs.includes("pool") and $avery_mansion.pool gte 1 and $bus is "avery_pool">>
		<<set _dirty_room to true>>
	<</if>>
	<<if $avery_mansion.jobs.includes("kitchen") and $avery_mansion.kitchen gte 1 and $bus is "avery_kitchen">>
		<<set _dirty_room to true>>
	<</if>>
	<<if $avery_mansion.jobs.includes("lounge") and $avery_mansion.lounge gte 1 and $bus is "avery_lounge">>
		<<set _dirty_room to true>>
	<</if>>
	<<if $avery_mansion.jobs.includes("display") and $avery_mansion.pool gte 1 and $bus is "avery_display">>
		<<set _dirty_room to true>>
	<</if>>
	<<if $avery_mansion.jobs.includes("bedroom") and $avery_mansion.pool gte 1 and $bus is "avery_bedroom">>
		<<set _dirty_room to true>>
	<</if>>
	<<if $avery_mansion.jobs.includes("bathroom") and $avery_mansion.pool gte 1 and $bus is "avery_bathroom">>
		<<set _dirty_room to true>>
	<</if>>
	<<if $avery_mansion.jobs.includes("dining") and $avery_mansion.pool gte 1 and $bus is "avery_dining">>
		<<set _dirty_room to true>>
	<</if>>
	<<if $avery_mansion.jobs.includes("garden") and $avery_mansion.pool gte 1 and $bus is "avery_garden">>
		<<set _dirty_room to true>>
	<</if>>
<</widget>>

<<widget "avery_housework_check">>
	<<if !$avery_mansion.jobs.includes("pool")>>
		<<set $avery_mansion.pool to 0>>
	<</if>>
	<<if !$avery_mansion.jobs.includes("kitchen")>>
		<<set $avery_mansion.kitchen to 0>>
	<</if>>
	<<if !$avery_mansion.jobs.includes("lounge")>>
		<<set $avery_mansion.lounge to 0>>
	<</if>>
	<<if !$avery_mansion.jobs.includes("display")>>
		<<set $avery_mansion.display to 0>>
	<</if>>
	<<if !$avery_mansion.jobs.includes("bedroom")>>
		<<set $avery_mansion.bedroom to 0>>
	<</if>>
	<<if !$avery_mansion.jobs.includes("bathroom")>>
		<<set $avery_mansion.bathroom to 0>>
	<</if>>
	<<if !$avery_mansion.jobs.includes("dining")>>
		<<set $avery_mansion.dining to 0>>
	<</if>>
	<<if !$avery_mansion.jobs.includes("garden")>>
		<<set $avery_mansion.garden to 0>>
	<</if>>
	<<set _avery_housework_count to $avery_mansion.kitchen + $avery_mansion.lounge + $avery_mansion.display + $avery_mansion.bathroom + $avery_mansion.dining + $avery_mansion.garden>>
	<<if !($avery_mansion.schedule is "pool" and $daily.avery.housekeeping_events.pool)>>
		<<set _avery_housework_count += $avery_mansion.pool>>
	<</if>>
	<<if $avery_mansion.bedroom gte 1 and $avery_mansion.bedroom_state isnot "locked" and $avery_mansion.bedroom_state isnot "off-limits">>
		<<set _avery_housework_bedroom to true>>
		<<set _avery_housework_count += $avery_mansion.bedroom>>
	<</if>>
<</widget>>

<<widget "avery_mansion_housework_total">>
	<<set _avery_mansion_housework_total to 0 + $avery_mansion.pool + $avery_mansion.kitchen + $avery_mansion.lounge + $avery_mansion.display + $avery_mansion.bathroom + $avery_mansion.dining + $avery_mansion.garden>>
<</widget>>

<<widget "avery_mansion_description">>
	<<avery_housework_check>>
	<<set _avery_housekeeping to Math.floor(10 - $housekeeping / 200)>>
	<<set _avery_tending to Math.floor(10 - $tending / 200)>>
	<<set _avery_mansion_time to 0 + $avery_mansion.pool * _avery_housekeeping + $avery_mansion.kitchen * _avery_housekeeping + $avery_mansion.lounge * _avery_housekeeping + $avery_mansion.display * _avery_housekeeping + $avery_mansion.bathroom * _avery_housekeeping + $avery_mansion.dining * _avery_housekeeping + $avery_mansion.garden * _avery_tending>>

	<<if _args[0] is "all" and $avery_mansion.jobs.includes("lounge")>>
		라운지:
	<</if>>
	<<if _args[0] is "lounge" or _args[0] is "all" and $avery_mansion.jobs.includes("lounge")>>
		<<if $avery_mansion.lounge gte 4>>
			<span class="red">마치 황소가 미쳐 날뛴 것 같다.</span>
		<<elseif $avery_mansion.lounge is 3>>
			<span class="pink">텔레비전에 커다란 얼룩이 묻어 있다.</span>
		<<elseif $avery_mansion.lounge is 2>>
			<span class="purple">탁자 위에 쓰레기가 널려 있다.</span>
		<<elseif $avery_mansion.lounge is 1>>
			<span class="blue">쿠션은 엉망으로 흩어져 있고, 피아노엔 먼지가 쌓여 있다.</span>
		<<else>>
			<span class="green">쇼룸을 방불케 할 정도로 깨끗하다.</span>
			<<if !_avery_housework_count and $avery_mansion.bedroom is 0>>
				<<if $avery_mansion.pool gte 1>>
					<span class="blue">수영장을 제외한 저택의 나머지 부분은 티 없이 말끔하다.</span>
				<<else>>
					<span class="green">저택은 티끌 하나 없이 말끔하다.</span>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("lounge")>>
		<br>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("kitchen")>>
		부엌:
	<</if>>
	<<if _args[0] is "kitchen" or _args[0] is "all" and $avery_mansion.jobs.includes("kitchen")>>
		<<if $avery_mansion.kitchen gte 4>>
			<span class="red">싱크대에서 무언가가 자라나고 있다.</span>
		<<elseif $avery_mansion.kitchen is 3>>
			<span class="pink">바닥을 대걸레로 닦아야 할 것 같다.</span>
		<<elseif $avery_mansion.kitchen is 2>>
			<span class="purple">싱크대 옆에 냄비, 팬, 접시들이 쌓여 있다.</span>
		<<elseif $avery_mansion.kitchen is 1>>
			<span class="blue">조리대가 부스러기 투성이다.</span>
		<<else>>
			<span class="green">조리대 위에 음식을 놓고 먹어도 될 정도로 깨끗하다.</span>
			<<if !_avery_housework_count and $avery_mansion.bedroom is 0>>
				<<if $avery_mansion.pool gte 1>>
					<span class="blue">수영장을 제외한 저택의 나머지 부분은 티 없이 말끔하다.</span>
				<<else>>
					<span class="green">저택은 티끌 하나 없이 말끔하다.</span>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("kitchen")>>
		<br>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("dining")>>
		식당:
	<</if>>
	<<if _args[0] is "dining" or _args[0] is "all" and $avery_mansion.jobs.includes("dining")>>
		<<if $avery_mansion.dining gte 4>>
			<span class="red">누군가 파티라도 연 듯 엉망이다.</span>
		<<elseif $avery_mansion.dining gte 3>>
			<span class="pink">탁자에서 병이 굴러떨어져 빨간 자국을 남겼다.</span>
		<<elseif $avery_mansion.dining gte 2>>
			<span class="purple">탁자 위엔 버려진 음식들이 널브러져 있다.</span>
		<<elseif $avery_mansion.dining gte 1>>
			<span class="blue">식기류가 제멋대로 흩어져 있다.</span>
		<<else>>
			<span class="green">모든 것이 가지런히 정돈되어 있다.</span>
			<<if !_avery_housework_count and $avery_mansion.bedroom is 0>>
				<<if $avery_mansion.pool gte 1>>
					<span class="blue">수영장을 제외한 저택의 나머지 부분은 티 없이 말끔하다.</span>
				<<else>>
					<span class="green">저택은 티끌 하나 없이 말끔하다.</span>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("dining")>>
		<br>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("display")>>
		전시실:
	<</if>>
	<<if _args[0] is "display" or _args[0] is "all" and $avery_mansion.jobs.includes("display")>>
		<<if $avery_mansion.display gte 4>>
			<span class="red">전시품 사이사이에 거미줄이 쳐져 있다.</span>
		<<elseif $avery_mansion.display is 3>>
			<span class="pink">전시품들에 찌든 때가 덮여 있다.</span>
		<<elseif $avery_mansion.display is 2>>
			<span class="purple">전시품마다 지문이 얼룩덜룩 묻어 있다.</span>
		<<elseif $avery_mansion.display is 1>>
			<span class="blue">전시품에 먼지가 앉아 있다.</span>
		<<else>>
			<span class="green">박물관처럼 전시품들이 새것같이 깨끗하다.</span>
			<<if !_avery_housework_count and $avery_mansion.bedroom is 0>>
				<<if $avery_mansion.pool gte 1>>
					<span class="blue">수영장을 제외한 저택의 나머지 부분은 티 없이 말끔하다.</span>
				<<else>>
					<span class="green">저택은 티끌 하나 없이 말끔하다.</span>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("display")>>
		<br>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("bedroom")>>
		침실:
	<</if>>
	<<if _args[0] is "bedroom" or _args[0] is "all" and $avery_mansion.jobs.includes("bedroom")>>
		<<if $avery_mansion.bedroom gte 4>>
			<span class="red">범죄 현장을 방불케 한다.</span>
		<<elseif $avery_mansion.bedroom gte 3>>
			<span class="pink">이상한 냄새가 난다.</span>
		<<elseif $avery_mansion.bedroom gte 2>>
			<span class="purple">옷가지들이 사방에 흩어져 있다.</span>
		<<elseif $avery_mansion.bedroom gte 1>>
			<span class="blue">침대 정리가 필요해 보인다.</span>
		<<else>>
			<span class="green">모든 것이 제자리에 완벽히 정리되어 있다.</span>
			<<if !_avery_housework_count and $avery_mansion.bedroom is 0>>
				<<if $avery_mansion.pool gte 1>>
					<span class="blue">수영장을 제외한 저택의 나머지 부분은 티 없이 말끔하다.</span>
				<<else>>
					<span class="green">저택은 티끌 하나 없이 말끔하다.</span>
				<</if>>
			<</if>>
		<</if>>
		<<if $avery_mansion.bedroom gte 1 and V.passage is "Mansion Housework Assess">>
			<<if $avery_mansion.bedroom_state is "off-limits">>
				<span class="blue">에이버리가 자고 있으며, <<nnpc_he Avery>>【이가】 잠든 사이에 당신이 침실을 청소하는 것을 좋아하지 않는다.</span>
			<<elseif $avery_mansion.bedroom_state is "locked">>
				<span class="bedroom">침실 문은 잠겨 있다.</span>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("bedroom")>>
		<br>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("bathroom")>>
		욕실:
	<</if>>
	<<if _args[0] is "bathroom" or _args[0] is "all" and $avery_mansion.jobs.includes("bathroom")>>
		<<if $avery_mansion.bathroom gte 4>>
			<span class="red">수도꼭지 주변에 조류가 자라나고 있다.</span>
		<<elseif $avery_mansion.bathroom gte 3>>
			<span class="pink">욕조와 세면대가 변색되어 있다.</span>
		<<elseif $avery_mansion.bathroom gte 2>>
			<span class="purple">거미 한 마리가 배수구 구멍에서 기어 나온다.</span>
		<<elseif $avery_mansion.bathroom gte 1>>
			<span class="blue">욕조와 세면대가 물에 젖어 있다.</span>
		<<else>>
			<span class="green">욕실이 완전히 새것처럼 깨끗하다.</span>
			<<if !_avery_housework_count and $avery_mansion.bedroom is 0>>
				<<if $avery_mansion.pool gte 1>>
					<span class="blue">수영장을 제외한 저택의 나머지 부분은 티 없이 말끔하다.</span>
				<<else>>
					<span class="green">저택은 티끌 하나 없이 말끔하다.</span>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("bathroom")>>
		<br>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("garden")>>
		정원:
	<</if>>
	<<if _args[0] is "garden" or _args[0] is "all" and $avery_mansion.jobs.includes("garden")>>
		<<if $avery_mansion.garden gte 4>>
			<span class="red">식물들이 마구잡이로 자라 있다.</span>
		<<elseif $avery_mansion.garden is 3>>
			<span class="pink">잡초들이 섬세한 꽃들을 질식시키듯 감싸고 있다.</span>
		<<elseif $avery_mansion.garden is 2>>
			<span class="purple">잡초가 깊게 뿌리를 내렸다.</span>
		<<elseif $avery_mansion.garden is 1>>
			<span class="blue">장식수들을 손질할 때가 된 것 같다.</span>
		<<else>>
			<span class="green">식물들이 아주 단정하고 깔끔하다.</span>
			<<if !_avery_housework_count and $avery_mansion.bedroom is 0>>
				<<if $avery_mansion.pool gte 1>>
					<span class="blue">수영장을 제외한 저택의 나머지 부분은 티 없이 말끔하다.</span>
				<<else>>
					<span class="green">저택은 티끌 하나 없이 말끔하다.</span>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("garden")>>
		<br>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("pool")>>
		수영장:
	<</if>>
	<<if _args[0] is "pool" or _args[0] is "all" and $avery_mansion.jobs.includes("pool")>>
		<<if $avery_mansion.pool gte 4>>
			<span class="red">수면 위가 조류로 덮여 번들거린다.</span>
		<<elseif $avery_mansion.pool is 3>>
			<span class="pink">물이 탁하고 불결한 색을 띤다.</span>
		<<elseif $avery_mansion.pool is 2>>
			<span class="purple">죽은 벌레들이 수면에 떠다닌다.</span>
		<<elseif $avery_mansion.pool is 1>>
			<span class="blue">낙엽이 수면에 둥둥 떠 있다.</span>
		<<else>>
			<span class="green">물이 수정처럼 맑고 깨끗하다.</span>
			<<if !_avery_housework_count and $avery_mansion.bedroom is 0>>
				<<if $avery_mansion.pool gte 1>>
					<span class="blue">수영장을 제외한 저택의 나머지 부분은 티 없이 말끔하다.</span>
				<<else>>
					<span class="green">저택은 티끌 하나 없이 말끔하다.</span>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<<if _args[0] is "all" and $avery_mansion.jobs.includes("pool")>>
		<br>
	<</if>>
	<<if _args[0] isnot "all">>
		<br>
	<</if>>
	<br>
<</widget>>

<<widget "avery_mansion_move">>
	<<if $bus is "avery_kitchen">>
		<<kitchenExit>>
	<</if>>
	<<handheldon 1>>
<</widget>>

<<widget "avery_mansion_links">>
	<<set _averyMansionLinksPrinted to true>>
	<<if $avery_mansion.jobs.length gte 1>>
		<<avery_housework_check>>
		<<if !_avery_housework_count>>
			<<if $avery_mansion.bedroom gte 1>>
				<<if $bus isnot "avery_bedroom" and $avery_mansion.bedroom_state isnot "locked">>
					<span class="blue">저택은 먼지 한 톨 없이 깨끗하다, <<if $avery_mansion.bedroom_state is "locked">>잠긴 <</if>>침실과<<if $avery_mansion.pool gte 1>> 수영장을<</if>> 제외하고는.</span>
					<br>
					<<icon "clothes/feather-duster.png">><<link [[집의 상태를 살펴본다|Mansion Housework Assess]]>><<avery_mansion_move>><</link>>
					<br><br>
				<</if>>
			<</if>>
		<<else>>
			저택은 청소가 필요하다.
			<br>
			<<icon "clothes/feather-duster.png">><<link [[집의 상태를 살펴본다|Mansion Housework Assess]]>><<avery_mansion_move>><</link>>
			<br><br>
		<</if>>
	<</if>>

	아래층
	<br>

	<<if $bus isnot "avery_lounge">>
		<<icon "avery-lounge.png">><<link [[라운지 (0:01)|Mansion Lounge]]>><<avery_mansion_move>><<pass 1>><</link>>
		<br>
	<</if>>

	<<if $bus isnot "avery_kitchen">>
		<<icon "avery-kitchen.png">><<link [[부엌 (0:01)|Mansion Kitchen]]>><<avery_mansion_move>><<pass 1>><</link>>
		<br>
	<</if>>

	<<if $bus isnot "avery_dining">>
		<<icon "avery-dining.png">><<link [[다이닝 룸 (0:01)|Mansion Dining]]>><<avery_mansion_move>><<pass 1>><</link>>
		<br>
	<</if>>

	<<if $bus isnot "avery_display">>
		<<icon "avery-display.png">><<link [[전시실 (0:01)|Mansion Display]]>><<avery_mansion_move>><<pass 1>><</link>>
		<br>
	<</if>>

	<<if $bus isnot "avery_garage">>
		<<icon "avery-garage.png">><<link [[차고 (0:01)|Mansion Garage]]>><<avery_mansion_move>><<pass 1>><</link>>
		<br>
	<</if>>
	<br>

	위층
	<br>

	<<if $bus isnot "avery_bedroom">>
		<<if $avery_mansion.bedroom_state is "locked">>
			<<icon "avery-bedroom.png">><span class="blue">에이버리가 오늘 밤 당신을 침실에서 못 들어오게 막았다.</span>
		<<else>>
			<<icon "avery-bedroom.png">><<link [[침실 (0:01)|Mansion Bedroom]]>><<avery_mansion_move>><<pass 1>><</link>>
		<</if>>
		<br>
	<</if>>

	<<if $bus isnot "avery_bathroom">>
		<<icon "avery-bathroom.png">><<link [[욕실 (0:01)|Mansion Bathroom]]>><<avery_mansion_move>><<pass 1>><</link>>
		<br>
	<</if>>


	<<if $bus isnot "avery_study">>
		<<if $avery_mansion.study_unlocked is 1>>
			<<icon "avery-study.png">><<link [[서재 (0:01)|Mansion Study]]>><<avery_mansion_move>><<pass 1>><</link>>
			<br>
		<<else>>
			<<icon "avery-study.png">><<link [[서재 (0:01)|Mansion Study Locked]]>><<avery_mansion_move>><<pass 1>><</link>>
			<br>
		<</if>>
	<</if>>
	<br>

	실외
	<br>

	<<if $bus isnot "avery_garden">>
		<<if $nextPassageCheck is "Mansion Garden">>
			<span class="nextLink"><<icon "avery-garden.gif">><<link [[정원 (0:01)|Mansion Garden]]>><<avery_mansion_move>><<pass 1>><</link>></span>
		<<else>>
			<<icon "avery-garden.gif">><<link [[정원 (0:01)|Mansion Garden]]>><<avery_mansion_move>><<pass 1>><</link>>
		<</if>>
		<br>
	<</if>>
	<<if $bus isnot "avery_pool">>
		<<icon "avery-pool.png">><<link [[수영장 (0:01)|Mansion Pool]]>><<avery_mansion_move>><<pass 1>><</link>>
		<br>
	<</if>>
	<<if $possessed and $nextPassageCheck is "Danube Street">>
		<span class="nextLink"><<icon "front-gate.png">><<link [[떠난다 (0:02)|Danube Street]]>><<avery_mansion_move>><<pass 2>><<endevent>><</link>></span>
	<<elseif $exposedRaw gte 1>>
		<<set _ex to ($exposedRaw >= 2 ? (Time.dayState == "night" ? 4 : 5) : (Time.dayState == "night" ? 2 : 3))>>
		<<if hasSexStat("exhibitionism", _ex)>>
			<<if Time.dayState is "night">>
				<<icon "front-gate.png">><<link [[저택에서 몰래 빠져나간다 (0:10)|Mansion Leave]]>><<avery_mansion_move>><<pass 10>><<endevent>><</link>>
			<<else>>
				<<icon "front-gate.png">><<link [[저택에서 몰래 빠져나간다 (0:20)|Mansion Leave]]>><<avery_mansion_move>><<pass 20>><<endevent>><</link>>
			<</if>>
			<<if $daily.ex.mansion isnot 1>>
				<<switch _ex>>
					<<case 2>>
						<<exhibitionist2>>
					<<case 3>>
						<<exhibitionist3>>
					<<case 4>>
						<<exhibitionist4>>
					<<case 5>>
						<<exhibitionist5>>
				<</switch>>
			<</if>>
		<<else>>
			<span class="blue">이런 옷차림으론 저택을 떠날 수 없다!</span>
		<</if>>
	<<elseif $avery_mansion.landry is 0 and $auriga_artefact is "Avery" and !$avery_fate and !$fake_artefact>>
		<<icon "front-gate.png">><<link [[떠난다 (0:02)|Mansion Landry Interrupt]]>><<avery_mansion_move>><<pass 2>><<endevent>><</link>>
	<<elseif $avery_mansion.days gte 7 and $avery_tower.intro is 1 and $mickeyPub gte 2 and $auriga_artefact is "Avery" and $fake_artefact is "pc" and !$avery_fate and !$avery_mansion.mickey>>
		<<icon "front-gate.png">><<link [[떠난다 (0:02)|Mansion Mickey Interrupt]]>><<avery_mansion_move>><<pass 2>><<endevent>><</link>>
	<<elseif $avery_mansion.days gte 9 and $avery_tower.intro is 1 and $auriga_artefact is "Avery" and $fake_artefact is "pc" and !$avery_fate and !$avery_mansion.fox.known and !isGwylanAbsent()>>
		<<icon "front-gate.png">><<link [[떠난다 (0:02)|Mansion Brown Fox Interrupt]]>><<avery_mansion_move>><<pass 2>><<endevent>><</link>>
	<<elseif $avery_mansion.fox.known and $brownFoxWoundedTimer and !$brownFoxWounded and !isGwylanAbsent()>>
		<<icon "front-gate.png">><<link [[떠난다 (0:02)|Mansion Brown Fox Wounded]]>><<avery_mansion_move>><<pass 2>><<endevent>><</link>>
	<<else>>
		<<icon "front-gate.png">><<link [[떠난다 (0:02)|Danube Street]]>><<avery_mansion_move>><<pass 2>><<endevent>><</link>>
	<</if>>
	<br>
<</widget>>

<<widget "avery_rage_assess">>
	<<avery_mansion_seen>>

	<<if $debug is 1>>
		<br>
		<i>수영장 무질서도:</i> <<print $avery_mansion.pool>>
		<br>
		<i>주방 무질서도:</i> <<print $avery_mansion.kitchen>>
		<br>
		<i>라운지 무질서도:</i> <<print $avery_mansion.lounge>>
		<br>
		<i>전시실 무질서도:</i> <<print $avery_mansion.display>>
		<br>
		<i>침실 무질서도:</i> <<print $avery_mansion.bedroom>>
		<br>
		<i>욕실 무질서도:</i> <<print $avery_mansion.bathroom>>
		<br>
		<i>식당 무질서도:</i> <<print $avery_mansion.dining>>
		<br>
		<i>정원 무질서도:</i> <<print $avery_mansion.garden>>
		<br>
		<i>저녁 식사 놓침:</i> <<print $avery_mansion.rage.dinner_missed>>
		<br>
		<i>현재 분노 평가치:</i> <<print $avery_mansion.rage.assess>>
		<br>
	<</if>>
	<<if $avery_mansion.kneel is "refuse" and $avery_mansion.jobs.includes("knees")>>
		<<set $avery_mansion.rage.assess += 1>>
		<<if $debug is 1>>
			<i>무릎 꿇지 않음</i><br>
		<</if>>
	<<elseif !$avery_mansion.bow and $avery_mansion.jobs.includes("bow")>>
		<<set $avery_mansion.rage.assess += 1>>
		<<if $debug is 1>>
			<i>인사하지 않음</i><br>
		<</if>>
	<</if>>
	<<if $avery_mansion.jobs.includes("meek") and !$speech_attitude_avery and $speech_attitude isnot "meek">>
		<<set $avery_mansion.rage.assess += 1>>
		<<if $debug is 1>>
			<i>태도 불량</i><br>
		<</if>>
	<</if>>
	<<if $avery_mansion.jobs.includes("maid") and !$worn.upper.type.includes("maid") and !$worn.lower.type.includes("maid") and !$worn.head.type.includes("maid")>>
		<<set $avery_mansion.rage.assess += 1>>
		<<set _avery_mansion_maid_failed to true>>
		<<if $debug is 1>>
			<i>메이드복 안 입음</i><br>
		<</if>>
	<</if>>
	<<if !$avery_mansion.jobs.includes("maid") and $avery_mansion.jobs.includes("formal") and !$worn.upper.type.includes("formal") and !$worn.lower.type.includes("formal")>>
		<<set $avery_mansion.rage.assess += 1>>
		<<set _avery_mansion_formal_failed to true>>
		<<if $debug is 1>>
			<i>정장 안 입음</i><br>
		<</if>>
	<</if>>
	<<if $avery_mansion.jobs.includes("hairstyle") and $hairtype isnot "neat">>
		<<set $avery_mansion.rage.assess += 1>>
		<<set $avery_mansion_hairstyle_failed to true>>
		<<if $debug is 1>>
			<i>머리 스타일 틀림</i><br>
		<</if>>
	<</if>>
	<<if $avery_mansion.jobs.includes("hairlength") and $hairlength gte 400>>
		<<set $avery_mansion.rage.assess += 1>>
		<<set $avery_mansion_hairlength_failed to true>>
		<<if $debug is 1>>
			<i>머리가 너무 김</i><br>
		<</if>>
	<</if>>
	<<if $debug is 1>>
		<i>총 분노 평가치:</i> <<print $avery_mansion.rage.assess>>
		<br>
	<</if>>
<</widget>>

<<widget "avery_antiques_notice">>
	<<if $avery_antiques>>
		<<if $avery_antiques.stolen.includes("dagger") and !$avery_antiques.noticed.includes("dagger")>>
			<<set $avery_antiques.stolen.delete("dagger")>>
			<<set $avery_antiques.noticed.pushUnique("dagger")>>
		<</if>>
		<<if $avery_antiques.stolen.includes("amulet") and !$avery_antiques.noticed.includes("amulet")>>
			<<set $avery_antiques.stolen.delete("amulet")>>
			<<set $avery_antiques.noticed.pushUnique("amulet")>>
		<</if>>
		<<if $avery_antiques.stolen.includes("mask") and !$avery_antiques.noticed.includes("mask")>>
			<<set $avery_antiques.stolen.delete("mask")>>
			<<set $avery_antiques.noticed.pushUnique("mask")>>
		<</if>>
	<</if>>
<</widget>>

<<widget "avery_housework_assess">>
	<<avery_rage_assess>>
	<<if $avery_mansion.kneel is "prostrate">>
		당신은 <<him>>의 앞에 무릎을 꿇고, 바닥에 이마를 댄다. <<He>>【이가】 성큼성큼 다가오더니, 당신의 등에 <<his>> 발을 올린다.
	<<elseif $avery_mansion.kneel is "kneel">>
		당신은 <<him>>의 앞에 무릎을 꿇는다. <<He>>【이가】 당신에게 다가온다.
	<<elseif $avery_mansion.bow>>
		당신은 <<him>>에게 정중한
		<<if $player.gender_appearance is "f">>
			여성식 인사를 하며,
		<<else>>
			허리 굽혀 인사를 하며,
		<</if>>
		<<he>>【이가】 성큼 다가오는 것을 맞이한다.
	<<else>>
		당신은 <<he>>【이가】 당신에게 다가오는 것을 지켜본다.
	<</if>>

	<<if !$avery_mansion.rage.apologetic>>
		<<if $avery_mansion.rage.assess gte 18>>
			<span class="red"><<his>> 눈에는 악의가 서려 있다.</span><<gggarage>><<npcincr Avery rage $avery_mansion.rage.assess>>
		<<elseif $avery_mansion.rage.assess gte 9>>
			<span class="pink"><<his>> 눈에는 분노가 서려 있다.</span><<ggarage>><<npcincr Avery rage $avery_mansion.rage.assess>>
		<<elseif $avery_mansion.rage.assess gte 1>>
			<span class="purple"><<He>>【이가】 짜증이 난 듯하다.</span><<garage>><<npcincr Avery rage $avery_mansion.rage.assess>>
		<<else>>
			<<He>>【이가】 지쳐 보이지만, <span class="green">차분하다.</span><<larage>><<npcincr Avery rage -1>>
		<</if>>
	<</if>>
	<br><br>

	<<if $avery_mansion.rage.apologetic is true>>
		<<set $avery_mansion.rage.apologetic to false>>
		<<set $averySeen.pushUnique("rage_apology")>>
		<<He>>【이가】 한 손을 등 뒤로 숨긴 채 긴장한 미소를 짓더니, 장미꽃 다발을 드러낸다. "미안해," 꽃을 내밀며 <<he>>【이가】 말한다. "진짜 너무 미안해. 내가 너무 화를 내서 그래, 하지만 네 잘못이 아니야." <<He>>【이가】 계속 말을 이으려 입을 열었지만, 이내 시선을 돌려버린다.<<lllarage>><<npcincr Avery rage -9>>
		<br><br>

		<<link [[꽃을 받는다|Mansion Return Flowers Accept]]>><<npcincr Avery love 3>><</link>><<gglove>>
		<br>
		<<link [[꽃을 받지 않고 지나친다|Mansion Return Flowers Refuse]]>><<npcincr Avery love -3>><<npcincr Avery rage 1>><</link>><<garage>><<llove>>
		<br>
		<<link [[KR.getPronounKr("his", $NPCList[0].pronouns.his) + "의 손에서 쳐내버린다"|Mansion Return Flowers Smack]]>><<npcincr Avery dom -1>><<npcincr Avery love -1>><<npcincr Avery rage 3>><</link>><<ggarage>>
		<br>
	<<elseif $averyragerevealed gte 1 and C.npc.Avery.rage gte 20 and $avery_mansion.rage.assess gte 1 and $avery_mansion.rage.timer lte 0>>
		<<if $avery_mansion.rage.assess gte random(1, 12)>>

			<<if _args[0] is "work">>
				"내가 널 위해 얼마나 존나게 일하는데," <<he>>【이가】 말한다. "이딴 식으로 보답해." <span class="red"><<He>>【이가】 당신의 팔을 움켜쥔다.</span>
			<<else>>
				"씨발 대체 어디 있었어?" <<he>>【이가】 묻는다. "당연히 날 피해서 숨어 있었겠지." <span class="red"><<He>>【이가】 당신의 팔을 움켜쥔다.</span>
			<</if>>
			<br><br>

			<<avery_mansion_rage_party "revealed chase">>
			<<avery_mansion_rage_housework>>
			<<avery_mansion_chase_init>>

			<span class="red"><<He>>【이가】 당신을 다치게 하려 한다.</span>
			<br><br>

			<<link [[사과한다|Mansion Chase Apologise]]>><<trauma 6>><<npcincr Avery dom 5>><</link>><<gtrauma>><<ggdom>>
			<br>
			<<link [[충격에 대비한다|Mansion Chase Brace]]>><</link>>
			<br>
			<<link [[도망친다|Mansion Chase Run]]>><</link>>
			<br>
		<<else>>
			<<His>> 미소가 억지스럽다.
			<br><br>

			<<if _args[0] is "work">>
				"일이 끔찍했어," <<he>>【이가】 말한다. "여느 때처럼 말이지."
			<<else>>
				"여기 있었네," <<he>>【이가】 말한다. "보고 싶었어."
			<</if>>
			<br><br>

			<<avery_mansion_rage_party "revealed">>
			<<avery_mansion_dom_events>>
		<</if>>
	<<else>>
		<<if !$averyragerevealed and C.npc.Avery.rage gte random(20, 100) and $avery_mansion.rage.assess gte 1>>
			<<set $averyragerevealed to 1>>
			<<if _args[0] is "work">>
				"그래 이런 식이지?" <<his>> 목소리가 분노로 떨린다. "하루 종일 개고생하고 집에 왔더니 꼬라지가 이렇네." <span class="red"><<He>>【이가】 당신의 팔을 움켜쥔다.</span>
			<<else>>
				"씨발 대체 어디 있었어?" <<his>> 목소리가 분노로 떨린다. "사방을 뒤졌잖아." <span class="red"><<He>>【이가】 당신의 팔을 움켜쥔다.</span>
			<</if>>
			<br><br>

			<<avery_mansion_rage_party "chase">>
			<<avery_mansion_rage_housework>>
			<<avery_mansion_chase_init>>

			<span class="red"><<He>>【이가】 당신을 다치게 하려 한다.</span>
			<br><br>
			<<link [[사과한다|Mansion Chase Apologise]]>><<trauma 6>><<npcincr Avery dom 5>><</link>><<gtrauma>><<ggdom>>
			<br>
			<<link [[충격에 대비한다|Mansion Chase Brace]]>><</link>>
			<br>
			<<link [[도망친다|Mansion Chase Run]]>><</link>>
			<br>
		<<else>>
			"긴 하루였어," <<he>>【이가】 억지로 희미한 미소를 지으며 말한다.

			<<avery_mansion_rage_party "normal">>
			<<avery_mansion_dom_events>>
		<</if>>
	<</if>>
	<br><br>
<</widget>>

<<widget "avery_mansion_rage_housework">>
	<<set $avery_mansion.rage.timer to 30>>
	<<He>>【은는】 당신을 비롯해 <<his>> 직장 동료, 원수, 친구, 부모를 향해 장광설을 퍼붓는다. <<He>>【은는】 모든 것에 분노하지만, 몇몇 말들이 반복해서 튀어나온다.
	<span class="red">
	<<if $avery_mansion.pool gte 1>>
		<br>
		"수영장이 무슨 늪지대 같잖아, 젠장."
	<</if>>
	<<if $avery_mansion.kitchen gte 1>>
		<br>
		"부엌 꼬라지가 쥐새끼들 소풍판이 따로 없군."
	<</if>>
	<<if $avery_mansion.lounge gte 1>>
		<br>
		"라운지가 무슨 강간 현장이라도 된 줄 알았어."
	<</if>>
	<<if $avery_mansion.display gte 1>>
		<br>
		"전시실은 아주 무덤이 따로 없더군, 제길."
	<</if>>
	<<if $avery_mansion.bedroom gte 1>>
		<br>
		"침실 꼴이 꼭 살인 현장 같잖아."
	<</if>>
	<<if $avery_mansion.bathroom gte 1>>
		<br>
		"그런 욕실에선 개도 안 씻기겠다."
	<</if>>
	<<if $avery_mansion.dining gte 1>>
		<br>
		"식당에서 아주 똥 냄새가 진동을 하는군."
	<</if>>
	<<if $avery_mansion.garden gte 1>>
		<br>
		"정원 꼴이 꼭 거지 같은 신전 앞마당 같더군."
	<</if>>

	<<if $avery_mansion.rage.dinner_wrong is true and $avery_mansion.rage.dinner_missed gte 1>>
		<<set $avery_mansion.rage.dinner_missed to 0>>
		<br>
		"엉뚱한 음식이나 내오고 말이야. 네가 뭐라도 만들 생각이 들 때 얘기지만."
	<<elseif $avery_mansion.rage.dinner_wrong is true>>
		<br>
		"내게 엉뚱한 음식이나 내오다니."
	<<elseif $avery_mansion.rage.dinner_missed gte 1>>
		<<set $avery_mansion.rage.dinner_missed to 0>>
		<br>
		"네가 날 굶주리게 만들었어."
	<</if>>
	<<if $avery_mansion.rage.ingredients>>
		<<unset $avery_mansion.rage.ingredients>>
		<br>
		"내가 일부러 수고해서 재료까지 사다 주는데, 넌 그게 거기 있는지조차 까먹고 자빠졌지."
	<</if>>
	<<if _avery_mansion_maid_failed>>
		<br>
		"아주 지가 이 집 주인인 것처럼 차려입었군."
	<<elseif _avery_mansion_formal_failed>>
		<br>
		"완전 거지 꼴이잖아."
	<</if>>

	<<if $avery_mansion.jobs.includes("knees") and !$avery_mansion.kneel>>
		<br>
		"왜 나랑 동등한 위치인 양 서 있는 거지?"
	<<elseif $avery_mansion.jobs.includes("bow") and !$avery_mansion.bow>>
		<br>
		"빌어먹을 <<= $player.gender_appearance is "f" ? "절" : "인사">>조차 안 하더군."
	<</if>>

	<<if _avery_mansion_hairstyle_failed>>
		<br>
		<<if _avery_mansion_hairlength_failed>>
			"네 머리카락은 아주 재앙이군."
		<<else>>
			"네 머리카락이 엉망진창이야."
		<</if>>
	<<elseif _avery_mansion_hairlength_failed>>
		<br>
		"그 망할 머리 좀 깎아야겠어."
	<</if>>
	</span>
	<<gpain>><<gtrauma>><<gstress>><<pain 4>><<trauma 6>><<stress 6>>
	<br><br>

	<<run V.avery_mansion.rage.assess = V.avery_mansion.pool + V.avery_mansion.kitchen + V.avery_mansion.lounge + V.avery_mansion.display + V.avery_mansion.bedroom + V.avery_mansion.bathroom + V.avery_mansion.dining + V.avery_mansion.garden + V.avery_mansion.rage.dinner_missed;>>
<</widget>>

<<widget "avery_mansion_dom_events">>
	<<rng 7>>
	<<if $passagePrev is "Maths Project Stim">>
		<<he>>【이가】 말을 잇기도 전에, 당신은 무릎을 꿇으며 <<his>> 셔츠를 움켜쥔다. <<His>> 눈이 휘둥그레진다.
		<br><br>

		<<if $speech_attitude is "meek" or $speech_attitude_avery>>
			"주-주인님... 제-제-제발... 당신이 필요해요,"
		<<elseif $speech_attitude is "bratty">>
			"에-에이버리... 나랑 해줘. 지금 당장, 여기서,"
		<<else>>
			"에-에이버리... 제-제발, 당신의 손길이 필요해,"
		<</if>>
		당신은 목소리를 떨며 낑낑거린다. <span @class="basicJitterCss()">그 효과가 점점 더 강해지고 있다.</span>
		<br><br>

		<<if ($speech_attitude is "meek" or $speech_attitude_avery) or C.npc.Avery.dom lte random(0, 80)>>
			<<His>> 입이 무언가 말하려듯 열리지만, <<he>>【은는】 잠시 말을 멈춘다. <<his>> 얼굴에 능글맞은 미소가 번진다.
			<<if $speech_attitude is "meek" or $speech_attitude_avery>>
				"'주인님'이라고 했나? 흠. 좋아. 아주 좋아, <<pcpetname "Avery">>."
			<</if>>
			<<He>>【이가】 당신의 턱을 쥔다. "내가<<if $speech_attitude is "meek" or $speech_attitude_avery>><<else>>그게<</if>> 얼마나 필요한 거지? 말해봐."
			<br><br>

			"당—" 당신은 헐떡인다. "당신이 생각하는 것보다
			<<if $speech_attitude is "bratty">>
				"훨씬 더요!"
			<<else>>
				세상 그 무엇보다도 더요!"
			<</if>>
			당신은 사실상 <<his>> 다리에 대고 몸을 비벼대고 있다.
			<br><br>

			에이버리가 흡족한 듯 미소 짓는다. "좋아. 난 잔인한 <<personsimple>>【이가】 아니니, 네 소원을 들어주지." 당신을 쓰러뜨리고 올라탄 <<his>> 눈에는 욕정이 가득하다.
			<br><br>

			<<link [[다음|Mansion Return Stim Sex]]>><<set $sexstart to 1>><</link>>
		<<else>>
			<<He>>【은는】 경멸 어린 눈으로 당신을 내려다보더니, <<his>> 발로 당신을 밀쳐낸다.
			<br><br>

			"애정결핍 걸레를 부탁한 적은 없는데," <<he>>【은는】 코웃음을 친다. "네 문제는 네가 알아서 해결해."
			<br><br>

			바닥에 쓰러져 신음하고 낑낑대는 당신을 버려두고 <<He>>【이가】 걸어간다. "나중에 저녁 기대하고 있을 테니까."
			<br><br>

			<<link [[견딘다 (4:00)|Maths Project Endure Mansion]]>><<endevent>><<set $phase to 1>><<pass 240>><<stress 24>><</link>><<ggstress>>
			<br>
			<<link [[밖으로 나간다|Maths Project Outside Mansion]]>><<endevent>><</link>>
			<br>
		<</if>>
	<<elseif $avery_tower.progress gte 25 and $avery_tower.stage is 0>>
		"잠깐 바람 좀 쐬러 가지," <<he>>【이가】 말한다. "내가 짓는 건물 쪽에 다녀올 거야. 진척 상황을 보여주고 싶군."
		<br><br>
		<<if $exposed gte 2>>
			<<link [[에이버리와 함께 간다|Skyscraper Foundation Naked]]>><<set $avery_tower.stage to 1>><</link>>
			<br>
		<<elseif $exposed gte 1>>
			<<link [[에이버리와 함께 간다|Skyscraper Foundation Undies]]>><<set $avery_tower.stage to 1>><</link>>
			<br>
		<<else>>
			<<link [[에이버리와 함께 간다|Skyscraper Foundation]]>><<set $avery_tower.stage to 1>><</link>>
			<br>
		<</if>>
		<<link [[거절한다|Skyscraper Foundation Refuse]]>><<set $avery_tower.stage to 1>><</link>>
		<br>
	<<elseif $avery_tower.progress gte 60 and $avery_tower.stage is 1>>
		"내 마천루가 거의 완공돼 가," <<he>>【이가】 말한다. "이리 와. 구경시켜 줄게."
		<br><br>
		<<if $exposed gte 2>>
			<<link [[에이버리와 함께 간다|Skyscraper Structure Naked]]>><<set $avery_tower.stage to 2>><</link>>
			<br>
		<<elseif $exposed gte 1>>
			<<link [[에이버리와 함께 간다|Skyscraper Structure Undies]]>><<set $avery_tower.stage to 2>><</link>>
			<br>
		<<else>>
			<<link [[에이버리와 함께 간다|Skyscraper Structure]]>><<set $avery_tower.stage to 2>><</link>>
			<br>
		<</if>>
		<<link [[거절한다|Skyscraper Structure Refuse]]>><<set $avery_tower.stage to 2>><</link>>
		<br>
	<<elseif C.npc.Avery.dom gte 80 and !$avery_mansion.jobs.includes("meek")>>
		<<set $avery_mansion.jobs.push("meek")>>
		<<set $speech_attitude_avery to true>>
		<<if $speech_attitude is "meek">>
			"적절한 태도로 날 대하는군. 계속 그렇게 해."
			<br><br>

			<span class="gold">에이버리는 앞으로 당신이 <<nnpc_him "Avery">> 앞에서 유순하게 굴기를 원합니다. 새로운 태도가 해금되었습니다.</span>
			<br><br>

			<<endevent>>
			<<avery_mansion_end_links>>
		<<else>>
			"앞으로도 날 대할 때는 적절한 태도를 보였으면 좋겠군. 적당한 유순함 말이야. 별문제 없을 거라 믿어."
			<br><br>

			<span class="gold">에이버리는 앞으로 당신이 <<nnpc_him "Avery">> 앞에서 유순하게 굴기를 원합니다. 새로운 태도가 해금되었습니다.</span>
			<br><br>

			<<link [[동의한다|Mansion Return Meek]]>><<set $speech_attitude_avery to true>><</link>>
			<br>
			<<link [[거절한다|Mansion Return Meek Refuse]]>><<set $speech_attitude_avery to false>><</link>>
			<br>
		<</if>>
	<<elseif C.npc.Avery.dom gte 75 and !$avery_mansion.jobs.includes("dungeon")>>
		<<set $avery_mansion.jobs.pushUnique("dungeon")>>
		"이리 와. 보여줄 게 있어. 네가 아직 못 본 방이 하나 있거든."
		<br><br>

		<<link [[다음|Mansion Return Dungeon]]>><</link>>
		<br>
	<<elseif C.npc.Avery.dom gte 70 and !$avery_mansion.jobs.includes("display")>>
		<<set $avery_mansion.jobs.push("display")>>
		"전시실 먼지 좀 털어줬으면 좋겠군," 에이버리가 말한다. "조심해. 그 안의 물건들은 너보다 훨씬 비싸니까."
		<br><br>

		<span class="gold">에이버리는 당신이 앞으로 전시실을 청결하게 유지해주길 바랍니다.</span>
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>
	<<elseif C.npc.Avery.dom gte 65 and !$avery_mansion.jobs.includes("knees")>>
		<<set $avery_mansion.jobs.push("knees")>>
		"꿇어."
		<br><br>
		<<link [[무릎을 꿇는다|Mansion Return Kneel]]>><<npcincr Avery dom 1>><<set $avery_mansion.kneel to "kneel">><</link>><<gdom>>
		<br>
		<<link [[거절한다|Mansion Return Kneel Refuse]]>><<npcincr Avery rage 1>><<set $avery_mansion.kneel to "refuse">><</link>><<garage>>
		<br>
	<<elseif C.npc.Avery.dom gte 60 and !$avery_mansion.jobs.includes("garden")>>
		<<set $avery_mansion.jobs.push("garden")>>
		"네게 이걸 맡길 거라곤 생각 못 했는데, 정원 좀 정리해 줘. 관목을 치고 내가 신경 쓰지 못한 잡초를 뽑아."
		<br><br>

		<span class="gold">에이버리는 당신이 앞으로 정원을 가꾸길 바랍니다. 관리 기술이 도움이 될 것입니다.</span>
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>
	<<elseif C.npc.Avery.dom gte 55 and !$avery_mansion.jobs.includes("bathroom")>>
		<<set $avery_mansion.jobs.push("bathroom")>>
		"이제부터 욕실 청소 좀 시작해 줘. 티끌 하나 없게 해."
		<br><br>

		<span class="gold">에이버리는 앞으로 당신이 욕실을 청소해주길 바랍니다.</span>
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>
	<<elseif C.npc.Avery.dom gte 50 and !$avery_mansion.jobs.includes("hairstyle")>>
		<<set $avery_mansion.jobs.push("hairstyle")>>
		<<if $hairtype is "neat">>
			"머리 모양 마음에 드네. 앞으로도 계속 그렇게 유지해."
		<<else>>
			"네 머리 손 좀 봐야겠다. 앞으로는 좀 더 단정하게 다녀."
		<</if>>
		<br><br>

		<span class="gold">에이버리는 앞으로 당신이 "단정한" 머리 스타일을 유지하길 바랍니다.</span>
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>
	<<elseif C.npc.Avery.dom gte 45 and !$avery_mansion.jobs.includes("pool")>>
		<<set $avery_mansion.jobs.push("pool")>>
		"수영장은 자주 청소해 줘야 해. 이제부터 그게 네 일이다. 날 실망시키지 마."
		<br><br>

		<span class="gold">에이버리는 앞으로 당신이 수영장을 청소해주길 바랍니다.</span>
		<br><br>
		<<endevent>>
		<<avery_mansion_end_links>>
	<<elseif C.npc.Avery.dom gte 40 and !$avery_mansion.jobs.includes("maid") and $avery_mansion.jobs.includes("formal")>>
		<<set $avery_mansion.jobs.push("maid")>>
		"너한텐 하인 옷이 잘 어울리겠군. 내가 집을 비웠을 때 누군가 알아서 관리해준다는 느낌이 들 테니. 착하게 앞으로는 적당한 옷을 차려입고 있어."
		<br><br>

		<span class="gold">에이버리는 당신이 앞으로 "메이드" 속성이 있는 옷을 입고 <<nnpc_him "Avery">> 맞이하길 원합니다.</span>
		<br><br>
		<<endevent>>
		<<avery_mansion_end_links>>

	<<elseif C.npc.Avery.dom gte 35 and !$avery_mansion.jobs.includes("kitchen")>>
		<<set $avery_mansion.jobs.push("kitchen")>>
		"부엌은 엉망이 되기 쉽지. 앞으로는 꼭 치워 둬. 쥐라도 나오는 꼴은 수치스러워서 못 봐주니까."
		<br><br>

		<span class="gold">에이버리는 앞으로 당신이 부엌을 청소해주길 바랍니다.</span>
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>
	<<elseif C.npc.Avery.dom gte 30 and !$avery_mansion.jobs.includes("hairlength")>>
		<<set $avery_mansion.jobs.push("hairlength")>>
		<<if $hairlength gte 400>>
			"머리가 좀 기네. 나를 위해 좀 다듬어 줄래? 가장 긴 머리가 어깨에 올 정도로만 말이야."
		<<else>>
			"머리 길이가 아주 예뻐. 계속 그렇게 유지해 줬으면 좋겠어. 가장 긴 머리가 어깨를 넘지 않게 해."
		<</if>>
		<br><br>

		<span class="gold">에이버리는 당신이 앞으로 단정한 머리를 유지하길 원합니다.</span>
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>

	<<elseif C.npc.Avery.dom gte 25 and !$avery_mansion.jobs.includes("dining")>>
		<<set $avery_mansion.jobs.push("dining")>>
		"다이닝 룸이 너무 어지러워져. 특히 손님들이 다녀가고 나면 말이지. 착한 <<girl>>답게 나를 위해 꼭 청소해 줘."
		<br><br>

		<span class="gold">에이버리는 앞으로 당신이 식당을 깨끗하게 유지해주길 바랍니다.</span>
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>
	<<elseif C.npc.Avery.dom gte 20 and !$avery_mansion.jobs.includes("formal")>>
		<<set $avery_mansion.jobs.push("formal")>>
		"집에 왔을 때 좀 더 근사한 옷을 입고 있으면 좋겠군. 내가 한 일들이 전부 보람차다고 느낄 수 있게. 정장 같은 거. 괜찮다면 말이야."
		<br><br>

		<span class="gold">에이버리는 당신이 앞으로 격식을 차린 옷을 입고 <<him>>【을를】 맞이하길 원합니다.</span>
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>

	<<elseif C.npc.Avery.dom gte 15 and !$avery_mansion.jobs.includes("bedroom")>>
		<<set $avery_mansion.jobs.push("bedroom")>>
		"앞으로 내가 일하러 갔을 때 침대 정리 좀 해줄래? 전반적으로 침실도 청소하고. 항상 나한텐 골칫거리였거든."
		<br><br>

		<span class="gold">에이버리는 앞으로 당신이 침실을 깨끗하게 유지해주길 바랍니다.</span>
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>

	<<elseif C.npc.Avery.dom gte 10 and !$avery_mansion.jobs.includes("bow")>>
		<<set $avery_mansion.jobs.push("bow")>>
		<<set $avery_mansion.bow to true>>
		"앞으로 내가 집에 올 때 내게
		<<if $player.gender_appearance is "f">>
			커트시를
		<<else>>
			고개 숙여 인사를
		<</if>>
		해 줄 수 있을까? 그러면 꽤 환영받는 기분이 들 것 같은데."
		<br><br>

		<<link [[동의한다|Mansion Return Bow Agree]]>><<npcincr Avery love 1>><<set $avery_mansion.bow to true>><</link>><<glove>>
		<br>
		<<if $player.gender_appearance is "f">>
			<<link [[커트시를 보여준다|Mansion Return Bow Demonstrate]]>><<set $avery_mansion.bow to true>><<npcincr Avery love 1>><<npcincr Avery dom 1>><</link>><<glove>><<gdom>>
			<br>
		<<else>>
			<<link [[고개 숙여 인사 하는 걸 보여준다|Mansion Return Bow Demonstrate]]>><<set $avery_mansion.bow to true>><<npcincr Avery love 1>><<npcincr Avery dom 1>><</link>><<glove>><<gdom>>
			<br>
		<</if>>
		<<link [[거절한다|Mansion Return Bow Refuse]]>><<set $avery_mansion.bow to false>><<npcincr Avery rage 1>><</link>><<garage>>
		<br>

	<<elseif C.npc.Avery.dom gte 5 and !$avery_mansion.jobs.includes("lounge")>>
		<<set $avery_mansion.jobs.push("lounge")>>
		"내가 일하러 간 사이에 라운지 좀 정리해 주지 않을래? 쿠션 같은 게 제대로 정리되어 있는지 확인만 하면 돼. 걱정거리 하나 줄여주는 셈 치고."
		<br><br>

		<span class="gold">에이버리는 앞으로 당신이 라운지를 깨끗하게 유지해주길 바랍니다.</span> 가사 기술이 도움이 될 것입니다.
		<br><br>

		<<endevent>>
		<<avery_mansion_end_links>>
	<<else>>
		<<if $avery_mansion.jobs.includes("dungeon") and random(1, 7) is 7 and Time.weekDay isnot 1>>
			"따라와. 훈육을 좀 해야겠군."
			<br><br>

			<<link [[에이버리와 함께 지하 감옥으로 간다|Mansion Dungeon Intro]]>><<npcincr Avery dom 1>><</link>><<gdom>>
			<br>
			<<link [[거절한다|Mansion Dungeon Intro Refuse]]>><<npcincr Avery rage 1>><</link>><<garage>>
			<br>
		<<elseif $rng is 1>>
			"마실 것 좀 줘."
			<br><br>
			<<link [[에이버리에게 마실 것을 만들어준다|Mansion Return Drink Accept]]>><<npcincr Avery dom 1>><</link>><<gdom>>
			<br>
			<<link [[정중하게 거절한다|Mansion Return Drink Polite]]>><<npcincr Avery rage 1>><</link>><<garage>>
			<br>
			<<link [[퉁명스럽게 거절한다|Mansion Return Drink Blunt]]>><<npcincr Avery rage 1>><</link>><<garage>>
			<br>
			<<if $avery_mansion.jobs.includes("dungeon")>>
				<<link [["대신 지하 감옥으로 데려가 달라고 " + KR.getPronounKr("he", $NPCList[0].pronouns.he) + " 제안한다"|Mansion Dungeon Intro Ask]]>><<npcincr Avery dom 1>><</link>><<gdom>>
				<br>
			<</if>>
		<<elseif $rng is 2>>
			<<if $spa_job gte 1>>
				"마사지를 좀 받고 싶군. 네 솜씨가 좋다고 들었는데."
			<<else>>
				"마사지나 받았으면 좋겠는데."
			<</if>>
			<br><br>
			<<if $bus is "avery_bathroom">>
				<<link [[에이버리에게 마사지를 해준다 (0:30)|Mansion Return Massage Accept]]>><<pass 30>><<npcincr Avery dom 1>><</link>><<gdom>>
				<br>
			<<else>>
				<<link [[에이버리와 함께 욕실로 간다 (0:30)|Mansion Return Massage Accept]]>><<pass 30>><<npcincr Avery dom 1>><</link>><<gdom>>
				<br>
			<</if>>
			<<link [[정중하게 거절한다|Mansion Return Massage Polite]]>><<npcincr Avery rage 1>><</link>><<garage>>
			<br>
			<<link [[퉁명스럽게 거절한다|Mansion Return Massage Blunt]]>><<npcincr Avery rage 1>><</link>><<garage>>
			<br>
			<<if $avery_mansion.jobs.includes("dungeon")>>
				<<link [["대신 지하 감옥으로 데려가 달라고 " + KR.getPronounKr("he", $NPCList[0].pronouns.he) + " 제안한다"|Mansion Dungeon Intro Ask]]>><<npcincr Avery dom 1>><</link>><<gdom>>
				<br>
			<</if>>
		<<elseif $rng is 3>>
			/* Resets walk_cycle to 0 if Avery's dominance is insufficient, resetting the loop early. */
			<<if $avery_mansion.walk_cycle is 3>>
				<<if C.npc.Avery.dom lt 50>>
					<<set $avery_mansion.walk_cycle to 0>>
				<</if>>
			<<elseif $avery_mansion.walk_cycle gte 2>>
				<<if C.npc.Avery.dom lt 35>>
					<<set $avery_mansion.walk_cycle to 0>>
				<</if>>
			<<elseif $avery_mansion.walk_cycle gte 1>>
				<<if C.npc.Avery.dom lt 20>>
					<<set $avery_mansion.walk_cycle to 0>>
				<</if>>
			<</if>>

			<<if $avery_mansion.walk_cycle is 3>>
				<<set $avery_mansion.walk_cycle to 0>>
				"산책이 좀 당기네," <span class="pink">개목걸이와 목줄</span>을 팽팽하게 잡아당기며 <<he>>【이가】 말한다. 앞면에는 금속 이름표가 달려 있지만, 긁힌 자국이 깊어 알아볼 수가 없다.
				<br><br>
				<<if $exposed gte 2>>
					"무릎 꿇어. 착한 개구먼."
					<br><br>
				<<else>>
					"옷 벗고 무릎 꿇어. 착한 개구먼."
					<br><br>
				<</if>>
				<<if hasSexStat("exhibitionism", 5)>>
					<<link [[에이버리에게 산책 당한다 (0:30)|Mansion Return Walk Dog]]>><<set $phase to 1>><<npcincr Avery dom 3>><</link>><<exhibitionist5>><<ggdom>>
					<br>
					<<link [[부끄럽다고 말한다 (거짓)|Mansion Return Walk Dog Shy]]>><</link>>
					<br>
				<<else>>
					<<link [[부끄럽다고 말한다 (진실)|Mansion Return Walk Dog Shy]]>><</link>>
					<br>
				<</if>>
			<<elseif $avery_mansion.walk_cycle is 2>>
				<<set $avery_mansion.walk_cycle to 3>>
				"산책이 좀 당기네. 하루 종일 책상 앞에만 붙어 있었거든." <<His>> 눈이 욕정을 숨기지 않은 채 당신의 몸을 위아래로 훑는다.
				<br><br>
				<<if $exposed gte 2>>
					"내 마음을 읽었군." <<He>>【이가】 <<his>> 팔을 내민다. "안전하게 지켜줄게."
					<br><br>

					<<He>>【은는】 당신이 이 차림으로 외출하길 바란다.
					<br><br>
				<<else>>
					"옷 벗어. 이웃들 눈요기나 시켜줄까?"
					<br><br>
				<</if>>
				<<if hasSexStat("exhibitionism", 5)>>
					<<link [[옷을 벗고 에이버리와 함께 산책한다 (0:30)|Mansion Return Walk Naked Strip]]>><<set $phase to 1>><</link>><<exhibitionist5>>
					<br>
					<<link [[부끄럽다고 말한다 (거짓)|Mansion Return Walk Naked Strip Shy]]>><</link>>
					<br>
				<<else>>
					<<link [[부끄럽다고 말한다 (진실)|Mansion Return Walk Naked Strip Shy]]>><</link>>
					<br>
				<</if>>
			<<elseif $avery_mansion.walk_cycle is 1>>
				<<set $avery_mansion.walk_cycle to 2>>
				"산책이 좀 당기네. 하루 종일 책상 앞에만 붙어 있었거든." <<He>>【은는】 당신을 빤히 보더니, <<his>> 턱을 톡톡 친다.
				<br><br>
				<<if $exposed gte 2>>
					"이미 차림새는 완벽하군. 혹은 아무것도 안 입었거나."
					<br><br>
					<span class="lewd"><<He>>【은는】 당신이 이러고 밖으로 나가길 원한다!</span>
					<br><br>
					<<if hasSexStat("exhibitionism", 5)>>
						<<link [[에이버리와 함께 산책한다 (0:30)|Mansion Return Walk Naked]]>><<set $phase to 1>><</link>><<exhibitionist5>>
						<br>
						<<link [[부끄럽다고 말한다 (거짓)|Mansion Return Walk Naked Shy]]>><</link>>
						<br>
					<<else>>
						<<link [[부끄럽다고 말한다 (진실)|Mansion Return Walk Naked Shy]]>><</link>>
						<br>
					<</if>>
				<<elseif $exposed gte 1>>
					"차림새는 완벽하군."
					<br><br>
					<<if hasSexStat("exhibitionism", 3)>>
						<<link [[에이버리와 함께 산책한다 (0:30)|Mansion Return Walk Undies]]>><<set $phase to 1>><</link>><<exhibitionist3>>
						<br>
