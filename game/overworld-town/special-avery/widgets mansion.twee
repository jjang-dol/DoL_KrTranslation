	<</if>>

	<<if !_averyMansionLinksPrinted and $bus is "avery_kitchen">>
		<<kitchenExit>>
	<</if>>
<</widget>>

<<widget "avery_mansion_contents_party">>
	<<if $worn.upper.type.includes("formal") and $worn.lower.type.includes("formal")>>
		에이버리가 당신의 옷차림을 살펴보고, 미소를 짓는다. "좋아," <<he>>【이가】 당신과 팔짱을 끼며 말한다. "이리 와. 맞이해야 할 손님들이 있다고."
		<br><br>

		<<avery_mansion_party_start_links>>
	<<else>>
		에이버리가 당신의 옷차림을 살펴본다. "손님들이 오고 있어." <<He>>【이가】 당신의 손을 꽉 잡는다. "이리 와. 내가 직접 입혀주지."
		<br><br>
		<<link [[에이버리와 함께 간다 (0:05)|Mansion Party Dress]]>><<pass 5>><</link>>
		<br>
		<<link [[거절한다|Mansion Party Dress Refuse]]>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "avery_mansion_contents_party_prepare">>
	"거기 있었군," 에이버리가 말한다. "손님들이 곧 도착할 거야." <<He>>【은는】 당신의 옷차림을 살펴본다.
	<<if $worn.upper.type.includes("formal") and $worn.lower.type.includes("formal")>>
		<<if Time.hour is 17>>
			<<pass `60-Time.minute`>>
		<</if>>

		"아주 좋아." <<He>>【은는】 당신과 팔짱을 낀다. "가볼까?"
		<br><br>

		<<avery_mansion_party_start_links>>
	<<else>>
		<<set $avery_mansion.outfit_warning to 1>>
		"가서 뭔가 어울리는 걸 입고 와. 뭔가 좀 더 <span class="gold">격식 있는</span> 것으로 말이야." <<He>>【은는】 자신의 머리카락을 빗으로 쓸어 넘긴다. "제대로 된 인상을 줘야 하니까."
		<br><br>
		<<endevent>>
		<<avery_mansion_end_links>>
	<</if>>
<</widget>>

<<widget "avery_valentines_date_check">>
	<<if Time.monthName is "February" and
	(Time.monthDay is 7 and Time.weekDay is 7) or
	(Time.monthDay is 8 and Time.weekDay is 1) or
	(Time.monthDay is 9 and Time.weekDay is 2) or
	(Time.monthDay is 10 and Time.weekDay is 3) or
	(Time.monthDay is 11 and Time.weekDay is 4) or
	(Time.monthDay is 12 and Time.weekDay is 5) or
	(Time.monthDay is 13 and Time.weekDay is 6)>>
		<<set _date_block to true>>
	<</if>>
<</widget>>

<<widget "avery_mansion_interrupt">>
	<<avery_valentines_date_check>>
	<<if $avery_mansion.schedule isnot "away" and $avery_mansion.schedule isnot "work" and $avery_mansion.schedule isnot "sleep">>
		<<set $_avery_present to true>>
	<</if>>

	<<if $possessed>>
		<<set _avery_interrupt to false>>
	<<elseif $_avery_present is true and $avery_valentines and $avery_valentines.invite and !$avery_valentines.ready and Time.monthName is "February" and Time.monthDay is 14 and Time.hour gte 21>>
		<<set _avery_interrupt to "valentines_ready">>
	<<elseif $_avery_present is true and $avery_injury>>
		<<set _avery_interrupt to "injury">>
	<<elseif $_avery_present is true and $avery_mansion.schedule is "return" and !($avery_valentines and $avery_valentines.invite and Time.monthName is "February" and Time.monthDay is 14 and Time.hour gte 21)>>
		<<set _avery_interrupt to "work">>
	<<elseif $_avery_present is true and $avery_valentines_missed>>
		<<set _avery_interrupt to "valentines_missed">>
	<<elseif $_avery_present is true and $avery_mansion.party_state is "missed">>
		<<set _avery_interrupt to "party_missed">>
	<<elseif $_avery_present is true and $avery_mansion.schedule is "party_prepare" and !$avery_mansion.outfit_warning>>
		<<set _avery_interrupt to "party_prepare">>
	<<elseif $_avery_present is true and $avery_mansion.schedule is "party">>
		<<set _avery_interrupt to "party">>
	<<elseif $_avery_present is true and $avery_valentines and !$avery_valentines.init and Time.monthName is "February" and (Time.monthDay is 14 and Time.hour lt 21 or Time.monthDay lt 14)>>
		<<set _avery_interrupt to "valentines_approach">>
	<<elseif $_avery_present is true and $avery_mansion.date_seen is false and (Time.weekDay isnot 7 or Time.weekDay is 7 and Time.hour lte 19) and !_date_block and !$averydate>>
		<<set _avery_interrupt to "date_approach">>
	<<elseif $_avery_present is true and $averydate is 1 and Time.hour is 20 and $averydatedone isnot 1 and $avery_mansion.date_ready isnot true and Time.weekDay is 7>>
		<<set _avery_interrupt to "date_ready">>
	<<elseif $_avery_present is true and $avery_mansion.schedule is "return">>
		<<set _avery_interrupt to "work">>
	<<elseif $_avery_present is true and $avery_tower.stage is 2 and $avery_tower.progress gte 100 and $avery_mansion.schedule isnot "away">>
		<<set _avery_interrupt to "skyscraper_approach">>
	<<elseif $_avery_present is true and $avery_tower.stage is 3 and Time.isBloodMoon() and !$avery_fate>>
		<<set _avery_interrupt to "skyscraper_ready">>
	<<elseif $avery_tower.stage gte 1 and getRobinLocation() is "orphanage" and $avery_mansion and $avery_mansion_robin is 1 and Time.hour gte 6 and Time.hour lte 21 and !$fromRobinRoom and $avery_fate isnot "fallen" and $avery_fate isnot "kicked">>
		<<set _avery_interrupt to "robin">>
	<<elseif $avery_mansion.schedule is "sleep" and !$avery_mansion.fox.end and Time.dayState is "night" and ($avery_fate is "ascended" or $avery_fate is "saved")>>
		<<if $avery_fate is "ascended" or !isGwylanAbsent()>>
			<<set _avery_interrupt to "fox">>
		<</if>>
	<</if>>
	<<if _args[0] and ["injury","work","party_missed","party_prepare","party","date_approach","date_ready","work","skyscraper_approach","skyscraper_ready","valentines_approach", "valentines_ready", "valentines_missed"].includes(_avery_interrupt)>>
		<<avery_mansion_seen>>
	<</if>>
<</widget>>

<<widget "avery_mansion_start_clothes">>
	<<set $wardrobe_location to "avery_mansion">>

	<<uppersend "ballgown" $wardrobe_location>>
	<<uppersend "maid dress" $wardrobe_location>>
	<<uppersend "hanfu" $wardrobe_location>>
	<<uppersend "tuxedo jacket" $wardrobe_location>>
	<<uppersend "shadbelly coat" $wardrobe_location>>
	<<uppersend "dress shirt" $wardrobe_location>>
	<<uppersend "ghost jumper" $wardrobe_location>>

	<<lowersend "tuxedo trousers" $wardrobe_location>>
	<<lowersend "short school skirt" $wardrobe_location>>
	<<lowersend "school shorts" $wardrobe_location>>

	<<underuppersend "swimsuit" $wardrobe_location>>
	<<underuppersend "camisole" $wardrobe_location>>

	<<underlowersend "lace panties" $wardrobe_location>>
	<<underlowersend "bikini bottoms" $wardrobe_location>>

	<<headsend "maid band" $wardrobe_location>>

	<<necksend "lace choker" $wardrobe_location>>
	<<necksend "necktie" $wardrobe_location>>

	<<handheldsend "regal parasol" $wardrobe_location>>
	<<handheldsend "messenger bag" $wardrobe_location>>
	<<handheldsend "feather duster" $wardrobe_location>>

	<<legssend "sheer stockings" $wardrobe_location>>

	<<feetsend "dress sandals" $wardrobe_location>>
	<<feetsend "cordovan loafers" $wardrobe_location>>
	<<feetsend "court heels" $wardrobe_location>>
	<<feetsend "tuxedo shoes" $wardrobe_location>>
	<<feetsend "school shoes" $wardrobe_location>>
<</widget>>

<<widget "skyscraper_time">>
	<<if Time.monthDay is Time.lastDayOfMonth>>
		<<if Time.hour gte 21>>
			<<set _skyscraper_time to "now">>
		<<else>>
			<<set _skyscraper_time to "tonight">>
		<</if>>
	<<elseif Time.monthDay is Time.lastDayOfMonth - 1>>
		<<set _skyscraper_time to "tomorrow">>
	<<else>>
		<<set _skyscraper_time to "blood">>
	<</if>>
<</widget>>

<<widget "avery_mansion_seen">>
	<<set $avery_mansion.days_absent to 0>>
<</widget>>

<<widget "avery_mansion_clean">>
	<<avery_mansion>>
	<<switch _args[0]>>
		<<case "lounge">>
			<<avery_mansion_clean_lounge>>
		<<case "kitchen">>
			<<avery_mansion_clean_kitchen>>
		<<case "dining">>
			<<avery_mansion_clean_dining>>
		<<case "display">>
			<<avery_mansion_clean_display>>
		<<case "bedroom">>
			<<avery_mansion_clean_bedroom>>
		<<case "bathroom">>
			<<avery_mansion_clean_bathroom>>
		<<case "garden">>
			<<avery_mansion_clean_garden>>
		<<case "pool">>
			<<avery_mansion_clean_pool>>
	<</switch>>
<</widget>>

<<widget "avery_mansion_clean_lounge">>
	<<if $avery_mansion.lounge gte 4>>
		당신은 라운지에서 뒤집힌 가구를 바로 세우고, 창문 위에 커튼을 단다.
	<<elseif $avery_mansion.lounge is 3>>
		당신은 천으로 라운지의 텔레비전을 닦는다.
	<<elseif $avery_mansion.lounge is 2>>
		당신은 라운지 테이블 위의 쓰레기들을 쓰레기봉투에 쓸어 담고, 빗자루와 쓰레받기로 테이블의 부스러기를 닦아낸다.
	<<elseif $avery_mansion.lounge is 1>>
		당신은 라운지의 쿠션들을 더 보기 좋게 정리한다.
	<</if>>
	<<avery_housework_change "lounge" -1>>
	<<pass _housekeeping_time>>

	<<if $avery_mansion.schedule is "lounge" and !$daily.avery.housekeeping_events.lounge>>
		<<set _event_triggered to true>>
		<<set $daily.avery.housekeeping_events.lounge to true>>
		<<npc "Avery">><<person1>>
		<br><br>

		에이버리는 당신이 일하는 것을 지켜보며, 심지어 텔레비전까지 끈다. <<He>>【이가】 의자의 팔걸이에 팔꿈치를 괴고 턱을 괸 채 당신을 응시한다.
		<br><br>

		<<link [[유혹한다|Mansion Housework Tease]]>><<exhibitionist1>><</link>>
		<br>
		<<link [[무시한다|Mansion Housework Ignore]]>><</link>>
		<br>
		<<link [[무례하게 군다|Mansion Housework Rude]]>><<def 1>><<npcincr Avery love -1>><<npcincr Avery rage 1>><</link>><<llove>><<garage>>
	<<elseif $avery_mansion.schedule is "drink" and !$daily.avery.housekeeping_events.drink>>
		<<set _event_triggered to true>>
		<<set $daily.avery.housekeeping_events.drink to true>>
		<<npc "Avery">><<person1>>
		<br><br>

		"앉아," 당신이 라운지를 청소하는 동안 에이버리가 말한다. <<He>>【이가】 테이블에 두 번째 잔을 놓고 비싼 양주를 따른 뒤, 당신 쪽으로 밀어준다.
		<br><br>

		<<if playerIsPregnant() and playerAwareTheyArePregnant()>>
			<span class="blue">아이가 있다는 걸 알면서 술을 마실 수는 없다.</span>
		<<else>>
			<<link [[마신다 (0:05)|Mansion Housework Drink]]>><<pass 5>><<drunk 60>><<npcincr Avery love 1>><</link>><<gdrunk>><<glove>>
		<</if>>
		<br>
		<<link [[거절한다|Mansion Housework Drink Refuse]]>><<npcincr Avery love -1>><</link>><<llove>>
	<</if>>
	<br>
<</widget>>

<<widget "avery_mansion_clean_kitchen">>
	<<if $avery_mansion.kitchen gte 4>>
		당신은 강력한 세제로 부엌의 싱크대를 청소한다.
	<<elseif $avery_mansion.kitchen is 3>>
		당신은 부엌 바닥에 엎질러진 것들을 걸레로 닦아낸다.
	<<elseif $avery_mansion.kitchen is 2>>
		당신은 부엌에서 설거지를 한다.
	<<elseif $avery_mansion.kitchen is 1>>
		당신은 빵 부스러기가 남지 않게 부엌의 조리대를 깨끗이 닦는다.
	<</if>>
	<<avery_housework_change "kitchen" -1>>
	<<pass _housekeeping_time>>
	<br>
<</widget>>

<<widget "avery_mansion_clean_dining">>
	<<if $avery_mansion.dining gte 4>>
		다이닝 룸은 엉망이지만, 당신은 장갑을 끼고 가장 심한 부분부터 청소한다.
	<<elseif $avery_mansion.dining gte 3>>
		당신은 양동이에 뜨거운 물을 채우고, 다이닝 룸의 붉은 얼룩을 닦아낸다.
	<<elseif $avery_mansion.dining gte 2>>
		당신은 다이닝 룸 테이블의 쓰레기를 쓰레기봉투에 쓸어 담고, 남은 얼룩을 닦는다.
	<<elseif $avery_mansion.dining gte 1>>
		당신은 왕족이 써도 될 만큼 다이닝 룸의 식기를 정돈한다.
	<</if>>
	<<avery_housework_change "dining" -1>>
	<<pass _housekeeping_time>>

	<<if $avery_mansion.schedule is "breakfast" and !$daily.avery.housekeeping_events.breakfast>>
		<<set _event_triggered to true>>
		<<set $daily.avery.housekeeping_events.breakfast to true>>
		<<npc "Avery">><<person1>>
		<br><br>

		에이버리는 당신이 없는 것처럼 아침을 먹지만, 이따금씩 당신을 쳐다보며, 당신이 상상했을지도 모를 만큼 빠르게 <<his>> 음식을 향해 시선을 돌린다.
		<br><br>
		"부엌에서 크림 좀 가져와," <<pcpetname Avery">>." <<he>>【이가】 말한다. "디저트에 곁들이고 싶어."
		<br><br>

		<<link [[크림을 가져온다 (0:03)|Mansion Housework Cream]]>><<pass 3>><</link>>
		<br>
		<<link [[거절한다|Mansion Housework Cream Refuse]]>><<npcincr Avery love -1>><<npcincr Avery rage 1>><</link>><<llove>><<garage>>
	<</if>>
	<br>
<</widget>>

<<widget "avery_mansion_clean_display">>
	<<if $avery_mansion.display gte 4>>
		당신은 진열실을 가득 채운 거미줄을 치워, 안에 보관된 골동품들보다 덜 낡아 보이게 만든다.
	<<elseif $avery_mansion.display is 3>>
		당신은 진열실에 있는 골동품들을 광낸다.
	<<elseif $avery_mansion.display is 2>>
		당신은 진열실의 골동품들을 문질러 닦는다.
	<<elseif $avery_mansion.display is 1>>
		당신은 진열실의 골동품들에 쌓인 먼지를 털어낸다.
	<</if>>
	<<avery_housework_change "display" -1>>
	<<pass _housekeeping_time>>

	<<if $avery_antiques.progress is 0 and $avery_antiques.bolts gte 1>>
		<<set _event_triggered to true>>
		<<set $avery_antiques.progress to 1>>
		<br><br>

		전시실에서 세 개의 물건이 특히 빛을 받아 반짝이며 당신의 눈길을 끈다. 모두 황금으로 만들어진 단검, 부적, 그리고 가면이다. 전시된 다른 어떤 물건들보다 가치가 높아 보이며, 여기보다는 박물관에 있는 게 더 어울릴 법하다. 이들은 두꺼운 유리 너머에 보관되어 있다. 자물쇠는 없지만 유리가 금속 볼트로 고정되어 있다. 이것들을 얻어내려면 꽤나 힘들 것이다.
		<br><br>

		<<link [[볼트를 푼다|Mansion Housework Antiques]]>><<set $avery_antiques.bolt_progress += 1>><</link>>
		<br>
		<<link [[무시한다|Mansion Housework Antiques Ignore]]>><</link>>
	<<elseif $avery_mansion.schedule isnot "away" and $avery_mansion.schedule isnot "work" and $avery_antiques.stolen.length gte 1>>
		<<npc "Avery">><<person1>>
		<<set _event_triggered to true>>
		<br><br>

		에이버리가 진열실로 들어와 골동품들에 먼지가 있는지 꼼꼼히 살핀다.
		<<set _items to ["dagger", "amulet", "mask"].filter(item => $avery_antiques.stolen.includes(item))>>
		<<set $_pronoun to pluralise(_items.length, "그것", "그것들")>>

		<<run _items.forEach(item => {
			$avery_antiques.noticed.pushUnique(item);
			$avery_antiques.stolen.delete(item);
		})>>

		<<He>>【이가】 한때 <<print formatList(_items)>>【이가】 놓여 있던 진열장에 다다른다. <<He>>【은는】 그것을 잠시 빤히 응시한다.
		<br><br>

		"내 <<pluralise _items.length "골동품" "골동품">>," 당신을 향해 돌아서며 <<he>>【이가】 말한다. "$_pronoun【을를】 어디다 뒀지?"
		<br><br>

		<<link [[$_pronoun【을를】 가져가지 않았다고 말한다 (거짓말)|Mansion Housework Antiques Lie]]>><</link>>
		<br>
		<<link [[침묵을 지킨다|Mansion Housework Antiques Silent]]>><</link>>
		<br>
		<<link [[$_pronoun【을를】 팔려고 가져갔다고 말한다|Mansion Housework Antiques Sell]]>><</link>>
		<br>
		<<link [[$_pronoun【을를】 박물관에 가져갔다고 말한다|Mansion Housework Antiques Museum]]>><</link>>
		<<if $avery_mansion.baileyStealLie>>
			<br>
			<<link [[베일리가 파티 중에 그것들을 훔쳤다고 말한다 (거짓말)|Mansion Housework Antiques Bailey]]>><</link>>
		<</if>>
	<</if>>
	<br>
<</widget>>

<<widget "avery_mansion_clean_bedroom">>
	<<if $avery_mansion.bedroom_state is "off-limits">>
		<<if _avery_housework_bedroom>>
			당신이 청소하는 동안 에이버리가 잠자리에 들었다. <span class="blue">침실 청소는 일단 건너뛰기로 한다.</span>
			<br>
		<</if>>

		<<exit>>
	<<elseif $avery_mansion.bedroom_state is "locked">>
		<<exit>>
	<</if>>

	<<if $avery_mansion.schedule is "sleep" and not _args[0] is true and $avery_mansion.bedroom_state isnot "ignored insisted" and $avery_mansion.bedroom_state isnot "insisted">>
		<<set _event_triggered to true>>
		<<npc "Avery">><<person1>>
		당신은 침실로 들어가 청소를 시작한다. 에이버리가 당신이 일하는 동안 뒤척인다. <<His>> 두 눈이 번쩍 떠지더니, 찌푸린 표정으로 당신을 지켜본다.
		<br><br>

		<<if $avery_mansion.bedroom_state is "ignored">>
			<<if C.npc.Avery.rage gte 20 and $averyragerevealed is 1>>
				"내가 씨발 뭐라고 했지?" <<he>>【이가】 머리맡의 램프를 켜고 일어나며 말한다. "그렇게 처맞고 싶다면, 소원대로 해주지."<<garage>><<npcincr Avery rage 1>>
				<br><br>

				<<link [[다음|Mansion Housework Bedroom Rape]]>><<set $molestationstart to 1>><</link>>
			<<else>>
				"자는 동안 성가시게 하지 말라고 했을 텐데," <<he>>【이가】 으르렁거린다. "당장 씨발 꺼져."
				<br><br>

				<<link [[순종한다|Mansion Housework Bedroom Comply]]>><</link>>
				<br>
				<<link [[거부한다|Mansion Housework Bedroom Refuse]]>><<npcincr Avery love -1>><<npcincr Avery rage 1>><</link>><<garage>><<llove>>
			<</if>>
		<<else>>
			"그건 아침에 하면 안 되나?"
			<br><br>

			<<link [[지금 청소하겠다고 고집한다|Mansion Housework Bedroom Insist]]>><<npcincr Avery rage 1>><<npcincr Avery love -1>><</link>><<garage>><<llove>>
			<br>
			<<link [[나중에 청소하겠다고 동의한다|Mansion Housework Bedroom Agree]]>><<set $avery_mansion.bedroom_state to "off-limits">><</link>>
		<</if>>
	<<else>>
		<<if _args[0] is true>>
			<<if $avery_mansion.bedroom_state is "ignored">>
				<<set $avery_mansion.bedroom_state to "ignored insisted">>
			<<else>>
				<<set $avery_mansion.bedroom_state to "insisted">>
			<</if>>
		<</if>>

		<<if $avery_mansion.bedroom gte 4>>
			당신은 침대를 제자리로 옮기고, 그 아래 감춰져 있던 지저분한 것들을 깨끗이 치운다.
		<<elseif $avery_mansion.bedroom gte 3>>
			당신은 침실에 묻은 수상한 얼룩을 닦아낸다.
		<<elseif $avery_mansion.bedroom gte 2>>
			당신은 침실의 옷들을 제자리에 정리한다.
		<<elseif $avery_mansion.bedroom gte 1>>
			당신은 시트를 팽팽하게 당겨 침대를 정돈한다.
		<</if>>
		<<avery_housework_change "bedroom" -1>>
		<<pass _housekeeping_time>>
	<</if>>
	<br>
<</widget>>

<<widget "avery_mansion_clean_bathroom">>
	<<if $avery_mansion.bathroom gte 4>>
		당신은 화장실의 수도꼭지를 걸레로 닦는다.
	<<elseif $avery_mansion.bathroom gte 3>>
		당신은 욕조와 세면대를 물과 화학 세제로 닦아, 눈부신 진줏빛을 되찾게 한다.
	<<elseif $avery_mansion.bathroom gte 2>>
		당신은 화장실에 있는 거미들을 밖으로 내보낸다.
	<<elseif $avery_mansion.bathroom gte 1>>
		당신은 걸레로 화장실의 물기를 닦아낸다.
	<</if>>
	<<avery_housework_change "bathroom" -1>>
	<<pass _housekeeping_time>>
	<br>
<</widget>>

<<widget "avery_mansion_clean_garden">>
	<<if $avery_mansion.garden gte 4>>
		당신은 전지가위를 사용해 정원을 뒤덮은 잡초 덤불을 제거한다.
	<<elseif $avery_mansion.garden is 3>>
		당신은 다른 꽃들이 상하지 않게 조심하며 정원의 잡초를 뽑아낸다.
	<<elseif $avery_mansion.garden is 2>>
		당신은 정원의 잡초를 뿌리째 뽑아낸다.
	<<elseif $avery_mansion.garden is 1>>
		당신은 에이버리의 취향에 맞게 정원수를 다듬는다.
	<</if>>
	<<avery_housework_change "garden" -1>>
	<<pass _tending_time>>

	<<if $avery_mansion.schedule is "garden" and !$daily.avery.housekeeping_events.garden>>
		<<set _event_triggered to true>>
		<<set $daily.avery.housekeeping_events.garden to true>>
		<<npc "Avery">><<person1>>
		<br><br>

		에이버리는 정원을 어슬렁거리며 잎사귀 하나하나를 천천히 다듬고, 궂은일은 당신에게 맡긴다. "이건 아주 아름답군," 호랑가시나무 덤불을 가리키며 <<he>>【이가】 말한다.
		<br><br>
		에이버리는 <<his>> 전지가위로 섬세하게 다듬고, 자주 뒤로 물러나 자신의 솜씨에 감탄한다.
		<<if currentSkillValue('tending') gte 600>>
			<span class="green">당신은 저것보단 더 잘할 수 있을 거라 생각한다.</span> 하지만 속으로만 생각하는 것이 현명할 것이다.
			<br><br>
			<<link [[에이버리를 가르쳐 준다|Mansion Housework Garden Teach]]>><</link>>
			<br>
		<<else>>
			<span class="red">에이버리는 자신이 뭘 하고 있는지 잘 알고 있는 듯하다.</span>
			<br><br>
		<</if>>
		<<link [[칭찬한다|Mansion Housework Garden Compliment]]>><</link>>
		<br>
		<<link [[무시한다|Mansion Housework Garden Ignore]]>><</link>>
	<</if>>
	<br>
<</widget>>

<<widget "avery_mansion_clean_pool">>
	<<if $avery_mansion.schedule is "pool" and $daily.avery.housekeeping_events.pool>>
		에이버리가 여전히 수영장을 쓰고 있다. 당신은 <<nnpc_him "Avery">>【을를】 그대로 내버려 두기로 한다.
	<<elseif $avery_mansion.schedule is "pool" and !$daily.avery.housekeeping_events.pool>>
		<<set _event_triggered to true>>
		<<set $daily.avery.housekeeping_events.pool to true>>
		<<npc "Avery">><<person1>>
		<br>
		당신은 수영장으로 향해 잡일을 시작한다. 에이버리가 <span class="lewd">아무것도 걸치지 않은 채</span> 당당하게 걸어 나온다.
		<<if Weather.temperature <= 10>>
			추위는 <<him>>【을를】 전혀 괴롭히지 않는 듯하다.
		<</if>>
		<<He>>【이가】 수경을 쓰고 안으로 다이빙하자, 일렁이는 물결이 당신 쪽으로 밀려온다.
		<br><br>

		<<He>>【이가】 수면 위로 올라오더니, 수영장 끝에서 끝으로 헤엄치기 시작한다.
		<br><br>

		<<link [[불평 없이 에이버리 주변에서 일한다|Mansion Housework Pool Work]]>><<stress 6>><</link>><<gstress>>
		<br>
		<<link [[에이버리에게 청소가 끝날 때까지 기다리라고 말한다|Mansion Housework Pool Tell]]>><<npcincr Avery rage 1>><</link>><<garage>>
		<br>
		<<link [[지금은 청소를 그만둔다|Mansion Pool]]>><<avery_housework_change "pool" 1>><<endevent>><</link>>
	<<else>>
		<<if $avery_mansion.pool gte 4>>
			당신은 호스를 풀고, 진공청소기로 수영장의 조류를 빨아들여 치운다.
		<<elseif $avery_mansion.pool is 3>>
			당신은 근처 창고에서 염소를 꺼내와 수영장에 넉넉히 푼다.
		<<elseif $avery_mansion.pool is 2>>
			당신은 뜰채로 수영장에 떠다니는 벌레들을 건져낸다.
		<<elseif $avery_mansion.pool is 1>>
			당신은 뜰채로 수영장에 떠다니는 벌레들을 건져내, 아주 깨끗하게 만든다.
		<</if>>
		<<avery_housework_change "pool" -1>>
		<<pass _housekeeping_time>>
	<</if>>
	<br>
<</widget>>

<<widget "summon_brown_fox">>
	<<set $_slot to _args[0] || 1>>
	<<set $_npc to clone(C.npc[$NPCNameList[7]])>>
	<<npc $NPCNameList[7] $_slot>>
<</widget>>

<<widget "say_brown_fox">><<silently>>
	<<if $brownFoxRevealed>>
		<<set $_brown_fox to "그윌란">>
	<<else>>
		<<set $_brown_fox to "갈색 여우">>
	<</if>>
<</silently>><<print $_brown_fox>><</widget>>

<<widget "avery_mansion_rage_party">>
	<<if $avery_mansion.party_state is "missed">>
		<<set $avery_mansion.party_state to "waiting">>
		<<set $averypartymiss to 1>>
		<<set $_dialog_type to _args[0]>>
		<<switch $_dialog_type>>
			<<case "normal">>
				"일요일에 네가 보고 싶었어. 파티에서 말이야.
			<<case "chase">>
				"그 빌어먹을 파티에 네가 빠졌잖아.
			<<case "revealed">>
				"파티에 안 왔더군," <<he>>【이가】 말한다.
			<<case "revealed chase">>
				"파티에 오지 않았더군.
		<</switch>>
		/* Reaction on the guest you missed (and scheduling Bailey again if the missed guest was Bailey) */
		<<switch $avery_mansion.party_missed_guest>>
			<<case "Bailey">>
				<<switch $_dialog_type>>
					<<case "normal">>
						우리 모두가 그랬어. 특히 베일리가 말이지. 네가 나타나지 않자 <<nnpc_He "Bailey">>【은는】 나가버렸어, <span class="gold">하지만 <<this_sunday>>에 다시 오기로 동의했어.</span> 두 번 다시 빠지지 마. 넌 날 바보로 만들었어."
					<<case "chase">>
						손님들은 다 도착했는데, 넌 코빼기도 안 보였지. 베일리는 네가 없다는 걸 알자마자 나가버렸어. <<nnpc_Hes "Bailey">> <span class="gold"><<this_sunday>>에 다시 오기로 동의했지.</span> 다시는 망신 주지 마."
					<<case "revealed">>
						"베일리가 그 자리에 있었어. 네가 안 나타나니까 <<nnpc_He "Bailey">>【은는】 가버렸지만, <span class="gold"><<this_sunday>>에 다시 오기로 동의했어.</span> 또다시 내게 굴욕감을 주지 마."
					<<case "revealed chase">>
						손님들이 왔는데 네가 없었을 때 내가 얼마나 굴욕적이었을지 상상해 봐. 베일리는 씨발 아무 말도 없이 휙 나가버렸어. <<nnpc_He "Bailey">>【은는】 <span class="gold"><<this_sunday>>에 다시 오기로 동의했어.</span> 반드시 그 자리에 있는 게 좋을 거야."
				<</switch>>
			<<case "Quinn">>
				<<switch $_dialog_type>>
					<<case "normal">>
						시장이 네 안부를 묻더군. 널 자랑하기에 딱 좋았을 텐데.
					<<case "chase">>
						시장은 내 등 뒤에서 네가 다른 사람들과 떡치고 다닐 거라는 농담이나 지껄이며 저녁 내내 시간을 보냈지. 그렇게 굴욕적인 적은 없었어.
					<<case "revealed">>
						"시장은 다루기 힘들더군. 네가 바람을 피우고 있을 거라 넌지시 비꼬는 농담을 계속해댔지.
					<<case "revealed chase">>
						그 멍청한 시장은 저녁 내내 네가 밖에서 딴 놈이랑 뒹굴고 있을 거라 암시하는 농담이나 지껄이더군.
				<</switch>>
			<<case "Remy">>
				<<switch $_dialog_type>>
					<<case "normal">>
						레미와 함께하는 시간도 즐겁긴 하지만, 네 부재가 분위기를 망쳤어.
					<<case "chase">>
						레미는 널 기대하고 있었지. 난 변명을 늘어놓아야만 했어. 모두가 내 말이 거짓말이라는 걸 알고 있었고 말이야.
					<<case "revealed">>
						"레미에게 네가 참석하지 않는 이유를 설명해야 했지. 썩 유쾌한 일은 아니었어.
					<<case "revealed chase">>
						알아둘 가치가 있는 주변의 몇 안 되는 사람들 앞에서 널 위해 굴욕적인 변명을 해야만 했다고.
				<</switch>>
			<<case "Briar">>
				<<switch $_dialog_type>>
					<<case "normal">>
						브라이어는 내 취향에는 좀 상스럽더군. <<nnpc_Hes "Briar">> 너처럼 거친 과거를 가졌으니, 네가 함께 있었더라면 좋았을 텐데.
					<<case "chase">>
						브라이어 같은 하류층 버러지를 나 혼자 상대해야 했어. 그 녀석들과 공감하는 척이라도 하려면 네가 필요했다고.
					<<case "revealed">>
						"브라이어가 개인적으로 네 안부를 묻더군. 변명을 하긴 했지만, 난 그렇게 천박한 자에게 질문받는 건 질색이야.
					<<case "revealed chase">>
						그 설치류 같은 브라이어를 나 혼자 감당해야 했지. <<nnpc_He Briar>>【은는】 뻔뻔하게도 내게 추파를 던지려 들더군.
				<</switch>>
			<<case "Harper">>
				<<switch $_dialog_type>>
					<<case "normal">>
						하퍼 의사가 네 안부를 묻더군. 네가 그 자리에 없어서 참 아쉬웠지.
					<<case "chase">>
						그 의사는 널 기대하고 있었어. 난 변명을 늘어놓아야 했고, 하퍼가 날 쳐다볼 때 내가 뭘 봤는지 아나? 동정이었어.
					<<case "revealed">>
						"의사가 네 안부를 묻기에, 나는 <<nnpc_him Harper>>에게 설득력 없는 대답을 할 수밖에 없었지.
					<<case "revealed chase">>
						그 의사는 널 기대하다가, 네가 나타나지 않자 실망하더군.
				<</switch>>
			<<case "Jordan">>
				<<switch $_dialog_type>>
					<<case "normal">>
						조던은 혼자가 아니었고, 그자들은 꽤 다루기 힘들더군.
					<<case "chase">>
						그 미치광이들과 단둘이 남겨진 기분이 어땠는지 알아? 조던과 그 일행들 말이야.
					<<case "revealed">>
						"조던이 늘 몰려다니는 수행원들을 데려왔는데, 그놈들은 언제나처럼 골칫거리였어.
					<<case "revealed chase">>
						그 종교에 미친 놈들을 나 혼자 상대해야 했다고.
				<</switch>>
		<</switch>>
		/* Announcing next guest (if not bailey) */
		<<switch $avery_mansion.guest>>
			<<case "Quinn">>
				<<switch $_dialog_type>>
					<<case "normal">>
						<<if random(0,1)>>
							<span class="gold"><<this_sunday>>에 시장이 올 거다.</span> 꼭 참석하도록 해. <<nnpc_He "Quinn">>도 꽤 다루기 힘든 부류니까."
						<<else>>
							<span class="gold">시장은 다음 주에 참석할 거다.</span> 분명히 <<nnpc_he Quinn>>도 네 안부를 물어볼 테지. 꼭 참석하도록 해."
						<</if>>
					<<case "chase">>
						<span class="gold"><<this_sunday>>에 시장이 올 거다.</span>
						<<if random(0,1)>>
							"반드시 기어나오는 게 좋을 거다."
						<<else>>
							"다시는 내게 굴욕을 주지 마."
						<</if>>
					<<case "revealed">>
						<span class="gold">시장이 <<this_sunday>>에 참석할 거다.</span> 날 또 우습게 만들지 마. 꼭 와."
					<<case "revealed chase">>
						<<if random(0,1)>>
							<span class="gold">시장이 <<this_sunday>>에 이곳에 올 거다.</span> 감히 날 <<nnpc_him Quinn>>【와과】 단둘이 남겨둘 생각일랑 마."
						<<else>>
							<span class="gold">시장이 <<this_sunday>>에 참석할 거다. 감히 날 <<nnpc_him Quinn>>【와과】 단둘이 남겨둘 생각일랑 마."</span>
						<</if>>
				<</switch>>
			<<case "Remy">>
				<<switch $_dialog_type>>
					<<case "normal">>
						<span class="gold">농부 레미가 <<this_sunday>>에 참석할 거다.</span> 내 친구지. 네가 올 수 있기를 바라."
					<<case "chase">>
						<span class="gold">농부 레미가 <<this_sunday>>에 올 거다.</span> 또 나를 망신시킨다면, 후회하게 될 거다."
					<<case "revealed">>
						<span class="gold">농부 레미가 <<this_sunday>>에 참석할 거다.</span> 다시는 나를 이런 난처한 상황에 빠뜨리지 마."
					<<case "revealed chase">>
						<span class="gold">농부 레미가 <<this_sunday>>에 참석할 거다.</span> 꼭 와. 다시 날 모욕했다간 가만두지 않겠다."
				<</switch>>
			<<case "Briar">>
				<<switch $_dialog_type>>
					<<case "normal">>
						<span class="gold">이 지역의 사업가인 브라이어가 <<this_sunday>>에 참석할 거다.</span> 꼭 오도록 해."
					<<case "chase">>
						<span class="gold"><<this_sunday>>에 그 뚜쟁이 놈, 브라이어 앞에 나타나지 않는다면,</span> 후회하게 될 거다."
					<<case "revealed">>
						<span class="gold">이 지역의 사업가인 브라이어가 <<this_sunday>>에 참석할 거다.</span> 날 바보로 만들지 마. 참석해라."
					<<case "revealed chase">>
						<span class="gold">그 지역의 뚜쟁이, 브라이어가 <<this_sunday>>에 참석할 거다.</span> 네 상스러운 수준에 더 잘 맞을 테니, 잊지 말고 꼭 참석해."
				<</switch>>
			<<case "Harper">>
				<<switch $_dialog_type>>
					<<case "normal">>
						<span class="gold">이 지역의 의사인 <<nnpc_hes "Harper">>【이가】 다음 주에 참석할 거다.</span> 지역 사회의 기둥치고는 무척 젊은 편이지. 꼭 오도록 해."
					<<case "chase">>
						<span class="gold">의사 하퍼가 <<this_sunday>>에 올 거다.</span> 나타나지 않으면 후회할 줄 알아."
					<<case "revealed">>
						<span class="gold">의사 하퍼가 <<this_sunday>>에 참석할 거다.</span> 꽤 중요한 인물이고, 나는 또다시 네 안부에 대해 추궁당하는 건 피하고 싶군. 반드시 오도록 해."
					<<case "revealed chase">>
					<span class="gold">의사 하퍼가 <<this_sunday>>에 참석할 거다.</span> 씨발 잊지 말고 쳐 기어나와."
				<</switch>>
			<<case "Jordan">>
				<<switch $_dialog_type>>
					<<case "normal">>
						<span class="gold">조던이 다음 주에 참석할 거다.</span> 필시 무리를 잔뜩 대동하고 올 테지. 나 혼자서 그들을 상대하는 일은 없었으면 좋겠군."
					<<case "chase">>
						<span class="gold">조던이 <<this_sunday>>에 올 거다.</span> 혼자는 아니겠지. 난 네가 그곳에 필요하고, 네 신상에 이로울 길을 안다면 꼭 참석해라."
					<<case "revealed">>
						<span class="gold">조던이 <<this_sunday>>에 참석할 거다.</span> 날 <<nnpc_his "Jordan">> 무리와 단둘이 남겨두지 마."
					<<case "revealed chase">>
						<span class="gold">조던이 <<this_sunday>>에 참석할 거다.</span> 반드시 오도록 해."
				<</switch>>
		<</switch>>
		<<if $avery_tower.stage lte 2>>
			<<avery_mansion_tower_negative_effects $avery_mansion.party_missed_guest>>
		<</if>>
		<<ggarage>><<lllove>><<npcincr Avery love -3>><<npcincr Avery rage 3>>
		<br><br>
	<</if>>
<</widget>>

<<widget "avery_mansion_skyscraper_calc">>
	<<set _tower_progress to 5>>
	<<if $avery_tower.effects.includes("temple")>>
		<<set _tower_progress -= 5>>
	<</if>>
	<<if $avery_tower.effects.includes("theft")>>
		<<set _tower_progress -= 5>>
	<</if>>
	<<if $avery_tower.effects.includes("mayor")>>
		<<set _tower_progress += 5>>
	<</if>>
	<<if $avery_tower.effects.includes("Remy")>>
		<<set _tower_progress += 5>>
	<</if>>
	<<if $avery_tower.effects.includes("Harper")>>
		<<set _tower_progress += 5>>
	<</if>>
<</widget>>

<<widget "avery_mansion_skyscraper_week_estimate">>
	<<avery_mansion_skyscraper_calc>>

	<<set _weeks_remaining to Math.round((100 - $avery_tower.progress) / _tower_progress)>>

	<<if _weeks_remaining lte 0>>
		거의 완성된 참이다.
	<<elseif _weeks_remaining is 1>>
		이대로라면, 대략 1주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 2>>
		이대로라면, 대략 2주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 3>>
		이대로라면, 대략 3주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 4>>
		이대로라면, 대략 4주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 5>>
		이대로라면, 대략 5주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 6>>
		이대로라면, 대략 6주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 7>>
		이대로라면, 대략 7주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 8>>
		이대로라면, 대략 8주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 9>>
		이대로라면, 대략 9주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 10>>
		이대로라면, 대략 10주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 11>>
		이대로라면, 대략 11주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 12>>
		이대로라면, 대략 12주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 13>>
		이대로라면, 대략 13주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 14>>
		이대로라면, 대략 14주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 15>>
		이대로라면, 대략 15주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 16>>
		이대로라면, 대략 16주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 17>>
		이대로라면, 대략 17주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 18>>
		이대로라면, 대략 18주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 19>>
		이대로라면, 대략 19주 후면 완성될 것이다.
	<<elseif _weeks_remaining is 20>>
		이대로라면, 대략 20주 후면 완성될 것이다.
	<<else>>
		<<if $avery_tower.progress gte 76>>
			진척이 정체되어 있다. 현재로서는 말이다.
		<<else>>
			아직 갈 길이 멀다.
		<</if>>
	<</if>>
<</widget>>

<<widget "avery_mansion_location_tracker">>
	<<avery_mansion_interrupt>>
	<<if _avery_interrupt is undefined>>
		<<switch $avery_mansion.schedule>>
			<<case "sleep">>
				<<if $bus isnot "avery_bedroom">>
					<<switch $bus>>
						<<case "avery_bathroom" "avery_study">>
							에이버리는 침대에서 자고 있다.
						<<case "avery_lounge" "avery_dining" "avery_display" "avery_garage">>
							에이버리는 위층에서 자고 있다.
						<<case "avery_garden" "avery_pool">>
							에이버리는 안에서 자고 있다.
						<<default>>
					<</switch>>
					<br><br>
				<</if>>
			<<case "bath">>
				<<if $bus isnot "avery_bathroom" and $daily.avery.morning_bath isnot "dressing">>
					<<switch $bus>>
						<<case "avery_bedroom">>
							욕실에서 물이 튀는 소리가 들린다. 에이버리가 목욕 중인 모양이다.
						<<case "avery_study" "avery_garage">>
							물이 흐르는 소리가 들린다. 에이버리가 목욕 중인 모양이다.
						<<case "avery_lounge" "avery_dining" "avery_display">>
							위층에서 움직이는 소리가 들린다. 에이버리가 깨어 있는 모양이다.
						<<case "avery_garden" "avery_pool">>
							위로 시선을 올리자 욕실 창문으로 누군가 움직이는 모습이 보인다.
						<<default>>
					<</switch>>
					<br><br>
				<</if>>
			<<case "breakfast">>
				<<if $bus isnot "avery_dining">>
					<<switch $bus>>
						<<case "avery_bedroom" "avery_bathroom" "avery_study">>
							주변에 에이버리가 안 보인다. <<nnpc_He "Avery">>【은는】 아래층에 있을 것이다.
						<<case "avery_lounge" "avery_display">>
							식당에서 에이버리의 목소리가 들린다. <<nnpc_He "Avery">>【은는】 아침 식사를 하고 있는 게 틀림없다.
						<<case "avery_garage">>
							차고 안은 조용하다.
						<<case "avery_pool" "avery_garden">>
							주변에 에이버리가 안 보인다. <<nnpc_He "Avery">>【은는】 집 안에 있을 것이다.
						<<default>>
					<</switch>>
					<br><br>
				<</if>>
			<<case "dinner">>
				<<set _dinnerDate to $avery_valentines?.ready and Time.monthDay is 14 and Time.monthName is "February">>
				<<if Time.weekDay isnot 1 and !_dinnerDate>>
					<<if $bus isnot "avery_dining">>
						<<switch $bus>>
							<<case "avery_bedroom" "avery_bathroom" "avery_study">>
								에이버리가 아래층에서 저녁 식사를 기다리고 있다.
							<<case "avery_lounge" "avery_display" "avery_garage">>
								에이버리가 저녁 식사를 기다리고 있다.
							<<case "avery_garden" "avery_pool">>
								에이버리가 안에서 저녁 식사를 기다리고 있다.
							<<default>>
						<</switch>>
						<br><br>
					<</if>>
				<</if>>
			<<case "study">>
				<<if $bus isnot "avery_study">>
					<<switch $bus>>
						<<case "avery_bedroom" "avery_bathroom">>
							서재에서 에이버리가 움직이는 소리가 들린다.
						<<case "avery_lounge" "avery_display">>
							위층에서 움직이는 소리가 들린다. 에이버리는 <<nnpc_his "Avery">> 서재에 있을지도 모른다.
						<<case "avery_dining">>
							주변에 에이버리가 안 보인다. <<nnpc_He "Avery">>【은는】 위층에 있을지도 모른다.
						<<case "avery_garage">>
							차고 안은 조용하다.
						<<case "avery_garden" "avery_pool">>
							주변에 에이버리가 안 보인다. <<nnpc_He "Avery">>【은는】 집 안에 있을 것이다.
						<<default>>
					<</switch>>
					<br><br>
				<</if>>
			<<case "pool">>
				<<if $bus isnot "avery_pool">>
					<<switch $bus>>
						<<case "avery_bedroom" "avery_bathroom" "avery_lounge" "avery_display">>
							창밖을 내다보니 에이버리가 
							<<if $avery_pool is "coffee">>
								수영장 옆에서 커피를 마시고 있는 모습이 보인다.
							<<elseif $avery_pool is "sunbathe">>
								수영장 옆에서 일광욕을 즐기고 있는 모습이 보인다.
							<<else>>
								수영장에서 수영을 하고 있는 모습이 보인다.
							<</if>>
						<<case "avery_study">>
							주변에 에이버리가 안 보인다. <<nnpc_He "Avery">>【은는】 아래층에 있을 것이다.
						<<case "avery_dining">>
							주변에 에이버리가 안 보인다. <<nnpc_He "Avery">>【은는】 밖에 있을지도 모른다.
						<<case "avery_garage">>
							<<if $avery_pool is "swim">>
								물이 튀는 소리가 들린다. 에이버리가 밖에서 수영을 하고 있는 게 분명하다.
							<<else>>
								차고 안은 조용하다.
							<</if>>
						<<case "avery_garden">>
							에이버리가 
							<<if $avery_pool is "coffee">>
								수영장 옆에서 커피를 마시고 있는 모습이 보인다.
							<<elseif $avery_pool is "sunbathe">>
								수영장 옆에서 일광욕을 즐기고 있는 모습이 보인다.
							<<else>>
								수영장에서 수영을 하고 있는 모습이 보인다.
							<</if>>
						<<default>>
					<</switch>>
					<br><br>
				<</if>>
			<<case "garden">>
				<<if $bus isnot "avery_garden">>
					<<switch $bus>>
						<<case "avery_bedroom" "avery_bathroom" "avery_lounge" "avery_display">>
							창밖을 슬쩍 보니 정원에 있는 에이버리가 보인다.
						<<case "avery_study">>
							주변에 에이버리가 안 보인다. <<nnpc_He "Avery">>【은는】 아래층에 있을 것이다.
						<<case "avery_dining">>
							주변에 에이버리가 안 보인다. <<nnpc_He "Avery">>【은는】 밖에 있을지도 모른다.
						<<case "avery_garage">>
							밖에서 가위질하는 소리가 들린다. 에이버리가 정원에 있는 게 틀림없다.
						<<case "avery_pool">>
							에이버리가 <<nnpc_his "Avery">> 정원에서 열심히 일하고 있는 모습이 보인다.
						<<default>>
					<</switch>>
					<br><br>
				<</if>>
			<<case "lounge">>
				<<if $bus isnot "avery_lounge">>
					<<switch $bus>>
						<<case "avery_bedroom" "avery_bathroom" "avery_study">>
							아래층에서 에이버리가 텔레비전을 보는 웅얼거리는 소리가 들린다.
						<<case "avery_dining" "avery_display">>
							거실에서 에이버리가 텔레비전을 보는 소리가 들린다.
						<<case "avery_garage">>
							집 안에서 에이버리가 텔레비전을 보는 웅얼거리는 소리가 들린다.
						<<case "avery_garden" "avery_pool">>
							거실 창문을 통해 에이버리가 텔레비전을 보고 있는 모습이 보인다.
						<<default>>
					<</switch>>
					<br><br>
				<</if>>
			<<case "drink">>
				<<if $bus isnot "avery_lounge">>
					<<switch $bus>>
						<<case "avery_bedroom" "avery_bathroom" "avery_study">>
							주변에 에이버리가 안 보인다. <<nnpc_He "Avery">>【은는】 아래층에 있을 것이다.
						<<case "avery_dining" "avery_display">>
							거실에서 유리가 부딪히는 소리가 쨍그랑 들린다.
						<<case "avery_garage">>
							차고 안은 조용하다.
						<<case "avery_garden" "avery_pool">>
							거실 창문을 통해 에이버리가 술을 마시는 모습이 보인다.
						<<default>>
					<</switch>>
					<br><br>
				<</if>>
			<<case "date">>
				<<if $bus isnot "avery_garage">>
					에이버리는 데이트를 위해 차고에서 기다리고 있다.
					<br><br>
				<</if>>
			<<case "work">>
				저택 안은 고요하다. 에이버리가 일하고 있는 게 분명하다.
				<br><br>
			<<case "party_prepare">>
				<<if $bus isnot "avery_dining">>
					에이버리가 오늘 저녁 파티를 준비하는 소리가 들린다.
					<br><br>
				<</if>>
			<<case "away">>
				<<if $avery_injury>>
					저택 안은 고요하다. 에이버리는 여전히 병원에서 치료를 받고 있다.
				<<else>>
					저택 안은 고요하다. 에이버리는 아직 돌아오지 않았다.
				<</if>>
				<br><br>
			<<default>>
		<</switch>>
	<</if>>
<</widget>>

<<widget "avery_injury_check">>
	<<set _avery_injured to ["sling", "cast", "healing"].includes($avery_mansion?.injury_stage)>>
	<<set _avery_injured_sling to $avery_mansion?.injury_stage is "sling">>
<</widget>>

<<widget "avery_valentines_init">>
	<<set $avery_valentines to {}>>

	<<set $avery_valentines.intro to false>>
	<<set $avery_valentines.invite to false>>
	<<set $avery_valentines.ready to false>>
	<<set $avery_valentines.done to false>>
	<<set $avery_valentines.reservation to false>>
	<<set $avery_valentines.chocolate to false>>
	<<set $avery_valentines.chocolate_asked to false>>
	<<set $avery_valentines.opinion to "none">>
	<<set $avery_valentines.confess to false>>
	<<set $avery_valentines.food to "none">>
	<<set $avery_valentines.soften to false>>
	<<set $avery_valentines.talk to false>>
	<<set $avery_valentines.talk_count to 0>>
	<<set $avery_valentines.sex to "none">>
	<<set $avery_valentines.end to "none">>
	<<set $avery_valentines.end_talk to false>>
	<<set $avery_valentines.missed_approach to false>>
<</widget>>

<<widget "avery_valentines_end">>
	<<unset $avery_valentines_anal_virginity>>
	<<unset $avery_valentines_virginity>>
	<<unset $avery_valentines_steal_virginity>>
	<<unset $avery_valentines_vow>>
	<<unset $speechfallentransform>>

	<<if $avery_mansion and Time.monthName is "February" and Time.monthDay is 14>>
		<<set $avery_mansion.rage.dinner_done to 1>>
	<</if>>
<</widget>>

<<widget "avery_mansion_morning_change">>
<<set $daily.avery.morning_bath to "dressing">>
<<set $daily.avery.morning_change to true>>
<<He>>【이가】 당신을 바라본다,
<<if $rng gte 76 and C.npc.Avery.dom gte 40>>
	그리고 묻는다. "너 안 바쁘지? 나 좀 따라와요." <<He>>【은는】 <<his>> 옷장을 향해 고갯짓을 한다.
	<<if $avery_mansion.morning_change_count gte 1>>
		<<he>>【은는】 당신이 다시 오늘 하루 입을 옷을 챙겨주길 바라는 눈치다.
	<<else>>
		"옷 입는 것 좀 도와줘요."
	<</if>>
	<br><br>
	<<link [[요구대로 한다 (0:15)|Mansion Bedroom Avery Dress]]>><<set $phase to 1>><<npcincr Avery dom 1>><<pass 15>><</link>><<gdom>>
	<br>
	<<link [[거절한다|Mansion Bedroom Avery Dress Refuse]]>><<set $phase to 2>><<npcincr Avery dom -1>><</link>><<ldom>>
	<br>
<<else>>
	고개를 끄덕이더니 <<his>> 침실로 향한다. <<his>> 옷장 문이 열리는 소리가 들린다.
	<br><br>

	<<link [[다음|Mansion Bathroom]]>><<clotheson>><<endevent>><</link>>
	<br><br>
<</if>>
<</widget>>
