							<<addinlineevent "avery_breakfast_table" 1>>
								<<set _hide_links to 1>>
								<<set _avery_breakfast_event to "table">>
							<</addinlineevent>>

							<<addinlineevent "avery_breakfast_no_event_2" 1>>

							<</addinlineevent>>
						<<runeventpool>>
					<</if>>
					<<endevent>>
					<<npc "Avery">><<person1>>
					<<if _avery_breakfast_event is "bite" and C.npc.Avery.love gte 60 and C.npc.Avery.rage lt 20>>
						에이버리가 당신이 쳐다보는 것을 눈치챈다. "배고파요?" <<He>>【이가】 한 숟가락을 듬뿍 뜬다. "한 입 먹을래요?"
						<br><br>
						<<link [[예|Mansion Breakfast Avery Bite]]>><<set $phase to 1>><</link>>
						<br>
						<<link [[아니오|Mansion Breakfast Avery Bite]]>><<set $phase to 2>><</link>>
						<br>
					<<elseif _avery_breakfast_event is "coffee">>
						식당에 들어서자 에이버리가 물었다. "<<= $averyragerevealed and C.npc.Avery.rage gte 20 ? "커피 좀 타와요" : "커피 좀 타주겠어요">>?<<if $averySeen.includes("lewd_coffee")>> 아까처럼 똑같이 말이죠,<</if>>" <<He>>【은는】 피곤한 기색이다.
						<br><br>
						<<link [[에이버리에게 커피를 타준다 (0:05)|Mansion Breakfast Avery Coffee]]>><</link>>
						<br>
						<<link [[거절한다|Mansion Breakfast Avery Coffee Refuse]]>><</link>><<llove>>
						<br>
					<<elseif _avery_breakfast_event is "table">>
						식당에 들어서자 에이버리가 아침 식사를 위해 식탁을 차리고 있는 모습이 보인다.
						<br><br>
						<<link [[<<him>>【을를】 돕는다|Mansion Breakfast Avery Table]]>><<set $phase to 0>><</link>>
						<br>
						<<link [[<<him>>【을를】 내버려 둔다|Mansion Breakfast Avery Table End]]>><<set $phase to 1>><</link>>
						<br>
					<<else>>
						<<unset _hide_links>>
						<<if C.npc.Avery.rage gte 80>>
							에이버리는 아침 식사는 까맣게 잊은 채 휴대폰을 들여다보며 씩씩거린다.
						<<elseif C.npc.Avery.rage gte 60>>
							에이버리는 아침을 먹는 둥 마는 둥 휴대폰만 스크롤한다.
						<<elseif C.npc.Avery.rage gte 40>>
							에이버리는 한 손으로 휴대폰 뉴스를 읽고, 다른 한 손으론 식사를 하고 있다.
						<<elseif C.npc.Avery.rage gte 20>>
							에이버리는 식사를 하고 있지만, 너무 딴 데 정신이 팔려 있어 즐기는 것 같지 않다.
						<<else>>
							에이버리는 한 입씩 음미하며 식사하고 있다.
						<</if>>
						<<endevent>>
						<br><br>
						<<socialiseicon>><<link [[에이버리와 이야기한다|Mansion Talk]]>><</link>>
						<br><br>
					<</if>>

				<<elseif $avery_mansion.schedule is "party_prepare">>
					<<npc "Avery">><<person1>>
					<<if Time.weekDay is 1>>
						<<if C.npc.Avery.rage gte 80>>
							하인들이 무시무시한 에이버리의 눈초리를 피하려 종종걸음 친다.
						<<elseif C.npc.Avery.rage gte 60>>
							하인들이 에이버리의 분노가 두려워 식탁을 세팅한다.
						<<elseif C.npc.Avery.rage gte 40>>
							에이버리는 손님들을 위한 테이블을 준비하는 하인들에게 호통을 친다.
						<<elseif C.npc.Avery.rage gte 20>>
							에이버리가 하인들에게 손님 맞을 준비를 시킨다.
						<<else>>
							에이버리는 하인들에게 지시하여 손님상 준비를 돕는다.
						<</if>>
						<<endevent>>
						<br><br>
						<<socialiseicon>><<link [[에이버리와 이야기한다|Mansion Talk]]>><</link>>
						<br><br>
					<</if>>
				<<elseif $avery_mansion.schedule is "dinner">>
					<<npc "Avery">><<person1>>
					<<set _dinnerDate to $avery_valentines?.ready and Time.monthDay is 14 and Time.monthName is "February">>
					<<if Time.weekDay isnot 1 and !_dinnerDate>>
						<<if C.npc.Avery.rage gte 80>>
							에이버리는 테이블에 앉아 당신을 지켜본다.
						<<elseif C.npc.Avery.rage gte 60>>
							에이버리는 테이블에 앉아 손가락으로 두드리며 저녁 식사를 기다린다.
						<<elseif C.npc.Avery.rage gte 40>>
							에이버리는 저녁을 기다리며, 테이블에 앉아 스마트폰을 넘기고 있다.
						<<elseif C.npc.Avery.rage gte 20>>
							에이버리는 식탁에 앉아, 식사를 기다리며 스마트폰을 보고 있다.
						<<else>>
							에이버리는 저녁이 나오길 기다리며, 테이블에 앉아 있다.
						<</if>>
						<<endevent>>
						<br>
						<<if canGiftFood("Avery")>>
							<<skinicon "waiter">><<link [[에이버리에게 저녁 식사를 대접한다|Avery Gifts Dinner List]]>><</link>>
						<<else>>
							<<skinicon "waiter">><span class="red">에이버리에게 먹일 아무것도 준비하지 않았다.</span>
						<</if>>
						<br><br>
					<</if>>
				<</if>>

			<</if>>

			<<if $bus is "avery_garage">>
				<<if $avery_valentines and $avery_valentines.ready and !$avery_valentines.done and Time.monthDay is 14>>
					<<icon "avery-car.png">><<link [[발렌타인 데이트|Avery Valentines]]>><<endevent>><</link>>
					<br><br>
				<<elseif $avery_mansion.date_ready is true and Time.hour lte 21 and $averydatedone isnot 1>>
					<<icon "avery-car.png">><<link [[데이트 (1:20)|Avery Date]]>><<endevent>><</link>>
					<br><br>
				<</if>>
			<</if>>

			<<if $bus is "avery_garden">>
				<<if !_avery_interrupt and $avery_mansion.schedule isnot "garden" and !$daily.avery.oranges>>
					<<set $skulduggerydifficulty to 500>>
					<<foodstufficon "orange">> <<link [[오렌지를 훔친다 (0:20)|Avery Garden Steal]]>><<pass 20>><</link>><<tendingdifficulty 1 300>><<skulduggerydifficulty>>
					<br><br>
				<</if>>
				<<if $avery_mansion.schedule is "garden">>
					<<npc "Avery">><<person1>>
					<<if C.npc.Avery.rage gte 80>>
						에이버리는 거칠게 정원수를 손질한다. 가지를 마구 잘라낸다.
					<<elseif C.npc.Avery.rage gte 60>>
						에이버리가 즐거운 듯이 정원수를 자르고 있다.
					<<elseif C.npc.Avery.rage gte 40>>
						에이버리는 손가락으로 수풀 잎사귀들을 잡아뜯는다.
					<<elseif C.npc.Avery.rage gte 20>>
						에이버리는 기계적인 집중력으로 장식수를 다듬는다.
					<<else>>
						에이버리가 신중하게 조경수들을 쳐내고 있다.
					<</if>>
					<<endevent>>
					<br><br>
					<<socialiseicon>><<link [[에이버리와 이야기한다|Mansion Talk]]>><</link>>
					<br><br>
				<<elseif $avery_mansion.fox.task is "heist" and ($avery_mansion.schedule is "away" or $avery_mansion.schedule is "sleep" or $avery_mansion.schedule is "work") and !$avery_fate and $auriga_artefact is "Avery">>
					<<if !isGwylanAbsent()>>
						<<birdicon "sing">><<link [[<<say_brown_fox>>에게 신호를 휘파람으로 분다|Mansion Fox Heist]]>><<endevent>><<pass 10>><</link>>
						<br><br>
					<</if>>
				<</if>>
			<</if>>

			<<if $avery_mansion.schedule isnot "away" and $avery_mansion.schedule isnot "work">>
				<<set $_avery_present to true>>
			<</if>>
			<<if $bus is "avery_study">>
				<<if $avery_mansion.schedule is "study" and !$avery_mansion.study_unlocked>>
					<<npc "Avery">><<person1>>
					문이 열리고 에이버리가 서재로 들어온다. 어둠 속에 있는 당신을 눈치채지 못한다. 당신은 밖으로 살짝 빠져나온다.
					<br><br>
					<<endevent>>
				<<elseif $avery_mansion.study_unlocked is 1 and Time.hour is 23 and $_avery_present>>
					<<npc "Avery">><<person1>>
					문이 열리고 에이버리가 서재에 들어온다. "오늘 밤은 서재 문을 잠가야겠어," <<he>>【이가】 말한다. "내일 아침에 다시 읽도록 해."
					<br><br>
					당신이 나가자, <<he>>【이가】 찰칵 소리를 내며 문을 잠그고 돌아선다.
					<br><br>
					<<endevent>>
					<<set $avery_mansion.study_unlocked to 0>>
				<<else>>
					<<if $avery_mansion.schedule is "study">>
						<<set _extralinebreak to true>>
						<<npc "Avery">><<person1>>
						<<if C.npc.Avery.rage gte 80>>
							에이버리는 방을 서성거린다.
						<<elseif C.npc.Avery.rage gte 60>>
							에이버리는 서가에 선 채로 무언가를 찾고 있다.
						<<elseif C.npc.Avery.rage gte 40>>
							에이버리는 책상에서 책을 읽고 있지만, 자꾸 책을 바꾼다.
						<<elseif C.npc.Avery.rage gte 20>>
							에이버리는 책상에 앉아 책을 휙휙 넘기고 있다.
						<<else>>
							에이버리는 책상 옆에서 등을 기대고 책에 몰두해 있다.
						<</if>>
						<<endevent>>
						<br><br>
						<<socialiseicon>><<link [[에이버리와 이야기한다|Mansion Talk]]>><</link>>
						<br>
					<</if>>
					<<if $avery_mansion.recipe.length gte 1>>
						<<set _extralinebreak to true>>
						<<for _i range $avery_mansion.recipe>>
							<<capture _i>>
								<<foodstufficon _i>><<link [[<<recipe_name _i>> 조리법을 배운다 (2:00)|Mansion Study Learn]]>><<set $phase to _i>><<pass 120>><</link>>
							<</capture>>
							<br>
						<</for>>
					<</if>>

					<<if $studyBooks?.rented isnot "none" or $studyBooks?.stolen isnot "none" or $scienceproject is "ongoing" or $mathsproject is "ongoing" or ($englishPlay is "ongoing" and $englishPlayRoles?.Player isnot "none")>>
						<<set _extralinebreak to true>>
						<<projectoptions>>
						<<homeStudyOptions>>
					<</if>>

					<<if $avery_mansion.schedule isnot "study" or $avery_mansion.schedule is "away">>
						<<if $avery_mansion.study_secret is 1>>
							<<set _extralinebreak to true>>
							<<icon "avery-dungeon.png">><<link [[지하 감옥을 찾는다|Mansion Dungeon Find]]>><<set $avery_mansion.study_secret to 2>><</link>>
							<br>
						<<elseif $avery_mansion.study_secret gte 2>>
							<<set _extralinebreak to true>>
							<<icon "avery-dungeon.png">><<link [[지하 감옥에 들어간다|Mansion Dungeon Enter]]>><</link>>
							<br>
						<</if>>
					<</if>>
				<</if>>
			<</if>>

			<<if _extralinebreak>>
				<br>
			<</if>>

			<<if !_hide_links>>
				<<avery_mansion_links>>
			<</if>>

			<<if $bus is "avery_bedroom">>
				<br><br>
				<<link [[게임플레이 설정|Settings]]>><<set $settingsExitPassage to "Mansion Bedroom">><</link>>
				<br>
				<<attitudesControlCheck>>
				<<if $attitudesControl.showGoldLink is true>>
					<span class="goldLink"><<link [[태도|Attitudes]]>><<set $attitudesExitPassage to $passage>><</link>> </span><span class="red">!!</span>
				<<else>>
					<<link [[태도|Attitudes]]>><<set $attitudesExitPassage to $passage>><</link>>
				<</if>>
				<br><br>
				<<if $debug is 1>>
					''DEBUG ONLY''
					<br><br>

					Basics:
					<br>

					<<link [[에이버리의 저택 복귀로 건너뛰기|Mansion Enter]]>><<set $avery_mansion.schedule = "work">>
					<<debug_avery_skip_to_return>>
					<</link>><br>

					<<link [[에이버리의 분노 폭발 발동|Mansion Enter]]>><<npcincr Avery rage 100>><<set $avery_mansion.rage.timer to 0>><<set $avery_mansion.rage.apologetic to false>><<debug_avery_skip_to_return>><<set $avery_mansion.rage.assess to 20>><<set $avery_mansion.schedule = "work">>
					<</link>><br>

					<<link [[에이버리의 사과 복귀 발동|Mansion Enter]]>><<npcset Avery rage 25>><<set $avery_mansion.rage.timer to 25>><<set $avery_mansion.rage.apologetic to true>><<set $avery_mansion.schedule = "away">>
					<<debug_avery_skip_to_return>>
					<</link>><br>

					<<link [[에이버리의 모든 업무를 지운다|$passage]]>><<set $avery_mansion.jobs to []>><</link>><br>
					<<link [[에이버리의 모든 업무를 추가한다|$passage]]>>
						<<set $avery_mansion.jobs.push("lounge")>>
						<<set $avery_mansion.jobs.push("bow")>>
						<<set $avery_mansion.jobs.push("bedroom")>>
						<<set $avery_mansion.jobs.push("formal")>>
						<<set $avery_mansion.jobs.push("dining")>>
						<<set $avery_mansion.jobs.push("hairlength")>>
						<<set $avery_mansion.jobs.push("kitchen")>>
						<<set $avery_mansion.jobs.push("maid")>>
						<<set $avery_mansion.jobs.push("pool")>>
						<<set $avery_mansion.jobs.push("hairstyle")>>
						<<set $avery_mansion.jobs.push("bathroom")>>
						<<set $avery_mansion.jobs.push("garden")>>
						<<set $avery_mansion.jobs.push("knees")>>
						<<set $avery_mansion.jobs.push("display")>>
						<<set $avery_mansion.jobs.pushUnique("dungeon")>>
						<<set $avery_mansion.jobs.push("meek")>>
						<<set $avery_mansion.jobs to [...new Set($avery_mansion.jobs)]>>
					<</link>>

					<br><br>

					마천루 플롯 기능:
					<br>

					<<link [[갈색 여우 강도 사건 시작|Mansion Fox Heist]]>><<set $avery_mansion.fox.task to "heist">><<set $auriga_artefact to "Avery">><<unset $avery_fate>><<passTimeUntil 23>><</link>> (이벤트 중 에이버리가 분노 폭발을 일으키지 않았다면 재우게 됩니다)<br>

					<<link [[마천루를 완성한다|Mansion Enter]]>><<set $avery_mansion.schedule = "work">><<debug_avery_skip_to_return>><<set $avery_tower.stage to 2>><<set $avery_tower.progress to 100>>
					<</link>>

					<br>
					<<link [[마천루 의식으로 간다|Mansion Enter]]>><<set $avery_mansion.schedule = "work">><<run Time.timeTravel(new DateTime(Time.year, Time.month, Time.lastDayOfMonth, 21, 0))>><<set $moonstate to "evening">><<unset $avery_fate>><<set $avery_tower.stage to 3>>
					<</link>>
					<br>

					<<link [[돌을 바꿔치기하지 않고 마천루 의식으로 간다|Mansion Enter]]>><<set $avery_mansion.schedule = "work">><<run Time.timeTravel(new DateTime(Time.year, Time.month, Time.lastDayOfMonth, 21, 0))>><<set $moonstate to "evening">><<unset $avery_fate>><<set $avery_tower.stage to 3>><<set $fake_artefact to "pc">>
					<</link>>
					<br>

					<<link [[돌을 바꿔치기하고 마천루 의식으로 간다|Mansion Enter]]>><<set $avery_mansion.schedule = "work">><<run Time.timeTravel(new DateTime(Time.year, Time.month, Time.lastDayOfMonth, 21, 0))>><<set $moonstate to "evening">><<unset $avery_fate>><<set $avery_tower.stage to 3>><<set $fake_artefact to "Avery">><<set $auriga_artefact to "pc">>
					<</link>>
					<br>

					<<link [[에이버리의 저택을 파괴한다|Danube Street]]>><<set $avery_mansion_fire_time to 3>><<if !$wardrobe_residential_alleys>><<set $wardrobe_residential_alleys to 1>><</if>><<avery_antiques_end>><<set $avery_fate to "fallen">><<dismissAvery "hard">><</link>> (이 작업은 되돌릴 수 없습니다)

					<br><br>
					Valentines:
					<br>

					<<link [[발렌타인데이 시작|Mansion Enter]]>><<run Time.timeTravel(new DateTime(Time.year + ((Time.month < 2 || (Time.month === 2 && Time.day <= 12)) ? 0 : 1), 2, 12, 7, 0))>><</link>>
					<br>

					<<link [['승천한 에이버리'로 발렌타인데이 시작|Mansion Enter]]>><<set $avery_fate to "ascended">><<npc Gwylan>><<npc Harper>><<npc Remy>><<set C.npc.Avery.title to "crimson hound">><<set C.npc.Harper.title to "silver fox">><<set C.npc.Remy.title to "high elk">><<set $auriga_scar++>><<gwylanNobody>><<if $gwylan>><<set $gwylan.wary += 3>><</if>><<set $avery_tower.progress to 100>><<run Time.timeTravel(new DateTime(Time.year + ((Time.month < 2 || (Time.month === 2 && Time.day <= 12)) ? 0 : 1), 2, 12, 7, 0))>><</link>><br>

					<<link [['구원받은 에이버리'로 발렌타인데이 시작|Mansion Enter]]>><<set $avery_fate to "saved">><<set $avery_injury to false>><<set $avery_mansion.injury_timer to 90>><<set $avery_mansion.injury_stage to "sling">><<npcincr Avery dom -9>><<run Time.timeTravel(new DateTime(Time.year + ((Time.month < 2 || (Time.month === 2 && Time.day <= 12)) ? 0 : 1), 2, 12, 7, 0))>><<npcincr Avery rage -39>><<set $avery_mansion.rage.timer to 30>><</link>>

					<br><br>
					Miscellaneous:
					<br>

					<<link [[에이버리 섹스 시작|Mansion Sleep Sex]]>><<endcombat>><<set $sexstart to 1>><<npc Avery>><<person1>><</link>><br>
					<<link [[에이버리 강간 시작|Mansion Date Rape]]>><<endcombat>><<set $molestationstart to 1>><<npc Avery>><<person1>><</link>><br>


				<</if>>
			<</if>>
