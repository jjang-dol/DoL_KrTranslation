	<</if>>
<</widget>>

<<widget "this_sunday">>
	<<if Time.weekDay is 1>>
		<<set $_text to "다음 주 일요일">>
	<<elseif Time.weekDay is 7>>
		<<set $_text to "내일">>
	<<else>>
		<<set $_text to "이번 주 일요일">>
	<</if>>
	<<print $_text>>
<</widget>>

<<widget "this_saturday">>
	<<if Time.weekDay is 7>>
		<<set $_text to "오늘 밤">>
	<<elseif Time.weekDay is 6>>
		<<set $_text to "내일">>
	<<else>>
		<<set $_text to "이번 주 토요일">>
	<</if>>
	<<print $_text>>
<</widget>>

<<widget "avery_mansion_victory">>
	<<switch $bus>>
		<<case "lounge">>
			에이버리는 발이 걸려 방 중앙에 있는 탁자 위로 넘어진다.
			<<avery_housework_change "lounge" 1>>
		<<case "study">>
			에이버리가 책장과 충돌하고, 쏟아져 내리는 책더미에 파묻힐 뻔한다.
		<<case "bedroom">>
			에이버리는 발코니 쪽으로 비틀거리다, 커튼을 경첩에서 뜯어내며 가까스로 넘어지는 것을 면한다.
			<<avery_housework_change "bedroom" 1>>
		<<case "bathroom">>
			에이버리는 욕조 안으로 떨어지며, 떨어지는 와중에 하마터면 수도꼭지를 부술 뻔한다.
			<<avery_housework_change "bathroom" 1>>
		<<case "hallway">>
			에이버리가 벽에 쿵 하고 부딪히며, 그림 하나가 떨어져 내린다.
		<<case "dungeon">>
			에이버리가 헐거워진 돌에 걸려, 하마터면 <<his>> 고문 기구에 떨어질 뻔한다.
		<<case "garden">>
			에이버리는 덤불 속으로 쓰러지며, 장식수를 망쳐버린다.
			<<avery_housework_change "garden" 1>>
		<<case "pool">>
			에이버리는 발을 헛디뎌 수영장 안으로 첨벙 빠진다. <<he>>【이가】 버둥거리자 마치 <<his>> 분노로 끓어오르는 것처럼 물이 요동친다.
			<<avery_housework_change "pool" 1>>
		<<case "garage">>
			에이버리는 발을 헛디디지만, 지탱하려고 <<his>> 차에 손을 대는 것만은 피하며 대신 땅바닥에 쓰러진다.
		<<case "kitchen">>
			에이버리가 찬장에 세게 부딪힌다. 접시들이 떨어지며 깨져 <<him>>【와과】 조리대 위로 쏟아진다.
			<<avery_housework_change "kitchen" 1>>
		<<case "dining">>
			에이버리가 탁자 위로 쓰러지며, 식기들이 사방으로 흩어진다.
			<<avery_housework_change "dining" 1>>
		<<case "display">>
			에이버리는 발을 헛디뎌 넘어지지 않으려고 가치를 매길 수 없는 골동품을 움켜쥔다.
			<<avery_housework_change "display" 1>>
		<<default>>
	<</switch>>
<</widget>>

<<widget "avery_mansion_chase_init">>
	<<set $avery_mansion.chase to {}>>
	<<set $avery_mansion.chase.active to true>>
	<<set $avery_mansion.chase.victory to 0>>
	<<set $avery_mansion.chase.health to 3>>
	<<set $averySeen.pushUnique("chase")>>
	<<switch $bus>>
		<<case "avery_lounge">>
			<<set $avery_mansion.chase.bus to "hallway_1_e">>
			<<set $avery_mansion.chase.avery_bus to "lounge">>
		<<case "avery_dining">>
			<<set $avery_mansion.chase.bus to "hallway_1_w">>
			<<set $avery_mansion.chase.avery_bus to "dining">>
		<<case "avery_kitchen">>
			<<set $avery_mansion.chase.bus to "hallway_1_w">>
			<<set $avery_mansion.chase.avery_bus to "kitchen">>
		<<case "avery_display">>
			<<set $avery_mansion.chase.bus to "hallway_1_e">>
			<<set $avery_mansion.chase.avery_bus to "display">>
		<<case "avery_garage">>
			<<set $avery_mansion.chase.bus to "garden">>
			<<set $avery_mansion.chase.avery_bus to "garage">>
		<<case "avery_bedroom">>
			<<set $avery_mansion.chase.bus to "hallway_2_w">>
			<<set $avery_mansion.chase.avery_bus to "bedroom">>
		<<case "avery_bathroom">>
			<<set $avery_mansion.chase.bus to "bedroom">>
			<<set $avery_mansion.chase.avery_bus to "bathroom">>
		<<case "avery_study">>
			<<set $avery_mansion.chase.bus to "hallway_3">>
			<<set $avery_mansion.chase.avery_bus to "study">>
		<<case "avery_garden">>
			<<set $avery_mansion.chase.bus to "hallway_1">>
			<<set $avery_mansion.chase.avery_bus to "garden">>
		<<case "avery_pool">>
			<<set $avery_mansion.chase.bus to "hallway_1_w">>
			<<set $avery_mansion.chase.avery_bus to "pool">>
		<<case "avery_dungeon">>
			<<set $avery_mansion.chase.bus to "hallway_1_w">>
			<<set $avery_mansion.chase.avery_bus to "dungeon">>
		<<default>>
			<<set $avery_mansion.chase.bus to "hallway_1">>
			<<set $avery_mansion.chase.avery_bus to "lounge">>
	<</switch>>
	<<set $avery_mansion.chase.sound to "none">>
	<<set $avery_mansion.chase.player_sound to "none">>
	<<set $avery_mansion.chase.key to false>>
	<<set $avery_mansion.chase.key_checked to []>>
	<<set $avery_mansion.chase.gear to []>>
	<<set $avery_mansion.chase.trap to []>>
	<<set $avery_mansion.chase.trap_done to []>>
	<<set $avery_mansion.chase.state to "tutorial">>
	<<rng 5>>
	<<switch $rng>>
		<<case 1>>
			<<set $avery_mansion.chase.key_location to "bedroom">>
		<<case 2>>
			<<set $avery_mansion.chase.key_location to "bathroom">>
		<<case 3>>
			<<set $avery_mansion.chase.key_location to "study">>
		<<case 4>>
			<<set $avery_mansion.chase.key_location to "lounge">>
		<<default>>
			<<set $avery_mansion.chase.key_location to "garage">>
	<</switch>>
<</widget>>

<<widget "avery_mansion_chase_end">>
	<<set $avery_mansion.chase to {}>>
	<<set $avery_mansion.chase.active to false>>
<</widget>>

<<widget "avery_mansion_chase_trap">>
	<<set $avery_mansion.chase.trap.push(_args[0])>>
	<<set $avery_mansion.chase.trap_done.push(_args[0])>>
<</widget>>

<<widget "avery_mansion_chase">>
	<span class="red">에이버리가 당신을 사냥하고 있다.</span>
	<br><br>

	<<set $_averysound to "">>
	<<switch $avery_mansion.chase.bus>>
		<<case "lounge">>
			<<if $avery_mansion.chase.avery_bus is "display">>
				<<set $_averysound to "당신은 에이버리가 전시실에서 서두르다 진열대들을 넘어뜨리는 소리를 듣는다.">>
				<<avery_housework_change "display" 1>>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1_w">>
				<<set $_averysound to "당신은 밖의 복도에서 에이버리가 벽을 세게 치고, 이어서 그림 하나가 바닥에 떨어지는 소리를 듣는다.">>
			<</if>>
		<<case "dining">>
			<<if $avery_mansion.chase.avery_bus is "kitchen">>
				<<set $_averysound to "당신은 부엌에서 에이버리가 당신을 찾고 찬장 문을 쾅쾅 닫는 소리를 듣는다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1_e">>
				<<set $_averysound to "당신은 에이버리가 밖의 복도를 서성이며 당신을 찾는 소리를 듣는다.">>
			<</if>>
		<<case "kitchen">>
			<<if $avery_mansion.chase.avery_bus is "dining">>
				<<set $_averysound to "식당 테이블 위로 의자가 미끄러지는 소리가 들린다.">>
				<<avery_housework_change dining 1>>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1_e">>
				<<set $_averysound to "당신은 밖의 복도에서 에이버리가 걸으며 손톱으로 벽을 긁는 소리를 듣는다.">>
			<<elseif $avery_mansion.chase.avery_bus is "garage">>
				<<set $_averysound to "에이버리가 차고를 걷고 있는 소리가 어렴풋이 들린다.">>
			<</if>>
		<<case "display">>
			<<if $avery_mansion.chase.avery_bus is "lounge">>
				<<set $_averysound to "에이버리가 라운지에서 쿠션을 걷어차는 소리가 들린다.">>
				<<avery_housework_change lounge 1>>
				<<set $_averysound to "당신은 에이버리가 밖의 복도를 걸으며 벽을 툭툭 치는 소리를 듣는다.">>
			<</if>>
		<<case "garage">>
			<<if $avery_mansion.chase.avery_bus is "kitchen">>
				<<set $_averysound to "부엌에서 서랍이 세게 닫히는 소리가 들린다.">>
			<<elseif $avery_mansion.chase.avery_bus is "garden">>
				<<set $_averysound to "작은 창문 너머 정원에서 에이버리가 장미의 머리를 뜯어내며 가시에 찔려 피를 흘리는 모습이 보인다.">>
			<</if>>
		<<case "garden">>
			<<if $avery_mansion.chase.avery_bus is "hallway_1">>
				<<set $_averysound to "안뜰에서 에이버리가 딱딱한 바닥에 구두굽 소리를 내며 걷는 소리가 들린다.">>
			<<elseif $avery_mansion.chase.avery_bus is "garage">>
				<<set $_averysound to "차고에서 에이버리가 차를 제외한 모든 것에 분풀이를 하는 모습이 엿보인다.">>
			<<elseif $avery_mansion.chase.avery_bus is "pool">>
				<<set $_averysound to "수영장에 뭔가 무거운 것이 떨어져 물이 튀는 소리가 들린다.">>
			<</if>>
		<<case "pool">>
			<<if $avery_mansion.chase.avery_bus is "garden">>
				<<set $_averysound to "머리가 잘린 장미들이 시야에 날아든다. 에이버리는 정원에 있다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1_w">>
				<<set $_averysound to "당신에게 등을 돌린 채 뒷문 바로 안쪽에 서 있는 에이버리의 모습이 보인다.">>
			<</if>>
		<<case "bedroom">>
			<<if $avery_mansion.chase.avery_bus is "bathroom">>
				<<set $_averysound to "당신은 에이버리가 욕실에서 수도꼭지를 트는 소리를 듣는다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_2_w">>
				<<set $_averysound to "당신은 에이버리가 밖의 복도에서 빈 방들을 하나씩 확인하며 문을 쾅쾅 닫는 소리를 듣는다.">>
			<</if>>
		<<case "bathroom">>
			<<if $avery_mansion.chase.avery_bus is "bedroom">>
				<<set $_averysound to "당신은 에이버리가 침실의 옷장을 뒤지며 당신을 찾는 소리를 듣는다.">>
			<</if>>
		<<case "study">>
			<<if $avery_mansion.chase.avery_bus is "hallway_3">>
				<<set $_averysound to "당신은 에이버리가 밖의 복도를 배회하며 당신을 가두려 하는 소리를 듣는다.">>
			<</if>>
		<<case "hallway_1">>
			<<if $avery_mansion.chase.avery_bus is "garden">>
				<<set $_averysound to "당신은 에이버리가 정원의 덤불을 짓밟으며 걷는 소리를 듣는다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_2">>
				<<set $_averysound to "위층에서 에이버리의 소리가 들린다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1_w">>
				<<set $_averysound to "여기서 라운지 사이 복도에서 에이버리의 소리가 들린다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1_e">>
				<<set $_averysound to "여기서 식당 사이 복도에서 에이버리의 소리가 들린다.">>
			<</if>>
		<<case "hallway_1_w">>
			<<if $avery_mansion.chase.avery_bus is "lounge">>
				<<set $_averysound to "당신은 에이버리가 라운지 소파 뒤에 당신이 있는지 확인하려는 듯 소파를 밀어내는 소리를 듣는다.">>
				<<avery_housework_change "lounge" 1>>
			<<elseif $avery_mansion.chase.avery_bus is "display">>
				<<set $_averysound to "당신은 에이버리가 전시실에서 골동품들을 험하게 다루는 소리를 듣는다.">>
				<<avery_housework_change "display" 1>>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1">>
				<<set $_averysound to "당신은 에이버리가 안뜰에서 계단을 걷어차는 소리를 듣는다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1_e">>
				<<set $_averysound to "복도 위쪽에서 에이버리의 소리가 들린다.">>
			<</if>>
		<<case "hallway_1_e">>
			<<if $avery_mansion.chase.avery_bus is "dining">>
				<<set $_averysound to "당신은 에이버리가 식당에서 의자들을 옆으로 던지는 소리를 듣는다.">>
				<<avery_housework_change "dining" 1>>
			<<elseif $avery_mansion.chase.avery_bus is "kitchen">>
				<<set $_averysound to "당신은 에이버리가 부엌에서 식기들을 벽에 던지는 소리를 듣는다.">>
				<<avery_housework_change "kitchen" 1>>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1">>
				<<set $_averysound to "안뜰에서 에이버리의 발소리가 들린다. 바닥이 부서지지 않는 게 신기할 정도로 강하게 내딛고 있다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_1_w">>
				<<set $_averysound to "복도 위쪽에서 에이버리의 소리가 들린다.">>
			<</if>>
		<<case "hallway_2">>
			<<if $avery_mansion.chase.avery_bus is "hallway_1">>
				<<set $_averysound to "아래층 안뜰에서 에이버리의 발소리가 메아리치는 게 들린다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_2_w">>
				<<set $_averysound to "여기서 침실 사이 복도에서 에이버리의 소리가 들린다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_2_e">>
				<<set $_averysound to "여기서 서재 사이 복도에서 에이버리의 소리가 들린다.">>
			<</if>>
		<<case "hallway_2_w">>
			<<if $avery_mansion.chase.avery_bus is "hallway_2">>
				<<set $_averysound to "근처 층계참이 삐걱이는 소리가 들린다.">>
			<<elseif $avery_mansion.chase.avery_bus is "bedroom">>
				<<set $_averysound to "당신은 에이버리가 침실에서 발코니 문을 여는 소리를 듣는다.">>
			<</if>>
		<<case "hallway_2_e">>
			<<if $avery_mansion.chase.avery_bus is "hallway_2">>
				<<set $_averysound to "층계참 바닥이 삐걱이는 소리가 들린다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_3">>
				<<set $_averysound to "위층에서 발소리가 들린다.">>
			<</if>>
		<<case "hallway_3">>
			<<if $avery_mansion.chase.avery_bus is "study">>
				<<set $_averysound to "서재에서 쿵쿵거리는 소리가 들린다.">>
			<<elseif $avery_mansion.chase.avery_bus is "hallway_2_w">>
				<<set $_averysound to "아래층에서 에이버리가 벽의 패널을 뜯어내는 소리가 들린다.">>
			<</if>>
	<</switch>>
	<<if $avery_mansion.chase.sound isnot "none">>
		<<avery_mansion_chase_sound $avery_mansion.chase.sound>>
	<</if>>
	<<avery_mansion_player_sound $avery_mansion.chase.bus>>

	<<if $_averysound isnot "">>
		<span class="pink"><<= $_averysound>></span>
		<br><br>
	<<elseif _averyHear>>
		<br><br>
	<</if>>
<</widget>>

<<widget "avery_mansion_chase_location">>
	<<set $avery_mansion.chase.avery_bus_prev to $avery_mansion.chase.avery_bus>>
	<<set $avery_mansion.chase.bus_prev to $avery_mansion.chase.bus>>
	<<set $avery_mansion.chase.sound to "none">>
	<<if $avery_mansion.chase.trap.includes($avery_mansion.chase.avery_bus)>>
		<<set $avery_mansion.chase.sound to $avery_mansion.chase.avery_bus>>
	<</if>>
	<<if $avery_mansion.chase.sound is "garage" or $avery_mansion.chase.sound is "pool" or $avery_mansion.chase.sound is "hallway_2">>

	<<elseif _args[0] is "sound_stairs_1">>
		<<if $avery_mansion.chase.avery_bus is "bedroom" or
		$avery_mansion.chase.avery_bus is "bathroom" or
		$avery_mansion.chase.avery_bus is "study" or
		$avery_mansion.chase.avery_bus is "hallway_2_w" or
		$avery_mansion.chase.avery_bus is "hallway_2_e" or
		$avery_mansion.chase.avery_bus is "hallway_1" or
		$avery_mansion.chase.avery_bus is "hallway_3">>
			<<set $avery_mansion.chase.avery_bus to "hallway_2">>
		<<else>>
			<<set $avery_mansion.chase.avery_bus to "hallway_1">>
		<</if>>
	<<elseif _args[0] is "sound_stairs_2">>
		<<if $avery_mansion.chase.avery_bus is "study">>
			<<set $avery_mansion.chase.avery_bus to "hallway_3">>
		<<else>>
			<<set $avery_mansion.chase.avery_bus to "hallway_2_e">>
		<</if>>
	<<elseif _args[0]>>
		<<set $avery_mansion.chase.avery_bus to _args[0]>>
	<<elseif $avery_mansion.chase.player_sound isnot "none">>
		<<set $avery_mansion.chase.avery_bus to $avery_mansion.chase.player_sound>>
	<<else>>
		<<switch $avery_mansion.chase.avery_bus>>
			<<case "lounge">>
				<<rng 2>>
				<<if $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "display">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "display">>
						<<avery_housework_change "display" 1>>
					<</if>>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1_w">>
				<</if>>
			<<case "dining">>
				<<rng 2>>
				<<if $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "kitchen">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "kitchen">>
						<<avery_housework_change "kitchen" 1>>
					<</if>>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1_e">>
				<</if>>
			<<case "kitchen">>
				<<rng 3>>
				<<if $rng is 3>>
					<<set $avery_mansion.chase.avery_bus to "dining">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "dining">>
						<<avery_housework_change "dining" 1>>
					<</if>>
				<<elseif $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "garage">>
					<<if $avery_mansion.chase.trap.includes("garage")>>
						<<set $avery_mansion.chase.sound to "garage">>
					<</if>>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1_e">>
				<</if>>
			<<case "display">>
				<<rng 2>>
				<<if $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "lounge">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "lounge">>
						<<avery_housework_change "lounge" 1>>
					<</if>>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1_w">>
				<</if>>
			<<case "garage">>
				<<rng 2>>
				<<if $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "kitchen">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "kitchen">>
						<<avery_housework_change "kitchen" 1>>
					<</if>>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "garden">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "garden">>
						<<avery_housework_change "garden" 1>>
					<</if>>
				<</if>>
			<<case "garden">>
				<<rng 3>>
				<<if $rng is 3>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1">>
					<<set $avery_mansion.chase.sound to "front_door">>
				<<elseif $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "garage">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "garage">>
						<<avery_housework_change "garage" 1>>
					<</if>>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "pool">>
					<<if $avery_mansion.chase.trap.includes("pool")>>
						<<set $avery_mansion.chase.sound to "pool">>
					<<elseif random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "pool">>
						<<avery_housework_change "pool" 1>>
					<</if>>
				<</if>>
			<<case "pool">>
				<<rng 2>>
				<<if $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1_w">>
					<<set $avery_mansion.chase.sound to "back_door">>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "garden">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "garden">>
						<<avery_housework_change "garden" 1>>
					<</if>>
				<</if>>
			<<case "bedroom">>
				<<rng 2>>
				<<if $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "hallway_2_w">>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "bathroom">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "bathroom">>
						<<avery_housework_change "bathroom" 1>>
					<</if>>
				<</if>>
			<<case "bathroom">>
				<<set $avery_mansion.chase.avery_bus to "bedroom">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "bedroom">>
						<<avery_housework_change "bedroom" 1>>
					<</if>>
			<<case "study">>
				<<set $avery_mansion.chase.avery_bus to "hallway_3">>
			<<case "dungeon">>
				<<set $avery_mansion.chase.avery_bus to "study">>
			<<case "hallway_1">>
				<<rng 4>>
				<<if $rng is 4>>
					<<if $avery_mansion.chase.trap.includes("hallway_2")>>
						<<set $avery_mansion.chase.sound to "hallway_2">>
						<<set $avery_mansion.chase.avery_bus to "hallway_1">>
					<<else>>
						<<set $avery_mansion.chase.avery_bus to "hallway_2">>
						<<set $avery_mansion.chase.sound to "main_stair">>
					<</if>>
				<<elseif $rng is 3>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1_w">>
				<<elseif $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1_e">>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "garden">>
					<<set $avery_mansion.chase.sound to "front_door">>
				<</if>>
			<<case "hallway_1_e">>
				<<rng 4>>
				<<if $rng is 4>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1_w">>
				<<elseif $rng is 3>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1">>
				<<elseif $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "dining">>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "kitchen">>
				<</if>>
			<<case "hallway_1_w">>
				<<rng 5>>
				<<if $rng is 5>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1_e">>
				<<elseif $rng is 4>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1">>
				<<elseif $rng is 3>>
					<<set $avery_mansion.chase.avery_bus to "lounge">>
					<<if random(1, 3) is 3>>
						<<avery_housework_change "lounge" 1>>
					<</if>>
				<<elseif $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "display">>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "pool">>
					<<if $avery_mansion.chase.trap.includes("pool")>>
						<<set $avery_mansion.chase.sound to "pool">>
					<<else>>
						<<set $avery_mansion.chase.sound to "back_door">>
					<</if>>
				<</if>>
			<<case "hallway_2">>
				<<rng 3>>
				<<if $rng is 3>>
					<<set $avery_mansion.chase.avery_bus to "hallway_2_w">>
				<<elseif $rng is 2>>
					<<set $avery_mansion.chase.avery_bus to "hallway_2_e">>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "hallway_1">>
					<<set $avery_mansion.chase.sound to "main_stair">>
				<</if>>
			<<case "hallway_2_w">>
				<<rng 2>>
				<<if $rng is 2>>
					<<if $avery_mansion.chase.trap.includes("hallway_2")>>
						<<set $avery_mansion.chase.sound to "hallway_2">>
						<<set $avery_mansion.chase.avery_bus to "hallway_1">>
					<<else>>
						<<set $avery_mansion.chase.avery_bus to "hallway_2">>
					<</if>>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "bedroom">>
				<</if>>
			<<case "hallway_2_e">>
				<<rng 2>>
				<<if $rng is 2>>
					<<if $avery_mansion.chase.trap.includes("hallway_2")>>
						<<set $avery_mansion.chase.sound to "hallway_2">>
						<<set $avery_mansion.chase.avery_bus to "hallway_1">>
					<<else>>
						<<set $avery_mansion.chase.avery_bus to "hallway_2">>
					<</if>>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "hallway_3">>
					<<set $avery_mansion.chase.sound to "study_stair">>
				<</if>>
			<<case "hallway_3">>
				<<rng 3>>
				<<if $rng is 3>>
					<<set $avery_mansion.chase.avery_bus to "study">>
					<<if random(1, 3) is 3>>
						<<set $avery_mansion.chase.sound to "study">>
						<<avery_housework_change "study" 1>>
					<</if>>
				<<else>>
					<<set $avery_mansion.chase.avery_bus to "hallway_2_e">>
					<<set $avery_mansion.chase.sound to "study_stair">>
				<</if>>
		<</switch>>
	<</if>>
	<<if $avery_mansion.chase.avery_bus is $avery_mansion.chase.player_sound>>
		<<set $avery_mansion.chase.player_sound to "none">>
	<</if>>
<</widget>>

<<widget "avery_mansion_chase_sound">>
	<<if _args[0] is "garage" and $avery_mansion.chase.trap.includes("garage")>>
		에이버리가 분노에 차 고함을 지른다. 차고에서 당신이 벌여놓은 짓을 발견한 모양이다.<<gfrustration>><<set $avery_mansion.chase.health -= 1>>
		<<set $avery_mansion.chase.trap.delete("garage")>>
	<<elseif _args[0] is "pool" and $avery_mansion.chase.trap.includes("pool")>>
		에이버리가 비명을 지른다. 곧이어 무언가 물에 첨벙 빠지는 큰 소리가 들린다. 당신이 뿌린 기름에 미끄러져 수영장에 빠진 것이다.<<gfrustration>><<set $avery_mansion.chase.health -= 1>>
		<<set $avery_mansion.chase.trap.delete("pool")>>
	<<elseif _args[0] is "hallway_2" and $avery_mansion.chase.trap.includes("hallway_2")>>
		에이버리가 화들짝 놀라며 소리친다. 그 직후 <<he>>【이가】 메인 계단에서 구르며 연속적인 쿵쿵거리는 소리가 들린다. 당신이 뿌려둔 구슬이 효과를 발휘했다.<<gfrustration>><<set $avery_mansion.chase.health -= 1>>
		<<set $avery_mansion.chase.trap.delete("hallway_2")>>
	<<elseif _args[0] is "main_stair">>
		에이버리의 발에 밟혀 메인 계단이 삐걱이는 소리가 들린다.
	<<elseif _args[0] is "study_stair">>
		에이버리의 발에 밟혀 3층으로 가는 낡은 계단이 삐걱이는 소리가 들린다.
	<<elseif _args[0] is "front_door">>
		현관문이 쾅 닫히는 소리가 들린다.
	<<elseif _args[0] is "back_door">>
		뒷문이 쾅 닫히는 소리가 들린다.
	<<else>>
		<<rng 10>>
		<<switch $rng>>
			<<case 10>>
				"어디 찾기만 해 봐,"
			<<case 9>>
				"나를 존중하는 게 어떤 건지 뼈저리게 가르쳐 주마,"
			<<case 8>>
				"마을 사람 아무한테나 다리를 벌리고 다니겠지. 모두가 내 뒤에서 비웃고 있다고,"
			<<case 7>>
				"네 본모습인 창녀처럼 대해 주마,"
			<<case 6>>
				"네가 누구 소유인지 확실히 상기시켜 줄 테다,"
			<<case 5>>
				"당장 나와 이 쓸모없는 걸레년아,"
			<<case 4>>
				"날 피해 숨어놓고 똑똑하게 굴었다고 생각하냐?"
			<<case 3>>
				"보여주겠어. 모두에게 보여주지,"
			<<case 2>>
				"네 녀석보단 내가 밟은 개똥이 훨씬 가치 있겠다,"
			<<default>>
				"씨발 딱 기다려,"
		<</switch>>
		<span class="blue"><<print ({lounge:"응접실",dining:"식당",display:"전시실",kitchen:"부엌",garden:"정원",pool:"수영장",bedroom:"침실",bathroom:"욕실",study:"서재",garage:"차고",dungeon:"지하 감옥",hallway_1:"아트리움",hallway_1_w:"1층 서쪽 복도",hallway_1_e:"1층 동쪽 복도",hallway_2:"계단참",hallway_2_w:"2층 서쪽 복도",hallway_2_e:"2층 동쪽 복도",hallway_3:"3층 복도"})[_args[0]] || _args[0]>></span>에서 <<he>>【이가】 소리친다.
		<<switch _args[0]>>
			<<case "lounge">>
				<<if random(0, 1)>>
					유리잔이 박살 나는 소리가 들린다.
				<<else>>
					불협화음의 피아노 소리가 연이어 울리더니 무언가 쾅 내리치는 소리가 들린다.
				<</if>>
			<<case "dining">>
				나무가 부러지는 소리가 들린다.
			<<case "display">>
				유리가 깨지는 소리가 들린다.
			<<case "kitchen">>
				접시가 깨지는 소리가 들린다.
			<<case "garden">>
				화분이 박살 나는 소리가 들린다.
			<<case "pool">>
				무언가 수영장에 첨벙 빠지는 소리가 들린다.
			<<case "bedroom">>
				침대가 바닥을 긁는 소리가 들린다.
			<<case "bathroom">>
				타일이 박살 나는 소리가 들린다.
			<<case "study">>
				방 안을 가로질러 책이 내던져지며 쿵쿵거리는 소리가 들린다.
		<</switch>>
	<</if>>
	<br><br>
<</widget>>

