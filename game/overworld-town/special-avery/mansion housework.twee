<<set _tending_time to Math.floor(10 - $tending / 200)>>
<<avery_housework_check>>
<<avery_mansion>>

<<set _rooms to [
	"lounge",
	"kitchen",
	"dining",
	"display",
	"bedroom",
	"bathroom",
	"garden",
	"pool"
]>>

<<for _roomindex to 0; _roomindex lt _rooms.length; _roomindex++>>
	<<if !_event_triggered and $avery_mansion[_rooms[_roomindex]] gte 1>>
		<<avery_mansion_clean _rooms[_roomindex]>>
	<</if>>
<</for>>

<<if _event_triggered isnot true>>
	<br>
	<<avery_mansion_end_links "housework">>
<</if>>

