<<if $photo_location is 4>>
	<<addinlineevent "photo_high_shop" 1.2>>
		<<generate1>><<person1>>
		조금 떨어진 곳에서 <<person>>【이가】 당신 위쪽과 뒤쪽을 가리키며 당신을 바라보는 것이 보인다. 벽에는 당신의 의상과 같은 캐릭터가 그려진 포스터가 붙어 있다.
		<br><br>

		<<photo_high_options_check>>
		<<if _photo_options>>
			<<link [[포스터의 포즈를 따라 한다|Photo High Poster Copy]]>><<photo_attention 1>><<photo_interest 1>><</link>><<gattention>><<ginterest>>
			<br>
		<</if>>
		<br>
		<<photo_high_options>>
	<</addinlineevent>>
<</if>>

<<if $photo_location is 5>>
	<<addinlineevent "photo_high_bus_stop" 1.2>>
		버스가 멈춰 서고 엄청난 수의 사람들이 우르르 쏟아져 나온다. 그들은 시골 사람들처럼 차려입었다. 그들은 당신 주위로 몰려든다.
		<br><br>

		"내가 제일 좋아하는 악당이잖아!"
		<br>
		"진짜 별걸 다 생각하네."
		<br>
		"내 양 떼를 놀라게 한 괴물처럼 생겼구만."
		<br><br>

		그들은 전단지를 흔쾌히 받아 간다. 만족한 인파는 새로운 구경거리를 찾아 흩어진다.<<ginterest>><<photo_interest 1>>
		<br><br>
		<<set $photo_flyers += 12>>
		<<endevent>>
		<<photo_high_options>>
	<</addinlineevent>>
<</if>>

<<if $photo_location is 6>>
	<<addinlineevent "photo_high_statue" 1.2>>
		당신이 다가가자 근처에 있던 비둘기 한 마리가 날아오르며 다른 새들을 놀라게 하고, 곧 동상 주위에 있던 모든 새가 푸드덕거리며 날아간다.<<gattention>><<photo_attention 1>>
		<br><br>
		<<photo_high_options>>
	<</addinlineevent>>
<</if>>

<<if $photo_location is 7>>
	<<addinlineevent "photo_high_sea" 1.2>>
		바다에서 불어오는 바람이 거세진다. 바람이 의상의 후드를 휘어잡아 뒤로 젖히는 바람에 그 힘에 밀려 뒤로 넘어지고 만다.
		<br><br>
		누군가 킥킥거린다. 당신은 몸을 일으킨다.<<gstress>><<gattention>><<stress 6>><<photo_attention 1>>
		<br><br>
		<<photo_high_options>>
	<</addinlineevent>>
<</if>>

<<set _photo_model_chance to (1 + ($photo_attention[_photo_location] / 10))>>
<<set Math.clamp(_photo_model_chance, 1, 2)>>

<<if $fame.model gte 200>>
	<<addinlineevent "photo_high_model_1" _photo_model_chance>>
		<<generate1>><<person1>>
		<<person>>【이가】 당신과 폰을 번갈아 힐끗거리는 모습이 보인다. "어디서 본 것 같더라니." 그들이 폰을 돌려 당신이 촬영용 의상을 차려입은 사진을 보여주며 말한다.
		<br><br>

		<<photo_high_options_check>>
		<<if _photo_options>>
			<<link [[같이 셀카를 찍자고 제안한다|Photo High Recognised Offer]]>><<famemodel 1 "pic">><</link>>
			<br>
			<<link [[미소 짓는다|Photo High Recognised Smile]]>><<famemodel 1 "pic">><</link>>
			<br>
		<</if>>
		<br>
		<<photo_high_options>>
	<</addinlineevent>>
<</if>>

<<if $fame.model gte 400>>
	<<addinlineevent "photo_high_model_2" _photo_model_chance>>
		<<generate1>><<person1>>
		한 무리의 사람들이 당신 쪽을 바라보고 있다. <<person>>【이가】 당신을 가리키며 말하고 있지만, 거리가 너무 멀어 들리지 않는다.
		<br><br>
		그들이 다가온다. "당신 맞네요." <<person1>><<person>>【이가】 말한다. "제게 당신 포스터가 있어요!" <<His>> 일행은 당신을 알아보지 못했지만, 꽤 인상 깊어하는 눈치다. 그들은 열성적으로 전단지를 챙겨간다.<<ginterest>><<photo_interest 1>>
		<<wearProp "flyers">>
		<br><br>
		<<set $photo_flyers += 6>>
		<<endevent>>
		<<photo_high_options>>
	<</addinlineevent>>
<</if>>

<<if $fame.model gte 600>>
	<<addinlineevent "photo_high_model_3" _photo_model_chance>>
		<<generate1>><<person1>>
		<<person>>【이가】 당신에게 다가온다. "사인 좀 받을 수 있을까요?"
		<br><br>

		<<photo_high_options_check>>
		<<if _photo_options>>
			<<link [[사인을 해준다|Photo High Autograph Give]]>><</link>>
			<br>
		<</if>>
		<br>
		<<photo_high_options>>
	<</addinlineevent>>
<</if>>

<<if $fame.model gte 800>>
	<<addinlineevent "photo_high_model_4" _photo_model_chance>>
		<<generate1>><<person1>>
		전문가용 카메라를 든 <<person>>【이가】 나타난다. <<He>>【은는】 당신이 언제라도 사라질까 봐 걱정하는 듯 연신 셔터를 눌러댄다.<<famemodel 1 "pic">>
		<br><br>
		니키가 <<him>>【을를】 처리할 것이다.
		<br><br>

		<<photo_high_options_check>>
		<<if _photo_options>>
			<<link [[직접 <<him>>【을를】 처리한다|Photo High Photographer]]>><</link>>
			<br>
		<</if>>
		<br>
		<<photo_high_options>>
	<</addinlineevent>>
<</if>>

<<if $fame.model gte 1000>>
	<<addinlineevent "photo_high_model_5" _photo_model_chance>>
		<<generate1>><<generate2>><<person1>>
		<<person>>【와과】 <<person2>><<person>>【이가】 흥분한 표정으로 달려온다.
		<br><br>
		"완전 열성 팬이에요." <<person1>><<person>>【이가】 말한다. "카메라 앞에서 몇 가지만 물어봐도 될까요? 오래 안 걸려요." <<person2>><<person>>【이가】 <<his>> 폰을 들어 올린다.
		<br><br>
		<<photo_high_options_check>>
		<<if _photo_options>>
			<<link [[1분을 내어준다|Photo High Interview One]]>><<photo_pass 1>><<photo_interest 1>><</link>><<ginterest>>
			<br>
			<<link [[5분을 내어준다 (0:05)|Photo High Interview Five]]>><<photo_pass 5>><<photo_interest 1>>
			<<if $photo_heat gte 60>>
				<<photo_heat -12>>
			<<elseif $photo_heat gte 30>>
				<<photo_heat -8>>
			<<else>>
				<<photo_heat -4>>
			<</if>>
			<</link>>
			<<if $photo_heat gte 60>>
				<<lllheat>>
			<<elseif $photo_heat gte 30>>
				<<llheat>>
			<<else>>
				<<lheat>>
			<</if>>
			<<ginterest>>
			<br>
		<</if>>
		<br>
		<<photo_high_options>>
	<</addinlineevent>>
<</if>>

<<runeventpool>>
<</widget>>

<<widget "photo_high_options_check">>
	<<if $stress gte $stressmax>>
		<<unset _photo_options>>
	<<elseif $photo_timer lte 0>>
		<<unset _photo_options>>
	<<else>>
		<<set _photo_options to true>>
	<</if>>
<</widget>>

<<widget "photo_high_options">>
	<<if $stress gte $stressmax>>
		<<endevent>>
		<<passout>>
		<<photo_pass 60>>
		스스로를 너무 한계까지 몰아붙였다. 당신은 기절하고 만다.
		<br><br>
		<<link [[다음|Photo High Passout]]>><<overruined>><</link>>
		<br>
	<<elseif $photo_timer lte 0>>

		<<photo_high_description>>
		<span class="teal">어느새 니키가 곁에 나타난다.</span> "촬영 끝!" 카메라 뒷면을 확인하며 <<nnpc_he "Niki">>【이가】 말한다. "옷 입으세요, 보수에 대해 얘기하죠."
		<br><br>

		<<link [[다음|Photo High End]]>>
			<<endevent>>
			<<pass 2>>
			<<overruined>>
			<<storeon "photo_high_suit">>
		<</link>>
		<br>
	<<else>>
		<<photo_high_description>>

		<<if $arousal gte $arousal_max>>
			열기가 차오르더니, 결국 당신을 압도해 버린다. <<orgasm>>

			손가락들이 당신을 향하고, 고개를 돌린 사람들은 수군거린다. 당신은 질 나쁜 관심을 끌고 말았다.<<gstress>><<stress 6>><<gggattention>><<photo_attention 3>>
			<br><br>
		<</if>>

		<<link [[전단지를 나누어준다 (0:01)|Photo High Flyer]]>><<endevent>><<photo_heat 1>><<photo_attention 1>><<photo_interest 1>><<photo_pass 1>><</link>><<gheat>><<gattention>><<ginterest>>
		<br>
		<<if $photo_location lte 6>>
			<<link [[바다 방향으로 걷는다 (0:01)|Photo High Walk]]>><<endevent>><<photo_heat 1>><<set $photo_location += 1>><<photo_pass 1>><</link>><<gheat>>
			<br>
		<</if>>
		<<if $photo_location gte 2>>
			<<link [[숲 방향으로 걷는다 (0:01)|Photo High Walk]]>><<endevent>><<photo_heat 1>><<photo_pass 1>><<set $photo_location -= 1>><</link>><<gheat>>
			<br>
		<</if>>
		<<link [[그늘에서 쉰다 (0:05)|Photo High Rest]]>>
			<<endevent>>
			<<photo_attention 1>>
			<<if $photo_heat gte 60>>
				<<photo_heat -12>>
			<<elseif $photo_heat gte 30>>
				<<photo_heat -8>>
			<<else>>
				<<photo_heat -4>>
			<</if>>
		<<photo_pass 5>>
		<</link>>
		<<gattention>>
		<<if $photo_heat gte 60>>
			<<lllheat>>
		<<elseif $photo_heat gte 30>>
			<<llheat>>
		<<else>>
			<<lheat>>
		<</if>>
		<br>
		<<link [[니키를 찾는다 (0:01)|Photo High Niki]]>><<photo_pass 1>><</link>>
		<br>
		<br>
	<</if>>
<</widget>>

<<widget "photo_high_check_location">>
	<<switch $photo_location>>
		<<case 7>>
			<<set _photo_location to "sea">>
		<<case 6>>
			<<set _photo_location to "statue">>
		<<case 5>>
			<<set _photo_location to "bus_stop">>
		<<case 4>>
			<<set _photo_location to "shop">>
		<<case 3>>
			<<set _photo_location to "shopping_centre">>
		<<case 2>>
			<<set _photo_location to "park">>
		<<default>>
			<<set _photo_location to "forest">>
	<</switch>>
<</widget>>

<<widget "photo_high_description">>
	<hr>
	장소:
	<<switch $photo_location>>
		<<case 7>>해안가 근처
		<<case 6>>광장
		<<case 5>>버스 정류장
		<<case 4>>게임 가게
		<<case 3>>쇼핑센터
		<<case 2>>공원
		<<case 1>>숲 근처
		<<default>><span class="red">하이 스트리트 어딘가 (버그입니다)</span>
	<</switch>>
	|
	남은 시간: <<print Math.max(0, $photo_timer)>>분
	|
	<<set Math.clamp($photo_location, 1, 7)>>
	돌린 전단지 수: <<print $photo_flyers>>
	|
	<<photo_high_check_location>>
	<<if $photo_attention[_photo_location] gte 9>>
		<span class="red">더 안전한 곳으로 이동해야 한다</span>
	<<elseif $photo_attention[_photo_location] gte 5>>
		<span class="purple">불쾌한 시선을 끌고 있다</span>
	<<elseif $photo_attention[_photo_location] gte 1>>
		<span class="blue">사람들이 당신 쪽을 쳐다본다</span>
	<<else>>
		<span class="lblue">몇 번 의상을 흘끗 쳐다보는 것을 제외하면 사람들은 당신을 무시한다</span>
	<</if>>
	|
	<<if $photo_heat gte 60>>
		<span class="red">너무 더워서 쪄 죽을 것 같다</span><<ggstress>><<stress 12>>
	<<elseif $photo_heat gte 30>>
		<span class="purple">불쾌할 정도로 덥다</span><<gstress>><<stress 6>>
	<<elseif $photo_heat gte 10>>
		<span class="blue">몸에 열이 오르고 있다</span>
	<<else>>
		<span class="green">너무 덥지는 않다</span>
	<</if>>
	<br><br>
<</widget>>

<<widget "photo_heat">>
	<<set _photo_heat to _args[0]>>
	<<if _photo_heat gt 0>>
		<<set _photo_heat *= ((Weather.temperature + 90) / 100)>>
		<<if $worn.upper.name isnot "naked">>
			<<set _photo_heat *= 1.2>>
		<</if>>
		<<if $worn.under_lower.name isnot "naked">>
			<<set _photo_heat *= 1.2>>
		<</if>>
	<</if>>
	<<set $photo_heat += _photo_heat>>
	<<set Math.clamp($photo_heat, 0, 100)>>
<</widget>>

<<widget "photo_attention">>
	<<photo_high_check_location>>
	<<if _args[0]>>
		<<set $photo_attention[_photo_location] += _args[0]>>
	<</if>>
<</widget>>

<<widget "photo_interest">>
	<<if _args[0]>>
		<<set $photo_interest += _args[0]>>
	<</if>>
<</widget>>

<<widget "photo_pass">>
	<<pass _args[0]>>
	<<set $photo_timer -= _args[0]>>
<</widget>>

<<widget "photo_init">>
	<<set $photo_heat to 0>>
	<<set $photo_timer to 120>>
	<<set $photo_interest to 0>>
	<<set $photo_attention to {
		sea: 0,
		statue: 0,
		bus_stop: 0,
		shop: 0,
		shopping_centre: 0,
		park: 0,
		forest: 0,
	}>>
	<<set $photo_location to 4>>
	<<set $photo_flyers to 0>>
<</widget>>

<<widget "photo_unset">>
	<<unset $photo_heat>>
	<<unset $photo_timer>>
	<<unset $photo_interest>>
	<<unset $photo_attention>>
	<<unset $photo_abduction_timer>>
	<<unset $photo_location>>
	<<unset $photo_flyers>>
<</widget>>

<<widget "photo_high_gang_load">>
	<<if $per_npc.photo_high_gang_1>>
		<<loadNPC 0 "photo_high_gang_1">>
		<<loadNPC 0 "photo_high_gang_2">>
		<<loadNPC 0 "photo_high_gang_3">>
		<<loadNPC 0 "photo_high_gang_4">>
	<<else>>
		<<generate1>>
		<<generate2>>
		<<generate3>>
		<<generate4>>
		<<person1>>
	<</if>>
<</widget>>

<<widget "photo_high_gang_clear">>
	<<clearNPC "photo_high_gang_1">>
	<<clearNPC "photo_high_gang_2">>
	<<clearNPC "photo_high_gang_3">>
	<<clearNPC "photo_high_gang_4">>
	<<unset $photo_high_abduction_options>>
<</widget>>
