:: Toy Shop Lock
<<set $outside to 0>><<effects>><<set $lock to 200>>

<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		<span class="blue">팔이 묶여 있지만 않다면</span> 자물쇠를 딸 수 있을 것 같다.
		<br><br>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span>
		<br><br>
		<<lockicon "pick">><<link [[자물쇠를 딴다 (0:10)|Toy Shop]]>><<pass 10>><<crimeUp 15 "trespassing">><</link>><<crime "trespassing">>
		<br>
	<</if>>
<<else>>
	<span class="red">자물쇠는 당신의 실력으로 딸 수 없을 것 같다.</span>
	<<skulduggeryrequired>>
	<br><br>
<</if>>

<<getouticon>><<link [[나간다|Shopping Centre Top]]>><</link>>
<br>

:: Toy Shop
<<set $outside to 0>><<effects>><<set $lock to 0>>

<<if $player.inventory.childrenToys is undefined>>
	<<set $player.inventory.childrenToys to []>>
<</if>>
<<if !$storedChildrenToys>><<set $storedChildrenToys to {}>><</if>>

당신은 장난감 가게에 있다. 바닥부터 천장까지 온갖 종류의 장난감들이 당신 앞에 서 있다. 많은 것들이 상자에 담겨 있고, 다른 것들은 바로 가지고 놀 수 있도록 준비되어 있다.
<<if $pregnancyStats.humanToysUnlocked>>
	이곳에 있으니 아이들 생각이 절로 난다.
<</if>>
<<if random(0,200) gt 199 and Time.dayState isnot "night">>
	<br><br>
	브렐카를 타고 쌩쌩 달리는 아이가 보인다.
	<<if !$daily.seenVrelcar>>
		<<set $daily.seenVrelcar to true>>
		<<trauma -60>><<lltrauma>>
	<</if>>
<</if>>
<br><br>

<<if Time.dayState is "night" and Time.hour isnot $closinghour>>
	어둠 속에 당신 혼자뿐이다.
	<br><br>
<<elseif $exposed gte 1>>
	수치심을 면하기 위해 찬장 안에 숨는다.
	<br><br>
<</if>>

<<if $stress gte 10000>>
	<<passoutshop "shop">>
<<else>>
	<<if Time.hour is 21>>
		폐점 시간이다. 경비원이 모두를 밖으로 내보내고 있다. <<if $exposed gte 1>>경비원이 이런 옷차림의 당신을 발견하면 얼마나 노출될지 깨닫자 공포가 밀려온다.<</if>>
		<br><br>

		<<if $exposed lte 0>>
			<<highicon>><<link [[밖으로 나가기|High Street]]>><</link>>
			<br>
		<<else>>
			<<ind>><<link [["끝날 때까지 숨어 있는다 (1:00)"|Toy Shop]]>><<pass 1 hour>><</link>>
		<</if>>
	<<else>>

		<<if Time.dayState is "night" and Time.hour isnot $closinghour and !$weekly.theft.toyShop>>
			<<shopicon "register">><<link [[금전 등록기를 살펴본다|Toy Shop Register]]>><</link>>
			<br><br>
		<</if>>

		<<toySelection>>
		<<if $exposed lte 1 and Time.dayState isnot "night" and Time.hour isnot 21>>
			<<if $pregnancyStats.humanToysUnlocked>>
				<<childicon "teddy bear">><<link [[장난감|Toy Shop Item]]>><<set $selectedToy to clone(_toySelection["teddyBear"])>><</link>>
				<br><br>
			<</if>>
		<</if>>
		<<getouticon>><<link [[나간다|Shopping Centre Top]]>><</link>>
	<</if>>
<</if>>

:: Toy Shop Item
<<dynamic "toyUpdate" "toy-update-container">>
<br>
<<getouticon>><<link [[돌아가기|Toy Shop]]>><<run delete $selectedToy>><</link>>
<br>
<<toySelection>>
<<set $selectedToy to $selectedToy || clone(_toySelection["teddyBear"])>>
<hr>
<div class="settingsHeader">장난감</div>
<div id="toyContainer">
	<<dynamic "toyLinks" "toyContainerHeader">>
	<<dynamic "toyList" "toy-menu-container">>
</div>

:: Toy Shop Widgets [widget]
<<widget "toyUpdate">>
	<<toySelection>>
	<<set _category to Object.values(_toySelection).find(entry => entry.set is $selectedToy.set)>>
	당신은 <<print _category ? window.KR.getToyNameKr(_toySelection, _category.name) : window.KR.getToyNameKr(_toySelection, $selectedToy.name)>> 모음을 살펴본다. 가격은 각각 <span class="gold"><<print $selectedToy.costDisplay>></span>이다.
<</widget>>

<<widget "toyLinks">>
	<<toySelection>>
	<<set _toyIds to Object.keys(_toySelection)>>
	<<for _i to 0; _i lt _toyIds.length; _i++>>
		<<set _id to _toyIds[_i]>>
		<<set _entry to _toySelection[_id]>>
		<div @class="$selectedToy.set is _entry.set ? 'shopTabSelected' : 'shopTab'">
			<button
				@class="($selectedToy.set is _entry.set ? 'selected' : '')"
				@id="Dynamic.eventBinder(_id)"
				onclick="(id) => $selectedToy = T.toySelection[id]"
			><<print window.KR.getToyNameKr(_toySelection, _entry.name)>>
			</button>
		</div>
	<</for>>
<</widget>>

<<widget "toyList">>
	<<toySelection>>
	<<if $selectedToy.options>>
		<<set _numberOnHand to {}>>
		<<for _i to 0; _i lt $player.inventory.childrenToys.length; _i++>>
			<<if $player.inventory.childrenToys[_i].set is $selectedToy.set>>
				<<if _numberOnHand[$player.inventory.childrenToys[_i].name] is undefined>>
					<<set _numberOnHand[$player.inventory.childrenToys[_i].name] to 1>>
				<<else>>
					<<set _numberOnHand[$player.inventory.childrenToys[_i].name]++>>
				<</if>>
			<</if>>
		<</for>>
		<<if $player.inventory.childrenToys.length gte 1>>
			<<set $_toys = V.player.inventory.childrenToys.map(function(item) {
				return '<span class="' + item.colour + '">' + window.KR.getToyNameKr(_toySelection, item.name) + '</span>';
			}).join(", ")>>
			보유한 장난감 (총 <<number $player.inventory.childrenToys.length>>개): <<= $_toys>>
		<<else>>
			장난감을 가지고 있지 않습니다.
		<</if>>
		<br>
		<<if $player.inventory.childrenToys.length gte 5>>
			<span class="description">장난감은 한번에 5개 까지만 보유 할 수 있습니다.</span>
		<</if>>
		<hr>
		<div id="toyContainer">
			<<capture _i>>
				<<for _i to 0; _i lt $selectedToy.options.length; _i++>>
					<div class="shopBlock no-numberify">
					<label>
						<<set _icon to $selectedToy.options[_i].name.toLowerCase().replace(".","").replace(" ","_")>>
						<<childicon _icon>>
						<span @class="$selectedToy.options[_i].colour">
							<<print window.KR.getToyNameKr(_toySelection, $selectedToy.options[_i].name)>>
						</span>
						|
						<<if $player.inventory.childrenToys.length gte 5>>
							<span class="grey"><<= "£"+$selectedToy.cost/100>></span>
						<<elseif $selectedToy.cost lte $money>>
							<<link [['£' + $selectedToy.cost/100|$passage]]>><<set $selectedToy.selectedOption to _i>><<buyToy>><</link>>
						<<else>>
							<span class="red"><<= "£"+$selectedToy.cost/100>></span>
						<</if>>
					</label>
					</div>
				<</for>>
			<</capture>>
		</div>
	<</if>>
<</widget>>

<<widget "toySelection">>
	<<set _toySelection to {
		"babyRattle":
			{
				set:"baby rattles", name:"baby rattle", name_lower: "딸랑이", cost:1000, costDisplay:"£10", selectedOption: 0, type:"human",
				options: [
					{"colour":"pink","name":"Pink baby rattle","name_lower":"분홍색 딸랑이","optionsName":"Pink"},
					{"colour":"blue","name":"Blue baby rattle","name_lower":"파란색 딸랑이","optionsName":"Blue"},
					{"colour":"green","name":"Green baby rattle","name_lower":"초록색 딸랑이","optionsName":"Green"},
					{"colour":"red","name":"Red baby rattle","name_lower":"빨간색 딸랑이","optionsName":"Red"},
					{"colour":"gold","name":"Yellow baby rattle","name_lower":"노란색 딸랑이","optionsName":"Yellow"},
				],

			},
		"teddyBear":
			{
				set:"teddy bears", name:"Teddy bear", name_lower: "테디 베어", cost:4000, costDisplay:"£40", selectedOption: 0, type:"human",
				options: [
					{"colour":"tan","name":"Teddy bear","name_lower":"테디 베어","optionsName":"Teddy Bear"},
					{"colour":"blue","name":"Mr. Teddy","name_lower":"미스터 테디","optionsName":"Mr. Teddy"},
					{"colour":"pink","name":"Mrs. Teddy","name_lower":"미세스 테디","optionsName":"Mrs. Teddy"},
					{"colour":"gold","name":"Clown","name_lower":"광대","optionsName":"Clown"},
					{"colour":"green","name":"Green robot","name_lower":"초록색 로봇","optionsName":"Green Robot"},
					{"colour":"red","name":"Red robot","name_lower":"빨간색 로봇","optionsName":"Red Robot"},
					{"colour":"light-pink","name":"Baby doll","name_lower":"아기 인형","optionsName":"Baby Doll"},
				],

			},
		"toyCar":
			{
				set:"toy cars", name:"Toy car", name_lower: "장난감 자동차", cost:1500, costDisplay:"£15", selectedOption: 0, type:"human",
				options: [
					{"colour":"pink","name":"Pink mini toy car","name_lower":"분홍색 미니 장난감 자동차","optionsName":"Pink Mini"},
					{"colour":"blue","name":"Blue toy racecar","name_lower":"파란색 장난감 경주차","optionsName":"Blue Racecar"},
					{"colour":"green","name":"Green toy racecar","name_lower":"초록색 장난감 경주차","optionsName":"Green Racecar"},
					{"colour":"red","name":"Hot rod toy car","name_lower":"핫로드 장난감 자동차","optionsName":"Hot Rod"},
					{"colour":"grey","name":"Limousine toy car","name_lower":"리무진 장난감 자동차","optionsName":"Limousine"},
				],

			},
		"chewToy":
			{
				set:"chew toys", name:"chew toy", name_lower: "터그 장난감", cost:1500, costDisplay:"£15", selectedOption: 0, type:"wolf",
				options: [
					{"colour":"grey","name":"Chew bone","name_lower":"씹는 뼈다귀","optionsName":"Chew Bone"},
					{"colour":"light-green","name":"Chew ball","name_lower":"씹는 공","optionsName":"Chew Ball"},
					{"colour":"light-grey","name":"Squeaky sheep","name_lower":"삑삑이 양","optionsName":"Squeaky Sheep"},
					{"colour":"gold","name":"Squeaky chicken","name_lower":"삑삑이 닭","optionsName":"Squeaky Chicken"},
					{"colour":"softbrown","name":"Rope","name_lower":"밧줄","optionsName":"Rope"},
				],

			},
		"dummy":
			{
				set:"dummies", name:"dummy", name_lower: "고무 젖꼭지", cost:500, costDisplay:"£5", selectedOption: 0, type:"human",
				options: [
					{"colour":"pink","name":"Pink dummy","name_lower":"분홍색 고무 젖꼭지","optionsName":"Pink"},
					{"colour":"blue","name":"Blue dummy","name_lower":"파란색 고무 젖꼭지","optionsName":"Blue"},
					{"colour":"green","name":"Green dummy","name_lower":"초록색 고무 젖꼭지","optionsName":"Green"},
					{"colour":"red","name":"Red dummy","name_lower":"빨간색 고무 젖꼭지","optionsName":"Red"},
					{"colour":"gold","name":"Yellow dummy","name_lower":"노란색 고무 젖꼭지","optionsName":"Yellow"},
					{"colour":"light-grey","name":"White dummy","name_lower":"하얀색 고무 젖꼭지","optionsName":"White"},
					{"colour":"light-grey","name":"Clear dummy","name_lower":"투명한 고무 젖꼭지","optionsName":"Clear"},
				],

			},
	}>>
<</widget>>

<<widget "buyToy">>
	<<money `-$selectedToy.cost` "toyShop">>
	<<if $selectedToy.options>>
		<<set _selectedOption to $selectedToy.selectedOption>>
		<<if $selectedToy.options[_selectedOption].name>>
			<<set $selectedToy.name to clone($selectedToy.options[_selectedOption].name)>>
			<<set $selectedToy.name_lower to clone($selectedToy.options[_selectedOption].name_lower)>>
		<</if>>
		<<if $selectedToy.options[_selectedOption].colour>>
			<<set $selectedToy.colour to clone($selectedToy.options[_selectedOption].colour)>>
		<</if>>
	<</if>>
	<<run $player.inventory.childrenToys.push(clone($selectedToy))>>
<</widget>>
