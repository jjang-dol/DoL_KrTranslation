:: Tattoo Parlour Lock

<<set $outside to 0>><<effects>><<set $lock to 0>>

<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		<span class="blue">팔이 묶여 있지만 않다면</span> 자물쇠를 딸 수 있을 것 같다.
		<br><br>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span>
		<br><br>
		<<lockicon "pick">><<link [[자물쇠를 딴다 (0:10)|Tattoo Parlour]]>><<pass 10>><<crimeUp 10 "trespassing">><</link>><<crime "trespassing">>
		<br>
	<</if>>
<<else>>
	<span class="red">이 자물쇠는 당신의 실력으로 딸 수 없을 것 같다.</span>
	<<skulduggeryrequired>>
	<br><br>
<</if>>

<<getouticon>><<link [[떠난다|Shopping Centre]]>><</link>>
<br>

:: Tattoo Parlour

<<set $outside to 0>><<effects>><<set $lock to 0>>

당신은 문신 시술소에 있다. 이곳의 타투이스트들은 당신 몸에 그려진 것을 문신으로 바꿀 수 있다. 선택 가능한 문신 도안도 준비되어 있다. 비용은 <<printmoney 50000>>【이】다.
<br><br>

<<if Time.dayState is "night" and Time.hour isnot $closinghour>>
	당신은 어둠 속에 혼자 있다.
	<br><br>
<<elseif $exposed gte 1>>
	당신은 존엄성을 지키기 위해 찬장에 숨는다.
	<br><br>
<</if>>

<<if $stress gte $stressmax>>
	<<passoutshop "shop">>
<<else>>
	<<if Time.hour is 21>>
		폐점 시간이다. 경비원이 모든 사람을 밖으로 몰아내고 있다. <<if $exposed gte 1>>경비원이 이 옷차림을 본다면 얼마나 노출되어 있을지 깨닫고 공황 상태에 빠진다.<</if>>
		<br><br>

		<<if $exposed lte 0>>
			<<highicon>><<link [[밖으로 나간다|High Street]]>><</link>>
			<br>
		<<else>>
			<<ind>><<link [["끝날 때까지 숨는다 (1:00)"|Tattoo Parlour]]>><<pass 1 hour>><</link>>
		<</if>>
	<<else>>
		<<if Time.dayState is "night" and Time.hour isnot $closinghour and !$weekly.theft.tattooParlour>>
			<<shopicon "register">><<link [[금전 등록기를 살펴본다|Tattoo Parlour Register]]>><</link>>
			<br><br>
		<<elseif $exposed lte 1 and Time.dayState isnot "night" and Time.hour isnot 21>>
			<<if $money lt 50000>>
				문신을 받을 돈이 없다.
				<br><br>
			<<else>>
				<<shopicon "tattoo">><<link [[문신을 받는다|Tattoo Choice]]>><</link>>
				<br>
				<<shopicon "tattoo">><<link [[몸의 낙서를 문신으로 바꾼다|Tattoo Bodywriting Choice]]>><</link>>
				<br><br>
			<</if>>
		<</if>>
		<<getouticon>><<link [[떠난다|Shopping Centre]]>><</link>>
	<</if>>
<</if>>

:: Tattoo Bodywriting Choice
<<effects>>

<<for _active_bodypart range setup.bodyparts>>
	<<set _part to $skin[_active_bodypart]>>
	<<switch _part.pen>>
		<<case "pen" "marker" "lipstick" "mud">>
			당신의 <<bodypart _active_bodypart>>에
			<<if _part.type is "text">>
				<span class="pink">"<<print window.KR.getBodywritingKr(_part.writing)>>"</span> 글귀가 적혀 있다.
			<<else>>
				<span class="pink"><<print window.KR.getBodywritingKr(_part.writing)>></span>【이가】 그려져 있다.
			<</if>>
			<<set _tooShy to (["left_bottom","right_bottom","pubic","breasts"].includes(_active_bodypart) and !hasSexStat("exhibitionism", 3))>>
			<<set _deviant to ["bestiality", "Black Wolf", "Great Hawk"].includes(_part.special)>>
			<<set _lewd to _part.lewd is 1>>
			<<if $money lte 50000>>
				<span class="red">그것을 문신으로 바꿀 돈이 없다.</span>
			<<elseif (_deviant and !hasSexStat("deviancy", 3)) or (_lewd and !hasSexStat("promiscuity", 3))>>
				<<set _lewdOrDeviant to (_deviant and !hasSexStat("deviancy", 3) ? "이상성욕적이지" : "음란하지")>>
				<<if _tooShy>>
					<span class="blue">타투이스트에게 당신의 <<bodypart _active_bodypart>>【을를】 보여주는 것을 견딜 수 없으며, 애초에 이런 것을 문신으로 만들 만큼 충분히 _lewdOrDeviant 않다.</span>
				<<else>>
					<span class="blue">그런 것을 문신으로 만들 만큼 _lewdOrDeviant도 않다.</span>
				<</if>>
				<<unset _lewdOrDeviant>>
			<<elseif _tooShy>>
				<span class="blue">문신 아티스트에게 당신의 <<bodypart _active_bodypart>>【을를】 보여줄 수 없다.</span>
			<<else>>
				<<capture _active_bodypart _part _deviant _lewd>>
					| <<link [[문신으로 바꾸기 (£500 1:00)|Tattoo Bodywriting]]>>
						<<pass 60>><<money -50000 "tattoo">><<set $tattoo_bodypart to _active_bodypart>><<set $tattoo_parlour to clone(_part)>>
						<<if _lewd or _deviant>><<control 50>><<else>><<control 25>><</if>>
						<<set _part.pen to "tattoo">><<pain 6>>
					<</link>><<if _lewd or _deviant>><<gggcontrol>><<else>><<ggcontrol>><</if>><<gpain>>
				<</capture>>
			<</if>>
			<<unset _tooShy>><<unset _deviant>><<unset _lewd>>
		<<case "tattoo">>
			당신의 <<bodypart _active_bodypart>>【은는】 이미 문신이 있다.
		<<case "brand">>
			당신의 <<bodypart _active_bodypart>>에 <span class="red">낙인</span>이 찍혀 있다.
		<<case "magic">>
			당신의 <<bodypart _active_bodypart>>에 마법적인 <span class="pink">문장</span>이 새겨져 있다.
		<<default>>
			당신의 <<bodypart _active_bodypart>>에는 아무것도 적혀 있지 않다.
	<</switch>>
	<br>
<</for>>
<br>
<<if hasSexStat("promiscuity", 3)>>
	<<link [[문신으로 새길 문장 생각하기|Tattoo Bodywriting Write]]>><</link>>
	<br>
<</if>>
<<link [[뒤로|Tattoo Parlour]]>><</link>>

:: Tattoo Choice
<<effects>>

문신 도안이 그려진 게시판이 있다.
<br><br>

위치:<br>
<<for _active_bodypart range setup.bodyparts>>
	<<if !$skin[_active_bodypart].writing>>
		<<set _bodypart_detected to 1>>
		<label><<bodypart _active_bodypart>> <<capture _active_bodypart>><<radiobutton "$tattoo_bodypart" _active_bodypart>><</capture>></label>
		<br>
	<</if>>
<</for>>
<<if _bodypart_detected isnot 1>>
	<span class="red">피부에 더 이상 빈 공간이 없다.</span>
	<br>
<</if>>
<br>

<span class="pink">소녀스러운</span> 문신:
<br>
<label>유니콘 <span class="pink">♀</span> <<radiobutton "$tattoo_choice" "unicorn">></label> |
<label>하트 <span class="pink">♀</span> <<radiobutton "$tattoo_choice" "heart">></label> |
<label>꽃 <span class="pink">♀</span> <<radiobutton "$tattoo_choice" "flower">></label> |
<label>나비 <span class="pink">♀</span> <<radiobutton "$tattoo_choice" "butterfly">></label> |
<label>별 <span class="pink">♀</span> <<radiobutton "$tattoo_choice" "star">></label> |

<br><br>
<span class="blue">소년스러운</span> 문신:
<br>
<label>해골 <span class="blue">♂</span> <<radiobutton "$tattoo_choice" "skull">></label> |
<label>불꽃 <span class="blue">♂</span> <<radiobutton "$tattoo_choice" "flame">></label> |

<br><br>

<span class="gold">신성한</span> 문신:
<br>
<label>십자가 <<radiobutton "$tattoo_choice" "cross">></label> |

<br><br>

<span class="lewd">변태적인</span> 문신:
<br>
<<if hasSexStat("deviancy", 3)>>
	<label>동물 발자국 <<radiobutton "$tattoo_choice" "paw_print">></label> |
<<else>>
	당신은 충분히 도착적이지 않다.
<</if>>
<br><br>

<<link [[시술을 받는다 (£500 1:00)|Tattoo Get]]>><</link>><<gpain>>
<br>
<<link [[돌아가기|Tattoo Parlour]]>><<unset $tattoo_bodypart>><<unset $writebodyaction>><</link>>

:: Tattoo Get

<<effects>>
<<if $tattoo_bodypart and $tattoo_choice>>
	<<set $tattoo_parlour to clone(setup.bodywriting[$tattoo_choice])>>
	<<add_bodywriting $tattoo_bodypart $tattoo_choice tattoo>><<pass 60>><<money -50000 "tattoo">>
	<<pain 6>>

	<<tattoo_parlour>>

	<<link [[다음|Tattoo Parlour]]>><</link>>
	<br>
<<elseif $tattoo_choice>>
	<span class="blue">문신을 새길 부위를 선택해야 합니다.</span>
	<br><br>

	<<unset $tattoo_choice>>

	<<link [[다음|Tattoo Choice]]>><</link>>
	<br>
<<elseif $tattoo_bodypart>>
	<span class="blue">어떤 문신을 새길지 선택해야 합니다.</span>
	<br><br>

	<<unset $tattoo_bodypart>>

	<<link [[다음|Tattoo Choice]]>><</link>>
	<br>
<<else>>
	<span class="blue">문신을 새길 부위와 이미지를 선택해야 합니다.</span>
	<br><br>

	<<link [[다음|Tattoo Choice]]>><</link>>
<</if>>

:: Tattoo Bodywriting

<<effects>>
<<tattoo_parlour>>
<<link [[다음|Tattoo Parlour]]>><</link>>

:: Tattoo Bodywriting Write

<<effects>>

<<if $bodyWritingSelected is null>>
	<<unset $bodyWritingSelected>>
<</if>>
<<if $bodyWritingSelected isnot undefined>>
	당신은 타투이스트에게 당신의 <<bodypart $bodyPartSelected>>에
	<<if isLoveInterest($skin[$bodyPartSelected].special)>>
		"<span class="lewd"><<print $bodyWritingSelected>></span>"
	<<elseif $skin[$bodyPartSelected].special isnot "none">>
		"<span class="red"><<print $bodyWritingSelected>></span>"
	<<elseif $skin[$bodyPartSelected].lewd is 1>>
		"<span class="pink"><<print $bodyWritingSelected>></span>"
	<<else>>
		"<span class="purple"><<print $bodyWritingSelected>></span>"
	<</if>>
	라고 적어 달라고 말하고, 그 결과를 살펴본다.

	<<set _part to $skin[$bodyPartSelected]>>
	<<set _lewd to _part.lewd is 1>>
	<<set _deviant to ["bestiality", "Black Wolf", "Great Hawk"].includes(_part.special)>>

	<br><br>
	<<link [[문신으로 바꾼다 (£500 1:00)|Tattoo Bodywriting]]>>
		<<pass 60>>
		<<money -50000 "tattoo">>
		<<pain 6>>
		<<if _lewd or _deviant>>
			<<control 50>>
		<<else>>
			<<control 25>>
		<</if>>
		<<set $tattoo_bodypart to $bodyPartSelected>>
		<<set $tattoo_parlour to clone(_part)>>
		<<set _part.pen to "tattoo">>
		<<unset $bodyWritingSelected>>
		<<unset $bodyPartSelected>>
		<<unset $bodywritingSet>>
	<</link>><<gpain>><<if _lewd or _deviant>><<gggcontrol>><<else>><<ggcontrol>><</if>>

	<br>
	<<link [[다른 것을 적는다|Tattoo Bodywriting Write]]>>
		<<bodywriting_clear $bodyPartSelected>>
		<<unset $bodyWritingSelected>>
		<<unset $bodyPartSelected>>
		<<unset $bodywritingSet>>
	<</link>>
<<else>>
	<<link [[뒤로|Tattoo Bodywriting Choice]]>><<unset $bodywritingSet>><</link>>
	<br><br>

	당신은 문신으로 어떤 말을 새길지 생각한다.
	<br><br>
	__낙서__<br>

	<<bodywriting>><br>

	<<bodywritingOptions>>

	<<set _bodyPartOptionsSkip to []>>
	<<if !hasSexStat("exhibitionism", 3)>>
		<<set _bodyPartOptionsSkip to _bodyPartOptionsSkip.concat(["left_bottom","right_bottom","pubic","breasts"])>>
	<</if>>

	<<bodywritingMenuLinks _bodyPartOptionsSkip>>
<</if>>
