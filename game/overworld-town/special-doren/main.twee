	<</if>>
	<<link [[괜찮다고 말한다|Doren Loft 7]]>><<set $phase to 3>><</link>><br>
	<<link [[무너져 내린다|Doren Loft 7]]>><<set $phase to 4>><<trauma -6>><<stress -12>><<pain -4>><<npcincr Doren love 1>><<npcincr Doren dom 1>><</link>><<glove>><<gdom "Doren">><<gcontrol>><<ltrauma>><<lstress>><<lpain>><br>
	<<link [[아무 일도 없었던 것처럼 행동한다|Doren Loft 7]]>><<set $phase to 5>><</link>><br>
<<else>>
