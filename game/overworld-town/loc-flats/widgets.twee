:: Widgets Flats [widget]
<<widget "hookah_master">>
<<if $pronoun is "f">>여주인님<<else>>주인님<</if>>
<</widget>>

<<widget "hookah_init">>
<<set $hookah to {}>>
<<set $hookah.lurkers to 1>>
<<set $hookah.juice to 0>>
<</widget>>

<<widget "hookah_juice">>

<<if $hookah.juice gte 1>>
	물담배에는 <<number $hookah.juice>>회 즐길 만큼 즙이 남아 있다,
<<else>>
	물담배에는 즙이 하나도 없다,
<</if>>
그리고
<<switch $hookah.lurkers>>
	<<case 5>>
		<span class="green">다섯 마리의</span>
	<<case 4>>
		<span class="teal">네 마리의</span>
	<<case 3>>
		<span class="lblue">세 마리의</span>
	<<case 2>>
		<span class="blue">두 마리의</span>
	<<case 1>>
		<span class="purple">한 마리의</span>
	<<default>>
		<span class="pink">아무</span>
<</switch>>
<<number $hookah.lurkers>>마리의 럴커가 냉장고에 들어 있다.
<br><br>

<<if $hookah.juice is 0>>
	<<if $lurkers_held gte 1>>
		<<birdicon "lurker_netted">><<link [[가지고 있는 럴커로 즙을 보충한다|Flats Hookah Juice Carried]]>><<set $lurkers_held -= 1>><<set $hookah.juice += 50>><</link>>
		<br>
	<<else>>
		<<set _no_lurkers_held to 1>>
	<</if>>
	<<if $hookah.lurkers gte 1>>
		<<birdicon "lurkers">><<link [[냉장고의 럴커로 즙을 보충한다|Flats Hookah Juice Fridge]]>><<set $hookah.lurkers -= 1>><<set $hookah.juice += 50>><</link>>
		<br>
	<<else>>
		<<set _no_lurkers_stored to 1>>
	<</if>>
	<<if _no_lurkers_held is 1 and _no_lurkers_stored is 1>>
		<span class="blue">당신에겐 즙을 보충할 럴커가 하나도 없다.</span>
		<br>
	<</if>>
<</if>>
<<if $lurkers_held gte 1 and $hookah.lurkers lt 5>>
	<<icon "fridge.png">><<link [[럴커를 냉장고에 보관한다|Flats Hookah Fridge]]>><<set $lurkers_held -= 1>><<set $hookah.lurkers += 1>><</link>>
	<br>
<</if>>
<</widget>>

<<widget "flats_canal">>
<<if _args[0]>>
	<<set $flats_canal += _args[0]>>
	<<set $flats_canal to Math.clamp($flats_canal, 0, 100)>>
<</if>>
<</widget>>

<<widget "flats_canal_defeat">>
<<if $flats_canal gte 50>>
	"괜찮아," <<person1>><<person>>【이가】 분노가 서린 목소리로 말한다. "다른 방법으로 갚으면 되니까. <span class="red">우리 각자에게 빚진 거 잊지 마.</span>"
	<br><br>
	<<generate2>><<generate3>><<generate4>><<generate5>><<generate6>>
	<<link [[다음|Flats Canal Rape]]>><<set $molestationstart to 1>><</link>>
	<br>
<<else>>
	그들이 당신을 놓아주더니, 이내 몸 위로 폭풍 같은 발길질이 쏟아진다. 당신은 몸을 웅크린다.<<ggpain>><<gtrauma>><<gstress>><<pain 4>><<trauma 6>><<stress 6>>
	<br><br>
	구타가 멈춘다. <<person>>【이가】 당신의 머리채를 거머쥐고, 당신을 무릎 꿇게 만든다. "괜찮아," <<he>>【이가】 분노가 서린 목소리로 말한다. "다른 방법으로 갚으면 되니까."
	<br><br>

	<<link [[다음|Flats Canal Oral]]>><<set $molestationstart to 1>><</link>>
	<br>
<</if>>
<</widget>>

<<widget "flats_canal_run">>
<<link [[달아난다|Flats Canal Run]]>><<flats_canal 9>><</link>>
<<if Weather.precipitation isnot "none">>
	<<athleticsdifficulty 400 1400>><<gggimpatience>><<note "날씨 때문에 운하가 진흙으로 가득 차 달리기 어려워졌으며, 실패하면 매우 위험할 수 있다" "red">>
	<br>
<<else>>
	<<athleticsdifficulty 1 1000>><<gggimpatience>><<note "실패하면 매우 위험할 수 있다" "red">>
	<br>
<</if>>
<</widget>>

<<widget "passout_flats">>
<<passout>>

<<if dangerEvent()>>
	<<link [[다음|Flats Auction]]>><</link>>
	<br>
<<else>>
	<<ambulance>>
<</if>>
<</widget>>

<<widget "flats_auction_end">>
<<unset $flats_auction>>
<<unset $flats_auction_fame>>
<<unset $flats_auction_select>>
<</widget>>

<<widget "flats_alarm_time">>
<<switch $flats_alarm_time>>
	<<case 4>>
		<span class="purple">"4분 남았습니다." 안내 방송이 울린다.</span>
		<br><br>
		<<flats_alarm_links>>
	<<case 3>>
		<span class="blue">"3분 남았습니다." 안내 방송이 울린다. "순종적인 자세를 취해 주십시오."</span>
		<br><br>
		<<flats_alarm_links>>
	<<case 2>>
		<span class="purple">"2분 남았습니다." 안내 방송이 울린다.</span>
		<br><br>
		<<flats_alarm_links>>
	<<case 1>>
		<span class="pink">"1분 남았습니다." 안내 방송이 울린다. "지원이 임박했습니다."</span>
		<br><br>
		<<flats_alarm_links>>
	<<default>>
		<<generate1>><<generate2>>
		<span class="red">"경찰이 현장에 도착했습니다." 안내 방송이 울린다. "좋은 하루 보내십시오."</span> 셔터가 열리고, <<person1>><<person>>【와과】 <<person2>><<person>>【으로로】 이루어진 경찰관 두 명이 성큼성큼 들어온다.
		<br><br>

		"한 명 여깄군." <<person1>><<person>>【이가】 말한다. "순순히 따라오는 게 좋을 겁니다." <<person2>><<person>>【이가】 수갑을 꺼내 들며 다가온다.
		<br><br>

		<<link [[조용히 간다|Hospital Arrest Journey]]>><<flats_alarm_end>><</link>>
		<br>
		<<link [[싸운다|Flats Sneak Fight]]>><<handheldon true>><<set $fightstart to 1>><</link>>
		<br>
<</switch>>
<</widget>>

<<widget "flats_alarm_links">>
<<if $flats_alarm_time is 1 and $flats_alarm_fabric lte 1 or $flats_alarm_time is 2 and $flats_alarm_fabric lte 0>>
	<span class="blue">밧줄을 완성할 시간이 부족하다.</span>
	<br>
<<else>>
	<<link [[천으로 밧줄을 만든다 (0:01)|Flats Sneak Housekeeping]]>><<pass 1>><<set $flats_alarm_time -= 1>><</link>><<housekeepingdifficulty 1 700>>
	<br>
<</if>>
<<link [[부수고 나간다 (0:01)|Flats Sneak Physique]]>><<pass 1>><<set $flats_alarm_time -= 1>><</link>><<physiquedifficulty 1 35000>>
<br>
<<if $flats_alarm_time lte 3>>
	<<link [[순종적인 자세를 취하고 경찰을 기다린다|Flats Sneak Assume]]>><</link>>
	<br>
<</if>>
<<if $flats_alarm_time lte 1>>
	<<link [[숨는다|Flats Sneak Hide]]>><</link>><<difficulty 0>>
	<br>
<</if>>
<</widget>>

<<widget "flats_alarm_end">>
<<unset $flats_alarm_time>>
<<unset $flats_alarm_fabric>>
<</widget>>
