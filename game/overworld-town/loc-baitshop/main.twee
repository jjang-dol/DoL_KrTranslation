:: Bait Shop
<<set $daily.fishing ??= {}>>

<div id="clothingShop-div" class="main-shop-div">
	<<baitShopShop-main>>
</div>

<<unset $showPcEnterBaitShopText>>

:: Bait Shop Widgets [widget]

<<widget "baitShopShop-main">>
	<<if $tryOn.autoReset isnot false>><<tryOnReset>><</if>><<unset $tempDisable>>
	<<set $outside to 0>><<set $location to "mer_pier">><<set $bus to "baitShop">><<effects>>
	<<set $shopName = "baitShop">>
	<<set _shopCloseOverride to !baitShopOpen()>>

	<div id="tryonstats-div"><<tryOnStats>></div>
	<<unset $shopListStartCount>>
	<<unset $clothes_choice>>
	<<set $shopPage = 0>>

	<<if !$per_npc.bait_shop_owner>>
		<<generate1>><<saveNPC 0 "bait_shop_owner">><<person1>>
	<<else>>
		<<loadNPC 0 "bait_shop_owner">><<person1>>
	<</if>>

	<<if !baitShopOpen()>>
		당신은 미끼 상점에 혼자 있다. 낚시 릴, 낚싯바늘, 그리고 낚싯줄 뭉치가 구석구석을 차지하고 있다.
	<<else>>
		<<if $fishing.baitShopAmbient is "declinedRecipe">>
			<<He>>【은는】 어깨를 으쓱한다. "상관없죠. 뭐 다른 필요한 건요?"
			<<unset $fishing.baitShopAmbient>>
		
		<<elseif $fishing.baitShopAmbient is "boughtBaitWorms">>
			<<wearProp "bait_worm">>
			<<He>>【은는】 미끼용 지렁이가 든 작은 캔을 건네준다. "<span class="blue">미끼용 물고기</span>를 낚을 게 아니라면, 이 지렁이들 말고 다른 걸 쓰는 게 나을 거예요. 그래도 없는 것보단 낫겠죠. 가진 게 이거뿐이라. 다른 필요한 건요?"

		<<elseif $showPcEnterBaitShopText>>
			문이 삐걱거리며 열리자 잡동사니가 쌓인 카운터 뒤에서 한 <<person>>【이가】 고개를 든다. 비좁은 오두막 안에는 낚시 릴, 낚싯바늘, 그리고 낚싯줄 뭉치가 구석구석을 차지하고 있다.
			<<if !$daily.fishing.baitShopOwnerSpeechIntro>>
				<<set $daily.fishing.baitShopOwnerSpeechIntro to true>>
				<br><br>
				 "장비 찾으세요?" <<he>>【이가】 묻는다.
			<</if>>
		<<else>>
			당신은 미끼 상점에 있다. 낚시 릴, 낚싯바늘, 그리고 낚싯줄 뭉치가 구석구석을 차지하고 있다. 한 <<person>>【이가】 카운터 뒤에 앉아, <<print either("매듭", "밧줄 뭉치", "낚시 루어", "낚시 찌")>>【을를】 만지작거리고 있다.
		<</if>>
		<<unset $fishing.baitShopAmbient>>
	<</if>>
	<br><br>

	<span>온기:</span>
	<<warmthscale>>
	<div id="warmth-description">
		<<warmth_description>>
	</div>
	<br><br>

	<<icon "clothing-shop.png">><<link "장비 둘러보기">><<unset _prop>><<updatesidebarimg>><<replace "#clothingShop-div">><<AllShop>><</replace>><<endevent>><</link>>
	<br>
	<<if baitShopOpen()>>
		<<if $money gte 600>>
			<<foodstufficon "bait_worm">><<link [[미끼용 지렁이 한 팩 (5마리) (£6)|Bait Shop]]>>
				<<money -600 "fishing">>
				<<set $fishing.baitShopAmbient to "boughtBaitWorms">>
				<<tending_give bait_worm 5>>
				<<endevent>>
			<</link>>
		<<else>>
			미끼용 지렁이 한 팩 (5마리) (£6) <span class="blue">돈이 부족하다.</span>
		<</if>>
		<<if $daily.fishing.baitShopRequest is "ready" and $foodstuff[$daily.fishing.baitShopRequestFish]?.amount gte 1>>
			<br>
			<<icon `"fish/" + $daily.fishing.baitShopRequestFish + ".png"`>><<link [[setup.foodstuff[$daily.fishing.baitShopRequestFish].name + " 건네기"|Bait Shop Give Fish]]>><</link>>
		<</if>>
	<</if>>
	<<if !baitShopOpen() and !$weekly.theft.baitShop>>
		<<shopicon "register">><<link [[금전등록기를 살펴본다|Bait Shop Register]]>><</link>>
		<br>
	<</if>>
	<br>
	<<run linkifyDivs('.button-back-to-shop')>>

	<<if baitShopOpen() and $tryOn.value is 0>>
		<<icon "hanger.png">><<link [[탈의실|Changing Room]]>><<ShowUnderEquip "normal">><<set $wardrobeExit to "Bait Shop">><<endevent>><</link>>
		<br>
	<</if>>

	<<if $tryOn.value isnot 0 and baitShopOpen()>>
		<<icon "hanger.png">><<link "옷 반납하기">><<clothingReset>>
			<<updatesidebarimg>>
			<<updatesidebardescription>>
			<<updateallure>>
			<<updatewarmthscale>>
			<<updatewarmthdescription>>
			<<updateclothingshop>>
			<<run updateMoment()>>
		<</link>>
		<br>
		<<if $tryOn.value gt 0 and $tryOn.value lte $money>>
			<<sendItemsToDropdown>>
			<<highicon>><<link "구입한다">><<buyTryOnClothes "wear">><<updatesidebarmoney>><<updateclothingshop>><</link>>
			<br>
			<<wardrobeicon>><<link "구입해서 옷장에 넣는다">>
				<<buyTryOnClothes "wardrobe">>
				<<updatesidebarmoney>>
				<<updatesidebarimg>>
				<<updatesidebardescription>>
				<<updateallure>>
				<<updatewarmthscale>>
				<<updatewarmthdescription>>
				<<updateclothingshop>>
				<<run updateMoment()>>
			<</link>>
			<br>
		<</if>>
	<<else>>
		<<if playerOwnsFishingRod() and baitShopOpen()>>
			<<if $fishing.baitShopIntro is undefined>>
				<<if Time.hour lt 13 and $daily.fishing.baitShopRequest isnot "requested">>
					<<set _exitPassage to "Bait Shop Owner Full Intro">>
				<<else>>
					<<set _exitPassage to "Bait Shop Owner Half Intro">>
				<</if>>
			<<elseif $fishing.baitShopIntro is "halfIntro">>
				<<if Time.hour lt 13>>
					<<if $daily.fishing.baitShopRequest is "willRequest">>
						<<set _exitPassage to "Bait Shop Owner Half Intro Request">>
					<<else>>
						<<set $fishing.baitShopIntro to "fullIntro">>
						<<set _exitPassage to "Mer Pier">>
					<</if>>
				<<else>>
					<<set _exitPassage to "Mer Pier">>
				<</if>>
			<<elseif $fishing.baitShopIntro is "fullIntro">>
				<<set _exitPassage to "Mer Pier">>
			<</if>>
		<<else>>
			<<set _exitPassage to "Mer Pier">>
		<</if>>
		<<getouticon>><<link [[떠난다|_exitPassage]]>>
			<<shopClothingFilterReset>>
			<<ShowUnderEquip "normal">>
			<<ShowUnderEquip "over">>
			<<buyTryOnClothes "wear" "steal">>
			<<set $tryOn.autoReset to true>>
			<<crimeUp `$tryOn.value / 100` "thievery">>
			<<shopHoodCheck>>
			<<shopCommandoCheck>>
			<<endevent>>
		<</link>>
		<<if $tryOn.value gt 0>><<crime "thievery">><</if>>
		<br>
	<</if>>
<</widget>>


<<widget "baitShopFishBehaviorHelp">>
	<<loadNPC 0 "bait_shop_owner">><<person1>>
	<<set _requestFish to setup.fishing.lootTables.fish[$daily.fishing.baitShopRequestFish]>>
	<<switch _requestFish.minigame.behavior>>
		<<case "runner">>
			"<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>> 같은 물고기들은 행동이 뻔해서 잡기 쉬워요. 그냥 지칠 때까지 <span class="blue">도망치다가,</span> 쉬거든요. 도망칠 때는 제자리에 붙들어 두거나, 힘에 자신 있다면 녀석이 날뛰는 걸 억누르고 그냥 당겨버리세요. 보통 <span class="green"><<print setup.foodstuff[_requestFish.preferredBait].plural>></span>【을를】 좋아하는 편이니, 미끼로 쓰면 낚는 데 도움이 될 겁니다. 어때요? 한 마리쯤은 거뜬히 잡아 오실 수 있겠죠?"
		<<case "darter">>
			"<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>>【은는】 잡기 어려운 녀석은 아니에요. 도망치다 서고, 도망치다 서고 할 텐데, 도망칠 때 막아 세우지 못하면 놓치고 말죠. 낚싯줄을 잘 잡아당기기만 하면 문제없을 겁니다. 보통 <span class="green"><<print setup.foodstuff[_requestFish.preferredBait].plural>></span>【을를】 좋아하는 편이니, 미끼로 쓰면 낚는 데 도움이 될 겁니다. 어때요? 한 마리쯤은 거뜬히 잡아 오실 수 있겠죠?"
		<<case "panicked">>
			"<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>> 같은 녀석들은 이리저리 도망치며 요동치는 경향이 있는데, 워낙 멍청해서 줄을 좀 늦춰주면 당신이 있다는 사실조차 까맣게 잊고 얌전해질 겁니다. 하지만 물가로 가까이 당겼을 때 눈치채기라도 하면 보통 <span class="blue">패닉에 빠져서</span> 요동치곤 하죠. 보통 <span class="green"><<print setup.foodstuff[_requestFish.preferredBait].plural>></span>【을를】 좋아하는 편이니, 미끼로 쓰면 낚는 데 도움이 될 겁니다. 어때요? 한 마리쯤은 거뜬히 잡아 오실 수 있겠죠?"
		<<case "thrasher">> /* Only pike */
			"<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>>【은는】 힘이 넘치는 녀석이라 사방팔방으로 <span class="blue">요동치는</span> 걸 좋아하죠. 잡기 쉽지 않아요. 녀석과 계속 힘겨루기를 해야 하는데, 요동칠 때 당기지 못하면 낚아 올릴 수 없죠. 녀석은 당신을 잊어버리지도 않을 테니, 가만히 있을 때 당기려고 하지 마세요. 그랬다간 바로 도망쳐버릴 테니까요. 솔직히 말해서 어차피 한 번쯤은 녀석이 도망치려 들 텐데, 그때 녀석을 막을 준비를 단단히 해두는 게 좋을 겁니다. 미끼로는 <span class="green">미끼용 물고기</span>를 제일 좋아하는데, 그것 없이는 녀석들을 물게 하기가 참 힘들더군요. 어때요? 한 마리쯤은 거뜬히 잡아 오실 수 있겠죠?"
		<<case "slipper">> /* Only eel */
			"<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>>【은는】 아주 <span class="blue">미끄러우니</span>, 언제 낚아 올릴지 조심해야 해요. 물가로 끌어당겼을 때 체력이 많이 남아있을수록 무서운 속도로 도망칠 확률이 높거든요. 미끼로는 <span class="green">미끼용 물고기</span>를 제일 좋아하는데, 그것 없이는 녀석들을 물게 하기가 참 힘들더군요. 어때요? 한 마리쯤은 거뜬히 잡아 오실 수 있겠죠?"
		<<case "anchor">> /* Only cod */
			"<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>>【을를】 낚아 올리는 건 마치 <span class="blue">닻</span>을 끌어올리는 것 같아요. 느리고, 묵직해서 팔이 꽤 아플 겁니다. 하지만 빨리 도망치는 녀석들은 아니니까, 필요하다면 팔을 좀 쉬게 해 줘도 괜찮아요. 미끼로는 <span class="green">미끼용 물고기</span>를 제일 좋아하는데, 그것 없이는 녀석들을 물게 하기가 참 힘들더군요. 어때요? 한 마리쯤은 거뜬히 잡아 오실 수 있겠죠?"
		<<default>>
			<<error { message: "Fish behavior not found for " + $daily.fishing.baitShopRequestFish }>>
	<</switch>>
	<br><br>
<</widget>>

<<widget "baitShopFishLocationHint">>
	<<set _requestFishKey to $daily.fishing.baitShopRequestFish>>
	<<set _coastUnlocked to $fishing.locationsFound.includes("fishingCoastPath")>>
	<<set $fishing.record[_requestFishKey] ??= { numCaught: 0, largest: 0, foundIn: [] }>>
	<<if !_coastUnlocked>>
		<<set _locationPriority to ["fishingPier", "fishingBeach", "fishingForestLake", "fishingMoor"]>>
	<<else>>
		<<set _locationPriority to ["fishingPier", "fishingBeach", "fishingForestLake", "fishingCoastPath", "fishingMoor"]>>
	<</if>>
	/* Locations this fish can actually be found in, in preference order */
	<<set _recommendableLocations to _locationPriority.filter(loc => setup.fishing.lootTables.fish[_requestFishKey].locations[loc] > 0)>>
	/* Recommend the highest-priority spot the player doesn't know about. If the player knows all of them, use the highest-priority spot */
	<<set _fishSpot to _recommendableLocations.find(loc => !$fishing.record[_requestFishKey].foundIn.includes(loc)) ?? _recommendableLocations[0]>>
	<<switch _fishSpot>>
		<<case "fishingBeach">><<set _fishSpotPhrase to "해변가에서">>
		<<case "fishingPier">><<set _fishSpotPhrase to "바로 밖 부두에서">>
		<<case "fishingCoastPath">><<set _fishSpotPhrase to "마을 외곽 절벽 아래에서">>
		<<case "fishingMoor">><<set _fishSpotPhrase to "황무지 밖에서">>
		<<case "fishingForestLake">><<set _fishSpotPhrase to "숲을 지나 호수에서">>
	<</switch>>
	<<set _alreadyFound to $fishing.record[_requestFishKey].foundIn.includes(_fishSpot)>>
	<<if !_alreadyFound>>
		<<run $fishing.record[_requestFishKey].foundIn.push(_fishSpot)>>
	<</if>><span @class="_alreadyFound ? 'blue' : 'gold'"><<= _fishSpotPhrase>></span>
<</widget>>

:: Bait Shop Lock
<<set $outside to 1>><<effects>><<set $lock to 200>>

미끼 상점은 닫혀 있다. <<openinghours 6 19>>
<br><br>

<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		<span class="blue">팔이 묶여 있지만 않다면,</span> 자물쇠를 딸 수 있을 것 같다.
		<br><br>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span>
		<br><br>
		<<lockicon "pick">><<link [[자물쇠를 딴다 (0:10)|Bait Shop]]>><<pass 10>><<crimeUp 10 "trespassing">><</link>><<crime "trespassing">>
		<br>
	<</if>>
<<else>>
	<span class="red">자물쇠는 당신의 기술로는 딸 수 없을 것 같다.</span><<skulduggeryrequired>>
	<br><br>
<</if>>

<<getouticon>><<link [[떠난다|Mer Pier]]>><<endevent>><</link>>


:: Bait Shop Register
<<set $outside to 0>><<effects>><<set $lock to 200>>

잡동사니가 쌓인 카운터 위에 작은 금전등록기가 놓여 있다. 잠겨 있다.
<br><br>

<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		<span class="blue">팔이 묶여 있지만 않다면,</span> 자물쇠를 딸 수 있을 것 같다.
		<br><br>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span>
		<br><br>
		<<lockicon "pick">><<link [[자물쇠를 딴다 (0:10)|Bait Shop Register Sneak]]>><<pass 10>><<crimeUp 10 "thievery">><<endevent>><</link>><<crime "thievery">>
		<br>
	<</if>>
<<else>>
	<span class="red">자물쇠는 당신의 기술로는 딸 수 없을 것 같다.</span><<skulduggeryrequired>>
	<br><br>
<</if>>

<<getouticon>><<link [[떠난다|Bait Shop]]>><<endevent>><</link>>


:: Bait Shop Register Sneak
<<set $outside to 0>><<effects>><<set $lock to 200>>
<<set $weekly.theft.baitShop to true>>
<<set $cash to random(1500, 4500)>>

능숙하게 금전등록기를 열고 안에 있는 돈을 센다. <<printmoney $cash>>【이가】 있다.
<br><br>

<<skulduggeryuse 300 "locks">>

<<if $rng gte 86>>
	<<skulshopevents>>
<<else>>
	<<link [[가져간다|Bait Shop]]>><<money $cash "thievery">><<crimeUp `$cash / 100` "thievery">><<endevent>><</link>><<crime "thievery">>
	<br>
	<<link [[그냥 둔다|Bait Shop]]>><<endevent>><</link>>
<</if>>


:: Bait Shop Owner Full Intro
<<set $outside to 0>><<effects>>
<<loadNPC 0 "bait_shop_owner">><<person1>>
<<set $fishing.baitShopIntro to "fullIntro">>
<<set $daily.fishing.baitShopRequestFish to "haddock">>

당신이 돌아가려 할 때, 카운터에 있던 <<person>>【이가】 말을 건넨다. "이 근처에서 낚시할 거라면 조심하세요. 여기 물속엔 좀 이상한 것들이 있거든요." <<He>>【은는】 잠시 말을 멈춘다. "하지만 어차피 나갈 거라면, 저녁거리로 <span class="blue">해덕대구</span> 한 마리만 잡아다 줄래요? 값을 후하게 쳐드릴게요. 시장에서 냄새나는 생선은 얼마든지 살 수 있으니, 오늘 잡은 싱싱한 놈으로요." <<He>>【은는】 어깨를 으쓱한다. "어쨌든 전 <<ampm 19 00>> 마감 때까지 여기 있을 테니, 그 전까지 저녁 메뉴를 정해야겠네요."
<br><br>

<<link [[<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>>【을를】 잡는 방법을 묻는다|Bait Shop Request Fish Catch Help]]>>
	<<endevent>>
<</link>>
<br>
<<link [[수락한다|Bait Shop Owner Fish Request Response]]>>
	<<set $daily.fishing.baitShopRequest to "requested">>
	<<endevent>>
<</link>>
<br>
<<link [[거절한다|Bait Shop Owner Fish Request Response]]>>
	<<set $daily.fishing.baitShopRequest to "notToday">>
	<<endevent>>
<</link>>


:: Bait Shop Owner Half Intro
<<set $outside to 0>><<effects>>
<<loadNPC 0 "bait_shop_owner">><<person1>>
<<set $fishing.baitShopIntro to "halfIntro">>

당신이 돌아가려 할 때, 카운터에 있던 <<person>>【이가】 말을 건넨다. "이 근처에서 낚시할 거라면 조심하세요. 여기 물속엔 좀 이상한 것들이 있거든요. 특히 밤에는 더요."
<br><br>

<<getouticon>><<link [[떠난다|Mer Pier]]>><<endevent>><</link>>


:: Bait Shop Owner Half Intro Request
<<set $outside to 0>><<effects>>
<<loadNPC 0 "bait_shop_owner">><<person1>>
<<set $fishing.baitShopIntro to "fullIntro">>
<<set $daily.fishing.baitShopRequestFish to baitShopRequestFish()>>

당신이 돌아가려 할 때, 카운터 뒤에 있던 <<person>>【이가】 말을 건넨다. "단골을 다시 뵈니 반갑네요. 지난번 뵌 이후로 괜찮은 걸 낚으셨기를 바랍니다!" <<He>>【은는】 잠시 말을 멈춘다. "오늘 밤에 나갈 거라면, 저녁거리로 <span class="blue"><<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>></span> 한 마리만 잡아다 줄래요? 값을 후하게 쳐드릴게요. 시장에서 냄새나는 생선은 얼마든지 살 수 있으니, 오늘 잡은 싱싱한 놈으로요." <<He>>【은는】 어깨를 으쓱한다. "어쨌든 전 <<ampm 19 00>> 마감 때까지 여기 있을 테니, 그 전까지 저녁 메뉴를 정해야겠네요."
<br><br>

<<link [[<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>>【을를】 잡는 방법을 묻는다|Bait Shop Request Fish Catch Help]]>>
	<<endevent>>
<</link>>
<br>
<<link [[수락한다|Bait Shop Owner Fish Request Response]]>>
	<<set $daily.fishing.baitShopRequest to "requested">>
	<<endevent>>
<</link>>
<br>
<<link [[거절한다|Bait Shop Owner Fish Request Response]]>>
	<<set $daily.fishing.baitShopRequest to "notToday">>
	<<endevent>>
<</link>>

:: Bait Shop Request
<<set $outside to 0>><<effects>>
<<loadNPC 0 "bait_shop_owner">><<person1>>
<<set $daily.fishing.baitShopRequestFish to baitShopRequestFish()>>
안으로 들어서자, 카운터에 있던 <<person>>【이가】 당신을 올려다본다.
<<if $fishing.baitShopRequestsCompleted is 0>>
	"단골을 다시 뵈니 반갑네요. 지난번 뵌 이후로 괜찮은 걸 낚으셨기를 바랍니다!" <<He>>【은는】 잠시 말을 멈춘다. "오늘 밤에 나갈 거라면, 저녁거리로 <span class="blue"><<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>></span> 한 마리만 잡아다 줄래요? 값을 후하게 쳐드릴게요. 시장에서 냄새나는 생선은 얼마든지 살 수 있으니, 오늘 잡은 싱싱한 놈으로요." <<He>>【은는】 어깨를 으쓱한다. "어쨌든 전 <<ampm 19 00>> 마감 때까지 여기 있을 테니, 그 전까지 저녁 메뉴를 정해야겠네요."
<<else>>
	"안녕하세요! 제가 제일 좋아하는 <<fisherPerson>> 손님이 오셨네요. 괜찮으시면 오늘 저녁거리로 <span class="blue"><<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>></span> 한 마리를 구하고 싶은데요. 항상 그렇듯 갓 잡은 싱싱한 걸로요. 저를 위해 다시 한번 찾아봐 주시겠어요? 전 <<ampm 19 00>> 마감 때까지 여기 있을 테니, 그 전까지 저녁 메뉴를 정해야겠네요."
<</if>>
<br><br>

<<link [[<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>>【을를】 잡는 방법을 묻는다|Bait Shop Request Fish Catch Help]]>>
	<<endevent>>
<</link>>
<br>
<<link [[수락한다|Bait Shop Owner Fish Request Response]]>>
	<<set $daily.fishing.baitShopRequest to "requested">>
	<<endevent>>
<</link>>
<br>
<<link [[거절한다|Bait Shop Owner Fish Request Response]]>>
	<<set $daily.fishing.baitShopRequest to "notToday">>
	<<endevent>>
<</link>>


:: Bait Shop Give Fish
<<set $outside to 0>><<effects>>
<<person1>>
<<set _fish to $daily.fishing.baitShopRequestFish>>
<<set _pay to setup.foodstuff[_fish].shop.sell_price * 15>>
<<set $foodstuff[_fish].amount -= 1>>
<<set $daily.fishing.baitShopRequest to "delivered">>
<<set $fishing.baitShopRequestsCompleted += 1>>

당신은 카운터에 <<= setup.foodstuff[_fish].name>>【을를】 올려놓는다. <<person>>【은는】 그것을 집어 들고 이리저리 뒤집어보며 고개를 끄덕인다.

<<if _fish is "haddock">>
	"완벽해요. 오늘 밤엔 튀김옷을 입혀서 제대로 된 피시 앤 칩스를 해 먹어야겠네요." <<He>>【은는】 조심스럽게 그것을 옆에 둔다. "하루 종일 이걸 기다렸거든요."<<llstress>><<ltrauma>><<trauma -3>><<stress -10>>
<<elseif _fish is "salmon">>
	"정말 멋진 연어네요. 레몬 버터를 곁들여 오븐에 구워야겠어요. 단순하지만 나무랄 데 없는 요리죠."<<llstress>><<ltrauma>><<trauma -3>><<stress -10>>
<<elseif _fish is "trout">>
	"훌륭한 송어군요." <<He>>【은는】 엄지손가락으로 송어의 옆면을 쓸어내린다. "마늘과 허브를 약간 곁들여 프라이팬에 구울 겁니다. 송어는 단순한 게 최고거든요."<<llstress>><<ltrauma>><<trauma -3>><<stress -10>>
<<elseif _fish is "bass">>
	"크기가 아주 좋네요." <<He>>【은는】 만족스러운 표정을 짓는다. "농어에 올리브 오일, 그리고 마늘 약간. 제게 묻는다면 최고의 생선 요리죠."<<llstress>><<ltrauma>><<trauma -3>><<stress -10>>
<<elseif _fish is "perch">>
	<<He>>【은는】 생선을 받아 들며 고개를 끄덕인다. "포를 떠서 튀겨야겠어요. 화려하진 않아도 농어 튀김은 아주 맛있죠. 오늘 밤은 복잡한 요리를 할 기분이 아니거든요."<<llstress>><<ltrauma>><<trauma -3>><<stress -10>>
<<elseif _fish is "cod">>
	"정말 좋네요." <<He>>【은는】 미소를 짓는다. "일주일 내내 생선 파이가 먹고 싶었는데. 이거면 완벽하겠어요."<<llstress>><<ltrauma>><<trauma -3>><<stress -10>>

		<<set _pay to Math.round(_pay * 1.5)>>
<<elseif _fish is "pike">>
	"잘 잡으셨네요." <<He>>【은는】 무게를 가늠해 본다. "손질하는 데 품은 좀 들겠지만 살이 아주 넉넉하네요. 뼈를 발라내고 제대로 요리하면 며칠은 든든하게 먹을 수 있겠어요."<<llstress>><<ltrauma>><<trauma -3>><<stress -10>>

		<<set _pay to Math.round(_pay * 1.5)>>
<<elseif _fish is "eel">>
	"잘 잡으셨네요." <<He>>【은는】 무게를 가늠해 본다. "아니, 대단한 솜씨예요! 정말 감사합니다, 빨리 요리하고 싶어 안달이 날 지경이네요." <<llstress>><<ltrauma>><<trauma -3>><<stress -10>>
	<br><br>

	"장어 젤리 드셔본 적 있으세요? 없다고요? 분명 언젠가 맛보게 되실 겁니다." <<gstress>>

		<<set _pay to Math.round(_pay * 1.5)>>
<</if>>
<br><br>

<<He>>【은는】 지폐를 세어 카운터 건너편으로 밀어준다. "여기 <<printmoney _pay>>입니다. 수고하셨어요!"<<money _pay "fishing">>
<br><br>

<<set $baitShopTeachRecipe to rollRecipeWithIngredient(_fish, false)>>
<<if $baitShopTeachRecipe>>
	<<link [[다음|Bait Shop Teach Dish]]>><</link>>
<<else>>
	<<link [[다음|Bait Shop]]>><<endevent>><</link>>
<</if>>


:: Bait Shop Teach Dish
<<set $outside to 0>><<effects>>
<<person1>>

<<He>>【은는】 카운터에 몸을 기댄다. "참, 이 생선으로 훌륭한 요리를 만드는 법을 알려드릴 수 있는데. 별로 안 어려워요. 조금만 기다려주시면 레시피를 적어드릴게요, 어떠세요?"
<br><br>

<<link [[수락한다|Bait Shop Teach Dish Accept]]>><</link>>
<br>
<<link [[거절한다|Bait Shop]]>><<set $fishing.baitShopAmbient to "declinedRecipe">><<endevent>><</link>>


:: Bait Shop Teach Dish Accept
<<set $outside to 0>><<effects>>
<<person1>>

<<He>>【은는】 자투리 종이와 연필을 꺼내 <<print setup.foodstuff[$baitShopTeachRecipe].name>> 레시피를 적어 당신에게 건넨다. "여기요. 재료량은 대충 적혀있을 수도 있지만, 제가 배운 방식이 원래 그렇답니다."

<<learn_recipe $baitShopTeachRecipe>>
<<unset $baitShopTeachRecipe>>
<br><br>

<<link [[다음|Bait Shop]]>><<endevent>><</link>>


/* Fishing event on the pier */
:: Fishing Pier Shack Owner Break
<<loadNPC 0 "bait_shop_owner">><<person1>>
<<set $daily.fishing.baitShopRequestFish to baitShopRequestFish()>>

당신 뒤쪽의 널빤지에서 발소리가 들린다. 뒤를 돌아보니 미끼 상점의 <<person>>【이가】 한 손에 머그잔과 샌드위치를 들고 다가오고 있다.
<<if $fishing.baitShopRequestsCompleted gte 1>>
	"당신일 거라고 생각했어요. 막 점심을 먹으려던 참이거든요." <<He>>【은는】 물 쪽을 향해 고개를 끄덕인다. "기왕 하시는 김에, 저녁거리로 <<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>> 한 마리만 잡아다 줄래요? 오늘 잡은 싱싱한 놈으로요. 항상 그렇듯 값은 후하게 쳐드릴게요. 잡으시면 <<ampm 19 00>> 마감 때까지 오두막에 있을 테니 가져오세요. 어때요?"
<<else>>
	"아까 가게에 오셨었죠? 벌써 유용하게 쓰시는 걸 보니 좋네요." <<he>>【이가】 당신의 낚싯대를 보며 고개를 끄덕인다. "오늘 계속 낚시하실 거라면, 저녁거리로 <<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>> 한 마리만 잡아다 주실 수 있나요? 제가 직접 하고 싶지만 가게를 봐야 해서요. 오늘 잡은 싱싱한 놈으로, 값은 후하게 쳐드릴게요. 전 <<ampm 19 00>> 마감 때까지 오두막에 있을 겁니다. 어때요?"
<</if>>
<br><br>

<<link [[<<= setup.foodstuff[$daily.fishing.baitShopRequestFish].name>>【을를】 잡는 방법을 묻는다|Fishing Pier Shack Owner Break Catch Help]]>>
	<<endevent>>
<</link>>
<br>
<<link [[수락한다|Fishing Pier Wait]]>>
	<<set $daily.fishing.baitShopRequest to "requested">>
	<<set $fishingAmbientOverride to "acceptedFishingRequest">>
	<<endevent>>
<</link>>
<br>
<<link [[거절한다|Fishing Pier Wait]]>>
	<<set $daily.fishing.baitShopRequest to "notToday">>
	<<set $fishingAmbientOverride to "declinedFishingRequest">>
	<<endevent>>
<</link>>

