:: Sydney Walk
<<set $outside to 0>><<if $location is "school">><<schooleffects>><</if>><<effects>><<set _sydneyPray to true>>
<<endevent>><<npc "Sydney">><<person1>>
<<if $sydney.glasses.includes("broken")>>
	"새 안경이 필요해요. 가요." <<if $sydneyromance is 1>>당신은 <<him>>의 팔을 잡고 일어서도록 도와준다.<<else>>당신은 시드니에게 일어나라고 손짓한다.<</if>>
	<br><br>
	<<if $location is "school">>
		<<set $exit to "library">>
		<<switch $schoolstate>>
			<<case "early" "morning" "first">>
				"지금요? 아직 한쪽 렌즈는 멀쩡한데요.<<if $sydneyScience>> 늦으면 <<nnpc_Mum "Sirris">>께서 이해해주셨으면 좋겠네요.<</if>>"
			<<case "second" "third" "fourth" "fifth">>
				"지금요? 수업 들어가야 하는 거 아니에요? 당신이 곤란해지는 건 싫지만..."
			<<default>>
				"정말 고마워요. 지금은 거리감이 전혀 안 잡히거든요."
		<</switch>>
		<<if $sydney.glasses is "playerbroken">>당신은 <<he>>【이가】 "자리 비움" 표지판을 찾으려다 거의 넘어질 뻔하자 죄책감이 살짝 든다.<<else>>잠시 뒤, <<he>>【은는】 간신히 "자리 비움" 표지판을 찾아 대여 카운터에 세워둔다.<</if>>
		<br><br>
		<<if Weather.precipitation isnot "none">>
			<<He>>【은는】 나가는 길에 <<his>> 사물함에 들러 우산을 챙긴다.
		<</if>>
		당신들은 공원을 가로질러 쇼핑 센터에 도착한다.
	<<elseif $location is "temple">>
		<<set $exit to "temple">>
		<<if Time.weekDay is 1 and Time.hour gte 10 and Time.hour lte 12 and $daily.massAttended isnot 1>>
			"고마워요. 그래도 미사를 놓치기는 싫지만요. 이것이 더 중요하겠죠."
		<<else>>
			"정말 고마워요. 지금은 거리감이 전혀 안 잡히거든요."
		<</if>>
		시드니는 <<monks>> 무리에게 손을 흔들어 인사하고, 당신과 함께 떠난다.
		<br><br>
		<<if Weather.precipitation isnot "none">>
			<<He>>【은는】 나가는 길에 우산을 챙긴다.
		<</if>>
		당신들은 금방 하이 가에 도착한다. 짧은 거리다.
	<</if>>
	<<set $location to "town">>
	<<He>>【은는】 당신의 팔을 조심스럽게 붙잡는다.
	<br><br>
	<<link [[다음|Sydney Shopping Glasses]]>><<set $phase to 1>><<set $daily.sydney.walk to true>><<set $daily.school.scienceExcused to true>><<pass 15>><</link>>
<<else>>
	<<if $speech_attitude is "meek">>
		"어디 좀 갈래요?" 당신이 묻는다.
	<<elseif $speech_attitude is "bratty">>
		"우리 여기서 잠깐 빠져나가자." 당신이 말한다.
	<<else>>
		"좀 쉬면서 바람을 쐬면 좋을 것 같아요." 당신이 말한다.
	<</if>>
	<br><br>
	<<if $location is "school" and $detention gte 1 and $daily.school.detentionAttended isnot 1 and $headnodetention isnot 1 and $pillory.tenant.special.name isnot "Leighton">>
		<<He>>【은는】 잠시 기운을 내지만, 당신을 보고 얼굴을 찌푸린다. "<<nnpc_title "Leighton">>께서 오늘 끝나고 벌을 받을 때까지 교내를 나가면 안 된다고 하셨잖아요. 미안해요."
		<br>
	<<else>>
		<<He>>【은는】 기운을 낸다. "무슨 생각인데요?"
		<br><br>
		<<highicon>><<link [[쇼핑 센터 (0:15+)|Sydney Walk Shopping]]>><</link>>
		<br>
		<<if C.npc.Sydney.love gte 50>>
			<<starfishicon>><<link [[해변 (0:50+)|Sydney Walk Beach]]>><</link>>
			<br>
		<</if>>
		<<if $sydneyromance is 1 and $sydneySeen.includes("corruptroom")>>
			<<templeicon "prayer room">><<link [[신전 기도실|Sydney Walk Prayer Room]]>><</link>>
			<br>
			<</if>>
			<<if $location is "temple" and !Weather.bloodMoon>>
				<<templeicon "garden">><<link [[신전 정원 (0:15)|Sydney Walk Temple Garden]]>><</link>>
			<br>
		<</if>>
	<</if>>
	<br>
	<<sydneyOptions>>
<</if>>

:: Sydney Walk Shopping
<<set $outside to 0>><<if $location is "school">><<schooleffects>><</if>><<effects>><<run statusCheck("Sydney")>><<set _sydneyPray to true>>
<<if $speech_attitude is "meek">>
	"쇼핑 센터는 어때요?" 당신이 묻는다.
<<elseif $speech_attitude is "bratty">>
	"쇼핑 센터 가자. 네 모습도 좀 산뜻하게 바꿔볼 겸." 당신이 말한다.
<<else>>
	"쇼핑하러 가도 좋겠어요." 당신이 말한다.
<</if>>
<br><br>
<<if $location is "school">>
	<<switch $schoolstate>>
		<<case "early" "morning" "first" "second" "third">>
			<<if $sydneyScience and Time.hour is 8 and Time.minute gte 30>>
				"가고 싶지만, 과학 수업에 늦을 위험은 감수 못 하겠어요. 적어도... 30분은 필요하겠죠? 다음에는 좀 더 일찍 나갈 수 있을 때요."
				<<set _walk to false>>
			<<else>>
				"아직 이른 시간이니까, 오는 학생도 많지 않을 테고... 좋아요!"
				<<set _walk to true>>
			<</if>>
		<<case "fourth" "fifth">>
			"당신 지금 수업 들어가야 하는 거 아니에요?" <<He>>【은는】 잠시 생각한다.
			<<if _sydneyStatus.includes("corrupt")>>
				"에라 모르겠어요. 당신과 함께 있을 시간이라면 뭐든 좋으니까요."
				<<set _walk to true>>
			<<elseif $sydneyromance is 1>>
				"당신이 곤란해져도 정말 괜찮다면요. 당신과 시간 보내는 건 좋아요."
				<<set _walk to true>>
			<<else>>
				"당신이 곤란해지는 건 정말 싫어요. 방과 후까지 기다리면 안 될까요?"
				<<set _walk to false>>
			<</if>>
		<<case "lunch">>
			"다음 수업까지 시간이 좀 빠듯하지 않을까요?" <<He>>【은는】 잠시 생각한다.
			<<if Time.minute gte 30>>
				<<if _sydneyStatus.includes("corrupt")>>
					"에라 모르겠어요. 당신과 함께 있을 시간이라면 뭐든 좋으니까요."
					<<set _walk to true>>
				<<elseif $sydneyromance is 1>>
					"당신이 곤란해져도 정말 괜찮다면요. 당신과 시간 보내는 건 좋아요."
					<<set _walk to true>>
				<<else>>
					"적어도 30분은 필요하겠죠? 당신이 곤란해지는 건 정말 싫어요. 방과 후까지 기다리면 안 될까요?"
					<<set _walk to false>>
				<</if>>
			<<else>>
				"사실 시간은 충분할 것 같아요. 재밌겠네요!"
				<<set _walk to true>>
			<</if>>
		<<default>>
			<<He>>【은는】 책을 내려놓는다. "좋아요. 다리도 좀 펼 겸요."
			<<set _walk to true>>
	<</switch>>
<<elseif $location is "temple">>
	<<if Time.weekDay is 1 and Time.hour gte 10 and Time.hour lte 12 and $daily.massAttended isnot 1>>
		"가고 싶지만, 미사 끝난 뒤로 미루면 안 될까요?"<<set _walk to false>>
	<<elseif Time.schoolDay and Time.hour is 6>>
		"그러기엔 조금 이르지 않나요?"<<set _walk to false>>
	<<elseif Time.hour gte 18 or Time.hour lte 5>>
		"그러기엔 조금 늦지 않나요?"<<set _walk to false>>
	<<elseif _sydneyStatus.includes("corrupt")>>
		"좋아요. 여기서 좀 벗어날 시간이 필요했어요."<<set _walk to true>>
	<<elseif $temple_rank is undefined or $temple_rank is "prospective">>
		시드니는 신난 듯하다. "좋아요! 제가 나간다고 <<nnpc_brother "Jordan">> 조던에게만 알리고 올게요." <<He>>【은는】 뛰어갔다가 몇 분 뒤 돌아온다. "준비됐어요."<<set _walk to true>><<pass 2>>
	<<elseif $temple_garden gte 100 and $temple_quarters gte 100>>
		"지금 신전 상태가 완벽하니, 제가 없어도 아무도 아쉬워하지 않을 거예요. 가요!"<<set _walk to true>>
	<<elseif $temple_garden gte 100>>
		"정원은 완벽하니, 잠깐 쉬어도 괜찮다고 해줄 거예요."<<set _walk to true>>
	<<elseif $temple_quarters gte 100>>
		"숙소는 완벽하니, 잠깐 쉬어도 괜찮다고 해줄 거예요."<<set _walk to true>>
	<<elseif $temple_garden gte 50 or $temple_quarters gte 50>>
		<<He>>【은는】 망설이는 듯하다. "아직 여기저기 할 일이 많지만... 잠깐 쉬는 정도는 괜찮겠죠."<<set _walk to true>>
	<<else>>
		<<He>>【은는】 슬프게 고개를 젓는다. "여기 해야 할 일이 너무 많아요. 미안해요."<<set _walk to false>>
	<</if>>
<</if>>
<<if _walk is true>>
	<<if $location is "school">>
		<<set $exit to "library">><<set $location to "park">>
		시드니는 대여 카운터에 "자리 비움" 표지판을 남기고,<<if $sydneyromance is 1>> 당신의 팔을 잡은 채<</if>> 당신과 함께 떠난다.
		<br><br>
		<<if Weather.precipitation isnot "none">>
			<<He>>【은는】 나가는 길에 <<his>> 사물함에 들러 우산을 챙긴다.
		<</if>>
		당신들은 공원을 가로질러 쇼핑 센터에 도착한다.
	<<elseif $location is "temple">>
		<<set $exit to "temple">><<set $location to "town">>
		시드니는 <<monks>> 무리에게 손을 흔들어 인사하고,<<if $sydneyromance is 1>> 당신의 팔을 잡은 채<</if>> 당신과 함께 떠난다.
		<br><br>
		<<if Weather.precipitation isnot "none">>
			<<He>>【은는】 나가는 길에 우산을 챙긴다.
		<</if>>
		당신들은 금방 하이 가에 도착한다. 짧은 거리다.
	<</if>>
	<br><br>
	<<link [[다음|Sydney Shopping Centre]]>><<set $daily.sydney.walk to true>><<pass 15>><</link>>
<<else>>
	<br><br>
	<<sydneyOptions>>
<</if>>

:: Sydney Walk Beach
<<set $outside to 0>><<if $location is "school">><<schooleffects>><</if>><<effects>><<run statusCheck("Sydney")>><<set _sydneyPray to true>>
<<if $speech_attitude is "meek">>
	"해변은 어때요?" 당신이 묻는다.
<<elseif $speech_attitude is "bratty">>
	"우리 해변에서 하루 보내도 좋을 것 같은데." 당신이 말한다.
<<else>>
	"해변에 가서 좀 놀아도 좋겠어요." 당신이 말한다.
<</if>>
<br><br>
<<if $location is "school">>
	<<if Time.weekDay is 6>>
		<<He>>【은는】 잠깐 신난 표정을 짓지만 곧 얼굴을 찌푸린다. "금요일에는 <<nnpc_mum "Sirris">>【을를】 도와드려야 해서, 시간이 충분하지 않을 것 같아요. 미안해요."
		<<set _walk to false>>
	<<else>>
		<<if $schoolstate is "afternoon">>
			<<His>> 얼굴이 밝아진다. "정말 좋겠어요!"
			<<set _walk to true>>
		<<else>>
			<<His>> 얼굴이 밝아진다. "정말 좋겠어요! 그래도 그렇게 몇 시간씩 학교를 그냥 떠날 순 없잖아요. 오늘 방과 후에는 어떨까요?"
			<<set _walk to false>>
		<</if>>
	<</if>>
<<elseif $location is "temple">>
	<<if Time.weekDay is 1 and Time.hour lte 12 and $daily.massAttended isnot 1>>
		"가고 싶지만, 미사 끝난 뒤로 미루면 안 될까요?"
		<<set _walk to false>>
	<<elseif Time.hour lte 8>>
		"해변에 가기엔... 조금 이르지 않나요?" <<He>>【은는】 하품한다.
	<<elseif Time.hour gte 17>>
		"해변에 가기엔 조금 늦지 않나요?"<<set _walk to false>>
	<<elseif _sydneyStatus.includes("corrupt")>>
		"당연히 좋죠. 당신이 아슬아슬한 수영복 입은 모습도 볼 수 있는 건가요?"<<set _walk to true>>
	<<elseif $temple_rank is undefined or $temple_rank is "prospective">>
		시드니는 신난 듯하다. "좋아요! 제가 나간다고 <<nnpc_brother "Jordan">> 조던에게만 알리고 올게요." <<He>>【은는】 뛰어갔다가 몇 분 뒤 돌아온다. "준비됐어요."<<set _walk to true>>
	<<elseif $temple_garden gte 100 and $temple_quarters gte 100>>
		"지금 신전 상태가 완벽하니, 조금 게으름을 피워도 될 것 같아요. 가요!"<<set _walk to true>>
	<<elseif $temple_garden gte 100>>
		"정원은 완벽하니, 잠깐 쉬어도 괜찮다고 해줄 거예요."<<set _walk to true>>
	<<elseif $temple_quarters gte 100>>
		"숙소는 완벽하니, 잠깐 쉬어도 괜찮다고 해줄 거예요."<<set _walk to true>>
	<<elseif $temple_garden gte 50 or $temple_quarters gte 50>>
		<<He>>【은는】 망설이는 듯하다. "아직 여기저기 할 일이 많지만... 하루 정도 쉬어도 큰일은 없겠죠."<<set _walk to true>>
	<<else>>
		<<He>>【은는】 슬프게 고개를 젓는다. "여기 해야 할 일이 너무 많아요. 미안해요."<<set _walk to false>>
	<</if>>
<</if>>
<<if _walk is true>>
	<<if $location is "school">>
		<<set $exit to "library">><<set $location to "town">>
		시드니는 <<his>> 물건을 챙기고, 도서관 직원에게 일찍 간다고 말한다. <<He>>【은는】 당신에게 미소 짓고,<<if $sydneyromance is 1>> 당신의 팔을 잡은 채<</if>> 당신과 함께 떠난다.
		<br><br>
		<<if Weather.precipitation isnot "none">>
			<<He>>【은는】 나가는 길에 <<his>> 사물함에 들러 큰 우산을 챙긴다.
		<</if>>
		당신들은 공원을 가로질러 스타피쉬 가에 도착한다.
	<<elseif $location is "temple">>
		<<set $exit to "temple">><<set $location to "town">>
		시드니는 <<monks>> 무리에게 손을 흔들어 인사하고,<<if $sydneyromance is 1>> 당신의 팔을 잡은 채<</if>> 당신과 함께 떠난다.
		<br><br>
		<<if Weather.precipitation isnot "none">>
			<<He>>【은는】 나가는 길에 큰 우산을 챙긴다.
		<</if>>
		스타피쉬 가까지 가는 길은 오래 걸리지 않는다.
	<</if>>
	<br><br>
	<<link [[다음|Sydney Beach Start]]>><<set $daily.sydney.walk to true>><<pass 25>><</link>>
<<else>>
	<br><br>
	<<sydneyOptions>>
<</if>>

:: Sydney Walk Prayer Room
<<set $outside to 0>><<if $location is "school">><<schooleffects>><</if>><<effects>><<run statusCheck("Sydney")>><<set _sydneyPray to true>>
<<if $speech_attitude is "meek">>
	"우리... 다시 기도실에 가도 좋겠어요." 당신이 얼굴을 붉히며 말한다.
<<elseif $speech_attitude is "bratty">>
	"기도실을 또 더럽히러 가자." 당신은 윙크하며 말한다.
<<else>>
	"기도실에서 다시 좀 장난쳐도 좋겠어요." 당신이 말한다.
<</if>>
<br><br>
<<if _sydneyStatus.includes("corrupt")>>
	<<if $location is "school">>
		<<if Time.weekDay is 6>>
			<<He>>【은는】 잠깐 신난 표정을 짓지만 곧 얼굴을 찌푸린다. "다른 날이라면 좋다고 했겠지만, 금요일에는 <<nnpc_mum "Sirris">>【을를】 도와드려야 해서 시간이 충분하지 않을 것 같아요. 미안해요."
			<<set _walk to false>>
		<<else>>
			<<He>>【은는】 활짝 웃으며 당신을 바라본다. "당연히 좋죠. 오늘 방과 후 밤에 신전에서 만나요."
			<<set _walk to false>>
		<</if>>
	<<elseif $location is "temple">>
		<<if Time.weekDay is 1 and Time.hour gte 10 and Time.hour lte 12 and $daily.massAttended isnot 1>>
			<<He>>【은는】 사악하게 씩 웃는다. "미사 중에 하자고요? 정말 죄스럽네요. 마음에 들어요."
		<<else>>
			<<His>> 얼굴이 조금 붉어지고, <<he>>【은는】 미소 짓는다. "네. 당신과 다시 죄를 짓고 싶어요."
		<</if>>
		<<set _walk to true>>
	<</if>>
<<else>>
	시드니는 부끄러운 듯 고개를 숙인다. "그 일은... 저는... 지금 마음이 좋은 상태가 아니에요. 제 세계관 전체가 뒤집혀버렸고, 이런 일들에 대해 정말 갈등하고 있어요. 미안해요."
	<<set _walk to false>>
<</if>>
<<if _walk is true>>
	<<He>>【은는】 당신의 손을 잡고, 당신은 신전 복도를 몰래 지나 기도실의 숨겨진 입구로 향한다. <<takeHandholdingVirginity "Sydney" "romantic">>
	<br><br>
	<<link [[다음|Sydney Temple Prayer Room]]>><<set $daily.sydney.walk to true>><<pass 5>><</link>>
<<else>>
	<br><br>
	<<sydneyOptions>>
<</if>>

:: Sydney Shopping Centre
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>><<sydneySchedule>>
당신은 시드니와 함께 쇼핑 센터 메인 층에 있다. 쇼핑객들로 붐빈다<<if $sydneyromance is 1>>, 그래서 떨어지지 않도록 <<him>>【와과】 팔짱을 낀다<</if>>.
<br><br>
<<if Time.schoolDay and $sydneyScience and ((Time.hour is 8 and Time.minute gte 44) or Time.hour is 9)>>
	<<He>>【은는】 시간을 보여주는 커다란 전광판을 본다. "가야 해요. 과학 수업에 늦겠어요!"
	<br><br>
	<<link [[떠난다 (0:15)|Sydney Shopping Leave]]>><<pass 15>><</link>>
<<elseif _sydney_location is "shop" and Time.hour gte 17>>
	<<He>>【은는】 시간을 보여주는 커다란 전광판을 본다. "저 벌써 조금 늦었어요. <<nnpc_mum "Sirris">>께서 하시는 일을 도우러 가야 해요. 그래도 데려와줘서 고마워요! 재밌었어요."
	<<if $sydneyromance is 1>><<He>>【은는】 쇼핑 센터를 떠나며 당신의 뺨에 키스하고 손을 흔든다.<<else>><<He>>【은는】 쇼핑 센터를 떠나며 당신에게 손을 흔든다.<</if>>
	<br><br>
	<<link [[다음|Shopping Centre]]>><<unset $exit>><<endevent>><<set $eventskip to 1>><</link>>
<<elseif Time.hour gte 21>>
	<<He>>【은는】 시간을 보여주는 커다란 전광판을 본다. "곧 문 닫을 시간이네요. 이제 정말 집에 가야겠어요. 데려와줘서 고마워요! 재밌었어요."
	<<if $sydneyromance is 1>><<He>>【은는】 쇼핑 센터를 떠나며 당신의 뺨에 키스하고 손을 흔든다.<<else>><<He>>【은는】 쇼핑 센터를 떠나며 당신에게 손을 흔든다.<</if>>
	<br><br>
	<<link [[다음|Shopping Centre]]>><<unset $exit>><<endevent>><<set $eventskip to 1>><</link>>
<<elseif $phase is 1 and C.npc.Sydney.love lt 30>>
	"우리... 이제 돌아가는 게 좋겠어요."
	<br><br>
	<<link [[쇼핑 센터를 떠난다 (0:15)|Sydney Shopping Leave]]>><<pass 15>><</link>>
	<br>
<<else>>
	<<if $phase is 1>>
		<<set $phase to 0>>
		<<He>>【은는】 시간을 확인한다. "음... 이미 여기까지 왔으니, 당신이 싫지 않다면 아직 떠나지 않아도 되겠네요."
	<<else>>
		"<<print either("여기는 언제나 이렇게 붐비네요.", "그래서, 뭘 찾아볼까요?", "아무것도 사지 않더라도 당신과 시간을 보내는 건 좋아요.", "사람 많은 곳은 조금 불안해요.")>>"
	<</if>>
	<br><br>
	<<if !$daily.sydney.shopGlasses>>
		<<clothingcategoryicon "face">> <<link [[안경점 (0:01)|Sydney Shopping Glasses]]>><<pass 1>><</link>>
		<br>
	<</if>>
	<<if !$daily.sydney.shopHair>>
		<<hairdressericon>><<link [[미용실 (0:01)|Sydney Shopping Hairdressers]]>><<pass 1>><</link>>
		<br>
	<</if>>
	<<if !$daily.sydney.shopSwim and C.npc.Sydney.love gte 50>>
		<<clothingcategoryicon "under-outfit">><<link [[수영복 매장 (0:01)|Sydney Shopping Swim]]>><<pass 1>><</link>>
		<br>
	<</if>>
	<br>
	<<link [[쇼핑 센터를 떠난다 (0:15)|Sydney Shopping Leave]]>><<pass 15>><</link>>
	<br>
<</if>>

:: Sydney Shopping Glasses
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>
<<set $daily.sydney.shopGlasses to true>>
당신은 시드니를 데리고 쇼핑 센터 위층에 도착한다.
<<if $sydneySeen.includes("glasses")>>
	무엇을 찾아야 하는지 알고 있으니 안경점을 훨씬 빨리 찾는다.
<<else>>
	<<set $sydneySeen.pushUnique("glasses")>>
	안경점 구역을 찾는 데 몇 분이 걸린다. <<pass 3>>
<</if>>
<br><br>
시드니는 카운터에서 일하는 사람을 알아보는 듯하다<<if $phase is 1>>, 그리고 <<his>> 처방 내용을 알려주기 시작하며 <<his>> <<sydneyGlasses>>【을를】 옆에 내려놓는다<</if>>. 당신은 안경으로 가득 찬 회전 진열대와 다양한 콘택트렌즈가 들어 있는 진열장을 둘러본다.
<br><br>
<<if $phase is 1>>
	<<link [[시드니에게 안경을 사준다 (£15)|Sydney Shopping Buy Glasses]]>><<money -1500 "sydney">><</link>>
	<br>
	<<if $money gte 5000>>
		<<link [[시드니에게 콘택트렌즈를 사준다 (£50)|Sydney Shopping Buy Contacts]]>><<money -5000 "sydney">><</link>>
		<br>
	<<else>>
		<span class="purple">시드니에게 콘택트렌즈를 사줄 돈이 없다.</span>
	<</if>>
<<elseif $money gte 1500>>
	<<link [[시드니에게 새 안경을 사준다 (£15 0:10)|Sydney Shopping Buy Glasses]]>><<pass 10>><<money -1500 "sydney">><<npcincr Sydney love 1>><</link>><<glove>>
	<br>
	<<if $money gte 5000>>
		<<link [[시드니에게 콘택트렌즈를 사준다 (£50 0:10)|Sydney Shopping Buy Contacts]]>><<pass 10>><<money -5000 "sydney">><<npcincr Sydney love 1>><</link>><<glove>>
		<br>
	<<else>>
		<span class="purple">시드니에게 콘택트렌즈를 사줄 돈이 없다.</span>
	<</if>>
	<br>
	<<link [[떠난다 (0:01)|Sydney Shopping Centre]]>><<pass 1>><</link>>
	<br>
<<else>>
	<span class="purple">여기서 시드니에게 아무것도 사줄 돈이 없다.</span>
	<br>
	<<link [[떠난다 (0:01)|Sydney Shopping Centre]]>><<pass 1>><</link>>
	<br>
<</if>>

:: Sydney Shopping Buy Glasses
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>
당신은 시드니에게 새 안경을 사준다.
<<switch $sydney.glasses>>
	<<case "broken">>
		<<He>>【은는】 <<his>> <<sydneyGlasses>>【을를】 카운터 직원에게 밀어준다. "이 낡은 것도 그리울 거예요." <<He>>【은는】 미소 지으며 당신을 바라본다.
		<<if $sydneyromance is 1>>"적어도 이제 이 새 안경은 당신을 떠올리게 해주겠네요."<<else>>"고마워요. 저를 위해 이렇게까지 하지 않아도 됐는데."<</if>>
	<<case "playerbroken">>
		<<He>>【은는】 <<his>> <<sydneyGlasses>>【을를】 카운터 직원에게 밀어준다. "이 낡은 것도 그리울 거예요." <<He>>【은는】 미소 지으며 당신을 바라본다.
		"부디 이번 것은 제 얼굴 위에서 부수지 말아주세요?" 당신은 죄책감에 고개를 숙이지만, <<he>>【은는】 장난스럽게 당신을 툭 친다.
	<<case "glasses">>
		"정말요? 지금 쓰는 것도 괜찮은데요."
		<br><br>
		<<if $sydneyromance is 1>>
			"이게 너한테 귀여울 것 같아서." 당신이 말한다. <<He>>【은는】 얼굴을 붉힌다.
			<br><br>
			"그렇다면 받을게요."
		<<else>>
			"이게 더 잘 어울릴 것 같아서요." 당신이 말한다. <<He>>【은는】 고개를 갸웃한다.
			<br><br>
			"음... 알겠어요. 고마워요."
		<</if>>
	<<case "playerbought">>
		"정말요? 이건 당신이 사준 거잖아요. 저도 꽤 마음에 들기 시작했는데요."
		<br><br>
		<<if $sydneyromance is 1>>
			"마음이 바뀌었어. 이게 훨씬 더 귀여워." 당신이 말한다. <<He>>【은는】 얼굴을 붉힌다.
			<br><br>
			"그렇다면 받을게요."
		<<else>>
			"조금 다양해도 나쁠 건 없죠." 당신이 말한다. <<He>>【은는】 고개를 갸웃한다.
			<br><br>
			"음... 알겠어요. 고마워요."
		<</if>>
	<<case "contacts">>
		"안경 쓰는 게 조금 그립긴 했어요. 고마워요!" <<He>>【은는】 <<his>> 오래된 안경을 카운터 직원에게 밀어준다.
<</switch>>
안경사는 새 안경을 쓴 시드니에게 간단한 시력 검사를 해준다. 잘 끝나고, 당신들은 쇼핑 센터로 다시 나온다. <<trauma -3>><<ltrauma>><<npcincr Sydney love 1>><<glove>>
<br><br>
<<link [[떠난다 (0:01)|Sydney Shopping Centre]]>><<pass 1>><<set $sydney.glasses to "playerbought">><</link>>
<br>

:: Sydney Shopping Buy Contacts
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>
당신은 시드니에게 콘택트렌즈 한 통과 그것을 제대로 관리하는 데 필요한 모든 것을 사준다.
<br><br>
<<switch $sydney.glasses>>
	<<case "broken">>
		<<He>>【은는】 <<his>> <<sydneyGlasses>>【을를】 카운터 직원에게 밀어준다. "이 낡은 것도 그리울 거예요." <<He>>【은는】 미소 지으며 당신을 바라본다.
		"적어도 이건 제 얼굴 위에서 깨질 걱정은 안 해도 되겠네요. 고마워요. 저를 위해 이렇게까지 하지 않아도 됐는데."
	<<case "playerbroken">>
		<<He>>【은는】 <<his>> <<sydneyGlasses>>【을를】 카운터 직원에게 밀어준다. "이 낡은 것도 그리울 거예요." <<He>>【은는】 미소 지으며 당신을 바라본다.
		"적어도 이제 당신이 저를 거칠게 다룰까 걱정하지 않아도 되겠네요." <<npcincr Sydney lust 1>><<glust>>
	<<case "glasses">>
		"뭐, 안경은 꽤 거추장스럽긴 하죠... 그리고 <<nnpc_Mum "Sirris">>께서도 제가 안경이 없을 때 더 귀엽다고 하셨고..."
		<br><br>
		<<if $sydneyromance is 1>>
			"<<nnpc_Hes "Sirris">> 말이 맞아요." 당신이 말한다. <<He>>【은는】 얼굴을 붉힌다.
			<br><br>
			"그렇다면 받을게요."
		<<else>>
			"그냥 한 번 써보는 것도 나쁘지 않죠." 당신이 말한다. <<He>>【은는】 고개를 갸웃한다.
			<br><br>
			"음... 알겠어요. 고마워요."
		<</if>>
	<<case "playerbought">>
		"정말요? 이 안경은 당신이 사준 거고, 저도 꽤 마음에 들기 시작했는데요."
		<br><br>
		<<if $sydneyromance is 1>>
			"마음이 바뀌었어. 안경 없는 네 모습이 귀여울 것 같아." 당신이 말한다. <<He>>【은는】 얼굴을 붉힌다.
			<br><br>
			"그렇다면 받을게요."
		<<else>>
			"조금 다양해도 나쁠 건 없죠." 당신이 말한다. <<He>>【은는】 고개를 갸웃한다.
			<br><br>
			"음... 알겠어요. 고마워요."
		<</if>>
	<<case "contacts">>
		<<He>>【은는】 혼란스럽게 당신을 본다. "저 이미... 지금도 끼고..." 당신은 더 설명하지 않고 어쨌든 구매한다.
<</switch>>
안경사는 새 콘택트렌즈를 낀 시드니에게 간단한 시력 검사를 해준다. 잘 끝나고, 당신들은 쇼핑 센터로 다시 나온다. <<trauma -3>><<ltrauma>><<npcincr Sydney love 1>><<glove>>
<br><br>
<<link [[떠난다 (0:01)|Sydney Shopping Centre]]>><<pass 1>><<set $sydney.glasses to "contacts">><</link>>
<br>

:: Sydney Shopping Hairdressers
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>><<run statusCheck("Sydney")>>
<<set $daily.sydney.shopHair to true>>
당신과 시드니는 미용실로 들어간다. 이곳에서는 머리를 자르거나 염색할 수 있다. 빈 의자가 두 개 있다.
<br><br>
<<if !$sydneySeen.includes("hairchange")>>
	<<if _sydneyStatus.includes("corrupt")>>
		<<Hes>> 거의 신나서 뛰어오를 듯하다. "머리 염색이나 스타일링을 몇 번 생각해본 적 있어요. 진짜 하는 건가요?"
	<<else>>
		<<He>>【은는】 불안해 보인다. "<<nnpc_Brother "Jordan">> 조던께서 늘 제 머리를 칭찬하셨어요. 그래서 염색하거나 자른 적이 없었죠. 그래도, 당신이 원한다면..."
	<</if>>
<<elseif C.npc.Sydney.hairColour isnot "strawberryblond">>
	<<He>>【은는】 잠시 멈춘다. "염색을 빼려는 건가요?"
<<else>>
	<<He>>【은는】 미소 짓는다. "전문가에게 머리를 맡기는 건 묘하게 마음이 편해져요. 여기 좋아요."
<</if>>
<br><br>
<<if $money gte 3000>>
	<<link [[자리에 앉는다|Sydney Hairdressers Sit]]>><</link>>
	<br>
<<else>>
	<span class="purple">돈이 부족하다.</span>
<</if>>
<br>
<<link [[떠난다 (0:01)|Sydney Shopping Centre]]>><<pass 1>><</link>>
<br>

:: Sydney Hairdressers Sit
<<run statusCheck("Sydney")>>
<<effects>>
당신은 시드니를 빈 의자 중 하나로 데려가고, <<him>>의 옆자리에 앉는다.
<<generate2>><<person2>>미용사인 <<person>> 하나가 곧 두 사람 뒤에 나타난다.<<person1>> "좋아요, 
<<if $sydneyromance is 1>>
	이 귀여운 커플은 뭘 해드릴까요?" 시드니는 <<if _sydneyStatus.includes("corrupt")>>자랑스레 미소 짓는다<<else>>살짝 얼굴을 붉힌다<</if>>.
<<else>>
	<<if $player.gender_appearance is "m" and $pronoun is "m">>
		두 멋진 신사분은 뭘 해드릴까요?"
	<<elseif $player.gender_appearance is "f" and $pronoun is "f">>
		두 아름다운 숙녀분은 뭘 해드릴까요?"
	<<else>>
		두 분은 뭘 해드릴까요?"
	<</if>>
<</if>>
<br><br>
<<if !$sydneySeen.includes("hairchange")>>
	<<person2>><<He>>【은는】 시드니에게 헤어 디자인과 색상 예시를 몇 가지 보여준다.<<person1>>
	당신은 <<his>> 눈이 검은 포니테일을 한 <<personsimple>> 사진에 머무르는 것을 알아차린다. <<He>>【은는】 한쪽 눈을 덮는 풀어헤친 머리의 <<personsimple>>도 바라본다.
	<br><br>
<</if>>
<<hairdressersPricelist>>
<<set $sydneyHairOption to $sydney.hair>>
<<set $dyeOption to "noChange">>
<div id="currentCost" class="gold">
	지불 금액: £0
</div>
<div id="hairDressersSydney">
	<<hairDressersOptionsSydney>>
</div>
<<hairdressersResetAlt>>
<<if $money gte _currentCost>>
	<<link [[계속|Sydney Hairdressers Sit 2]]>><<money `-_currentCost` "hairdressers">><</link>>
<<elseif $money lt _currentCost>>
	미용사에게 지불할 돈이 부족하다.
<</if>>
<br><br>
<<link [[떠난다|Sydney Hairdressers Cancel]]>><<endevent>><</link>>

:: Sydney Hairdressers Sit 2
<<effects>>
<<set _sydneyPresent to true>><<set _pass to 0>>
<<if $sydneyHairOption is $sydney.hair and $dyeOption is "noChange">>
	<<set _cancel to true>>
	당신과 시드니는 <<his>> 머리를 손대지 않기로 한다. <<person2>><<He>>【은는】 당신 뒤에 선다. "좋아요. 그럼 당신은요?"
<<else>>
	<<set $sydneyHairDone to true>>
	당신은 돈을 건네고, <<person2>><<he>>【은는】 시드니에게 작업을 시작한다.
	<<if !$sydneySeen.includes("hairchange")>>
		<<person1>><<His>> 눈이 커진다. "저기, 정말 괜찮아요? 제가 낼 수도 있었는데."
	<</if>>
	<<if $sydneyHairOption isnot $sydney.hair>>
		<<set $sydneyStyle to true>>
		미용사는<<if $sydney.hair is "ponytail">> 시드니의 포니테일을 조심스럽게 푼다<<else>> 시드니의 머리를 손질하기 시작한다<</if>> 그리고 빗질을 시작한다.
		<<set $sydney.hair to clone($sydneyHairOption)>>
		<<set _pass += 5>>
		<<unset $sydneyHairOption>>
	<</if>>
	<<if $dyeOption is "removeDye">>
		<<set $sydneyDyeRemove to true>>
		<<if _pass gt 0>>
			<<He>>【은는】 이어 시드니의 머리색을 씻어내는 과정을 시작한다.
		<<else>>
			미용사는 시드니에게 <<nnpc_his "Sydney">> 머리를 뒤로 젖히라고 하고, <<nnpc_his "Sydney">> 머리색을 씻어내기 시작한다.
		<</if>>
		<<set C.npc.Sydney.hairColour to "strawberryblond">>
		<<set _pass += 15>>
		<<unset $dyeOption>>
	<<elseif $dyeOption isnot "noChange">>
		<<set $sydneyDye to true>>
		<<set C.npc.Sydney.hairColour to clone($dyeOption)>>
		<<if _pass gt 0>>
			<<He>>【은는】 이어 염색약을 바르기 시작한다.
		<<else>>
