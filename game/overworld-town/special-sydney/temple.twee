		<br>
		<<if $money gte 100>>
			<<link [[작게 기부한다 (£1)|Temple Plate Donation]]>><<set $phase to 0>><<money -100>><<trauma -6>><<famegood 1>><<npcincr Sydney love 1>><</link>><<ltrauma>><<glove>>
			<br>
		<</if>>
