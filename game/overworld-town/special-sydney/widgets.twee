						<<priest>>【이가】 당신을 채찍질하기 위해 움직인다.
						<<set $priestAction to "Player">>
					<<case 2>>
						<<priest>>【이가】 시드니를 채찍질하기 위해 움직인다.
						<<set $priestAction to "Sydney">>
					<<case 3>>
						<<priest>>【이가】 높아진 진동을 유지한다.
				<</switch>>
		<</switch>>
		</span>
		<br><br>
		<<if $sydneyHold lte 4>>
			<<link [[시드니를 더 꽉 껴안는다|Sydney Temple Punish Hold]]>><<set $sydneyHold += 1>><<pain -3>><<set $sydneyPain -= 1>><</link>><<lpain>><<gspain>>
			<br>
		<</if>>
		<<if $sydneyStop lte 4>>
			<<link [[정조대의 진동을 막는다|Sydney Temple Punish Belt]]>><<set $sydneyStop += 1>><<set $sydneyArousal -= 2>><<arousal -2500>><</link>><<llarousal>><<llsarousal>>
			<br>
		<</if>>
		<<if $sydneyHit lte 3 and $priestAction is "Sydney">>
