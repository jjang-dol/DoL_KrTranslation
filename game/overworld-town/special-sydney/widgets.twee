			<br>
		<</if>>
		<<switch $sydneyTouch>>
			<<case 0>>
				<<link [[시드니를 더듬는다|Sydney Temple Punish Touch]]>><<set $sydneyTouch += 1>><<arousal 1500>><<set $sydneyPain -= 4>><</link>><<garousal>><<gsarousal>><<lllspain>><<promiscuous1>>
				<br>
			<<case 1>>
