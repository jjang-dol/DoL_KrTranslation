	<</if>>
<</widget>>

<<widget "priestAttack">>
	<<switch $priestAction>>
		<<case "Player">>
			<<if $sydneyPain lte 3 and ($pain gte 50 or $sydneyArousal gte 4)>>
				<<person2>><<priest>>【이가】 <<his>> 채찍을 내리치지만, 시드니가 갑자기 몸을 날려 <span class="green">당신 대신 채찍에 맞는다.</span> <<person1>><<He>>【이가】 고통스럽게 비명을 지른다. <<set $sydneyPain += 2>><<set $sydneyArousal -= 1>><<ggspain>><<lsarousal>>
			<<else>>
				<<person2>><<priest>>【이가】 당신에게 <<his>> 채찍을 내리치고, 당신은 재갈을 문 채로 비명을 지른다.
				<<if $pain gte 60>>
					시드니가 소리치며 <<his>> 고개를 가로젓고는, 애원하는 눈길로 <<person2>><<priest>>【을를】 바라본다.
				<<else>>
					시드니가 <<person2>><<him>>【을를】 노려본다.
				<</if>>
				<<violence_noncombat 30 0.3>><<gpain>>
			<</if>>
		<<case "Sydney">>
			<<if !_blocked>>
				<<person2>><<priest>>【이가】 <<his>> 채찍을 내리쳐 시드니를 후려친다.
				<<if $sydneyPain gte 3>>
					<<person1>><<He>>【은는】 <<his>> 재갈을 문 채로 신음을 내지른다.
				<<else>>
					<<person1>><<He>>【은는】 <<his>> 비명을 참아낸다.
				<</if>>
				<<set $sydneyPain += 2>><<set $sydneyArousal -= 1>><<ggspain>><<lsarousal>>
			<</if>>
		<<case "Vibrate">>
			진동이 점점 더 강렬해진다.
			<<if $sydneyArousal gte 3>>
				시드니가 당신의 어깨에 대고 신음한다.
			<<else>>
				시드니가 헐떡임과 신음을 간신히 참아낸다.
			<</if>>
			<<arousal 2000>><<set $sydneyArousal += 1>><<garousal>><<gsarousal>>
	<</switch>>
<</widget>>

<<widget "sydneyTortureFail">>
	<<set $punishmentCounter += 1>>
	<<person2>><<priest>>【이가】 <<his>> 손을 치켜든다. "그만." <<monks>>【은는】 멈춰 서서 향로의 불을 끈다. "너희들의 몸이 스스로를 배신하는구나. 회복할 시간을 줄 테니, 그 후에 다시 시작하겠다." <<stress 24>><<gggstress>>
	<br><br>
	<<monks>>【이가】 방의 조명을 어둡게 하고, 한 명씩 자리를 떠난다. 마지막 사람이 나가자, 당신과 시드니는 완전한 어둠 속에 남겨진다.
	<br><br>
	피부에 시드니의 숨결이 느껴진다. <<nnpc_hes "Sydney">> 여전히 그곳에 있다는 사실이 당신을 어쩐지 안심시킨다. <<nnpc_He "Sydney">>【이가】 당신을 더 꽉 끌어안는다. 당신도 마주 안아준다. <<stress -1>><<lstress>>
	<br><br>

	<<if playerBellySize() gte 15>>
		두 사람 사이에서 희미한 제3의 심장 박동이 느껴진다.
		<br><br>
	<</if>>

	<<link [[휴식한다 (1:00)|Sydney Temple Punish Repeat]]>><<pass 1 hour>><<set $sydneyPain -= 4>><<set $sydneyArousal -= 4>><<pain -30>><</link>><<lllpain>>
	<br>
<</widget>>

<<widget "gspain">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">+ 시드니의 고통</span>
	<</if>>
