:: Island Bed
<<set $outside to 0>><<effects>>

<<if $island.home is "rocky_hillock">>
	당신은 돌출부 아래, 부드러운 이끼 침대 위에 누워 있다. 주변의 바위가 바람과 비로부터 당신을 보호해 준다.
	<br><br>
<</if>>

<<generateSleepLinks "Island Sleep">>

<<link [[침대에서 나온다|Island]]>><<storeon "bed">><<set $wardrobe_location to "wardrobe">><<loadTempHairStyle>><<endevent>><</link>>
<br><br>

:: Island Sleep
<<set _autosavehere to true>>
<<effects>>

<<sleep>><<effects>>
<<sleepeffects>>

<<if $island_wake_3 is 1>>
	<<unset $island_wake_3>>
	<<generateRole 0 0 "islander">>
	<<generateRole 1 0 "islander">>
	<<generateRole 2 0 "islander">>
	<<generateRole 3 0 "islander">>
	<<person1>>
	<<if $island[$island.home].trap is "simple" and random(1, 2) is 2 or $island[$island.home].trap is "basic" and random(1, 4) gte 2 or $island[$island.home].trap is "advanced">>
		비명 소리에 잠에서 깬다. 당신의 덫에 누군가 걸렸다. 하지만 다른 세 사람의 목소리가 이쪽으로 다가오고 있다.<<lcamp_concealment>><<set $island.hide += 1>>
		<br><br>
		<<endevent>>
		<<generateRole 0 0 "islander">>
		<<generateRole 1 0 "islander">>
		<<generateRole 2 0 "islander">>
		<<person1>>
		<<link [[몸을 지킨다|Island Sleep Defend]]>><<set $phase to 1>><<unset $island_roll>><</link>>
		<br>
		/*
		<<set $island_roll to random(1, 100)>><<set $island_roll += (13 * $island.hide)>>
		<<link [[Skulk away|Island Sleep Skulk]]>><<set $phase to 1>><</link>><<difficulty $island_roll>>
		<br>
		*/
		<<set $skulduggerydifficulty to (800 + (50 * $island.hide))>>
		<<link [[슬쩍 피한다|Island Sleep Hide 3]]>><<set $phase to 1>><<unset $island_roll>><</link>><<skulduggerydifficulty>>
		<br>
	<<else>>
		<<if $islander_language gte 100>>
			<span class="pink">요란한 목소리</span>에 잠에서 깬다. 그들은 자신들의 존재를 알리고 있다.
			<br>
			"안에 있는 거 다 알아." <<personssimple>> 목소리가 말한다.
			<br>
			"순순히 굴면 얌전히 대해주지." 다른 목소리가 말한다.
		<<elseif $islander_language gte 50>>
			<span class="pink">요란한 목소리</span>에 잠에서 깬다. 그들은 자신들의 존재를 알리고 있다. 조롱하는 어조로 당신을 부르는 것 같다.
		<<else>>
			<span class="pink">요란한 목소리</span>에 잠에서 깬다. 그들은 자신들의 존재를 알리고 있다. 그들의 언어는 이해할 수 없지만, 점점 가까워지고 있다.
		<</if>>
		<<lcamp_concealment>><<set $island.hide += 1>>
		<br><br>
		<<link [[몸을 지킨다|Island Sleep Defend]]>><<unset $island_roll>><</link>>
		<br>
		/*
		<<set $island_roll to random(1, 100)>><<set $island_roll += (12 * $island.hide)>>
		<<link [[Skulk away|Island Sleep Skulk]]>><</link>><<difficulty $island_roll>>
		<br>
		*/
		<<set $skulduggerydifficulty to (700 + (50 * $island.hide))>>
		<<link [[슬쩍 피한다|Island Sleep Hide 3]]>><<unset $island_roll>><</link>><<skulduggerydifficulty>>
		<br>
		<br>
	<</if>>
<<elseif $island_wake_2 is 1>>
	<<unset $island_wake_2>>
	<<generateRole 0 0 "islander">>
	<<generateRole 1 0 "islander">>
	<<generateRole 2 0 "islander">>
	<<person1>>
	<<if $island[$island.home].trap is "simple" and random(1, 2) is 2 or $island[$island.home].trap is "basic" and random(1, 4) gte 2 or $island[$island.home].trap is "advanced">>
		<<personssimple>> 비명 소리에 잠에서 깬다. 당신의 덫에 누군가 걸렸지만, 다른 두 사람의 목소리가 이쪽으로 다가오고 있다.<<lcamp_concealment>><<set $island.hide += 1>>
		<<endevent>>
		<<generateRole 0 0 "islander">>
		<<generateRole 1 0 "islander">>
		<<person1>>
		<br><br>
		<<link [[기습한다|Island Sleep Ambush]]>><<unset $island_roll>><</link>>
		<br>
		/*
		<<set $island_roll to random(1, 100)>><<set $island_roll += (6 * $island.hide)>>
		<<link [[Slink away|Island Sleep Slink]]>><</link>><<difficulty $island_roll>>
		<br>
		*/
		<<set $skulduggerydifficulty to (300 + (50 * $island.hide))>>
		<<link [[슬그머니 피한다|Island Sleep Hide 2]]>><<set $phase to 1>><<unset $island_roll>><</link>><<skulduggerydifficulty>>
		<br>
	<<else>>
		<span class="pink">목소리들</span>에 잠에서 깬다. 세 사람이 소곤거리며 이야기하고 있다. 그들은 점점 가까워지고 있다.<<lcamp_concealment>><<set $island.hide += 1>>
		<br><br>

		<<link [[기습한다|Island Sleep Ambush]]>><<unset $island_roll>><</link>>
		<br>
		/*
		<<set $island_roll to random(1, 100)>><<set $island_roll += (11 * $island.hide)>>
		<<link [[Slink away|Island Sleep Slink]]>><</link>><<difficulty $island_roll>>
		<br>
		*/
		<<set $skulduggerydifficulty to (600 + (50 * $island.hide))>>
		<<link [[슬그머니 피한다|Island Sleep Hide 2]]>><<unset $island_roll>><</link>><<skulduggerydifficulty>>
		<br>
	<</if>>
<<elseif $island_wake_1 is 1>>
	<<unset $island_wake_1>>
	<<generateRole 0 0 "islander">>
	<<generateRole 1 0 "islander">>
	<<person1>>
	<<if $island[$island.home].trap is "simple" and random(1, 2) is 2 or $island[$island.home].trap is "basic" and random(1, 4) gte 2 or $island[$island.home].trap is "advanced">>
		<<person1>><<personsimple>> 비명 소리에 잠에서 깬다. 누군가 당신의 덫을 건드렸다. 두 번째 목소리가 들려오며 점점 커진다. 곧 도착할 테지만, 혼자인 것 같다.<<lcamp_concealment>><<set $island.hide += 1>>
		<<endevent>>
		<<generateRole 0 0 "islander">>
		<br><br>
		<<link [[일어나서 맞선다|Island Sleep Confront Trapped]]>><<unset $island_roll>><</link>>
		<br>
		/*
		<<set $island_roll to random(1, 100)>><<set $island_roll += (5 * $island.hide)>>
		<<link [[Remain motionless|Island Sleep Motionless Trapped]]>><</link>><<difficulty $island_roll>>
		<br>
		*/
		<<set $skulduggerydifficulty to (200 + (100 * $island.hide))>>
		<<link [[숨는다|Island Sleep Hide Trapped]]>><<unset $island_roll>><</link>><<skulduggerydifficulty>>
		<br>
	<<else>>
		<span class="pink">위험을 감지</span>하고 깜짝 놀라 잠에서 깬다. 속삭이는 소리가 들린다.<<lcamp_concealment>><<set $island.hide += 1>>
		<br><br>

		<<link [[일어나서 속삭임의 근원과 맞선다|Island Sleep Confront]]>><<unset $island_roll>><</link>>
		<br>
		/*
		<<set $island_roll to random(1, 100)>><<set $island_roll += (10 * $island.hide)>>
		<<link [[Remain motionless|Island Sleep Motionless]]>><</link>><<difficulty $island_roll>>
		<br>
		*/
		<<set $skulduggerydifficulty to (500 + (100 * $island.hide))>>
		<<link [[숨는다|Island Sleep Hide]]>><<unset $island_roll>><</link>><<skulduggerydifficulty>>
		<br>
	<</if>>
<<else>>
	편안하게 잠을 잔다,
	<<if Time.dayState is "night">>
		그리고 바람 소리에 잠에서 깬다.
	<<else>>
		그리고 지저귀는 새소리에 잠에서 깬다.
	<</if>>
		<br><br>
	<<link [[다음|Island]]>><</link>>
	<br>
<</if>>

:: Island Sleep Defend
<<effects>>

<<if $phase is 1>>
	당신이 왕좌에서 기다리자 목소리가 가까워진다. <<person1>><<person>>, <<person2>><<person>>, 그리고 <<person3>><<person>>【이가】 나무들 사이에서 걸어 나온다.
<<else>>
	당신이 왕좌에서 기다리자 목소리가 가까워진다. <<person1>><<person>>, <<person2>><<person>>, <<person3>><<person>>, 그리고 <<person4>><<person>>【이가】 나무들 사이에서 걸어 나온다.
<</if>>
<<if $island[$island.home].chair is "advanced">>
	당신의 자세에 그들이 잠시 멈칫한다.
	<br><br>
	<<if $islander_language gte 100>>
		"이 무력한 창녀가 섬을 지배할 수 있다고 생각하는군." <<person1>><<person>>【이가】 소리친다. "<<phim>>에게 <<pher>> 분수를 가르쳐주자."
	<<elseif $islander_language gte 50>>
		<<person1>><<person>>【이가】 당신에게 분수를 가르쳐주겠다는 내용의 말을 소리치더니, 그들이 돌격한다.
	<<else>>
		<<person1>><<person>>【이가】 이해할 수 없는 언어로 무언가 소리치더니, 그들이 돌격한다.
	<</if>>
	<br><br>

	<<link [[다음|Island Sleep Fight]]>><<set $fightstart to 1>><</link>>
	<br>
<<else>>
	<br><br>
	<<if $islander_language gte 100>>
		"드루이드가 원하는 게 바로 이 자다." <<person1>><<person>>【이가】 소리친다. "돌격!"
	<<elseif $islander_language gte 50>>
		<<person1>><<person>>【이가】 특별히 당신을 찾고 있었다는 내용의 말을 소리치더니, 그들이 돌격한다.
	<<else>>
		<<person1>><<person>>【이가】 이해할 수 없는 언어로 소리치더니, 그들이 돌격한다.
	<</if>>
	<br><br>

	<<link [[다음|Island Sleep Fight]]>><<set $fightstart to 1>><</link>>
	<br>
<</if>>

:: Island Sleep Skulk
<<effects>>

<<if $phase is 1>>
	당신은 잠자리에서 살금살금 빠져나와, <<person1>><<person>>, <<person2>><<person>>, 그리고 <<person3>><<person>>【이가】 시야에 들어올 때까지 잎사귀 사이에 몸을 낮춘다.
<<else>>
	당신은 잠자리에서 살금살금 빠져나와, <<person1>><<person>>, <<person2>><<person>>, <<person3>><<person>>, 그리고 <<person4>><<person>>【이가】 시야에 들어올 때까지 잎사귀 사이에 몸을 낮춘다.
<</if>>
<<if $rng gte $island_roll>>
	<span class="green">그들은 당신을 알아채지 못하고 바로 지나간다.</span> 그리고는 알 수 없는 곳으로 계속 나아간다.
	<br><br>

	<<link [[다음|Island]]>><<endevent>><</link>>
	<br>
<<else>>
	<<if $islander_language gte 100>>
		그들이 서로 속삭인다.
		<br>
		"잃어버린 그 아이인 것 같나?"
		<br>
		"조용히 해, 들키겠어."
		<br>
		"맞아!" <<person1>><<person>>【이가】 소리친다. "저기다!" <<He>>【이가】 당신을 똑바로 가리킨다.
	<<elseif $islander_language gte 50>>
		그들은 서로 속삭이며, 무언가를 찾는 듯 땅을 훑어보며 질문을 던진다. <<person2>><<person>>【이가】 <span class="red">소리를 지르며 당신을 똑바로 가리킨다.</span>
	<<else>>
		그들은 이해할 수 없는 언어로 서로 속삭이며 무언가를 찾는 듯 땅을 훑어본다. <<person2>><<person>>【이가】 <span class="red">소리를 지르며 당신을 똑바로 가리킨다.</span>
	<</if>>
	<br><br>

	<<link [[싸운다|Island Sleep Fight]]>><<set $fightstart to 1>><</link>>
	<br>
	<<link [[굴복한다 (0:30)|Island Sleep Submit]]>><</link>>
	<br>
<</if>>
<<unset $island_roll>>

:: Island Sleep Hide 3
<<effects>>

당신은 그림자 속으로 사라져 미동도 하지 않는다. 이제 그들의 속삭임이 더 선명하게 들린다.
<<if $islander_language gte 100>>
	여러 사람이 말하고 있다.
	"나오면, 얌전히 대해주지."
	<br>
	"난 차라리 제대로 저항해줬으면 좋겠는데."
	<br>
	"너무 다치게 하면 드루이드가 화낼지도 몰라."
<<elseif $islander_language gte 50>>
	여러 사람이 말하고 있다. 그들이 당신을 찾고 있다는 것을 알 수 있을 만큼은 이해할 수 있다.
<<else>>
	여러 사람이 말하고 있지만, 당신에게는 이해할 수 없는 언어다.
<</if>>
<br><br>

<<if $phase is 1>>
	당신은 그림자 속에 누워, <<person>>, <<person2>><<person>>, 그리고 <<person3>><<person>>【이가】 시야에 들어오는 것을 지켜본다. 각자 이상한 사슴뿔 가면을 쓰고 있다.
<<else>>
	당신은 그림자 속에 누워, <<person>>, <<person2>><<person>>, <<person3>><<person>>, 그리고 <<person4>><<person>>【이가】 시야에 들어오는 것을 지켜본다. 각자 이상한 사슴뿔 가면을 쓰고 있다.
<</if>>
<br><br>

<<skulduggerycheck>>
<<if $skulduggerysuccess is 1>>
	그들은 당신의 잠자리 앞에 멈춰 서더니, <span class="green">당신 쪽은 쳐다보지도 않고</span> 계속 나아간다.
	<br><br>

	<<skulduggeryuse>>

	<<link [[다음|Island]]>><<endevent>><</link>>
	<br>

<<else>>

