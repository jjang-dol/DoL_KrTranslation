:: Adult Shop Lube Price [widget]
<<widget lubePrice>>
	<<if _args[0] lte 50>>
		<<set _price to _args[0] * 2000 * .98>>
	<<elseif _args lte 150>>
		<<set _price to 50 * 2000 * .98 + (_args[0] - 50) * 2000 * .95>>
	<<else>>
		<<set _price to 50 * 2000 * .98 + 50 * 2000 * .95 + (_args[0] - 100) * 2000 * .92>>
	<</if>>
<</widget>>
