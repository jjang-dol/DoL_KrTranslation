:: Adult Shop Widgets [widget]

<<widget "adultShopEvents">>
	<<endevent>><<generateAdultShopCustomer 1>>

	<<set _reactTone to either("코웃음 친다","외친다","조용히 한탄한다","얼굴을 감싼다","노려보고 <<his>> 눈을 굴린다")>>
	<<set _reactSpeech to ["그건 부적절합니다,"]>>
	<<set _reactPerson to "Sirris">>
	<<set _reactTitle to "과학 교사">>

	<<if $adultshopstate is "sydney" and random(0,1) is 1>>
		<<set _reactSpeech to [
			"맙소사!",
			"무엇을 도와드릴까요?",
			"그건 부적절해요.",
			"흠?",
			"흠?",
			"ㅁ-뭐... 조심 좀 해주세요."
		]>>
		<<set _reactTone to either("코웃음 친다","외친다","<<nnpc_his \"Sydney\">> 눈을 가리며 중얼거린다","카운터 뒤로 물러난다")>>
		<<run statusCheck("Sydney")>>
		<<if _sydneyStatus.includes("corrupt")>>
			<<set _reactPerson to "Sydney">>
				<<set _reactSpeech to [
					"이거 아주 멋지군,",
					"그건 부적절해요,",
					"꺼져, 이 패배자야!",
					"뭐라도 사든가 비켜,",
					"뭘 사든지 아니면 꺼져!",
					"제기랄!",
					"못된 아이네! 너를 어떻게 해야 할까?",
					"와. 진짜 와,",
					"쯧, 쯧,",
					"내 거나 빨아!",
					"장난감 추천이라도 필요하신가요?"
				]>>
			<<set _reactTone to either("코웃음 친다","외친다","얼굴을 감싼다","한탄한다","제안한다","노려보고 <<nnpc_his Sydney>> 눈을 굴린다","야유한다")>>
		<</if>>
		<<set _reactTitle to window.KR.getNpcTitleKr(C.npc.Sydney.title) + (C.npc.Sydney.gender is "m" ? " 소년" : " 소녀")>>
		<<set _reactPerson to "Sydney">>
	<<else>>
		<<set _reactSpeech.push(
			"못된 아이네! 너를 어떻게 해야 할까?",
			"이것보단 잘할 수 있잖아, 자 어서,",
			"도움이 필요하신가요? 신기한 모양의 애널 플러그에 관심 있으신가요?",
			"오, 얌전히 굴어!",
			"맙소사!",
			"쯧, 쯧,",
			"다른 손님들을 배려해주세요!"
		)>>
		<<set _reactTone to either("코웃음 친다","외친다","얼굴을 감싼다","킬킬 웃는다","어이없다는 듯 숨을 내쉰다","선의로 한숨을 쉰다","제안한다","활짝 웃는다","딜도로 가리킨다","손가락을 까딱인다")>>
		<<set _reactPerson to "Sirris">>
		<<set _reactTitle to window.KR.getNpcTitleKr(C.npc.Sirris.title)>>
	<</if>>

	<<if $adultshopintro is 0 or ($adultshopintro is 1 and random(2) is 0)>>
		<<adultShopBackgroundEvent>>
		<<if $adultshopstate is "sydney">>
			<br><br>
			<<set _reactPerson to (_reactPerson is "Sydney" ? "Sirris" : "Sydney")>>
			<<adultShopPersonEvent>>
		<</if>>
	<<else>>
		<<adultShopPersonEvent>>
		<<if $adultshopstate is "sydney">>
			<<set _reactPerson to (_reactPerson is "Sydney" ? "Sirris" : "Sydney")>>
			<<adultShopPersonEvent>>
		<</if>>
	<</if>>
<</widget>>

<<widget "adultShopBackgroundEvent">>
	<<endevent>><<generateAdultShopCustomer 1>>
	/*<<set _reactTone to _args[0]>>
	<<set _reactSpeech to _args[1]>>
	<<set _reactPerson to _args[2]>>
	<<set _reactTitle to _args[3]>>*/
	<!-- Background event pool -->
	<<switch random(0,12)>>
		<<case 0 1>>
			<<print window.KR.getDescriptionKr($NPCList[0].fullDescription)>>【이가】 딜도를 도발적으로 들어 올리며 당신을 음흉하게 바라본다.
			<<if $adultshopstate is "sydney" and _sydneyStatus.includes("corrupt")>>
				<<set _reactSpeech.push("뭐라도 사든가 비켜.","그건 부적절해요.","변태 출몰!")>>
			<</if>>
		<<case 2 3>>
			<<person1>><<person>>【이가】 초조한 듯 몸을 뒤척이며, <<his>> 가랑이에 <<print either("딜도","DVD","잡지","애널 플러그")>>【을를】 문지르며 신음을 흘린다.
			<<if $adultshopstate is "sydney" and _sydneyStatus.includes("corrupt") and _reactPerson is "Sydney">>
				<<set _reactSpeech to ["그건 부적절해요.","변태 출몰!","그거 계산은 해야 할 거야.","그거 계산은 해야 할 거야.","써 보기 전에 먼저 사, 변태야.","뭐라도 사든가 꺼져!","뭐라도 사든가 비켜."]>>
			<</if>>
			<<if _reactPerson is "Sydney">>
				<<set $_purityLoss to true>>
			<</if>>
		<<case 4 5>>
			<<person1>><<person>>【이가】 _reactTitle에게 <<print either("말한다","부드럽게 속삭인다","<<laughs>>")>>,
			<<print either("\"이봐 자기, 이것 좀 모델해 줄래?\"",
			"\"이봐 자기, 이 기구 어떻게 쓰는지 좀 보여줄래?\"",
			"\"끝내주네, 자기!\" <<He>>【이가】 늑대 휘파람을 분다.")>>
			<<if $adultshopstate is "sydney" and _sydneyStatus.includes("corrupt") and _reactPerson is "Sydney">>
				<<set _reactSpeech.push("그건 부적절해요.","내 엉덩이나 빨아, 오줌 싸개야!","변태 출몰!","꿈 깨, 병신아!")>>
			<<elseif $adultshopstate is "sirris">>
				<<set _reactSpeech.push("여기서 무슨 일이죠?")>>
			<</if>>
			<<if _reactPerson is "Sydney">>
				<<set $_purityLoss to true>>
			<</if>>
		<<case 6 7>>
			<<person1>><<person>>【이가】 코트 깃을 여미며 은밀하게 주위를 살핀다. <<He>>【은는】 _reactTitle에게 달려가 코트를 활짝 열어젖히며, <<his>> 생식기를 노출한다.
			<<if $adultshopstate is "sydney" and _sydneyStatus.includes("corrupt") and _reactPerson is "Sydney">>
				<<set _reactSpeech.push("변태 출몰!","제기랄!","출입 금지, 금지라고, 꺼져! 출입 금지야!")>>
				<<set _reactTone to "<<nnpc_his Sydney>> 얼굴을 가리고 카운터 뒤로 물러난다">>
			<<elseif $adultshopstate is "sydney" and _reactPerson is "Sydney">>
				<<set _reactSpeech.push("아, 또야!")>>
				<<set _reactTone to "<<nnpc_his Sydney>> 얼굴을 가리고 카운터 뒤로 물러난다">>
			<</if>>
			<<if _reactPerson is "Sydney">>
				<<set $_purityLoss to true>>
			<</if>>
		<<case 8 9>>
			한 커플이 딜도를 비교하고 있다. <<person1>><<person>>【이가】 장난스럽게 <<generateAdultShopCustomer 2 "couple">><<person2>><<person>>의 얼굴을 후려친다.
		<<case 10 11>>
			잡지에 푹 빠져 있던 <<person1>><<person>>【이가】 딜도가 가득 찬 선반을 넘어뜨린다.

		<<case 12>>
			<!-- Wraith? -->
			<<rngWraith 1>>
			<<if _wraithEvent is true>>
				당신의 귀에 숨 가쁜 목소리가 속삭이는 것이 들린다.
				<br>
				"<span class="wraith"><<print either("너의 매력에 짓눌린 채. 사냥감처럼 맴도는구나","우리는 죽지 않았다. 우리는 계속 살아있었다.","하늘의 불꽃이 꺼졌구나","한때 있었던 것들은 이제 사라졌네. 모든 갈망과 고통이여","내 품으로 떨어지렴, 최면에 걸린 듯한 흔들림을 간직한 채","나는 너의 외로움을 위한 기도란다","꿈의 연못에서, 물이 검게 물드는구나","나의 <<pcPetname \"Wraith\">>")>>.</span>"
				<br>
				깜짝 놀란 당신은 <<print either("윤활제","볼 개그","오나홀","딜도")>> 진열대를 쓰러뜨린다. 휙 돌아보지만, 당신 뒤에는 아무도 없다.
				<<stress 12>><<ggstress>><<trauma 4>><<gtrauma>>
			<<else>>
				무언가 당신의 등을 찌른다. 뒤돌아보니, 입이 귀에 걸리도록 웃고 있는 <<person1>><<person>>【이가】 딜도로 당신을 찌르고 있다.
				<<stress 5>><<gstress>>
			<</if>>
			<<if $adultshopstate is "sydney" and $sydneyromance gte 1>>
				<<set _reactSpeech to ["괜찮아요?","저쪽 괜찮으세요?", "도와드릴까요?"]>>
				<<if $adultshopstate is "sydney" and $sydneyromance gte 1 and _reactPerson is "Sydney">>
					<<set _reactTone to either("묻는다","외친다","어이없다는 듯 숨을 내쉰다","선의로 한숨을 쉰다","제안한다","따뜻하게 미소 짓는다")>>
				<</if>>
			<</if>>
	<</switch>>
	<br>

	"<<print _reactSpeech.random()>>" <<print window.KR.gatPersonNameDictKR(_reactPerson)>>【이가】 _reactTone.
	<<if $adultshopstate is "sydney" and $_purityLoss>>
		<<npcincr Sydney purity -1>><<lspurity>>
	<</if>>
<</widget>>

<<widget "adultShopPersonEvent">>
	<<endevent>><<generateAdultShopCustomer 1>>
	<<if _reactPerson is "Sirris">>
		<<switch random(0,8)>>
		<<case 0>>
			<<set $_topic to either("자기 사업 운영하기","페깅","다양한 윤활제 브랜드","애널 플러그","위생","바디 페인트","딜도","스트로커","다양한 콘돔 종류","바이브레이터","콘돔과 페서리의 차이")>>
			<<if random(1) is 0>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 <<person1>><<person>>【와과】 $_topic의 장점에 대해 의논한다.
			<<else>>
			<<generateAdultShopCustomer 2 "partner">>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 <<fullGroup>>【와과】 $_topic의 장점에 대해 의논한다.
			<</if>>
		<<case 1 2 3>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 계산대에서 일한다.
		<<case 4 5>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【이가】 손님들에게 다양한 <<print either("딜도","페니스 밴드","애널 플러그","윤활제","볼 개그","라텍스 의상","정조대 기구")>>【을를】 보여주고 있다.
		<<case 6>>
			<<generateAdultShopCustomer 2 "partner">>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【이가】 <<fullGroup>>【와과】 커플용 <<print either("페니스 밴드","롤플레이","의상","딜도","본디지 웨어")>>에 대해 상의하고 있다.
		<<case 7>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 소포에 서명한다.
		<<case 8>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 서류들을 꼼꼼히 살펴본다.
		<</switch>>
	<<else>>
		<<switch random(0,7)>>
		<<case 0 1 2>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 카운터를 깨끗하게 닦는다.
		<<case 3>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 부지런히 창문을 닦는다.
		<<case 3>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 선반을 채우고 있다.
		<<case 4>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 재고가 실린 손수레를 밀며 창고에서 나온다.
		<<case 5>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 클립보드를 자세히 들여다본다.
		<<case 6>>
			<<if !_sydneyStatus.includes("corrupt")>>
				<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 손버릇이 나쁜 손님을 피해 카운터 뒤로 물러난다.
			<<else>>
				<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 손님의 손을 찰싹 쳐내고는 <<nnpc_his "Sydney">> 일을 계속한다.
			<</if>>
		<<case 7>>
			<<print window.KR.gatPersonNameDictKR(_reactPerson)>>【은는】 상품의 먼지를 턴다.
		<</switch>>
	<</if>>
<</widget>>

<<widget "getadultshopstate">>
	<<sydneySchedule>>
	<<if Time.hour gte 21 or Time.weekDay is 1 or (Time.weekDay is 7 ? Time.hour lt 9 : Time.hour lt 16) or $adultshophelped is 1>>
		<<set $adultshopstate to "closed">>
	<<elseif _sydney_location is "shop">>
		<<set $adultshopstate to "sydney">>
	<<else>>
		<<set $adultshopstate to "sirris">>
	<</if>>
<</widget>>

<<widget "generateAdultShopCustomer">>
	/* Generates random customers with descriptors unique to the store. _args[1] turns the NPC into a partner */

	<<set $_customertype to [{description:"저속한",hp:220},{description:"수상한",hp:220},{description:"음침한",hp:220},{description:"뚱뚱한",hp:250},{description:"머리를 번들거리게 넘긴",hp:200},{description:"근육질의",hp:275},{description:"노년의",hp:175},{description:"화려한",hp:200},{description:"입을 벌리고 숨 쉬는",hp:200},{description:"소름끼치는",hp:250},{description:"가느다란",hp:200},{description:"키득거리는",hp:200},{description:"뼈마디가 도드라진",hp:175}]>>

	<<if _args[1] isnot undefined>>
		<<set _generate_partner to 1>>
	<</if>>
	<<generateNPC _args[0]>>

	<<set $_npc to $NPCList[_args[0]-1]>>
	<<if $_npc.pronoun is "m">>
		<<set $_customertype.push({description:"잘생긴",hp:200},{description:"거친",hp:250},{description:"난폭한",hp:275},{description:"멋쟁이 같은",hp:175},{description:"탄탄한",hp:250})>>
	<<else>>
		<<set $_customertype.push({description:"예쁜",hp:200},{description:"귀여운",hp:200},{description:"포동포동한",hp:250},{description:"가슴이 큰",hp:220},{description:"굴곡진",hp:220})>>
	<</if>>
	<<set $_chosentype to $_customertype.random()>>
	<<set $_npc.description to $_chosentype.description>>
	<<set $_npc.fullDescription to $_chosentype.description + ($_npc.pronoun is "m" ? " 남자" : " 여자")>>
	<<set $_npc.healthmax to $_chosentype.hp>>
<</widget>>

<<widget "adultShopClear">>
	<<set $adultshopintro to 0>>
	<<endevent>>
<</widget>>

<<widget "adultshopentryevent">>
	/* Events which take you to a specific passage instead of the usual store */
	<<endevent>><<cleareventpool>><<getadultshopstate>>

	<<addinlineevent "entershop" 20>>
		<<shopicon "adult">><<link [[성인용품점 (0:01)|Adult Shop]]>><<pass 1>><</link>>
	<</addinlineevent>>

	<<if $adultshopstate is "sirris">>
		<<addinlineevent "sirrisshopassist" 1>>
			<<shopicon "adult">><<link [[성인용품점 (0:01)|Sirris Shop Assistant 1]]>><<pass 1>><</link>>
		<</addinlineevent>>
	<</if>>

	<<if $adultshopstate is "sydney" and C.npc.Whitney.state is "active">>
		<<addinlineevent "whitneydildothief" 1>>
			<<shopicon "adult">><<link [[성인용품점 (0:01)|Whitney Dildo Thief]]>><<pass 1>><</link>>
		<</addinlineevent>>
	<</if>>

	<<if $adultshopstate is "sydney">>
		<<addinlineevent "customerdildoflirtingsydney" 1>>
			<<shopicon "adult">><<link [[성인용품점 (0:01)|Adult Shop Customer Dildo Flirt Sydney]]>><<pass 1>><</link>>
		<</addinlineevent>>
	<</if>>

	<<if $adultshopstate is "sydney" and !$daily.sydney.adultshop>>
		<<addinlineevent "sydneybackroominvitation" 5>>
			<<shopicon "adult">><<link [[성인용품점 (0:01)|Sydney Backroom Invitation Enter]]>><<pass 1>><</link>>
		<</addinlineevent>>
	<</if>>

	<<runeventpool>>
<</widget>>

<<widget "giveNPCsextoy">>
	/* args[0] = NPC index */
	/* args[1] = Toy name. Possible toys: ("dildo","length of anal beads","riding crop","flog") */
	/* args[2] = Hand. Left blank it will select a random hand */

	<<if _args[0] isnot undefined and _args[1]>>
		<<set $_npc to _args[0]>>
		<<set $_toy to _args[1]>>

		<<if _args[2] isnot undefined>>
			<<set $NPCList[$_npc][_args[2]+"tool"] to $_toy>>
			<<set $NPCList[$_npc][_args[2]+"hand"] to "dildo_reveal">>
		<<else>>
			<<if random(0,1) is 0>>
				<<set $NPCList[$_npc].lefttool to $_toy>>
				<<set $NPCList[$_npc].lefthand to "dildo_reveal">>
			<<else>>
				<<set $NPCList[$_npc].righttool to $_toy>>
				<<set $NPCList[$_npc].righthand to "dildo_reveal">>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "adultshopclerkevents">>
	<<cleareventpool>>
	<<adultShopWage>>

	<<addinlineevent "uneventful" 0.5>>
		교대 시간은 별일 없이 지나간다. 당신은 <<moneyGain _wage>>【을를】 번다.<<glove "Sirris">><<npcincr Sirris love 1>>
		<br><br>
		<<link [[돌아간다|Adult Shop]]>><</link>>
	<</addinlineevent>>

	<<addinlineevent "uneventful2" 0.5>>
		<<set $_tip to _wage>>
		<<if $awareness gte 300 and hasSexStat("promiscuity", 5)>>
			당신은 손님들에게 좋은 조언을 제공하고 자연스럽게 대화를 나눴다.
			<br><br>
			<<set $tipmod to random(1,3)*random(1,3)*random(1,2)/10>>
			<<tipset>>
			<<set $tip += _wage*100>>
			손님들이 당신에게 팁을 조금 주었다. <<tipreceive "adultShop">><<control 1>><<stress -1>><<gcontrol>><<lstress>><<glove "Sirris">><<npcincr Sirris love 1>>
		<<else>>
			당신은 대화를 주도하지만, 그럼에도 불구하고 불편함을 느낀다.<<stress -1>><<lstress>><<gtiredness>><<tiredness 2>>
			<br><br>
			당신은 <<moneyGain _wage>>【을를】 벌었다.
		<</if>>
			<br><br>
		<<link [[돌아간다|Adult Shop]]>><</link>>
