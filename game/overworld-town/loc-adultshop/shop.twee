:: Adult clothing shop widgets [widget]
<<widget "adultShop-main">>
	<<if $tryOn.autoReset isnot false>><<tryOnReset>><</if>><<unset $tempDisable>>
	<<set $outside to 0>><<set $location to "adult_shop">><<effects>>
	<<set $shopName = "adult">>
	<<set _shopCloseOverride to $adultshopstate is "closed">>

	당신은 성인용품점 안에 있다. 페티시 의상과 페니스 밴드가 대량으로 구비되어 있다.
	<br><br>

	<<if $stress gte $stressmax>>
		<<passoutadultshop>>
	<<else>>
		<<if Time.hour is 21 and Time.minute lt 10>>
			폐점 시간이다. 시리스가 사람들을 밖으로 내보내고 있다. <<if $exposed gte 1>>시리스가 이런 차림의 당신을 발견할까 봐 두려워져 패닉이 밀려온다.<</if>>
			<br><br>

			<<set $adultshopstate to "closed">>
			<<if $exposed lte 0>>
				<<elkicon>><<link [[밖으로 나간다|Elk Street]]>><<adultShopClear>><</link>>
				<br>
			<<else>>
				<<ind>><<link [["끝날 때까지 숨어 있는다 (1:00)"|Adult Shop]]>><<pass 1 hour>><</link>>
			<</if>>
		<<else>>
			<div id="tryonstats-div"><<tryOnStats>></div>
			<<unset $shopListStartCount>>
			<<unset $clothes_choice>>
			<<set $shopPage = 0>>

			<<if Time.dayState is "night">>
				당신은 홀로 어둠 속에 있다.
				<br><br>
			<<elseif $exposed gte 1>>
				당신은 존엄성을 지키기 위해 짐프 슈트 전시대 안에 숨어 있다.
				<br><br>
			<</if>>

			<span>보온성:</span>
			<<warmthscale>>
			<div id="warmth-description">
				<<warmth_description>>
			</div>
			<br><br>
			<<clothingcategoryicon "all">>
			<<link "전체 보기">><<replace "#clothingShop-div">><<AllShop>><</replace>><</link>>
			<br><br>
			<<if $debug is 1>>
				<<clothingcategoryicon "over-outfit">>
				<<link "겉옷 세트 보기">><<replace "#clothingShop-div">><<OverOutfitShop>><</replace>><</link>>
				<br>
				<<clothingcategoryicon "over-outfit">>
				<<link "겉옷 상의 보기">><<replace "#clothingShop-div">><<OverTopShop>><</replace>><</link>>
				<br><br>
			<</if>>
			<<clothingcategoryicon "outfit">>
			<<link "의상 보기">><<replace "#clothingShop-div">><<OutfitShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "upper">>
			<<link "상의 보기">><<replace "#clothingShop-div">><<TopShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "lower">>
			<<link "하의 보기">><<replace "#clothingShop-div">><<BottomShop>><</replace>><</link>>
			<br><br>
			<<clothingcategoryicon "under-outfit">>
			<<link "속옷 세트 보기">><<replace "#clothingShop-div">><<UnderOutfitShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "under-upper">>
			<<link "속옷 상의 보기">><<replace "#clothingShop-div">><<UnderTopShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "under-lower">>
			<<link "속옷 하의 보기">><<replace "#clothingShop-div">><<UnderBottomShop>><</replace>><</link>>
			/* Left here for future expansion */
			/*<br>
			<<clothingcategoryicon "genitals">>
			<<link "View Genital Wear">><<replace "#clothingShop-div">><<GenitalShop>><</replace>><</link>>*/
			<br><br>
			<<clothingcategoryicon "head">>
			<<link "머리 장신구 보기">><<replace "#clothingShop-div">><<HeadShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "face">>
			<<link "얼굴 장식 보기">><<replace "#clothingShop-div">><<FaceShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "neck">>
			<<link "목 장식 보기">><<replace "#clothingShop-div">><<NeckShop>><</replace>><</link>>
			<br>
			/*<<clothingcategoryicon "handheld">>
			<<link "View Handheld Items">><<replace "#clothingShop-div">><<HandheldShop>><</replace>><</link>>
			<br>*/
			<<clothingcategoryicon "hand">>
			<<link "장갑 보기">><<replace "#clothingShop-div">><<HandsShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "legs">>
			<<link "다리 장식 보기">><<replace "#clothingShop-div">><<LegsShop>><</replace>><</link>>
			<br>
			<<clothingcategoryicon "feet">>
			<<link "신발 보기">><<replace "#clothingShop-div">><<FeetShop>><</replace>><</link>>
			<br><br>
			<<run linkifyDivs('.button-back-to-shop')>>

			/*<<if $clothingrebuy is 1>>
				[[Disable automatic clothing rebuy|Rebuy Shop]]
				<br>
			<<else>>
				[[Enable automatic clothing rebuy|Rebuy Shop]]
				<br>
			<</if>>*/

			<<if Time.dayState is "night" and Time.hour isnot $closinghour and !$weekly.theft.adultShop>>
				<<shopicon "register">><<link [[계산대를 조사한다|Adult Shop Register]]>><</link>>
				<br>
			<</if>>

			<br>

			<<if Time.dayState is "night" or $adultshopstate is "closed" or $tryOn.value is 0>>
				<<if Time.dayState is "night" and $adultShop.spotted is true and $adultShop.stolenClothes gt 0>>
					<<getouticon>><<link [[떠난다|Adult Shop Night Guard Found]]>>
						<<shopClothingFilterReset>>
						<<ShowUnderEquip "normal">>
						<<ShowUnderEquip "over">>
						<<set $tryOn.autoReset to true>>
						<<crimeUp `$tryOn.value / 100` "thievery">>
						<<set $adultshopstate to "closed">>
						<<shopCommandoCheck>>
					<</link>>
				<<else>>
					<<getouticon>><<link [[떠난다|Adult Shop]]>>
						<<shopClothingFilterReset>>
						<<ShowUnderEquip "normal">>
						<<ShowUnderEquip "over">>
						<<set $tryOn.autoReset to true>>
						<<crimeUp `$tryOn.value / 100` "thievery">>
						<<set $adultshopstate to "closed">>
						<<shopCommandoCheck>>
					<</link>>
				<</if>>
				<<if $tryOn.value gt 0>>
					<<crime "thievery">>
				<</if>>
				<br><br>
			<<elseif $tryOn.value isnot 0>>
				<<icon "hanger.png">><<link "옷을 반납한다">><<clothingReset>>
					<<updatesidebarimg>>
					<<updatesidebardescription>>
					<<updateallure>>
					<<updatewarmthscale>>
					<<updatewarmthdescription>>
					<<updateclothingshop>>
					<<run updateMoment()>>
				<</link>>
				<br>
				<<if $tryOn.value gt 0 and $tryOn.value lte $money>>
					<<sendItemsToDropdown>>
					<<highicon>><<link "옷을 구매한다">><<buyTryOnClothes "wear">><<updatesidebarmoney>><<updateclothingshop>><</link>>
					<br>
					<<wardrobeicon>><<link "옷을 구매하여 옷장으로 보낸다">>
						<<buyTryOnClothes "wardrobe">>
						<<updatesidebarmoney>>
						<<updatesidebarimg>>
						<<updatesidebardescription>>
						<<updateallure>>
						<<updatewarmthscale>>
						<<updatewarmthdescription>>
						<<updateclothingshop>>
						<<run updateMoment()>>
					<</link>>
					<br>
				<</if>>
				<<if $tryOn.value gt 0>>
					<<if Object.values(V.tryOn.tryingOn).some(slot => slot?.type.includes("heavy"))>>
						<span class="red">당신이 입어본 옷들은 훔치기에는 너무 무겁다!</span>
					<<else>>
						<<getouticon>><<link [[훔친 옷을 입고 떠난다|Stolen Adult Shop Result]]>><<shopClothingFilterReset>><<shopCommandoCheck>><</link>>
					<</if>>
					<br>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

:: Stolen Adult Shop Result
<<effects>>
<<ShowUnderEquip "over">>
<<ShowUnderEquip "normal">>
<<if currentSkillValue('skulduggery') lt 90>>
	시리스는 곁눈질로 입구를 지켜보고 있다. 다른 출구는 없으므로, 당신은 모든 것을 제자리에 돌려놓고 떠난다.
	<<clothingReset>>
<<else>>
	<<rng>>
	<<if crimeSumCurrent("thievery","petty") gte 50000 or (crimeSumCurrent("thievery","petty") gte 40000 and $rng * 20 gte currentSkillValue('skulduggery')) or (crimeSumCurrent("thievery","petty") gte 25000 and $rng * 10 gte currentSkillValue('skulduggery'))
	or (crimeSumCurrent("thievery","petty") gte 10000 and $rng * 5 gte currentSkillValue('skulduggery'))>>
		<<generate1>><<person1>>
		시리스는 곁눈질로 입구를 지켜보고 있다가, 당신이 슬쩍 지나가려 하자 <<he>>【이가】 당신을 멈춰 세운다.
		<br><br>
		"그래. 내가 널 계속 지켜보고 있었어." <<he>>【이가】 말을 잇는다. "이번에는 그냥 보내주겠지만, 당분간 이 건물 출입을 금지할 거야. 이걸로 물건을 훔치면 안 되는 이유를 배우길 바라."
		<<if $adultShop.banCount lt 4>>
			<<set $adultShop.ban to 7>>
		<<elseif $adultShop.banCount lt 8>>
			<<set $adultShop.ban to 10>>
		<<else>>
			<<set $adultShop.ban to 14>>
		<</if>>
		<<crime "thievery">>
		<<set $adultShop.banCount++>>
	<<else>>
		시리스는 곁눈질로 입구를 지켜보고 있지만, 당신은 의심을 사지 않고 떠난다.
		<<crime "thievery">>
	<</if>>
	<<set _crime to ($tryOn.value / 100)>>
	<<crimeUp _crime "thievery">>
<</if>>
<br><br>
<<link [[다음|Elk Street]]>><<set $tryOn.autoReset to true>><<adultShopClear>><</link>>

:: Adult Shop Guard
<<effects>>
<<generate1>><<person1>>
시리스는 곁눈질로 입구를 지켜보다가 당신을 발견한다. <<He>>【은는】 보이지 않는 누군가에게 몇 마디 하더니, 당신에게 다가온다.
<br><br>
"미안하지만, 지나갈 수 없어." <<he>>【이가】 말한다. "아직 <<if $adultShop.ban gt 1>><<number $adultShop.ban>>일 남았어<<else>>하루 더 남았어<</if>>
출입 금지가 풀릴 때까지."
<br><br>

<<link [[다음|Elk Street]]>><<adultShopClear>><</link>>

:: Adult Shop Sneak Guard
<<effects>>
입구 바로 옆에 있는 시리스를 발견한다. 몰래 지나갈 수는 없을 것 같다.
<br><br>

<<link [[다음|Elk Street]]>><<adultShopClear>><</link>>

:: Adult Shop Night Guard Found
<<effects>>
<<generate1>><<person1>>
<<set $adultShop.banCount++>>
<<set $adultShop.spotted to false>>
최대한 조용히 가게 문을 닫고 돌아서자, 당신은 한 <<person>>【와과】 얼굴을 마주하고 충격에 빠진다. <<He>>【은는】 당신이 도망갈 생각조차 하기 전에 어깨에 손을 얹는다.
<br><br>
"이게 누구야? 육변기 몇 개 훔쳐 달아나려는 작은 쥐새끼 도둑인가?" <<he>>【이가】 못마땅한 표정으로 말한다. "이 상황을 주인들에게 알리도록 하지."
<br><br>
<<He>>【은는】 <<his>> 휴대폰을 꺼내 시리스에게 전화하는 것 같다.
<<if $adultShop.ban gt 0>>
	<<set $adultShop.banExtension to true>>
	<<set $adultShop.ban += 7>>
	"아하! 이미 출입 금지 상태였군." <<he>>【이가】 말을 잇는다. "그들은 꽤 엄격한 출입 금지 정책을 가지고 있어서, 여기서 쇼핑하려면 한참 걸릴 거야."
<<else>>
	<<if $adultShop.banCount lt 4>>
		<<set $adultShop.ban to 7>>
	<<elseif $adultShop.banCount lt 8>>
		<<set $adultShop.ban to 10>>
	<<else>>
		<<set $adultShop.ban to 14>>
	<</if>>
	"이걸로 됐군." <<he>>【이가】 말을 잇는다. "자. 넌 한동안 이 건물에 들어오지 못할 거야. 이걸로 교훈을 얻길 바라."
<</if>>
<br><br>
"이제 날 따라와, 여기서부터 호송하겠다. 널 곧장 형틀로 끌고 가지 않는 걸 다행으로 알아라."
<<tryOnReset>><<set $tryOn.autoReset to true>>
<br><br>
<<link [[도망친다|Adult Shop Night Guard Found Run]]>><</link>><<athleticsdifficulty 500>>
<br>
<<link [[경비원을 따라간다|Adult Shop Night Guard Found Follow]]>><</link>>

:: Adult Shop Night Guard Found Run
<<effects>>
당신은 도망쳐 숨기로 결심한다.
<<if $athleticsSuccess>>
	그 <<person>>【이가】 당신을 완전히 붙잡으려 하지만, 당신은 <<him>>【을를】 간신히 피해서 도망친다. 멀리서 <<he>>【이가】 소리치는 가운데 당신은 골목길을 달려간다.
	<br><br>
	<<link [[도망친다|Elk Street]]>><<adultShopClear>><</link>>
<<else>>
	하지만, 그 <<person>>【을를】 지나치기 전에, <<he>>【이가】 당신을 세게 잡아당겨 엉덩방아를 찧게 만든다.
	<br><br>
	"나한테서 도망치려 한 걸 후회하게 될 거다." <<he>>【이가】 <<his>> 얼굴에 미소를 띠고 말한다. "여긴 카메라가 없거든."
	<br><br>
	<<link [[다음|Adult Shop Night Guard Molestation]]>><<set $molestationstart to 1>><</link>>
<</if>>

:: Adult Shop Night Guard Found Follow
<<effects>>
<<He>>【은는】 당신을 출구 쪽으로 안내한다.
<<if random(0,100) gte 50>>
	"그거 알아?" <<he>>【이가】 묻는다. "이곳엔 카메라가 없어."
	<br><br>
	당신이 걱정스러운 표정으로 <<him>>【을를】 쳐다보자마자 <<he>>【이가】 당신을 붙잡는다.
	<br><br>
	<<link [[다음|Adult Shop Night Guard Molestation]]>><<set $molestationstart to 1>><</link>>
<<else>>
	당신은 말없이 거리를 걷고, 엘크 가 모퉁이에 다다르자 그 <<person>>【이가】 당신을 향해 돌아선다.
	<br><br>
	"이게 너에게 좋은 교훈이 되길 바란다." <<He>>【은는】 미소 짓는다. "더 정직한 방법으로 돈을 벌도록 해. 그게 모두에게 덜 골치 아픈 길이야."
	<br><br>
	당신이 떠날 때 <<He>>【은는】 당신에게 가운뎃손가락을 들어 보인다.
	<br><br>
	<<link [[떠난다|Elk Street]]>><<adultShopClear>><</link>>
<</if>>

:: Adult Shop Night Guard Molestation
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<maninit>>
	<<set $enemytrust -= 40>>
	<<set $enemyanger += 40>>
	<<set $NPCList[0].lefthand to "arms">>
	<<set $leftarm to "grappled">>
	<<set $rightarm to "grappled">>
<</if>>

<<effects>>
<<effectsman>>
<<man>>
<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend>>
	<span id="next"><<link [[다음|Adult Shop Night Guard Molestation Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Adult Shop Night Guard Molestation]]>><</link>></span><<nexttext>>
<</if>>

:: Adult Shop Night Guard Molestation Finish
<<if $enemyhealth lte 0>>
	당신은 <<him>>【을를】 충분히 다치게 해서 도망칠 수 있었다. <<tearful>> 당신은 가게에서 도망친다.
	<<clotheson>>
	<<endcombat>>
	<<link [[탈출한다|Elk Street]]>><<adultShopClear>><</link>>
<<elseif $enemyarousal gte $enemyarousalmax>>
	<<ejaculation>>
	"음, 재미있었어." <<he>>【이가】 말한다. "하지만 이제 네가 떠날 시간인 것 같군."
	<<clotheson>>
	<<endcombat>>
	<<link [[떠난다|Elk Street]]>><<adultShopClear>><</link>>
<</if>>

:: Adult Shop Register

<<set $outside to 0>><<effects>><<set $lock to 250>>
평범한 금전 등록기가 카운터 위에 놓여 있다. 단단히 잠겨 있다.
<br><br>
<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		자물쇠를 딸 수 있을 것 같지만, <span class="blue">팔이 묶여 있지 않다면 말이다.</span>
		<br><br>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span>
		<br><br>
		<<lockicon "pick">><<link [[자물쇠를 딴다 (0:10)|Adult Shop Register Sneak]]>><<pass 10>><<crimeUp 1 "thievery">><</link>><<crime "thievery">>
		<br>
	<</if>>
<<else>>
	<span class="red">자물쇠는 당신의 실력으로 딸 수 없을 것 같다.</span><<skulduggeryrequired>>
	<br><br>
<</if>>
<<getouticon>><<link [[떠난다|Adult Shop]]>><</link>>
<br>

:: Adult Shop Register Sneak
<<set $outside to 0>><<effects>><<set $lock to 200>>
<<set $weekly.theft.adultShop to true>>
<<set $tip to random(4000, 10000)>>
당신은 능숙하게 금전 등록기를 열고 안의 돈을 센다.
<<printmoney $tip>>【이가】 있다.
<br><br>

<<skulduggeryuse 300 "locks">>

<<if $rng gte 86>>
	<<skulshopevents>>
<<else>>
	<<link [[가져간다|Adult Shop]]>><<money $tip "tip">><<crimeUp `$tip / 100` "thievery">><</link>><<crime "thievery">>
	<br>
	<<link [[그대로 둔다|Adult Shop]]>><</link>>
	<br>
<</if>>
