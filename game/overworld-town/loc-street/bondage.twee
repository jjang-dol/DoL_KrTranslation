	<<ltrauma>><<lllstress>><<trauma -6>><<stress -24>>
	<br><br>
	<<endevent>>
	<<destinationeventend>>
<<else>>

	<<if dangerEvent() and $eventskip isnot 1 or $phase is 1>><<set $phase to 0>>
		<<eventsbondagenorth>>
	<<else>>
		<<link [[기계 소리가 나는 쪽으로 달린다 (0:05)|Bondage Run]]>><<set $bus to "starfish">><<pass 5>><<stress 3>><</link>><<gstress>>
