:: Widgets Events Street [widget]
<<widget "eventsstreet">>
	<<rng>>

	/* Events that must bypass eventpool and any conditions */
	<<if $wraith.state and $eventforced and Time.isBloodMoon() and !_wraithEventSkipped>>
		<<wraithEventStreet>>
	<<elseif $kylarwatched is 1>>
		<<kylarwatched>>
	<<elseif $kylar_manor_secret is 2>>
		<<monstrance_accost>>
	<<elseif $averyseen isnot 1 and !$avery_injury and $exposed lte 0 and Time.dayState is "day" and C.npc.Avery.state isnot "dismissed" and Time.weekDay is 7 and ($scienceproject is "won" or $scienceproject is "done" or C.npc.Avery.init is 1) and !$averydate>>
		<<set $averyseen to 1>>
		<<streetavery>>
	<<elseif $photo_known is undefined and $exposed lte 0 and Time.dayState is "day" and fameTotal() gte 3000>>
		<<set $photo_known to 1>>
		<<street_niki>>
		<<set $nikiSeen.pushUnique("street")>>
	<<else>>
		/* Eventpool */
		<<cleareventpool>>

		<<if $exposed gte 1>>
			/* Exposure events */
			<<if $bus is "residential">>
				<<addevent "residentialex1" 1>>
				<<addevent "residentialex2" 1>>
				<<addevent "residentialex3" 1>>
			<<elseif $bus is "commercial">>
				<<addevent "commercialex1" 1>>
				<<addevent "commercialex2" 1>>
				<<addevent "commercialex3" 1>>
			<<elseif $bus is "industrial">>
				<<addevent "industrialex1" 1>>
				<<addevent "industrialex2" 1>>
				<<addevent "industrialex3" 1>>
			<<elseif $bus is "park">>
				<<addevent "parkex1" 1>>
				<<addevent "parkex2" 1>>
				<<addevent "parkex3" 1>>
			<<else>>
				<<if Time.dayState is "night">>
					<<addevent "streetex1" 2>>
					<<addevent "streetex2" 1>>
					<<addevent "streetex3" 1>>
					<<addevent "streetex4" 1>>
					<<addevent "streetex5" 1>>
				<<else>>
					<<addevent "streetexday1" 1>>
					<<addevent "streetexday2" 1>>
				<</if>>
			<</if>>
			/* Any alleyway */
			<<if $location is "alley">>
				<<addevent "streetcardboardbox" 1>>
			<</if>>

			/* Any location */
			<<outfitChecks>>
			<<if _topless>>
				<<addevent "streetchestgroper" 1>>
			<</if>>

			<<if !$weekly.bondagePhotographer and $fame.exhibitionism gte 400 and $exposed gte 2>>
				<<addevent "exposedBondagePhotographer" 1>>
			<</if>>
		<<else>>

			/* Events that can only happen if NOT exposed (unless they also exist above) */

			/* These two previously existed in both eventsstreetday and eventsstreetnight, with an RNG override */
			<<if $location is "alley" and !Time.schoolDay and $bullytimer gte $rng and C.npc.Whitney.init is 1 and !["dungeon", "pillory"].includes(C.npc.Whitney.state) and $daily.whitney.park is undefined>>
				<<addinlineevent "whitneyStreet" 5>>
					<<set $bullytimer to 0>>
					<<eventsWhitneyStreet>>
				<</addinlineevent>>
			<</if>>

			<<if $kylarReunionScene isnot undefined and C.npc.Kylar.state is "active" and Time.dayState is "day">>
				<<addinlineevent "kylarReunion" 5>>
					<<kylarReunionScene>>
				<</addinlineevent>>
			<</if>>

			<<if $farm_stage gte 2 and Time.hour gte 6 and Time.hour lte 20>>
				<<addevent "streetAlex1">>
			<</if>>

			/* Same probability regardless of time of day */
			<<addevent "streetCatcall" 1.2>>
			<<addevent "streetSoloStalk" 1>>
			<<addevent "streetMoneyProposition" 1>>
			<<addevent "streetClothingTorn" 0.5>>
			<<addevent "streetFlirt" 1>>
			<<addevent "streetBreastGlance" 1>>
			<<addevent "streetWaterBalloon" 0.5>>

			<<addevent "streetbottomgrope" 1>>
			<<addevent "streetexshow" 0.5>>
			<<addevent "streetfamerape" 1>>
			<<addevent "streetmodelshow" 0.5>>
			<<addevent "streetnpcflash" 0.5>>
			<<addevent "streetrocks" 0.5>>
			<<addevent "streetvan" 1>>

			<<if $bus is "elk">>
				<<addevent "elkBreeze" 1>>
			<</if>>
			<<if $bus is "high">>
				<<addevent "highShoplift" 1>>
			<</if>>

			<<addinlineevent "ambient" 1>>
				<<eventAmbient>>
				<<destinationeventend>>
			<</addinlineevent>>

			<<if Time.dayState is "night">>
				/* Events previously in eventsstreetnight */
				<<addevent "streetGroupStalk" 1>> /* Group stalking encounter, much more likely at night */
				<<addevent "streetProstitutionProposition" 0.5>>
				<<addevent "streetbox" 1>>
				<<addevent "streetlurker" 0.2>>
				<<addevent "streetkidnap" 0.5>>
				<<if $stray_happiness gte random(1, 100)>>
					<<addevent "streetFollowDogAlley" 1>>
				<<else>>
					<<addevent "streetNightDogAttack" 0.5>>
				<</if>>
				<<if !$daily.streetNightMonster>>
					<<if $beauty gte ($beautymax / 7) * 4>>
						<<addevent "streetNightMonster" 0.4>>
					<<elseif $beauty gte ($beautymax / 7) * 2>>
						<<addevent "streetNightMonster" 0.2>>
					<</if>>
				<</if>>
			<<else>>
				/* Events previously in eventsstreetday */
				<<addevent "streetGroupStalk" 0.1>>
				<<addevent "streetProstitutionProposition" 1>>
				<<addevent "streetbox" 0.5>>
				<<addevent "streetbullies" 1>>
				<<addevent "streetdog" 1>>
				<<addevent "streetFollowDogAlley" 1>>
				<<addevent "streetfriendly1" 1>>
				<<addevent "streetstray" 1>>
				<<addevent "shadyFan" 0.6>>
				<<addevent "streetSeduction" 1>>

				<<bodywritingExposureCheck true>>
				<<if _bodywriting_exposed is 1>>
					<<addevent "streetbodywriting" 1>>
					<<if $skin[_bodypart].special is "prostitution">>
						<<addevent "streetwhorebodywriting" 1>>
					<</if>>
					<<if $skin[_bodypart].special is "criminal">>
						<<addevent "streetcriminalbodywriting" 1>>
					<</if>>
				<</if>>

				<<if $bus is "domus" or $bus is "danube">>
					<<addevent "streetorphancookie" 1>>
				<</if>>

				<<if $settings.condomLevel gte 1 and ["wolf", "nightingale", "cliff", "starfish", "high"].includes($bus) and Time.days gte 4>>
					<<addevent "streetabstinence" 1>>
				<</if>>

				<<if $location isnot "alley" and $bus isnot "park">>
					<<addevent "streetfootbridge" 1>>
					<<addevent "streetcrossing" 1>>
					<<addevent "street_alley_detour" 0.5>>
				<</if>>

				<<if ($bus is "domus" or $bus is "danube") and Weather.precipitation is "rain" and ($upperwetstage is 1 or $lowerwetstage is 1)>>
					<<addevent "rainyDayHarass" 0.6>>
				<</if>>

				<<if $bus is "high" and !Time.schoolDay and $bullytimer gte $rng and C.npc.Whitney.init is 1 and !["dungeon", "pillory"].includes(C.npc.Whitney.state) and C.npc.Whitney.dom gte 10>>
					<<addinlineevent "whitneyHigh" 3>>
						<<set $bullytimer to 0>>
						<<if random(1, 100) gte 51 and ($whitneyromance is 1 or ($whitneyskirtcheck gte 1 and $settings.forcedCrossdressingEnabled and C.npc.Whitney.dom gte 18)) and !$daily.whitney.shoppingCentre and !($weekly.whitneyShoppingCentre gte 2)>>
							<<whitneyShoppingCentre>>
						<<else>>
							<<pantsdownscene>>
						<</if>>
					<</addinlineevent>>
				<</if>>

				<<if getTransformParts(["ears", "wings", "tail"])>>
					<<addevent "streettfpicture" 1>>
				<</if>>

				<<if $hairlength gte 1000>>
					<<addevent "streetlonghair" .7>>
				<</if>>

				<<if $photo_high_caught is 1>>
					<<addevent "streetPhotoHighCaught" 2>>
				<</if>>
			<</if>>
			/* end time differences */

			<<if $worn.feet.type.includes("heels") and currentSkillValue("feetskill") lt $worn.feet.reveal>>
				<<addevent "streetheeltrip" 2>>
			<</if>>

			<<if $exhibitionismrun is undefined and !$challengetimer>>
				<<if !$exhibitionismrunon and Time.days gte 8>>
					<<addevent "streetexoffer" 0.9>>
				<<elseif $exhibitionismrunon is 1>>
					<<addevent "streetexoffer2" 0.9>>
				<<elseif $exhibitionismrunon is 2>>
					<<addevent "streetexoffer3" 0.9>>
				<<elseif $exhibitionismrunon is 3>>
					<<addevent "streetexoffer4" 0.9>>
				<</if>>
			<</if>>

			<<if $hallucinations gte 2 and $settings.tentaclesEnabled>>
				<<addevent "streettentacle" 0.9>>
			<</if>>

			<<if $fame.sex gte random(1, 1000)>>
				<<addevent "streetsexfame" 0.9>>
			<</if>>
			<<if $fame.prostitution gte random(1, 1000)>>
				<<addevent "streetprostitutionfame" 0.9>>
			<</if>>
			<<if $fame.rape gte random(1, 1000)>>
				<<addevent "streetrapefame" 0.9>>
			<</if>>
			<<if $fame.bestiality gte random(1, 1000)>>
				<<addevent "streetbestialityfame" 0.9>>
			<</if>>
			<<if $fame.pregnancy gte random(1, 1000)>>
				<<addevent "streetpregnancyfame" 0.9>>
			<</if>>
			<<if $fame.exhibitionism gte random(1, 1000)>>
				<<addevent "streetexhibitionismfame" 0.9>>
			<</if>>

			<<if C.npc.Whitney.state is "dungeon" and $whitneyposter isnot 1>>
				<<addevent "whitneyposter" 0.9>>
			<</if>>

			<<if (edenFreedomStatus() gte 2 or ($edenescape and Time.dayState is "night")) and ($edenragerespite lte 0 || $edenragerespite is undefined)>>
				<<addevent "streetedenrage" 0.9>>
			<<elseif edenFreedomStatus() gte 1 and !$edenCagedEscape>>
				<<if $edenfreedom gte 2 and C.npc.Eden.love gte 60>>
					<<addevent "streetedenworried" 0.9>>
				<<else>>
					<<addevent "streetedenangry" 0.9>>
				<</if>>
			<</if>>

			<<if !$weekly.streetPolice and crimeSumCurrent() gte 1000 and !$worn.lower.type.includes("naked")>>
				<<addevent "streetpolice" 2>>
			<</if>>

			<<if $worn.neck.collared is 1>>
				<<addevent "streetcollared" 1>>
			<</if>>

			<<if pcAreArmsBound("any")>>
				<<addevent "streetbound" 1>>
			<</if>>

			<<if $worn.lower.name is "towel" or $worn.lower.name is "large towel bottom">>
				<<addevent "streetlowertowel" 1>>
			<</if>>

			<<if $worn.upper.name is "towel" or $worn.upper.name is "large towel">>
				<<addevent "streetuppertowel" 1>>
			<</if>>

			<<if crimeSumCurrent() gte 5000>>
				<<addevent "streetwanted" 1>>
			<</if>>

			<<if $location is "alley">>
				<<addevent "streetcardboardbox" 1>>
			<</if>>

			<<outfitChecks>>
			<<if _topless>>
				<<addevent "streetchestgroper" 1>>
			<</if>>

			<<if $bus is "starfish" and (Time.hour gte 18 or Time.hour lt 1) and !$daily.starfishperformer>>
				<<addevent "starfishperformer" 1.2>>
			<</if>>
		<</if>>

		<<runeventpool>>
	<</if>>

	<<if $eventforced>>
		<<unset $eventforced>>
	<</if>>
<</widget>>

<<widget "pantsdownscene">>
	<<npc Whitney>><<person1>>
	<<outfitChecks>>
	<<if pcAreArmsBound("both")>>
		"너냐, 걸레년?" 당신이 뒤를 돌아보니 휘트니가 인도를 거닐며 당신을 향해 걸어오고 있다. "너일 줄 알았지! 왜 그렇게 묶여 있어?"
		<br><br>
		<<He>>【이가】 당신의 몸을 돌려 당신의 묶인 손목을 확인한다. 몇 초간 침묵하던 <<he>>【이가】 입을 연다. "해보고 싶은 게 생겼어. 가만히 있어."
		<br><br>
		그게 무슨 뜻인지 미처 생각하기도 전에, 당신은 <<his>> 손가락이 당신의 <<bottoms>> 허리춤에 닿는 것을 느낀다.
		<br><br>
	<<else>>
		갑자기 휘트니의 목소리가 들린다. "야 걸레! 거기 가만히 있어!"
		<br><br>
		당신이 뒤를 돌아보니 눈에 짓궂은 장난기가 가득한 휘트니가 다가오고 있다. 당신은 <<he>>【이가】 무슨 짓을 꾸몄든 견디기로 마음먹는다. "움직이지 마, 해보고 싶은 게 생겼으니까."
		<br><br>
		<<He>>【이가】 당신의 <<bottoms>> <<= _skirtExposed ? "밑단" : "허리춤">>【으로로】 손을 뻗는다.
		<br><br>
	<</if>>
	<<link [[가만히 있는다|High Public Pants Down Still]]>><<trauma 6>><<stress 6>><<sub 1>><<npcincr Whitney dom 1>><</link>><<gstress>><<gtrauma>><<gdom>>
	<br>
	<<if pcAreArmsBound("both")>>
		<span class="blue">팔이 묶여 있어 <<him>>【을를】 막을 수 있는 게 아무것도 없다!</span>
		<br>
	<<else>>
		<<link [[휘트니의 손을 쳐낸다|High Public Pants Down Push]]>><<set $fightstart to 1>><<def 1>><<npcincr Whitney dom -1>><</link>><<ldom>>
		<br>
	<</if>>
<</widget>>

<<widget "whitneyShoppingCentre">>
	<<npc Whitney>><<person1>>
	갑자기 휘트니의 목소리가 들린다. "어이 걸레년! 거기 가만히 있어!"
	<br><br>
	뒤를 돌아보자 장난기 가득한 눈빛의 휘트니가 다가오는 것이 보인다. 당신은 <<he>>【이가】 무슨 수작을 부리려는지 마음의 준비를 한다. "따라와."
	<br><br>
	<<He>>【은는】 당신의 손을 향해 <<his>> 손을 뻗는다.
	<br><br>
	<<link [[가만히 있는다|Whitney Shopping Centre]]>><<trauma 6>><<stress 6>><<sub 1>><<npcincr Whitney dom 1>><<set $phase to 0>><</link>><<gstress>><<gtrauma>><<gdom>><<handholdingvirginitywarning>>
	<br>
	<<link [[물러선다|Whitney Shopping Centre Refuse]]>><<def 1>><<npcincr Whitney dom -1>><<set $phase to 0>><</link>><<ldom>>
<</widget>>

<<widget "whitneyShoppingData">>
    <<set _chosenCommentSchool to "학교에 입고 가면 딱이겠네. 마음에 들었으면 좋겠어.">>
    <<set _rejectedCommentSchool to "왜, 마음에 안 들어? 학교에 입고 가기 딱인데 말이야.">>
    <<set _chosenCommentSwimClass to "수영 시간에 입고 놀기 딱이겠어. 마음에 들었으면 좋겠네.">>
    <<set _rejectedCommentSwimClass to "왜, 마음에 안 들어? 수영 시간에 입고 가기 딱인데 말이야.">>

    <<set _chosenCommentOutside to "학교 밖에서도 그거 입고 돌아다니는 거 볼 수 있었으면 좋겠네.">>

    <<set _chosenCommentBeach to "해변에서 입고 놀기 딱이겠어. 마음에 들었으면 좋겠네.">>
    <<set _rejectedCommentBeach to "왜, 마음에 안 들어? 해변에 입고 가기 딱인데 말이야.">>
    <<set _extraCommentBeach to "해변에서 구르는 너 같은 걸레한테 딱이지.">>

    <<set _rejectedCommentBed to "침대에서 입고 자면 딱이겠어. 마음에 들었으면 좋겠네.">>
    <<set _extraCommentBed to "잠옷으로 입기 딱이겠네.">>

    <<set _rejectedCommentLewd to "마음에 안 들어? 네가 입기엔 너무 음란했나봐?">>
    <<set _extraCommentLewd to "너 같은 걸레한테 딱이네.">>

	<<set _rejectedCommentGeneric to "무슨 문제라도 있어?">>

	<<if $whitneyClothesGender is "f">>
		<<set $_set1 to ["pink", "purple", "tangerine", "yellow", "red"]>>
		<<set $_colour1 to $_set1.random()>>
		<<set $_colour2 to ["light pink", "lilac", "brown", "tan", "black"][$_set1.indexOf($_colour1)]>>
		<<set $_colour3 to ["light pink", "lilac", "red", "lilac", "black"][$_set1.indexOf($_colour1)]>>
		<<set $_denim to ["denim", "light blue", "black", "blue steel", "grey"].random()>>
		<<set $_headPieceOptions to [5, 16, 46, 55]>>
		<<if ["autumn", "winter"].includes(Time.season)>>
			<<run $_headPieceOptions.pushUnique(50)>>
		<<else>>
			<<run $_headPieceOptions.pushUnique(18)>>
		<</if>>
		<<set $_headPiece to [$_headPieceOptions.random(), $_colour1]>>
		<<if $_headPiece[0] is 18>><<run $_headPiece.push($_colour2)>><</if>>
		<<if $_headPiece[0] is 50>><<run $_headPiece.push($_colour3)>><</if>>
		<<set _whitneyClothingChoices to [
			{index: 0, items:{
				head: $_headPiece,
				upper: [113, "white"],
				lower: [106, $_colour1, $_colour1],
				legs: [3],
				feet: [[33, 34].random(), $_colour2, "silver"],
				handheld: [[5, 6].random(), $_colour3, "silver"],
			}, chosenComment: _chosenCommentSchool, rejectedComment: _rejectedCommentSchool, schoolItems: true},
			{index: 1, items:{
				head: $_headPiece,
				upper: [112, $_colour1, "white"],
				lower: [27, "black"],
				legs: [3],
				feet: [[33, 34].random(), $_colour2, "silver"],
				handheld: [[5, 6].random(), $_colour3, "silver"],
			}, chosenComment: _chosenCommentSchool, rejectedComment: _rejectedCommentSchool, schoolItems: true},
			{index: 2,items:{
				head: $_headPiece,
				upper: [5, "white", $_colour1],
				lower: [56, $_colour1],
				legs: [3],
				feet: [[33, 34].random(), $_colour2, "silver"],
				handheld: [[5, 6].random(), $_colour3, "silver"],
			}, chosenComment: _chosenCommentSchool, rejectedComment: _rejectedCommentSchool, schoolItems: true},
			{index: 3, items:{under_upper: [[2, 6].random(), $_colour1]},
				chosenComment: _chosenCommentSwimClass, rejectedComment: _rejectedCommentSwimClass, swimItems: true},
			{index: 4, items:{under_upper: [24, $_colour1], under_lower: [31, $_colour1]},
				chosenComment: _chosenCommentSwimClass, rejectedComment: _rejectedCommentSwimClass, swimItems: true},
			{index: 5, items:{upper: [109]}, exposed: true,
				chosenComment: _rejectedCommentBed, rejectedComment: _rejectedCommentLewd, extraComment: _extraCommentBed, sleepItems: true},
			{index: 6, items:{upper: [[17, 18].random(), $_colour1]}, exposed: true,
				chosenComment: _rejectedCommentBed, rejectedComment: _rejectedCommentLewd, extraComment: _extraCommentBed, sleepItems: true},
			{index: 7, items:{upper: [21, $_colour1], lower: [76, $_denim], legs: [[1, 4].random()], feet: [[10, 12].random(), $_colour1]}, normalItems: true,
				chosenComment: _chosenCommentOutside, rejectedComment: _rejectedCommentLewd, extraComment: _extraCommentLewd},
			{index: 8, items:{upper: [21, $_colour1], lower: [25, $_colour1], legs: [12, $_colour1, "white"], feet: [[10, 12].random(), $_colour1]}, normalItems: true,
				chosenComment: _chosenCommentOutside, rejectedComment: _rejectedCommentLewd, extraComment: _extraCommentLewd},
			{index: 9, items:{upper: [19, $_colour1], lower: [114, $_denim], legs: [[1, 4].random()], feet: [[10, 12].random(), $_colour1]}, normalItems: true,
				chosenComment: _chosenCommentOutside, rejectedComment: _rejectedCommentLewd, extraComment: _extraCommentLewd},
			{index: 10, items:{upper: [29], legs: [27, "white"], feet: [[10, 12].random(), "purple"]}, normalItems: true,
				chosenComment: _chosenCommentOutside, rejectedComment: _rejectedCommentLewd, extraComment: _extraCommentLewd},
			{index: 11, items:{under_upper: [[1, 35].random(), $_colour1], under_lower: [[18, 41].random(), $_colour1]},
				chosenComment: _chosenCommentBeach, rejectedComment: _rejectedCommentBeach, extraComment: _extraCommentBeach},
		]>>
	<<else>>
		/* Picking out males clothes is a pain */
		<<set $_set1 to ["blue", "red", "green", "teal"]>>
		<<set $_colour1 to $_set1.random()>>
		<<set $_colour2 to ["cyan", "black", "white", "blue"][$_set1.indexOf($_colour1)]>>
		<<set $_blackOrWhite to ["black", "white"].random()>>
		<<set $_leather to ["black", "brown", "blue steel", "tan", "olive", "wine"].random()>>
		<<set $_metal to ["grey", "steel", "blue steel", "bronze", "gold", "rose gold", "silver"].random()>>
		<<set _whitneyClothingChoices to [
			{index: 0, items:{
				head: [2, $_colour1],
				upper: [62, $_colour1],
				lower: [[28, 104].random(), $_colour1],
				legs: [2],
				feet: [1],
				handheld: [[7, 8].random(), $_colour2],
				},
			chosenComment: _chosenCommentSchool, rejectedComment: _rejectedCommentSchool},
			{index: 1, items:{
				face: [15, $_metal],
				upper: [149, ["white", "brown", "navy blue", "tan"].random()],
				lower: [[6, 60, 105].random(), "black"],
				legs: [2],
				feet: [1],
				handheld: [[7, 8].random(), $_colour2],
				},
			chosenComment: _chosenCommentSchool, rejectedComment: _rejectedCommentSchool},
			{index: 2, items:{under_upper: [21, $_colour1], under_lower: [7, $_colour1]},
				chosenComment: _chosenCommentSwimClass, rejectedComment: _rejectedCommentSwimClass},
			{index: 3, items:{under_lower: [7, $_colour1]}, breastExposed: true,
				chosenComment: _chosenCommentSwimClass, rejectedComment: _rejectedCommentSwimClass},
			{index: 4, items:{upper: [119, "black", $_colour1], lower: [137, ["black", "navy", "olive", "brown"].random()], feet: [30, $_colour1]},
				chosenComment: _chosenCommentOutside, rejectedComment: _rejectedCommentGeneric},
			{index: 5, items:{upper: [8, $_blackOrWhite, $_colour1], lower: [[127, 132].random(), $_colour1], legs: [[20, 27].random(), $_blackOrWhite, $_colour1], feet: [6, $_blackOrWhite, $_colour1]},
				chosenComment: _chosenCommentOutside, rejectedComment: _rejectedCommentGeneric},
			{index: 6, items:{upper: [[40, 41].random(), $_leather, $_metal], lower: [23, $_blackOrWhite], feet: [21]}, breastExposed: true,
				chosenComment: _chosenCommentOutside, rejectedComment: _rejectedCommentGeneric},
			{index: 7, items:{under_lower: [19, $_colour1]}, breastExposed: true,
				chosenComment: _chosenCommentBeach, rejectedComment: _rejectedCommentBeach, extraComment: _extraCommentBeach},
		]>>
	<</if>>
<</widget>>

<<widget "whitneyShoppingPicker">>
	/* When still picking out items */
	<<if $whitneyClothingChoice is undefined>><<set $whitneyClothingChoice to []>><</if>>
	<<set _whitneyChoice to _whitneyClothingChoices.filter(choice => !$whitneyClothingChoice.includes(choice.index) and !($player.breastsize gte 3 and choice.breastExposed)).random()>>
	<<run $whitneyClothingChoice.push(_whitneyChoice.index)>>
	<<headruined true>>
	<<faceruined true>>
	<<upperruined true>>
	<<lowerruined true>>
	<<underupperruined true>>
	<<underlowerruined true>>
	<<legsruined true>>
	<<feetruined true>>
	<<run Object.entries(_whitneyClothingChoices[$whitneyClothingChoice.last()].items).forEach(([slot, item]) => {
		wikifier("generalWear", slot, item[0], item[1] ? `"${item[1]}"` : undefined, item[2] ? `"${item[2]}"` : undefined);
	})>>
<</widget>>

<<widget "whitneyShoppingPickerChoice">>
	<<if !$whitneyClothingChoice>>
		<<exit>>
	<</if>>
	<<set $changeBack to $worn.upper.type.includes("naked") or $worn.lower.type.includes("naked") or _whitneyClothingChoices[$whitneyClothingChoice.last()].exposed>>
	<<if $changeBack>>
		<<undress "wardrobe">>
		<<storeon "whitneyShopping">>
	<<else>>
		/* Remember the colours used */
		<<set _itemColours to {}>>
		<<run Object.entries($worn).forEach(([slot, item]) => {
			if (item.index) {
				T.itemColours[slot] = {};
				if (item.colour) T.itemColours[slot].colour = item.colour;
				if (item.accessory_colour) T.itemColours[slot].accessory_colour = item.accessory_colour;
			}
		})>>
		<<headruined true>>
		<<faceruined true>>
		<<upperruined true>>
		<<lowerruined true>>
		<<underupperruined true>>
		<<underlowerruined true>>
		<<legsruined true>>
		<<legsruined true>>
		<<feetruined true>>
		<<storeon "whitneyShopping">>
		<<run Object.entries(_whitneyClothingChoices[$whitneyClothingChoice.last()].items).forEach(([slot, item]) => {
			let colour = T.itemColours[slot]?.colour || item[1];
			let accessory_colour = T.itemColours[slot]?.accessory_colour || item[2];
			wikifier("generalWear", slot, item[0], `"${colour}"`, `"${accessory_colour}"`);
		})>>
	<</if>>
<</widget>>

<<widget "street_alley_detour">>
	당신이 거리를 걷고 있는데, 저 앞 경찰차에서 뿜어져 나오는 익숙한 푸른 섬광이 보인다. 가까이 다가가자 교차로가 <span class="purple">부서진 차로 인해 막혀</span> 아직 치워지는 중이다. 횡단보도는 당분간 폐쇄되어 있다.
	<br><br>
	당신은 관계자들이 일을 마칠 때까지 여기서 기다릴 수도 있고, <<if $bus isnot "park" or $bus isnot "nightingale">>근처 골목으로<<else>>공원으로<</if>> 우회해서 갈 수도 있다.
	<br><br>

	<<if $bus is "domus" or $bus is "danube" or $bus is "barb" or $bus is "connudatus">>
		<<link [[우회한다|Residential Alleyways]]>><</link>>
	<<elseif $bus is "cliff" or $bus is "high" or $bus is "wolf">>
		<<link [[우회한다|Commercial Alleyways]]>><</link>>
	<<elseif $bus is "oxford" or $bus is "mer" or $bus is "elk" or $bus is "harvest">>
		<<link [[우회한다|Industrial Alleyways]]>><</link>>
	<<elseif $bus is "starfish" or $bus is "nightingale">>
		<<link [[우회한다|Park]]>><</link>>
	<</if>>
	<br>

	<<switch $bus>>
		<<case "nightingale">>
			<<link [[기다린다 (0:20)|Nightingale Street]]>><<pass 20>><</link>>
		<<case "domus">>
			<<link [[기다린다 (0:20)|Domus Street]]>><<pass 20>><</link>>
		<<case "elk">>
			<<link [[기다린다 (0:20)|Elk Street]]>><<pass 20>><</link>>
		<<case "high">>
			<<link [[기다린다 (0:20)|High Street]]>><<pass 20>><</link>>
		<<case "starfish">>
			<<link [[기다린다 (0:20)|Starfish Street]]>><<pass 20>><</link>>
		<<case "barb">>
			<<link [[기다린다 (0:20)|Barb Street]]>><<pass 20>><</link>>
		<<case "connudatus">>
			<<link [[기다린다 (0:20)|Connudatus Street]]>><<pass 20>><</link>>
		<<case "wolf">>
			<<link [[기다린다 (0:20)|Wolf Street]]>><<pass 20>><</link>>
		<<case "harvest">>
			<<link [[기다린다 (0:20)|Harvest Street]]>><<pass 20>><</link>>
		<<case "oxford">>
			<<link [[기다린다 (0:20)|Oxford Street]]>><<pass 20>><</link>>
		<<case "danube">>
			<<link [[기다린다 (0:20)|Danube Street]]>><<pass 20>><</link>>
		<<case "mer">>
			<<link [[기다린다 (0:20)|Mer Street]]>><<pass 20>><</link>>
		<<case "cliff">>
			<<link [[기다린다 (0:20)|Cliff Street]]>><<pass 20>><</link>>
		<<case "park">>
			<<link [[기다린다 (0:20)|Park]]>><<pass 20>><</link>>
	<</switch>>

<</widget>>

<<widget "streeteffects">>
	<<if !$possessed>>
		<<set _kylarLocation to getKylarLocation()>>
		<<if npcCanHunt("Ivory Wraith") and $wraith.state and $wraith.hunt is 0 and $wraith.timer gte (random(0, 60))>>
			<<wHunt "town">>
		<<elseif $wraith.hunt>>
			<<wHunt "town">>
		<<elseif $kylar and $kylar.timer.street gte ($rng + 65) and C.npc.Kylar.state is "active" and $kylarwatched isnot 1 and $exposed lte 0 and _kylarLocation.area isnot $location>>
			<<set $kylar.timer.street to 0>><<set $kylarwatchedtimer to 2>>
			원초적인 본능이 보내는 경고에, 당신은 몸을 떤다. <span class="blue">무언가 당신을 지켜보고 있다.</span>
			<<set $kylarwatched to 1>><<set $eventskip to 1>>
		<<elseif $kylarwatched is 1>>
			<<if $exposed gte 1 or C.npc.Kylar.state isnot "active" or $kylarwatchedtimer lte 0 or _kylarLocation.area is $location>>
				<<set $kylarwatched to 0>>
			<<else>>
				<span class="blue">무언가 당신을 지켜보고 있다.</span>
			<</if>>
		<</if>>
		<<wTimerProgress>>
	<</if>>
<</widget>>

<<widget "loiter">>
	<<add_link "<<loitericon>><<link [[서성거린다 (0:15)|$passage]]>><<pass 15>><</link>><br>">>
	<<hideDisplay>>
<</widget>>

<<widget "street_rescue">>
	<<generate1>><<person1>>
	<<person>>【이가】 당신 곁으로 다가온다.
	<<if $exposed gte 1>>
		<<covered>> <<He>>【은는】 눈을 피한다.
	<</if>>
	"비명 소리를 들었어," <<he>>【이가】 말한다. "괜찮니? 이 근처에 아는 사람이 있거나, 내가 널 데려다줄 만한 곳이 있니?" <<he>>【이가】 묻는다.
	<br><br>

	<<link [[괜찮다고 말한다|Street Rescue Fine]]>><</link>>
	<br>
	<<link [[고아원까지 태워달라고 부탁한다 (0:05)|Street Rescue Orphanage]]>><<pass 5>><</link>>
	<br>
	<<if $farm_stage gte 7>>
		<<link [[당신의 농장까지 태워달라고 부탁한다 (0:15)|Street Rescue Farm]]>><<pass 15>><</link>>
		<br>
	<</if>>
	<<if $trauma gte $traumamax * 0.8>>
		<<link [[주저앉아 오열한다 (1:00)|Street Rescue Break]]>><<pass 60>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "monstrance_accost">>
	<<if $per_npc.bishop>>
		<<loadNPC 0 "bishop">>
	<<else>>
		<<generateConfessor 1>>
		<<saveNPC 0 "bishop">>
	<</if>>
	<<person1>>
	<<if $temple_rank is undefined or $temple_rank is "prospective">>
		"얘야,"
	<<else>>
		"<<temple_Title "dark">>,"
	<</if>>
	어두운 골목에서 느릿한 목소리가 들려온다. 검은색 로브를 두른 형체인 <<he>>【이가】 빛을 향해 걸어 나온다. <<his>> 눈은 카울에 가려져 있다.
	<<if $temple_confessor_intro>>
		주교다. <<his>> 두 명의 동행인도 어둠 속에서 걸어 나온다.
	<<else>>
		"두려워하지 마십시오. 저는 신전에서 왔습니다." 과연 신전의 상징이 새겨진 펜던트가 <<his>> 목에 걸려 있다. 검은색 로브를 입은 두 명의 형체가 더 어둠 속에서 나타나 <<him>>【을를】 호위한다.
	<</if>>
	<br><br>

	"당신이 어떤 <span class="pink">성체 현시대</span>에 대해 문의했다 들었습니다. 저택에서 그것을 찾았지요. 말해보십시오, 그곳의 거주자들에 대해 어떻게 생각하십니까? 그들이 두렵지 않습니까?"<<gstress>><<stress 6>>
	<br><br>

	<<link [[그곳에 이상한 것은 없다고 말한다|Street Monstrance Nothing]]>><</link>>
	<br>
	<<link [[그곳에 괴물들이 있지만 신경 안 쓴다고 말한다|Street Monstrance Brave]]>><</link>>
	<br>
