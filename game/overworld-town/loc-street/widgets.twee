	<<if $harpy gte 6 and _tfParts.includes("wings") and _tfParts.includes("tail")>>
		<<set $phase2 to 0>>
		날개와 꼬리다.
	<<elseif _tfParts.includes("wings") and (random(1, 2) is 1 or _tfParts.filter(part => part !== "wings").length is 0)>>
		<<set $phase2 to 1>>
		날개다.
	<<elseif _tfParts.includes("ears") or _tfParts.includes("tail")>>
		<<set $phase2 to 2>>
		<<set _earsandtail to []>>
		<<if _tfParts.includes("ears")>>
			<<run _earsandtail.push("귀")>>
		<</if>>
		<<if _tfParts.includes("tail")>>
			<<run _earsandtail.push("꼬리")>>
		<</if>>
		<<print formatList(_earsandtail)>>다.
	<<else>> /* Fallback, just in case */
		인간이 아닌 특징이다.
	<</if>>
	<br><br>

	<<link [[포즈를 취한다 (0:05)|Street Transformation Picture]]>><<pass 5>><<set $phase to 0>><</link>>
	<br>
	<<link [[과시한다 (0:05)|Street Transformation Picture]]>><<pass 5>><<set $phase to 1>><</link>><<exhibitionist 1>>
	<br>
	<<link [[거절한다|Street Transformation Picture]]>><<set $phase to 2>><</link>>
<</widget>>

