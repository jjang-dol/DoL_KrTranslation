:: Mer Street

<<set $outside to 1>><<set $location to "town">><<effects>><<set $bus to "mer">><<getTarget true>>
당신은 메르 가에 있다. 이 거리는 부두와 해운 산업이 주를 이룬다.
<<if Time.dayState is "day">>
	<<if Weather.precipitation is "rain">>
		도로의 일부가 젖은 모래로 덮여 있다.
	<<elseif Weather.precipitation is "snow">>
		염분이 너무 많아 이곳에는 눈이 쌓이지 않는다.
	<<else>>
		부두에서 많은 소음이 들려온다.
	<</if>>
<<elseif Time.dayState is "dawn">>
	<<if Weather.precipitation is "rain">>
		바다에서 불어온 안개가 이따금 도로 위로 흩뿌려진다.
	<<elseif Weather.isFreezing>>
		부두에서 움직임이 보인다. 노동자들이 아침 추위를 무릅쓰고 일하고 있다.
	<<else>>
		부두에서 벌써부터 활기찬 소리가 들려온다.
	<</if>>
<<elseif Time.dayState is "dusk">>
	<<if Weather.precipitation is "rain">>
		세차게 내리는 빗소리 너머로 부두의 소음이 들린다.
	<<elseif Weather.precipitation is "snow">>
		배수로에 진창이 생긴다.
	<<else>>
		이 시간에도 부두는 여전히 시끄럽다.
	<</if>>
<<elseif Time.dayState is "night">>
	<<if Weather.precipitation is "rain">>
		안개가 얼굴을 따갑게 한다.
	<<elseif Weather.precipitation is "snow">>
		배수로가 진창으로 가득하다.
	<<else>>
		바다 소리 외에는 아무것도 들리지 않는다.
	<</if>>
<</if>>
<<streeteffects>>
<br><br>
<<if $exposed gte 1>>
	<<exhibitionism "street">>
	<<if $exposed is 1>>
		<span class="lewd">이 옷차림은 근처 해변에서는 괜찮을지 몰라도, 여기서는 너무 야하다!</span>
		<br><br>
	<</if>>
<</if>>
<<if $arousal gte $arousalmax>>
	<<orgasmstreet>>
<</if>>
<<if $stress gte $stressmax and !$possessed>>
	<<passoutstreet>>
<<else>>

	<<if (dangerEvent() or $eventforced) and $eventskip is 0>>
		<<eventsstreet>>
	<<else>>
		<<if $options.mapTop is true>>
			<<map "mer">>
			<br>
		<</if>>
		주요 장소
		<br>
		<<docksicon>><<link [[부두 (0:02)|Docks]]>><<pass 2>><</link>>
		<br>
		<<merpiericon>><<link [[부두 (0:10)|Mer Pier]]>><<pass 10>><</link>>
		<br>
		<<if $historytrait gte 2>>
			<<coastalpathicon>><<link [[해안 길 (0:30)|Coast Path Mer]]>><<pass 30>><</link>>
			<br>
		<</if>>
		<br>
		<<if $exposed gte 1 and Time.dayState isnot "night">>
		<<else>>
			<<add_link "이동<br>">><<hideDisplay>>
			<<starfish>>
			<<oxford>>
			<<harvest>>
			<<if $exposed lte 0>>
				<<buswait>>
			<</if>>
			<<loiter>>
		<</if>>
		<<add_link "<br>우회로<br>">><<hideDisplay>>
		<<industrial>>
		<<stormdrain>>
		<<displayLinks>>
		<<if $options.mapTop isnot true>>
			<br>
			<<map "mer">>
		<</if>>
	<</if>>
<</if>>
<<set $eventskip to 0>>
