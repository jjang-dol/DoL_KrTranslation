<</if>>
<<if $confessorQuestions.includes("jordan") and !$confessorQuestions.includes("replacement")>>
	<<link [[누가 조던을 대신할 수 있을까요?|Temple Confessor Intro Ask]]>><<set $confessorQuestions.push("replacement")>><<set $confessorQuestion to "replacement">><</link>>
	<br>
<</if>>
