		<<danubeicon>><<link [[다뉴브 저택 아래에서 발견한 것에 대해 조던에게 알린다|Temple Ritual Inform]]>><<set $jordan_ritual_dance to 3>><</link>>
		<br>
	<</if>>
	<<if $spear_vessel is "sea" and !($temple_spear_mission gte 2)>>
