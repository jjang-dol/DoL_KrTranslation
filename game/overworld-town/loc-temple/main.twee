	<<gwillpower>><<willpower 1>>
	<br><br>
	<<templeicon "trialcontinue">><<link [[계속한다|Temple Firewalk 7]]>><<set Weather.Temperature.override.increase.inside(5)>><</link>><<gpain>>
	<br>
	<<templeicon "trialbail">><<link [[뛰어내린다|Temple Firewalk Jump]]>><<set $phase to 0>><<set Weather.Temperature.override.increase.inside(0)>><</link>>
