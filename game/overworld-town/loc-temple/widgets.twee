:: Widgets Temple [widget]

<<widget "prayoptions">>
	<<if _sydneyPray>>
		<<set _prayPassage to "Temple Sydney Pray">>
	<<else>>
		<<set _prayPassage to "Temple Pray">>
	<</if>>
		<<templeicon "pray">><<link [[구원을 위해 기도한다 (1:00)|_prayPassage]]>>
			<<pass 60>><<set $phase to 2>>
			<<if $purity gte ((1000 / 7) * 7)>>
				<<stress -6>><<awareness -2>><<arousal -1200>>
			<<elseif $purity gte ((1000 / 7) * 6)>>
				<<stress -6>><<awareness -1>><<arousal -1000>>
			<<elseif $purity gte ((1000 / 7) * 5)>>
				<<stress -5>><<awareness -1>><<arousal -800>>
			<<elseif $purity gte ((1000 / 7) * 4)>>
				<<stress -4>><<awareness -1>><<arousal -600>>
			<<elseif $purity gte ((1000 / 7) * 3)>>
				<<stress -3>><<awareness -1>><<arousal -500>>
			<<elseif $purity gte ((1000 / 7) * 2)>>
				<<stress -2>><<awareness -1>><<arousal -400>>
			<<else>>
				<<stress -1>><<awareness -1>><<arousal -300>>
			<</if>>
		<</link>>
		<<lawareness>><<lstress>><<larousal>>
		<br>
		<<if insecurityExists("penis_small") and $daily.templePray isnot 1>>
			<<templeicon "pray">><<link [[더 큰 자지를 위해 기도한다 (1:00)|_prayPassage]]>>
				<<pass 60>><<set $phase to $player.penissize lt 2 ? 4 : 5>><<set $daily.templePray to 1>>
				<<if $purity gte ((1000 / 7) * 7)>>
					<<stress 5>><<acceptance "penis_small" 20>>
				<<elseif $purity gte ((1000 / 7) * 6)>>
					<<stress 5>><<acceptance "penis_small" 18>>
				<<elseif $purity gte ((1000 / 7) * 5)>>
					<<stress 6>><<acceptance "penis_small" 16>>
				<<elseif $purity gte ((1000 / 7) * 4)>>
					<<stress 7>><<acceptance "penis_small" 14>>
				<<elseif $purity gte ((1000 / 7) * 3)>>
					<<stress 8>><<acceptance "penis_small" 12>>
				<<elseif $purity gte ((1000 / 7) * 2)>>
					<<stress 10>><<acceptance "penis_small" 10>>
				<<else>>
					<<stress 12>><<acceptance "penis_small" 8>>
				<</if>>
			<</link>>
			<<gstress>><<gacceptance>>
			<br>
		<</if>>
		<<if insecurityExists("penis_big") and $daily.templePray isnot 1>>
			<<templeicon "pray">><<link [[더 작은 자지를 위해 기도한다 (1:00)|_prayPassage]]>>
				<<pass 60>><<set $phase to 6>><<set $daily.templePray to 1>>
				<<if $purity gte ((1000 / 7) * 7)>>
					<<stress 5>><<acceptance "penis_big" 20>>
				<<elseif $purity gte ((1000 / 7) * 6)>>
					<<stress 5>><<acceptance "penis_big" 18>>
				<<elseif $purity gte ((1000 / 7) * 5)>>
					<<stress 6>><<acceptance "penis_big" 16>>
				<<elseif $purity gte ((1000 / 7) * 4)>>
					<<stress 7>><<acceptance "penis_big" 14>>
				<<elseif $purity gte ((1000 / 7) * 3)>>
					<<stress 8>><<acceptance "penis_big" 12>>
				<<elseif $purity gte ((1000 / 7) * 2)>>
					<<stress 10>><<acceptance "penis_big" 10>>
				<<else>>
					<<stress 12>><<acceptance "penis_big" 8>>
				<</if>>
			<</link>>
			<<gstress>><<gacceptance>>
			<br>
		<</if>>
		<<if insecurityExists("breasts_small") and $daily.templePray isnot 1>>
			<<templeicon "pray">><<link [[더 큰 가슴을 위해 기도한다 (1:00)|_prayPassage]]>>
				<<pass 60>><<set $phase to !$player.breastsize ? 7 : 8>><<set $daily.templePray to 1>>
				<<if $purity gte ((1000 / 7) * 7)>>
					<<stress 5>><<acceptance "breasts_small" 20>>
				<<elseif $purity gte ((1000 / 7) * 6)>>
					<<stress 5>><<acceptance "breasts_small" 18>>
				<<elseif $purity gte ((1000 / 7) * 5)>>
					<<stress 6>><<acceptance "breasts_small" 16>>
				<<elseif $purity gte ((1000 / 7) * 4)>>
					<<stress 7>><<acceptance "breasts_small" 14>>
				<<elseif $purity gte ((1000 / 7) * 3)>>
					<<stress 8>><<acceptance "breasts_small" 12>>
				<<elseif $purity gte ((1000 / 7) * 2)>>
					<<stress 10>><<acceptance "breasts_small" 10>>
				<<else>>
					<<stress 12>><<acceptance "breasts_small" 8>>
				<</if>>
			<</link>>
			<<gstress>><<gacceptance>>
			<br>
		<</if>>
		<<if insecurityExists("breasts_big") and $daily.templePray isnot 1>>
			<<templeicon "pray">><<link [[더 작은 가슴을 위해 기도한다 (1:00)|_prayPassage]]>>
				<<pass 60>><<set $phase to 9>><<set $daily.templePray to 1>>
				<<if $purity gte ((1000 / 7) * 7)>>
					<<stress 5>><<acceptance "breasts_big" 20>>
				<<elseif $purity gte ((1000 / 7) * 6)>>
					<<stress 5>><<acceptance "breasts_big" 18>>
				<<elseif $purity gte ((1000 / 7) * 5)>>
					<<stress 6>><<acceptance "breasts_big" 16>>
				<<elseif $purity gte ((1000 / 7) * 4)>>
					<<stress 7>><<acceptance "breasts_big" 14>>
				<<elseif $purity gte ((1000 / 7) * 3)>>
					<<stress 8>><<acceptance "breasts_big" 12>>
				<<elseif $purity gte ((1000 / 7) * 2)>>
					<<stress 10>><<acceptance "breasts_big" 10>>
				<<else>>
					<<stress 12>><<acceptance "breasts_big" 8>>
				<</if>>
			<</link>>
			<<gstress>><<gacceptance>>
			<br>
		<</if>>
		<<if insecurityExists("pregnancy") and $daily.templePray isnot 1>>
			<<set _pregnancyLink to (playerAwareTheyArePregnant() ? "Pray about your pregnant belly (1:00)" : "Pray about your pregnant looking belly (1:00)")>>
			<<templeicon "pray">><<link [[_pregnancyLink|_prayPassage]]>>
				<<pass 60>><<set $phase to 10>><<set $daily.templePray to 1>>
				<<if $purity gte ((1000 / 7) * 7)>>
					<<stress 5>><<acceptance "pregnancy" 20>>
				<<elseif $purity gte ((1000 / 7) * 6)>>
					<<stress 5>><<acceptance "pregnancy" 18>>
				<<elseif $purity gte ((1000 / 7) * 5)>>
					<<stress 6>><<acceptance "pregnancy" 16>>
				<<elseif $purity gte ((1000 / 7) * 4)>>
					<<stress 7>><<acceptance "pregnancy" 14>>
				<<elseif $purity gte ((1000 / 7) * 3)>>
					<<stress 8>><<acceptance "pregnancy" 12>>
				<<elseif $purity gte ((1000 / 7) * 2)>>
					<<stress 10>><<acceptance "pregnancy" 10>>
				<<else>>
					<<stress 12>><<acceptance "pregnancy" 8>>
				<</if>>
			<</link>>
			<<gstress>><<gacceptance>>
			<br>
		<</if>>
		<<crimeicon "mark">><<link [[지켜본다 (1:00)|_prayPassage]]>>
			<<pass 60>><<set $phase to 3>>
			<<if $purity gte ((1000 / 7) * 7)>>
				<<stress 5>><<awareness 2>>
			<<elseif $purity gte ((1000 / 7) * 6)>>
				<<stress 5>><<awareness 1>>
			<<elseif $purity gte ((1000 / 7) * 5)>>
				<<stress 6>><<awareness 1>>
			<<elseif $purity gte ((1000 / 7) * 4)>>
				<<stress 7>><<awareness 1>>
			<<elseif $purity gte ((1000 / 7) * 3)>>
				<<stress 8>><<awareness 1>>
			<<elseif $purity gte ((1000 / 7) * 2)>>
				<<stress 10>><<awareness 1>>
			<<else>>
				<<stress 12>><<awareness 1>>
			<</if>>
		<</link>>
		<<gawareness>><<gstress>>
		<br>
		<<if !_sydneyPray>>
			<<refuseicon>><<link [[멈춘다|Temple]]>><</link>>
			<br>
		<</if>>
<</widget>>

<<widget "passouttemple">>
	<<if isPregnancyEnding()>>
		<<pregnancyPassout "temple">>
	<<else>>
		당신은 너무 무리했다.
		<br><br>
		<<passout>>

		<<if dangerEvent()>>
			<<link [[다음|Lake Ritual]]>><</link>>
			<br>
		<<else>>
			<<ambulance>>
		<</if>>

		<<pass 1 hour>>
		<<trauma 6>><<set $stress -= 2000>>
	<</if>>
<</widget>>

<<widget "inittemple">>
	<<set $temple_rank to "initiate">>
	<<set $temple_initiate_days to 0>>
	<<set $player.virginity.temple to true>>
	<<set $temple_garden to 0>>
	<<set $temple_quarters to 0>>
	<<set $grace to 0>>
	<<set $temple_harassed to 0>>
	<<set $temple_chastity_timer to 30>>
	<<set $temple_event to 1>>
<</widget>>

<<widget "prayerend">>
	<<if Time.hour is 0>>
		<<generate1>><<person1>>
		<<monk>>【이가】 방에 들어온다. "청소하러 왔습니다," <<he>>【이가】 말한다.

			<<if $temple_sneak is 1>>
				<<He>>【은는】 얼굴을 찌푸린다. "여기에 누가 계신 줄은 몰랐습니다. 이렇게 늦은 밤에 기도하는 것은 바람직하지 않습니다. 아침에 계속하시지요. 향도 거의 다 떨어졌습니다."
			<<else>>
				"이렇게 늦은 밤에 여기서 기도하는 건 좋지 않습니다. 아침에 계속할 수 있습니다. 어차피 향도 거의 다 떨어졌고요."
			<</if>>
		<br><br>

		<<endevent>>
		<<link [[떠난다|Temple]]>><<unset $temple_sneak>><</link>>
		<br>
	<<elseif $temple_jordan_prayer is undefined and random(1, 20) is 20 and $temple_sneak is 1>><<set $temple_jordan_prayer to 1>>
		<<npc Jordan>><<person1>>
		방문이 열린다. 조던이 걸어 들어온다. <<He>>【은는】 당신을 보고 놀란 눈치다. <<He>>【은는】 문을 닫고, 반대편 계단에 앉는다.
		<br><br>

		"여기에 누가 있을 줄은 몰랐군요," <<he>>【은는】 속삭인다. <<He>>【은는】 더 가까이 다가온다. "몰래 들어왔습니까?"
		<br><br>

		<<link [[사실대로 말한다|Temple Prayer Truth]]>><<grace 1>><</link>><<ggrace>><<handholdingvirginitywarning>>
		<br>
		<<link [[거짓말한다|Temple Prayer Lie]]>><<grace -1>><</link>><<lgrace>><<handholdingvirginitywarning>>
		<br>
	<<elseif $temple_sneak is 1>>
		<<link [[계속 기도한다 (1:00)|Temple Prayer]]>><<grace -5>><</link>><<llgrace>>
		<br>
		<<link [[그만둔다|Temple]]>><<unset $temple_sneak>><</link>>
		<br>
	<<else>>
		<<link [[계속 기도한다 (1:00)|Temple Prayer]]>><</link>>
		<br>
		<<link [[그만둔다|Temple]]>><<unset $temple_sneak>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "eventstemple">>
	/* ToDo: eventpoolify */
	<<if $rng gte 91>>
		<<if $angel gte 6>>
			<<if playerBellyVisible()>>
				<<generate1>><<person1>>
				복도를 헤매는 두 사람의 모습이 눈에 들어온다. 무언가, 또는 누군가를 찾고 있는 것 같다. 그들은 당신을 발견하자마자 발걸음을 빨리해 다가온다.
				<br><br>

				그들은 당신을 쳐다보다가, 시선을 내려 당신의 배를 본다. 두 사람 모두 손가락에 은반지를 끼고 있는 것이 보인다. 일행인 게 틀림없다.
				<br><br>

				"여기 계셨군요," 두 사람 중 한 명이 말한다. "당신을 찾고 있었습니다."
				<br><br>

				당신이 이유를 묻기도 전에 <<his>> 파트너가 이어서 말한다, "신께서 당신을 축복하셨습니다. 당신은 이토록 순결한데도 아이를 품고 계시는군요. 저희도 오랫동안 아이를 가지려 노력했지만, 소용이 없었습니다. 부디, 당신의 잉태의 힘으로 저희를 축복해 주십시오."
				<br><br>

				<<link [[축복을 내려준다|Temple Fertility Blessing]]>><</link>>
				<br>
				<<link [[그들의 요청을 거절한다|Temple Fertility Blessing Refuse]]>><</link>>
			<<else>>
				<<generate1>><<person1>><<generate2>><<generatey3>>"오, 불쌍한 아이야," 당신의 오른쪽에서 목소리가 들린다. 늙은 <<person>>【이】다. "마치 천사 같구나. 내게 축복을 내려주겠니?"
				<br><br>

				<<link [[축복을 내려준다 (0:10)|Temple Blessing]]>><<grace 3>><<pass 10>><</link>><<gggrace>>
				<br>
				<<link [[거절한다|Temple Blessing Refuse]]>><<grace -1>><</link>><<lgrace>>
				<br>
			<</if>>
		<<elseif $demon gte 6 and ($transformationParts.demon.horns isnot "hidden" or $transformationParts.demon.wings isnot "hidden" or $transformationParts.demon.tail isnot "hidden")>>
			<<generate1>><<person1>><<generate2>>당신의 오른쪽에서 누군가 비명을 지른다. 나이 든 <<monk>>【이】다. <<He>>【은는】 광기 어린 눈빛으로 당신을 노려보며, 성스러운 상징을 내민다.
			<br><br>

			"사악한 존재여!" <<he>>【이가】 소리친다. "이 신성한 곳에서 물러가십시오. 더는 소란을 피우지 마십시오!"
			<<gstress>><<gtrauma>><<stress 6>><<trauma 6>>
			<br><br>

			<<person2>><<priest>>【이가】 달려와 <<person1>><<monk>>【을를】 진정시킨다. <<person2>><<He>>【은는】 <<person1>><<him>>【을를】 당신에게서 멀리 떨어뜨려 다른 방으로 안내하는 데 성공한다.
			<br><br>
			<<person2>><<priest>>【이가】 당신에게 고개를 돌린다. "정말 죄송합니다," <<he>>【이가】 말한다. "우리 사람들 중 일부는 세상물정을 잘 몰라서요." <<He>>【은는】 찡그리며 당신의 <<if $transformationParts.demon.horns isnot "hidden">>뿔<<elseif $transformationParts.demon.wings isnot "hidden">>날개<<elseif $transformationParts.demon.tail isnot "hidden">>꼬리<</if>>【을를】 쳐다본다. "이곳에선 옷차림에 신경 쓰셔야 합니다. 다른 건 몰라도 그건 무례한 행동이니까요."
			<br><br>

			<<endevent>>

			<<link [[다음|Temple]]>><</link>>
			<br>
		<<elseif $fallenangel gte 2 and ($transformationParts.fallenAngel.halo isnot "hidden" or $transformationParts.fallenAngel.wings isnot "hidden")>>
			<<generatey1>><<generate2>><<person1>>
			당신은 모두가 당신을 쳐다보기를 꺼린다는 사실을 깨닫는다. 단 한 <<person>>만이 예외로, 당신의 부서진 <<if $transformationParts.fallenAngel.halo isnot "hidden">>후광<<elseif $transformationParts.fallenAngel.wings isnot "hidden">>날개<</if>>【을를】 경이롭다는 듯 쳐다본다. <<His>> <<person2>><<father>>【이가】 서둘러 <<person1>><<his>> 눈을 가리고 <<him>>【을를】 끌고 간다.
			<<gtrauma>><<trauma 6>>
			<br><br>
			<<endevent>>

			<<link [[다음|Temple]]>><</link>>
			<br>
		<<else>>
			신전은 평소보다 분주하다. 신도석은 붐비고, 성직자들은 모두를 돌보느라 진땀을 빼고 있다.
			<br><br>

			<<link [[다음|Temple]]>><</link>>
			<br>
		<</if>>
	<<elseif $rng gte 81>>
		<<if _sydneyTemple and $sydney_templeWork is "garden">>
			<<npc "Sydney">><<person1>>
			당신은 창문 밖을 내다보다, 정원에 앉아 이야기를 나누는 여러 수습생들을 발견한다. 시드니도 그들과 함께 있는 것을 눈치챈다.
			<br><br>
			<<link [[그들과 합류한다 (1:00)|Temple Garden Join Sydney]]>><<pass 60>><<trauma -6>><<stress -6>><<npcincr Sydney love 1>><</link>><<ltrauma>><<lstress>><<glove>>
			<br>
			<<if $temple_rank isnot undefined and $temple_rank isnot "prospective">>
				<<link [[정원 정리를 하도록 그들을 독려한다 (1:00)|Temple Garden Encourage Sydney]]>><<grace 3>><<pass 60>><<tiredness 6>><</link>><<gtiredness>><<gggrace>>
				<br>
			<</if>>
			<<link [[무시한다|Temple]]>><<endevent>><</link>>
			<br>
		<<else>>
			창문 밖을 내다보니 여러 수습생들이 정원에 모여 앉아 잡담을 나누고 있다.
			<br><br>
			<<if $temple_rank is undefined or $temple_rank is "prospective">>
				<<link [[다음|Temple]]>><<endevent>><</link>>
				<br>
			<<else>>
				<<link [[그들과 합류한다 (1:00)|Temple Garden Join]]>><<pass 60>><<trauma -6>><<stress -6>><</link>><<ltrauma>><<lstress>>
				<br>
				<<link [[정원 정리를 하도록 그들을 독려한다 (1:00)|Temple Garden Encourage]]>><<grace 3>><<pass 60>><<tiredness 6>><</link>><<gtiredness>><<gggrace>>
				<br>
				<<link [[무시한다|Temple]]>><<endevent>><</link>>
				<br>
			<</if>>
		<</if>>
	<<elseif $rng gte 71>>
		계단 아래에서 한 무리의 수습생들이 잡담을 나누고 있는 것이 보인다.
		<br><br>
		<<if $temple_rank is undefined or $temple_rank is "prospective">>
			<<link [[다음|Temple]]>><<endevent>><</link>>
			<br>
		<<else>>
			<<link [[그들과 합류한다 (1:00)|Temple Stairs Join]]>><<pass 60>><<trauma -6>><<stress -6>><</link>><<ltrauma>><<lstress>>
			<br>
			<<link [[숙소 정리를 하도록 그들을 독려한다 (1:00)|Temple Stairs Encourage]]>><<grace 3>><<pass 60>><</link>><<gtiredness>><<gggrace>>
			<br>
			<<link [[무시한다|Temple]]>><<endevent>><</link>>
			<br>
		<</if>>
	<<elseif $rng gte 63 and playerBellyVisible() and $settings.pregnancySpeechEnabled>>
		<<generatey1>><<generate2>>
		<<person1>><<person>>【이가】 당신의 배를 힐끗힐끗 보는 것을 포착한다. <<He>>【은는】 <<person1>><<his>> <<person2>><<father>>처럼 보이는 <<person2>><<person>>에게 고개를 돌려 묻는다. "임신하신 걸까요?"
		<br><br>

		<<if $templePromised isnot "">>
			<<He>>【은는】 대답한다, "그런 것 같구나. 명심하렴, 결혼 후 아이를 갖는 것은 죄가 아니란다." <<He>>【은는】 당신의 반지를 가리킨다. "어쩌면 이 마을에도 아직 희망이 있을지 모르겠군."
			<<ltrauma>><<trauma -6>><<lstress>><<stress -6>>
		<<else>>
			<<He>>【은는】 대답한다. "그런 것 같구나. 결혼 반지가 없지만,
			<<if $worn.hands.name isnot "naked">>
				단지 <<pher>> <<print $worn.hands.name>> 밑에 가려진 걸 수도 있지."
			<<else>>
				"어쨌든, <<phim>>【을를】 위해 기도해야겠구나."
			<</if>>
			<<gtrauma>><<trauma 6>>
		<</if>>
		<br><br>
		<<endevent>>

		<<link [[다음|Temple]]>><</link>>
		<br>
	<<elseif $rng gte 59>>
		<<generate1>><<person1>>
		<<if $purity gte 990>>
			<<priest>>【이가】 지나간다. <<He>>【은는】 당신이 헌신적으로 순결을 지키는 것을 칭찬한다.
			<<ltrauma>><<trauma -6>>
			<br><br>

			<<endevent>>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<<elseif $purity gte 900>>
			<<priest>>【이가】 지나간다. <<He>>【은는】 당신을 무시한다.
			<br><br>

			<<endevent>>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<<elseif $purity gte 500>>
			<<priest>>【이가】 지나가다 멈춰 서서 당신을 가로막는다. "잘못된 길을 걷고 있구나, 아이야," <<he>>【이가】 말한다. "너의 방식을 바꿔야 해. 순결의 길을 찾거라."
			<<gstress>><<stress 6>>
			<br><br>

			<<endevent>>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<<else>>
			<<priest>>【이가】 지나간다. <<He>>【은는】 당신을 멀찍이 피하며, 입술을 달싹여 조용히 기도를 속삭인다.
			<br><br>

			<<endevent>>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<</if>>
	<<elseif $rng gte 51>>
		<<if $awareness gte 800>>
			산전수전 다 겪은 성직자들이 교구민들을 돌보며, 겉으로나마 예의 바른 분위기를 만들어낸다.
			<<if $temple_confessor_intro>>
				지금으로선, 고해성사의 비밀은 유지되고 있다.
			<<else>>
				이 타락이 어디까지 뿌리내렸는지 의문이 든다.
			<</if>>
			<<gstress>><<stress 6>>
			<br><br>

			<<if _sydneyTemple>>
				<<run statusCheck("Sydney")>>
				<<if _sydneyStatus.includes("corrupt")>>
					어쩌면 시드니도 그걸 눈치채고 있을지 모른다.
				<<else>>
					시드니의 무지함이 부럽다.
				<</if>>
				<br><br>
			<</if>>

			<<link [[다음|Temple]]>><</link>>
			<br>
		<<elseif $awareness gte 600>>
			<<generate1>><<person1>>
			불안해 보이는 <<priest>>【이가】 벽의 부적을 수리하고 있다. 다른 성직자는 교구민의 고통에 고개를 끄덕이면서도, 주변을 살피며 위험을 찾는다. <<monk>>【은는】 붉은 십자가가 그려진 문을 지나, 계단 아래로 상자를 몰래 옮기고 있다.
			<br><br>

			<<endevent>>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<<elseif $awareness gte 400>>
			<<generate1>><<person1>>
			성직자들은 교구민들을 보살피면서도 어딘가 주의가 산만해 보인다. 당신은 <<monk>>【이가】 붉은 십자가가 칠해진 문 너머의 계단 아래로 상자를 몰래 나르는 것을 발견한다.
			<br><br>
			<<endevent>>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<<elseif $awareness gte 200>>
			성직자들이 지쳐 보인다. 교구민들을 감당할 만큼 충분한 인원이 있는 것 같은데 이상한 일이다.
			<br><br>

			<<if _sydneyTemple>>
				이게 바로 시드니가 항상 피곤해 보이는 이유가 아닐까 하는 생각이 든다.
				<br><br>
			<</if>>

			<<link [[다음|Temple]]>><</link>>
			<br>
		<<elseif $awareness gte 0>>
			신전의 안전한 보호 아래에 있다는 사실에 안도감이 밀려온다.
			<<lstress>><<stress -6>>
			<br><br>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<<else>>
			당신은 순수하고 정의로운 성직자들에게 둘러싸인 이곳에서 안전하다고 느낀다.
			<<llstress>><<stress -18>>
			<br><br>

			<<link [[다음|Temple]]>><</link>>
			<br>
		<</if>>
	<<elseif $rng gte 41>>
		<<generate1>><<person1>><<generate2>> 당신은 <<priest>>【이가】 <<person2>><<monk>>【와과】 나누는 대화를 우연히 엿듣는다.
		<br><br>
		<<if $gwylan?.timer.ritual gte Time.date.timeStamp>>
			"숲이 요 며칠 잠잠하더군요," <<person1>><<priest>>【이가】 말한다. "이번엔 정원이 덩굴에 질식당하지 않고 있습니다."
			<br><br>
			"무언가 바뀐 게 있습니까?" <<person2>><<monk>>【이가】 묻는다. "아니면 우리의 노력 덕분에 침입을 막아낸 걸까요?"
			<br><br>
		<<else>>
			"간밤에 숲이 침략했습니다," <<person1>><<priest>>【이가】 말한다. "또 말입니다."
			<br><br>
			"어쩔 수 없군요," <<person2>><<monk>>【이가】 대답한다. "제 전지가위를 챙겨 오겠습니다. 수습생 몇 명을 데려와 일을 도와달라고 해봐야겠어요."
			<br><br>
			<<if $temple_rank is undefined or $temple_rank is "prospective">>
			<<else>>
				<<set $temple_garden -= 10>>
			<</if>>
		<</if>>
		<<endevent>>
		<<link [[다음|Temple]]>><</link>>
		<br>
	<<elseif $rng gte 36>>
		<<generate1>><<person1>>
		<<monks>> 행렬이 신전 안으로 행진해 들어오며, 다들 엄숙한 기도를 올리듯 고개를 숙이고 있다. 그들의 수도복 밑에서 무언가 쩔렁거리는 소리가 들린다.
		<br><br>

		<<if $temple_rank is undefined or $temple_rank is "prospective" or $temple_rank is "initiate">>
			<<link [[금속 소리에 대해 묻는다|Temple March Clink]]>><</link>>
			<br>
		<<else>>
			<<link [[그들의 무기 닦는 것을 돕는다 (1:00)|Temple March Help]]>><<pass 60>><<grace 3>><</link>><<gggrace>>
			<br>
			<<link [[독려한다|Temple March Encourage]]>><<grace 1>><</link>><<ggrace>>
			<br>
		<</if>>
		<<link [[무시한다|Temple]]>><<endevent>><</link>>
		<br>
	<<elseif $rng gte 31>>
		<<generate1>><<person1>><<generate2>>
		당신은 두 수습생의 대화를 엿듣는다.
		<br><br>

		"숙소가 엉망진창이야," 한 명이 말한다. "마치 안에서 <<person2>><<monks>>【이가】 밤새 파티라도 한 것 같아. 어떻게 했는지는 몰라도 사방에 진흙을 잔뜩 묻혀놨더라고."
		<br><br>

		"직접 청소해야 했다면 그렇게 더럽히진 않았을 텐데," 다른 한 명이 대답한다. "서약을 좀 더 진지하게 받아들일 거라고 생각했는데 말이야."
		<br><br>
		<<if $temple_rank is undefined or $temple_rank is "prospective">>
		<<else>>
			<<set $temple_quarters -= 10>>
		<</if>>
		<<endevent>>

		<<link [[다음|Temple]]>><</link>>
		<br>
	<<elseif $rng gte 21>>
		<<generate1>><<person1>>
		고대 찬송가를 부르며 <<monks>> 행렬이 지나간다.
		<br><br>
		<<endevent>>
		<<link [[다음|Temple]]>><</link>>
		<br>
	<<elseif $rng gte 16>>
		<<generate1>><<person1>>
		달콤한 향기가 나는 향로를 흔들며 <<priest>>【이가】 지나간다.
		<br><br>

		<<endevent>>
		<<link [[다음|Temple]]>><</link>>
		<br>
	<<elseif $rng gte 11>>
		<<generateTemple 1>><<generateyTemple 2>><<generateyTemple 3>><<generateTemple 4>><<generateTemple 5>><<generateTemple 6>><<person1>>
		<<if $temple_rank isnot undefined and $temple_rank isnot "prospective">>
			<<if $temple_rank is "initiate">>
				<<monk>>【이가】 걸어온다. "아, 수습생," <<he>>【이가】 말한다. "마침 잘 오셨습니다. 오늘 기부금을 모금할 예정인데, 도움이 필요합니다. 수습생이 함께할수록 사람들이 더 너그러워지곤 합니다." 다른 여러 수습생들이 이미 <<him>> 곁에 따라다니고 있다.
			<<else>>
				<<monk>>【이가】 걸어온다. "<<Sister>>님," <<he>>【이가】 말한다. "오늘 기부금을 모금할 예정입니다. 저희와 함께하시겠습니까?" 여러 수습생들이 이미 <<him>> 곁에 따라다니고 있다.
			<</if>>
			<br><br>

			<<link [[그들과 합류한다 (2:00)|Temple Donations]]>><<grace 3 monk>><<pass 30>><</link>><<gggrace monk>>
			<br>
			<<link [[거절한다|Temple]]>><<grace -3 monk>><<endevent>><</link>><<llgrace monk>>
			<br>
		<<else>>
			<<monk>>【이가】 신전을 나선다. 수습생들의 행렬이 <<him>>【을를】 따르고 있다.
			<br><br>

			<<endevent>>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<</if>>
	<<else>>
		과로에 찌든 수습생 하나가 두루마리 다발을 든 채 서둘러 지나간다.
		<<if random(1, 5) is 5>>
			<<generateTemple 1>><<person1>>
			<<He>>【은는】 신도석에 걸려 넘어져 바닥에 두루마리들을 이리저리 쏟아버린다.
			<br><br>

			<<He>>【은는】 바닥에 꼼짝 않고 누워 있다. 아픔 때문이라기보다는 짜증이 나서 신음을 흘린다.
			<br><br>

			<<if $temple_rank is undefined or $temple_rank is "prospective">>
				<<link [[돕는다 (0:05)|Temple Help]]>><<pass 5>><<trauma -6>><</link>><<ltrauma>>
			<<else>>
				<<link [[돕는다 (0:05)|Temple Help]]>><<pass 5>><<trauma -6>><<grace 1>><</link>><<ggrace>><<ltrauma>>
			<</if>>
			<br>
			<<link [[무시한다|Temple]]>><<endevent>><</link>>
			<br>
		<<elseif _sydneyTemple and $sydney_templeWork isnot "pray">>
			<<if $sydneyromance is 1>>
				당신은 시드니라는 사실을 깨닫지 못하다가, <<nnpc_he "Sydney">>【이가】 지나치면서 당신의 뺨에 입을 맞추고서야 알아차린다. <<npcincr Sydney lust 1>><<glust>>
			<<else>>
				시드니이다. <<nnpc_He "Sydney">>【은는】 돌아서서 당신에게 손을 흔들며 미소를 짓다가, 하마터면 신도석에 걸려 넘어질 뻔한다.
			<</if>>
			<br><br>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<<else>>
			<<endevent>>
			<br><br>
			<<link [[다음|Temple]]>><</link>>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "temple_effects">>
	<<if $temple_rank is "initiate" or $temple_rank is "monk" or $temple_rank is "priest">>
		<br>
		은총:
		<div class="meter">
			<<set _percent to Math.floor((($grace + 100)/ 100)*50)>>
			<<if $grace isnot 100>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
			<<else>>
				<<print '<div class="goldbar glowbar" style="width:' + _percent + '%"></div>'>>
			<</if>>
		</div>
		<br>
	<</if>>

	<<if C.npc.Sydney.init is 1 and _sydney_location is "temple">>
		<<set _sydneyTemple to true>>
	<</if>>

<</widget>>

<<widget "temple_title">><<silently>>
	<<if _args[0] is "Sydney">>
		<<switch $sydney.rank>>
			<<case "initiate">><<set _text_output to "수련생">>
			<<case "monk">><<set _text_output to (C.npc.Sydney.pronoun is "m" ? "수도사" : "수녀")>>
			<<case "priest">><<set _text_output to "사제">>
			<<default>><<set _text_output to "수련생">>
		<</switch>>
	<<elseif _args[0] is "dark">>
		<<switch $temple_rank>>
			<<case "initiate">><<set _text_output to "신참">>
			<<case "monk">>
				<<if $temple_confessor_intro>>
					<<set _text_output to "그릇">>
				<<else>>
					<<set _text_output to "사도">>
				<</if>>
			<<case "priest">><<set _text_output to "어둠의 사제">>
			<<default>><<set _text_output to "신참">>
		<</switch>>
	<<else>>
		<<switch $temple_rank>>
			<<case "initiate">><<set _text_output to "수련생">>
			<<case "monk">><<set _text_output to ($player.gender_appearance is "m" ? "수도사" : "수녀")>>
			<<case "priest">><<set _text_output to "사제">>
			<<default>><<set _text_output to "수련생">>
		<</switch>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "temple_Title">><<silently>>
	<<if _args[0] is "Sydney">>
		<<temple_title "Sydney">><<capitalise>>
	<<elseif _args[0] is "dark">>
		<<temple_title "dark">><<capitalise>>
	<<else>>
		<<temple_title>><<capitalise>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "endconfession">>
	<<unset $attendant>>
	<<unset $confession>>
	<<endevent>>
<</widget>>

<<widget "endconfessionself">>
	<<set $daily.confessed to $confession>>
	<<endconfession>>
<</widget>>

<<widget "temple_bailey_options">>
	<<babyRent>>
	<<if $money gte $rentmoney + ($babyRent or 0)>>
		<<link [[돈을 지불한다|Temple Bailey Pay]]>><</link>>
		<br>
		<<link [[거부한다|Temple Bailey Refuse]]>><<def 1>><<grace -30>><</link>><<lllgrace>>
		<br>
	<<else>>
		<<set $baileypaychain to 0>>
		<<set $baileyRefusedToPay += 1>>
		<<set $baileyRefusedToPayTotal += $rentmoney + ($babyRent || 0)>>
		<<set $baileyRefusedToPayTotalStat += $rentmoney + ($babyRent || 0)>>
		<<if $speech_attitude is "meek">>
			"도-돈이 없어," 당신은 베일리에게 말한다. "신전에는 아무 원한도 갖지 말아줘."
		<<elseif $speech_attitude is "bratty">>
			"돈 없어," 당신은 베일리에게 말한다. "게다가 내 <<brothers_and_sisters>>에게 둘러싸인 채로 그런 걸 요구하다니 참 뻔뻔하기도 하네."
		<<else>>
			"돈은 없어," 당신은 베일리에게 말한다. "신께서 네 죄를 용서하시기를 바랄 뿐이야."
		<</if>>
		<br><br>
		"빚은 우리에게 수치입니다."
		<br>
		"우리 <<sister>>의 명예를 더럽히는 짓이지."<<lllgrace>><<grace -30>>
		<br><br>

		"마음대로 해," 베일리가 말한다. <<nnpc_He Bailey>>【은는】 돌아서서 걸어간다.
		<br><br>

		<<link [[다음|Temple]]>><<endevent>><</link>>
		<br>
	<</if>>
	<<set $renttime to 7>><<set $rentday to Time.weekDay>>
<</widget>>

<<widget "temple_spear_mission_end">>
	<<unset $temple_spear_mission_winter>>
<</widget>>
