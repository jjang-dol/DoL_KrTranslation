	<<set $_colourBase to ["black", "white", "white"].filter(c => c !== $_colour).random()>>

	<!-- gender neutral underwear -->
	<!-- <<set $_underwearSet.push()>> --> /* empty for now */

	<<if $_underwearGender is "m">>
		<<set $_underwearSet.push(
			{id: 4, desc: "XX 브리프", simpleDesc: "브리프", colourDesc: "XX 브리프", hasAcc: false},
		)>>
	<<else>>
		<<set $_underwearSet.push(
			{id: 20, desc: "XX【와과】 YY 줄무늬 팬티", simpleDesc: "팬티", colourDesc: "XX【와과】 YY 줄무늬 팬티", hasAcc: true},
			{id: 1, desc: "XX 팬티", simpleDesc: "팬티", colourDesc: "XX 팬티", hasAcc: false},
		)>>
	<</if>>
	<<set _kylarUndies to $_underwearSet.random()>>

	<<if _kylarUndies.hasAcc>>
		<!-- If the underwear has two colours, the second colour is its base, so "white with red stripes" and "red" both use $_colour for "red" -->
		<<set _kylarUndies.colour to $_colourBase>>
		<<set _kylarUndies.colourAcc to $_colour>>
	<<else>>
		<<set _kylarUndies.colour to $_colour>>
	<</if>>

	<!-- Replace the XX and YY in the descriptions with the colours that have been randomly chosen -->
	/* colour/colourAcc 자체는 옷장/색상 필터 렌더링 등에서 영어 키로 계속 쓰이므로 그대로 두고,
	   화면에 보여줄 desc/colourDesc에만 한글 색상명을 대신 넣는다. */
	<<set _colourKr to { black: "검은색", white: "흰색", grey: "회색", pink: "분홍색", red: "빨간색", green: "초록색" }>>
	<<set _kylarUndies.desc to _kylarUndies.desc.replace("XX", _colourKr[_kylarUndies.colour] || _kylarUndies.colour).replace("YY", _colourKr[_kylarUndies.colourAcc] || _kylarUndies.colourAcc)>>
	<<set _kylarUndies.colourDesc to _kylarUndies.colourDesc.replace("XX", _colourKr[_kylarUndies.colour] || _kylarUndies.colour).replace("YY", _colourKr[_kylarUndies.colourAcc] || _kylarUndies.colourAcc)>>

	<<if !($kylarSeen.includes("commando") or $daily.kylar.underwear?.desc)>>
		<<set $daily.kylar.underwear to _kylarUndies>>
	<</if>>
<</widget>>

