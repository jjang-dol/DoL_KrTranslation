				<<birdicon "sing">><<link [[로빈과 함께 노래한다 (0:20)|Robin Harpy]]>><<pass 20>><<trauma -2>><<stress -2>><<npcincr Robin love 1>><<npcincr Robin dom -2>><</link>><<harpy>><<ldom>><<glove>><<ltrauma>><<lstress>>
				<br>
			<<else>>
				<<birdicon "sing">><<link [[로빈과 함께 노래한다 (0:20)|Robin Harpy]]>><<pass 20>><<trauma -2>><<stress -2>><<npcincr Robin love 1>><<npcincr Robin dom 1>><</link>><<harpy>><<gdom>><<glove>><<ltrauma>><<lstress>>
				<br>
			<</if>>
		<</if>>
		<<if _robin.trauma lt 20 and $wolfgirl gte 6>>
			<<tficon "wolf">><<link [[배를 드러낸다 (0:20)|Robin Wolf]]>><<pass 20>><<trauma -2>><<stress -2>><<npcincr Robin love 1>><<npcincr Robin dom 1>><</link>><<wolfgirl>><<gdom>><<glove>><<ltrauma>><<lstress>>
			<br>
		<</if>>
		<<if _robin.trauma lt 20 and $fox gte 6 and $transformationParts.fox.tail isnot "hidden">>
			<<tficon "fox">><<link [[꼬리를 살랑인다 (0:20)|Robin Fox]]>><<pass 20>><<trauma -2>><<stress -2>><<npcincr Robin love 1>><<npcincr Robin dom 1>><</link>><<fox>><<gdom>><<glove>><<ltrauma>><<lstress>>
			<br>
		<</if>>
		<<if _robin.lovestage gte 3 and _robin.trauma lte 20>>
			<<brothelicon>><<link [[추파를 던진다 (0:15)|Robin Flirt Room]]>><<pass 15>><<npcincr Robin love 1>><</link>><<promiscuous1>><<glove>>
			<br>
		<</if>>
		<<if $robin.wateringIntro and _robin.trauma lt 50>>
			<<if !$daily.robin.wateringAsk>>
				<<set $daily.robin.wateringAsk to 0>>
			<</if>>
			<<if $daily.robin.wateringAsk lt 2>> /* Hide these options if Robin has been asked too much */
				<<gardenicon>>
				<<if $robin.autoWater>>
					<<link [[로빈에게 정원 물주기를 그만하라고 부탁한다 (0:01)|Robin Watering Ask]]>><<pass 1>><<set $robin.autoWater to false>><</link>>
				<<else>>
					<<link [[로빈에게 정원에 물을 주기 시작해 달라고 부탁한다 (0:01)|Robin Watering Ask]]>><<pass 1>><<set $robin.autoWater to true>><</link>>
				<</if>>
				<br>
			<</if>>
		<</if>>
		<<if _robin.lovestage gte 1 and $milkshake gte 2>>
			<<foodicon "milkshake">><<link [[밀크쉐이크를 권한다 (0:20)|Robin Give Milkshake]]>><<pass 20>><<set $milkshake -= 2>><<stress -5>> <</link>><<lstress>><<glove>>
			<br>
		<</if>>
		<<if _robin.lovestage gte 2 and $milkshake gte 1>>
			<<foodicon "milkshake">><<link [[밀크쉐이크를 나눠 마신다 (0:20)|Robin Share Milkshake]]>><<pass 20>><<set $milkshake -= 1>><<stress -10>><</link>><<lstress>><<gglove>>
			<br>
		<</if>>
		<<if checkSextoysGift("Robin") and checkIfNPCHasCategorySextoy("Robin","strap-on").length <= 5>>
			<<sextoysicon "strap-on">><<link [[로빈에게 페니스 밴드를 선물한다|Robin Gift Strap-on]]>><</link>>
			<br>
		<</if>>
		<br>
		<<if canGiftFood("Robin")>>
			<<if C.npc.Robin.trauma gte 40 || $robin.timer.hurt gte 1>>
				<span class="blue">로빈은 지금 선물을 받을 기분이 아니다.</span>
				<br>
			<<else>>
				<<skinicon "give">><<link [[로빈에게 음식을 준다|Robin Gifts List]]>><</link>>
				<br>
			<</if>>
		<</if>>
		<<robinbully>>
		<<main_hall_icon>><<link [[중앙 홀 (0:01)|Orphanage]]>><<pass 1>><<set $fromRobinRoom to true>><<set $robinhugging to 0>><<endevent>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "robinpay">>
	<<if $robinpaid isnot 1>>
		<i>로빈은 지금은 안전하지만, 베일리는 계속 통행료를 걷으려 들 것이다. 베일리와 직접 맞서야 할지도 모른다.</i>
		<br><br>
	<</if>>
<</widget>>

<<widget "robinhug">>
	<<if $robin.timer.hurt gte 1>>
		로빈은 잠시 당신이 <<him>>【을를】 안고 있게 해주다가, 부드럽게 <<himself>>【을를】 당신에게서 떼어낸다. "미안해." <<he>>【이가】 말한다. "아직 너한테 조금 속상해. 나한테 시간이 좀 필요해."
		<br><br>
	<<else>>
		<<if $daily.robin.hugCry isnot 1 and $robinpaid isnot 1 and $trauma gte ($traumamax / 7) * 2>>
			<<link [[운다 (0:05)|Robin Hug Cry]]>><<pass 5>><<set $daily.robin.hugCry to 1>><<stress -12>><<trauma -6>><<tearup>><<npcincr Robin love 1>><<npcincr Robin dom 1>><</link>><<lstress>><<ltrauma>><<glove>><<gdom>>
			<br>
		<</if>>
		<<if $daily.robin.hugCry isnot 1 and $trauma gte ($traumamax / 7) * 3>>
			<<link [[무너져 내린다 (0:30)|Robin Hug Break]]>><<set $daily.robin.hugCry to 1>><<stress -12>><<stress -12>><<trauma -6>><<trauma -6>><<pass 30>><<tearup>><<npcincr Robin love 1>><<npcincr Robin dom 1>><</link>><<llstress>><<lltrauma>><<glove>><<gdom>>
			<br>
		<</if>>
		<<if $daily.robin.hugComplain isnot 1>>
			<<link [[하소연한다 (0:10)|Robin Hug Complain]]>><<set $daily.robin.hugComplain to 1>><<stress -12>><<trauma -6>><<pass 10>><</link>><<lstress>><<ltrauma>>
			<br>
		<</if>>
		<<if C.npc.Robin.love gte 50>>
			<<link [[껴안고 있는다 (0:10)|Robin Hug Cuddle]]>><<set $robinhugging to 1>><<pass 10>><<npcincr Robin love 1>><<trauma -1>><<stress -1>><</link>><<lstress>><<ltrauma>><<glove>>
			<br>
		<</if>>
		<<if $robinstunned isnot 1 and $robinconsole is 1>>
			<<link [[로빈이 노는 걸 지켜본다 (0:30)|Robin Watch]]>><<set $robinhugging to 1>><<stress -6>><<trauma -3>><<pass 30>><<npcincr Robin love 1>><</link>><<lstress>><<ltrauma>><<glove>>
			<br>
		<</if>>
	<</if>>
	<<link [[껴안기를 멈춘다|Robin Hug Stop]]>><</link>>
	<br>
	<<set $robinstunned to 0>>
<</widget>>

<<widget "robinbully">>
	<<if $trauma gte ($traumamax / 7) * 2 and $daily.robin.hugComplain isnot 1>>
		<<socialiseicon>><<link [[하소연한다 (0:10)|Robin Complain]]>><<set $robinroomentered to 1>><<pass 10>><<set $daily.robin.hugComplain to 1>><<set $phase to 0>><<trauma -6>><<stress -6>><</link>><<ltrauma>><<lstress>>
		<br>
	<</if>>
	<<if $daily.robin.blame isnot 1 and $trauma gte ($traumamax / 7) * 2>>
		<<socialiseicon "angry">><<link [[로빈을 탓한다|Robin Blame]]>><<set $robinroomentered to 1>><<set $phase to 1>><<set $daily.robin.blame to 1>><<trauma -6>><<stress -6>><<npcincr Robin trauma 2>><<npcincr Robin love -1>><<npcincr Robin dom -1>><</link>><<ltrauma>><<lstress>><<grtrauma>><<llove>><<ldom>>
		<br>
	<</if>>
	<<if $daily.robin.persecute isnot 1 and $trauma gte ($traumamax / 7) * 3>>
		<<socialiseicon "angry">><<link [[로빈을 몰아붙인다|Robin Persecute]]>><<set $robinroomentered to 1>><<set $phase to 3>><<set $daily.robin.persecute to 1>><<trauma -12>><<stress -12>><<npcincr Robin trauma 4>><<npcincr Robin love -1>><<npcincr Robin dom -1>><</link>><<lltrauma>><<llstress>><<ggrtrauma>><<llove>><<ldom>>
		<br>
	<</if>>
	<<if $robinmoney gt 0 and !$robinromance>>
		<<highicon>><<link [[돈을 부탁한다|Robin Money]]>><<set $robinroomentered to 1>><</link>>
		<br>
	<</if>>
	<br>
<</widget>>

<<widget "robinOpen">>
	<<if $robin.timer.hurt gte 1>>
		로빈은 문을 활짝 열었다가 당신을 보고 멈칫한다. "들어와." <<he>>【이가】 말하며, 당신이 <<his>> 방으로 들어갈 수 있도록 옆으로 비켜선다. <<hes>> 아직도 <<npcHurt "Robin">>인 게 분명하지만, 적어도 당신과 시간을 보낼 마음은 있는 듯하다.
	<<else>>
		로빈이 문을 활짝 열고 당신을 껴안는다. "들어와." <<he>>【이가】 당신을 안으로 끌어당기며 말한다.
	<</if>>
<</widget>>

<<widget "robinPayout">>
	<<set $robinPayout to 1>>
	문을 두드린다. 로빈은 문을 활짝 열고 당신을 안는다. "들어와." <<he>>【이가】 말하며 당신을 안으로 끌어당긴다. <<He>>【은는】 잠시 <<his>> 서랍을 뒤적이다가 <span class="gold">£<<print $robinmoney>></span>를 당신에게 건넨다.
	<br><br>
	<<money `($robinmoney * 100)` "robin">><<set $robinmoney to 0>>
	<<if $robinPayoutIntro is undefined>>
		<<set $robinPayoutIntro to 0>>
		당신은 돈을 내려다보며 혼란스러워한다. <<He>>【이가】 조심스럽게 당신의 손에 돈을 쥐여주며, 당신의 눈을 똑바로 응시한다. "네가 나를 위해 돈을 내주고 있잖아. 최소한이라도 도우려 하지 않는다면 난 정말 형편없는 <<if $robinromance is 1>><<nnpc_girlfriend "Robin">><<else>>친구<</if>>일 거야."
	<<else>>
		"<<print either(
		"이게 적어도 조금이나마 도움이 됐으면 좋겠어.",
		"베일리가 내가 이제 쓸모없는 짐이라고 계속 상기시켜. 조금 걱정되긴 하지만, 무섭진 않아. 더는.",
		"더 많이 벌어서 널 더 도와줄 수 있으면 좋을 텐데.",
		"넌 어떻게 그렇게 많이 벌어? 나도 너한테 더 유용한 사람이 되고 싶어.",
		"언젠가는 내가 대신 널 위해 돈을 내줄지도 몰라!",
		"난 돈 쓸 데가 별로 없어, 필요한 건 전부 여기 있으니까.<<set _hand to 1>>",
		"정말, 정말 고마워. 네가 있어서 정말 다행이야.",
		"난 항상 비상시를 대비해서 £20를 보관해. 괜찮았으면 좋겠네.",
		"도망가는 거 생각해 본 적 있어? 난 예전에 많이 생각했었는데.",
		"언젠가는 더 이상 돈을 내지 않아도 될 거야. 나쁜 사람들은 항상 자기 죗값을 치르게 되잖아, 그렇지?",
		"이게 내가 가진 전부야, 충분해? 다음 주엔 더 열심히 일할 수 있어!",
		"넌 한 푼이 아깝지 않은 사람이야, 그 이상이고."
		)>>"
				<<if _hand is 1>><<He>>【은는】 당신의 손을 꽉 쥔다. <<takeHandholdingVirginity "Robin" "consensual">><</if>><<npcincr Robin dom 3>><<gdom>>
	<</if>>
	<br><br>
	<<He>>【은는】 텔레비전 옆 침대에 앉아<<if $robinconsole is 1>> 컨트롤러를 집어 든다<<else>> 무언가를 집으려다 잡을 게 아무것도 없다는 걸 곧 깨닫는다. <<him>>의 얼굴에 따분한 기색이 스친다<</if>>.
<</widget>>

<<widget "robinbrothelappear">>
	<<unset $robinBrothel>>
	<<set _robin to statusCheck("Robin")>>
	<<if $robinromance is 1 and (_robin_location is "orphanage" or _robin_location is "sleep") and $fame.prostitution gte 600 and _robin.dom gte 50 and !$weekly.robinBrothel>>
		<<set $robinBrothel to true>>
	<</if>>
<</widget>>

<<widget "robinTraumaMultiplierDecay">>
	<<if $robinTraumaMultiplier gte 0.6>>
		<<set $robinTraumaMultiplier -= 0.1>>
	<</if>>
<</widget>>

<<widget "robinPunishment">>
	<<set _event to _args[0]>>
	<<switch _event>>
		<<case "docks">>
			<<npcincr Robin trauma 30>>
			<<set $robin_injured to 1>>
			<<set $robindebtevent to 7>>
		<<case "dinner">>
			<<set $robindebtevent to 1>>
		<<case "landfill">>
			<<set $robindebtevent to 7>>
		<<case "pillory">>
			<<set $robindebtevent to 30>> <!-- Robin stays imprisoned for up to a month because UFarm might take a while -->
			<<set $robinPillory to {}>>
			<<set $robinPillory.locks to 3>>
			<<set $robinPillory.danger to 0>>
			<<set $robinPillory.distractions to []>>
			<<set $robinPillory.known to false>>
		<<case "mansion">>
			<<npcincr Robin trauma 40>>
			<<set $robindebtevent to 1>>
	<</switch>>
	<<set $robinPunishments.pushUnique(_event)>>
	<<set $robinLastPunishment to _event>>
	<<set $robinmissing to _event>>
	<<set C.npc.Robin.comforted to 0>>
	<<robinTraumaMultiplierDecay>>
<</widget>>

<<widget "robinPilloryHour">>
	<<if $robinPillory.lockpicked is 1>>
		<<set $robinPillory.lockpicked to 0>>
	<</if>>
	<<if Time.hour gte 15 and Time.hour lte 22>>
		<<if Time.dayState is "night">>
			<<set $robinPillory.danger += 3>>
		<<elseif Time.dayState is "dusk">>
			<<set $robinPillory.danger += 2>>
		<<else>>
			<<set $robinPillory.danger += 1>>
		<</if>>
	<<elseif Time.hour gte 23>>
		<<robinPilloryFailure>>
	<</if>>
	<<if $robinPillory.danger lte 3>>
		<<npcincr Robin trauma 1>>
	<<elseif $robinPillory.danger lte 7>>
		<<npcincr Robin trauma 2>>
	<<elseif $robinPillory.danger lte 11>>
		<<npcincr Robin trauma 3>>
	<<else>>
		<<npcincr Robin trauma 4>>
	<</if>>
<</widget>>

<<widget "robinPilloryFailure">>
	<<set $robinmissing to 0>><<set $robinPilloryFail to true>>
	<<if C.npc.Robin.trauma lte 80>>
		<<set C.npc.Robin.trauma to 80>>
	<</if>>
	<<NPCVirginityTakenByOther "Robin" "anal" "pillory">>
	<<if C.npc.Robin.penis isnot "none">>
		<<NPCVirginityTakenByOther "Robin" "penile" "pillory">>
	<</if>>
	<<if C.npc.Robin.vagina isnot "none">>
		<<NPCVirginityTakenByOther "Robin" "vaginal" "pillory">>
	<</if>>
<</widget>>

<<widget "robinRentUnsafeMessage">>
	<<set $rentsale to 0>>
	<i>당신은 <<nnpc_he "Bailey">>【이가】 당신이 제때 <<nnpc_him "Bailey">>에게 돈을 낼 거라고 단순히 기대할 수 없다는 것을 베일리에게 증명했다.
	<span class="red">당신이 베일리를 막아내지 못하면, 로빈은 더 이상 베일리에게서 안전하지 않을 것이다.</span></i>
	<br><br>
<</widget>>

<<widget "lemonade_stand_options">>
	<<if ["helped", "sabotaged"].includes($balloonStand.robin.status) and $balloonStand.robin.talked is false and $robin.timer.customer is 0>>
		<<balloonRobinTalk>>
		<br><br>
		<<link [[로빈에게 진실을 말한다|Balloon Robin Check-In]]>><<endevent>><<set $phase to ("confess_"+$balloonStand.robin.status)>><</link>>
		<br>
		<<link [[침묵한다|Balloon Robin Check-In]]>><<endevent>><<set $phase to ("quiet_"+$balloonStand.robin.status)>><</link>>
	<<else>>
		<<if $money gte 100>>
			<<foodicon "lemonade">><<link [[레모네이드를 산다 (0:15 £1)|Robin's Lemonade Purchase]]>><<endevent>><<stress -6>><<trauma -1>><<pass 15>><</link>><<lstress>><<ltrauma>>
			<br>
		<</if>>
		<<robinicon "lemonade">><<link [[돕겠다고 한다 (0:30)|Robin's Lemonade Help]]>><<endevent>><<npcincr Robin love 1>><<npcincr Robin trauma -1>><<pass 30>><</link>><<glove>><<lrtrauma>>
		<br>
		<<getouticon>><<link [[떠난다|Beach]]>><<endevent>><</link>>
	<</if>>
<</widget>>

<<widget "robinroom_link">>
	<<if C.npc.Robin.init is 1>>
		<<if Time.dayState isnot "night" and $exposed gte 1 and getRobinLocation() is "orphanage">>
			<<if hasSexStat("exhibitionism", 5) and $exposed is 2>>
				<<bedroomicon>><<link [[로빈의 방 (0:01)|Robin Room Naked]]>><<pass 1>><</link>><<exhibitionist5>>
				<br>

			<<elseif hasSexStat("exhibitionism", 4) and $exposed is 1>>
				<<bedroomicon>><<link [[로빈의 방 (0:01)|Robin Room Naked]]>><<pass 1>><</link>><<exhibitionist4>>
				<br>
			<</if>>

		<<elseif $exposed lte 0>>
			<<bedroomicon>><<link [[로빈의 방 (0:01)|Robin's Room Entrance]]>><<pass 1>><</link>>
			<br>

		<</if>>
	<</if>>
<</widget>>

<<widget "popcornEat">>
	<<silently>><<handheldon>><<set $popcorn -=1>><<trauma -6>><</silently>>
<</widget>>

<<widget "popcornSpill">>
	<<if $popcorn gte 1>>
		<<popcornEat>>
		"팝콘을 쏟아서 미안해." 로빈이 미안한 듯 당신을 쳐다본다. "나 정말 기대하고 있었거든, 너도 그랬을 텐데."
		<br><br>
		<<if $speech_attitude is "meek">>
			"괜찮아," 당신이 다정하게 말한다. "진짜 아무렇지도 않아. 팝콘은 언제든 또 먹을 수 있잖아!"
		<<elseif $speech_attitude is "bratty">>
			"에이," 당신이 <<him>>의 팔꿈치를 툭 치며 말한다. "그런 건 신경 안 써. 엎질러진 팝콘을 보고 울어봤자 소용없잖아, 그지?"
		<<else>>
			"야, 괜찮아," 당신이 <<him>>【을를】 격려하듯 미소 지으며 말한다. "그냥 팝콘일 뿐이잖아."
		<</if>>
		<br><br>
		<<He>>【은는】 당신에게 미소 지으며 가볍게 포옹한다. "고마워," <<he>>【은는】 말한다. "네가 최고야."
	<</if>>
<</widget>>

<<widget "robinorphanagekitchen">>
	<<if $daily.robin.orphanageKitchen and Time.hour gte 7 and Time.hour lte 8 and getRobinLocation() is "orphanage" and C.npc.Robin.trauma lte 10>>
		<<unset $daily.robin.orphanageKitchen>>
		<<set $passageRobinKitchen to $passage>>
		<<npc Robin>><<person1>>
		부엌에 들어서자 소란스러운 광경이 눈에 띈다. 로빈은 <<his>> 손에 거품기를 든 채 약간 당황한 표정이다. 고아 세 명이 근처에 서서 <<him>>【와과】 스스럼없이 대화를 나누고 있다.
		<br><br>
		자세히 보니, <<him>>【은는】 "요리사에게 키스를"이라고 쓰인 낡은 앞치마를 두르고 있다.
		<br><br>

		<<link [[돕는다|Robin Orphanage Kitchen Chaos]]>><<set $phase to 0>><<housekeeping 1 400>><</link>><<ghousekeeping 400 "silent">>
		<br>
		<<link [[놀린다|Robin Orphanage Kitchen Chaos]]>><<set $phase to 1>><</link>>
		<br>
		<<if hasSexStat("promiscuity", 2)>>
			<<link [[키스한다|Robin Orphanage Kitchen Chaos]]>><<set $phase to 2>><</link>><<promiscuous2>><<if $robinromance is 1>><<NPCvirginitywarning "Robin" "kiss">><</if>>
			<br>
		<</if>>
		<<link [[무시한다|Robin Orphanage Kitchen Chaos]]>><<set $phase to 3>><</link>>
		<<exitAll>>
	<</if>>
<</widget>>

<<widget "robin_amusements_init">>
	<<set $robin_amusements to {}>>
	<<set $robin_amusements.games to ["claw", "coin", "shooting", "ring", "slot", "dance"]>>
	<<set $robin_amusements.tickets to 0>>
<</widget>>


<<widget "robin_amusements_end">>
	<<unset $robin_amusements>>
<</widget>>

<<widget "robin_amusements_list">>
	<<if $robin_amusements.games.includes("claw")>>
		<<link [[인형뽑기|Robin Amusements Claw]]>><<money -700 "robin">><<pass 15>><<set $robin_amusements.games.delete("claw")>><</link>>
		<br>
	<</if>>
	<<if $robin_amusements.games.includes("coin")>>
		<<link [[코인 푸셔|Robin Amusements Coin]]>><<money -700 "robin">><<pass 15>><<set $robin_amusements.games.delete("coin")>><</link>>
		<br>
	<</if>>
	<<if $robin_amusements.games.includes("shooting")>>
		<<link [[사격장|Robin Amusements Shooting]]>><<money -700 "robin">><<pass 15>><<set $robin_amusements.games.delete("shooting")>><</link>>
		<br>
	<</if>>
	<<if $robin_amusements.games.includes("ring")>>
		<<link [[고리 던지기|Robin Amusements Ring]]>><<money -700 "robin">><<pass 15>><<set $robin_amusements.games.delete("ring")>><</link>>
		<br>
	<</if>>
	<<if $robin_amusements.games.includes("slot")>>
		<<link [[슬롯머신|Robin Amusements Slot]]>><<money -700 "robin">><<pass 15>><<set $robin_amusements.games.delete("slot")>><</link>>
		<br>
	<</if>>
	<<if $robin_amusements.games.includes("dance")>>
		<<link [[댄스 플랫폼|Robin Amusements Dance]]>><<money -700 "robin">><<pass 15>><<set $robin_amusements.games.delete("dance")>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "robin_amusements_end_links">>
	산책로 끝에 다다르자 로빈이 당신을 향해 돌아선다.
	<<if $robin_amusements.slot_win>>
		<<his>> 주머니 속 동전들이 짤랑거린다. "집에 가기 전에 카페에 데려가고 싶어. 이 근처에 좋은 곳이 있거든."
		<br><br>
		<<link [[로빈과 카페에 간다 (0:45)|Robin Amusements Cafe]]>><<pass 45>><<npcincr Robin dom 1>><</link>><<gdom>>
		<br>
		<<link [[로빈에게 돈을 간직하라고 조언한다|Robin Amusements Cafe Refuse]]>><<set $robinmoney += 200>><<npcincr Robin dom -1>><</link>><<ldom>>
		<br>
	<<else>>
		"초대해줘서 고마워." <<he>>【이가】 말한다. "재미있었어."
		<<if $robinromance is 1>>
			<<He>>【은는】 <<his>> 팔로 당신을 감싸고 오래도록 안아준다.<<ltrauma>><<trauma -6>>
		<</if>>
		<br><br>

	<<if $robin_amusements.toy>>
		당신은 고아원으로 걸어 돌아간다,
		<<if $robinromance is 1>>
			손을 잡고
		<</if>>
		당신은 인형 뽑기 기계에서 딴 장난감을 고아들에게 전해주기 위해 잠시 다른 길로 샌다. 로빈도 아이들만큼이나 행복해 보인다.<<ghope>><<hope 1>>
		<br><br>
		로빈의 방은 떠날 때와 그대로다.
		<br><br>
	<<else>>
		당신은 고아원으로 걸어 돌아간다,
		<<if $robinromance is 1>>
			손을 잡고,
		<</if>>
		그리고 <<his>> 방도 떠날 때와 그대로임을 확인한다.
		<br><br>
	<</if>>


		<<link [[다음|Robin Options]]>><<pass 15>><<robin_amusements_end>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "robin_amusements_slots_pull">>
	<<set $robin_amusements.slots to ["starfish", "sea shell", "seagull", "mermaid", "ship", "fish", "squid", "ship", "crab", "wave"]>>
<</widget>>

<<widget "robin_amusements_slots_stop">>
	<<set _symbol to $robin_amusements.slots.pluck()>>
	<<print ({"starfish": "불가사리", "sea shell": "조개껍데기", "seagull": "갈매기", "mermaid": "인어", "ship": "배", "fish": "물고기", "squid": "오징어", "crab": "게", "wave": "파도"})[_symbol] || _symbol>>
<</widget>>

<<widget "robinMemoryHeal">>
	<<if !$robinSeen.includes(_args[0])>>
		<<run $robinSeen.pushUnique(_args[0])>>
		<<npcincr Robin trauma -1>><<lrtrauma>>
	<</if>>
<</widget>>

/* 한글판 전용: 로빈 숲 코스튬 이름(_args[0])을 한글로 출력 */
<<widget "costumeNameKr">><<print ({"witch": "마녀", "vampire": "뱀파이어", "ghost": "유령"})[_args[0]] || _args[0]>><</widget>>
