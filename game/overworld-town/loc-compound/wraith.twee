:: Elk Compound Wraith Give
<<effects>><<wraithPossess>>

<<if C.npc["Ivory Wraith"].lust gt 10 and ($wraith.state is "haunt" or $wraith.offspring is "dead")>>
	<<set $compound.wraith to "accepted">>
	그것이 움직이는지 아닌지 알 수 없지만, 잔상은 여전히 그 주위에 형성된다. 당신은 저항 없이 무릎을 꿇는다.
<<else>>
	<<set $compound.wraith to "willing">><<canvas-model-override "mouth" "neutral">>
	<<if $wraith.seen gte 5>>망설이며, 당신은<<else>>당신은<</if>> 그 형체의 손을 잡고, 그것은 부드럽게 당신의 손을 감싼다. 만지면 차갑다. <<takeHandholdingVirginity "Ivory Wraith" "consensual">>
<</if>>
<br><br>

그 형체는 바닥부터 위로 빠르게 흰 안개로 흩어지기 시작한다. 당신은 입을 벌리고 있다. 아무것도 느낄 수 없다.
<br><br>

<span class="red">안개가 당신의 입으로 스며들어, 온몸이 차갑고 뻣뻣해지는 것을 느낀다.</span> 그 형체는 사라졌다. 당신은 일어서지만, 다리에 감각이 없다.
<br><br>

<span class="nextLink"><<link [[다음|Elk Compound Possessed Intro]]>><</link>></span>

:: Elk Compound Wraith Resist
<<effects>><<set $compound.wraith to "resisted">>

당신은 소용돌이치는 형상들을 마음에서 몰아내려 애쓰며 고개를 돌린다. 창백한 형체가
<<if $wraith.state is "haunt" or $wraith.offspring is "dead">>
	몸을 떤다. "<span class="wraith">하지만, 나는 묻지 않았다.</span>"
<<else>>
	인상을 쓴다. "<span class="wraith">단 한 번만이라도, 머물러 줄 수는 없는가?</span>"
<</if>>
<<initWraith "abomination">><<startWraith>>
"<span class="wraith">어떤 식으로든. 그들을 위해서.</span>"
<br><br>

<<link [[다음|Elk Compound Wraith Fight]]>><<set $molestationstart to 1>><</link>>

:: Elk Compound Wraith Fight
<<effects>>
<<if $struggle_start is 1>>
	<<set $combat to 1>>
	<<controlloss>>
	<<violence 1>>
	<<molested>>
	<<if $player.penisExist>>
		<<set $struggle.penis.creature to "pale slime">><<set $penisuse to "struggle">><<set $penisstate to "struggle">><<set $struggle.enemy[0].location to "penis">>
	<<else>>
		<<set $struggle.vagina.creature to "pale slime">><<set $vaginause to "struggle">><<set $vaginastate to "struggle">><<set $struggle.enemy[0].location to "vagina">>
	<</if>>
	<<unset $struggle_start>>
<<elseif $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<set $enemytype to $wraith.type>>
<</if>>
<<effectsWraith>>

<<switch $wraith.type>>
	<<case "man">>
		<<if _combatend or ($pain gte 100 and $willpowerpain is 0)>>
			<span id="next"><<link [[다음|Elk Compound Wraith Fight Finish]]>><</link>></span><<nexttext>>
		<<else>>
			<span id="next"><<link [[다음|Elk Compound Wraith Fight]]>><</link>></span><<nexttext>>
		<</if>>
	<<case "tentacles">>
		<<if $tentacles.active lte ($tentacles.max / 2)>>
			<span id="next"><<link [[다음|Elk Compound Wraith Fight Finish]]>><</link>></span><<nexttext>>
		<<else>>
			<span id="next"><<link [[다음|Elk Compound Wraith Fight]]>><</link>></span><<nexttext>>
		<</if>>
	<<case "slime">>
		<<if $struggle.done gte $struggle.number>>
			<span id="next"><<link [[다음|Elk Compound Wraith Fight Finish]]>><</link>></span><<nexttext>>
		<<else>>
			<span id="next"><<link [[다음|Elk Compound Wraith Fight]]>><</link>></span><<nexttext>>
		<</if>>
<</switch>>

:: Elk Compound Wraith Fight Finish
<<effects>>
<<if !$wraithCount>>
	<<if $wraith.state isnot "haunt" and !["dead","sold"].includes($wraith.offspring)>>
		<<set $wraithCount to 1>><<set $wraithMax to 1>>
	<<else>>
		<<set $wraithCount to 0>>
		<<set $wraithMax to 3>>
		<<if ["dead","sold"].includes($wraith.offspring)>>
			<<set $wraithMax++>>
		<</if>>
		<<if !$settings.tentaclesEnabled>>
			<<set $wraithMax -->>
		<</if>>
	<</if>>
<</if>>
<<if $enemyhealth lte 0>>
	<<person>>【은는】 뒷걸음질 치며 충격에 빠져 당신을 내려다본다.
	<<if $wraith.gen is "abomination">>
		촉수들이 생명력을 잃고 땅으로 떨어지더니, 분홍빛 안개로 승화한다.
	<<elseif $wraith.gen is "arms">>
		<<His>> 여분의 팔들이 다시 안으로 접힌다.
	<</if>>
	<<His>> 머리가 뒤로 젖혀지고, <<he>>【은는】 당신의 마음속에 메아리치는 짧은 비명과 함께 허공으로 사라진다. 당신의 귀가 울리고, 흐느끼는 소리가 들리는 것 같다. <<He>>【이가】 무언가 말하지만, 알아들을 수 없다.
	<br><br>
	<<tearful>> 당신은 <<he>>【이가】 정말 사라졌는지 확인하기 위해 주위를 둘러본다.
	<<endRainWraith true>>
	<<set $wraith.defeated++>>
	<<clotheson>>
	<<endcombat>><<endWraith>><<clearWraith>>
	<<set $wraithCompoundCooldown to 10>>
	<<set $wraithCompoundChance to 10>>
	<<link [[다음|Elk Compound]]>><</link>>
<<elseif $enemyarousal gte $enemyarousalmax or $pain gte 100 and $willpowerpain is 0 or ($wraith.type is "tentacles" and $tentacles.active lte ($tentacles.max / 2)) or ($wraith.type is "slime" and $struggle.done gte $struggle.number)>>
	<<set $wraithCount++>>
	<<ejacW>>
	<<if $wraithCount gte $wraithMax>>
		<<kissWraith "stress">>
		<br><br>
		<<if $pain gte 100 or $stress gte $stressmax>>
			<<if $pain gte 100>>
				<span class="red">당신은 너무 얻어맞고 멍들어서 저항할 수 없습니다.</span>
			<<else>>
				이것은 당신에게 너무 벅차다. 의식이 희미해지는 것을 느낀다.
			<</if>>
			그 형체는 바닥부터 위로 빠르게 흰 안개로 흩어지기 시작한다. 당신은 입을 벌리고 있다. 아무것도 느낄 수 없다.
			<br><br>
			<span class="red">안개가 당신의 입으로 스며들어, 온몸이 차갑고 뻣뻣해지는 것을 느낀다.</span> 그 형체는 사라졌다. 당신은 일어서지만, 다리에 감각이 없다.
			<br><br>
			<<link [[다음|Elk Compound Possessed Intro]]>><<endWraith>><<clearWraith>><<clotheson>><<endcombat>><<wraithPossess>><</link>>
			<br>
		<<elseif $wraith.state is "haunt" or ["dead","sold"].includes($wraith.offspring)>>
			그 형체가 얼굴을 찌푸린다. "<span class="wraith">나에게서 충분히 빼앗아 가지 않았는가? 다른 방법을 찾겠다.</span>" <<He>>【은는】 말을 끊고 물의 급류 속으로 사라진다.
			<br><br>
			<<tearful>> 당신은 <<he>>【이가】 정말 사라졌는지 확인하기 위해 주위를 둘러본다.
			<<endRainWraith true>>
			<<clotheson>>
			<<endcombat>><<endWraith>><<clearWraith>>
			<<set $wraithCompoundCooldown to 10>>
			<<set $wraithCompoundChance to 10>>
			<<link [[다음|Elk Compound]]>><</link>>
		<<else>>
			그 형체가 인상을 쓴다. "<span class="wraith">돌에서 피를 짜내는 것 같군. 다른 방법을 찾겠다.</span>" <<He>>【은는】 말을 끊고 물의 급류 속으로 사라진다.
			<br><br>
			<<tearful>> 당신은 <<he>>【이가】 정말 사라졌는지 확인하기 위해 주위를 둘러본다.
			<<endRainWraith true>>
			<<clotheson>>
			<<endcombat>><<endWraith>><<clearWraith>>
			<<set $wraithCompoundCooldown to 10>>
			<<set $wraithCompoundChance to 10>>
			<<link [[다음|Elk Compound]]>><</link>>
		<</if>>
	<<else>>
		<<continueWraith>>
		<br><br>
		<<link [[다음|Elk Compound Wraith Fight]]>><</link>>
		<br>
	<</if>>
<</if>>

:: Elk Compound Possessed Intro
<<effects>>
<<set $wraithWillMessage to true>>
<<set $compound.wraithSeen to true>> /* currently unused */
당신은 웅덩이로 <<wraithShamble>> 다가가 당신의 모습을 비춰본다. <<wraithEyes>> 눈을 한 창백한 <<girl>>【이가】 당신을 마주 본다.
<br><br>
당신은 시험하듯 손가락을 하나씩 움직여 본다.
<br><br>
<<if $compound.wraith is "willing">>
	당신의 머리가 옆으로 기울어지며 만족스러운 뚝 소리를 낸다. 당신은 중앙 건물을 응시한다.
	<br><br>
	당신의 입에서 말이 나온다.
	"<span class="wraith">우리는 앞으로 나아간다.</span>" 그것이 당신의 머리를 단호하게 끄덕인다.
<<else>>
	당신의 머리가 빠르게 옆으로 기울어지며 역겨운 우두둑 소리를 낸다. 당신은 중앙 건물을 응시한다.
	<br><br>
	당신의 입에서 말이 나온다.
	"<span class="wraith">나는 앞으로 나아간다.</span>" 그것이 당신의 입술을 비틀어 미소 짓게 만든다.
<</if>>
<br><br>
<span class="nextLink"><<link [[다음|Elk Compound Possessed]]>><</link>></span>
<br>

:: Elk Compound Possessed
<<effects>>

당신은 엘크 가의 단지 안에 있다. 붉은 벽돌 건물 세 채가 철조망으로 둘러싸여 서 있다. 정문은 경비원들이 지키고 있다.
<<if $compound.alarm gte 1>>
	<span class="red">무단 침입 상태입니다.</span>
<</if>>
<br><br>

당신은 중앙 건물 쪽으로 <<wraithShamble>> 다가가 문에 도착한다. 문손잡이를 잡고 당겨보지만, 잠겨 있다.
<br><br>

<<if $compound.wraith is "willing">>
	<<set $lock to 300>>
	<<if currentSkillValue('skulduggery') gte $lock>>
		<<if pcAreArmsBound("both")>>
			자물쇠를 딸 수 있을 것 같지만, <span class="blue">팔이 묶여 있지 않다면 말이다.</span>
			<br>
		<<else>>
			<<wearProp "lockpick">>
			<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span> 당신은 손의 감각을 되찾는다.
			<br><br>
			<<link [[침입한다 (0:05)|Elk Compound Possessed 2]]>><<set $phase to 1>><<pass 5>><</link>>
			<br>
		<</if>>
		<<link [[창백한 형체가 처리하게 둔다|Elk Compound Possessed 2]]>><<set $phase to 2>><</link>><<gtrauma>>
	<<else>>
		<span class="red">자물쇠는 당신의 능력으로는 딸 수 없을 것 같다.</span>
		<<skulduggeryrequired>>
		<br><br>

		창백한 형체는 어쨌든 당신의 목을 가다듬고 앞으로 나아가게 한다. 마치 젤리를 통과하는 것처럼 문을 통과한다. 아주 이상한 감각이다.
		<<trauma 6>><<gtrauma>>
		<br><br>

		<span class="nextLink"><<link [[다음|Elk Compound Possessed 2]]>><<set $phase to 0>><</link>></span>
	<</if>>
<<else>>
	창백한 형체는 어쨌든 당신을 앞으로 나아가게 한다. 마치 젤리를 통과하는 것처럼 문을 통과한다. 아주 이상한 감각이다.
	<<trauma 6>><<gtrauma>>
	<br><br>

	<span class="nextLink"><<link [[다음|Elk Compound Possessed 2]]>><<set $phase to 0>><</link>></span>
<</if>>

:: Elk Compound Possessed 2
<<set $outside to 0>><<effects>>

<<if $phase is 1>>
	당신은 성공적으로 자물쇠를 따고 문을 연다. "<span class="wraith">재빠르군,</span>" 당신의 목소리가 말한다. 설명할 수 없는 만족감이 온몸에 퍼지며 속이 따뜻해지는 기분이다.
	<<stress -6>><<trauma -6>><<lstress>><<ltrauma>>
	<br><br>

	당신이 앞으로 나아가자 그것이 다시 몸의 통제권을 가져간다.
<<elseif $phase is 2>>
	당신이 창백한 형체에게 정신적으로 신호를 보내자, 그것은 당신의 목으로 킥킥 웃으며 통제권을 되찾는다. 당신은 앞으로 나아가, 마치 젤리를 통과하는 것처럼 문을 통과한다. 아주 이상한 감각이다.
	<<trauma 6>><<gtrauma>>
	<br><br>
<</if>>

건물 내부는 거대한 승강기가 차지하고 있다. 작동시킬 방법은 보이지 않지만, 창백한 형체는 신경 쓰지 않는 것 같다. 당신은 승강기 앞에 서서 팔을 흔들자, 안에서 피어오른 안개구름에 의해 승강기 문이 강제로 열린다.
<br><br>

당신은 승강기 안으로 들어서자, 문도 닫히지 않은 채 곧장 아래로 곤두박질친다. 바닥에 닿기 전에 속도가 느려지며,
<<if $compound.wraith is "willing">>
	부드럽게 착지한다.
<<else>>
	완전히 고통 없는 착지를 보장할 만큼은 아니었다.
	<<pain 4>><<gpain>>
<</if>>
<br><br>

당신 앞에는 콘크리트 벽으로 된 복도망이 펼쳐져 있다. 천장에는 형광등이 줄지어 있지만, 대부분은 타버렸고, 노출된 파이프와 전선 주위로 얽혀 있다. 타일 바닥은 여러 군데 금이 가고 더러우며, 보이는 복도 중 하나는 동굴로 직접 이어진다.
<br><br>

<span class="nextLink"><<link [[다음|Elk Compound Possessed 3]]>><</link>></span>

:: Elk Compound Possessed 3
<<effects>><<generate1>><<generate2>><<person1>>

당신은 한 복도에만 시선을 고정한 채 그쪽으로 성큼성큼 걸어간다. 복도를 걷는 사람은 아무도 없다. 인접한 방에 몇몇 과학자들이 있지만, 그들은 당신을 알아채지 못한다.
<br><br>

마침내, 당신은 계속 응시하던 방에 도착하여 조용히 모퉁이를 돈다. 벽에 여러 개의 금속 상자가 쌓여 있고, <<person2>><<person>> 한 명이 상자 하나를 벽 쪽으로 옮기고 있으며, <<person1>><<person>> 한 명이 지켜보고 있다.
<br><br>

"이게 마지막일 거야." <<person>>【이가】 말한다. "조심해서 다뤄. <b>퀸</b> 시장님이 최상의 상태이길 원하시니까."
<<stress 2>><<gstress>>
<br><br>

"<b>퀸</b> 시장님이나 내 엉덩이나 빨라고 해." <<person2>><<person>>【이가】 투덜거린다. "젠장, 이거 진짜 무겁네. 대체 이게 뭔데?"
<<stress 2>><<gstress>>
<br><br>

그들이 퀸의 이름을 말할 때마다, 이질적인 분노가 당신을 스쳐 지나간다. 창백한 형체가 원한을 품고 있는 것 같다.
<br><br>

당신이 방으로 들어서자 경비원들이 당신을 돌아본다. <<person1>><<person>>【은는】 즉시 <<his>> 클립보드를 옆에 두고 <<his>> 엉덩이에 있는 버튼을 누른다. 그러고는 <<person2>><<person>>【와과】 함께 당신을 향해 행진한다.
<br><br>

<<if $compound.wraith is "willing">>
	<span class="nextLink"><<link [[싸운다|Elk Compound Possessed Fight]]>><<set $fightstart to 1>><</link>></span>
<<else>>
	<span class="nextLink"><<link [[놈들을 쓰러뜨린다|Elk Compound Possessed Fight]]>><<set $fightstart to 1>><</link>></span>
<</if>>

:: Elk Compound Possessed Fight
<<if $fightstart is 1>>
	<<set $fightstart to 0>>
	<<neutral 1>>
	<<maninit>>
	<<set $enemytrust -= 100>>
	<<set $enemyanger += 200>>
	<<npcidlegenitals>><<set $noAdmire to true>><<set $noBodyWriting to true>>
	<<if $compound.wraith is "willing">>
		"<span class="wraith">내가 널 돌봐줄게, 내가 저들을 처리해줄게,</span>" 당신의 목소리가 속삭인다.
	<<else>>
		"<span class="wraith">더 깊이, 더 깊이 빠져들어라,</span>" 당신의 목소리가 비웃는다.
	<</if>>
	<<if !$wraith.will>>
		<<set $wraith.will to random(1300, 1700)>>
	<</if>>
	<br><br>
<</if>>

<<effects>>
<<effectsman>><<man>>
<<if _resist gte 1 and $compound.wraith is "willing">>
	<<set $finish to 1>>
	<span class="black">당신의 저항에 창백한 형체로부터 짧은 혼란의 섬광이 느껴진다.</span>
	<br><br>
<<elseif _resist gte 1 and $compound.wraith is "accepted">>
	<<set $compound.wraith to "resisted">>
	<span class="black">당신의 저항에 창백한 형체로부터 짧은 경멸의 섬광이 느껴진다.</span>
	<br><br>
<</if>>
<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend or _controlRegain is 1>>
	<span id="next" class="nextWraith"><<link [[다음|Elk Compound Possessed Fight Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next" class="nextWraith"><<link [[다음|Elk Compound Possessed Fight]]>><</link>></span><<nexttext>>
<</if>>

:: Elk Compound Possessed Fight Finish
<<effects>>
<<if $enemyhealth lte 0>>
	경비원들이 신음하며 바닥에 쓰러진다. 당신은 그들에게서 물러나, 붙잡으려는 <<person1>><<persons>> 팔을 짓밟고 벽에 있는 상자들을 향해 걸어간다.
	<br><br>

	<<endcombat>><<clotheson>>
	<<if $compound.wraith is "willing">>
		<<canvas-model-override "mouth" "smile">>
	<</if>>

	<span class="nextLink"><<link [[다음|Elk Compound Possessed Creatures]]>><<endevent>><<set $pain to 0>><</link>></span><<nexttext>>
<<elseif $enemyarousal gte $enemyarousalmax>>
	<<ejaculation "short">>

	경비원들이 신음하며 바닥에 쓰러진다. 당신은 그들에게서 물러나, 붙잡으려는 <<person1>><<persons>> 팔을 짓밟고 벽에 있는 상자들을 향해 걸어간다.
	<br><br>

	<<endcombat>><<clotheson>>
	<<if $compound.wraith is "willing">>
		<<canvas-model-override "mouth" "smile">>
	<</if>>

	<span class="nextLink"><<link [[다음|Elk Compound Possessed Creatures]]>><<endevent>><<set $pain to 0>><</link>></span><<nexttext>>
<<elseif $finish is 1>>
	<<wraithExorcise true true>>
	당신은 뒤로 비틀거리자, 창백한 형체가 당신의 가슴을 통해 몸 밖으로 빠져나온다. "<span class="wraith">아마도 다른 접근법이 필요하겠군.</span> <span class="tentacle">둘로서, 하나처럼-</span>"
	<br><br>

	"저게 대체 뭐야?!" <<person2>><<person>>【이가】 비명을 지르며, 허둥지둥 도망치려다 거의 넘어질 뻔한다. "저거... 저게... 저게 <<pher>> 가슴에서 나왔어! 너도 봤지!"
	<br><br>

	"그래, 봤어." <<person1>><<person>>【이가】 눈을 굴리며 말한다. "시장이 이것에 대해 말해줬어. 저 망할 것들 근처에 있으면 헛것이 보일 거라고. 그냥 무시해." <<he>>【은는】 상자를 향해 엄지를 치켜든다.
	<br><br>

	"말은 쉽지!" 창백한 형체가 사악하게 웃으며 <<him>> 주위를 맴돌자 <<person2>><<person>>【이가】 비명을 지른다. <<person1>><<person>>【은는】 한숨을 쉬고 <<his>> 파트너의 비명을 무시한 채 당신에게 다가온다.
	<br><br>

	<<saveNPC 0 "compound_guard">>
	<<endcombat>>
	<<loadNPC 0 "compound_guard">><<clearNPC "compound_guard">>

	<<link [[다음|Elk Compound No Longer Possessed Fight]]>><<set $fightstart to 1>><</link>>
<<else>>
	<<wraithExorcise true true>>
	<span class="gold">당신은 멈춘다.</span> 당신은 그것이 계속 나아가라고, 계속 싸우라고 당신을 밀어붙이는 것을 느낄 수 있지만, 당신은 발뒤꿈치를 땅에 박고 집중한다. 당신은 몸을 되찾았고, 포기할 생각이 없다. 당신이 싸움을 멈추자 경비원들이 혼란스럽게 당신을 쳐다본다.
	<br><br>

	당신은 고통에 몸을 구부린다. 그것은 자신이 졌다는 것을 알고 당신에게서 빠져나가고 있다. 당신의 가슴에서 한 쌍의 창백하고 반투명한 팔이 튀어나오는 것을 본다. 엄청난 노력 끝에, 그것은 당신에게서 자신을 방출한다.
	<br><br>

	그것의 머리가 뒤로 젖혀지고, 당신의 마음속에 울리는 짧고 분노에 찬 으르렁거림과 함께 허공으로 사라진다. 당신의 귀가 울리고, 사방에서 그것의 목소리가 들린다. "<span class="wraith">거의 다 왔는데, 네가 칼날을 비트는구나. 이 얼마나 잔인한가.</span>" 경비원들은 충격에 휩싸여 당신을 보며 비틀거리며 물러선다. <<tearful>> 당신은 복도로 달려가고, 경비원들은 당신을 쫓아온다.
	<br><br>

	당신은 그들이 당신에게 닿기 전에 간신히 승강기에 도착하고, 문은 자동으로 닫힌다. 그들은 문을 두드리지만, 당신이 위로 올라가면서 두드리는 소리는 점점 조용해진다. 마침내 소리가 멈추고, 당신은 문 밖으로 달려나가 단지로 돌아간다.
	<br><br>

	<<endcombat>><<clotheson>>
	<<set $wraithCompoundCooldown to 10>>
	<<set $wraithCompoundChance to 10>>

	<<link [[다음|Elk Compound]]>><<unset $compound.wraith>><<endRainWraith>><<endWraith>><<clearWraith>><<set $compound.alarm += 5>><<set $eventskip to 1>><</link>>
<</if>>

