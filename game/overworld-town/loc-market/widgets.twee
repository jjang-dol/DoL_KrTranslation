			<<connudatusicon>><<link [[떠난다|Connudatus Street]]>><<endevent>><<endstall>><<clotheson>><</link>>
			<br>
		<<elseif _inventory_in_stall isnot 1>>
			진열할 물건이 없으니 가판대를 지킬 이유가 별로 없다.
			<br><br>
			<<icon "project-maths.png">><<link [[가판대 관리|Stall Manage]]>><</link>>
			<br>
			<<connudatusicon>><<link [[떠난다|Connudatus Street]]>><<endevent>><<endstall>><<clotheson>><</link>>
			<br>
		<<else>>

			<<He>>【은는】 돌아선다.
			<br><br>

			<<stall_trust>>
			<br><br>

			<<if $stall_seduced is 0>>
               <<link [[추파를 던져 <<him>>【을를】 다시 유혹한다 (0:05)|Stall Seduce]]>><<pass 5>><</link>><<promiscuous1>><<glust>>
				<br>
			<<elseif $stall_seduced is 1>>
               <<link [[몸매를 과시하여 <<him>>【을를】 다시 유혹한다 (0:05)|Stall Seduce]]>><<pass 5>><</link>><<exhibitionist1>><<glust>>
				<br>
			<<elseif $stall_seduced is 2 and hasSexStat("promiscuity", 2)>>
               <<link [[키스로 <<him>>【을를】 다시 유혹한다 (0:05)|Stall Seduce]]>><<pass 5>><</link>><<promiscuous2>><<glust>>
				<br>
           <<elseif $stall_seduced is 3 and $worn.lower.type.includes("naked")>>
				<<if $worn.under_lower.type.includes("naked") and hasSexStat("exhibitionism", 3)>>
                   <<link [[속옷을 입지 않은 것을 보여주며 <<him>>【을를】 다시 유혹한다 (0:05)|Stall Seduce]]>><<pass 5>><</link>><<exhibitionist3>><<gglust>>
					<br>
				<<elseif !$worn.under_lower.type.includes("naked") and hasSexStat("exhibitionism", 2)>>
                   <<link [[속옷을 입지 않았다는 걸 보여주며 <<him>>【을를】 다시 유혹한다 (0:05)|Stall Seduce]]>><<pass 5>><</link>><<exhibitionist2>><<glust>>
					<br>
				<</if>>
           <<elseif $stall_seduced is 4 and $worn.lower.type.includes("naked") and $worn.under_lower.type.includes("naked") and hasSexStat("exhibitionism", 4)>>
               <<link [[더 잘 보이게 해 주며 <<him>>【을를】 다시 유혹한다 (0:05)|Stall Seduce]]>><<pass 5>><</link>><<exhibitionist4>><<gglust>>
                   <br>
			<</if>>

           <<link [[<<him>>【을를】 보내준다|Stall]]>><<endevent>><<endstall>><</link>>
			<br>
			<<link [[가판대를 떠난다|Connudatus Street]]>><<endevent>><<endstall>><<set $eventskip to 1>><<clotheson>><</link>>
			<br>
		<</if>>
	<<elseif $enemytrust gte -50>>
		<<set $enemytrust -= 10>>
		<<person1>><<person>>【이가】 흥정하려 든다.
		<br><br>

		<<stall_trust>>
		<br><br>

		<<link [[물러서지 않는다|Stall Sell]]>><</link>><<note "(<<printmoney `$stall_cost * $stall_amount`>>)" "gold">>
		<br>
		<<link [[가격을 낮춰준다|Stall Sell]]>><<set $stall_cost *= 0.8>><<set $enemytrust += 20>><</link>><<note "(<<printmoney `$stall_cost * $stall_amount * 0.8`>>)" "gold">><<gtrust>>
		<br>
		<<link [[가격을 올린다|Stall Sell]]>><<set $enemytrust -= 20>><<set $stall_cost *= 1.2>><</link>><<note "(<<printmoney `$stall_cost * $stall_amount * 1.2`>>)" "gold">><<ltrust>>
		<br>
	<<else>>
		<<person1>><<person>>【은는】 비웃으며 떠났다.
		<br><br>

		<<stall_actions>>

	<</if>>
<</widget>>

<<widget "stall_init">>
	<<set $stall_foodstuff to $foodstuff_inventory.random()>>
	<<set $enemytrust to 0>>
	<<set $enemyarousal to 0>>
	<<set $stall_seduced to 0>>
	<<stall_update>>
<</widget>>

<<widget "stall_update">>
   <<set _stall_multiplier to Math.max(1,Math.pow(2,Math.max(0,$stall_seduced-2)))>>
   /* Range of 2-5 becomes 1-8, for a gentle exponential scaling */
	<<if setup.foodstuff[$stall_foodstuff].shop.stall_size is "large">>
       <<set $stall_amount to random(1,2 * _stall_multiplier)>>
	<<elseif setup.foodstuff[$stall_foodstuff].shop.stall_size is "small">>
       <<set $stall_amount to random(25 * _stall_multiplier, 75 * _stall_multiplier)>>
	<<else>>
		<<if $stall_seduced lte 1>>
			<<set $stall_amount to random(1, 10)>>
		<<else>>
			<<set $stall_amount to random(5 * _stall_multiplier, 15 * _stall_multiplier)>>
			/* At most 120 products in one unlikely sale. Averages are (5,10,20,40,80) */
		<</if>>
	<</if>>
	<<if $stall_amount gte $foodstuff[$stall_foodstuff].amount>>
		<<set $stall_amount to clone($foodstuff[$stall_foodstuff].amount)>>
	<</if>>
	<<set $stall_cost to Math.round(clone(setup.foodstuff[$stall_foodstuff].shop.sell_price))>>
<</widget>>

<<widget "stall_amount">>
	<<if $stall_amount is 1>>
		<<set _text_output to "한 ">>
	<<else>>
		<<number $stall_amount silent>>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "stall_check_text">><<silently>>
	<<set $_examines to ["살펴본다","들어 올린다","집어 든다","냄새를 맡는다"].pluck()>>
	<<switch $stall_foodstuff>>
		<<case "blood_lemon" "bottle_of_breast_milk" "baby_bottle_of_breast_milk" "bottle_of_semen" "strange_flower" "wolfshroom">>
			<<if $_examines is "sniffs">>
				<<set $_reacts to " 그러다 얼굴을 붉힌다">>
			<<else>>
				<<set $_reacts to "">>
			<</if>>
		<<case "apple" "banana" "cabbage" "orange" "peach" "pear" "plum" "strawberry">>
			<<if $_examines is "examines">>
				<<set $_reacts to " 멍든 곳이 있는지">>
			<<elseif ["lifts","picks up"].includes($_examines)>>
				<<set $_reacts to " 멍든 곳이 있는지 확인하려고">>
			<<else>>
				<<set $_reacts to "">>
			<</if>>
		<<case "chicken_egg" "bird_egg">>
			<<if $_examines is "sniffs">>
				<<set $_examines to "examines">>
				<<set $_reacts to " 금 간 곳이 있는지">>
			<<elseif $_examines is "examines">>
				<<set $_reacts to " 금 간 곳이 있는지">>
			<<elseif ["lifts","picks up"].includes($_examines)>>
				<<set $_reacts to " 금 간 곳이 있는지 확인하려고">>
			<</if>>
		<<default>>
			<<set $_reacts to "">>
	<</switch>>

	<<set _text_output to "한 개의 <span class='green'>" + (setup.foodstuff[$stall_foodstuff].name) + "</span>【을를】 " + $_examines + $_reacts>>
<</silently>><<print _text_output>><</widget>>

<<widget "stallCustomerArousal">>
	<<set $enemyarousal += 10*random(1,2)*random(1,2)>>
	/*
	25% +10 arousal
	50% +20 arousal
	25% +40 arousal
	*/
<</widget>>

<<widget "stall_autosale">>
	/* 1/3 no sale, 1/3 normal sale, 1/3 double sale. Averages to 1 sale. */
	<<silently>><<stall_inventory>><</silently>>
	<<stall_init>>

	<<if Math.min(10000,3000 + $attractiveness/2 + $fame.business + (currentSkillValue('tending') * 2) + (Math.min($foodstuff_inventory.length,10) * 500)) gte random(1, 15000)>>
		/* No sale in 1/3 of the cases. */
		<<set _stall_attention to 2>>
		<<set $stall_foodstuff to $foodstuff_inventory.random()>>

		/* Decide between 1 item, doubled amount, or 2 different items. */
		<<if random(1, 2) is 2>>
			<<if random(1, 2) is 2>>
				<<set $stall_seduced to 2>>  /* Doubles the amount sold. */
			<<else>>
				/* Try to sell two different products */
				<<if $foodstuff_inventory.length gte 2>>
					<<set $_food2 to $foodstuff_inventory.filter(item => item !== $stall_foodstuff).random()>>
				<<else>>
					<<set $stall_seduced to 2>>  /* Not enough variety. */
				<</if>>
			<</if>>
		<</if>>

		<<stall_update>>
		<<generate1>><<person1>>


		<<silently>><<stall_sell>><</silently>>
		<<person>>【이가】
		<<if $stall_amount gte 2>>
			<span class="green"><<print window.KR.getFoodstuffCountKr($stall_foodstuff, $stall_amount)>></span>
		<<else>>
			<span class="green"><<print setup.foodstuff[$stall_foodstuff].name>> 하나</span>
		<</if>>
		【을를】
		<<if $_food2 is undefined>>
			<<printmoney `$stall_cost * $stall_amount`>>에 구매한다.
		<<else>>
			<<printmoney `$stall_cost * $stall_amount`>>에, 그리고
			<<set $stall_foodstuff to $_food2>>
			<<stall_update>>
			<<silently>><<stall_sell>><</silently>>
			<<if $stall_amount gte 2>>
				<span class="green"><<print window.KR.getFoodstuffCountKr($stall_foodstuff, $stall_amount)>></span>
			<<else>>
				<span class="green"><<print setup.foodstuff[$stall_foodstuff].name>> 하나</span>
			<</if>>
			【을를】 <<printmoney `$stall_cost * $stall_amount`>>에 구매한다.
		<</if>>
		<br>

		<<set $stall_seduced to 0>>
		<<endstall>>
		<<silently>><<stall_inventory>><</silently>>
		<<famebusiness 1>>
		<<endevent>>
	<</if>>
<</widget>>

<<widget "marketStockDisplay">>
	<div id="marketStockDisplay" class="food_ui no-numberify">
		<div id="body">
			<div id="mainSection">
				<div id="search">
					검색:
					<<textbox "_marketSearch" "">>
					<<run $(() => {
						var marketTimer = null;
						$('#textbox--marketsearch').on('input change keypress', e => {
							_marketSearch = e.target.value;
							clearTimeout(marketTimer);
							marketTimer = setTimeout(updateUI, 300);
						});
						var updateUI = () => {
							Wikifier.wikifyEval('<<replace "#itemList">><<marketStockDisplayItems>><</replace>>');
						}
					})>>
				</div>
				<div id="itemList">
					<<marketStockDisplayItems>>
				</div>
			</div>
			<div id="altSection" class="mobileHidden">
				<<if $lastRecipeViewed and setup.foodstuff[$lastRecipeViewed]>>
					<<marketStockDisplayItemDetail $lastRecipeViewed>>
				<</if>>
			</div>
			<div id="mobileCloser" class="mobileOnly mobileHidden" onclick="wikifier('addclass', '#altSection', 'mobileHidden'); wikifier('addclass', '#mobileCloser', 'mobileHidden');"></div>
		</div>
	</div>
	<br>
<</widget>>

<<widget "marketStockDisplayItems">>
	<<marketFilter>>
	<<set _groupNameMap to {
		"ingredient": "재료",
		"sweets": "디저트",
		"savouries": "요리",
		"drinks": "음료",
		"produce": "농산물",
		"meat": "고기",
		"seafood": "해산물",
		"vegetable": "채소",
		"fruit": "과일",
		"mushroom": "버섯",
		"flower": "꽃",
		"dish": "요리",
		"materials": "재료"
	}>>
	<<for _category range _marketGroups>>
		<<if !_marketKeys.find(key => key.group is _category)>><<continue>><</if>>
		<<set _categoryVar to "_" + _category.replace(" ", "")>>
		<<foldout false _categoryVar>>
			<span class="gold"><<print _groupNameMap[_category] || _category.toLocaleUpperFirst()>></span>
			<<set _filteredItems to _marketKeys.filter(key => key.group is _category)>>
			<div class="text-align-center">
				<<if _filteredItems.length gt 1>>
					모두 선택:
					<<capture _filteredItems>>
						<<link "끄기">>
							<<run _filteredItems.forEach(key => {
								let control = $(`#${key.key} input`)[0];
								if (control) {
									control.checked = false;
									$foodstuff[key.key].marketStall = false;
								}
							})>>
						<</link>> |
						<<link "켬">>
							<<run _filteredItems.forEach(key => {
								let control = $(`#${key.key} input`)[0];
								if (control) {
									control.checked = true;
									$foodstuff[key.key].marketStall = true;
								}
							})>>
						<</link>>
					<</capture>>
				<</if>>
			</div>
			<<for $_i, $_keyObject range _filteredItems>>
				<div @id="$_keyObject.key" class="item"><<marketStockDisplayItem $_keyObject.key>></div>
				<<if $_i < _filteredItems.length - 1>><hr><</if>>
			<</for>>
		<</foldout>>
	<</for>>
<</widget>>

<<widget "marketStockDisplayItem">>
	<<set $_setupItem to setup.foodstuff[_args[0]]>>
	<div class="details">
		<div>
			<<foodstufficon _args[0]>> <<recipe_name _args[0] "cap">> |
			보유 중: <span class="gold"><<print $foodstuff[_args[0]].amount>></span> |
			가치: <<printmoney `$_setupItem.shop.sell_price`>> |
			총계: <<printmoney `$_setupItem.shop.sell_price * $foodstuff[_args[0]].amount`>>
			<br>
			<<set $_variable to `$foodstuff['${_args[0]}'].marketStall`>>
			<label>가판대에 진열됨: <<checkbox $_variable false true autocheck>></label>
		</div>
	</div>
	<div class="recipe">
		<<capture _args[0]>>
			<<if $options.images is 1>>
				<<set _file to setup.foodstuff[_args[0]].kitchen_item_type_icon>>
				<<link "<<iconUi _file>>">>
					<<replace "#altSection">><<marketStockDisplayItemDetail _args[0]>><</replace>>
					<<removeclass "#altSection, #mobileCloser" "mobileHidden">>
				<</link>>
			<<else>>
				<<link "상세">>
					<<replace "#altSection">><<marketStockDisplayItemDetail _args[0]>><</replace>>
					<<removeclass "#altSection, #mobileCloser" "mobileHidden">>
				<</link>>
			<</if>>
		<</capture>>
	</div>
<</widget>>

<<widget "marketStockDisplayItemDetail">>
	<<set $lastRecipeViewed to _args[0]>>
	<<set $_setupItem to setup.foodstuff[_args[0]]>>
	<div id="basket">
		<div>
		<<foodstufficon _args[0]>>
			<div class="recipeTitle"><<recipe_name _args[0] "cap">>:</div>
		</div>
		<div class="mobileOnly">
			<<link "닫기">>
				<<addclass "#altSection, #mobileCloser" "mobileHidden">>
			<</link>>
		</div>
	</div>
	<div id="basketItems">
		<<if setup.foodstuff[_args[0]].recipe?.ingredients.length gt 0>>
			<div id="requiredForRecipe">
				<<requiredForRecipe _args[0]>>
			</div>
		<</if>>
		<<knownFoodRecipes _args[0]>>
	</div>
<</widget>>
