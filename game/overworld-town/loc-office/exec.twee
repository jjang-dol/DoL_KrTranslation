			<br><br>
			<<link [[다음|Office Executive Work]]>><</link>>
		<</if>>
	<<case 2>>
		<<outfitChecks>>
		<<danceStripActionObject>>
		<<if $worn.upper.name isnot "naked">>
			<<if _middleOutfit>>
				<<set _statRequired to _danceExhibition.middleOutfit[0]>>
