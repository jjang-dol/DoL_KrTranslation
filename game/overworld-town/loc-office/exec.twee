				<<lowerruined>>
			<<case "top">>
				<<upperruined>>
			<<case "skirt">>
				<<lowerruined>>
			<<case "underclothes">>
				<<underupperruined>>
				<<underlowerruined>>
			<<case "bra">>
				<<underupperruined>>
			<<case "panties">>
				<<underlowerruined>>
			<<case "shoes">>
