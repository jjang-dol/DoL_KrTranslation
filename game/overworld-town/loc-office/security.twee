	<span id="next"><<link [[다음|Office Security Spank Finish]]>><</link>></span><<nexttext>>
<<elseif $enemyarousal gte $enemyarousalmax>>
	<span id="next"><<link [[다음|Office Security Spank Finish]]>><</link>></span><<nexttext>>
