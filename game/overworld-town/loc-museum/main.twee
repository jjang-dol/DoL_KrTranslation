<<widget "museumtalk">>
    <<museumAntiqueText>><<museumPaintingText>>
    /* Prevent having to "sell" a worn chastity belt for £0 */
    <<if $museumAntiques.antiques.antiquegoldchastitybelt is "found" and $worn.genitals.origin is "Underwater Temple" and $gold_chastity_held isnot true>>
        <<museumAntiqueStatus "antiquegoldchastitybelt" "talk">>
    <</if>>
    <<for _labelM, _valueM range $museumAntiques.antiques>>
        <<capture _labelM, _museumAntiqueText[_labelM].key>>
            <<set _antique to _museumAntiqueText[_labelM].name.toLowerCase()>>
            <<if $museumAntiques.antiques[_labelM] is "talk">>
                <<icon _museumAntiqueText[_labelM].icon>>
                <<link [[_antique에 대해 물어본다|`Museum `+ _museumAntiqueText[_labelM].key]]>><<set $museumAntiques.antiques[_labelM] to "museum">><<set $museumAntiques.museumCount++>><<npcincr Winter love 1>><</link>><<glove "Winter" "simple">>
                <br>
            <</if>>
        <</capture>>
    <</for>>
    <<if !$daily.winterStoryTime>>
        <<if $bleedingWardCheckpoint and $museumAntiques.paintings.paintingward is "museum">>
            <<icon _museumPaintingText.paintingward.icon>><<link [[윈터에게 중단했던 '피 흘리는 병동' 이야기를 마저 들려달라고 부탁한다 (0:15)|Bleeding Ward Resume]]>><<set $daily.winterStoryTime to true>><</link>>
            <br>
        <</if>>
        <<for _labelP, _valueP range $museumAntiques.paintings>>
            <<capture _labelP, _museumPaintingText[_labelP].key>>
                <<if $museumAntiques.paintings[_labelP] is "talk">>
                    <<set _painting to _museumPaintingText[_labelP].journalName.toLowerCase()>>
                    <<icon _museumPaintingText[_labelP].icon>>
                    <<link [[`_painting【을를】 물어본다 (0:30)`|`Museum `+ _museumPaintingText[_labelP].key + ` Story`]]>><<set $daily.winterStoryTime to true>><<npcincr Winter love 3>><</link>><<gglove "Winter" "simple">>
                    <<if _labelP is "paintingsnake">><<note "긴 이야기가 될 것입니다..." "red">> | <span class="red tooltip-anchor" tooltip="<span class='red'>이 장면에는 신체 훼손을 포함해 다른 곳에서는 볼 수 없는 불쾌한 콘텐츠가 포함되어 있습니다. 이는 어떤 토글이나 설정으로도 막을 수 없습니다. 경고했습니다.</span>\"><i>(!콘텐츠 경고!)</i></span><</if>> <!-- Appears even with blind stats enabled. Intentional -->
                    <br>
                <<elseif $museumAntiques.paintings[_labelP] is "museum">>
                    <<set _painting to "'" + _museumPaintingText[_labelP].name + "'">>
                    <<icon _museumPaintingText[_labelP].icon>>
                    <<link [[`윈터에게 _painting 이야기를 다시 들려달라고 부탁한다 (0:30)`|`Museum `+ _museumPaintingText[_labelP].key + ` Story`]]>><<set $daily.winterStoryTime to true>><</link>>
                    <<if _labelP is "paintingsnake">><<note "긴 이야기가 될 것입니다..." "red">> | <span class="red tooltip-anchor" tooltip="<span class='red'>이 장면에는 신체 훼손을 포함해 다른 곳에서는 볼 수 없는 불쾌한 콘텐츠가 포함되어 있습니다. 이는 어떤 토글이나 설정으로도 막을 수 없습니다. 경고했습니다.</span>\"><i>(!콘텐츠 경고!)</i></span><</if>> <!-- Appears even with blind stats enabled. Intentional -->
                    <br>
                <</if>>
            <</capture>>
        <</for>>
    <</if>>
<</widget>>

:: Museum Lock
<<set $outside to 1>><<set $location to "museum">><<effects>>

박물관은 닫혀 있다. 표지판에 이렇게 쓰여 있다.
<<if $town_projects.diving is 3>>
	"현장 작업으로 인해 임시 휴관합니다. 호수에 있는 제 현장 사무실로 연락 주세요."
<<else>>
	"주말 개관:	<<ampm 9 00>> - <<ampm 18 00>>"
<</if>>
<br><br>

<<oxfordicon>><<link [[떠난다|Oxford Street]]>><</link>>
<br>

:: Museum
<<set $outside to 0>><<set $location to "museum">><<effects>>

<<if $museumintro isnot 1 and $passagePrev is "Oxford Street">>
	<<set $museumintro to 1>><<set $phase to 0>>

	<<npc Winter>><<person1>>당신은 어두컴컴한 박물관으로 들어선다. 높은 천장 바로 아래에 있는 작은 창문들은 어둠을 거의 걷어내지 못한다. 다른 방들도 별반 다르지 않다.
	<br><br>

	윈터가 놋쇠 냄비를 닦으며 서 있다. <<He>>【은는】 당신을 똑바로 쳐다본다. "아무것도 만지지 마십시오." <<he>>【이가】 말한다. "손은 씻지 않으셨을 것 같군요."
	<br><br>

	<<link [[분개하며 대답한다|Museum Intro]]>><<def 1>><<set $phase to 0>><</link>>
	<br>
	<<link [[고분고분하게 대답한다|Museum Intro]]>><<sub 1>><<set $phase to 1>><<npcincr Winter love 1>><</link>><<glove>>
	<br>
	<<link [[유혹적으로 대답한다|Museum Intro]]>><<set $phase to 2>><<npcincr Winter love -1>><</link>><<promiscuous1>><<llove>>
	<br>
<<elseif $bell_timer lte 0 and $passagePrev is "Oxford Street">>
	<<unset $bell_timer>>
	<<if $worn.feet.type.includes("shackle")>>
		당신이 문을 열자 두건을 쓴 인물이 난입한다. 당신은 $worn.feet.name에 걸려 넘어지고, 둘은 함께 바닥으로 굴러떨어진다. 그 인물은 벌떡 일어서지만 고통에 찬 비명을 지르더니, 다리를 절며 서둘러 달아난다. 당신이 정신을 차렸을 때, 그 인물은 이미 사라지고 없었다.
	<<else>>
		당신이 문을 열자 두건을 쓴 인물이 난입해, 당신을 거의 보도블록으로 넘어뜨릴 뻔한다. 당신이 정신을 차렸을 때, 그 인물은 이미 사라지고 없었다.
	<</if>>
	<br><br>
	<<npc Winter>><<person1>>
	당신은 박물관에 들어서자, <span class="red">바닥에 쓰러져 있는 윈터를 발견한다.</span> <<His>> 눈은 감겨 있다. 받침대에서 떨어진 골동품들이 바닥에 널브러져 있다. 가죽 지도는 여전히 벽에 걸려 있지만, 크게 찢어져 있다.
	<br><br>

	당신이 다가가자 윈터가 기침을 한다. "예의라고는 없군요." <<he>>【이가】 간신히 말하며 <<his>> 눈을 뜬다. "괜찮을 겁니다. 그냥 늙어서 그런 겁니다. 당신이 오는 소리를 듣고 놈들이 놀란 겁니다. 종을 움켜쥐고 달아났습니다. 더 많은 걸 원했던 것 같습니다만."
	<br><br>
	<<link [[윈터 곁에 머문다|Museum Attack Stay]]>><<museumAntiqueStatus "antiquebell" "stolen">><<npcincr Winter love 1>><<npcincr Winter dom -5>><<world_corruption "hard" 2>><</link>><<lldom>><<glove>>
	<br>
	<<link [[범인을 쫓는다|Museum Attack]]>><</link>>
	<br>
<<elseif $museumhorseintro is undefined and $museumAntiques.museumCount gte 10 and $passagePrev is "Oxford Street">>
	<<set $museumhorseintro to 0>>
	<<npc Winter>><<person1>>당신은 어두컴컴한 박물관으로 들어선다. 윈터가 전시대 위에 홀로 놓인 놋쇠 냄비를 쳐다보고 있다. "어디에 둬야 할지 모르겠군요." <<he>>【이가】 한숨을 쉰다. <<He>>【은는】 당신을 알아본다. "당신이 오길 바라고 있었습니다. 이미 많은 도움을 주셨으니, 부탁 하나만 더 드리고 싶습니다." <<He>>【은는】 방구석으로 걸어간다. 그곳에는 더러운 천 아래에 커다란 무언가가 숨겨져 있다. <<He>>【이가】 천을 잡아당기자 나무로 된 말이 드러난다.
	<br><br>

	"진품입니다." <<he>>【이가】 만족스럽게 말한다. "상태도 좋군요."
	<br><br>

	<<if $awareness gte 200>>
		"고문 기구잖아요." 당신이 말한다.
		<br><br>

		"놀랍군." <<he>>【이가】 대답한다. "정확해. 희생자를 위에 앉히고, 무게를 실어 가랑이에 압력을 가했지. 종종 동시에 채찍질을 당하기도 했고."
	<<else>>
		"무엇에 쓰는 건가요?" 당신이 묻는다.
		<br><br>

		"고문용이지." <<he>>【이가】 대답한다. "현대의 물건들은... 다른 용도로 존재하지만. 희생자를 위에 앉히고, 무게를 실어 가랑이에 압력을 가했지. 종종 동시에 채찍질을 당하기도 했고."
	<</if>>
	<br><br>
	<<He>>【은는】 말 위에 손을 얹는다. "사람들이 역사에 관심을 갖게 하려고 시연을 해볼까 해." <<He>>【은는】 당신을 바라본다. "억지로 시키고 싶진 않지만, 네 도움이 필요해. 한번 생각해 봐."
	<br><br>

	<<link [[다음|Museum]]>><<endevent>><</link>>
	<br>
<<elseif $museumduckintro is undefined and $museumAntiques.museumCount gte 20 and $passagePrev is "Oxford Street">>
	<<set $museumduckintro to 0>>
	<<npc Winter>><<generate2>><<person2>>당신은 어두컴컴한 박물관으로 들어선다. 한 <<person>>【이가】 당신을 스쳐 지나간다.
	<br><br>
	<<person1>>
	"마침 잘 오셨군요." 윈터가 짙은 갈색 나무 의자에서 고개를 들며 말한다. "흥미로운 <<person2>><<gentleman_npc>>【와과】 이야기를 나누고 있었습니다. 들어오는 길에 <<him>>【을를】 마주치셨을지도 모르겠군요."<<person1>>
	<br><br>

	<<person1>>윈터가 <<him>> 옆에 있는 의자에 손가락을 올려놓는다. "기증품을 하나 받았습니다. 꽤 특별한 물건이죠."
	<br><br>

	<<if $awareness gte 300>>
		당신은 더 가까이 다가가 본다. 의자 뒤쪽에는 무언가에 묶기 위한 것처럼 보이는 고리가 달려 있다. "물고문 의자군요." 당신이 말한다. "사람들을 물속에 넣어 질식시키는 데 사용했죠."
		<br><br>

		"정말 인상적이군요." <<he>>【이가】 대답한다. "정확합니다. 의자를 일종의... 기중기에 묶었습니다. 그러고는 희생자를 강에 담갔죠. 경우에 따라 치명적일 수도 있었습니다."
	<<else>>
		"무엇에 쓰는 건가요?" 당신이 묻는다.
		<br><br>

		"처벌용입니다." <<he>>【이가】 대답한다. "물고문 의자라고 불리죠. 뒤에 이 고리가 보이십니까? 희생자를 의자에 묶은 채로 기중기에 매달았습니다. 그러고는 물속에 넣어 질식시켰죠. 치명적일 수도 있었습니다."
	<</if>>
	<br><br>
	"대중 앞에서 시연해보고 싶습니다." <<he>>【이가】 말을 잇는다. "나머지 장비를 제공해 줄 사람을 찾았고, 근처에 강도 있습니다. 억지로 시키려는 건 아니지만, 당신의 도움이 필요합니다. 한번 생각해 보십시오."
	<br><br>

	<<link [[다음|Museum]]>><<endevent>><</link>>
	<br>
<<elseif $museumfamoushorseintro is undefined and $museum_horse_success and ((fameSum('business', 'good', 'social', 'model')/8000) gte 0.25) and $passagePrev is "Oxford Street">>
	<<set $museumfamoushorseintro to 0>>
	<<npc Winter>><<person1>>당신은 박물관에 들어선다. 윈터는 몇몇 방문객과 이야기를 나누다가 당신과 눈이 마주치자 재빨리 달려온다. "박물관에 예전보다 훨씬 많은 사람이 오고 있습니다. 당신의 시연이 많은 관심을 끌었거든요!" <<he>>【이가】 말한다. "이제 입장료를 받아도 될 것 같습니다. 당신이 괜찮으시다면, 이걸 더 큰 행사로 만들고 싶습니다. 마을 사람들을 교육하는 좋은 기회가 될 겁니다. 물론 수익의 일부는 당신에게 드리겠습니다. 잠시 생각해보고 알려주십시오."
	<br><br>
	윈터는 고전 연극 가면을 구경하는 다른 손님 무리로 이동하며, 당신에게 선택지를 고려할 시간을 준다.
	<br><br>
	<<link [[다음|Museum]]>><<endevent>><</link>>
<<else>>
	당신은 박물관 안에 있다. 역사적 가치가 있는 물건들이 벽을 덮고 받침대 위에 놓여 있다.
	<<if $museuminterest gte 100>>
		방문객들이 건물에 가득 차 흥미롭게 골동품들을 살펴보고 있다. 윈터는 과로한 듯 보이지만 만족스러워 보인다.
	<<elseif $museuminterest gte 60>>
		건물은 골동품을 구경하러 온 방문객들로 가득하다.
	<<elseif $museuminterest gte 20>>
		몇몇 다른 방문객들이 전시품을 살펴보고 있다.
	<<else>>
		건물 안에는 당신 외에 다른 방문객이 없다.
	<</if>>
	<br><br>
	<<if $arousal gte $arousalmax>>
		<<orgasmLocation "museum">>
	<</if>>

	<<if $museumhorseintro is 0>>
		<<museumicon "horse">><<link [[나무 말 시연에 동의한다|Museum Horse Agree]]>><<set $museumhorseintro to 1>><</link>>
		<br>
	<<elseif $museumhorseintro is 1 and $museumhorse isnot 1>>
		<<museumicon "horse">><<link [[나무 말 시연하기 (1:00)|Museum Horse]]>><<pass 60>><<set $museumhorse to 1>><</link>><<gpain>><<exhibitionist1>>
		<br>
	<</if>>
	<<if $museumfamoushorseintro is 0 and $museumhorse isnot 1>>
		<<museumicon "horse">><<link [[유료 나무 말 시연에 동의한다|Museum Famous Horse Agree]]>><<set $museumfamoushorseintro to 1>><</link>>
		<br>
	<<elseif $museumfamoushorseintro is 1 and $museumhorse isnot 1>>
		<<museumicon "horse">><<link [[돈을 받고 나무 말 시연하기 (1:30)|Museum Famous Horse]]>><<set $museumhorse to 1>><</link>><<gpain>><<exhibitionist1>>
		<br>
	<</if>>
	<<if $museumduckintro is 0>>
		<<museumicon "duck">><<link [[물고문 의자 시연에 동의한다|Museum Duck Agree]]>><<set $museumduckintro to 1>><</link>>
		<br>
	<<elseif $museumduckintro is 1 and $museumduck isnot 1>>
