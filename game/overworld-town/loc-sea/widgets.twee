:: Widgets Events Sea [widget]
<<widget "eventsseabeach">>
	<<if Time.dayState isnot "night" and !Weather.isOvercast>>
		<<if $rng gte 96>>
			<<sea1>>
		<<elseif $rng gte 81>>
			<<seabeach1>>
		<<elseif $rng gte 61>>
			<<sea5>>
		<<elseif $rng gte 36>>
			<<seatangle>>
		<<else>>
			<<sea2>>
		<</if>>
	<<elseif Time.dayState isnot "night" and Weather.precipitation isnot "none">>
		<<if $rng gte 96>>
			<<sea1>>
		<<elseif $rng gte 81>>
			<<seabeach2>>
		<<elseif $rng gte 71>>
			<<searape>>
		<<elseif $rng gte 51>>
			<<sea5>>
		<<elseif $rng gte 36>>
			<<seatangle>>
		<<else>>
			<<sea2>>
		<</if>>

	<<elseif Time.dayState isnot "night">>

		<<if $rng gte 81>>
			<<sea1>>
		<<elseif $rng gte 71>>
			<<searape>>
		<<elseif $rng gte 51>>
			<<sea5>>
		<<elseif $rng gte 36>>
			<<seatangle>>
		<<else>>
			<<sea2>>
		<</if>>

	<<else>>

		<<if $rng gte 96>>
			<<if $settings.swarmsEnabled>><<sea3>><<else>><<sea1>><</if>>
		<<elseif $rng gte 81>>
			<<sea1>>
		<<elseif $rng gte 61>>
			<<sea5>>
		<<else>>
			<<sea2>>
		<</if>>

	<</if>>
<</widget>>

<<widget "eventssea">>
	<<set _dangerevent to random(1, 100)>>
	<<if _dangerevent lte 10>>
		<<if $settings.swarmsEnabled>>
			<<sea3>>
		<<else>>
			<<sea1>>
		<</if>>
	<<elseif _dangerevent lte 20>>
		<<sea1>>
	<<elseif _dangerevent lte 30>>
		<<searape>>
	<<elseif _dangerevent lte 50>>
		<<sea5>>
	<<elseif _dangerevent lte 60>>
		<<seatangle>>
	<<elseif _dangerevent lte 80>>
		<<sea2>>
	<<elseif _dangerevent lte 100>>
		<<sea7>>
	<</if>>
<</widget>>

<<widget "eventsdeepsea">>
	<<set _dangerevent to random(1, 96)>>
	<<if _dangerevent lte 10>>
		<<if $settings.swarmsEnabled>>
			<<sea3>>
		<<else>>
			<<sea1>>
		<</if>>
	<<elseif _dangerevent lte 20>>
		<<sea1>>
	<<elseif _dangerevent lte 30>>
		<<sea4>>
	<<elseif _dangerevent lte 40>>
		<<seavore>>
	<<elseif _dangerevent lte 50>>
		<<sea5>>
	<<elseif _dangerevent lte 60>>
		<<seatentacles>>
	<<elseif _dangerevent lte 70>>
		<<sea6>>
	<<elseif _dangerevent lte 80>>
		<<seaflotsam>>
	<<elseif _dangerevent lte 86>>
		<<sea_hairwrap>>
	<<elseif _dangerevent lte 90>>
		<<sea_struggle>>
	<<elseif _dangerevent lte 91>>
		<<sea_eye>>
	<<elseif _dangerevent lte 96>>
		<<sea_chest>>
	<</if>>
<</widget>>

:: Widgets Sea [widget]
<<widget "seabeach1">>
	<<generate1>><<person1>><<person>> 하나가 당신에게 헤엄쳐 와 엉덩이를 움켜쥔다.
	<<outfitChecks>>
	<<if _bottomless>>
		여기 아래엔 아무것도 안 입었네? 정말 음란한 <<girl>>【이】군.
	<<else>>
		"안녕, 예쁜 <<girl>>.
	<</if>>
	우리 좀 재밌게 놀아볼까?" <<He>>【은는】 점점 더 열정적으로 당신을 애무하기 시작한다.
	<br><br>

	<<if hasSexStat("promiscuity", 4)>>
		<<link [[동의한다|Sea Beach Molestation]]>><<set $sexstart to 1>><</link>><<promiscuous4>>
	<<else>>
		<<insufficientStat "promiscuity" "이대로 계속 허락하기엔">>
	<</if>>
	<br>

	<<if random(1,5) is 1>> /* 20% change of being raped if you refuse */
		<<link [[몸을 뺀다|Sea Beach Molestation]]>><<set $molestationstart to 1>><</link>>
	<<else>>
		<<link [[몸을 뺀다|Sea Beach Molestation Finish]]>><<set $finish to 1>><</link>>
	<</if>>
	<br>
<</widget>>

<<widget "seabeach2">>
	<<rng>>
	커다란 파도가 당신을 향해 다가온다. 그러나 파도가 닿기 전에, 서핑보드를 탄 <<generate1>><<person1>><<person>>【이가】 스쳐 지나가며 당신을 물에서 낚아챈다. <<He>>【은는】 한 손으로 당신의 팔을 누르고, 다른 손으로 입을 틀어막는다.
	<br><br>

	<<link [[다음|Sea Beach Molestation]]>><<set $molestationstart to 1>><<set $phase to 1>><</link>>
<</widget>>

<<widget "sea1">>
	<<beastNEWinit 3 dolphin>>
	<<rng>>
	<<if $rng gte 81 and ($monster is 1 or $settings.bestialityEnabled)>>
		세 마리의 <<beastsplural>>【이가】 당신에게 헤엄쳐 와 장난스럽게 몸을 민다. 당신도 쓰다듬어 주지만, 그것들은 끈질기다. 한 마리가 당신에게 몸을 비비기 시작하고, 다른 둘은 당신이 벗어나지 못하게 막는다.
		<br><br>

		<<link [[다음|Sea Dolphins]]>><<set $molestationstart to 1>><</link>>
		<br>
	<<elseif $rng gte 26 and numberOfEarSlime() and ($monster is 1 or $settings.bestialityEnabled) and ($earSlime.growth gte 80 - ($earSlime.deviancy * 10))>>
		세 마리의 <<beastsplural>>【이가】 당신에게 헤엄쳐 와 장난스럽게 당신을 툭 친다. 당신도 그들을 쓰다듬어 준다.
		<br><br>

		<span class="lewd">머릿속의 슬라임이 <<if $exposed lt 2>>옷을 벗고 <</if>>그들에게 몸을 드러내라고 명령하는 것이 느껴진다.</span> 따르면 보상을 주겠다고 약속하고, 거부하면 대가가 있을 거라고 위협한다.
		<br><br>

		<<if hasSexStat("deviancy", 4) and $submissive gte 1900>>
			<<link [[순순히 받아들인다|Sea Slime Dolphins Submit willingly]]>><<corruption 3>><<pain -8>><<stress -12>><<trauma -24>><<sub 2>><</link>><<deviant4>><<ggcorruption>><<llpain>><<llltrauma>><<llstress>>
			<br>
		<</if>>
		<<link [[복종한다|Sea Slime Dolphins Obey]]>><<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 1>><</link>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
		<br>
		<<link [[반항한다|Sea Slime Dolphins Defy]]>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>><</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
		<br>
	<<else>>
		세 마리의 <<beastsplural>>【이가】 당신에게 헤엄쳐 와 장난스럽게 당신을 툭 친다. 당신도 그들을 쓰다듬어 준다.
		<<lstress>><<ltrauma>><<stress -12>><<trauma -6>>
		<br><br>

		<<if hasSexStat("deviancy", 3) and ($monster is 1 or $settings.bestialityEnabled)>>
			<<link [[음란하게 쓰다듬는다|Sea Dolphins Sex]]>><<set $sexstart to 1>><</link>><<deviant3>>
			<br>
		<</if>>

		<<destinationeventend>>
	<</if>>
<</widget>>

<<widget "sea2">>
	<<rng>>
	큰 파도가 당신을 향해 밀려온다.

	<<if $uncladtest isnot 1>> /* unused. This outcome always happens */
		당신은 파도에 휩쓸려 위로 빨려 올라갔다가, 반대편으로 떠내려온다. 재미있었다!<<lstress>><<stress -6>>
	<<else>>
		당신은 파도에 휩쓸려 위로 빨려 올라간다. 그 힘에 옷이 손에서 찢겨 나간다!

		<<if $rng gte 81>>
			파도가 지나간 뒤 사라진 옷을 찾아 주위를 둘러보지만, 어디에도 보이지 않는다. 옷을 잃어버리자 자신의 <<nudity>>【이가】 훨씬 더 의식된다.<<print _nudityExtra>>
			<<garousal>><<gstress>><<arousal 600>><<stress 6>>
			<<set $unclad to 0>> /* unused */
			<<if $uncladoutfit is 1>><<set $uncladoutfit to 0>>
				<<upperruined>><<lowerruined>>
			<</if>>
			<<if $uncladupper is 1>><<set $uncladupper to 0>>
				<<upperruined>>
			<</if>>
			<<if $uncladlower is 1>><<set $uncladlower to 0>>
				<<lowerruined>>
			<</if>>
			<<if $uncladunder is 1>><<set $uncladunder to 0>>
				<<underruined>>
			<</if>>
			<<handheldruined>>
		<<else>>
			파도가 지나간 뒤 사라진 옷을 찾아 주위를 둘러보다가, 멀지 않은 곳에 떠 있는 것을 발견한다. 당신은 그쪽으로 헤엄쳐 가고, 옷을 되찾고 나서야 안도한다.
		<</if>>
	<</if>>
	<br><br>
	<<destinationeventend>>
<</widget>>

<<widget "sea3">>
	<<rng>>
	다리에 무언가가 스치는 것이 느껴진다. 내려다보니 범인은 장어다. 더 많은 장어들이 몰려와 당신 주위를 빙글빙글 돌며, 미끈한 애무로 역겨움과 수치스러운 감각을 동시에 부추긴다. 떼 지은 장어들이 당신 아래 깊은 곳에서 솟아오르고 있다. 주위를 둘러보니 그리 멀지 않은 곳에 부표가 보인다. 저기까지 헤엄쳐 갈 수 있다면, 안전한 곳으로 올라갈 수 있을 것이다.
	<br><br>

	<<link [[다음|Sea Eels]]>><<set $molestationstart to 1>><</link>>
<</widget>>

<<widget "sea4">>
	<<generate1>><<generate2>>
	어선 한 척이 당신을 향해 방향을 틀어 다가온다. 그물이 당신을 감싸고, 당신은 갑판 위로 끌어올려진다.
	<br><br>
	<<fullGroup>>【이가】 당신을 내려다보며 미소 짓는다. "활기찬 녀석을 잡았군." <<person1>><<person>>【이가】 말한다.
	<br><br>

	<<link [[다음|Boat Molestation]]>><<set $molestationstart to 1>><</link>>
	<br>
<</widget>>

<<widget "sea5">>
	<<if $settings.bestialityEnabled>>
		<<if $squidcount is 0>>

			당신의 <<genitals>>에 부드러운 것이 닿는 느낌이 든다. 물 아래를 보니 작은 오징어가 촉수로 당신을 문지르고 있다.
			<<garousal>><<arousal 600 "genitals">>
			<br>

		<<elseif $squidcount is 1>>

			당신의 <<breasts>>에 부드러운 것이 닿는 느낌이 든다. 물 아래를 보니 작은 오징어가 촉수로 당신을 문지르고 있다.
			<<garousal>><<arousal 600 "breasts">>
			<br>

		<<elseif $squidcount is 2>>

			당신의 <<breasts>>에 부드러운 것이 닿는 느낌이 든다. 물 아래를 보니 작은 오징어가 촉수로 당신을 문지르고 있다.
			<<garousal>><<arousal 600 "breasts">>
			<br>

		<<elseif $squidcount is 3>>

			당신의 <<bottom>>에 부드러운 것이 닿는 느낌이 든다. 물 아래를 보니 작은 오징어가 촉수로 당신을 문지르고 있다.
			<<garousal>><<arousal 600 "bottom">>
			<br>

		<<else>>

			당신의 피부에 부드러운 것이 닿는 느낌이 든다. 물 아래를 보니 작은 오징어가 촉수로 당신을 문지르고 있다.
			<<garousal>><<arousal 600>>
			<br>

		<</if>>
		<br>
		<<link [[계속하게 둔다|Sea Squid]]>><</link>><<deviant1>>
		<br>
		<<link [[떼어낸다|Sea Pull]]>><</link>>
		<br>

	<<else>>
		<<sea2>>
	<</if>>
<</widget>>

<<widget "sea6">>
	어선 한 척이 지나간다. 배에 탄 아무도 당신을 알아채지 못한다.
	<br><br>
	어쩌면 그들이 해안으로 가는 것을 도와줄 수도 있을 것이다.
	<br><br>
	<<link [[도움을 요청한다|Sea Boat Call]]>><</link>>
	<br>
	<<link [[무시한다|Sea Boat Ignore]]>><</link>>
	<br>
<</widget>>

<<widget "seavore">>
	<<if $settings.voreEnabled>>
		<<set $rng to random(1,4)>>
		<<if $rng lte 2>>
			당신의 냄새에 이끌린 거대한 생물체가 깊은 곳에서 나타난다. 미처 그것이 거기에 있다는 걸 알아차리기도 전에, 그것은 커다란 입으로 당신의 다리를 꽉 붙잡는다.
			<br><br>
			<<link [[다음|Sea Vore]]>><<set $molestationstart to 1>><<set $vorecreature to "whale">><</link>>
		<<else>>
			물속을 움직일 때, 무언가가 당신의 다리를 꽉 문다. 몸을 비틀어 돌아보니, 당신을 통째로 삼키려는 거대한 굴이 있다!
			<br><br>
			<<link [[다음|Sea Vore]]>><<set $molestationstart to 1>><<set $vorecreature to "oyster">><</link>>
		<</if>>
	<<else>>
		<<sea1>>
	<</if>>
<</widget>>

<<widget "seatangle">>
	<<if !$worn.lower.type.includes("naked")>>
		허리에 해초가 얽힌다. 먼저 <<bottoms>>【을를】 벗으면 풀어내기 더 쉬울 것이다. 주위에는 아무도 없고...
		<br><br>
		<<link [[옷을 벗는다|Sea Tangle Undress]]>><</link>><<exhibitionist1>>
		<br>
		<<link [[옷을 벗지 않는다 (0:01)|Sea Tangle]]>><<pass 1>><<stress 6>><</link>><<gstress>>
		<br>
	<<else>>
		당신의 허리가 해초에 얽힌다. 몸을 빼내는 데 1분이 걸린다.
		<<pass 1>><<stress 1>><<gstress>>
		<br><br>
		<<destinationeventend>>
		<br><br>
	<</if>>
<</widget>>

<<widget "searape">>
	<<generate1>><<person1>><<npcClothesType $NPCList[0] "beachDive">>
	무언가가 당신의 발목을 단단히 잡고 물 아래로 끌어당긴다. 잠수 마스크를 쓴 <<person>>【이가】 탁한 물속에서 솟아오른다.
	<br><br>

	<<link [[다음|Sea Rape]]>><<set $molestationstart to 1>><</link>>
	<br>
<</widget>>

<<widget "seatentacles">>
	<<if $settings.tentaclesEnabled and $hallucinations gte 2>>
		무언가가 다리를 스치더니, 허리를 붙잡는다. 여러 촉수가 물속에서 솟아오른다.
		<br><br>

		<<link [[다음|Sea Tentacles]]>><<set $molestationstart to 1>><</link>>
		<br>
	<<else>>
		<<seavore>>
	<</if>>
<</widget>>

<<widget "seaflotsam">>
	해초로 뒤덮인 나무와 잔해가 떠다닌다. 그 안에서 무언가 반짝이는 것이 보이는 것 같다.
	<br><br>

	<<link [[손을 넣는다|Sea Flotsam Reach]]>><</link>>
	<br>
	<<link [[무시한다|Sea Flotsam Ignore]]>><</link>>
	<br>
<</widget>>

<<widget "sea_struggle">>
	<<if $settings.bestialityEnabled>>
		무언가가 당신의 다리를 감싸는 느낌이 든다. 물 아래를 들여다보니, 수많은 촉수가 보인다.
		<br><br>

		<<link [[다음|Sea Struggle]]>><<set $struggle_start to 1>><</link>>
		<br>
	<<else>>
		<<seaflotsam>>
	<</if>>
<</widget>>

<<widget "sea_eye">>
	<<if $hallucinations gte 2>>
		아래에서 누군가 당신을 지켜보는 느낌이 든다. 당신은 갑작스러운 공포에 휩싸인다.<<gstress>><<stress 6>>
		<br><br>

		<<link [[아래를 내려다본다|Sea Eye]]>><<awareness 1>><<stress 6>><</link>><<gstress>><<gawareness>>
		<br>
		<<link [[보지 않는다|Sea Eye Refuse]]>><</link>>
		<br>
	<<else>>
		<<seaflotsam>>
	<</if>>
<</widget>>

<<widget "sea_chest">>
	파도 꼭대기에 오르자 해초로 뒤덮인 바위 무리가 나타난다. 바닷물에 닳아 매끄러워진 바위들이다.
	<br><br>

	<<link [[조사한다 (0:10)|Sea Chest]]>><<pass 10>><</link>><<swimmingdifficulty 1 1000>>
	<br>
	<<link [[무시한다|Sea]]>><<set $eventskip to 1>><</link>>
	<br>
<</widget>>

<<widget "sea7">>
	<<generatey1>><<generatey2>><<person1>>
	<<person>> 한 명과 <<person2>><<person>> 한 명이 근처에서 물장구를 치고 있다. 해변에서 헤엄쳐 나온 게 틀림없다. 그들은 당신을 향해 고개를 돌리고, 서로 미소를 지으며 더 가까이 헤엄쳐 온다.
	<<if $exposed gte 1>>
		<span class="lewd">물속에 잠긴 자신의 <<lewdness>>【이가】 의식된다.</span> 숨어 있을 수 있을지도 모른다.
	<</if>>
	<br><br>

	<<link [[인사한다|Sea Pair Greet]]>><</link>>
	<br>
	<<link [[헤엄쳐 달아난다|Sea Pair Swim]]>><</link>><<swimmingdifficulty 1 1000>>
	<br>
<</widget>>

<<widget "sea_hairwrap">>
    <<if $hairlength gte 1000 and $hallucinations gte 2>>
        무언가 당신 주위를 미끄러지며 다가오는 것이 느껴진다. 그것은 천천히 당신의 다리와 팔, 그리고 목을 차례로 휘감아 움직임을 억제한다.
        <br><br>
        아래를 내려다보자 <<print $haircolour>> 해초 같은 촉수들이 똬리를 틀어 당신을 옭아매고 있다.
        <br><br>

        <<link [[집중한다|Sea Hair Wrap]]>><<set $phase to "focus">><</link>><<willpowerdifficulty 400 1000>>
        <br>
        <<link [[발버둥 친다|Sea Hair Wrap]]>><<set $phase to "struggle">><<trauma 6>><<stress 6>><</link>><<gtrauma>><<gstress>>
        <br>
    <<else>>
        <<seaflotsam>>
    <</if>>
<</widget>>

<<widget "passoutsea">>
	<<if isPregnancyEnding()>>
		<<pregnancyPassout "sea">>
	<<else>>
		<<link [[모든 것이 어둠에 잠긴다...|Passout Sea]]>><</link>>
	<</if>>
<</widget>>

:: Widgets Sea Beach [widget]
<<widget "seabeach">>
