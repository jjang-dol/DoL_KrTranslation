:: Men's Toilets
<<set $outside to 0>><<set $location to "park">><<effects>><<set $bus to "parkmens">>

당신은 공원 남자 화장실에 있다.
<<storeon "parkmens" "check">>
<<if _store_check is 1>>
    당신의 옷은 세면대 아래에 보관되어 있다.
<</if>>
<br><br>

<<if $stress gte $stressmax>>
    <<passoutpark>>
<<else>>

        <<if dangerEvent() and $player.gender_appearance is "f" and $eventskip is 0>>
            <<eventstoilets>>
        <<else>>
            <<storeactions "parkmens">>
            <<if hasSexStat("exhibitionism", 5) and Time.dayState is "day" and $exposed gte 2 and !$daily.parkStreak>>
                <span class="lewd">화장실에 벌거벗고 서 있으니, 공원을 알몸으로 질주하고 싶은 음란한 충동이 든다. 정말 많은 사람이 당신을 볼 것이다.</span>
                <br><br>
                <<ind>><<link [[알몸으로 달리기|Park Streak]]>><<set $daily.parkStreak to true>><<pass 1>><<arousal 100>><</link>><<exhibitionist5>><<garousal>>
                <br>
            <<elseif hasSexStat("exhibitionism", 4)>>
                <span class="lewd">음란한 생각이 떠오른다.</span> 옷을 벗고 화장실 칸 중 하나에서 순진한 행인이 당신을 보기를 기다릴 수 있다.
                <<if Time.dayState is "dusk" or Time.dayState is "night">>
                    <br><br>
                    <<skinicon "strip">><<link [[옷 벗고 칸에서 기다리기 (0:20)|Toilets Stall]]>><<pass 20>><</link>><<exhibitionist4>>
                    <br>
                <<else>>
                    <span class="blue">하지만, 밤이 될 때까지 기다리는 것이 가장 좋을거같다.</span>
                    <br><br>
                <</if>>
            <</if>>
            <<mirroricon>><<link [[거울 보기 (0:02)|Simple Mirror]]>><<pass 2>><<set $previousPassage = $passage>><</link>>
            <br>
            <<if hasSexStat("exhibitionism", 3) or $arousal gte 9000>>
                <<skinicon "masturbate">><<link [[자위하기|Men's Toilets Masturbation]]>><<set $masturbationstart to 1>><</link>>
                <br>
            <</if>>
            <<if setup.bodyliquid.combined("face") gte 1 or $skin.left_cheek.pen is "pen" or $skin.right_cheek.pen is "pen" or $skin.forehead.pen is "pen" or $skin.left_cheek.pen is "mud" or $skin.right_cheek.pen is "mud" or $skin.forehead.pen is "mud" or $skin.left_cheek.pen is "lipstick" or $skin.right_cheek.pen is "lipstick" or $skin.forehead.pen is "lipstick">>
                <<bathroomicon "sink">><<link [[얼굴 씻기 (0:05)|Men's Toilets Wash]]>><<pass 5>><</link>>
                <br>
            <</if>>
            <<if setup.bodyliquid.combined("mouth") gte 1>>
                <<bathroomicon "sink">><<link [[입 헹구기 (0:05)|Men's Toilets Rinse]]>><<pass 5>><</link>>
                <br>
            <</if>>
            <<pregnancyTest "Men's Toilets">>
            <<storeon "parkmens" "check">>
            <<if _store_check isnot 1>>
                <<getouticon>><<link [[나가기|Park]]>><</link>>
            <<elseif $exposed gte 2 and hasSexStat("exhibitionism", 3)>>
                <<sneakicon>><<link [[몰래 나가기|Park Toilets Sneak]]>><<set $phase to 2>><</link>><<exhibitionist3>>
            <<elseif $exposed is 1>>
                <<sneakicon>><<link [[몰래 나가기|Park Toilets Sneak]]>><<set $phase to 1>><</link>><<exhibitionist1>>
            <<elseif $exposed lte 0>>
                <<getouticon>><<link [[나가기|Park]]>><</link>>
            <</if>>
        <</if>>
<</if>>

<<set $eventskip to 0>>
<<storecleanup>>

:: Men's Toilets Wash
<<effects>>

<<if setup.bodyliquid.combined("face") gte 1>>
    <<if $skin.left_cheek.pen is "pen" or $skin.right_cheek.pen is "pen" or $skin.forehead.pen is "pen">>
        세면대에 몸을 숙여, 얼굴에서 음란한 액체와 잉크를 씻어낸다.
