:: Balloon Stand [exitCheckBypass]
<<clearsinglenpc 0>><<loadNPC 0 "stall_owner">><<person1>>

<div id="clothingShop-div" class="main-shop-div">
	<<stallShop-main>>
</div>

:: Balloon Purchase
<<effects>>
<<if $balloonStand.owner is "angry" and ["hot drink","cold drink"].includes($phase)>>
	<<person>>【은는】 한숨을 쉬기 전 한참 동안 당신을 바라본다. "물론이죠." <<he>>【이가】 체념한 듯 말한다. "저기, 냉정을 잃어서 미안해요. 도와주겠다고 약속해놓고 제 음료를 팔기 시작한 건 좀 비겁한 짓이었죠. 하지만 솔직히 말해서, 당신도 절 가게 해주겠다고 약속해놓고 절 아프게 했잖아요. 그래도 화내는 건 싫어요. 우리 괜찮은 거 맞죠?"
	<br><br>
	<<He>>의 말에도 일리가 있다. 당신은 고개를 끄덕인다. "괜찮아요."
	<<set $balloonStand.owner to "appeased">>
<<else>>
	<<set _sir to $player.gender_appearance is 'f' ? '아가씨' : '도련님'>>
	"<<print $balloonStand.owner is "angry" ? "네, 뭐든지요." : either("물론이죠,", "바로 준비해 드리겠습니다, _sir,", "물론이죠,", "바로 나옵니다,", "물론입니다!")>>" <<person>>【이가】 말한다.
<</if>>
<br><br>
<<switch $phase>>
	<<case "popcorn">>
		<<He>>【이가】 갓 튀긴 팝콘을 퍼 담는다. <<he>>【이가】 건네줄 때 봉지는 아직 따뜻하다.
		<<set $daily.ex.popcorn to ($daily.ex.popcorn or 0) + 1>>
		<<wearProp "popcorn">>

		<<if $daily.ex.popcorn is 2 and $balloonStand.owner isnot "angry">>
			"배가 많이 고프신가 봐요." <<he>>【이가】 말한다. <<print playerBellyVisible() ? `"두 사람 몫을 먹는 셈이네요." <<He>>【은는】 당신의 부른 배를 다정하게 흘긋 보며 미소 짓는다.` : `"집에서 충분히 못 먹고 있나요?" <<His>> 눈썹이 잠시 찌푸려지지만, <<he>>【은는】 곧 털어낸다.`>>
		<<elseif $daily.ex.popcorn is 3>>
			"다른 손님들을 위해 남겨둬야 하니, 이번까지만 드릴게요." <<print $balloonStand.owner is "angry" ? "<<His>> 목소리는 퉁명스럽다" : "<<He>>【은는】 미안한 듯 미소를 짓는다">>.
		<</if>>
	<<default>>
		<<set $daily.ex.balloonDrink to ($daily.ex.balloonDrink or 0) + 1>>
		<<switch $phase2>>
			<<case "hotcocoa">>
				<<wearProp "travel cup">>
			<<case "strawberrylemonade">>
				<<wearProp "strawberry lemonade">>
			<<case "hotcider">>
				<<wearProp "travel cup cider">>
			<<default>>
				<<wearProp "lemonade">>
		<</switch>>

		<<if $phase is "cold drink">>
			<<He>>【은는】 당신에게 얼음처럼 차가운 <<seasonal_beverage>> 한 잔을 따라준다. 플라스틱 컵이 손안에서 후끈거린다.
		<<else>>
			<<He>>【은는】 당신에게 김이 나는 <<seasonal_beverage>> 한 잔을 따라준다. 종이컵이 손을 따뜻하게 해준다.
		<</if>>

		<<if $daily.ex.balloonDrink is 2>>
			"목마르셨군요?" <<he>>【이가】 말한다. "<<print playerBellyVisible() ? "그 작은 아이에게도 수분을 공급해야 하니까요" : "수분 보충을 잘하시는 걸 보니 다행이네요">>." <<He>>【이가】 당신에게 미소 짓는다.
		<<elseif $daily.ex.balloonDrink is 3>>
			"다른 손님들을 위해 남겨둬야 하니, 이번까지만 드릴게요." <<He>>【은는】 미안한 듯 미소를 짓는다.
		<</if>>
<</switch>>
"<<print $balloonStand.owner is "angry" ? "자. 꺼져." : either("또 뵙네요, 손님.", "남은 하루도 즐겁게 보내세요.", "이용해 주셔서 감사합니다.", "맛있게 드세요!")>>"
<br><br>
<<switch $phase>>
	<<case "popcorn">>
		<<link [[팝콘을 먹는다 (0:15)|Balloon Consume]]>><<set $phase to $balloonStand.robin.status is "help needed" ? "ask_eat" : "popcorn">><<trauma -3>><</link>><<ltrauma>><br>
		<<if $balloonStand.robin.status is "help needed">>
			<<link [[나중에 먹기 위해 챙겨둔다|Balloon Consume]]>><<set $phase to "ask">> <<set $popcorn += 1>><</link>><br>
		<<else>>
			<<link [[나중에 먹기 위해 챙겨둔다|Beach]]>><<set $eventskip to 1>><<set $popcorn += 1>><<endevent>><</link>>
		<</if>>
	<<default>>
		<<link [[한 모금 마신다 (0:15)|Balloon Consume]]>><<stress -9>><<pass 15>><</link>><<lstress>><br>
<</switch>>

:: Balloon Consume
<<effects>>

<<switch $phase>>
	<<case "cold drink">>한 모금 마신다. <<seasonal_beverage>>【은는】 <<print Time.season is "spring" ? "기분 좋은 과일 맛이 나고" : "톡 쏘면서도">> 상쾌해서, 스트레스가 녹아내리는 것이 느껴진다.
	<<case "popcorn" "park" "ask_eat">>팝콘 한 줌을 입에 넣는다. 버터 맛과 짠맛이 어우러져, 영화관에 갔던 향수를 불러일으킨다.
	<<case "ask">>팝콘이 사방으로 쏟아지지 않도록 봉지 윗부분을 접어 주머니에 넣는다.
	<<default>>혀를 데지 않도록 조심스럽게 한 모금 마신다. <<seasonal_beverage>>【은는】 <<print Time.season is "winter" ? "진하고 크리미하며" : "향신료가 풍부하고">>, 스트레스가 녹아내리는 것이 느껴진다.
<</switch>>
<br><br>
<<if ["ask","ask_eat"].includes($phase)>>
	"물어볼 게 있었는데," 그 <<person>>【이가】 가판대에 <<his>> 팔꿈치를 기대고 당신과 대화하려고 몸을 기울이며 말한다. "팝콘은 어때요? 맛있죠, 그렇죠?"
	<br><br>
	<<if $speech_attitude is "meek">>
		"아주 맛있어요, <<sir>>." 당신은 <<him>>에게 말한다. "그런데, 음, 좀 짠 것 같아요?"
	<<elseif $speech_attitude is "bratty">>
		"네, 인정해야겠네요, 잘 만드셨어요. 근데 짜네요. 목말라 죽겠어요." 당신은 솔직하게 입맛을 다신다.
	<<else>>
		"맛있어요, 네! 굳이 비평하자면, 좀 짜긴 하네요."
	<</if>>
	<br><br>
	"소금은 중독성이 있죠. 그렇게 손님들을 다시 오게 만드는 거예요." <<he>>【이가】 윙크하며 말한다. "하지만 알려줘서 고마워요. 개선할 점은 언제나 환영이니까요."
	<br><br>
	<<link [[가판대 주인이 로빈과 협력하도록 제안한다|Balloon Partner]]>><<set $phase to "help">><</link>><br>
	<<link [[가판대 주인이 음료를 팔도록 제안한다|Balloon Partner]]>><<set $phase to "sabotage">><</link>>
<<elseif $phase is "park">>
	<<link [[다음|Park]]>><<set $eventskip to 1>><<endevent>><</link>>
<<else>>
	<<link [[다음|Beach]]>><<set $eventskip to 1>><<endevent>><</link>>
<</if>>

:: Balloon Partner
<<effects>>
<<location "beach">><<npc Robin 2>><<person2>>
<<set _boyfriend to ($robinromance ? `<<nnpc_girlfriend "Robin">>` : "친구")>>

<<switch $phase>>
	<<case "help">>
		<<if getRobinLocation() is "beach">>
			"저기 바로 맞은편에서 제 _boyfriend【이가】 레모네이드를 팔고 있거든요." 당신은 로빈의 레모네이드 가판대를 턱짓으로 가리킨다. "진짜 맛있어요. 손님들도 팝콘을 드시고 나면 시원한 음료를 마실 수 있어서 좋아할 것 같은데요."
		<<else>>
			"<<print Time.season is "winter" ? "날이 춥지 않을 때는," : "지금은 저기 없지만,">> 제 _boyfriend【이가】 주말마다 저기 바로 맞은편에서 레모네이드를 팔아요. 아마 보신 적 있을 거예요." 당신은 평소 로빈이 가판대를 차려두는 자리를 턱짓으로 가리킨다. "<<print Time.season is "winter" ? "지금은 겨울이라 공원에서 핫초코를 팔고 있지만요." : "진짜 맛있어요.">> 팝콘을 먹고 나서 마시면 딱 좋을 것 같아서요."
		<</if>>
		<br><br>
		<<person1>><<person>>【은는】 고개를 갸웃거리며 당신의 말을 곰곰이 생각한다.
		<<if C.npc.Robin.crossdressing gte 2 and getRobinLocation() is "beach" and $robinromance>>
			"<<print (_boyfriend.toUpperFirst())>>【이】라고?" <<He>>【은는】 로빈의 <<= C.npc.Robin.pronoun is "f" ? "동여맨 가슴" : "<<npcClothesText statusCheck('Robin') 'upper'>>">> 쪽을 힐끔 쳐다본다. "난 또 속을 뻔했네. 뭐, 네 취향이 그렇다면야 상관없지만, 안 그래?" <<He>>【은는】 당신에게 쓴웃음을 지어 보이고는 말을 잇는다.
			<<set _boyfriend to C.npc.Robin.pronoun is "f" ? "'여자친구'" : "'남자친구'">>
		<</if>>
		"그 녀석 레모네이드라면 나도 예전에 먹어본 적 있거든." <<person2>><<person1>><<he>>【이가】 말한다. "그냥 설탕물 수준이던데. 딱 잘라 거절하겠다는 건 아니지만, 네 꼬마 _boyfriend랑 손잡는 게 영 꽝인 생각은 아니라는 걸 증명하려면 좀 더 설득해 봐야 할 거야."
		<br><br>
		<<link [[설득한다|Balloon Convince]]>><<set $phase to "persuade">><</link>><<englishdifficulty 1 1000>><br>
		<<if hasSexStat("promiscuity", 4)>>
			<<link [[유혹한다|Balloon Convince]]>><<set $phase to "seduce">><</link>><<promiscuous4>>
			<br>
		<</if>>
		<<if $money gte 30000>>
			<<link [[뇌물을 준다 (£300)|Balloon Convince]]>><<set $phase to "bribe">><<money -30000 "bribe">><</link>>
		<</if>>

	<<case "sabotage">>
		"팝콘이랑 같이 음료도 팔아볼 생각은 없으세요?" 당신이 묻는다.
		<br><br>
		<<person1>><<person>>【은는】 가판대를 닦으며 애매하게 흥얼거린다. "<<print getRobinLocation() is "beach" ? "저기 있는" : Time.season is "winter" ? "공원에서 핫초코 파는" : "레모네이드 파는">> 네 친구처럼?" <<He>>【은는】 비밀을 말하듯 몸을 기울인다. "<<person2>><<his>> 레모네이드는 전에 마셔봤어. <<He>>【은는】 설탕을 좀 많이 넣는 편이던데, 제대로 된 착즙기나 하나 장만해야 할 거야."
		<br><br>
		<<person1>><<He>>【은는】 다시 몸을 바로 세운다. "네 친구는 얼마에 팔아?" <<he>>【은는】 <<print getRobinLocation() is "beach" ? "로빈의 가판대" : "로빈이 평소에 가게를 차리는 곳">> 쪽을 힐끗 보며 중얼거린다. "£1? 그렇게 해서는 먹고살 수 없지. 뭐, 어쩌면 선의의 경쟁이 <<person2>><<him>>의 장사에 도움이 될지도 모르고." <<person1>><<person>>【은는】 킥킥 웃는다. "벌써 계절 메뉴도 생각 중이야. 가을엔 사과주, 봄엔 딸기 레모네이드... 재밌겠는데. 내일 한번 들러, 어때? 음료수 한 잔 공짜로 줄게." <<set $balloonStand.freeDrink to true>>
		<br><br>
		<<if $speech_attitude is "meek">>
			"정말 친절하시네요, <<sir>>." 당신은 <<him>>에게 살짝 미소 짓는다. "감사합니다."
		<<elseif $speech_attitude is "bratty">>
			"좋아요, 저도 껴주세요." 당신은 활짝 웃는다. "공짜라면 언제나 환영이죠."
		<<else>>
			"정말 좋을 것 같아요." 당신은 미소 짓는다. "감사합니다."
		<</if>>
		<br><br>
		"그렇다고 맨날 공짜로 줄 거라고 기대하진 마. 나도 먹고살아야 하니까." <<he>>【이가】 윙크하며 말한다. "너, 제법 수완이 좋은데, <<girl>>. 계속 그렇게 하면 언젠가 훌륭한 사업가가 될 거야." <<stress -6>><<lstress>>

		<<balloonRobinSabotaged>>
		<br><br>
		<<link [[다음|Beach]]>><<set $eventskip to 1>><<endevent>><</link>>
<</switch>>

:: Balloon Convince
<<effects>>
<<npc Robin 2>><<person2>>

<<switch $phase>>
	<<case "persuade">>
		당신은 로빈의 <<print Time.season is "winter" ? "핫초코" : "레모네이드">>【이가】 얼마나 훌륭한지 길게 이야기한다. 거기에 더해, 로빈이 고아였다는 슬픈 사연까지 덧붙인다.
		<br><br>
		<<if $englishSuccess>>
			"정말 <<person2>><<him>>에게 큰 도움이 될 거예요, <<person1>><<sir>>." 당신은 눈을 동그랗게 뜨고 진심 어린 표정으로 말한다. "<<person2>><<He>>【은는】 좋은 사람이에요. 그저 한 번만 기회를 줄 사람이 필요할 뿐이죠. 그리고 이건 일방적인 게 아니에요, 장담하건대. <<He>>도 기꺼이 손님들을 이쪽으로 보내줄 거예요. 게다가 이 잔인한 세상에서 불행한 고아가 자립할 수 있도록 돕는 거니, 얼마나 좋은 업보를 쌓는 거겠어요!"
			<br><br>
			<<person1>><<person>>【은는】 당신의 열정적인 말에 감동한 듯 보인다. <<balloonRobinHelped>>
			<br><br>
			<<link [[다음|Beach]]>><<set $eventskip to 1>><<endevent>><</link>>
		<<else>>
			<<person1>><<person>>【은는】 감동하지 않은 표정이다. "그래서, <<person2>><<personssimple>>【이가】 힘든 삶을 살았다고. 안 그런 사람이 어디 있나? 여긴 자선 사업하는 곳이 아니고, <<he>>【이가】 나한테 무슨 이득을 줄 수 있을지 모르겠군."
			<br><br>
			<<person1>><<He>>【은는】 한숨을 쉰다. "이봐, 나도 나쁜 놈은 아니야." <<personsimple>>【이가】 말한다. "썩 내키진 않지만, 넌 마음에 드는군. 다른 때에 가판대에 들르면, 네 얘기를 기꺼이 들어주지."
			<<set $daily.ex.balloonConvince to 1>>
			<<set $balloonStand.robin.status to "convince">>
			<br><br>
			<<link [[다음|Beach]]>><<set $eventskip to 1>><<endevent>><</link>>
		<</if>>

	<<case "seduce">>
		<<set $seductiondifficulty to 8000>>
		<<seductioncheck>>
		<<seductionskilluptext>>
		<<seductionskilluse>>

		"정말 설득이 안 될까요?" 당신은 <<person1>><<his>> 가판대 위로 몸을 기울이며 속삭인다. 입술을 핥고는 <<his>> 가랑이를 노골적으로 쳐다본다. "전 입을 아주 잘 쓰는데... 분명 합의점을 찾을 수 있을 거예요." <<promiscuity4>>

		<<if $seductionrating gte $seductionrequired>>
			<<He>>【은는】 잠시 갈등하는 듯했지만, 이내 마음을 누그러뜨린다. "아, 알았어." <<He>>【은는】 재빨리 주변을 살피고 당신을 가판대 밑으로 들여보낸다. "그 입을 잘 써준다면, 도와주지. 서둘러, 누가 보기 전에. 저쪽에 손님이 될 만한 사람들이 보이는 것 같군."
			<br><br>
			<<link [[다음|Balloon Sex]]>><<set $sexstart to 1>><</link>>
		<<else>>
			<<person>>【은는】 당신을 보더니 웃음을 터뜨려, 당신을 무안하게 만든다. "어림도 없지, 미안. 이봐, 나도 나쁜 놈은 아니야." <<he>>【이가】 말한다. "관심은 없지만, 넌 마음에 드는군. 내일 다시 가판대에 들르면, 네 얘기를 기꺼이 들어주지. 다음엔 말로 해, 이런... 거 말고." <<He>>【은는】 혼자 킬킬 웃고는 손을 흔들어 당신을 돌려보낸다.
			<<set $daily.ex.balloonConvince to 1>>
			<<set $balloonStand.robin.status to "convince">>
			<br><br>
			<<link [[다음|Beach]]>><<set $eventskip to 1>><<endevent>><</link>>
		<</if>>

	<<case "bribe">>
		<<if $speech_attitude is "meek">>
			"이러면 거래가 좀 더 달콤해질까요?" 당신은 £300를 세어 <<person1>><<him>>에게 건넨다.
		<<elseif $speech_attitude is "bratty">>
