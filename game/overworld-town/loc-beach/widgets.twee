:: Widgets Beach [widget]
<<widget "beachday1">>
	<<generatey1>>뒤에서 누군가의 발소리가 들린다. 당신이 뒤돌아보는 찰나 <<person1>><<person>>【이가】 당신에게 달려든다. <<He>>【은는】 모래밭에 당신을 때려 눕히곤 당신의 옷을 벗기려 든다!
	<br><br>
	<<link [[다음|Beach Day Molestation]]>><<set $molestationstart to 1>><<set $eventskip to 1>><</link>>
<</widget>>

<<widget "beachday2">>
	<<outfitChecks>>
	<<beastNEWinit 1 dog>>
	누군가 당신의 _bottom.name【을를】 확 잡아당기는 게 느껴진다. 어깨너머로 돌아보니, <<bhis>> 이빨로 당신의 옷을 물고 있는 작은 <<beasttype>>【이가】 보인다.

	<<if _bottom.integrity lte 20>>
		<<set _bottom.integrity -= 20>>
		당신은 그 짐승의 주둥이에서 옷을 억지로 빼내려 애쓰지만, 당신의 _bottom.name【이가】 몸에서 찢겨 나간다!
		<<if !_bottomUnder>>
			<<beasttype>>【은는】 도망가버리고, 당신은 당신의 <<genitals>>【이가】 만천하에 드러난 채 굴욕감을 느끼며 홀로 남겨진다.
			<<gtrauma>><<trauma 1>><<stress 1>><<gstress>>
		<<else>>
			<<beasttype>>【은는】 도망가버리고, 당신은 당신의 _bottomUnder.name【이가】 만천하에 드러난 채 굴욕감을 느끼며 홀로 남겨진다.
			<<stress 1>><<gstress>>
		<</if>>
		<br><br>
		<<integritycheck>><<trauma 6>>
	<<else>>
		당신은 가까스로 <<bhis>> 주둥이에서 옷을 빼내지만, 이 난리통에 옷이 좀 해어졌다.
	<</if>>
	<br><br>
	<<destinationBeach "다음">><<set $eventskip to 1>><<endevent>><</destinationBeach>>
<</widget>>

<<widget "beachday3">>
	<<generate1>><<set $NPCList[0].virginity.penile to false>><<set $NPCList[0].virginity.vaginal to false>><<person1>><<person>>【이가】 당신을 쳐다보는 게 보인다. <<He>>【은는】 저만치에서 모래놀이를 하는 <<his>> 아이들과 함께 여기 온 것 같다. 당신과 눈이 마주치자 <<He>>【은는】 시선을 돌려버린다.
	<br><br>

	<<link [[접근한다|Beach Day Encounter]]>><<set $phase to 0>><</link>>
	<br>
	<<destinationBeach "외면한다">><<set $eventskip to 1>><<endevent>><</destinationBeach>>
	<br>
<</widget>>

<<widget "beachday4">>
	바다에서 돌풍이 불어와, 당신의 피부를 기분 좋게 어루만진다.
	<<lstress>><<stress -2>>
	<br><br>

	<<if setup.clothes.lower[clothesIndex('lower', $worn.lower)].skirt is 1 and $worn.under_lower?.type.includes("lower_covering")>>
		바람에 당신의 치마가 훌렁 뒤집히지만, $worn.under_lower.name【이가】 당신의 존엄성을 지켜준다.
		<br><br>

		<<destinationBeach "다음">><<set $eventskip to 1>><</destinationBeach>>
	<<elseif setup.clothes.lower[clothesIndex('lower', $worn.lower)].skirt is 1>>
		/* variables */
		<<set _helpless to pcAreArmsBound("both")>>
		<<set _trauma_gain to 0>>
		<<set _arousal_gain to 0>>

		/* event */
		그 바람에 당신의 치마가 펄럭이며 뒤집어져 당신의
		<<if $worn.under_lower.type.includes("naked")>>
			<<set _arousal_gain += 200>>
			<<set _trauma_gain += .5>>
			<<genitals>>
		<<else>>
			<<set _arousal_gain += 100>>
			$worn.under_lower.name
		<</if>>해변 한가운데에 노출시킨다.

		<<if _helpless>>
			<<set _arousal_gain += 100>>
			<<set _trauma_gain += 1>>
			포박당한 채 무력해진 당신은, 마침내 바람이 잦아들어 치맛단이 다시 제자리로 돌아갈 때까지 당신의 노출을 가지고 노는 바람을 견뎌내는 것 말고는 아무것도 할 수 없다.
		<</if>>
		<<if random(0, 10) gte 5>>
			<<print [
			"갑작스러운 낄낄거리는 웃음소리에 당신이 고개를 돌려 구경꾼을 마주본다.",
			"갑작스러운 낄낄거리는 웃음소리가 당신의 주의를 끈다.",
			"충격에 빠져 헐떡이는 한 구경꾼이 당신의 주의를 끈다.",
			"낄낄대는 한 구경꾼이 당신의 주의를 끈다.",
			"충격에 빠져 헐떡이는 무리가 당신의 주의를 끈다.",
			"낄낄거리는 사람들의 무리가 당신의 주의를 끈다."
			].pluck()>>
			<<fameexhibitionism 1>>

			<<if random(0, 10) gte 7>>
				<<endevent>>
				<span class="pink">
					당신은 자신을 향해 있는 휴대폰을 발견하고, 그들이 아마도 촬영하고 있었을 거란 사실을 깨닫는다.
				</span>
				<<fameexhibitionism 5 "vid">>
				<<set _trauma_gain += 2>>
				<<set _arousal_gain += 100>>
			<<else>>
				그들이 전부 봤음이 틀림없다.
				<<set _trauma_gain += 1>>
				<<set _arousal_gain += 50>>
			<</if>>
		<</if>>

		<<if $uncomfortable.nude and hasSexStat("exhibitionism", 5) and _trauma_gain>>
			당신은 그런 공공장소에서 속살을 노출했다는 생각에 끔찍하게 속이 뒤틀리며, 구겨진 체면을 조금이나마 회복해 보려 그 일에 대해 잊으려 애쓴다.
			<<set _trauma_gain += 1>>
		<<else>>
			당신은 이런 공공장소에서 몸을 노출했다는 생각에 아랫배가 흥분으로 찌릿하게 달아오르며, 겉으로는 체면을 챙기는 척하면서 그 감각을 온전히 만끽할 수밖에 없다.
			<<set _arousal_gain += 50>>
		<</if>>

		/* stats application */
		<<if _arousal_gain>>
			<<garousal>><<arousal _arousal_gain>>
		<</if>>
		<<if _trauma_gain and $uncomfortable.nude>>
			<<gtrauma>><<trauma _trauma_gain>>
		<</if>>

		/* choices */
		<br><br>
		<<if _helpless>>
			<<link [[다음|Beach]]>><<set $eventskip to 1>><</link>>
		<<else>>
			<<link [[치마를 눌러 내리려 한다|Beach Skirt Flare Stop]]>><</link>>
			<<if hasSexStat("exhibitionism", 3) and !$worn.under_lower.type.includes("naked")>>
				<br>
				<<link [[그냥 둔다|Beach Skirt Flare Allow]]>><</link>><<exhibitionist2>>
			<<elseif hasSexStat("exhibitionism", 4)>>
				<br>
				<<link [[그냥 둔다|Beach Skirt Flare Allow]]>><</link>><<exhibitionist4>>
			<</if>>
		<</if>>

		/* cleanup */
		<<unset _helpless>>
		<<unset _arousal_gain>>
		<<unset _trauma_gain>>
	<<else>>
		<<destinationBeach "다음">><<set $eventskip to 1>><</destinationBeach>>
	<</if>>
<</widget>>

<<widget "beachday5">>
	당신이 해안가를 걷고 있을 때 등 뒤에서 소란스러운 소리가 들린다. 어깨너머로 돌아보자, 당신의 반 친구 몇 명이 당신을 향해 달려오는 게 보인다.
	<br><br>
	<<link [[멈춰서 기다린다|Beach Day Classmates]]>><<set $phase to 0>><</link>><br>
	<<link [[도망친다|Beach Day Classmates]]>><<set $phase to 1>><</link>><<athleticsdifficulty 1 800>>
<</widget>>

<<widget "beachday6">>
	<<if setup.clothes.lower[clothesIndex('lower', $worn.lower)].skirt isnot 1 and !$worn.lower.type.includes("naked")>>
	<<generatey1>><<person1>>
	당신이 해안가를 거닐고 있을 때 <<person>>【이가】 당신의 허리띠를 잡아당겨 당신의 <<bottom>>【을를】 노출시킨다. 당신이 반응하기도 전에, <<he>>【은는】 모래가 가득 든 커다란 양동이를 당신의 <<if $worn.under_lower.name is "naked" or $worn.under_lower.one_piece is 1>>$worn.lower.name<<else>>$worn.under_lower.name<</if>> 안으로 부어 버린다. <<He>>【은는】 아마 다른 장난 칠 희생양을 찾아다니기 위해, 당신의 엉덩이를 철썩 때리고 도망친다.
	<br><br>
	당신은 최선을 다해 옷 안에서 모래를 털어낸다. 그럼에도 필연적으로 일부는 엉덩이 골 사이에 끼어 살갗을 쓸리게 하고 거슬리게 만든다. <<gpain>><<gstress>><<pain 1>><<stress 2>>
	<br><br>
	<<destinationBeach "다음">><<endevent>><<set $eventskip to 1>><</destinationBeach>>
<<else>>
	바다에서 돌풍이 불어와, 당신의 피부를 기분 좋게 어루만진다.
	<<lstress>><<stress -2>>
	<br><br>
	<<destinationBeach "다음">><<set $eventskip to 1>><</destinationBeach>>
<</if>>
<</widget>>

<<widget "beachnight1">>
	<<beastNEWinit 1 dog>>
	<<if $monster is 1>>
		어둠 속에서 <<beasttype>>【이가】 나타난다. 더부룩하게 털이 자란 <<bhis>> 몸이 야만적인 분위기를 풍긴다. <<bHe>>【은는】 <<bhis>> 송곳니를 드러내며, <span class="red">굶주림으로 번뜩이는 눈</span>으로 당신을 쳐다본다.
	<<else>>
		야생동물 같은 <<beasttype>>【이가】 이빨을 드러내고 굶주림으로 번뜩이는 눈을 한 채 어둠 속에서 나타난다.
	<</if>>
	<br><br>
	<!-- Modified for Beast People -->
	<<if $monster is 1 or $settings.bestialityEnabled>>
		<<link [[다음|Beach Night Dog]]>><<set $eventskip to 1>><<set $molestationstart to 1>><</link>>
		<br>
	<<else>>
		당신은 간신히 도망치지만, 상처를 입고 만다.<<beastescape>>
		<br><br>
		<<destinationBeach "다음">><<endevent>><<set $eventskip to 1>><</destinationBeach>>
	<</if>>
<</widget>>

<<widget "beachnight2">>
	<<generate1>>사방이 너무 어두워서, 모래 위에 누워있던 <<person1>><<person>>【이가】 당신의 발목을 붙잡아 바닥으로 넘어뜨릴 때까지 눈치채지 못했다.
	<br><br>
	<<link [[다음|Beach Night Molestation]]>><<set $molestationstart to 1>><</link>>
<</widget>>

<<widget "beachex1">>
	<<generatey1>>한 <<person1>><<person>>【이가】 불안해 보이는 당신을 발견하고는 소리친다, <<catcalllewd>> 그 소리에 고개를 돌린 다른 사람들에 의해 당신은 순식간에 시선의 중심이 된다.
	<<if $panicattacks gte 1>>
		당신은 압도적인 불안감에 휩싸인다. 이성적인 생각을 잃은 채 조롱 섞인 웃음소리에 쫓기며 무리에게서 달아나는 것 말고는 아무것도 할 수 없다.
		<<fameexhibitionism 30>><<gstress>><<gtrauma>><<stress 6>><<trauma 6>>
		<br><br>
		공포심이 사그라졌을 때 즈음, 당신은 탈의실 안쪽 벽에 털썩 주저앉아 있는 자신을 발견한다.
		<br><br>
		<<link [[탈의실|Changing Room]]>><<endevent>><</link>>
	<<else>>
		<<gstress>><<gtrauma>><<stress 6>><<trauma 6>>
		<br><br>
		<<link [[탈의실|Beach Exhibition]]>><<set $phase to 0>><</link>>
		<br>
		<<link [[도움을 청한다|Beach Exhibition]]>><<set $phase to 1>><</link>>
	<</if>>
<</widget>>

<<widget "beachex2">>
	<<generatey1>><<person1>><<person>>【이가】 이 위태로운 상태의 당신을 발견하곤 <<his>> 친구들을 부른다. 당신은 순식간에 포위된다. <<person>>【이가】 말한다. "여기 누드 비치 아닌 거 알지? 경찰에 신고해야 할 거 같은데." <<he>>【이가】 마치 큰 소리를 지르려는 듯 숨을 크게 들이켜자 당신은 곤경에 빠진 자신에게 시선이 더 몰릴 거란 예상에 몸을 움츠린다. 하지만 그 대신, <<he>>【와과】 <<his>> 친구들은 조소 섞인 웃음을 터뜨린다. "아니면, 내가 옷 같은 걸 줘서 도와줄 수도 있고. 당연히, 공짜는 아니지. 무릎 꿇어."
	<<fameexhibitionism 20>>
	<br><br>
	<<if hasSexStat("promiscuity", 3)>>
		<<link [[따른다|Beach Exhibit Molestation]]>><<set $phase to 1>><<set $sexstart to 1>><</link>><<promiscuous3>>
		<br>
	<<elseif $uncomfortable.prostituting is false>>
		<<set _desperateaction to 2>>
		<<link [[마지못해 따른다|Beach Exhibit Molestation]]>><<set $desperateaction to _desperateaction>><<set $phase to 1>><<set $sexstart to 1>><</link>><<promiscuous3>>
		<br>
	<</if>>
	<<link [[거부한다|Beach Exhibit Molestation]]>><<set $phase to 0>><<set $molestationstart to 1>><</link>>
	<br>
<</widget>>

<<widget "removebeachlower">><<silently>>
	<<if _args[0] is 1>>
		<<set $_pulltense to "고">>
	<<elseif _args[0] is 2>>
		<<set $_pulltense to "며">>
	<<else>>
		<<set $_pulltense to "고">>
	<</if>>

	/* This should include cases for every lower clothing in the types Town, Beach, Warm,
	schoolSwim, and Cold. Essentially, everything an NPC on the beach can be wearing,
	according to the "Beach" case for the widget "generateNPCClothes" */
	<<switch $NPCList[$index].clothes.lower.name>>
		<<case "shorts" "trousers" "tracksuit bottoms" "slacks" "jeans" "khakis" "swim shorts" "board shorts" "boyshorts" "jorts" "sweatpants" "school swim shorts">>
			<<set $_text_output to "<<his>> $NPCList[$index].clothes.lower.name【을를】 끌어내리$_pulltense">>
		<<case "bikini bottoms" "microkini bottoms" "school swimsuit bottoms">>
			<<set $_text_output to "<<his>> $NPCList[$index].clothes.lower.name【을를】 옆으로 젖히$_pulltense">>
		<<case "sundress skirt" "skirt" "miniskirt">>
			<<set $_text_output to "<<his>> $NPCList[$index].clothes.lower.name【을를】 걷어 올리$_pulltense">>
		<<default>>
			<<if $pronoun is "f">>
				<<set $_text_output to "<<his>> 비키니 하의를 옆으로 젖히$_pulltense">>
			<<else>>
				<<set $_text_output to "<<his>> 반바지를 끌어내리$_pulltense">>
			<</if>>
	<</switch>>
<</silently>><<print $_text_output>><</widget>>

<<widget "removesbeachlower">>
	<<removebeachlower 1>>
<</widget>>

<<widget "removingbeachlower">>
	<<removebeachlower 2>>
<</widget>>

