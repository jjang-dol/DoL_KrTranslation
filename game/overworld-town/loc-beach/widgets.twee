:: Widgets Events Beach [widget]
/* TODO: replace with eventpool */
<<widget "eventsbeach">>
	<<set $dangerevent to random(1, 100)>>
	<<if Time.dayState is "night">>
		<<if $dangerevent lte 15>>
			<<beachnight1>>
