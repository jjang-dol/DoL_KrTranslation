:: Widgets School Projects [widget]
<<widget "scienceprojectstart">>
	<<set $sciencelichentemple to 0>>
	<<set $sciencelichenpark to 0>>
	<<set $sciencelichenlake to 0>>
	<<set $sciencelichendrain to 0>>

	<<set $sciencelichentempleready to 0>>
	<<set $sciencelichenparkready to 0>>
	<<set $sciencelichenlakeready to 0>>
	<<set $sciencelichendrainready to 0>>

	<<set $scienceshroomwolf to 0>>
	<<set $scienceshroomheart to 0>>

	<<set $scienceshroomwolfready to 0>>
	<<set $scienceshroomheartready to 0>>

	<<set $sciencephallusready to 0>>

	<<set $sciencephallus to 0>>

	<<set $sciencephalluspenis to 0>>
	<<set $sciencephallusclit to 0>>

	<<set $sciencefaircheat to 0>>
<</widget>>

<<widget "scienceprojectfinish">>
	<<unset $sciencelichentemple>>
	<<unset $sciencelichenpark>>
	<<unset $sciencelichenlake>>
	<<unset $sciencelichendrain>>

	<<unset $sciencelichentempleready>>
	<<unset $sciencelichenparkready>>
	<<unset $sciencelichenlakeready>>
	<<unset $sciencelichendrainready>>

	<<unset $scienceshroomwolf>>
	<<unset $scienceshroomheart>>

	<<unset $scienceshroomwolfready>>
	<<unset $scienceshroomheartready>>

	<<unset $sciencephallus>>

	<<unset $sciencephallusready>>

	<<unset $sciencephalluspenis>>
	<<unset $sciencephallusclit>>

	<<unset $sciencefaircheat>>
	<<unset $sciencelichenchance>>
	<<unset $scienceshroomchance>>
	<<unset $sciencephalluschance>>

	<<unset $scienceprojectwarning>>

	<<unset $science_leighton_flirt>>
	<<unset $science_sabotage>>
	<<unset $science_fair_project>>

	<<unset $science_avery_comment>>

<</widget>>

<<widget "mathsprojectstart">>
	<<set $mathschance to 0>>
		<<if $mathsstim is undefined>>
		<<set $mathsstim to 0>>
		<</if>>
	<<set $mathsstimused to 0>>
	<<set $mathsstimbought to 0>>
	<<set $mathsstimstolen to 0>>
	<<set $mathsinfo to 0>>
<</widget>>

<<widget "mathsprojectfinish">>
	<<unset $mathschance>>

	<<unset $mathsprojectdays>>
	<<unset $mathsstimused>>
	<<unset $mathsstimbought>>
	<<unset $mathslibraryknown>>
	<<unset $mathsdruggedstudent>>
	<<unset $mathsinfo>>
	<<unset $mathsstimstolen>>
	<<unset $mathsstimrobin>>
	<<unset $mathsstimbeg>>
	<<unset $mathsprojectwhitney>>
	<<unset $mathschancestart>>
	<<unset $river_help>>
	<<unset $mathsprojectwarning>>
	<<unset $maths_avery_comment>>
<</widget>>

<<widget "englishplaystart">>
	<<set $englishPlayReadiness to 0>>
	<<set $englishPlayApproval to 0>>
		<<set $englishPlayRoles to {
			Player: "none",
			Kylar: "none",
			Sydney: "none",
			KylarKnown: false,
			KylarCount: 0,
			SydneyKnown: false,
			SydneyCount: 0
		}>>
<</widget>>

<<widget "englishplayfinish">>
	<<unset $englishPlayDays>>
	<<unset $englishPlayReadiness>>
	<<unset $englishPlayWarning>>
	<<set $englishPlayRolePlayed to $englishPlayRoles.Player>>
	<<unset $englishPlayRoles>>
	<<unset $englishPlayKylarReplace>>
	<<unset $englishPlayKylarTalk>>
	<<unset $englishPlaySydneyTalk>>
	<<unset $englishPlaySydneyWatch>>
	<<unset $englishPlayRobinWatch>>
	<<unset $englishPlayWatch>>
	<<unset $randomPlayPool>>
	<<unset $englishPlayPronouns>>
	<<unset $englishPlayKylarLeave>>
	<<set $englishPlay to "done">>
	<<unset $english_avery_comment>>
	<<unset $english_play_break_one>>
	<<unset $english_play_break_two>>
	<<unset $english_play_kiss>>
<</widget>>

<<widget "projectoptions">>
	<<if $scienceproject is "ongoing">>
		<<icon "project-science.png">><<link [[과학 프로젝트를 작업한다|Science Project]]>><</link>>
		<br>
	<</if>>
	<<if $mathsproject is "ongoing">>
		<<icon "project-maths.png">><<link [[수학 프로젝트를 작업한다|Maths Project]]>><</link>>
		<br>
	<</if>>
	<<if $englishPlay is "ongoing" and $englishPlayRoles.Player isnot "none" and ($location is "home" or $location is "avery_mansion")>>
		<<if $location is "avery_mansion" and ($avery_mansion?.schedule is "sleep" or ($avery_mansion?.schedule isnot "away" and $avery_mansion?.schedule isnot "work" and !$avery_mansion?.study_unlocked))>>
			<<icon "project-english.png">><span class="blue">이곳에 있어서는 안 된다는 것을 알고 있기에, 예행연습을 하면 안 될 것이다.</span>
		<<else>>
			<<icon "project-english.png">><<link [[배역을 예행연습한다 (2:00)|English Play Rehearse Alone]]>><<pass 2 hours>><<englishskill 6>><<if $location is "avery_mansion" and $daily.avery.noRehearse>><<npcincr Avery rage 1>><</if>><</link>><<genglish>><<greadiness>><<if $location is "avery_mansion" and $daily.avery.noRehearse>><<garage>><</if>>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "scienceprojectchance">>
	<<set $sciencelichenchance to $sciencelichenparkready * 25 + $sciencelichenlakeready * 25 + $sciencelichendrainready * 25 + $sciencelichentempleready * 25>>
	<<set $scienceshroomchance to $scienceshroomwolfready * 10 + $scienceshroomheartready * 10>>
	<<set $sciencephalluschance to $sciencephallusready * 10>>
<</widget>>

<<widget "mathsphone">>
	그들은 자신들이 찍은 사진들을 비교한다. 그들 중 두 명이 당신의 눈앞에 전화기를 들이민다.
	<br><br>

	<<if $mathsab1 is "smile">>
	첫 번째 사진에는 당신이 양손으로 V자를 그리며 미소 짓는 모습이 담겨 있다. 사정을 모르는 사람이 본다면 억지로 찍힌 사진이라는 걸 눈치채지 못할 것이다.
	<<elseif $mathsab1 is "frown">>
	첫 번째 사진에는 당신이 눈살을 찌푸린 채 손으로 카메라를 향해 불쾌한 제스처를 취하는 모습이 담겨 있다.
	<<elseif $mathsab1 is "cover">>
	첫 번째 사진에는 당신이 얼굴을 가리고 있는 모습이 담겨 있다. 누군가 봐도 그게 당신인지 알아볼 수 없을 것 같다.
	<<elseif $mathsab1 is "tearsmile">>
	첫 번째 사진에는 당신이 양손으로 V자를 그리며 미소 짓는 모습이 담겨 있다. 얼굴에는 눈물이 흐르고, 미소는 전혀 진심이 아닌 것처럼 보인다.
	<<elseif $mathsab1 is "tearfrown">>
	첫 번째 사진에는 당신이 눈물을 흘리며 화난 얼굴로 찌푸리고 있는 모습이 담겨 있다. 당신은 손으로 카메라를 향해 불쾌한 제스처를 취하고 있다.
	<<elseif $mathsab1 is "tearcover">>
	첫 번째 사진에는 당신이 얼굴을 가리고 있는 모습이 담겨 있다. 가린 손 밑으로 눈물이 흘러내린다.
	<</if>>
	시간이 좀 흐른 뒤 찍힌 두 번째 사진 속 당신은 훨씬 더 흐트러진 모습이다. 미끄럽고 반짝거리는 무언가로 온몸이 범벅이 되어 있다.
	<<if $mathsab2 is "smile">>
	당신의 얼굴은 미소를 짓고 있지만, 눈빛 어딘가가 이상해 보인다.
	<<elseif $mathsab2 is "frown">>
	당신의 얼굴은 화가 나 있고, 반항적이다.
	<<elseif $mathsab2 is "cover">>
	당신의 얼굴은 가려져 있다.
	<<elseif $mathsab2 is "tearsmile">>
	당신의 얼굴은 미소를 짓고 있지만, 눈물이 흘러 사실은 그렇지 않다는 것을 적나라하게 보여준다.
	<<elseif $mathsab2 is "tearfrown">>
	당신의 얼굴은 눈물범벅이지만, 여전히 화가 나 있고 반항적이다.
	<<elseif $mathsab2 is "tearcover">>
	당신의 얼굴은 가려져 있지만, 흘러내리는 눈물은 숨길 수 없다.
	<</if>>
	<br><br>
<</widget>>

<<widget "greadiness">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="green">+ 준비도</span>
	<</if>>
<</widget>>

<<widget "ggreadiness">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="green">+ + 준비 태세</span>
	<</if>>
<</widget>>

<<widget "gggreadiness">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="green">+ + + 준비 태세</span>
	<</if>>
<</widget>>

<<widget "gapproval">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="teal">+ 호감도</span>
	<</if>>
<</widget>>

<<widget "ggapproval">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="teal">+ + 호감도</span>
	<</if>>
<</widget>>

<<widget "gggapproval">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="teal">+ + + 호감도</span>
	<</if>>
<</widget>>

<<widget "lapproval">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">- 호감도</span>
	<</if>>
<</widget>>

<<widget "llapproval">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">- - 호감도</span>
	<</if>>
<</widget>>

<<widget "lllapproval">>
	<<if !$settings.blindStatsEnabled>> |
		<span class="red">- - - 호감도</span>
	<</if>>
<</widget>>

<<widget "playReadiness">>
<<set $englishPlayReadiness = Math.clamp($englishPlayReadiness, 0, 100)>>
<<if $englishPlayReadiness is 0>>
	<span class="black">당신은 예행연습을 시작조차 하지 않았다.</span>
<<elseif $englishPlayReadiness lte 10>>
	<span class="pink">당신은 끊임없이 다시 읽어야 하며, 대사의 대부분이 입에 붙지 않아 버벅거린다.</span>
<<elseif $englishPlayReadiness lte 25>>
	<span class="purple">어려운 부분도 있지만, 당신은 서서히 감을 잡아가고 있다.</span>
<<elseif $englishPlayReadiness lte 55>>
	<span class="blue">이제 당신은 연극을 훨씬 잘 파악하게 되었고, 대사 중 일부를 암기할 수 있다.</span>
<<elseif $englishPlayReadiness lte 69>>
	<span class="lblue">당신은 가장 문제가 되는 몇 가지 대사를 제외하고, 대부분의 대사를 익혔다.</span>
<<elseif $englishPlayReadiness lte 99>>
	<span class="teal">당신은 역할을 해낼 준비가 되었다고 느낀다. 당신은 대사를 기억하고 자연스럽게 읊을 수 있다.</span>
<<else>>
	<span class="green">당신은 연극 전체를 암기했으며, 당신의 연기에 자신감이 있다.</span>
<</if>>
<</widget>>

<<widget "playLinePool">>
	<<set _englishPlayLinePool to {
		Cass: [
			"크리스마스 이브에 이런 가슴 아픈 다툼을 목격하다니, 차마 볼 수가 없군요!",
			"제가 거지라서 제 말이 저처럼 가치 없다는 건 알지만, 제 말을 들어주세요.",
			"평생 동안, 저는 가난하고 병든 어머니와 함께 살아왔습니다...", 
			"제 삶의 유일한 다른 위안은 테일러입니다. 그래서 제가 간청하는 겁니다, 이번 한 번만, 제가 사랑하는 사람과 밤을 보낼 수 있게 해주세요."
		],
		Taylor: [
			"제발, 들어주세요! 제가 캐스에게 느끼는 감정은 단순한 관심이 아니에요! 우리는 정말로 함께할 운명이었어요!",
			"저는 평생 당신이 살라고 한 삶을, 당신이 저를 위해 내린 선택들로 살아왔어요.",
			"이것 때문에 저를 미워하고 싶으시다면, 막을 수는 없지만, 이것이 제가 원하는 전부라는 걸 알아주세요.",
			"당신의 축복을 받게 되어 제 마음이 진정으로 기쁩니다."
		],
		Sterling: [
			"정말 믿을 수가 없군... 내 자식이, 더러운 거지에게 홀리다니? 당장 떠나자, 테일러. 집에 가서 설명해라.",
			"내가 너를 이 세상에 데려온 이후로, 네가 진정한 행복을 찾기만을 바랐다.",
			"나 또한 근시안적인 부모의 엄격한 지도 아래 자랐지...", 
			"......하지만 성공을 향한 자기중심적인 추구 속에서, 나는 단지 나 자신의 만족을 추구하고 있었다는 것을 깨닫지 못했다."
		]
	}>>
<</widget>>

<<widget "randomPlay">><<silently>>
	<<generates1>><<person1>>
	<<if !$randomPlayPool>>
		<<set $randomPlayPool to [
			"연극은 주연 <<actor>>【이가】 <<his>> 대사를 외우지 못해 엉망이 된다. 실망한 도렌이 대역으로 뛰어들어 연극을 짧게 끝낸다.",
			"로맨틱한 연극은 두 주인공이 무대에서 키스하기 위한 핑계였던 것으로 드러납니다. 도렌은 그들을 떼어놓고 대사를 계속하도록 강요해야 합니다.",
			"연극은 뱀파이어에 관한 것으로, 학생들은 짙은 화장을 하고 있습니다. 나중에 화장실에서 그들 중 일부가 화장을 지우려고 애쓰는 모습을 보게 될 것이라고 확신합니다.",
			"주연 <<actor>>【이가】 병이 나서 연극이 빨리 끝났습니다.",
			"연극은 <<actor>>【이가】 <<actorAroused>> 때문에 도렌에 의해 일찍 끝나게 됩니다.",
			"연극은 어떤 동화를 바탕으로 하고 있지만, 그 암울한 성격 때문에 당신은 그것이 원작 독일어 버전이라고 추측합니다.",
			"배우들은 이 연극 동안 대부분의 대사를 잊어버리고 즉흥 연기를 하기로 결정합니다. 그들이 오로지 농담을 하고 캐릭터를 깨기 시작하자, 도렌이 개입하여 대본을 읽게 합니다.",
			"주연 <<actor>>【은는】 연극 동안 훌륭한 연기를 선보이며, <<his>> 수제 의상을 자랑스러워합니다. 도렌이 사전에 그 의상을 승인하지 않았다는 것은 매우 분명합니다.",
			"예상치 못한 반전으로, 주연 <<actor>>【이가】 마지막 막에서 옷을 벗습니다. 연극이 이미 끝났기 때문에 도렌은 개입할 기회가 없습니다.",
			"연극은 위대한 전투의 이야기를 따르며, 배우들은 임시변통의 중세 갑옷을 입고 있습니다.",
			"배우들은 남편에게 환멸을 느낀 주부가 삶에서 더 많은 것을 찾기 위해 그를 떠나는 짧은 연극을 합니다.",
			"연극 도중 배우 중 한 명의 의상이 찢어져 방 안의 모두에게 노출됩니다. 도렌은 재빨리 <<him>>에게 담요를 덮어주고 <<him>>【을를】 무대 뒤로 서둘러 보냅니다.",
			"학생 중 한 명이 대본에 쓰인 것보다 훨씬 긴 독백을 하기로 결정하면서 연극이 길어집니다.",
			"연극 도중, 학생 중 한 명이 다른 <<actor>>【이가】 <<him>>【을를】 만지자 비명을 지르고, 도렌은 연극을 일찍 끝내고 다른 학생을 집으로 보내야 합니다.",
			"연극 도중, <<actor>> 한 명이 <<his>> 의상에 문제가 생겨 옷이 흘러내리고 관객 전체에게 노출됩니다.",
			"연극 중간에, 배경에 있던 학생 중 한 명이 <<his>> 기회를 보고 바지를 내립니다. 도렌이 <<him>>【을를】 덮치고, 나머지 연극은 어찌어찌 계획대로 끝납니다.",
			"연극은 1920년대 한 가족의 고군분투를 묘사하며, 배우들은 더러운 옷과 누더기를 입고 있습니다.",
			"연극은 연휴를 위해 모인 기능 장애 가족에 대한 다크 코미디로 끝납니다.",
			"학생들은 시장이 섹스 스캔들에 휘말리는 정치 풍자극을 연기합니다. 이는 관객 중 몇몇의 특별한 관심을 끕니다.",
			"학생들은 코미디 연기 중 진지하게 연기하려고 애쓰면서 캐릭터를 깨지 않으려고 고군분투합니다. 하지만 공연은 좋은 평가를 받습니다.",
			"로맨틱 코미디는 두 학생이 한 장면을 위해 담요 아래에 숨으면서 지나치게 성적으로 변합니다. 그들은 명백히 공공장소에서 성교를 하고 있습니다.",
			"연극은 주연 <<actor>>【이가】 독백 도중 <<his>> 바지를 내릴 때까지 순조롭게 진행되는 것처럼 보입니다. 도렌은 <<him>>【을를】 담요로 덮고, <<him>>【을를】 무대 밖으로 데리고 나갑니다."
		]>>
	<</if>>
	<<set _randomPlay to $randomPlayPool.pluck()>>
<</silently>><<print _randomPlay>><</widget>>

<<widget "sterlingTitle">><<silently>>
	<<set _text_output to ($englishPlayPronouns.Sterling is "m" ? "스털링 씨" : "스털링 부인")>>
<</silently>><<print _text_output>><</widget>>

<<widget "sterlingFather">><<silently>>
	<<set _text_output to ($englishPlayPronouns.Sterling is "m" ? "아버지" : "어머니")>>
<</silently>><<print _text_output>><</widget>>

<<widget "sterlingSir">><<silently>>
