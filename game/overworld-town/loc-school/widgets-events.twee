		<<if $schoolrep.crossdress gte 5 and !$worn.face.type.includes("mask")>>
			<<addinlineevent "fame_crossdress">>
				/* Note: This ladder has multiple sections of code that are duplicate except for the gender being used.
				Those sections are (appear-f,gender-f,no-belly)=(appear-m,gender-m,no-belly) and (appear-f,gender-m,no-belly)=(appear-m,gender-f,no-belly)
				In those sections, any adjustments you make should be also made in their mirror version, as long as the changes are not gender specific.*/

				<<generatey1>><<generatey2>><<generatey3>> 당신의 뒤에서 세 명의 학생이 속삭이는 소리가 들린다.
				<br><br>
				<<if $player.gender_appearance is "f">>
					<<if $player.sex is "f">>
						<<if playerBellyVisible()>>
							<<person1>>
							<<switch random(1,3)>>
								<<case 1>>"쟤가 남자애처럼 입는다고?" <<person>>【이가】 묻는다. "어떻게? 저렇게 임신했는데."
								<<case 2>>"쟤가 남자처럼 옷을 입는다는 게 확실해?" <<person>>【이가】 묻는다. "애초에 남자 옷을 입을 수나 있겠어."
								<<case 3>>"남자처럼 옷을 입을 리가 없어," <<person>>【이가】 말한다. "저 <<bellyDescription pc>>【으로로】는 무리야."
							<</switch>>
							<br>
							<<person2>>
							<<switch random(1,3)>>
								<<case 1>>"항상 그러진 않나 봐," <<person>>【이가】 대답한다. "남자 탈의실에 몰래 들어가려고 그런 거겠지."
								<<case 2>>"가끔씩만 그럴지도," <<person>>【이가】 대답한다. "누굴 꼬셔서 임신하려고 속인 게 분명해."
								<<case 3>>"뭐, 항상 그러는 건 아니래," <<person>>【이가】 대답한다. "남자 화장실에 가려고 그런 걸지도."
							<</switch>>
							<br>
							<<person3>>
							<<switch random(1,3)>>
								<<case 1>>"이유가 뭐든 간에," <<person>>【이가】 덧붙인다, "변태네."
								<<case 2>>"분명히 그럴 거야," <<person>>【이가】 덧붙인다. "정말 미친년이라니까!"
								<<case 3>>"여전히 변태는 변태지," <<person>>【이가】 덧붙인다, "이유야 어찌됐든."
							<</switch>>
							<<schoolrep crossdress -3>>
						<<elseif !playerBellyVisible()>>
							<<person1>>
							<<switch random(1,3)>>
								<<case 1>>"쟤가 남자애처럼 옷을 입어?" <<person>>【이가】 묻는다. "지금은 그냥 여자애 같잖아."
								<<case 2>>"쟤야?" <<person>>【이가】 묻는다. "남자처럼 입고 다닌다는 애? 생긴 것만 봐선 모르겠는데."
								<<case 3>>"남장하는 거 맞아?" <<person>>【이가】 묻는다. "남자애 같진 않은데."
							<</switch>>
							<br>
							<<person2>>
							<<switch random(1,3)>>
								<<case 1>>"항상 그러진 않나 봐," <<person>>【이가】 대답한다. "섹스하려고 남들 속이는 걸지도 몰라."
								<<case 2>>"원할 때만 남자처럼 보이나 봐," <<person>>【이가】 대답한다. "분명 속여서 섹스하려고 하는 걸 거야."
								<<case 3>>"항상 남자처럼 보이는 건 아닌가 봐," <<person>>【이가】 대답한다. "꼬시려고 저러는 것 같아."
							<</switch>>
							<br>
							<<person3>>
							<<switch random(1,3)>>
								<<case 1>>"이유가 어쨌든," <<person>>【이가】 덧붙인다, "좀 이상하네."
								<<case 2>>"틀림없이 그럴 거야," <<person>>【이가】 덧붙인다. "변태네."
								<<case 3>>"어쨌든," <<person>>【이가】 덧붙인다, "정신이 좀 나갔어."
							<</switch>>
						<</if>>
					<<elseif $player.sex is "m">>
						<<if playerBellyVisible()>>
							<<person1>>
							<<switch random(1,3)>>
								<<case 1>>"진짜 남자애 맞아?" <<person>>【이가】 묻는다. "완전 임신했잖아. 어떻게 남자애가 임신을 해?"
								<<case 2>>"네가 착각한 거겠지," <<person>>【이가】 말한다. "저게 남자일 리가 없잖아. 임신했다니까!"
								<<case 3>>"딱 봐도 임신이잖아," <<person>>【이가】 말한다. "남자일 리가 없어. 저기 좀 봐!"
							<</switch>>
							<br>
							<<person2>>
							<<switch random(1,3)>>
								<<case 1>>"맞아," <<person>>【이가】 덧붙인다, "남자가 임신했다는 소린 들어본 적도 없어."
								<<case 2>>"진짜, 과학 시간에 그만 좀 자라," <<person>>【이가】 덧붙인다. "딱 봐도 여자잖아."
								<<case 3>>"남자가 임신할 순 없지," <<person>>【이가】 덧붙인다. "네가 들은 앤 쟤가 아닐 거야."
							<</switch>>
							<br>
							<<person3>>
							<<switch random(1,3)>>
								<<case 1>>"그렇다 쳐도, 저 <<bellyDescription pc>> 좀 봐," <<person>>【이가】 대답한다. "남자가 아니라 해도 완전 걸레네."
								<<case 2>>"어느 쪽이든," <<person>>【이가】 대답한다, "저런 모습으로 학교에 오다니, 진짜 뻔뻔하다."
								<<case 3>>"상관없어," <<person>>【이가】 대답한다. "저런 꼴로 다니는 변태라는 건 마찬가지니까."
							<</switch>>
							<<schoolrep crossdress -3>>
						<<elseif !playerBellyVisible()>>
							<<person1>>
							<<switch random(1,3)>>
								<<case 1>>"진짜 남자에 맞아?" <<person>>【이가】 묻는다. "그냥 여자애 같은데."
								<<case 2>>"네가 착각한 거 아니야?" <<person>>【이가】 말한다. "남자에일 리가 없어."
								<<case 3>>"완전 여잔데," <<person>>【이가】 말한다. "남자는 저렇게 안 생겼어."
							<</switch>>
							<br>
							<<person2>>
							<<switch random(1,3)>>
								<<case 1>>"틀림없어. 쟤 남자야," <<person>>【이가】 대답한다. "섹스하려고 남들 속이는 걸지도 몰라."
								<<case 2>>"걔 맞아. 남자애," <<person>>【이가】 대답한다. "선생들이랑 하려고 저러는 걸지도."
								<<case 3>>"남자애 맞아. 확실해," <<person>>【이가】 대답한다. "여자애들한테 접근하려고 저러는 거겠지."
							<</switch>>
							<br>
							<<person3>>
							<<switch random(1,3)>>
								<<case 1>>"상관없어. 이상한 애야," <<person>>【이가】 덧붙인다. "그거면 충분해."
								<<case 2>>"완전 변태네," <<person>>【이가】 덧붙인다. "조심하라고 말해야겠어."
								<<case 3>>"완전 징그럽다," <<person>>【이가】 덧붙인다. "아무도 모를 줄 알았나 보지?"
							<</switch>>
						<</if>>
					<</if>>
				<<elseif $player.gender_appearance is "m">>
					<<if $player.sex is "f">>
						<<if playerBellyVisible()>>
