:: Widgets Exams [widget]
<<widget "exam">>
	<<switch _args[0]>>
		<<case "science">>
			<<set $exam_chance to $science_exam>><<set $_teacher_name to "Sirris">>
		<<case "maths">>
			<<set $exam_chance to $maths_exam>><<set $_teacher_name to "River">>
		<<case "english">>
			<<set $exam_chance to $english_exam>><<set $_teacher_name to "Doren">>
		<<case "history">>
			<<set $exam_chance to $history_exam>><<set $_teacher_name to "Winter">>
		<<case "housekeeping">>
			<<set $exam_chance to $housekeeping / (2 * setup.foodstuff[$chosen_recipe].recipe.difficulty)>>
			<<set $_teacher_name to "River">>
		<<default>>
			<<run throw new Error("Invalid argument passed to 'exam' widget: ", _args[0])>>
	<</switch>>
	이해력: <span class="black"><<print Math.trunc($exam_chance)>>%</span>
	<br>
	<<if C.npc[$_teacher_name].love gte 10>>
		<<set $exam_chance += 5>>
		<span class="green"><<print window.KR.personNameDict[$_teacher_name] || $_teacher_name>>의 <<print setup.loveAlias[$_teacher_name]()>>:</span> <span class="black">+5%</span>
		<br>
	<</if>>
	<<if $delinquency lte 400>>
		<<set $exam_chance += 5>>
		<span class="green">모범생:</span> <span class="black">+5%</span>
		<br>
	<</if>>
	<<if _args[0] is "maths">>
		<<if $whitneymaths is "active">>
			<<set $exam_chance -= 5>>
			<span class="pink">휘트니의 방해:</span> <span class="black">-5%</span>
			<br>
		<<elseif $whitneymaths is "seat">>
			<<set $exam_chance -= 10>>
			<span class="red">휘트니의 방해:</span> <span class="black">-10%</span>
			<br>
		<</if>>
	<</if>>
	<<if $drunk gte 1>>
		<<set _drunk to Math.ceil($drunk / 50)>>
		<<set $exam_chance -= _drunk>>
		<span class="purple">술에 취함:</span> <span class="black">-_drunk%</span>
		<br>
	<</if>>
	<<if $anxiety gte 2>>
		<<set $exam_chance -= 20>>
		<span class="red">매우 초조함:</span> <span class="black">-20%</span>
		<br>
	<<elseif $anxiety gte 1>>
		<<set $exam_chance -= 10>>
		<span class="red">초조함:</span> <span class="black">-10%</span>
		<br>
	<</if>>
	<<if $arousal gte 8000>>
		<<set $exam_chance -= 10>>
		<span class="lewd">발정남:</span> <span class="black">-10%</span>
		<br>
	<<elseif $arousal gte 6000>>
		<<set $exam_chance -= 5>>
		<span class="lewd">흥분함:</span> <span class="black">-5%</span>
		<br>
	<</if>>

	합격 확률: <<print Math.trunc($exam_chance)>>%
<</widget>>

<<widget "exam_result">>
	<<set $_subject to _args[0]>>
	<<if $exam_chance gte V[$_subject + '_exam_difficulty']>>
		<<if V[$_subject + 'trait'] gte 4>>
			<<school_skill_up $_subject>>
			첫 페이지에 동그라미 쳐진 <<school_mark $_subject>>【이가】 인쇄되어 있고, 그 옆에 초록색 잉크로 <span class="green">"우수"</span>라고 적혀 있다.<<ggcontrol>><<control 25>><<ldelinquency>><<detention -6>>
			<<distinction_stat>>
		<<else>>
			<<school_skill_up $_subject>>
			첫 페이지에 동그라미 쳐진 <<school_mark $_subject>>【이가】 인쇄되어 있다. <span class="green">점수가 올랐다!</span>
			<br>
			<<school_skill_up_text $_subject>>
		<</if>>
	<<else>>
		첫 페이지에 동그라미 쳐진 <<school_mark $_subject>>【이가】 인쇄되어 있다. 예상했던 점수다.
	<</if>>
	<<unset $exam_chance>>
<</widget>>

<<widget "exam_difficulty">>
	<<set $science_exam_difficulty to random(1, 100)>>
	<<set $maths_exam_difficulty to random(1, 100)>>
	<<set $english_exam_difficulty to random(1, 100)>>
	<<set $history_exam_difficulty to random(1, 100)>>
<</widget>>

<<widget "school_mark">><<silently>>
	<<set $_trait to V[_args[0] + 'trait']>>
	<<switch Math.clamp($_trait,-1,4)>>
		<<case 4>> <<set _text_output to '<span class="green">A+</span>'>>
		<<case 3>> <<set _text_output to '<span class="teal">A</span>'>>
		<<case 2>> <<set _text_output to '<span class="lblue">B</span>'>>
		<<case 1>> <<set _text_output to '<span class="blue">C</span>'>>
		<<case 0>> <<set _text_output to '<span class="purple">D</span>'>>
		<<default>> <<set _text_output to '<span class="red">F</span>'>>
	<</switch>>
<</silently>><<print _text_output>><</widget>>

<<widget "school_skill_up">>
	<<school_skill_change _args[0] 1>>
<</widget>>

<<widget "school_skill_down">>
	<<school_skill_change _args[0] -1>>
<</widget>>

<<widget "school_skill_change">>
	<!-- args[0] is the school subject, while args[1] is the change in value (1 or -1) -->
	<<set $_skill to _args[0]>>
	<<set $_change to _args[1]>>
	<<set $_trait to $_skill + "trait">>

	<<set V[$_trait] to Math.clamp(V[$_trait] + $_change, -1, 4)>>
	<<set V[$_skill] to [0,100,200,400,700,1000][V[$_trait] + 1]>>
	<<set V[$_skill + '_exam'] to 0>>
<</widget>>

<<widget "exam_cheat">>
	<<set $_trait to V[_args[0] + 'trait']>>
	<<set $skulduggerydifficulty to [100,200,400,700,1100,1100][Math.clamp($_trait + 1, 0, 5)]>>
<</widget>>

<<widget "science_skill_up_text">>
	<<school_skill_up_text "science">>
<</widget>>

<<widget "maths_skill_up_text">>
	<<school_skill_up_text "maths">>
<</widget>>

<<widget "english_skill_up_text">>
	<<school_skill_up_text "english">>
<</widget>>

<<widget "history_skill_up_text">>
	<<school_skill_up_text "history">>
<</widget>>

<<widget "school_skill_up_text">>
	<<switch _args[0]>>
		<<case "science">><<set $_subject to "과학">>
		<<case "maths">><<set $_subject to "수학">>
		<<case "english">><<set $_subject to "영어">>
		<<case "history">><<set $_subject to "역사">>
		<<case "housekeeping">><<set $_subject to "가사">>
		<<default>><<set $_subject to _args[0].toUpperFirst()>>
	<</switch>>
	<<set $_trait to V[_args[0] + 'trait']>>
	<<if $_trait lt 1>>
		계속 노력하면 분명 도움이 된다.
	<<else>>
		<<set $_colour to ["","blue", "lblue", "teal", "green"][$_trait]>>
		<<set $_traitname to ["", "나쁘지 않은", "꽤 좋은", "좋은", "훌륭한"][$_trait] + " " + $_subject>>
		<span class="gold">
			<span @class="$_colour">$_traitname 성적</span> 특성을 획득했다.
		</span>

		<<switch _args[0]>>
			<<case "science">>
				<<switch $_trait>>
					<<case 4>> 고통을 훨씬 더 쉽게 견딜 수 있게 된다. <!-- Excellent Science -->
					<<case 3>> 고통을 더 쉽게 견딜 수 있게 된다. <!-- Good Science -->
					<<case 2>> 고통을 어느 정도 더 쉽게 견딜 수 있게 된다. <!-- Decent Science -->
					<<case 1>> 고통을 조금 더 쉽게 견딜 수 있게 된다. <!-- Passable Science -->
				<</switch>>
			<<case "maths">>
				<<switch $_trait>>
					<<case 4>> 팁과 협상한 대가로 받는 돈이 100% 증가한다. <!-- Excellent Maths -->
					<<case 3>> 팁과 협상한 대가로 받는 돈이 75% 증가한다. <!-- Good Maths -->
					<<case 2>> 팁과 협상한 대가로 받는 돈이 50% 증가한다. <!-- Decent Maths -->
					<<case 1>> 팁과 협상한 대가로 받는 돈이 25% 증가한다. <!-- Passable Maths -->
				<</switch>>
			<<case "english">>
				<<switch $_trait>>
					<<case 4>> 말하기 행동의 효과가 다섯 배가 된다. <!-- Excellent English -->
					<<case 3>> 말하기 행동의 효과가 네 배가 된다. <!-- Good English -->
					<<case 2>> 말하기 행동의 효과가 세 배가 된다. <!-- Decent English -->
					<<case 1>> 말하기 행동(애원, 신음, 요구, 사과, 조롱, 유혹)의 효과가 두 배가 된다. <!-- Passable English -->
				<</switch>>
			<<case "history">>
				<<switch $_trait>>
					<<case 4>> 마을 곳곳의 비밀 통로를 더 많이 알게 된다. <!-- Excellent History -->
					<<case 3>> 마을 곳곳의 비밀 통로를 더 많이 알게 된다. <!-- Good History -->
					<<case 2>> 마을 곳곳의 비밀 통로를 더 많이 알게 된다. <!-- Decent History -->
					<<case 1>> 마을 곳곳의 비밀 통로를 알게 된다. <!-- Passable History -->
				<</switch>>
		<</switch>>
	<</if>>
	<<if $_trait lt 4>>
		하지만 다음 시험은 더 어려워질 것이다.
	<</if>>
<</widget>>

:: Science Exam
<<schooleffects>><<effects>><<wearProp "pen">>

<<set _time_temp to (59 - Time.minute)>>
<<pass _time_temp>>

<<npc Sirris>><<person1>>

<<switch $phase>>
	<<case 0>>
		당신은 시험에 집중하며, 다른 학생들의 사각거리는 소리와 신음 소리를 무시하려고 최선을 다한다.
	<<case 1>>
		당신은 심호흡을 하고, 압박감에 굴하지 않으려 노력한다.
	<<case 2 3 5>>
		<<if $phase is 5>>
			<<if $earSlime.corruption gte (currentSkillValue('willpower') / 10)>>
				<<skulduggerycheck>><<set _cheating to true>>
				슬라임이 통제권을 주장하려 한다. <span class="red">그것은 당신의 의지를 압도하여,</span> 시험에서 부정행위를 할 방법을 찾도록 강요한다.
			<<else>>
				당신은 슬라임의 명령을 무시하고 시험에 집중하려고 한다. 당신은 그것이 당신에게 부정행위를 강요하려다 <span class="green">실패하는 것을</span> 느끼지만, 여전히 방해가 된다. <<set $exam_chance -= 5>><<passPercent -5>>
			<</if>>
		<<else>>
			<<skulduggerycheck>><<set _cheating to true>>
			<<if $phase is 3>>당신은 <<= numberOfEarSlime() gte 2 ? "슬라임들의" : "슬라임의">> 명령에 따라 시험에서 부정행위를 할 방법을 찾는다.<</if>>
		<</if>>

		<<if _cheating>>
			당신은 시리스를 지켜본다. <<He>>【은는】 교실을 감시해야 하지만, 창밖을 보는 데 더 많은 시간을 보낸다. 조심한다면 이웃의 답을 베낄 수 있을 것이다.
			<<if $skulduggerysuccess is 1>>
				조심스럽게. <span class="green">당신은 더 어려운 몇몇 문제에 대한 답을 간신히 얻어낸다.</span>
				<<set $exam_chance += 10>><<passPercent 10>>
			<<else>>
				조심-
				<br><br>
				<span class="red">"네 시험지에나 집중해라."</span> 시리스가 당신을 똑바로 쳐다보며 말한다. <<He>>【은는】 보이는 것만큼 정신이 팔려 있지는 않았다.
				<<gstress>><<stress 6>><<set $exam_chance -= 10>><<passPercent -10>><<ggdelinquency>><<detention 5>>
			<</if>>
			<br><br>

			<<skulduggeryuseinline>>
		<</if>>
	<<case 4>>
		당신은 <<= numberOfEarSlime() gte 2 ? "슬라임들의" : "슬라임의">> 명령을 무시하고, 다른 학생들의 사각거리는 소리와 신음 소리를 무시하는 데 최선을 다한다.
<</switch>>
<br><br>

시리스는 이따금 <<his>> 시계를 본다. "끝이다." <<he>>【이가】 말한다. "결과가 나쁘지 않기를 바란다." 몇몇 학생들은 계속해서 낙서를 하지만, 시리스는 시험지를 걷기 위해 서둘러 교실을 돌아다닌다.
<br><br>

시리스가 시험지를 채점하는 동안 반 학생들은 잡담을 할 수 있다. 그들은 평소보다 더 시끄럽게 침묵의 시간을 만회하지만, 일부는 너무 긴장해서 말을 하지 못한다.
<br><br>

종이 울린다. 시리스는 문 옆에 서서, 지나가는 학생들에게 시험지를 돌려주며 미소 짓는다. <<He>>【은는】 당신의 시험지도 내민다.
<<exam_result "science">>
<br><br>

당신은 복도에 있는 학생들 무리에 합류한다.
<br><br>

<<link [[다음|Hallways]]>><<endevent>><</link>>
<br>

:: Maths Exam
<<schooleffects>><<effects>><<wearProp "pencil">>

<<set _time_temp to (59 - Time.minute)>>
<<pass _time_temp>>

<<npc River 1>><<person1>>
<<generatey2>> <!-- student who doesn't stop writing when the exam is over -->

<<switch $phase>>
	<<case 0 7>>
		<<if $phase is 7>>당신은 <<= numberOfEarSlime() gte 2 ? "슬라임들의" : "슬라임의">> 명령을 무시하고,<<else>>당신은<</if>>
		<<if $whitneymaths is "active">>
			시험에 집중하려 하지만, 휘트니가 자꾸 방해해서 집중하기 어렵다.
		<<elseif $whitneymaths is "seat">>
			시험에 집중하려 하지만, 휘트니가 간헐적으로 더듬거리는 탓에 집중하기 어렵다. <<garousal>><<arousal 300 "genitals">><<arousal 300 "bottom">>
		<<else>>
			다른 학생들이 글씨를 쓰거나 신음하는 소리를 무시하려 애쓰며 시험에 집중한다.
		<</if>>
	<<case 1>>
		<<if $whitneymaths is "active">>
			당신은 심호흡을 하고, 휘트니의 잦은 방해에 신경 쓰지 않으려 노력한다.
		<<elseif $whitneymaths is "seat">>
			당신은 심호흡을 하고, 휘트니의 간헐적인 더듬거림에 신경 쓰지 않으려 노력한다. <<garousal>><<arousal 150 "genitals">><<arousal 150 "bottom">>
		<<else>>
			당신은 심호흡을 하고, 압박감에 굴하지 않으려 노력한다.
		<</if>>
	<<case 2 6 8>>
		<<if $phase is 8>>
			<<if $earSlime.corruption gte (currentSkillValue('willpower') / 10)>>
				<<skulduggerycheck>><<set _cheating to true>>
				슬라임이 통제권을 주장하려 한다. <span class="red">그것은 당신의 의지를 압도하여,</span> 시험에서 부정행위를 할 방법을 찾도록 강요한다.
			<<else>>
				당신은 슬라임의 명령을 무시하고 시험에 집중하려고 한다. 당신은 그것이 당신에게 부정행위를 강요하려다 <span class="green">실패하는 것을</span> 느끼지만, 여전히 방해가 된다. <<set $exam_chance -= 5>><<passPercent -5>>
			<</if>>
		<<else>>
			<<skulduggerycheck>><<set _cheating to true>>
			<<if $phase is 6>>당신은 <<= numberOfEarSlime() gte 2 ? "슬라임들의" : "슬라임의">> 명령에 따라 시험에서 부정행위를 할 방법을 찾는다.<</if>>
		<</if>>
		<<generatey3>><<person3>>

		<<if _cheating>>
			옆을 힐끗 쳐다본다. 옆자리의 <<person>>【은는】 자신만만해 보인다. 당신은 아무렇지 않은 척 움직이며 시선을 가린다.
			<<if $skulduggerysuccess is 1>>
				리버의 시선을 피하려 애쓴다. <span class="green">당신은 몇몇 어려운 문제의 답을 간신히 엿보는 데 성공한다.</span>
				<<set $exam_chance += 10>><<passPercent 10>>
			<<else>>
				그러려던-
				<br><br>
				<span class="red">"앞이나 봐."</span> 리버가 <<person1>><<his>> 시선으로 당신을 꿰뚫으며 말한다. <<He>>【은는】 그 문제에 대해 더는 아무 말도 하지 않지만, 당신은 당신의 시험지가 철저한 감시 아래 놓일 것을 안다.
				<<gstress>><<stress 6>><<set $exam_chance -= 10>><<passPercent -10>><<ggdelinquency>><<detention 5>>
			<</if>>
			<br><br>

			<<skulduggeryuseinline>>
		<</if>>
	<<case 3>>
		<<npc Whitney 3>>
		<<if $danceSuccess>>
			<<wearProp "rubber">>
			휘트니가 던지는 순간 뒤를 돌아본다. <span class="green">당신은 공중에서 지우개를 낚아채는 데 성공한다.</span>
			던질 것을 빼앗긴 휘트니는 그저 노려볼 수밖에 없다.
			<<set $exam_chance += 5>><<passPercent 5>>
		<<else>>
			휘트니가 던지는 순간 뒤를 돌아보며, 공중에서 지우개를 낚아채려 한다.
			<br><br>

			<span class="red">"앞이나 봐."</span> 리버가 <<person1>><<his>> 시선으로 당신을 꿰뚫으며 말한다. <<He>>【은는】 그 문제에 대해 더는 아무 말도 하지 않지만, 당신은 당신의 시험지가 철저한 감시 아래 놓일 것을 안다.
			<<gstress>><<stress 6>><<passPercent -10>><<set $exam_chance -= 10>>
			<br><br>

			휘트니는 당신을 괴롭히는 것을 멈추지만, 당신은 <<person3>><<he>>【은는】 씩 웃고 있다는 것을 안다.
		<</if>>
	<<default>>
		<<if $phase is 4 or $phase is 5>>
			<<npc Whitney 3>><<person3>>
			당신은 <<npcUndressText `C.npc.Whitney` "lower">>,
			<<if $phase is 4>>
				손가락으로 <<his>> <<print window.KR.getPenisDescKr(C.npc.Whitney.penisdesc)>>【을를】 감싼다.
			<<else>>
				손가락을 <<his>> 클리토리스에 갖다 댄다.
			<</if>>
			당신은 <<handtext>> <<him>>【을를】 쓰다듬는다.
			<br><br>
			<<if currentSkillValue("handskill") gte random(1, 1000)>>
				리버가 알아채기 전에 빨리 <<him>>【을를】 끝내야 한다.
				<<if $phase is 4>>
					<<He>>【은는】 소리를 내지 않으려 애쓰지만, 당신의 손 위에서 <span class="green">절정하며</span> 몸을 떤다.<<bodyliquid "leftarm" "semen">>
				<<else>>
					<<He>>【은는】 소리를 내지 않으려 애쓰지만, <span class="green">절정하며</span> 몸을 떤다.
				<</if>>
				<<passPercent 5>><<set $exam_chance += 5>>
				<br><br>

				<<He>>【은는】 만족스럽게 등을 기대고, 당신이 문제지를 풀도록 내버려 둔다.
			<<else>>
				리버가 알아채기 전에 빨리 <<him>>【을를】 끝내야 한다는 것을 알지만, 움직임이 제한되어 있어 어렵다.
				<br><br>

				<span class="red">"꼼지락거리지 마."</span> 리버가 <<person1>><<his>> 시선으로 당신을 꿰뚫으며 말한다. 당신은 손을 떼고, 휘트니의 간헐적인 더듬거림을 견뎌야 한다. <<garousal>><<arousal 300 "genitals">><<arousal 300 "bottom">>
			<</if>>
		<</if>>
<</switch>>
<br><br>

리버는 내내 지켜보며, 벽에 걸린 시계를 가끔 힐끗 쳐다본다. "펜 내려놔." <<person1>><<he>>【이가】 말한다. 한 <<person2>><<person>>【이가】 계속 글을 쓰자, 리버가 <<him>>【을를】 날카롭게 쏘아본다.
<br><br>

리버는 <<person1>><<he>>【이가】 시험지를 채점하는 동안 반 학생들에게 교과서 뒤에 있는 "재미있는" 퍼즐을 풀라고 지시한다. 채점은 몇 분밖에 걸리지 않는다.
<br><br>

채점된 문제지가 당신의 책상 위에 놓인다.
<<exam_result "maths">>
<br><br>

<!-- Add text for interacting with Whitney here, if they are present? -->
<<if $whitneymaths is "seat">>
	<<endevent>>
	<<npc Whitney>><<person1>>
	휘트니는 당신의 시험 결과를 쳐다보더니 꼬깃꼬깃 뭉친 <<he>>의 시험지를 당신에게 건넨다. "이거나 갖다 버려, <<slut>>." 당신이 종이를 펴보자 그 안에는 
	<<switch random(1, 3)>>
		<<case 1>><span class="green">A+</span>
		<<case 2>><span class="teal">A</span>
		<<case 3>><span class="lblue">B</span>
	<</switch>>
	등급이 적혀 있다.
	<br><br>
<</if>>

종이 울린다. 당신은 다른 학생들과 함께 복도의 인파 속으로 섞여 들어간다.
<br><br>

<<link [[다음|Hallways]]>><<if $whitneymaths>><<set $whitneymaths to "absent">><</if>><<endevent>><</link>>
<br>


:: English Exam
<<schooleffects>><<effects>><<wearProp "pen">>

<<set _time_temp to (59 - Time.minute)>>
<<pass _time_temp>>

<<run statusCheck("Kylar")>>
<<npc Doren>><<person1>>
<<if $kylarenglishstate is "active">>
	<<npc Kylar 2>><<person2>>
<</if>>

<<switch $phase>>
	<<case 0>>
		당신은 시험에 집중하며, 다른 학생들의 사각거리는 소리와 신음 소리를 무시하려고 최선을 다한다.
	<<case 1>>
		당신은 심호흡을 하고, 압박감에 굴하지 않으려 노력한다.
	<<case 2 4 6>>
		<<if $phase is 6>>
			<<if $earSlime.corruption gte (currentSkillValue('willpower') / 10)>>
				<<skulduggerycheck>><<set _cheating to true>>
				슬라임이 통제권을 주장하려 한다. <span class="red">그것은 당신의 의지를 압도하여,</span> 시험에서 부정행위를 할 방법을 찾도록 강요한다.
			<<else>>
				당신은 슬라임의 명령을 무시하고 시험에 집중하려고 한다. 당신은 그것이 당신에게 부정행위를 강요하려다 <span class="green">실패하는 것을</span> 느끼지만, 여전히 방해가 된다. <<set $exam_chance -= 5>><<passPercent -5>>
			<</if>>
		<<else>>
			<<skulduggerycheck>><<set _cheating to true>>
			<<if $phase is 4>>당신은 <<= numberOfEarSlime() gte 2 ? "슬라임들의" : "슬라임의">> 명령에 따라 시험에서 부정행위를 할 방법을 찾는다.<</if>>
		<</if>>

		<<if _cheating>>
			도렌은 종종 당신에게 등을 돌리고 있지만, <<his>> 동선은 예측할 수 없다.
			<<if $skulduggerysuccess is 1>>
				<<He>>【은는】 언제든 돌아설 수 있지만, <span class="green">당신은 대담한 곁눈질로 옆자리 학생의 답안지를 읽는 데 성공한다.</span>
				<<set $exam_chance += 10>><<passPercent 10>>
			<<else>>
				당신은 <<he>>【이가】 지나갈 때까지 기다렸다가, 옆자리 학생을 힐끗 쳐다본다. 도렌이 휙 돌아서더니, <span class="red">당신의 책상에 <<his>> 손을 내리친다.</span>
				<br><br>

				"파리 잡았단다." <<he>>【이가】 말한다. <<He>>【은는】 당신이 부정행위를 하다 걸리는 창피함은 면하게 해주었지만, 당신의 답안지는 더욱 엄격하게 채점될 것이다.<<gstress>><<stress 6>><<set $exam_chance -= 10>><<passPercent -10>><<ggdelinquency>><<detention 5>>
			<</if>>
			<br><br>

			<<skulduggeryuseinline>>
		<</if>>
	<<case 3>>
		당신은 카일라의 시험지를 힐끗 본다. <<He>>【이가】 그것을 눈치채고는, 당신의 마음에 들고 싶어서 <<he>>【이가】 글을 쓰는 동안 <<his>> 팔로 시야를 가리지 않도록 한다. <<He>>【은는】 더 어려운 문제들에 대해 창의적인 답을 가지고 있다.
	<<case 5>>
		당신은 <<= numberOfEarSlime() gte 2 ? "슬라임들의" : "슬라임의">> 명령을 무시하고, 다른 학생들의 사각거리는 소리와 신음 소리를 무시하는 데 최선을 다한다.
<</switch>>
<br><br>

도렌이 내내 돌아다니다가, <<person1>><<his>> 책상 위의 서류함을 들어 올린다. <<He>>【은는】 교실을 돌아다니며 시험지를 걷는다.
<br><br>

"오래 안 걸릴 거란다." <<he>>【이가】 빨간 펜으로 첫 번째 시험지를 찢을 듯이 채점하며 말한다. <<He>>【은는】 터져 나오는 잡담에도 아랑곳하지 않는다. <<He>>【은는】 곧 채점을 마친다.
<br><br>

채점된 당신의 시험지가 당신 앞으로 미끄러지듯 놓인다.
<<exam_result "english">>
<br><br>

<!-- Add text for interacting with Kylar here, if they are present? -->
<<if $kylarenglishstate is "active">>
    카일라는 시험지를 들고 머뭇거리며 다가오더니,
    <<if !_kylarStatus.includes("Love")>>
			교실 밖으로 뛰쳐나간다.
		<<else>>
			당신에게 조심스럽게 묻는다. "저기, 나, 나는...
			<<switch random(1, 3)>>
			<<case 1>><span class="lblue">B</span>
			<<case 2>><span class="blue">C</span>
			<<case 3>><span class="purple">D</span>
			<</switch>>야... 내, <<kylar_pet_name>>【은는】 어때?" <<He>>【은는】 당신의 시험지를 슬쩍 훔쳐본다. <<status -3>><<lcool>>
	<</if>>
	<br><br>
<</if>>
종이 울린다. 당신은 다른 학생들과 함께 복도의 인파 속으로 뒤섞여 들어간다.
<br><br>

<<link [[다음|Hallways]]>><<endevent>><</link>>
<br>


:: History Exam
<<schooleffects>><<effects>><<wearProp "pen">>

<<set _time_temp to (59 - Time.minute)>>
<<pass _time_temp>>

<<npc Winter>><<person1>>

<<switch $phase>>
	<<case 0>>
		당신은 시험에 집중하며, 다른 학생들의 사각거리는 소리와 신음 소리를 무시하려고 최선을 다한다.
	<<case 1>>
		당신은 심호흡을 하고, 압박감에 굴하지 않으려 노력한다.
	<<case 2 3 5>>
		<<if $phase is 5>>
			<<if $earSlime.corruption gte (currentSkillValue('willpower') / 10)>>
				<<skulduggerycheck>><<set _cheating to true>>
				슬라임이 통제권을 주장하려 한다. <span class="red">그것은 당신의 의지를 압도하여,</span> 시험에서 부정행위를 할 방법을 찾도록 강요한다.
			<<else>>
				당신은 슬라임의 명령을 무시하고 시험에 집중하려고 한다. 당신은 그것이 당신에게 부정행위를 강요하려다 <span class="green">실패하는 것을</span> 느끼지만, 여전히 방해가 된다. <<set $exam_chance -= 5>><<passPercent -5>>
			<</if>>
		<<else>>
			<<skulduggerycheck>><<set _cheating to true>>
			<<if $phase is 3>>당신은 <<= numberOfEarSlime() gte 2 ? "슬라임들의" : "슬라임의">> 명령에 따라 시험에서 부정행위를 할 방법을 찾는다.<</if>>
		<</if>>

		<<if _cheating>>
			윈터는 책에 몰두해 있으며, 별로 신경 쓰지 않는 것 같다.
			<<if $skulduggerysuccess is 1>>
				당신은 그게 사실이 아니라는 것을 안다. 여기저기 선생님의 주의가 다른 곳으로 쏠리는 순간들이 있다. 당신은 그 순간들을 이용해 옆자리 학생들을 힐끗 쳐다보고, <span class="green">더 어려운 문제들의 답 몇 개를 얻어내는 데 성공한다.</span>
				<<set $exam_chance += 10>><<passPercent 10>>
			<<else>>
				당신은 기회를 틈타 옆자리 학생의 시험지를 본다.
				<br><br>
				<<if $robinhistory is "seat">>
					<span class="red">로빈이 당신을 쿡 찌른다.</span> "컨닝하면 안 돼!"
					<br><br>

					윈터가 고개를 든다. "조용." 이제는 빠져나갈 수 없을 것이다.<<gstress>><<stress 6>><<set $exam_chance -= 10>><<passPercent -10>>
				<<else>>
					<span class="red">"부정행위 금지."</span> 윈터가 고개도 들지 않고 말한다. <<he>>【이가】 아무런 내색도 하지 않았지만, 당신은 <<he>>【이가】 당신을 가리켜 말한 것임을 안다.<<gstress>><<stress 6>><<set $exam_chance -= 10>><<passPercent -10>><<ggdelinquency>><<detention 5>>
				<</if>>
			<</if>>
			<br><br>

			<<skulduggeryuseinline>>
		<</if>>
	<<case 4>>
		당신은 <<= numberOfEarSlime() gte 2 ? "슬라임들의" : "슬라임의">> 명령을 무시하고, 다른 학생들의 사각거리는 소리와 신음 소리를 무시하는 데 최선을 다한다.
<</switch>>
<br><br>

학생들이 시험을 보는 동안 윈터는 <<person1>><<his>> 책장을 넘긴다. <<He>>【이가】 책을 탁 소리 나게 덮는다. "끝." <<he>>【이가】 알린다.
<br><br>

당신은 다시 질서정연하게 줄을 선다. 윈터는 시험지를 받을 때마다 채점하는데, <<his>> 빨간 펜이 휙휙 움직인다. 당신의 것도 예외는 아니다. <<He>>【이가】 당신에게 시험지를 돌려준다.
<<exam_result "history">>
<br><br>

<!-- Add text for interacting with Robin here, if they are present? -->
<<if $robinhistory isnot "missing">>
    <<npc Robin 2>><<person2>>
    <<if C.npc.Robin.trauma gte 40>>
        로빈이 시험지를 들고 조용히 당신에게 다가온다. 두 사람은 말없이 시험 결과를 공유한다. <<He>>【은는】 
        <<switch random(1, 3)>>
            <<case 1>><span class="green">A+</span>
            <<case 2>><span class="teal">A</span>
            <<case 3>><span class="lblue">B</span>
        <</switch>>
        등급을 받았다.
    <<else>>
        "시험은 어땠어<<if $robinromance is 1>>, 내 사랑<</if>>? 난 
        <<switch random(1, 3)>>
            <<case 1>><span class="green">A+</span>야!"
            <<case 2>><span class="teal">A</span>야!"
            <<case 3>><span class="lblue">B</span>야!"
        <</switch>>
        로빈이 미소 짓는다. 당신은 <<him>>【와과】 결과를 공유한다.
    <</if>>
    <br><br>
<</if>>

종이 울리고, 당신은 복도에 있는 학생들 무리에 합류한다.
<br><br>

<<link [[다음|Hallways]]>><<endevent>><</link>>
<br>

:: Housekeeping Exam
<<schooleffects>><<effects>>

<<set _time_temp to (59 - Time.minute)>>
<<pass _time_temp>>

<<npc River 1>><<person1>>
<<generatey2>> <!-- student who doesn't stop cooking when the exam is over -->

<<switch $phase>>
	<<case 0>>
		당신은 배운 모든 것을 시험하며 레시피를 따르는 데 집중한다.
	<<case 1>>
		당신은 레시피대로 작업하며 긴장을 풀려고 노력하지만, 이는 정신없이 서두르는 다른 학생들과는 대조적이다.
<</switch>>
<<if $exam_chance gte random(1, 100)>>
	당신의 창작물은 <span class="green">먹을 수 있는 무언가</span>로 완성된다.
	<<set _exam_pass to true>>
<<else>>
	<span class="red">하지만 무언가 잘못되어,</span> 당신의 재료들은 알아볼 수 없는 꿀꿀이죽으로 변해버린다.
	<<set _exam_pass to false>>
<</if>>
<br><br>

리버는 교실을 돌아다니며 재료를 잘못 사용하거나 어지럽히는 학생들에게 날카롭게 지적한다. "1분 남았다." <<he>>【이가】 경고하자, 학생들이 마지막으로 분주하게 움직인다. "멈춰." 한 <<person2>><<person>>【이가】 선생님의 눈초리를 눈치챌 때까지 계속 작업을 한다.
<br><br>

<<person1>>리버가 교실을 길게 가로질러 걸어가며, <<his>> 눈으로 각 학생의 창작물을 차례로 훑어본다. <<He>>【은는】 맨 끝에서 멈춰 서서 돌아선 다음, 왔던 길을 되돌아온다. 이번에는 각 학생이 합격인지 불합격인지를 발표한다.
<br><br>

<<if _exam_pass is true>>
	<<He>>【은는】 당신 앞에서 잠시 멈춰 당신의 <<recipe_name $chosen_recipe>>【을를】 꼼꼼히 살핀 후, 결과를 발표한다. <span class="green">"합격."</span>
	<br><br>
	<<wearProp $chosen_recipe>>
	<<learn_recipe $chosen_recipe>>
<<else>>
	당신은 리버가 발표하기 전에 결과를 안다. <span class="red">"불합격."</span> <<he>>【이가】 속도를 늦추지 않고 말한다. 레시피를 배울 기회는 또 있을 것이다.<<ghousekeeping>><<housekeeping 1>>
	<<if random(1, 2) is 2>>
		<<set _slopProp to $hallucinations gte 2 ? "inedible tentaslop" : "inedible slop">>
		<<wearProp _slopProp>>
	<<else>>
		<<wearProp "inedible burnt">>
	<</if>>
<</if>>
<br><br>
종이 울린다. 당신은 다른 학생들과 함께 복도의 인파 속으로 뒤섞여 들어간다.
<br><br>

<<link [[다음|Hallways]]>><<unset $exam_chance>><<unset $chosen_recipe>><<endevent>><</link>>
<br>

:: Housekeeping Exam Assistant Sweet
<<effects>>

<<generatey2>> <!-- student who doesn't stop cooking when the exam is over -->
당신은 시험 프로젝터에 띄울 달콤한 레시피를 선택한다. 리버가 그것을 보고 고개를 끄덕인다. 당신은 <<him>> 뒤를 따라 교실을 돌아다니며, 재료를 잘못 사용하거나 어지럽히는 학생들에게 날카롭게 지적한다.<<gcontrol>><<control 10>>
<br><br>

"1분 남았다." 리버가 경고하자, 학생들이 마지막으로 분주하게 움직인다. "멈춰." 한 <<person2>><<person>>【이가】 선생님의 눈초리를 눈치챌 때까지 계속 작업을 한다.
<br><br>

<<person1>>당신은 리버를 따라 교실을 가로질러 걸으며, <<his>> 눈으로 각 학생의 창작물을 차례로 훑어본다. <<He>>【은는】 맨 끝에서 멈춰 서서 당신과 상의하기 위해 돌아선다. <<He>>【은는】 몇몇 요리에 대해 결정을 내리지 못했고, 당신의 의견을 원한다.
<br><br>

<<link [[관대하게 평가한다|Housekeeping Exam Assistant Lenient]]>><</link>>
<br>
<<link [[엄격하게 평가한다|Housekeeping Exam Assistant Strict]]>><</link>>
<br>

:: Housekeeping Exam Assistant Savoury
<<effects>>

<<generatey2>> <!-- student who doesn't stop cooking when the exam is over -->
당신은 시험 프로젝터에 띄울 짭짤한 레시피를 선택한다. 리버가 그것을 보고 고개를 끄덕인다. 당신은 <<him>> 뒤를 따라 교실을 돌아다니며, 재료를 잘못 사용하거나 어지럽히는 학생들에게 날카롭게 지적한다.<<gcontrol>><<control 10>>
<br><br>

"1분 남았다." 리버가 경고하자, 학생들이 마지막으로 분주하게 움직인다. "멈춰." 한 <<person2>><<person>>【이가】 선생님의 눈초리를 눈치챌 때까지 계속 작업을 한다.
<br><br>

<<person1>>당신은 리버를 따라 교실을 가로질러 걸으며, <<his>> 눈으로 각 학생의 창작물을 차례로 훑어본다. <<He>>【은는】 맨 끝에서 멈춰 서서 당신과 상의하기 위해 돌아선다. <<He>>【은는】 몇몇 요리에 대해 결정을 내리지 못했고, 당신의 의견을 원한다.
<br><br>

<<link [[관대하게 평가한다|Housekeeping Exam Assistant Lenient]]>><</link>>
<br>
<<link [[엄격하게 평가한다|Housekeeping Exam Assistant Strict]]>><</link>>
<br>

:: Housekeeping Exam Assistant Spicy
<<effects>>

<<generatey2>> <!-- student who doesn't stop cooking when the exam is over -->
