					<br>
				<</if>>
			<</if>>
			<br>
			<<getouticon>><<link [[사무실을 나간다 (0:01)|Hallways]]>><<endevent>><<pass 1>><<detention 1>><</link>><<gdelinquency>>
		<</if>>
	<<else>>
