	<<if $phase is 1>>
		<<set $phase to 0>>
		<<if $exposed gte 1 and $swimall isnot 1>>
			수업이 끝났음을 알리는 종이 울린다. 당신은 다른 학생들이 나갈 때까지 기다린다. 당신이 물에서 나올 때의 좋은 경치를 감상하고 싶은 게 분명한지 몇몇 학생들이 뭉그적거리지만, 메이슨이 그들을 몰아내어 당신이 혼자 있을 수 있게 해준다. 당신은 수영장 밖으로 나온다<<if playerBellyVisible()>>, 메이슨이 허락하고 난 후에 말이다. <<nnpc_he "Mason">>【은는】 당신을 돕기 위해 곁에 딱 붙어있는다<</if>>.
			<br><br>
		<<elseif $exposed lte 0>>
			수업이 끝났음을 알리는 종이 울린다. 당신은 수영장 밖으로 나온다<<if playerBellyVisible()>>, 메이슨이 허락하고 난 후에 말이다. <<nnpc_he "Mason">>【은는】 당신을 돕기 위해 곁에 딱 붙어있는다<</if>>.
			<br><br>
		<</if>>

		<<if $exposed lte 0 or $swimall is 1>>
			<<destinationpoolchangingroom>>
		<</if>>

		<<if $exposed gte 1>>
			<<destinationpoolchangingroom "수건">>
		<</if>>
	<<else>>
		<<set _mod to 0.2>>
		<<if $exposed gte 1>>
			<<set _mod to 1>>
		<</if>>

		<<if dangerEvent(_mod, 8900)>>
			<<eventsswimming>>
		<<else>>
			<<eventsswimmingsafe>>
		<</if>>
	<</if>>
<</widget>>

<<widget "bookRentalOptions">>
	<<if $studyBooks is undefined>>
		<<set $studyBooks to {}>>
		<<set $studyBooks.rented to "none">>
		<<set $studyBooks.stolen to "none">>
	<</if>>
	<<if (!Time.schoolDay or $schoolstate is "early" or $schoolstate is "late")>>
		도서관은 섬뜩할 정도로 조용하다.
	<<else>>
		대여 가능한 여러 교과서가 구비되어 있다.
		<<if $studyBooks.rented isnot "none">>
			다른 책을 대여하려면 먼저 빌린 책을 반납해야 한다. 현재 대여한 책은 <<if $book_rent_timer gt 0>><span class="gold"><<print $book_rent_timer>>일 후 반납해야 한다.</span><<elseif $book_rent_timer is 0>><span class="blue">오늘 반납해야 한다.</span><<else>><span class="red">반납 기한이 지났다.</span><</if>>
		<<else>>
			반납할 대여 도서가 없다.
		<</if>>
	<</if>>
	<br>
	<<switch $studyBooks.rented>>
		<<case "science">><<set _rentedName to "과학">>
		<<case "maths">><<set _rentedName to "수학">>
		<<case "English">><<set _rentedName to "영어">>
		<<case "history">><<set _rentedName to "역사">>
		<<default>><<set _rentedName to $studyBooks.rented>>
	<</switch>>

	<<switch $studyBooks.stolen>>
		<<case "science">><<set _stolenName to "과학">>
		<<case "maths">><<set _stolenName to "수학">>
		<<case "English">><<set _stolenName to "영어">>
		<<case "history">><<set _stolenName to "역사">>
		<<default>><<set _stolenName to $studyBooks.stolen>>
	<</switch>>

	<<switch $studyBooks.rented>>
		<<case "science" "maths" "English" "history">>
			<<schoolicon "library">><<link [[`${_rentedName} 교과서를 반납한다`|Book Rental]]>><<set $phase2 to "return">><</link>>
			<br>
		<<case "Raul and Janet">>
			<<schoolicon "library">><<link [["라울과 자넷"을 반납한다|Book Rental]]>><<set $phase to 5>><<set $phase2 to "return">><</link>>
			<br>
		<<case "Pinch">>
			<<schoolicon "library">><<link [[올리브색 책을 반납한다|Book Rental]]>><<set $phase to 6>><<set $phase2 to "return">><</link>>
			<br>
		<<default>>
	<</switch>>

	<<switch $studyBooks.stolen>>
		<<case "science" "maths" "English" "history">>
			<<schoolicon "library">><<link [[`훔친 ${_stolenName} 교과서를 반납한다`|Book Rental Return Stolen]]>><</link>>
			<br>
		<<case "Raul and Janet">>
			<<schoolicon "library">><<link [[훔친 "라울과 자넷" 책을 반납한다|Book Rental Return Stolen]]>><<set $phase to 5>><</link>>
			<br>
		<<case "Pinch">>
			<<schoolicon "library">><<link [[올리브색 책을 반납한다|Book Rental Return Stolen]]>><<set $phase to 6>><</link>>
			<br>
		<<default>>
	<</switch>>
	<<sydneySchedule>>
	<<if _sydney_location is "library">>
		<<if $money gte 2000 and $studyBooks.rented is "none">>
			<<if $studyBooks.stolen isnot "science">>
				<<scienceicon>><<link [[과학 교과서를 대여한다 (£20)|Book Rental]]>><<money -2000 "libraryBooks">><<set $phase2 to "rent">><<set $phase to 1>><</link>><<note "+ 과학 학습 효율" "green">>
				<br>
			<</if>>
			<<if $studyBooks.stolen isnot "maths">>
				<<mathicon>><<link [[수학 교과서를 대여한다 (£20)|Book Rental]]>><<money -2000 "libraryBooks">><<set $phase2 to "rent">><<set $phase to 2>><</link>><<note "+ 수학 학습 효율" "green">>
				<br>
			<</if>>
			<<if $studyBooks.stolen isnot "English">>
				<<englishicon>><<link [[영어 교과서를 대여한다 (£20)|Book Rental]]>><<money -2000 "libraryBooks">><<set $phase2 to "rent">><<set $phase to 3>><</link>><<note "+ 영어 학습 효율" "green">>
				<br>
			<</if>>
			<<if $studyBooks.stolen isnot "history">>
				<<historyicon>><<link [[역사 교과서를 대여한다 (£20)|Book Rental]]>><<money -2000 "libraryBooks">><<set $phase2 to "rent">><<set $phase to 4>><</link>><<note "+ 역사 학습 효율" "green">>
				<br>
			<</if>>
			<<if currentSkillValue('english') gte 300 and $studyBooks.stolen isnot "Raul and Janet">>
				<<scarleticon>><<link [["라울과 자넷"을 대여한다 (£20)|Book Rental]]>><<money -2000 "libraryBooks">><<set $phase2 to "rent">><<set $phase to 5>><</link>>
				<br>
			<</if>>
			<<if ((Time.monthName is "November" and Time.monthDay gte 24) or Time.monthName is "December") and $studyBooks.stolen isnot "Pinch">>
				<<oliveicon>><<link [[올리브색 책을 대여한다 (£20)|Book Rental]]>><<money -2000 "libraryBooks">><<set $phase2 to "rent">><<set $phase to 6>><</link>>
				<br>
			<</if>>
		<<elseif between($book_rent_timer, 1, 13)>>
			<<if $money gte 1500>>
				<<highicon>><<link [[도서 대여를 연장한다 (£15)|Book Rental]]>><<money -1500 "libraryBooks">><<set $phase2 to "renew">><</link>>
				<br>
			<<else>>
				<span class=purple>도서 대여를 연장할 돈이 부족하다.</span>
				<br>
			<</if>>
		<<elseif $money lte 2000 and $studyBooks.rented is "none">>
			<span class=purple>교과서를 대여할 돈이 부족하다.</span>
			<br>
		<</if>>
	<<else>>
		<<if (!Time.schoolDay or $schoolstate is "early" or $schoolstate is "late")>>
			<<if $studyBooks.stolen is "none">>
				<<if $studyBooks.rented isnot "science">>
					<<scienceicon>><<link [[과학 교과서를 훔친다|Book Rental]]>><<set $phase2 to "steal">><<set $phase to 1>><</link>><<crime "thievery">><<note "+ 과학 학습 효율" "green">>
					<br>
				<</if>>
				<<if $studyBooks.rented isnot "maths">>
					<<mathicon>><<link [[수학 교과서를 훔친다|Book Rental]]>><<set $phase2 to "steal">><<set $phase to 2>><</link>><<crime "thievery">><<note "+ 수학 학습 효율" "green">>
					<br>
				<</if>>
				<<if $studyBooks.rented isnot "English">>
					<<englishicon>><<link [[영어 교과서를 훔친다|Book Rental]]>><<set $phase2 to "steal">><<set $phase to 3>><</link>><<crime "thievery">><<note "+ 영어 학습 효율" "green">>
					<br>
				<</if>>
				<<if $studyBooks.rented isnot "history">>
					<<historyicon>><<link [[역사 교과서를 훔친다|Book Rental]]>><<set $phase2 to "steal">><<set $phase to 4>><</link>><<crime "thievery">><<note "+ 역사 학습 효율" "green">>
					<br>
				<</if>>
				<<if currentSkillValue('english') gte 300 and $studyBooks.rented isnot "Raul and Janet">>
					<<scarleticon>><<link [["라울과 자넷"을 훔친다|Book Rental]]>><<set $phase to 5>><<set $phase2 to "steal">><</link>><<crime "thievery">>
					<br>
				<</if>>
				<<if ((Time.monthName is "November" and Time.monthDay gte 24) or Time.monthName is "December") and $studyBooks.stolen isnot "Pinch">>
					<<oliveicon>><<link [[올리브색 책을 훔친다|Book Rental]]>><<set $phase to 6>><<set $phase2 to "steal">><</link>><<crime "thievery">>
					<br>
				<</if>>
			<<else>>
				훔친 책은 한 번에 한 권만 가지고 다닐 수 있다.
				<br>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "homeStudyOptions">>
