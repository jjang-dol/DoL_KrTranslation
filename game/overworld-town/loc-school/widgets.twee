:: Widgets School [widget]
<<widget "schooleffects">>
	<<if Time.schoolDay>>
		<<if Time.hour lte 6>>
			<<set $schoolstate to "early">><<set $schoollesson to 0>>
		<<elseif Time.hour lte 8>>
			<<set $schoolstate to "morning">><<set $schoollesson to 0>>
		<<elseif Time.hour is 9>>
			<<set $schoolstate to "first">><<set $schoollesson to 1>>
		<<elseif Time.hour is 10>>
			<<set $schoolstate to "second">><<set $schoollesson to 1>>
		<<elseif Time.hour is 11>>
			<<set $schoolstate to "third">><<set $schoollesson to 1>>
		<<elseif Time.hour is 12>>
			<<set $schoolstate to "lunch">><<set $schoollesson to 0>>
		<<elseif Time.hour is 13>>
			<<set $schoolstate to "fourth">><<set $schoollesson to 1>>
		<<elseif Time.hour is 14>>
			<<set $schoolstate to "fifth">><<set $schoollesson to 1>>
		<<elseif Time.hour lte 16>>
			<<set $schoolstate to "afternoon">><<set $schoollesson to 0>>
		<<elseif Time.hour gte 17>>
			<<set $schoolstate to "late">><<set $schoollesson to 0>>
		<</if>>

		<!-- changing room is in use a bit longer than school is in session. also include changing times before first, after fifth and during midday break -->
		<<set $changingroomstate to "empty">>
		<<if (Time.hour gt 8 or Time.hour is 8 and Time.minute gte 58) and (Time.hour lt 15 or Time.hour is 15 and Time.minute lte 4)>>
			<<if Time.minute lte 4 or Time.minute gte 58>>
				<<if Time.hour gte 14 and Time.minute gte 58>>
					<<set $changingroomstate to "own">>
				<<else>>
					<<set $changingroomstate to "other">>
				<</if>>
			<</if>>
		<</if>>

		<<if $schoolpoolundress isnot undefined>>
			<span class="yellow">당신의 옷은 <<print $schoolpoolundress is "wardrobe" ? "옷장" : $schoolpoolundress + " 탈의실">>【으로로】 옮겨졌다.</span>
			<br>
			<<unset $schoolpoolundress>>
		<</if>>

		<!-- pool room itself is in use during $schoolstate only -->
		<<if $schoolstate is "fifth">>
			<<set $poolroomstate to "own">>
		<<elseif $schoollesson is 1>>
			<<set $poolroomstate to "other">>
		<<else>>
			<<set $poolroomstate to "empty">>
		<</if>>
	<<else>>
		<<if Time.hour lte 6>>
			<<set $schoolstate to "earlynoschool">><<set $schoollesson to 0>>
		<<elseif Time.hour gte 17>>
			<<set $schoolstate to "daynoschool">><<set $schoollesson to 0>>
		<<else>>
			<<set $schoolstate to "latenoschool">><<set $schoollesson to 0>>
		<</if>>
		<<set $changingroomstate to "empty">>
		<<set $poolroomstate to "empty">>
	<</if>>
<</widget>>

<<widget "advancelesson">><!-- advances time during a lesson and sets $phase to 1 if the lesson has ended -->
	<<set _time_left to 59 - Time.minute>>
	<!-- the lesson ends at 59th minute to give time to walk to the next class -->
	<<set _state to $schoolstate>>
	<<schooleffects>>

	<<if _state isnot $schoolstate>>
		<!-- only happens if we somehow jumped into another lesson, abort! -->
		<<set $phase to 1>>
	<<elseif _time_left gte 23>>
		<!-- make sure that there's at least a couple of minutes left for the next phase of a lesson -->
		<<pass 20>>
	<<else>>
	<!-- end of the lesson -->
		<<set $phase to 1>>
		<<pass _time_left>>
	<</if>>
	<<schooleffects>>
	<!-- an extra variable for use in adding learning points, stress, etc.
		1 point per 5 minutes + 1 for being present at the end of the lesson -->
	<<set _lesson_progress to (_time_left gte 20 ? 4 : Math.trunc(_time_left / 5)) + $phase>>
<</widget>>

<<widget "lessonEnd">>
	<<endevent>>
	종이 울리며, <<print _args[1] is "sleep" ? "당신을 깜짝 놀라 깨운다. 당신은 게슴츠레한 눈으로" : "수업이 끝났음을 알린다. 당신은">>
	<<storeon _args[0] "check">>
	<<if _store_check is 1>>
		<<storeon _args[0]>>
		외투를 챙기고
	<</if>>
	교실을 나선다.
	<br><br>
	<<delinquency -1 "bonus">>

	<<if $weekly.schoolNightPoolParty is undefined and $rng gte 96>>
		<<set $weekly.schoolNightPoolParty to "intro">>

		<<generates1>><<person1>>
		학생 몇 명이 복도에서 당신을 지나친다. 당신은 그들의 대화를 엿듣게 된다.
		<br><br>
		"그래, <span class="gold">오늘 밤이야</span>." <<person>>【이가】 <<his>> 친구들에게 말한다. "울타리만 넘으면, 만사형통이라고."
		<br><br>
		그들이 떠나면서, <<his>> 말은 복도의 소음에 묻혀 흐릿해진다.
		<br><br>
		<<endevent>>
	<</if>>

	<<if _args[0] is "mathsClassroom" and $whitneymaths isnot undefined>>
		<!-- set whitney's state to "absent" after the lesson ends so that we can use mathsWhitneyAttendChance to put them back in class on the next day -->
		<!-- Note: if you want to know whether or not Whitney attended maths class, but class has already ended, you'll need to change how this system works. -->
		<<set $whitneymaths to "absent">>
	<</if>>
	<<if _args[0] is "historyClassroom" and $robinhistory isnot "missing" and $robinReunionScene isnot undefined>>
		<<link [[다음|Robin After Class]]>><</link>>
	<<else>>
		<<link [[다음|Hallways]]>><</link>>
	<</if>>
<</widget>>

<<widget "lessonEvents">>
	<<set $_mod to _args[1] or 1>> <!-- $_mod multiplies the effect that allure has on your odds of getting an unsafe event -->

	<<if dangerEvent($_mod, 8900)>>
		<<switch _args[0]>>
			<<case "maths">><<eventsmaths>>
			<<case "science">><<eventsscience>>
			<<case "history">><<eventshistory>>
			<<case "english">><<eventsenglish>>
			<<case "housekeeping">><<eventshousekeeping>>
		<</switch>>
	<<else>>
		<<switch _args[0]>>
			<<case "maths">><<eventsmathssafe>>
			<<case "science">><<eventssciencesafe>>
			<<case "history">><<eventshistorysafe>>
			<<case "english">><<eventsenglishsafe>>
			<<case "housekeeping">><<eventshousekeepingsafe>>
		<</switch>>
	<</if>>
<</widget>>

<<widget "schoolperiod">>
	<<if $exposed lte 0>>
		<<if $schoolstate is "morning" or ($schoolstate is "first" and Time.minute lte 58)>>
			<<scienceicon>><<link [[과학 수업을 듣는다 (0:01)|Science Classroom]]>><<set $justEntered to true>><<pass 1>><</link>>
			<br><br>
		<<elseif $schoolstate is "first" or ($schoolstate is "second" and Time.minute lte 58)>>
			<<if Time.weekDay is 3 or Time.weekDay is 5>>
				<<icon "housekeeping.png">><<link [[가사 수업을 듣는다 (0:01)|Housekeeping Classroom]]>><<set $justEntered to true>><<pass 1>><</link>>
				<br><br>
			<<else>>
				<<mathicon>><<link [[수학 수업을 듣는다 (0:01)|Maths Classroom]]>><<set $justEntered to true>><<pass 1>><</link>>
				<br><br>
			<</if>>
		<<elseif $schoolstate is "second" or ($schoolstate is "third" and Time.minute lte 58)>>
			<<englishicon>><<link [[영어 수업을 듣는다 (0:01)|English Classroom]]>><<set $justEntered to true>><<pass 1>><</link>>
			<br><br>
		<<elseif $schoolstate is "third" or ($schoolstate is "lunch" and Time.minute lte 58)>>
			<<foodicon "eat">><<link [[학생들을 따라 급식실로 간다 (0:01)|Canteen]]>><<pass 1>><</link>>
			<br>
			<<historyicon>><<link [[역사 교실에서 기다린다 (0:01)|History Classroom]]>><<set $justEntered to true>><<pass 1>><</link>>
			<br><br>
		<<elseif $schoolstate is "lunch" or ($schoolstate is "fourth" and Time.minute lte 58)>>
			<<historyicon>><<link [[역사 수업을 듣는다 (0:01)|History Classroom]]>><<set $justEntered to true>><<pass 1>><</link>>
			<br><br>
		<<elseif $schoolstate is "fourth" or ($schoolstate is "fifth" and Time.minute lte 58)>>
			<<swimmingicon>><<link [[수영 수업을 듣는다 (0:01)|School Pool Entrance]]>><<set $justEntered to true>><<pass 1>><</link>>
			<br><br>
		<</if>>
	<</if>>
<</widget>>

<<widget "schoolperiodtext">>
    <<if $schoolstate is "morning">>
        과학 수업은 <<ampm 9 00>>에 시작한다.
        <br><br>
    <<elseif $schoolstate is "first" and Time.minute lte 58>>
        과학 수업은 <<ampm 9 00>>에 시작했다!
        <br><br>
    <<elseif $schoolstate is "first">>
        <<if Time.weekDay is 3 or Time.weekDay is 5>>
            가사 수업은 <<ampm 10 00>>에 시작한다.
            <br><br>
        <<else>>
            수학 수업은 <<ampm 10 00>>에 시작한다.
            <br><br>
        <</if>>
    <<elseif $schoolstate is "second" and Time.minute lte 58>>
        <<if Time.weekDay is 3 or Time.weekDay is 5>>
            가사 수업은 <<ampm 10 00>>에 시작했다!
            <br><br>
        <<else>>
            수학 수업은 <<ampm 10 00>>에 시작했다!
            <br><br>
        <</if>>
    <<elseif $schoolstate is "second">>
        영어 수업은 <<ampm 11 00>>에 시작한다.
        <br><br>
    <<elseif $schoolstate is "third" and Time.minute lte 58>>
        영어 수업은 <<ampm 11 00>>에 시작했다!
        <br><br>
    <<elseif $schoolstate is "lunch">>
        역사 수업은 <<ampm 13 00>>에 시작한다.
        <br><br>
    <<elseif $schoolstate is "fourth" and Time.minute lte 58>>
        역사 수업은 <<ampm 13 00>>에 시작했다!
        <br><br>
    <<elseif $schoolstate is "fourth">>
        수영 수업은 <<ampm 14 00>>에 시작한다.
        <br><br>
    <<elseif $schoolstate is "fifth">>
        수영 수업은 <<ampm 14 00>>에 시작했다!
        <br><br>
    <</if>>
<</widget>>

<<widget "classgrades">>
    <<if $schoolstate is "morning" or ($schoolstate is "first" and Time.minute lte 58)>>
        <<if $sciencetrait gte 4>>
            현재 과학 성적은 <span class="green">A+</span>이다. 이 수업에서 더 이상 배울 것이 없다.
        <<elseif $sciencetrait gte 3>>
            현재 과학 성적은 <span class="teal">A</span>이다. 당신은 최고의 학생 중 하나이지만, 더 높은 성취를 이룰 수 있다.
        <<elseif $sciencetrait gte 2>>
            현재 과학 성적은 <span class="lblue">B</span>이다. 최고의 성적은 아니지만, 최악도 아니다.
        <<elseif $sciencetrait gte 1>>
            현재 과학 성적은 <span class="blue">C</span>이다. 약간의 발전이 있었지만, 여전히 더 공부해야 한다.
        <<elseif $sciencetrait gte 0>>
            현재 과학 성적은 <span class="purple">D</span>이다. 아직 갈 길이 멀다.
        <<else>>
            현재 과학 성적은 <span class="red">F</span>이다. 당신은 반에서 가장 성적이 낮은 학생이다.
        <</if>>
    <<elseif $schoolstate is "first" or ($schoolstate is "second" and Time.minute lte 58)>>
        <<if $mathstrait gte 4>>
            현재 수학 성적은 <span class="green">A+</span>이다. 이 수업에서 더 이상 배울 것이 없다.
        <<elseif $mathstrait gte 3>>
            현재 수학 성적은 <span class="teal">A</span>이다. 당신은 최고의 학생 중 하나이지만, 더 높은 성취를 이룰 수 있다.
        <<elseif $mathstrait gte 2>>
            현재 수학 성적은 <span class="lblue">B</span>이다. 최고의 성적은 아니지만, 최악도 아니다.
        <<elseif $mathstrait gte 1>>
            현재 수학 성적은 <span class="blue">C</span>이다. 약간의 발전이 있었지만, 여전히 더 공부해야 한다.
        <<elseif $mathstrait gte 0>>
            현재 수학 성적은 <span class="purple">D</span>이다. 아직 갈 길이 멀다.
        <<else>>
            현재 수학 성적은 <span class="red">F</span>이다. 당신은 반에서 가장 성적이 낮은 학생이다.
        <</if>>
    <<elseif $schoolstate is "second" or ($schoolstate is "third" and Time.minute lte 58)>>
        <<if $englishtrait gte 4>>
            현재 영어 성적은 <span class="green">A+</span>이다. 이 수업에서 더 이상 배울 것이 없다.
        <<elseif $englishtrait gte 3>>
            현재 영어 성적은 <span class="teal">A</span>이다. 당신은 최고의 학생 중 하나이지만, 더 높은 성취를 이룰 수 있다.
        <<elseif $englishtrait gte 2>>
            현재 영어 성적은 <span class="lblue">B</span>이다. 최고의 성적은 아니지만, 최악도 아니다.
        <<elseif $englishtrait gte 1>>
            현재 영어 성적은 <span class="blue">C</span>이다. 약간의 발전이 있었지만, 여전히 더 공부해야 한다.
        <<elseif $englishtrait gte 0>>
            현재 영어 성적은 <span class="purple">D</span>이다. 아직 갈 길이 멀다.
        <<else>>
            현재 영어 성적은 <span class="red">F</span>이다. 당신은 반에서 가장 성적이 낮은 학생이다.
        <</if>>
    <<elseif $schoolstate is "lunch" or ($schoolstate is "fourth" and Time.minute lte 58)>>
        <<if $historytrait gte 4>>
            현재 역사 성적은 <span class="green">A+</span>이다. 이 수업에서 더 이상 배울 것이 없다.
        <<elseif $historytrait gte 3>>
            현재 역사 성적은 <span class="teal">A</span>이다. 당신은 최고의 학생 중 하나이지만, 더 높은 성취를 이룰 수 있다.
        <<elseif $historytrait gte 2>>
            현재 역사 성적은 <span class="lblue">B</span>이다. 최고의 성적은 아니지만, 최악도 아니다.
        <<elseif $historytrait gte 1>>
            현재 역사 성적은 <span class="blue">C</span>이다. 약간의 발전이 있었지만, 여전히 더 공부해야 한다.
        <<elseif $historytrait gte 0>>
            현재 역사 성적은 <span class="purple">D</span>이다. 아직 갈 길이 멀다.
        <<else>>
            현재 역사 성적은 <span class="red">F</span>이다. 당신은 반에서 가장 성적이 낮은 학생이다.
        <</if>>
    <</if>>
        <br><br>
<</widget>>

<<widget "exhibitorgasm">>
	<<if $orgasmdown gte 1>><<set $orgasmdown to 0>>
		<<if $orgasmcurrent lte 0>>
		<<elseif $orgasmcurrent lte 1>>
			당신은 구속구에 묶인 채 몸을 경련한다.
			<<if $enemyno gte 2>>
				<<if $player.penisExist and $orgasmcount lte 23>>
					당신이 몸부림치자 두 사람의 눈이 반짝인다. "<<pshe>>【이가】 가고 있어!" <<person>>【이가】 소리치고는, 당신의 분비물을 피하기 위해 뒷걸음질 치면서도 경외에 찬 눈으로 바라본다.
				<<else>>
					당신이 몸부림치자 두 사람의 눈이 반짝인다. "<<pshe>>【이가】 가고 있어!" <<person>>【이가】 소리친다.
				<</if>>
			<<else>>
				<<if $player.penisExist and $orgasmcount lte 23>>
				<<else>>
				<</if>>
			<</if>>
		<<elseif $orgasmcurrent is 2>>
			당신은 구속구에 묶인 채 다시 몸을 경련한다.
			<<if $enemyno gte 2>>
				<<if $player.penisExist and $orgasmcount lte 23>>
					"한 번 이상 갈 수 있는지 몰랐어!" <<person>>【이가】 말한다.
				<<else>>
					"한 번 이상 갈 수 있는지 몰랐어!" <<person>>【이가】 말한다.
				<</if>>
			<<else>>
				<<if $player.penisExist and $orgasmcount lte 23>>
				<<else>>
				<</if>>
			<</if>>
		<<else>>
		<</if>>
		<br><br>
	<</if>>
<</widget>>

:: Widgets Events Science [widget]
<<widget "eventsscience">>
	<<cleareventpool>>

	<<if (($player.gender_appearance is "m" and $worn.legs.gender is "f") or ($player.gender_appearance is "f" and $worn.legs.gender is "m")) and $worn.legs.name.includes("gym socks")>>
		<<addinlineevent "scienceSocks" 1>>
			<<generates1>><<person1>><<person>>【이가】 당신의 발을 쳐다본다.
			<<if $worn.legs.name is "girl's gym socks">>
				"왜 여자애 양말을 신은 거야?" <<he>>【이가】 큰 소리로 묻는다. "그거 신으면 예뻐진 것 같아?"
			<<else>>
				"왜 남자애 양말을 신은 거야?" <<he>>【이가】 큰 소리로 묻는다. "그걸 신으면 네가 걸레란 걸 사람들이 잊을 것 같아?"
			<</if>>
			<<His>> 무리들이 웃음을 터뜨린다.
			<br><br>

			<<link [[걷어찬다|Science Kick]]>><<stress -12>><<trauma -6>><<detention 3>><</link>><<gdelinquency>><<ltrauma>><<lstress>>
			<br>
			<<link [[무시한다|Science Lesson]]>><<stress 6>><<trauma 6>><<endevent>><</link>><<gtrauma>><<gstress>>
			<br>
		<</addinlineevent>>
	<</if>>

	<<addinlineevent "scienceChemicals" 1>>
		반 아이들이 화학 물질을 이용해 실험을 진행한다.
		<br><br>

		<<generates1>><<person1>><<person>>【이가】 당신의 옷에 산을 흩뿌린다!
		"미안, 미끄러졌어," <<he>>【이가】 <<print either("능글맞게 웃으며","능글맞게 웃으며","능글맞게 웃으며","숨을 헉 들이켜며","당황해하며")>> 말한다.
		<br><br>

		<<set $worn.upper.integrity -= 20>>
		<<set $worn.lower.integrity -= 20>>
		<<set $worn.under_lower.integrity -= 20>>

		<<integritycheck no_text>>
		<<exposure>>

		<<if !$worn.upper.type.includes("naked") and !$worn.lower.type.includes("naked")>>
			아주 독한 산은 아니지만, 옷을 꽤 많이 상하게 한다.
		<<else>>
			산이 당신의 옷을 녹여버리고, 곧 반 전체 앞에 알몸을 노출하게 된다! 시리스가 수건을 들고 달려오는 동안, 당신은 최선을 다해 <<lewdness>>【을를】 가린다.
			<<if $uncomfortable.underwear or ($uncomfortable.nude and $worn.under_lower.type.includes("naked"))>>
				당신은 몸을 가리고 노출된 부위를 숨기려 하지만, 반 학생들은 이미 그 모습을 똑똑히 본 뒤였다.
			<<else>>
				당신은 반 학생들이 당신의 <<nudity>>【을를】 똑똑히 보도록 내버려 둔다.<<print _nudityExtra>>
			<</if>>
			<<if $worn.lower.type.includes("naked") and $worn.under_lower.type.includes("naked")>>
				<<schoolrep_naked>>
				<</if>>
			<<towelup>>

		<</if>>
		<br><br>

		<<link [[다음|Science Lesson]]>><<endevent>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "scienceFront" 2>>
		<<npc Sirris>><<person1>>시리스가 당신에게 교실 앞으로 나와달라고 한다.
		<br><br>

		<<link [[다음|Science Event3]]>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "scienceTerrarium" 2>>
		반 아이들이 교실 구석에 늘어선 테라리움 주변으로 모여든다. 당신은 안에 든 식물들을 관찰하며 어떤 종인지 식별하려 애쓴다.
		<br><br>

		<<link [[다음|Science Terrarium]]>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "scienceDelinquents" 2>>
		비행 청소년 무리가 당신을 괴롭히기로 작정한다.
		<br><br>

		<<link [[선생님에게 도움을 청한다|Science Pick]]>><<status -10>><</link>><<llcool>>
		<br>
		<<link [[참는다|Science Pick]]>><<set $phase to 1>><</link>><<gtrauma>><<gstress>>
		<br>
		<<link [[맞선다|Science Pick]]>><<set $phase to 2>><<detention 2>><</link>><<gdelinquency>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "scienceGroup" 2>>
		시리스가 모두에게 두 명씩 짝을 지으라고 말한다.
		<br><br>
		<<rng>>

		<<if $cool gte 80>>
			당신은 파트너를 찾고 함께 <<print either("양의 눈을","곤충을","벌레를","개구리를")>> 해부한다.
			<br><br>

			<<link [[해부에만 집중한다|Science Dissection]]>><<scienceskill>><</link>><<gscience>>
			<br>
			<<link [[파트너와 농담을 나눈다|Science Dissection]]>><<trauma -1>><<stress -2>><<status 1>><<set $phase to 1>><</link>><<ltrauma>><<lstress>><<gcool>>
			<br>
		<<else>>
			<<wearProp "box">>
			다른 학생들은 당신을 피하고, 당신은 결국 짝을 찾지 못한다. 시리스가 플라스틱 상자를 들고 들어오다 당신이 혼자인 것을 보고 멈춰 선다.
			<br><br>

			"너에게 특별히 맡길 일이 있단다. 학교 입구 바로 옆 헛간에 이거랑 똑같은 상자가 하나 더 있을 거야. 이리로 좀 가져와 주겠니?"
			<br><br>

			당신은 잠겨 있지 않은 헛간으로 걸어가 안쪽에서 상자를 찾는다. 정말 무겁다! 간신히 들어 올릴 정도지만, 어찌어찌 학교 안으로 다시 들고 들어간다.
			<<physique>>
			<br><br>
			<<if $rng gte 21>>
				당신이 다시 교실에 도착했을 때, 반 아이들은 이미 개구리를 해부하느라 바쁘다. 파트너가 없는 당신은 혼자서 개구리 하나를 차지하게 된다.
				<<gscience>><<scienceskill>>
				<br><br>

				<<link [[다음|Science Lesson]]>><<endevent>><</link>>
				<br>
			<<else>>
				<<generatey1>><<generatey2>><<generatey3>>
				당신은 복도에서 담배를 피우는 세 명의 불량배를 지나친다. 상자에 시야가 가려 다가오는 것을 미처 보지 못한 탓이다. 그들은 복도를 따라 당신을 끈질기게 쫓아온다.

				<<person1>><<person>>【이가】 당신의 $worn.lower.name 자락을 꽉 붙잡고 아래로 끌어내리려 한다!

				<<if $worn.under_lower.type.includes("naked")>>
					<span class="lewd">속옷을 아무것도 입지 않았다는 사실을 깨달은 당신은 등골이 오싹해진다!</span>
				<</if>>
				<br><br>

				"이 밑에 뭘 입고 있는지 한 번 볼까," <<person2>><<person>>【와과】 <<person3>><<person>>【이가】 합세할 작정으로 다가온다.
				<br><br>

				상자를 안고 있느라 두 팔이 묶인 당신은 몸을 지킬 수 없다. 안에 든 내용물을 부수지 않고 상자를 내려놓으려면 허리를 숙여야 하지만, 그러다간 훨씬 무방비한 꼴이 되고 말 것이다.
				<br><br>

				<<link [[상자를 내팽개치고 몸을 보호한다|Science Dissection]]>><<handheldon>><<set $phase to 2>><<detention 2>><</link>><<gdelinquency>>
				<br>
				<<link [[그냥 견딘다|Science Dissection]]>><<set $phase to 3>><<stress 2>><<trauma 2>><</link>><<gtrauma>><<gstress>>
				<br>
				<<link [[몸을 숙여 상자를 조심스레 내려놓는다|Science Dissection]]>><<handheldon>><<set $phase to 4>><</link>>
			<</if>>
		<</if>>
	<</addinlineevent>>

	<<runeventpool>>
<</widget>>

<<widget "eventssciencesafe">>
	<<if $settings.condomLevel isnot 0 and !$scienceCondomIntro>>
		<<scienceCondomIntro>>
		<<exit>>
	<</if>>
	<<if $scienceproject is "none" and Time.days gte 2 and $mathsprojectdays isnot (21 + (7 - Time.weekDay))>>
		<<scienceProject>>
		<<exit>>
	<</if>>
	<<cleareventpool>>
	<<set $_linkSkip to false>>

	<<addinlineevent "scienceBook" 2>>
		<<npc Sirris>><<person1>>
		시리스는 학생들에게 교과서 $rng쪽을 펴라고 한다.
		<<if $worn.handheld.name isnot "naked" and !$worn.handheld.type.includes("bookbag")>>
			당신은 가방을 잊고 왔다는 것을 너무 늦게 깨달았다.
			<<if C.npc.Sirris.love gte 10>>
			시리스는 당신을 부드럽게 꾸짖으면서도 여분의 교과서를 건네준다. "이번엔 봐주겠지만, 다음부터는 준비를 더 잘해 오렴."
			<<else>>
				시리스가 고개를 젓는다. "미안하지만, 다음에는 준비를 더 철저히 해야 한단다." <<he>>【이가】 훈계하며 여분의 교과서를 건네준다. <<detention 1>><<gdelinquency>>
			<</if>>
		<<else>>
			교실은 여유로운 분위기다. 대부분의 학생들이 읽는 것보다 잡담하는 데 시간을 더 쏟고 있다.
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "scienceVideo" 1>>
		시리스가 <<print either("자연","우주","자기장","전자","화학 결합","아인슈타인","과학적 방법의 개척자들","아이작 뉴턴","핵융합","효소의 역할","DNA")>>에 관한 짧은 비디오를 튼다. 교실은 여유로운 분위기다. 대부분의 학생들이 비디오를 시청하지만, 많은 수가 계속 잡담을 한다.
	<</addinlineevent>>

	<<addinlineevent "scienceExperiment" 1>>
		<<generates1>><<person1>>
		<<switch random(1,4)>>
			<<case 1 2>>
				<<wearProp "science flask">>
				반 학생들은 화학 물질로 실험을 진행한다. 당신은 아무것도 흘리지 않도록 조심한다.
			<<case 3>>
				<<wearProp "science flask">>
				반 학생들은 화학 물질로 실험을 진행한다. 어느 <<person>>【이가】 실수로 자신의 옷에 화학 물질을 엎지른다. 당황한 <<personsimple>>【은는】 옷이 녹기 시작하자 교실에서 뛰쳐나간다.
			<<case 4>>
				어느 <<person>>【이가】 <<print (random(1,5) is 1 ? "실수로" : "'실수로'")>> <<generates2>><<person2>><<persons>> 옷에 화학 물질을 잔뜩 엎지른다. 당황한 <<personsimple>>【은는】 옷이 녹기 시작하자 교실에서 뛰쳐나간다.
		<</switch>>
	<</addinlineevent>>

	<<addinlineevent "scienceDelinquents" 1>>
		일부 불량 학생들이 괴짜 학생 중 한 명을 괴롭힌다. 시리스는 가해자들을 교실 반대편으로 자리에서 옮기게 한다.
	<</addinlineevent>>

	<<addinlineevent "scienceSexTape" 1>>
		시리스는 인간의 생식에 관한 비디오를 튼다.
		<<if Time.days gte 25 and $rng % 3 is 0>>/*1 in 3 chance, and won't happen too early*/
			<br><br>
			전혀 교육용 영상 같지 않다—매우 노골적이다. 아주 적나라하다. 기본적으로 14분짜리 홈 섹스 테이프에 가깝다. 유일하게 '교육적인' 부분은 시리스가 주기적으로 비디오를 멈추고 어떤 신체 부위를 핥고, 쓰다듬고, 빨고, 깨물고, 삽입하고 있는지 학생들에게 퀴즈를 내는 것뿐이다.
			비디오에서 얼굴은 절대 나오지 않지만, 당신은 출연자 중 한 명이 시리스일지도 모른다고 의심하기 시작한다.
			<br>
			반 전체가 영상 속 남녀가 헐떡이며 절정에 달할 때까지 넋을 잃고 지켜본다.
			<<garousal>><<arousal 200>>
			<br><br>
			"상당히 노골적이라는 건 안단다." 시리스가 말한다. "하지만 훌륭한 과학자는 비위가 약해선 안 된단다. 인간은 동물이야. 그리고 이건 그저 동물의 행동을 관찰하는 것일 뿐이지. 게다가 사실과 용어를 아는 것만큼이나, 진짜 섹스가 무엇이고 어떻게 생겼는지 이해하는 것도 중요하단다."
			<<awarenessup 200 1>>
		<<else>>
			이 영상은 성 건강, 성병, <<if $settings.pregnancySpeechEnabled>>임신, <</if>>피임, 그리고 동의에 대해 심도 있게 다루며, 교육적인 목적에 강하게 초점을 맞추고 있다.
			관련된 신체 부위와 세포 유형을 표시한 몇 가지 간단한 다이어그램과 함께, 성의 기본적인 메커니즘을 설명한다.
			<<awarenessup 100 1>>
			<br><br>
			교실은 여유로운 분위기다. 몇몇 학생들은 비디오를 시청하지만, 진정으로 흥미를 가지는 학생은 드물고, 많은 학생들이 내내 잡담을 계속한다.
			<<if playerBellyVisible() and $settings.pregnancySpeechEnabled>>당신은 현재 처한 상황과 내면에 있는 소중한 생명을 끊임없이 상기하게 된다.<<lstress>><<stress -10>><</if>>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "scienceQuestion" 1>>
		<<npc Sirris>><<person1>>
		시리스가 학생들에게 질문을 던진다. 당신은 답을 알고 있다고 생각한다.
		<<set $_linkSkip to true>>
		<br><br>
		<<link [[손을 든다|Science Event1]]>><<set $phase to 1>><<stress 1>><<scienceskill 1>><</link>><<gstress>><<gscience>>
		<br>
		<<link [[고개를 숙이고 있는다|Science Event1]]>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "scienceAnatomy" 1>>
		<<if $player.gender_appearance is "m">><<generatesf1>><<else>><<generatesm1>><</if>>
		시리스가 방 안을 둘러보고, 잠시 당신을 힐끗 보더니 한 <<person1>><<personsimple>>에게 교실 앞으로 나와달라고 요청한다.
		<br><br>
		시리스가 <<person>>【을를】 보고 미소를 짓는다.
		<<rng>>
		<<if $scienceprogression gte 2>>
			<<He>>【은는】 불안해 보인다. "수업의 이번 부분은 인체 해부학에 관한 거란다. 네 옷을 전부 벗어주렴. 부끄러워하지 마, 수업을 위해 중요한 일이니."
			<br><br>
			<<if $rng lte 35>>
				<<set $_studentLeaves to true>>
			<<else>>
				<<personsimple>> <<print either("신나서 동의한다", "활기차게 동의한다", "무심하게 동의한다", "마지못해 동의한다", "looks like <<he>>【은는】 울고 싶은 것처럼 보이지만, 얌전히 고개를 끄덕인다", "눈물을 흘리며 동의한다")>>.
				<<He>>【이가】 옷을 벗자, 곧바로 반 전체의 이목이 집중된다. <<person>>【이가】 벌거벗은 채 앞에 서 있고, 선생님은 <<his>> 해부학적 구조의 여러 부분을 가리킨다.
				<<if $scienceprogression gte 3>>
					그러고 나서 시리스는 <<him>>에게 책상 위로 올라가 다리를 벌리라고 지시한다. 흥분한 학생들에게 더 선명한 시야를 제공하기 위해, 시리스는 <<if $NPCList[0].penis isnot "none">><<personssimple>> 자지를 들어 올린다<<else>>질경을 사용한다<</if>>.
					<<if $scienceprogression gte 4>>
						상황은 마침내 조금 통제 불능이 된다. 몇몇 학생들이 조금 '손을 대기' 시작하자 <<person>>【이가】 꽥 비명을 지른다. 마침내 통제력을 되찾고,
					<</if>>
				<</if>>
				시리스가 <<person>>에게 옷을 입고 자리에 앉으라고 하며 시범을 마무리한다.
				<br><br>

				<<person>>【이가】 불쌍하게 느껴지긴 했지만, 그 덕에 수업은 확실히 흥미로워졌고 무언가 배운 것 같다고 생각한다.
				<<gscience>><<scienceskill>>
			<</if>>
		<<elseif $scienceprogression gte 1>>
			"이 파트를 진행하려면 네가 옷을 벗어줘야 한단다. 걱정하지 마, 속옷은 입고 있어도 돼."
			<br><br>
			<<if $rng lte 25>>
				<<set $_studentLeaves to true>>
			<<elseif $rng lte 35>>
				<<set $_studentNotWearingUnderwear to true>>
			<<else>>
				<<personsimple>> <<print either("신나서 동의한다", "활기차게 동의한다", "무심하게 동의한다", "마지못해 동의한다", "looks like <<he>>【은는】 울고 싶은 것처럼 보이지만, 얌전히 고개를 끄덕인다", "눈물을 흘리며 동의한다")>>.
				<<He>>【이가】 속옷 차림으로 벗자, 곧바로 학생들의 관심이 쏠린다.
				시리스는 수업을 계속하며, <<persons>> 신체 부위들을 가리키고 다양한 기능들을 설명한다.
				시리스는 이내 시범을 마치고, <<person>>에게 옷을 입고 자리에 앉아 학생들 무리로 돌아가라고 지시한다.
				<br><br>

				<<person>>【이가】 조금 불쌍하게 느껴지긴 했지만, 그 덕에 수업은 확실히 흥미로워졌고 무언가 배운 것 같다고 생각한다.
				<<gscience>><<scienceskill>>
			<</if>>
		<<else>>
			"걱정하지 마, 거부감이 들 만한 건 하지 않을 거란다."
			<br><br>
			그다음 몇 분 동안 시리스는 여러 뼈와 장기에 대해 이야기하며, 위치를 보여주기 위해 <<persons>> 신체 부위들을 가리킨다. 흥미롭다.
			<<gscience>><<scienceskill>>
		<</if>>

		<<if $_studentNotWearingUnderwear>>
			<<personsimple>>【이가】 시리스에게 무언가를 속삭인다.
			<br><br>
			시리스의 얼굴이 새빨개지더니 서둘러 <<person>>에게 다시 자리에 앉으라고 한다. "다시 생각해보니, 얘들아, 아... 그냥 해부도를 사용하도록 하자꾸나." 시리스가 말한다. "그게 더... 명확하니까."
		<<elseif $_studentLeaves>>
			<<print either(
				"<<personsimple>>【은는】 그대로 교실 밖으로 뛰쳐나가 돌아오지 않는다.",
				"<<personsimple>>【은는】 무표정한 얼굴로 아무 말 없이 교실을 나간다.",
				"<<personsimple>>【은는】 걱정스러운 표정을 지으며 화장실에 다녀와도 되냐고 묻고는, 책상에서 <<his>> 짐을 챙겨 나간다. <<He>>【은는】 돌아오지 않는다."
			)>>
			<br><br>
			"어쩔 수 없이 낡은 해부도를 써야겠구나." 시리스가 말한다. "미안하구나, 얘들아."
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "scienceHelp" 1>>
		<<set $_linkSkip to true>>
		<<if $dissociation gte 1>>
			<<npc Sirris>><<person1>>시리스가 다가온다. "별일 없니?" <<he>>【이가】 묻는다. "너, 좀... 안 좋아 보이는구나."
			<br><br>

			<<link [[괜찮다고 말한다|Science Event2]]>><</link>>
			<br>
			<<link [[무너진다|Science Event2]]>><<set $phase to 1>><</link>>
			<br>
		<<else>>
			시리스가 당신에게 다가온다. "혹시 내가 더 설명해 줄 만한 내용이 있니?"
			<br><br>

			<<link [[예|Science Event2]]>><<set $phase to 2>><<scienceskill 1>><</link>><<gscience>>
			<br>
			<<link [[아니오|Science Event2]]>><<set $phase to 3>><</link>>
			<br>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "scienceMetals" 1>>
		반 학생들은 금속을 이용한 실험을 한다.
		<<if $science gte 600>>
			당신은 무난하게 절차를 밟아나가며 시간을 잘 분배한다. <<stress -3>><<lstress>>
		<<else>>
			당신은 지시사항을 따르느라 고전하지만, 제시간에 끝마친다.
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "sciencePlants" 1>>
		반 학생들은 여러 식물로 실험을 한다.
		<<if $backgroundTraits.includes("plantlover")>>
			당신에게 이 실험은 아주 시시하게 느껴지며, 그저 큰 식물들의 줄기를 뚫어져라 쳐다보는 데에 시간을 보낸다. <<stress -3>><<arousal 200>><<lstress>><<garousal>>
		<<elseif $science gte 600 or $tending gte 600>>
			당신은 무난하게 실험을 진행하며, 다양한 식물을 감상하는 데에 시간을 보낸다. <<stress -2>><<trauma -2>><<lstress>><<ltrauma>>
		<<else>>
			당신은 지시사항을 따르느라 고전하지만, 제시간에 끝마친다.
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "scienceBird" 1>>
		<<npc Sirris>><<person1>>
		시리스가 조류의 습성과 번식에 대한 수업을 시작한다.
		<<if $harpy gte 6>>
			당신은 발표 자료에서 황야의 사진이 나오자 겨우 꽥 소리를 참아낸다.
		<<elseif $syndromebird gte 1>>
			당신은 거대 매의 독특한 짝짓기 성향을 떠올리며 미소를 짓는다. <<arousal 200>><<garousal>>
		<<elseif hasSexStat("deviancy", 3)>>
			당신은 이 강의가 제법 흥미롭다고 느끼기 시작한다. <<arousal 200>><<garousal>>
		<<else>>
			당신은 총배설강에 대한 <<his>> 심층적인 설명에 얼굴을 찌푸린다. <<trauma 3>><<gtrauma>>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "scienceWolf" 1>>
		<<npc Sirris>><<person1>>
		시리스가 개과 동물의 습성과 번식에 대한 수업을 시작한다.
		<<if $wolfgirl gte 6>>
			시리스가 일반적인 사냥감에 대한 부분을 다루자, 당신은 허기가 져 입술을 핥는다.
		<<elseif $syndromewolves gte 1>>
			당신은 자신의 무리를 떠올리며, 숲 속에서 그들과 함께 달리는 자신의 모습을 상상한다. <<stress -3>><<lstress>>
		<<elseif hasSexStat("deviancy", 3)>>
			당신은 이 강의가 제법 흥미롭다고 느끼기 시작한다. <<arousal 200>><<garousal>>
		<<else>>
			당신은 최대한 귀 기울여 들으려 하지만, 주제가 별로 흥미롭지 않아 보인다.
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "scienceCat" 1>>
		<<npc Sirris>><<person1>>
		시리스가 고양이과 동물의 습성과 번식에 대한 수업을 시작한다.
		<<if $cat gte 6>>
			발표 화면에 생쥐 사진이 나오자, 당신의 꼬리가 휙휙 움직이고 눈매가 날카로워지는 것을 느낀다.
		<<elseif hasSexStat("deviancy", 3)>>
			당신은 이 강의가 제법 흥미롭다고 느끼기 시작한다. <<arousal 200>><<garousal>>
		<<else>>
			당신은 최대한 귀 기울여 들으려 하지만, 주제가 별로 흥미롭지 않아 보인다.
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "scienceCow" 1>>
		<<npc Sirris>><<person1>>
		시리스가 소과 동물의 습성과 번식에 대한 수업을 시작한다.
		<<if $cow gte 6>>
			발표 화면에 부드럽고 푸른 풀밭 사진이 나오자, 당신은 '음매' 소리가 튀어나오는 것을 겨우 억누른다.
		<<elseif $lactating gte 1 and $settings.breastFeedingEnabled and $milk_volume gte 1000>>
			당신은 주변의 학생들보다는 소들과 훨씬 더 깊은 유대감을 느낀다. <<stress 3>><<gstress>>
		<<elseif $lactating gte 1 and $settings.breastFeedingEnabled>>
			당신은 자신과 소들 사이에 무언가 공통점이 있다고 생각하기 시작한다.
		<<elseif hasSexStat("deviancy", 4)>>
			당신은 이 강의가 제법 흥미롭다고 느끼기 시작한다. <<arousal 200>><<garousal>>
		<<else>>
			당신은 최대한 귀 기울여 들으려 하지만, 주제가 별로 흥미롭지 않아 보인다.
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "scienceFox" 1>>
		<<npc Sirris>><<person1>>
		시리스가 여우과 동물의 습성과 번식에 대한 수업을 시작한다.

		<<if $fox gte 6>>
			당신은 최대한 수업에 집중하려 애쓰지만, 자꾸만 시선이 동급생들의 학용품으로 향하고 그것들을 훔치고 싶다는 강렬한 충동을 느낀다.
		<<elseif hasSexStat("deviancy", 3)>>
			당신은 이 강의가 제법 흥미롭다고 느끼기 시작한다. <<arousal 200>><<garousal>>
		<<else>>
			당신은 최대한 귀 기울여 들으려 하지만, 주제가 별로 흥미롭지 않아 보인다.
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "exitingPrank">>
		<<generatey1>><<person1>>
한 <<person>>【이가】 <<= either("교실 창문 밖으로 뛰어내리려", "교실 밖으로 뛰쳐나가려")>> 한다. 시리스가 <<him>>【을를】 붙잡는다. "어디 가는 거니? 자리로 돌아가렴." 시리스가 친절하게 말한다.
		<br><br>
	재빨리 <<person>>【이가】 <<his>> 자리로 돌아간다. 몇몇 학생들이 <<his>> 익살스러운 행동에 킥킥댄다. 수업은 계속된다.
	<</addinlineevent>>

	<<runeventpool>>

	<<if $_linkSkip is false>>
		<br><br>
		<<link [[다음|Science Lesson]]>><<endevent>><</link>>
	<</if>>
<</widget>>

<<widget "eventssciencesleep">>
	<<cleareventpool>>
	<<set $_linkSkip to false>>

	<<addinlineevent "scienceCaught">>
		<<npc Sirris>><<person1>>
		책상을 날카롭게 두드리는 소리가 난다. 깜짝 놀라 벌떡 일어난 당신은 시리스의 단호한 시선과 마주친다. <<He>>【이가】 한숨을 내쉰다. "방과 후에 나머지 공부란다." <<ltiredness>><<detention 2>><<gdelinquency>>
	<</addinlineevent>>

	<<addinlineevent "scienceNotCaught">>
		<<npc Sirris>><<person1>>
		눈이 번쩍 뜨인다. 깜빡 잠이 든 게 틀림없다. 당신은 시치미를 뚝 떼고 아무 일도 없었던 것처럼 슬그머니 고개를 들며 하품을 참는다. 시리스는 전혀 눈치채지 못한 채 계속 말을 이어가고 있다. <<ltiredness>>
	<</addinlineevent>>

	<<if random(1, 400) gte $cool and $worn.upper.name isnot "naked">>
		<<addinlineevent "scienceIce">>
			등 뒤로 차가운 액체가 흘러내리고, 그 느낌에 당신은 화들짝 놀라 잠에서 깬다. <<willpowerdifficulty 1 300 no_text>>

			<<if $willpowerSuccess>>
				<span class="green">당신은 비명을 참고 평정을 유지하는 데 성공한다</span>. 당신의 $worn.upper.name 안을 조심스레 뒤지자 오늘 실험에서 남은 얼음조각 하나가 잡힌다. 당신 뒤에 앉은 <<generates1>><<person1>><<person>>【은는】 당신이 덤덤하게 반응하자 실망한 기색이 역력하다. 당신은 녹아가는 얼음을 책상 위에 올려두고, 수업은 더 이상의 방해 없이 계속된다.
				<<ltiredness>><<stress 6>><<gstress>>
			<<else>>
				<span class="red">당신은 책상에서 벌떡 일어나며 비명을 내지르고 만다</span>. 오늘 실험에서 썼던 얼음조각 하나가 당신의 $worn.upper.name【으로로】부터 툭 떨어진다. <<gstress>><<stress 6>>
				<br><br>

				<<generates1>><<person1>><<person>>【이가】 낄낄대며 웃음을 터뜨린다.
				<<if $submissive gte 1150>>
					당신은 반 전체가 쳐다보자 얼굴이 시뻘게진 채 황급히 다시 자리에 앉는다.
				<<elseif $submissive lte 850>>
					당신은 <<him>>【을를】 매섭게 노려보고는 다시 자리에 앉는다. 반 전체가 당신을 쳐다본다.
				<<else>>
					당신은 자리에 다시 앉아 쏟아지는 반 아이들의 시선을 무시하려 애쓴다.
				<</if>>
				<br><br>

				시리스가 걱정스러운 얼굴로 급히 다가온다. "무슨 일이니?"
				<br><br>

				당신과 <<person>>【은는】 일제히 서로를 가리킨다. <br>
				"얘가 수업 중에 자고 있었어요!" <br>
				"얘가 제 등에 얼음을 넣었단 말이에요!"
				<br><br>

				<<if $delinquency gte 400>>
					시리스가 당신에게 묻는다. "이게 사실이니?"
					<br><br>
					"네, 하지만..."
					<br><br>
					"하지만은 무슨. 내 수업 중에 잠을 자는 건 용납할 수 없단다," 시리스는 방과 후 나머지 공부를 지시하고는 교탁으로 되돌아간다. <<detention 6>><<gdelinquency>>

				<<elseif $delinquency gte 200>>
					시리스가 찌푸린 얼굴로 둘 다 조용히 시킨다. "그만. 방과 후에 나머지 공부를 하면서 반성하도록 하렴." 시리스는 두 사람 모두에게 처벌을 내리고는 교탁으로 돌아간다.
					<<detention 4>><<gdelinquency>>

				<<else>>
					시리스가 <<person>>에게 묻는다. "이게 사실이니?"
					<br><br>
					"네, 하지만..."
					<br><br>
					"하지만은 무슨. 내 수업에선 장난질은 절대 용납하지 않겠다. 사고는 그렇게 일어나는 거란다," 시리스가 단호하게 말한다. 시리스는 <<personsimple>>에게 방과 후 처벌을 내리고는 교탁으로 돌아간다.

				<</if>>
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<if random(1, 400) gte $cool>>
		<<addinlineevent "scienceTattletale">>
			<<npc Sirris>><<person1>>
			"선생님," <<generates2>><<person2>><<person>>【이가】 말한다. "얘가 수업 중에 자고 있어요!"
			<br><br>
			<<personsimple>>의 목소리에 잠에서 깬다. 책상에서 고개를 들자 선생님이 당신을 돌아보고 있다. 시리스는 <<person1>><<his>> 고개를 내젓는다. "방과 후에 나머지 공부란다."
			<br><br>
			<<person2>>
			<<if $submissive gte 1150>>
				당신은 당황하여 고개를 숙이지만, <<person>>【은는】 당신을 곤경에 빠뜨린 게 통쾌한지 만면에 웃음을 띠고 있다.
			<<elseif $submissive lte 850>>
				당신은 <<person>>【을를】 쏘아본다. 선생에게 꼬지른 게 그다지 현명한 짓은 아니었다는 걸 깨달았는지, 당신의 서늘한 시선 아래 <<His>> 미소가 사그라든다.
			<<else>>
				당신이 <<person>>【을를】 찡그리며 노려보지만, <<He>>【은는】 당신을 곤란하게 만들었다는 게 너무도 즐거운지 활짝 웃어보일 뿐이다.
			<</if>>
			<<ltiredness>><<detention 2>><<gdelinquency>>
		<</addinlineevent>>
	<</if>>

	<<if $settings.watersportsEnabled>>
		<<addinlineevent "sciencePiss">>
			가랑이부터 다리를 타고 따뜻한 기운이 번지는 것이 느껴진다. 머리가 번쩍 솟구친다. 갑작스러운 움직임과 무언가 똑똑 떨어지는 소리는 반 전체의 이목을 끌기에 충분하고도 남았다.<<underlowerwet 200>><<lowerwet 200>>
			<br><br>

			<<generates1>><<person1>><<person>>【이가】 당신의 발 밑에 고인 물웅덩이를 손가락질한다. "세상에, 얘 오줌 쌌어!" 당신의 실금에 교실이 일제히 비웃음바다로 변한다.
			<br><br>

			당신은 따뜻한 물이 담긴 컵에서 황급히 손을 빼보지만, 이미 엎질러진 물이다. 옆자리의 <<generates2>><<person2>><<person>>【이가】 팔꿈치로 <<his>> 친구를 찌른다. "이거 통할 거라고 했지?"
			<br><br>

			시리스가 황급히 수건을 들고 와 당신의 꼴사나운 모습을 가리고 치우는 걸 도와준다. 시리스는 <<person>>에게 즉시 방과 후 벌을 내리며 사태를 수습하려 하지만, 웃음소리도, 앞으로 꼬리표처럼 따라다닐 소문도 멈추지는 못한다. <<ltiredness>><<llcool>><<status -15>><<gtrauma>><<trauma 6>><<gstress>><<stress 6>>
		<</addinlineevent>>
	<</if>>

	<<if $sydneyScience is 1>>
		<<addinlineevent "scienceSydneyWake">>
			<<npc Sydney>><<person1>>
			<<run statusCheck("Sydney")>>
			<<if _sydneyStatus.includes("corrupt")>>
				피부에 은근한 압박이 느껴진다. 누군가 당신의 몸에 글씨를 쓰는 것 같다. 그 느낌이 멈추자마자 당신은 눈을 뜨며 하품을 한다. 시리스는 계속 강의 중이라 전혀 눈치채지 못했다.
				<br><br>

				시드니가 한 손에 펜을 쥔 채 웃으며 당신에게 손을 흔든다.
				<<if $settings.bodyWritingLevel gte 2>>
					<<sydneyBodywritingLocation>>
					<<if _writingFail isnot 1>>
						"일어나서 다행이네요."
						<br><br>
						당신이 슬쩍 내려다보니 당신의 <<bodypart _bodypart>>【은는】 이제 "<<sydneyBodywriting sleepyhead>>"라고 적혀 있다.
						<br><br>
					<<else>>
						"일어나서 다행이네요. 글씨 쓸 빈 공간이 없어 아쉽군요."
					<</if>>
				<<else>>
					"일어나서 다행이네요. 제 펜에 잉크가 떨어져서 아쉽지만요.
				<</if>>
			<<else>>
				무언가가 당신의 팔을 쿡쿡 찌른다. 눈을 떠보니 시드니가 당신을 펜으로 가볍게 찌르고 있다. 당신이 깨어난 걸 본 <<He>>【은는】 행동을 멈추고 웃어 보인다.
				<br><br>

				당신은 시치미를 뚝 떼고 아무 일도 없었던 것처럼 슬그머니 고개를 들며 하품을 참는다. 당신은 시드니에게 고맙다는 눈인사를 건넨다. 시리스는 전혀 눈치채지 못한 채 계속 말을 이어가고 있다.
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<if $drunk gte 1>>
		<<addinlineevent "scienceDrunk">>
			<<npc Sirris>><<person1>>
			책상을 날카롭게 두드리는 소리가 난다. 그 소리가 울릴 때마다 당신은 머리가 지끈거려 불평하듯 신음을 내뱉는다. <<gpain>><<pain 6>>
			<br><br>

			고개를 들고 시리스를 올려다본다. <<He>>【은는】 당신이 술에 취한 꼴을 보고 역정이 난 상태다.
			<br><br>

			"수업에서 대체 무얼 배운 거냐? 술을 마시러 다닐 거면, 최소한 책임감이라도 가져. 널 교실에서 내쫓지 않은 걸 다행으로 여기거라."
			<br><br>

			시리스는 실망스럽다는 듯 고개를 내저으며 교실 앞으로 돌아간다.
		<</addinlineevent>>
	<</if>>

	<<runeventpool>>

	<<if $_linkSkip is false>>
		<br><br>
		<<link [[다음|Science Lesson]]>><<endevent>><</link>>
	<</if>>
<</widget>>

<<widget "scienceCondomIntro">>
	<<set $scienceCondomIntro to true>>
	<<npc Sirris>><<person1>>
	시리스가 작은 상자들을 한 무더기 들고 교실 앞으로 나온다. "너희 부모님 중 일부는 아직 너희에게 '그 이야기'를 해주지 않으셨다는 걸 확실히 안다. 아니면, 너희 중 일부는 내 <<nnpc_daughter "Sydney">>처럼 평생 금욕적으로 살 거라고 생각하겠지."
	<<He>>【은는】 앞쪽 학생들에게 작은 상자들을 나눠 주기 시작하고, 학생들은 차례로 그것을 뒤로 넘긴다. 몇몇 학생은 상자를 살피며 킥킥거리고, 다른 학생들은 몹시 당황한 기색을 보인다.
	<br><br>

	이건 콘돔이다. 너희는 인생의 전성기에 있고 호르몬이 날뛰고 있으니, 항상 이걸 몇 개씩 가지고 다니고 싶을 거다. 계획에 없던 아이를 갖게 될 가능성을 줄여줄 뿐만 아니라, 너희를 깨끗하게 지켜줄 거다." 시리스는 <<his>> 책상 밑에서 크고 눈에 띄는 모양의 과일을 꺼낸다.
	<br><br>

	"착용법은 아주 간단해요. 여기 포장을 찢고, 끝부분에 대고, 아래로 굴려 내리면 됩니다. 다만 이 부분은 누르지 마세요. 저장고 끝이라고 부르는 부분인데, 액체가 새는 것을 막아 줍니다." 시리스가 과일에 콘돔을 씌우는 동작을 하자 몇몇 학생들의 얼굴이 붉어진 듯하다. <<arousal 200>><<garousal>>
	<br><br>

	"여러분이 금욕할 거라고 기대하지는 않지만, 안전하게 지내기를 기대합니다. 때가 오면 반드시 이것들을 사용하세요. 제 사비로 산 것이니, 개봉도 하지 않은 채 쓰레기통에 버려진 모습은 보지 않았으면 합니다. 부족해지면, <span class="gold">학교 화장실의 자판기에서 더 살 수 있습니다. 나이팅게일 가에 있는 병원 약국에도 콘돔과 다른 피임용품이 있습니다</span>." 당신은 콘돔 상자를 내려다본다. <<awarenessup 200 5>><<gcondoms 3>>
	<br><br>

	<i>콘돔은 음란한 체액을 막아 원치 않는 수정과 오염을 방지하고, 안팎을 깨끗하게 유지해 줍니다. 순결함 손실을 완화하고 흥분 증가량도 낮춰 줍니다. 다만 격렬한 섹스 중에는 특히, 낮은 확률로 찢어질 수 있습니다. 피임약과 함께 쓰면 가장 효과적입니다.</i>
	<br><br>
	<<link [[다음|Science Lesson]]>><<endevent>><</link>>
<</widget>>

<<widget "scienceProject">>
	<<set $scienceproject to "ongoing">><<set $scienceprojectdays to (21 + (7 - Time.weekDay))>>
	<<scienceprojectstart>>
	"몇 주 후에 과학 박람회가 열릴 겁니다." 시리스가 알린다. "참가는 선택 사항이지만, 더 실용적인 방식으로 배울 수 있는 좋은 기회입니다. 주제는 지역 야생 동물입니다. 여러분 각자를 위한 프로젝트 아이디어가 있지만, 원한다면 자신만의 아이디어를 내도 좋습니다."
	<br><br>
	시리스는 반 학생들에게 교과서 $rng쪽을 펴라고 한 뒤, 교실을 돌아다니며 작은 카드를 나눠 준다. 당신의 카드에는 이렇게 적혀 있다. "이끼는 마을 곳곳에서 자랍니다. 지역 환경은 번성하는 종에 어떤 영향을 줄까요?" 이어서 시험해 볼 수 있는 몇 가지 변수가 적혀 있고, 끝에는 이렇게 쓰여 있다. "사유지에 들어가기 전에는 반드시 허락을 구하세요!"
	<<set $sciencelichenknown to 1>>
	<br><br>
	시리스가 다시 앞으로 돌아온다. "박람회는 토요일에 시청에서 열릴 겁니다. 프로젝트를 가져오지 않더라도 참석해주길 바랍니다."
	<br><br>
	<span class="gold">과학 프로젝트가 일지에 추가되었습니다.</span>

	<<if $sciencephallusknown isnot 1 and hasSexStat("promiscuity", 3)>>
		<br><br>
		<<set $sciencephallusknown to 1>>
		다른 학생들이 아이디어를 논의하는 동안 음란한 생각이 떠오른다. <span class="gold">"지역 남근" 과학 프로젝트를 떠올렸다.</span>
	<</if>>
	<br><br>
	<<link [[다음|Science Lesson]]>><<endevent>><</link>>
<</widget>>

