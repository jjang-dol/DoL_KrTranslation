				<</if>>
				<<link [[참는다|Events Swimming Tail]]>><<set $phase to "Endure">><</link>><<gstress>>
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<runeventpool>>
	<<if $_linkSkip is false>>
