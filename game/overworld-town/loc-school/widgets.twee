				<br>
			<<default>>
		<</switch>>
		<<switch $studyBooks.stolen>>
			<<case "science">>
				/*<<link [[Study science (0:20)|$passage]]>><<set $study to 1>><<pass 20>><<set $phase to 1>><</link>><<gscience>>
				<br>*/
			<<case "maths">>
				/*<<link [[Study maths (0:20)|$passage]]>><<set $study to 1>><<pass 20>><<set $phase to 2>><</link>><<gmaths>>
				<br>*/
			<<case "English">>
				/*<<link [[Study English (0:20)|$passage]]>><<set $study to 1>><<pass 20>><<set $phase to 3>><</link>><<genglish>>
				<br>*/
			<<case "history">>
				/*<<link [[Study history (0:20)|$passage]]>><<set $study to 1>><<pass 20>><<set $phase to 4>><</link>><<ghistory>>
				<br>*/
			<<case "Raul and Janet">>
				<<scarleticon>><<link [["라울과 자넷"을 읽는다 (0:01)|ScarletBook1]]>><<pass 1>><<set $scarletExitPassage to $passage>><</link>>
				<br>
			<<case "Pinch">>
				<<oliveicon>><<link [[올리브색 책을 읽는다 (0:01)|Olive Book 1]]>><<pass 1>><<set $oliveExitPassage to $passage>><</link>>
				<br>
			<<default>>
		<</switch>>
	<</if>>
<</widget>>

<!-- "upperruined" doesn't take sets into account, so use "strip" and destroy the carried towel parts -->
<<widget "droptowel">>
	<<if _toweldrop is "both">>
		<<generalStrip "upper">>
		<<generalStrip "lower">>
	<<elseif _toweldrop is "lower">>
		<<generalStrip "lower">>
	<<elseif _toweldrop is "upper">>
		<<generalStrip "upper">>
	<</if>>
<</widget>>

<!-- Will check if the pc can drop a towel to expose themselves. Returns its result in "_exlevel" and "_toweldrop".-->
<<widget "checkdroptowel">>
	<<set _bottom to "nothing">>
	<<set _top to "nothing">>
	<<if hasSexStat("exhibitionism", 4)>>
		<<if ($worn.lower.name is "towel skirt" or $worn.lower.name is "large towel bottom") and $worn.over_lower.exposed gte 2>>
			<<if $worn.under_lower.exposed lt 1 or hasSexStat("exhibitionism", 5)>>
				<<set _bottom to "strip">>
			<</if>>
		<</if>>
		<<if ($worn.upper.name is "towel top" or $worn.upper.name is "large towel") and $worn.over_upper.exposed gte 2>>
			<<if $worn.upper.one_piece isnot 1 or _bottom is "strip">>
				<<set _top to "strip">>
			<</if>>
		<</if>>
	<</if>>

	<<if _bottom is "strip" and _top is "strip">>
		<<set _exlevel to ($worn.under_lower.exposed lt 1 ? 1 : 2)>>
		<<set _toweldrop to "both">>
	<<elseif _bottom is "strip">>
		<<set _exlevel to ($worn.under_lower.exposed lt 1 ? 1 : 2)>>
		<<set _toweldrop to "lower">>
	<<elseif _top is "strip">>
		<<set _exlevel to 1>>
		<<set _toweldrop to "upper">>
	<<else>>
		<<set _exlevel to 0>>
		<<set _toweldrop to "none">>
	<</if>>
<</widget>>

<<widget "school_infirmary_options">>
	<<if $passage isnot "School Infirmary Ask Painkiller">>
		<<schoolicon "infirmary">><<link [[진통제를 달라고 한다|School Infirmary Ask Painkiller]]>><</link>>
		<br>
	<</if>>
	<<if $passage isnot "School Infirmary Ask Bed">>
		<<bedroomicon>><<link [[침대 하나를 써도 되는지 묻는다|School Infirmary Ask Bed]]>><</link>>
		<br>
	<</if>>
	<<if $passage isnot "School Infirmary Cabinet">>
		<<pillicon>><<link [[캐비닛 안을 들여다본다|School Infirmary Cabinet]]>><</link>>
		<br>
	<</if>>
	<br>
	<<getouticon>><<link [[떠난다|Hallways]]>><<endevent>><</link>>
	<br>
<</widget>>

<<widget "infirmary_excused">>
	<<switch $schoolstate>>
		<<case "first">>
			<<set $daily.school.scienceExcused to true>>
		<<case "second">>
			<<set $daily.school.mathsExcused to true>>
		<<case "third">>
			<<set $daily.school.englishExcused to true>>
		<<case "fourth">>
			<<set $daily.school.historyExcused to true>>
		<<case "fifth">>
			<<set $daily.school.swimmingExcused to true>>
	<</switch>>
<</widget>>

<<widget "enableSchoolRescue">>
	/* Call with all applicable conditions for a rescue in any order. ex: <<enableSchoolRescue "Whitney" "delinquency">> for scenes where Whitney or low delinquency can save you, or <<enableSchoolRescue "Leighton">> for scenes where just Leighton can save you. */
	/* Shouldn't be called without any arguments; just use the standard "enable_rescue" widget for those cases. */
	<<set $_rescue to []>>

	<<if _args.includes("Whitney") and C.npc.Whitney.dom gte random(10, 25) and C.npc.Whitney.state is "active" and $whitneyromance is 1>>
		<<set $_rescue.push("Whitney")>>
	<</if>>

	/* There are no cases where Leighton being present and low delinquency are separate conditions for rescue, but there are some where both are required. ex: "Maths Note Molestation" */
	<<if _args.includesAll("delinquency", "Leighton") and $delinquency lt 400 and $pillory.tenant.special.name isnot "Leighton">>
		<<set $_rescue.push("Leighton")>>
	<<elseif _args.includes("delinquency") and $delinquency lt 400>>
		<<set $_rescue.push("delinquency")>>
	<<elseif _args.includes("Leighton") and $pillory.tenant.special.name isnot "Leighton">>
		<<set $_rescue.push("Leighton")>>
	<</if>>

	<<if $_rescue.includes("Whitney") and $_rescue.includes("delinquency", "Leighton")>>
		/* Safe Whitney rescue */
		<<set $rescue to 3>>
	<<elseif $_rescue.includes("Whitney")>>
		/* Lone Whitney rescue */
		<<set $rescue to 2>>
	<<elseif $_rescue.length gt 0 or !_args[0]>>
		/* Safe rescue */
		<<set $rescue to 1>>
	<</if>>
<</widget>>

:: School Vending Machine Widget [widget]
/*
	$weekly.theft.vendingMachine {
		broken: boolean
		stolen: boolean
	}
	$daily.vendingMachine {
		used: boolean
	}
 */
<<widget "schoolVendingMachine">>
	<<set $weekly.theft.vendingMachine to $weekly.theft.vendingMachine || {}>>
	<<set $daily.vendingMachine to $daily.vendingMachine || {}>>
	<br>
	콘돔 자판기가 있다. 청소년부의 보조금을 받는 물건이다.
	<br>
	<<if !$brothelVending>>
		<<if $brotheljob and $fame.business gte 100>>
			<<set $brothelVending to {status: "idea", products: 0, condoms: 0, lube: 0, condomsSold: 0, lubeSold: 0, condomsToRefill: 0, lubeToRefill: 0, weeksRent: 0, weeksEmpty: 0}>>
			/* $brothelVending.status
			idea - 1 PC has had the idea but not talked to Briar
			asked - 2 Talked with Briar But not bought the machine
			bought 2 - 4 Bought the vending machine but not installed it
			sold - Briar sold the machine since it was empty for so long
			set 3 - 8 Installed the vending machine
			BITS of $brothelVending.products
			bit 0 - 1 Talked to the pharmacy nurse about reselling condoms
			bit 1 - 2 Talked to Sirris about selling lube */
			<br>
			자판기를 보자, <span class="pink">좋은 생각이 떠오른다</span>. 창관 탈의실에도 자판기를 설치해 직원들이 콘돔이나 업무에 쓸 만한 물건을 살 수 있게 하면 좋을 것 같다. <span class="gold">브라이어와 이야기해 보기로 한다.</span>
			<br><br>
		<</if>>
	<</if>>
	/* Suggestion:
		When broken, the machine can be completely inoperable for a week.
		When stolen, the machine can still be operated normally, but held cash is set to 0:
		Each day the machine's stored wealth can be reset, and held cash could be randomly incremented.
		If you purchase condoms, you could sneakily regain the cash you spent.
		Optional: There could be more than 2 condoms in the machine.
	*/
	<<if $weekly.theft.vendingMachine.broken or $weekly.theft.vendingMachine.stolen>>
		<span class="red">자판기가 고장 나 있다.</span>
	<<else>>
		<<if $daily.vendingMachine.used>>
			빨간 표시창에는 "<span class="red">비어 있음</span>"이라고 적혀 있다.
		<<else>>
			<<if $money gte 2000>>
				<<condomicon "machine">><<link [[콘돔 구매하기 (2개 £20)|Vending Machine Buy]]>><</link>>
			<<else>>
				당신은 그것들을 살 돈이 없다.
			<</if>>
		<</if>>
		<<if !Time.schoolTime>>
			<br>
			<<condomicon "machine">><<link [[턴다|Vending Machine Rob]]>><</link>>
		<</if>>
	<</if>>
<</widget>>

<<widget "classRoomEarSlime">>
	<<if _args[0] is $daily.earSlimeSkipLesson and $justEntered>>
		당신은 슬라임의 명령을 무시하려 해보지만, 스스로 <<if $daily.earSlimeSkipLesson is "swimming">>수영장<<else>>교실<</if>>에 들어갈 수 없음을 깨닫는다.
		<br><br>
		<<if $daily.earSlimeSkipLesson is "swimming">>
			<<link [[다음|$lastChangingRoom]]>><<endevent>><</link>>
		<<else>>
			<<link [[다음|Hallways]]>><<endevent>><</link>>
		<</if>>
		<<unset $justEntered>>
		<<exitAll>>
	<<elseif _args[0] and !$daily.earSlimeSkipLesson and _args[0] isnot $weekly.earSlimeSkipLesson and numberOfEarSlime() and earSlimeMakingMundaneRequests() and $justEntered and random(0,200) gte 175 - $earSlime.corruption>>
		<<set $daily.earSlimeSkipLesson to _args[0]>>
		<<set $weekly.earSlimeSkipLesson to _args[0]>>
		<span @class="$earSlime.startedThreats ? 'lewd' : 'lblue'">머릿속 슬라임이 당신에게 _args[0] 수업을 땡땡이치라고 명령하는 것을 느낀다.</span> 그것은 복종한다면 보상을 주겠다고 약속하며<<if $earSlime.startedThreats>>, 거부한다면 대가가 따를 것이라고 협박한다<</if>>.
		<br><br>
		<<link [[복종한다|School Lesson Slime]]>><<set $phase to 0>><<set $lessonPassage to $passage>><<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 2>><</link>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
		<br>
		<<if $earSlime.startedThreats>>
			<<link [[반항한다|School Lesson Slime]]>><<set $phase to 2>><<set $lessonPassage to $passage>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>><</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
		<<else>>
			<<link [[무시한다|School Lesson Slime]]>><<set $phase to 1>><<set $lessonPassage to $passage>><</link>>
		<</if>>
		<br>
		<<unset $justEntered>>
		<<exitAll>>
	<<elseif _args[0] and !$daily.earSlimeSkipLesson and _args[0] isnot $weekly.earSlimeSkipLesson and numberOfEarSlime() and $justEntered and random(0,100) gte 95 - ($earSlime.growth / 25) and $earSlime.exhibitionism gte 2>>
		<<if $earSlime.growth gte 200 and $earSlime.promiscuity gte 4>>
			<span class="lewd">머릿속 슬라임이 당신에게 수업을 빼먹고 복도에서 자위한 뒤, 구경꾼이 모이면 강간해 달라고 부탁하라고 명령하는 것을 느낀다.</span> <span class="red">그것은 당신이 복종하기를 바라고 있다.</span>
		<<else>>
			<span class="lewd">머릿속 슬라임이 당신에게 수업을 빼먹고 복도에서 자위하라고 명령하는 것을 느낀다.</span> 그것은 복종한다면 보상을 주겠다고 약속하며, 거부한다면 대가가 따를 것이라고 협박한다.
		<</if>>
		<br><br>
		<<link [[복종한다|School Lesson 2 Slime]]>><<set $phase to 0>><<set $lessonPassage to $passage>><<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 2>><</link>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
		<br>
		<<link [[반항한다|School Lesson 2 Slime]]>><<set $phase to 1>><<set $lessonPassage to $passage>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>><</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
		<br>
		<<unset $justEntered>>
		<<exitAll>>
	<</if>>
<</widget>>

<<widget "eventshousekeeping">>
	<<cleareventpool>>

	<<addinlineevent "housekeeping_vacuum">>
		리버는 진공청소기 조작법을 반 학생들에게 가르친다. 각 학생은 저마다 기기를 받아 주방 구역의 부스러기를 치우는 임무를 맡는다.
		<br><br>

		<<if $housekeeping gte 1000>>
			<<set _event_selection to random(1, 4)>>
		<<elseif $housekeeping gte 700>>
			<<set _event_selection to random(1, 3)>>
		<<elseif $housekeeping gte 400>>
			<<set _event_selection to random(1, 2)>>
		<<else>>
			<<set _event_selection to 1>>
		<</if>>
		<<if _event_selection is 4>>
			<<generatey1>><<npc "River" 2>><<person1>>
			어떤 <<person>>【이가】 교실 건너편에서 당신을 눈여겨보지만, 당신이 그쪽을 바라보자 시선을 진공청소기로 돌린다. 이내 <<his>> 입가에 미소가 번지고, <<he>>【은는】 당신 쪽으로 걸어온다.
			<br><br>

			<<He>>【은는】 몇 피트 떨어진 곳에 멈춰 선 다음, 진공청소기를 당신 쪽으로 향하고 켠다.
			<br><br>

			소음이 귀청을 찢을 듯하다. 청소기의 흡입력이 당신을 발을 잡아끌어 거의 넘어질 뻔하게 만든다. 리버가 소리치는 것을 보지만 단 한 마디도 들리지 않는다. <<person>>【이가】 기기 옆면을 철썩 치더니 청소기 세기를 높인다.

			<<set $worn.upper.integrity -= 20>>
			<<set $worn.lower.integrity -= 20>>
			<<set $worn.under_lower.integrity -= 20>>
			<<set $worn.under_upper.integrity -= 20>>

			<<integritycheck>>
			<<exposure>>
			<<if $exposed gte 1>>
				당신의 옷이 진공청소기에 빨려 들어가자 <<person>>【이가】 만족스러운 미소를 짓는다. <<covered>> 리버의 얼굴이 창백해지고, <<he>>【은는】 <<person2>><<his>> 눈을 가린다. <<He>>【은는】 <<person1>><<person>>【을를】 향해 제스처를 취한다. 몇몇 다른 학생들이 그 의도를 알아채고 더 피해를 보기 전에 <<person1>><<person>>【을를】 제지한다.
				<br><br>
				<<link [[다음|Housekeeping Vacuum Heavy 2]]>><</link>>
				<br>
			<<else>>
				당신은 옷이 찢어지는 것을 느끼지만, 리버가 <<person>>에게 다가가 <<him>>의 귀를 붙잡고 기기를 끈 뒤 <<him>>【을를】 방 밖으로 끌어낼 때까지 다행히 찢어지진 않았다.
				<br><br>

				남은 수업은 이렇다 할 일 없이 진행된다.
				<br><br>

				<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
				<br>
			<</if>>

		<<elseif _event_selection is 3>>
			<<generatey1>><<generatey2>><<person1>>
			당신은 <<person>>【와과】 <<person2>><<person>>【이가】 방 건너편에서 당신을 눈여겨보는 것을 알아챈다. <<person1>><<person>>【이가】 히죽거리자, 둘 다 당신 쪽으로 걸어오기 시작한다.
			<br><br>

			<<link [[무시한다|Housekeeping Vacuum Heavy Ignore]]>><</link>><<difficulty 50>>
			<br>
			<<link [[피한다|Housekeeping Vacuum Heavy Avoid]]>><<detention 1>><</link>><<gdelinquency>>
			<br>
		<<elseif _event_selection is 2>>
			<<generatey1>><<person1>>
			따분한 작업에 지루해하던 어떤 <<person>>【이가】 청소기 세기를 최고로 올려놓고 당신에게 달려든다. 기기가 당신 셔츠 앞섶을 움켜잡고, 등을 팽팽하게 끌어당긴다.<<gstress>><<stress 6>>
			<br><br>

			<<link [[참는다|Housekeeping Vacuum Medium Endure]]>><<trauma 6>><</link>><<gtrauma>>
			<br>
			<<link [[선생님을 부른다|Housekeeping Vacuum Medium Call]]>><<status -1>><</link>><<lcool>>
			<br>
			<<link [[밀친다|Housekeeping Vacuum Medium Shove]]>><<detention 2>><</link>><<gdelinquency>>
			<br>
		<<else>>
			<<generatey1>><<person1>>
			당신의 <<print $worn.lower.name>>【이가】 당겨지는 것을 느낀다. 어떤 <<person>>【이가】 옷감을 <<his>> 청소기로 빨아들인다. <<Hes>> 리버와 대부분의 학생에게 보이지 않게 카운터 밑에서 그렇게 하고 있다.
			<br><br>

			<<link [[참는다|Housekeeping Vacuum Light Endure]]>><<trauma 6>><</link>><<gtrauma>>
			<br>
			<<link [[움직인다|Housekeeping Vacuum Light Move]]>><</link>><<difficulty 80>>
			<br>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "housekeeping_pans">>
		<<if $delinquency gte 800>>
			<<set _event_selection to random(1, 4)>>
		<<elseif $delinquency gte 600>>
			<<set _event_selection to random(1, 3)>>
		<<elseif $delinquency gte 400>>
			<<set _event_selection to random(1, 2)>>
		<<else>>
			<<set _event_selection to 1>>
		<</if>>
		<<if _event_selection is 4>>
			<<npc "River">><<person1>>
			"너," 리버가 당신을 똑바로 바라보며 말한다. <<He>>【은는】 냄비와 팬이 지저분하게 쌓인 곳을 가리킨다. "네 청소 실력을 보고 싶구나. 저것들 좀 닦아라. 혼자서." <<He>>【은는】 벽시계를 쳐다본다. "시간은 20분 주겠다."
			<br><br>

			<<link [[서두른다|Housekeeping Pans Hurry]]>><</link>><<housekeepingdifficulty 1 1000>>
			<br>
			<<link [[거절한다|Housekeeping Pans Refuse]]>><<detention 3>><</link>><<gdelinquency>>
			<br>
		<<elseif _event_selection is 3>>
			<<npc "River">><<person1>>
			리버는 반 학생들에게 냄비와 팬을 깨끗이 문질러 닦으라고 지시한다. 먼저 무질서하게 쌓여 있는 더미에서 그릇들을 가져온 다음 개수대로 날라야 한다.
			<br><br>

			당신이 냄비 몇 개를 차곡차곡 쌓아놓고 몸을 돌리자 리버가 당신 옆에 서 있다. <<He>>【은는】 당신에게 기다리라고 손짓하더니 큰 더미에서 냄비 몇 개를 더 가져와 당신 냄비 더미에 올려둔다.
			<br><br>
			"일반적인 상황이라면 이렇게 많이 들고 다니는 건 현명하지 않겠지," <<he>>【이가】 말한다. "하지만 만일의 사태에 대비해야 하니까."
			<br><br>
			<<link [[최선을 다한다|Housekeeping Pans Best 2]]>><</link>><<housekeepingdifficulty 1 600>>
			<br>
			<<link [[항의한다|Housekeeping Pans Protest]]>><<detention 2>><</link>><<gdelinquency>>
			<br>
		<<elseif _event_selection is 2>>
			<<npc "River">><<person1>>
			리버의 눈길이 교실 안을 이리저리 훑는다. "냄비와 프라이팬을 닦아야 해," <<he>>【이가】 교실 구석에 무질서하게 쌓여 있는 더미를 가리키며 말한다. "모두 참여할 거지만, 누군가 먼저 시범을 보였으면 좋겠구나."
			<br><br>

			선생님의 시선이 당신에게 머문다. "너. 어떻게 하는 건지 보여주렴."
			<br><br>

			<<link [[최선을 다한다|Housekeeping Pans Best]]>><<stress 6>><</link>><<gstress>><<housekeepingdifficulty 1 400>>
			<br>
			<<link [[무능한 척한다|Housekeeping Pans Feign]]>><<status 1>><<detention 1>><</link>><<gdelinquency>><<gcool>>
			<br>
		<<else>>
			리버는 반 학생들에게 깨끗한 냄비와 팬을 문질러 닦으라고 지시한다. 먼저 무질서하게 쌓여 있는 더미에서 그릇들을 가져온 다음 개수대로 날라야 한다.
			<br><br>

			<<link [[조심한다|Housekeeping Pans Careful]]>><</link>>
			<br>
			<<link [[재빠르게 움직인다|Housekeeping Pans Swift]]>><</link>><<housekeepingdifficulty 1 200>>
			<br>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "housekeeping_rubbish">>

		<<if $cool lte 40>>
			<<set _event_selection to random(1, 4)>>
		<<elseif $cool lte 80>>
			<<set _event_selection to random(1, 3)>>
		<<elseif $cool lte 120>>
			<<set _event_selection to random(1, 2)>>
		<<else>>
			<<set _event_selection to 1>>
		<</if>>
		리버는 반 학생들에게 쓰레기를 종류별로 분리수거하라고 지시한다. 판지, 종이, 유리, 금속, 플라스틱은 각각 따로 용기가 있으며 모두 바퀴가 달려 들어온다. 다른 분류에 들어가지 않는 일반 쓰레기통도 있다.
		<br><br>
		<<if _event_selection is 4>>
			<<npc "River">><<person1>>
			리버의 주머니에서 진동음이 들린다. <<He>>【은는】 뭔가 방해되는 것에 대해 중얼거린다. "미안하다 얘들아," <<he>>【이가】 말한다. "몇 분 정도 걸릴 거다. 내가 없는 동안 조용히 잘 지내거라."
			<br><br>
			<<him>>【이가】 문을 닫자마자 몇몇 불량배들이 기회를 잡는다.
			<<endevent>>
			<<generatey1>><<generatey2>><<generatey3>><<generatey4>><<person1>>
			그들이 당신을 에워싼다.
			<br><br>
			"너 같은 인간 쓰레기랑 이 교실을 같이 쓰는 데 지쳤어," 어떤 <<person>>【이가】 당신의 <<print $worn.upper.name>>【을를】 붙잡고 말한다. "그러니까 밖으로 내보내 주지."
			<br><br>
			사방에서 손들이 뻗어 나와 당신의 옷을 찢어내려 한다. 그들 모두 네 명이다.<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
			<br><br>

			<<link [[소극적으로 행동한다|Housekeeping Bin Passive]]>><</link>>
			<br>
			<<link [[스스로 옷을 벗겠다고 제안한다|Housekeeping Bin Undress]]>><</link>>
			<br>
			<<link [[싸운다|Housekeeping Bin Fight]]>><<set $fightstart to 1>><</link>>
			<br>
		<<elseif _event_selection is 3>>
			<<generatey1>><<generatey2>><<generatey3>><<person1>>
			교실 문에서 노크 소리가 들린다. "리버," 레이튼의 목소리가 들린다. "잠깐 이야기 좀 하지."
			<br><br>
			리버가 조심스럽게 교실 안을 힐끗 본 뒤 밖으로 걸어 나간다. 문이 닫히자마자 어떤 <<person3>><<person>>【이가】 서둘러 달려가 의자로 문을 막아 리버가 밖에서 들어오지 못하게 한다.
			<br><br>
			어떤 <<person1>><<person>>【이가】 당신의 팔을 잡는다. "선생님이 가셨다," <<he>>【이가】 교실을 향해 선언한다. 다른 <<person2>><<person>>【이가】 당신의 다른 팔을 움켜쥔다. "재미 좀 볼까."
			<br><br>
			그들은 당신의 옷을 찢어내려 한다. 반 학생들 중 몇몇은 병적인 호기심으로 구경하고, 다른 이들은 고개를 돌린다.
			<br><br>

			<<link [[참는다|Housekeeping Rubbish Endure]]>><<trauma 6>><<stress 6>><</link>>
			<br>
			<<link [[싸운다|Housekeeping Rubbish Fight]]>><<set $fightstart to 1>><</link>>
			<br>
		<<elseif _event_selection is 2>>
			<<generatey1>><<generatey2>><<generatey3>><<person1>>
			세 명의 불량배인 <<person>>, <<person2>><<person>>, 그리고 <<person3>><<person>>【이가】 당신을 에워싼다. "보여줘. 네
			<<if $player.gender_appearance is "m">>
				자지 말이야."
			<<else>>
				"보지 말이야."
			<</if>>
			<<person1>><<person>>【이가】 말한다.
			<br><br>
			다른 둘은 당신의 양쪽에 서서 당신을 가로막는다.
			<br><br>

			<<link [[시키는 대로 한다|Housekeeping Rubbish Bid]]>><<trauma 6>><<stress 6>><</link>><<gtrauma>><<gstress>>
			<br>
			<<link [[주먹을 날린다|Housekeeping Rubbish Punch]]>><<detention 1>><</link>><<gdelinquency>>
			<br>
			<<link [[리버를 부른다|Housekeeping Rubbish Call Self]]>><<status -1>><</link>><<lcool>>
			<br>
		<<else>>
			<<generateyv1>><<person1>>
			불량배들이 어떤 <<person>>【을를】 괴롭히면서 작업을 더 흥미롭게 만든다. <<Hes>> 인기 없는 학생이다. 다들 외면하고, <<person>>【은는】 리버에게 알리기엔 너무 겁을 먹었다.
			<br><br>

			<<link [[직접 리버를 부른다|Housekeeping Rubbish Call]]>><<famegood 10>><<status -1>><</link>><<lcool>>
			<br>
			<<link [[무시한다|Housekeeping Lesson]]>><<endevent>><</link>>
			<br>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "housekeeping_trip">>
		<<generatey1>><<person1>>
		리버는 당신에게 과제물을 나눠주라고 지시한다. 책상 사이를 오가며 각 학생에게 과제물을 나눠주던 중, 한 <<person>>【이가】 다리를 걸어 방해한다. 당신은 발이 걸려 넘어진다.<<gpain>><<pain 4>><<gstress>><<stress 6>>
		<br><br>

		본능적으로 중심을 잡으려고 근처 카운터를 짚지만, 느슨하게 얹혀 있던 그릇만 짚어 그릇과 함께 넘어진다. 당신은 엉덩방아를 찧고, 그릇은 당신의 머리 위에 떨어진다.
		<br><br>

		<<if $worn.lower.skirt_down is 1>>
			일부 학생들의 시선이 당신을 향한다. 당신의 치마가 말려 올라가 <<undies>>【이가】 노출되었다.
			<<if $worn.under_lower.type.includes("naked")>>
				<<ggtrauma>><<trauma 12>><<schoolrep_naked>>
			<<else>>
				<<gtrauma>><<trauma 6>>
			<</if>>
			<br><br>
			<<link [[다리 사이의 치마를 끌어당긴다|Housekeeping Trip Tug]]>><</link>>
			<br>
			<<link [[가운데 손가락을 날린다|Housekeeping Trip Finger]]>><</link>>
			<br>
			<<if $worn.under_lower.type.includes("naked")>>
				<<if hasSexStat("exhibitionism", 5)>>
					<<link [[자랑한다|Housekeeping Trip Show Naked]]>><<fameexhibitionism 5>><</link>><<exhibitionist5>>
					<br>
				<</if>>
			<<else>>
				<<if hasSexStat("exhibitionism", 2)>>
					<<link [[자랑한다|Housekeeping Trip Show Undies]]>><<fameexhibitionism 2>><</link>><<exhibitionist2>>
					<br>
				<</if>>
			<</if>>
		<<else>>
			<<link [[웃어 넘긴다|Housekeeping Trip Laugh]]>><</link>>
			<br>
			<<link [[리버에게 알린다|Housekeeping Trip Inform]]>><<status -1>><</link>><<lcool>>
			<br>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "housekeeping_sink">>
		<<npc "River">><<person1>><<generatey2>>
		리버는 더러운 수저가 가득한 통을 가져온다. "소매를 걷어붙여라," <<he>>【이가】 말한다. "수업이 끝날 때까지 모든 걸 깨끗이 치워 놨으면 좋겠구나. 일해라. 난 나머지를 가지고 오마." 반 학생들은 단체로 신음 소리를 참는다.
		<br><br>
		당신은 싱크대에 물을 받는다.

		<<if $rng gte 81>>
			어떤 <<person2>><<person>>【이가】 슬며시 다가와 당신의 뒷덜미를 잡고 물속으로 머리를 밀어 넣으려 한다.<<gtrauma>><<trauma 6>><<gstress>><<stress 6>>
			<br><br>

			<<link [[저항한다|Housekeeping Sink Struggle]]>><</link>><<physiquedifficulty 1 15000>>
			<br>
			<<link [[숨을 참는다|Housekeeping Sink Breath]]>><</link>><<swimmingdifficulty 1 1000>>
			<br>
			<<link [[침착하려고 노력한다|Housekeeping Sink Calm]]>><<stress 6>><</link>><<gstress>>
			<br>
		<<else>>
			<<generateyv3>>
			어떤 <<person2>><<person>>【이가】 어떤 <<person3>><<persons>> 머리를 밀어 넣으려고 하지만, 리버가 제때 도착해 이를 막는다.
			<br><br>

			반 학생들은 수저를 세척하는 데 성공하지만, 리버는 결과에 불만을 표한다.
			<br><br>

			<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
			<br>
		<</if>>
	<</addinlineevent>>

	<<runeventpool>>
<</widget>>

<<widget "eventshousekeepingsafe">>
	<<cleareventpool>>
	<<addinlineevent "housekeeping_safe_1">>
		<<npc "River">><<person1>>
		리버는 학급에 가사 관리에 대한 구식 비디오를 보도록 시킨다. 몇몇 학생들이 그걸 보며 낄낄댄다. 리버는 영상과 학생들 양쪽을 모두 감시할 수 있는 교실 뒤편으로 자리를 옮긴다.
		<br><br>

		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "housekeeping_safe_2">>
		<<npc "River">><<person1>><<generatey2>>
		학급이 교과서를 읽는 동안, 리버는 책상 사이를 어슬렁거리며 배회한다.
		<<if $rng gte 6>>
			<<He>>【은는】 당신을 지목하여 일어나 교과서의 한 부분을 소리 내어 읽으라고 시킨다. 그다지 어려워 보이지 않는다.
			<br><br>

			<<link [[평범하게 읽는다|Housekeeping Read Normal]]>><</link>>
			<br>
			<<link [[연극하듯 오버해서 읽는다|Housekeeping Read Theatric]]>><</link>><<difficulty 80>>
			<br>
		<<else>>
			<<He>>【은는】 한 <<person2>><<person>>【을를】 지목하여 일어나 소리 내어 읽으라고 시킨다. <<Hes>> 너무 긴장한 나머지, 결국 리버가 그만하라고 제지할 때까지 계속 말을 더듬는다.
			<br><br>

			<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
			<br>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "housekeeping_safe_3">>
		<<npc "River">><<person1>>
		리버가 반 학생들에게 조리법을 시연한다. <<He>>【은는】 위생과 청결을 아주 강조한다. 아무도 감히 <<him>>【을를】 방해하지 못한다.
		<br><br>

		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "housekeeping_safe_4">>
		<<npc "River">><<person1>>
		리버는 특정 레시피에 대한 계획서를 학급 학생들에게 작성하게 시킨다. "본격적으로 요리를 시작하기 전에 무엇을 해야 할지 미리 파악하는 게 중요하다," <<he>>【이가】 말한다. "예상치 못한 상황은 허락되지 않는다. 실수도 용납하지 않는다."
		<br><br>

		<<He>>【은는】 순서대로 각 학생의 어깨너머를 들여다보며, 시도 때도 없이 수정을 요구한다.<<gstress>><<stress 6>>
		<br><br>

		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "housekeeping_safe_5">>
		<<npc "River">><<person1>>
		리버는 학생들에게 레시피의 시범 영상 한 편을 보게 시킨다. 영상이 재생되는 동안 <<He>>【은는】 주방을 어슬렁거리며 눈곱만 한 먼지라도 없는지 샅샅이 뒤진다. 반 학생 대다수는 선생님의 주의가 다른 곳으로 쏠렸다는 사실에 안도하는 눈치다.
		<br><br>

		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "housekeeping_safe_6">>
		<<npc "River">><<person1>>
		리버는 바느질 시범을 보여줄 테니 모두 <<him>> 주위로 모이라고 학급에 지시한다.
		<br><br>
		"자기 자리로 돌아가도록," 시범이 끝나자마자 <<he>>【이가】 지시한다. "자, 이젠 각자 실습할 시간이다."
		<br><br>
		모두가 자리에 앉자, 리버는 책상 사이를 배회하며, 게으름 피우는 사람은 없는지 학생들 어깨너머로 일일이 확인한다.
		<br><br>
		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
		<br>
	<</addinlineevent>>

	<<addinlineevent "exitingPrank">>
		<<generatey1>><<person1>>
		<<person>>【이가】 <<= either("교실 창문 밖으로 뛰어내리려", "교실 밖으로 뛰쳐나가려")>> 한다. 리버가 <<him>>의 멱살을 잡아 가로막고는, 차가운 눈으로 <<him>>【을를】 쏘아본다. "교장실까지 깡충깡충 뛰어가는 건 어때, 응?"
		<br><br>
		<<person>>【은는】 재빨리 <<his>> 자리로 돌아간다. 몇몇 학생이 <<his>> 기행에 킥킥거린다. 수업은 계속된다.
		<br><br>
		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
	<</addinlineevent>>

	<<runeventpool>>
<</widget>>

<<widget "canteenlunchoptions">>
	<<if $exposed gte 1>>
		<<link [[학교 복도로 달려간다|Hallways]]>><<endevent>><<set $eventskip to 1>><</link>>
		<br>
	<<else>>
		<<historyicon>><<link [[역사 수업을 듣는다 (0:01)|History Classroom]]>><<endevent>><<set $justEntered to true>><<pass 1>><</link>>
		<br>
		<<if _args[0] is "Kylar">>
			<<set _kylarLocation to getKylarLocation()>>
			<<if _kylarLocation.area is "rear_courtyard">>
				<<schoolicon "courtyard">><<link [[카일라를 따라 안뜰로 간다 (0:03)|School Rear Courtyard]]>><<endevent>><<pass 3>><</link>>
				<br>
			<</if>>
		<</if>>
		<<schoolicon "library">><<link [[도서관으로 간다 (0:02)|School Library]]>><<endevent>><<pass 2>><</link>>
		<br>
		<<foodicon "eat">><<link [[식당에 남는다|Canteen]]>><<endevent>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "schoolnightpoolpartyend">>
	<<set $weekly.schoolNightPoolParty to false>>

	비밀 파티가 끝나기 시작한다. 이미 지치고 만족한 학생들은 수영장을 떠나 탈의실로 향한다. 온 장소에는 빈 맥주캔과 성적인 체액이 어지럽게 남고, 청소부도 야간 경비도 그 모습을 그리 반기지는 않을 것 같다.
	<br><br>
	그래도 뒤처지고 싶지 않은 당신은 수영장 방을 나가기로 결심한다.
	<br><br>

	<<maleicon>><<link [[남자 탈의실|School Boy Changing Room]]>><<endevent>><</link>>
	<br>
	<<femaleicon>><<link [[여자 탈의실|School Girl Changing Room]]>><<endevent>><</link>>
	<br>
<</widget>>

<<widget "eventshousekeepingsleep">>
	<<cleareventpool>>

	<<addinlineevent "housekeepingCaught">>
		<<npc River>><<person1>>
		큰 소리에 당신은 잠에서 깬다. 당신이 벌떡 일어나자 리버가 당신을 노려보고 있다. "수업 중 취침은 무조건 나머지 공부다." <<ltiredness>><<detention 2>><<gdelinquency>>
		<br><br>
		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
	<</addinlineevent>>

	<<addinlineevent "housekeepingNotCaught">>
		<<npc River>><<person1>>
		당신은 눈을 번쩍 뜬다. 잠이 들었던 모양이다. 다행히 리버는 자기 말에 너무 집중한 나머지 아직은 조는 학생을 눈치채지 못하고 있다. <<ltiredness>>
		<br><br>
		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
	<</addinlineevent>>

	<<if random(1, 400) gte $cool>>
		<<addinlineevent "housekeepingTattletale">>
			<<npc River>><<person1>>
			"<<Sir>>!" 한 <<generates2>><<person2>><<person>>【이가】 소리치고, 당신은 화들짝 놀라 깬다. "<<pShe>>【은는】 수업 시간에 자고 있어요!"
			<br><br>
			고개를 들자 리버가 당신을 빤히 쳐다보고 있다. "나머지 공부." 리버가 말한다. "내가 직접 체벌할 수 없는 걸 다행으로 알아."
			<br><br>
			<<if $submissive gte 1150>>
				당신이 창피함에 고개를 숙이자 <<person>>【은는】 미소를 짓는다. 당신을 곤경에 빠뜨린 것이 무척 기쁜 모양이다.
			<<elseif $submissive lte 850>>
				당신은 <<person>>【을를】 노려본다. 당신의 쏘아보는 시선에 <<His>> 미소가 흔들리고, <<he>>【은는】 선생님에게 이르는 것이 그리 똑똑한 생각이 아니었음을 깨닫는다.
			<<else>>
				당신은 <<person>>에게 눈살을 찌푸린다. <<He>>【은는】 마주 웃음 지으며, 당신을 곤경에 빠뜨린 것을 무척 기뻐한다.
			<</if>>
			<<ltiredness>><<detention 2>><<gdelinquency>>
			<br><br>
			<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
		<</addinlineevent>>
	<</if>>

	<<addinlineevent "housekeepingLearn">>
		<<npc River>><<person1>>
		당신은 리버의 목소리를 들으며 꾸벅꾸벅 존다. 복잡한 레시피를 따라 하는 꿈을 꾸다 깨어나 보니, 리버는 화이트보드에 똑같은 레시피를 설명하고 있다. 당신은 무언가 배운 기분이 든다. <<ltiredness>><<ghousekeeping>><<housekeeping 2>>
		<br><br>
		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
	<</addinlineevent>>

	<<addinlineevent "housekeepingSewn">>
		<<generatey1>><<person1>>
		당신은 눈을 번쩍 뜬다. 잠이 들었던 모양이다. 펜을 찾으려 더듬거리다 소매가 꿰매져 있는 것을 발견한다. 옆자리의 <<person>>【이가】 당신을 보며 씩 웃고 있다.
		<br><br>
		서둘러 한 짓이라 여분의 실을 뜯어낼 수 있었지만, 리버가 '딴짓을 했다'며 당신에게 나머지 공부를 내린 뒤였다.<<ltiredness>><<gdelinquency>><<detention 2>>
		<br><br>
		<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
	<</addinlineevent>>

	<<if $drunk gte 1>>
		<<addinlineevent "housekeepingDrunk">>
			<<npc River>><<person1>>
			"무슨 일 있어? 평소보다 덜 집중하는 것 같은데." 당신은 신음하며 고개를 들어 당신의 책상 옆에 서 있는 리버를 바라본다.
			<br><br>

			"너 혹시... 취했—" 리버는 차마 그 말을 끝맺지 못한다. <<He>>【은는】 깊이 나무라듯 고개를 저으며 몹시 분개한 표정을 짓는다. "나머지 공부." <<ltiredness>><<detention 6>><<ggdelinquency>>
			<br><br>
			<<link [[다음|Housekeeping Lesson]]>><<endevent>><</link>>
		<</addinlineevent>>
	<</if>>

	<<runeventpool>>
<</widget>>
