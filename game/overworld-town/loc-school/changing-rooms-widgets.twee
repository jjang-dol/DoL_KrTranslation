:: Widgets Changing Room [widget]

<<widget "changingRoomSetup">>
	<<unset $lastChangingRoom>>
	<<outfitChecks>>
	<<set _changingRoomGenderType to _args[0]>>

	<<if ["School Boy Changing Room", "School Girl Changing Room"].includes($passage)>>
		<<if $previousClothes is undefined>><<set $previousClothes to clone($worn)>><</if>>
		<<run Object.entries($worn).forEach(([slot, item]) => {
			const previousItem = $previousClothes[slot];
			if (item.name isnot previousItem.name or item.colour isnot previousItem.colour or item.accessory_colour isnot previousItem.accessory_colour) {
				if (["upper", "under_upper"].includes(slot)) _justChangedUpperClothes to true;
				if (["lower", "under_lower"].includes(slot)) _justChangedLowerClothes to true;
				_justChangedClothes to true;
			}
		})>>
		<<set $previousClothes to clone($worn)>>
	<</if>>

	<<set _stayedInLocker to ["School Boy Changing Room", "School Girl Changing Room", "School Pool Wardrobe"].includes($passagePrev)>>

	<<set _studentsKnow to ($schoolrep.crossdress gte 5 or $schoolrep.herm gte 5) and $changingroomstate isnot "empty">>
	/* Base setup, may have unique overrides later */
	<<set _allowedToChange to [_args[0], "h"].includes(_studentsKnow ? $player.sex : $player.gender_appearance)>>

	/* Specific changing room overrides */
	<<if _args[0] is "f">>
		<<set _genderChance to 100 - maleChance()>>

		<<if !$daily.school.changingRoomPregnancyFame>><<set $daily.school.changingRoomPregnancyFame to $player.gender_appearience is "m" ? random(500, 1500) : random(200, 1000)>><</if>>
		<<if $fame.pregnancy gte $daily.school.changingRoomPregnancyFame or
			playerBellyVisible() or
			($settings.forcedCrossdressingEnabled and $whitneyCrossdressSwimwear gte 1 and $player.gender_appearance is "f")>>
			<<set _allowedToChange to true>>
		<</if>>
		<<if $daily.school.changingRoomGirlAllowed and $changingroomstate isnot "empty">>
			<<set _studentsKnow to true>>
			<<set _allowedToChange to true>>
		<</if>>
	<<else>>
		<<set _genderChance to maleChance()>>
	<</if>>
	<<set _seenGender to (_studentsKnow ? $player.gender : $player.gender_appearance)>> <!-- If they know you crossdress, then they won't judge you by appearance -->
	<<set _uncomfortable to ($backgroundTraits.includes("crossdresser") and $player.sex is _args[0])>>
	<<set _notStartedLesson to Time.hour is 14 and Time.minute lte 5>>
	<<set _finishedLesson to Time.hour is 15 or (Time.hour is 14 and Time.minute gte 58)>>
<</widget>>

<<widget "schoolChangingRoomEmpty">>
	<<if $changingroomstate is "empty" and $poolroomstate isnot "empty">>
		현재는 텅 비어 있지만, 수영장 쪽에서 활동하는 소리가 들린다. <<if $poolroomstate is "own">>수업이 진행 중이다.<</if>>
		<<changingRoomFeelings 1>>
		<br><br>
		<<schoolPoolSwap>>
		<<raidLockers>>
		<<schoolChangingRoomLinks>>
	<<elseif $changingroomstate is "empty">>
		텅 비어 있다.
		<<changingRoomFeelings 2>>
		<br><br>
		<<if ["changingRoom", "party", "rape"].includes($weekly.schoolNightPoolParty) and Time.dayState is "night">>
			<span class="blue">수영장에서 사람들이 대화하는 소리와 물장구치는 소리가 들린다.</span>
			<<if $weekly.schoolNightPoolParty is "changingRoom">>
				<br>
				<<ind>><<link [[안을 훔쳐본다|School Night Pool Party Peek]]>><</link>>
			<</if>>
			<br><br>
		<</if>>
		<<schoolChangingRoomLinks>>
	<</if>>
<</widget>>

<<widget "schoolChangingRoomLinks">>
	<<if $exposed gte 2 and hasSexStat("exhibitionism", 5) and $poolroomstate isnot "empty">>
		<<swimmingicon>><<link [[수영장으로 들어간다|School Pool]]>><<set $lastChangingRoom to $passage>><<set $justEntered to true>><<unset $previousClothes>><</link>><<if $swimall isnot 1>><<gdelinquency>><</if>>
	<<elseif $exposed gte 2 and $swimall isnot 1 and $poolroomstate isnot "empty">>
		<span class="pink">이런 차림으로는 수영장에 들어갈 수 없다!</span>
	<<elseif $weekly.schoolNightPoolParty is "rape" and Time.dayState is "night">>
		<span class="purple">더 자극하지 않는 편이 좋다.</span>
	<<else>>
		<<swimmingicon>><<link [[수영장으로 들어간다|School Pool]]>><<set $lastChangingRoom to $passage>><<set $justEntered to true>><<unset $previousClothes>><</link>>
	<</if>>
	<br>
	<<if $earSlime.forcedCommando isnot undefined and !$worn.under_lower.type.includes("naked") and !$hypnosis_traits?.silence>>
		<span class="red">귓속의 슬라임이 <<underwearTypeText>>【을를】 입은 채로 나가는 것을 허락하지 않는다.</span>
	<<elseif $exhibitionism lte 75 and $exposed gte 1>>
		<span class="pink">이런 차림으로는 나갈 수 없다!</span>
	<<elseif $exposed gte 1>>
		<<getouticon>><<link [[나간다|School Pool Entrance Exhibitionism]]>><<unset $previousClothes>><</link>>
	<<else>>
		<<getouticon>><<link [[나간다|School Pool Entrance]]>>
			<<if $daily.whitney.whitneyCrossdressSwimwear>><<run $daily.whitney.whitneyCrossdressSwimwear.push(`${$changingRoomGender} exit`)>><</if>><<unset $previousClothes>>
		<</link>>
	<</if>>
	<<schoolpoolclothes _store_location>>
	<<lockericon>><<link [[사물함|School Pool Wardrobe]]>><</link>>
	<<exitAll>>
<</widget>>

<<widget "destination_pool">>
	<<if $changingRoomGender is "boys">>
		<<link [[다음|School Boy Changing Room]]>><<endevent>><</link>>
	<<else>>
		<<link [[다음|School Girl Changing Room]]>><<endevent>><</link>>
	<</if>>
<</widget>>

<<widget "changingRoomFeelings">>
	<<if $schoolrep.crossdress lt 3 and _args[0] is undefined>>
		<<if $backgroundTraits.includes("crossdresser") and $player.sex isnot _changingRoomGenderType>>
			<<if !$daily.school.changingRoomStressRelief>>
				<span class="green">그 사실이 기분 좋게 느껴진다.</span><<lstress>><<stress -3>><<set $daily.school.changingRoomStressRelief to true>>
			<<else>>
			그 사실이 기분 좋게 느껴진다.
			<</if>>
		<<elseif isCrossdressing() and !_uncomfortable>>
			왠지 엉뚱한 짓을 하는 것 같은 기분이 든다.
		<</if>>
	<<elseif _uncomfortable>>
		<br><br>
		<<switch _args[0]>>
			<<case 1>>혼자 있는데도, <<if $changingRoomGender is "girls">>여학생<<else>>남학생<</if>> 탈의실에 있는 것은 <span class="red">불편하다.</span>
			<<case 2>>그럼에도 불구하고, <<if $changingRoomGender is "girls">>여학생<<else>>남학생<</if>> 탈의실에 있는 것은 <span class="red">불편하다.</span>
			<<default>><<if $changingRoomGender is "girls">>여학생<<else>>남학생<</if>> 탈의실에 있는 것은 <span class="red">불편하다.</span>
		<</switch>><<gstress>><<stress 1>>
	<<elseif isCrossdressing()>>
		/* Intentional lack of br */
		<<switch _args[0]>>
			<<case 1>>혼자 있는데도 여기에 있으니 왠지 짓궂은 짓을 하는 기분이 드는 한편, 들키지 않을까 걱정된다.
			<<case 2>>그럼에도 불구하고 여기에 있으니 왠지 짓궂은 기분이 든다.
			<<default>> /* Intentional blank, this one is handled outside the widget */
		<</switch>>
	<</if>>
<</widget>>

<<widget "eventsSchoolChangingRoomsBoys">>
	<<if $daily.school.changingRoomBoyEvent is Time.date.timeStamp or random(0, 100) gte 25>><<exit>><</if>>
	/* These events make use non-widget usages of "he", "his", etc. These are intentional and should not be changed */
	<<cleareventpool>>
	<<if $poolroomstate is "own" and $worn.under_lower.name is "naked" and ($worn.lower.name is "naked" or $worn.lower.name.includes("towel"))>>
		<<if $worn.lower.name.includes("towel")>>
			<<if _genderChance gt 0 and $player.penisExist and !playerChastity("hidden")>>
				<<addinlineevent "schoolChangingRoomBoysEvent">>
					<<if $worn.genitals.name is "chastity parasite" or (!playerChastity("penis") and $parasite.penis.name)>>
						<<set _chastity to "기생충으로 덮인">>
					<<elseif playerChastity("cage")>>
						<<set _chastity to "정조대에 갇힌">>
					<<else>>
						<<set _chastity to "">>
					<</if>>
					급우 중 한 명이 손이 닿지 않는 틈을 타 당신의 허리에서 수건을 낚아채어, 급우들 앞에서 당신의 <<genitals>>【을를】 노출시킨다.
					<<lowerruined true>>
					<<if $player.penissize is 6>>
						탈의실이 폭소로 터져 나오고, 몇몇 학생들은 황급히 몸을 가리는 당신의 <<EZbig>><<if _chastity>>, 하지만 _chastity<</if>> <<EZpenis>>【을를】 보며 저속한 농담을 던진다.
					<<elseif $player.penissize lte 3>>
						새로 드러난 당신의 <<EZsmall>><<if _chastity>>, _chastity<</if>> <<genitals>>【을를】 보고 탈의실이 폭소로 가득 찬다. 수치심에 두 손으로 <<EZsmall>> <<EZpenis>>【을를】 움켜쥐자, 남학생 중 하나가 <<Penisremarkquote>> 하고 외친다.
						<<status -5>><<lcool>>
					<<else>>
						탈의실이 폭소로 터져 나오고, 몇몇 학생들은 황급히 몸을 가리는 당신의<<if _chastity>> _chastity<</if>> <<EZpenis>>【을를】 보며 저속한 농담을 던진다.
					<</if>>
					<<incgpenisinsecurity>><<trauma 5>><<gtrauma>>
				<</addinlineevent>>
			<</if>>
		<<else>> /* $worn.lower.name is "naked" */
			<<addinlineevent "schoolChangingRoomBoysEvent">>
				<<if _genderChance gt 0 and random(0, 100) gte 75 and $player.penisExist and !playerChastity("hidden")>>
					<<if $worn.genitals.name is "chastity parasite" or (!playerChastity("penis") and $parasite.penis.name)>>
						<<set _chastity to "기생충으로 덮인">>
					<<elseif playerChastity("cage")>>
						<<set _chastity to "정조대에 갇힌">>
					<<else>>
						<<set _chastity to "">>
					<</if>>
					급우 중 한 명이 당신의 양팔을 붙잡고 등 뒤로 꺾은 뒤, 모두에게 보라고 소리친다.
					<<if $player.penissize is 6>>
						탈의실이 폭소로 터져 나오고, 몇몇 학생들은 당신의 <<EZbig>><<if _chastity>>, 하지만 _chastity<</if>> <<genitals>>【을를】 보며 저속한 농담을 던진다.
						<br><br>

						장난을 마친 그 소년이 당신을 놓아주자 탈의실은 다시 평온을 찾는다. 학생들의 일반적인 수군거림 속에서도 당신의 유난히 큰 크기에 대한 묘한 소문이 여전히 들려온다.
					<<elseif $player.penissize lte 3>>
						새로 드러난 당신의 <<EZsmall>> <<genitals>>【을를】 보고 탈의실이 폭소로 가득 찬다.
						<br><br>

						팔이 풀려나자마자 당신은 수치심에 두 손으로 <<EZsmall>><<if _chastity>>, _chastity<</if>> <<EZpenis>>【을를】 황급히 움켜쥔다. 그러자 소년 중 하나가 <<Penisremarkquote>> 하고 외친다.
						<<status -5>><<lcool>>
					<<else>>
						탈의실이 폭소로 터져 나오고, 몇몇 학생들은 당신의 <<genitals>>【을를】 보며 저속한 농담을 던진다.
						<br><br>

						장난을 마친 그 소년이 당신을 놓아주자 탈의실은 다시 평온을 찾는다.
					<</if>>
					<<trauma 5>><<gtrauma>><<incgpenisinsecurity>>
				<<else>>
					소년들 중 하나가 수건으로 당신의 알몸 엉덩이를 찰싹 때리자 탈의실이 폭소로 터져 나온다. "우리가 네 엉덩이를 과녁 삼아 놀게 하고 싶지 않다면 <<print ["cover it", "get dressed", "put something over it", "put something on", "put your clothes on"].pluck()>>【은는】 게 좋을 걸," 그 소년이 말한다.
					<<pain 2>><<gpain>>
				<</if>>
			<</addinlineevent>>
		<</if>>
	<</if>>
	<<addinlineevent "schoolChangingRoomBoysEvent">>
		조금 더 대담한 소년들 몇 명이 서로의 성기 크기를 비교하고 있다. 아무도 당신에게는 신경 쓰지 않는다.
		<br><br>
		"야, 고추 쩌는데!" 방 건너편에서 한 소년이 친구를 칭찬하는 소리가 들린다. "누가 더 크다고 보냐?" 그와 그의 친구는 <<= either("서로의 성기를 나란히 대고 길이를 비교하고", "누가 더 크다고 으스대고", "어떻게 파트너를 만족시키는지 자랑스럽게 떠벌린다")>>. 잠시 후 그들은 <<if Time.minute gte 45>>옷을 입고 탈의실을 떠난다<<else>>수영복으로 갈아입고 수영장 쪽으로 향한다<</if>>.
	<</addinlineevent>>
	<<if $settings.maleVictimChance gt 0>>
		<<if _finishedLesson>>
			<<addinlineevent "schoolChangingRoomBoysEvent">>
				학생들 중 한 명이 혹시 여분의 속옷이 있는 사람치고 남는 게 없는지 방 안을 둘러보며 묻는다. 누군가 자신의 사물함에 침입해 속옷을 훔쳐갔다고 주장한다. 아무도 도와주려 하지 않고, 결국 그는 초조하게 반바지를 껴입고 탈의실을 떠난다.
			<</addinlineevent>>
		<</if>>
		<<addinlineevent "schoolChangingRoomBoysEvent">>
			덩치가 더 큰 소년 중 하나가 왜소한 급우의 수건을 홱 빼앗아 간다. 그 불량배는 <<= either("수건을 쥐락펴락 꼬아서 그 소년의 알몸에 채찍질을 해대고", "수건을 머리 위에 치켜들며 소년의 크기를 놀려댄다")>>. 그 작은 녀석은 수건을 돌려받을 때쯤이면 거의 울기 직전이 된다. 다행히도 당신이 옷을 갈아입는 동안에는 아무도 방해하지 않는다.
		<</addinlineevent>>
		<<if _notStartedLesson>>
			<<addinlineevent "schoolChangingRoomBoysEvent">>
				방 반대편에서는 인기 많은 소년 무리가 괴짜 같은 범생이 소년 한 명을 괴롭히기 시작한다. 그들은 속옷을 붙잡고 위로 확 잡아당겨 그를 공중에 띄운다. 결국 천이 찢어지고, 다른 이들이 탈의실을 빠져나가는 동안 그 범생이 소년은 수치심에 질린 채 차가운 바닥에 알몸으로 남겨진다. 다행히 그들은 당신을 내버려 둔다.
			<</addinlineevent>>
		<</if>>
	<</if>>
	<<if $player.perceived_breastsize gte 3>>
		<<addinlineevent "schoolChangingRoomBoysEvent">>
			근처에서 옷을 갈아입던 소년 중 하나가 당신을 훑어보더니 놀리듯 말한다. "네 가슴살이 더 불어나면 여자 탈의실을 쓰게 해야 할지도 모르겠는걸." 다른 아이들이 낄낄거리며 픽 웃는다.
			<<if $player.sex is "f" and $player.gender is "f" and isCrossdressing() and !_studentsKnow>>
				그들은 당신이 실제로는 여자라는 사실을 모른다. <<if _uncomfortable>><<gstress>><<stress 1>><</if>>
			<<else>>
				<<stress 5>><<gstress>>
			<</if>>
		<</addinlineevent>>
		<<if _genderChance gt 0>>
			<<addinlineevent "schoolChangingRoomBoysEvent">>
				<<generatesm1>><<person1>>
				뒤에서 누군가 당신의 <<breasts>>【을를】 주무르는 손길이 느껴진다. 제자리에 홱 돌아서자, 얼굴에 짓궂은 미소를 띤 <<person>>【이가】 보인다.
				<<endevent>>
				<<if $player.breastsize gte 9>>
					"젠장, 엄청나네! 언젠가 그 슴가를 출렁거리게 만들고 싶단 말이지."
				<<elseif $player.breastsize gte 6>>
					"와우, 가슴이 커다랗네! 언젠가 어떻게 다뤄야 할지 구경하고 싶어."
				<<else>>
					"예쁜 가슴이네. 언젠가 한번 맛보고 싶어!"
				<</if>>
				그가 윙크를 날린다.
				<<arousal 300 "bottom">>
				<<if $arousal gte $arousalmax>>
					마침내 당신을 절정 직전까지 밀어붙인다.
					<<garousal>>
					<br><br>
					<<orgasm>>
					<<set $orgasmcurrent to 0>>
					"누가 봐도 잔뜩 쌓였나 보네," 그가 킥킥거린다.
					<<if $adultshopunlocked and random(1)>>
						"성인용품점에서 마사지기라도 하나 사보라고, 그거 꽤 재밌거든."
					<<else>>
						"네가 풀 수 있도록 도와줄 다른 사람을 찾아보는 게 좋을걸."
					<</if>>
				<<elseif $arousal gte $arousalmax / 2>>
					그리고는 몸을 돌려 가버리며, 당신에게 야릇한 흥분을 남긴다. <<garousal>>
				<<else>>
					그리고는 가버리며, 당신을 당황스럽게 만든다. <<garousal>>
				<</if>>
			<</addinlineevent>>
		<</if>>
	<</if>>
	<<if $player.penisExist>>
		<<addinlineevent "schoolChangingRoomBoysEvent">>
			근처에서 옷을 갈아입던 급우 중 하나가 <<if _bottomless>>당신의 성기<<else>>당신의 <<exposedlower>> 속에 불룩하게 솟아오른 부위<</if>>【을를】 턱짓으로 가리킨다.

			<<if $player.penissize gte 5>>
				"시선은 혼자 다 독차지하겠는데!"
			<<elseif $player.penissize gte 3>>
				"제법 묵직한 물건을 가졌네. 재미 좀 보나?"
			<<else>>
				"그 조그마한 걸로 누굴 만족시키기나 하겠어."
			<</if>>
			<br><br>
			<<if _uncomfortable>>
				당신은 대충 얼버무리며 최대한 빨리 대화를 끝내려고 애쓴다. <<stress 5>><<gstress>>
			<<else>>
