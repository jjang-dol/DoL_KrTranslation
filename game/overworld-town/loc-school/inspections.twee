<</widget>>

<<widget "inspectionexpect">>
	<<if _args[0]>>
		<<set _expectedGender to _args[0]>>
		<<set _oppositeGender to (_args[0] is "m"? "f" : "m")>>
		<<set _hasGenitals to (_args[0] is "m"? $player.penisExist and $parasite.clit.name isnot "parasite" : $player.vaginaExist)>>
	<</if>>

	<<set $inspection.expect to ($inspection.gender_appearance is _expectedGender? "join" : "sit")>>

	<<if $genderknown.includes("Leighton")>>
		<<set $inspection.expect to (_hasGenitals? "join" : "sit")>>
	<</if>>

	<<if ($schoolrep.crossdress gte 4 or $schoolrep.herm gte 4) and $cool lte 240>>
		<<if $inspection.expect is "sit">> /* students can't override leighton setting expectation to join */
			<<set $inspection.expect to (_hasGenitals? "join" : "sit")>>
		<</if>>
	<</if>>
<</widget>>

:: Penis Inspection
<<set $outside to 0>><<set $location to "school">><<schooleffects>><<effects>>
<<generateym2>><<generateym3>>
<<set $inspection to {}>>
<<set $inspection.gender_appearance to $player.gender_appearance>> /* this locks in the player's gender appearance so logic remains consistent during this scene .*/
<<inspectionexpect "m">>

레이튼이 시리스의 책상을 옆으로 밀어 교실 앞 공간을 비운다. 학생들은 교장이 무슨 계획을 하고 있는지 궁금해하며 서로를 쳐다본다. "모든 남학생들은 교실 앞으로 줄을 서 주겠나?"
<br><br>

<<if $genderknown.includes("Leighton")>>
	<<if (($player.penisExist and $parasite.clit.name isnot "parasite") and $player.vaginaExist) or ($player.sex is "m" and $inspection.gender_appearance is "f")>>
		레이튼과 잠시 시선이 마주친다. <span class="purple">당신은 <<he>>【이가】 당신의 비밀을 알고 있다는 사실을 상기한다.</span> <<He>>【은는】 당신이 줄에 합류하기를 기대하고 있다.
	<<else>>
		당신은 <<if $inspection.expect is "join">>줄에 합류해야<<else>>자리에 앉아 있어야<</if>> 할 것으로 예상된다.
	<</if>>
	<br><br>
<<elseif $schoolrep.herm gte 4 or ($schoolrep.crossdress gte 4 and $player.sex is "m" and $inspection.gender_appearance is "f")>>
	<<if $inspection.gender_appearance is "f">>
		레이튼은 당신이 자리에 앉아 있기를 기대한다.
		<span class="purple"><<He>>【은는】 당신의 비밀에 대해 모르지만, 당신의 반 친구들은 알고 있다.</span>

		<<if $cool lte 120>>
			당신이 줄을 서지 않으면 그들이 알아챌 것이고, 당신의 평판으로 보아 그들이 당신을 고자질하는 것을 주저하지 않을 것이라고 확신한다.
		<<elseif $cool gte 240>>
