:: School Pool
<<set $outside to 0>><<set $location to "pool">><<schooleffects>><<effects>>

<<unset $previousClothes>>
<<set _masonCanUnlock to playerChastity() and $worn.genitals.origin is "Winter" and C.npc.Mason.chastityKeyCarried and !$weekly.masonChastityRemovalDeclined and !$daily.masonChastityRemovalDeclined
	and getVisibleClothesList().find(o => o === V.worn.genitals) and (C.npc.Mason.love gte 10 or C.npc.Mason.lust gte 15)>>
<<if Time.minute lt 45 and $schoolstate is "fifth">>
	<<classRoomEarSlime "swimming">>
<</if>>
<<if $poolroomstate is "own">>
	<<if Time.minute gte 45>>
		<<if $daily.school.attended.swimming>>
			수영장으로 들어간다.
			<br><br>
			수업이 막 끝났다. 몇몇 학생들이 아직 탈의실로 가고 있다. 메이슨은 남겨진 수건들을 모으고 있다.
			<br><br>
			<<if $exposed lte 0>>
				<<destinationpoolchangingroom>>
			<<elseif $exposed gte 1>>
				<<destinationpoolchangingroom "수건">>
			<</if>>
		<<else>>
			<<include "School Swimming Late">>
			<<set $daily.school.swimmingLate to true>><!-- still a missed lesson -->
		<</if>>
	<<elseif $exposed gte 2 and $swimall is 1>>
		<<npc Mason>><<person1>>
		<<if $daily.school.attended.swimming>>
			수영 수업에 다시 참여한다.
			<<schoolpoolmasoncheck>>
			<<if _masonCanUnlock>>
				<<include "Mason Chastity Prompt">>
			<<else>>
				<br><br>

				<<link [[다음|Swimming Lesson]]>><<endevent>><</link>>
			<</if>>
			<br>
		<<elseif Time.minute lt 5>>
			수영장으로 들어간다.
			메이슨은 수영장 옆에 서서, 나머지 학생들이 들어오는 동안 학생들에게 스트레칭을 하도록 독려하며 <<his>> 몸을 가리고 있다.
			<<schoolpoolmasoncheck>>
			<<if _masonCanUnlock>>
				<<include "Mason Chastity Prompt">>
			<<else>>
				<br><br>

				<<link [[다음|Swimming Lesson]]>><<endevent>><</link>>
			<</if>>
			<br>

		<<else>>
			수영장으로 들어간다.

			메이슨과 학생들은 이미 물속에 있다.
			<<if $daily.school.swimmingExcused>>
				<<run delete $daily.school.swimmingExcused>>
				"이제 왔구나." <<he>>【이가】 손짓하며 말한다. "걱정 마, 넌 봐줬으니까. 어서 들어와!"
			<<else>>
				"와줘서 기쁘군!" <<he>>【이가】 손짓하며 말한다.
				<<gdelinquency>><<detention 1>>
			<</if>>
			<br><br>
			<<schoolpoolmasoncheck>>
			<<if _masonCanUnlock>>
				<<include "Mason Chastity Prompt">>
			<<else>>
				메이슨이 수업을 계속하는 동안 당신은 물속으로 들어간다.
				<br><br>

				<<link [[다음|Swimming Lesson]]>><<endevent>><</link>>
			<</if>>
			<br>
		<</if>>
	<<elseif $exposed gte 2 and $swimall isnot 1>>
		<<npc Mason>><<person1>>
		<<schoolpoolexposed>>
		<<if hasSexStat("exhibitionism", 5) and $swimall isnot 1>>
			<<socialiseicon "ask">><<link [[알몸으로 수영하게 해달라고 부탁한다|School Pool Ask Naked]]>><<fameexhibitionism 15>><<endevent>><<set $swimnudecounter += 1>><</link>><<exhibitionist5>>
			<br>
		<</if>>
	<<elseif $swimall is 1>>
		<<npc Mason>><<person1>>
		<<if $daily.school.attended.swimming>>
			수영 수업에 다시 참여한다.
			<<schoolpoolmasoncheck>>
			<br>
		<<else>>
			수영장으로 들어간다.
			메이슨은 수영장 옆에 서서, 나머지 학생들을 기다리며 스트레칭을 하도록 독려하고 있다.
		<</if>>

		<<if $exposed gte 2>>
			<br>
			<<if _masonCanUnlock>>
				<<include "Mason Chastity Prompt">>
			<<else>>
				<br><br>
				<<link [[다음|Swimming Lesson]]>><<endevent>><</link>>
			<</if>>
		<<else>>
			<br><br>
			<<He>>【이가】 당신을 쏘아본다. "자, 어떤 녀석 덕분에, 네가 완전히 알몸이 아니면 수영장에 들여보낼 수 없게 됐어."
			<br><br>
			<<link [[알몸으로 수영한다|Swimming Lesson]]>><<schoolpoolundress>><<endevent>><</link>>
		<</if>>
	<<elseif ($worn.under_lower.type.includes("swim") or $worn.lower.type.includes("swim"))
	and ($worn.under_upper.type.includes("swim") or $worn.upper.type.includes("swim") or ($worn.under_upper.type.includes("naked") and $worn.upper.type.includes("naked") and ($player.gender_appearance is "m" or $daily.swimCrossdressPermission)))
	and (($worn.upper.type.includes("naked") or $worn.upper.type.includes("swim")) and ($worn.lower.type.includes("naked") or $worn.lower.type.includes("swim")))>>
		<<npc Mason>><<person1>>
		<<if $daily.school.attended.swimming>>
			수영 수업에 다시 참여한다.
			<<schoolpoolmasoncheck>>
			<<if _masonCanUnlock>>
				<<include "Mason Chastity Prompt">>
			<<else>>
				<br><br>

				<<link [[다음|Swimming Lesson]]>><<endevent>><</link>>
			<</if>>
			<br>
		<<elseif Time.minute lt 5>>
			수영장으로 들어간다.
			메이슨은 수영장 옆에 서서, 나머지 학생들을 기다리며 스트레칭을 하도록 독려하고 있다.
			<<schoolpoolmasoncheck>>
			<<if _masonCanUnlock>>
				<<include "Mason Chastity Prompt">>
			<<else>>
				<br><br>

				<<link [[다음|Swimming Lesson]]>><<endevent>><</link>>
			<</if>>
			<br>
		<<else>>
			수영장으로 들어간다.

			메이슨과 학생들은 이미 물속에 있다.
			<<if $daily.school.swimmingExcused>>
				<<run delete $daily.school.swimmingExcused>>
				"이제 왔구나." <<he>>【이가】 손짓하며 말한다. "걱정 마, 넌 봐줬으니까. 어서 들어와!"
			<<else>>
				"와줘서 기쁘군!" <<he>>【이가】 손짓하며 말한다.
				<<gdelinquency>><<detention 1>>
			<</if>>
			<br><br>
			<<schoolpoolmasoncheck>>
			<<if _masonCanUnlock>>
				<<include "Mason Chastity Prompt">>
			<<else>>
				메이슨이 수업을 계속하는 동안 당신은 물속으로 들어간다.
				<br><br>

				<<link [[다음|Swimming Lesson]]>><<endevent>><</link>>
			<</if>>
			<br>
		<</if>>
	<<else>>
		수영장으로 들어간다.
		<<npc Mason>><<person1>>
		<<if $daily.school.swimmingExcused>>
			"수업은 면제됐지만, 그래도 옷은 갈아입어야지.
		<<else>>
			"그렇게 입고 수영할 순 없잖아!
		<</if>>
		<<if _masonCanUnlock>>
			<<include "Mason Chastity Prompt">>
		<<else>>
			"가서 갈아입어."
			<br><br>

			<<if hasSexStat("exhibitionism", 5) and $swimall isnot 1>>
				<<set _hasAskLink to true>>
				<<socialiseicon "ask">><<link [[알몸으로 수영하게 해달라고 부탁한다|School Pool Ask Naked]]>><<fameexhibitionism 15>><<endevent>><<set $swimnudecounter += 1>><</link>><<exhibitionist5>>
				<br>
			<</if>>

			<<if $player.sex is "f" or ($player.sex is "h" and $player.gender_appearance is "f")>>
				<<if !$daily.swimCrossdressPermission>>
					<<set _hasAskLink to true>>
					<<socialiseicon>><<link [[남자 수영복밖에 없다고 말한다|School Pool Wrong]]>><</link>>
					<br>
				<</if>>
			<<else>>
				<<if !$daily.swimCrossdressPermission>>
					<<set _hasAskLink to true>>
					<<socialiseicon>>
					<<if ($worn.upper.type.includes("naked") and $worn.under_upper.type.includes("naked")) and
					($worn.lower.type.includes("swim") or ($worn.lower.type.includes("naked") and $worn.under_lower.type.includes("swim")))>>
						<<link [[남자 수영복밖에 없다고 말한다|School Pool Wrong]]>><<set $phase to 1>><</link>>
					<<else>>
						<<link [[여자 수영복밖에 없다고 말한다|School Pool Wrong]]>><</link>>
					<</if>>
					<br>
				<</if>>
			<</if>>
			<<if !$daily.swimSpareClothes>>
				<<set _hasAskLink to true>>
				<<socialiseicon>><<link [[갈아입을 옷이 없다고 말한다|School Pool Spare]]>><</link>>
			<br>
			<</if>>
			<<if _hasAskLink>>
				<br>
			<</if>>
			<<destinationpoolchangingroom>>
		<</if>>
	<</if>>

<<elseif $poolroomstate is "other">>
	<<if $exposed gte 1>>
		<<npc Mason>><<person1>>
		<<schoolpoolexposed>>
	<<else>>
		수영장으로 들어간다.
		<<if $daily.school.swimmingInterrupted is 1>>
			<<npc Mason>><<person1>>메이슨은 하던 일을 멈추고 당신 쪽을 본다. "수업 중이다.
			방해하지 마." <<He>>【이가】 문을 가리킨다.
			<<gdelinquency>>
			<br><br>
			<<detention 1>>

			<<destinationpoolchangingroom>>
		<<else>>
			<<npc Mason>><<person1>>
			메이슨은 하던 일을 멈추고 당신에게 미소 짓는다. "길 잃었니? 아니면 나한테 할 말이라도 있어?"
			아무래도 수업을 방해한 것 같다.
			<br><br>
			<<set $daily.school.swimmingInterrupted to 1>>

			<<link [[사과한다|Swimming Classroom Apology]]>><<trauma 1>><<stress 1>><</link>><<gstress>><<gtrauma>>
			<br>
			<<if $trauma gte 1>>
				<<link [[조롱한다|Swimming Classroom Mock]]>><<status 1>><<stress -12>><</link>><<lstress>><<gcool>><<gdelinquency>>
				<br>
			<</if>>
		<</if>>
	<</if>>
<<elseif $weekly.schoolNightPoolParty is "party" and Time.hour is 6>>
	<<schoolnightpoolpartyend>>
<<elseif ["changingRoom", "party"].includes($weekly.schoolNightPoolParty) and Time.dayState is "night">>
	<<if $weekly.schoolNightPoolParty is "changingRoom">>
		<<generates1>><<generates2>>
		수영장으로 들어서자, 알몸의 사람들이 홍수처럼 밀려온다. <span class="lewd">사방에서 신음, 키스, 젖은 몸이 서로 뒤엉켜 꿈틀거리는 소리로 가득하다.</span>
		<<ggarousal>><<arousal 1200>>
		<br><br>
		난교 중인 몇몇 얼굴은 수업에서 본 <<= $delinquency gte 400 ? "동료" : "알려진">> 불량 학생들임을 알아본다. 몇몇은 평범한 학생처럼 보인다. 하지만, 전에 본 적 없는 얼굴도 있다. 이 학교 학생이 맞긴 한가?
		<br><br>
		육욕적인 행위에 몰두해 있음에도 불구하고, 누군가 당신을 발견하기까지는 오래 걸리지 않았다. 누군가 비명을 지르며 당신을 가리키자, 곧 방 안의 모든 사람이 당신을 쳐다본다.
		<br><br>
		"잠깐, 누가 <<phim>>【을를】 불렀어?" 한 <<person1>><<person>>【이가】 소리친다.
		<br><br>
		"난 아냐!" 다른 <<person2>><<person>>【이가】 힘겨운 목소리로 대답한다.
		<br><br>
		<<if $speech_attitude is "meek">>
			"저... 저, 당신들이 들어오는 걸 봤어요." 당신의 소심한 목소리가 수영장에 울려 퍼진다. "담을 넘는 걸 보고... 궁금해서, 뭘 하는지 알고 싶었어요."
		<<elseif $speech_attitude is "bratty">>
			"그냥 따라왔어." 당신의 큰 목소리가 수영장에 울려 퍼진다. "너희들 정말 숨는 데 젬병이네. 어쨌든, 무슨 소란인지 보러 왔어."
		<<else>>
			"당신들이 들어오는 걸 봤어요." 당신의 목소리가 수영장에 울려 퍼진다. "몇몇이 담을 넘는 걸 보고, 무슨 일인지 알고 싶었어요."
		<</if>>
		<br><br>

		<<if hasSexStat("promiscuity", 5) or hasSexStat("exhibitionism", 5)>>
			<<link [[머물러도 되는지 묻는다|School Night Pool Party]]>><</link>>
		<<else>>
			<<insufficientStat "custom" "남아 있기에는" "blue" "음란함이나 노출증이">>
		<</if>>
		<br>
		<<if $changingRoomGender is "boys">>
			<<link [[자리를 비킨다|School Boy Changing Room]]>><<endevent>><<set $eventskip to 1>><</link>>
		<<else>>
			<<link [[자리를 비킨다|School Girl Changing Room]]>><<endevent>><<set $eventskip to 1>><</link>>
		<</if>>
		<br>
	<<else>>
		<<outfitChecks>>
		<<if $drunk gte random(480, 1000) or $stress gte $stressmax>>
			<<set $weekly.schoolNightPoolParty to false>>

			갑작스러운 현기증이 덮치고, 곧 방 전체가 빙빙 도는 것 같다. <<if $stress gte $stressmax>>스스로를 너무 몰아붙인 탓에,<<else>>마신 술이 이제야 올라오는 건지 궁금해할 틈도 없이<</if>> 시야가 까맣게 변한다.
			<br><br>
			정신을 잃는다.
			<br><br>

			<<link [[다음|School Night Pool Party Drunk]]>><<if $stress gte $stressmax>><<set $stress -= 2000>><</if>><</link>>
			<br>
		<<else>>
			학교 수영장이다. 불량 학생들이 비밀 파티를 열고 있다. 수영장의 염소 냄새만으로는 술과 정액 냄새를 가릴 수 없다.
			<br><br>
			<<if !_fullyNaked>>
				<<generates1>><<person1>>
				한 <<person>>【이가】 당신을 발견하고 비틀거리며 다가온다. "바보같이 차려입고 여기서 뭐 하는 거야?" <<He>>【이가】 웃으며 당신의 옷을 잡아당기지만, 해를 끼칠 의도는 없어 보인다. "옷은 금지야! 다 벗고 다시 와."
				<br><br>
				<<He>>【은는】 당신을 내버려 두고 수영장 가에 있는 친구들 무리로 술에 취해 걸어간다.
			<<else>>

				몇몇 학생들이 자기들끼리 잡담하고 있다.<br>
				<<socialiseicon>><<link [[어울린다|School Night Pool Party Socialise]]>><</link>>
				<br><br>

				수영장 곳곳에서 성적인 난잡함이 펼쳐진다.<br>
				<<investigateicon>><<link [[주변을 둘러본다 (0:10)|School Night Pool Party Around]]>><<pass 10>><</link>>
			<</if>>
			<br><br>

			<<if $exposed lte 0>>
				<<destinationpoolchangingroom>>
			<<elseif $exposed gte 1>>
				<<destinationpoolchangingroom "수건">>
			<</if>>
		<</if>>
	<</if>>
<<else>><!-- $poolroomstate is "empty" -->
	수영장 안이다. 염소 냄새가 진동한다.
	<br><br>
	<<if $arousal gte $arousalmax>>
		<<orgasmLocation "emptySwimClassroom">>
	<</if>>

	<<exhibitionclassroom>>

	<<destinationpoolchangingroom>>
<</if>>

:: School Pool Ask Naked
<<set $outside to 0>><<set $location to "pool">><<schoolpoolundress>><<schooleffects>><<effects>><<exposure>>

<<set _masonCanUnlock to playerChastity() and $worn.genitals.origin is "Winter" and C.npc.Mason.chastityKeyCarried and !$weekly.masonChastityRemovalDeclined and !$daily.masonChastityRemovalDeclined
	and getVisibleClothesList().find(o => o === V.worn.genitals) and (C.npc.Mason.love gte 10 or C.npc.Mason.lust gte 15)>>

<<if $swimnudecounter lte 1>>
	<<npc Mason>>

	<<if $speech_attitude is "meek">>
		"알몸으로 수영해도 될까요?" 당신은 묻는다. "물이 기분 좋아요."
	<<elseif $speech_attitude is "bratty">>
		"저 알몸으로 수영할 거예요." 당신은 선언한다.
	<<else>>
		"알몸으로 수영해도 돼요?" 당신은 묻는다.
	<</if>>
	<br><br>

	<<schoolpoolmasoncheck>>
	<<person1>><<His>> 얼굴이 더욱 붉어지고, 반 아이들은 흥분하기 시작한다. "ㅈ, 좋아." <<he>>【이가】 말한다. <<He>>【은는】 돌아서서 다른 학생들을 조용히 시키려고 최선을 다한다.
<<elseif $swimnudecounter lte 2>>
	<<npc Mason>><<generatey2>>

	<<if $speech_attitude is "meek">>
		"알몸으로 수영해도 될까요?" 당신은 묻는다. "물이 기분 좋아요."
	<<elseif $speech_attitude is "bratty">>
		"저 알몸으로 수영할 거예요." 당신은 선언한다.
	<<else>>
		"알몸으로 수영해도 돼요?" 당신은 묻는다.
	<</if>>
	<br><br>

	<<person1>><<His>> 얼굴이 더욱 붉어지고, 반 아이들은 흥분하기 시작한다. "ㄸ, 또?" <<he>>【이가】 끽 소리를 낸다. <<he>>【은는】 몸을 돌리기도 전에, <<person2>><<person>> 한 명도 탈의실에서 알몸으로 나온다.
	<br><br>

	<<person2>>"<<pshe>>만 알몸으로 수영하는 건 불공평하잖아요." <<he>>【이가】 말한다. 메이슨은 너무 놀라 아무 말도 못 하고, 당신과 그 학생이 수영장에 들어가는 것을 내버려 둔다.
<<elseif $swimnudecounter lte 3>>
	<<npc Mason>><<generatey2>><<generatey3>><<generatey4>>

	당신이 나오자, <<person2>><<person>>, <<person3>><<person>>, 그리고 <<person4>><<person>> 한 명이 이미 방 안에 알몸으로 있는 것이 보인다. 수영장 안의 학생들은 즐거워하고 메이슨은 경악한다.
	<br><br>

	<<person1>>네 번째 학생까지 기꺼이 모든 것을 벗어 던지자 반 아이들이 박수를 치고, 메이슨의 얼굴은 더욱 붉어진다. "너희들까지?"
	<<he>>【은는】 고개를 저으며 말한다.
	<br><br>

	<<if $speech_attitude is "meek">>
		"다들 같이 하고 싶었나 봐요." 당신은 말한다.
	<<elseif $speech_attitude is "bratty">>
		"아무래도 선생님이 수적으로 불리한 것 같네요." 당신은 말한다.
	<<else>>
		"이 수영복을 싫어하는 게 저뿐만이 아니네요." 당신은 말한다.
	<</if>>
<<elseif $swimnudecounter lte 4>>
	<<npc Mason>><<generatey2>><<generatey3>><<generatey4>>

	당신이 수영장에 들어가자, 지난번보다 훨씬 더 많은 학생들이 이미 알몸으로 와 있는 것이 보인다. 당신 뒤로도 몇 명이 더 나온다. 아마 반의 절반 정도가 알몸으로 수업에 참여하는 것 같다.
	<br><br>

	<<person2>><<person>> 한 명이 가장자리에서 물장구를 치며 당신에게 손을 흔든다. 한편 <<person1>>메이슨은 옷을 입은 학생들이 알몸으로 수영하는 무리에게서 시선을 돌리게 하려고 최선을 다하고 있다.

	<<if $cool gte 80>>
