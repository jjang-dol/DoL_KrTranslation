:: Fishing Moor Catch
<<if ["sit", "campfire"].includes($daily.fishing.fishingMoor.hikers.phase)>>
	<<fishingMoorCatchHikers>>
<<elseif $daily.fishing.fishingMoor.fox.phase is "watching">>
	<<fishingMoorCatchFox>>
<<else>>
	<<fishingMoorCatch>>
<</if>>

:: Widgets Fishing Moor Catch [widget]
<<widget "fishingMoorCatchHikers">>
	<<loadNPC 0 "moor_hiker_1">><<person1>>
	<<loadNPC 1 "moor_hiker_2">><<person2>>
	<<set _canEatFish to canEatFishTf($fishingHookedFish)>>
	<<set _cookOffer to $rng gte 50 and fishingHasMinutesPassedSinceNpcArrival(30) and canCookFish($fishingHookedFish.type) and $daily.fishing.fishingMoor.hikers.phase isnot "campfire">>

	<<if _cookOffer>>
		<<person1>><<personsimple>>【은는】 <<= setup.foodstuff[$fishingHookedFish.type].name>>【을를】 살펴본다. "불을 피워서 요리해 먹을 수 있을 것 같은데, 어때?"
		<br><br>
	<<elseif random(1, 5) is 1>>
		<<switch random(1, 2)>>
			<<case 1>>
				<<person1>><<personsimple>>【은는】 물고기를 보며 만족스러운 듯 고개를 끄덕인다. "잘 잡았네."
			<<case 2>>
				<<person2>><<personsimple>>【은는】 물고기를 보려고 몸을 앞으로 숙인다. "나쁘지 않은걸."
		<</switch>>
		<br><br>
	<</if>>

	<<if _canEatFish>>
		아주 작은 물고기라, 한입에 다 넣을 수도 있을 것 같다.
		<br><br>
	<</if>>

	<<link [[setup.foodstuff[$fishingHookedFish.type].name + " 보관하기"|Fishing Moor Wait]]>>
		<<tending_give $fishingHookedFish.type 1>>
		<<set $fishingAmbientOverride to "stowAway">>
		<<if baitShopWants($fishingHookedFish.type)>><<set $daily.fishing.baitShopRequest to "ready">><</if>>
		<<endevent>>
	<</link>>
	<br>
	<<link [[놓아준다|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "throwBack">><<endevent>><</link>>
	<<if _cookOffer>>
		<br>
		<<link [[물고기로 요리를 해달라 한다|Fishing Moor Campfire Cook]]>><<endevent>><</link>>
	<</if>>

	<<if _canEatFish>>
		<br>
		<<link [[물고기를 먹는다|Fishing Moor Cat Eat Hikers]]>><<endevent>><</link>><<fishEatingTf>>
	<</if>>
<</widget>>


<<widget "fishingMoorCatchFox">>
	<<effects>>
	<<loadNPC 0 "moor_fishing_fox">>
	<<set _canEatFish to canEatFishTf($fishingHookedFish)>>
	<<set _foxLunges to $daily.fishing.fishingMoor.fox.closeness gte 8 and dangerEvent()>>

	<<if _foxLunges>>
		하지만 당신이 무언가 하기도 전에, <<beasttype>>【이가】 <<= setup.foodstuff[$fishingHookedFish.type].name>>【을를】 향해 달려든다.
		<br><br>
	<<else>>
		<<if $daily.fishing.fishingMoor.fox.closeness gte 8>>
			<<beasttype>>【은는】 당신의 <<= setup.foodstuff[$fishingHookedFish.type].name>>【을를】 빤히 쳐다본다.
			<br><br>
		<<else>>
			당신이 <<= setup.foodstuff[$fishingHookedFish.type].name>>【을를】 들어 올리자 <<beasttype>>【이가】 고개를 번쩍 든다.
			<br><br>
		<</if>>

		<<if _canEatFish>>
			아주 작은 물고기라, 한입에 다 넣을 수도 있을 것 같다.
			<br><br>
		<</if>>
	<</if>>

	<<if _foxLunges>>
		<<link [[여우에게 물고기를 던진다|Fishing Moor Fox Angry Feed]]>><<endevent>><</link>>
		<<if $settings.bestialityEnabled>>
			<br>
			<<link [[물고기를 꼭 쥐고 있는다|Fishing Moor Fox Molestation]]>><<set $molestationstart to 1>><<set $fishingMoorFoxPhase to 1>><<endevent>><</link>>
		<</if>>
	<<else>>
		<<if $daily.fishing.fishingMoor.fox.closeness gte 8>>
			<<link [[setup.foodstuff[$fishingHookedFish.type].name + " 보관하기"|Fishing Moor Keep Fox]]>>
				<<if baitShopWants($fishingHookedFish.type)>><<set $daily.fishing.baitShopRequest to "ready">><</if>>
				<<endevent>>
			<</link>>
		<<else>>
			<<link [[setup.foodstuff[$fishingHookedFish.type].name + " 보관하기"|Fishing Moor Wait]]>>
				<<tending_give $fishingHookedFish.type 1>>
				<<set $fishingAmbientOverride to "stowAway">>
				<<if baitShopWants($fishingHookedFish.type)>><<set $daily.fishing.baitShopRequest to "ready">><</if>>
				<<endevent>>
			<</link>>
		<</if>>
		<br>
		<<if $daily.fishing.fishingMoor.fox.closeness gte 8>>
			<<link [[놓아준다|Fishing Moor Throw Back Fox]]>><<endevent>><</link>>
		<<else>>
			<<link [[놓아준다|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "throwBack">><<endevent>><</link>>
		<</if>>
		<<if _canEatFish>>
			<br>
			<<link [[물고기를 먹는다|Fishing Moor Cat Eat Fox]]>><<endevent>><</link>><<fishEatingTf>>
		<</if>>

		<<if $daily.fishing.fishingMoor.fox.closeness gte 8>>
			<br>
			<<link [[setup.foodstuff[$fishingHookedFish.type].name + "【을를】 여우에게 준다"|Fishing Moor Fox Feed]]>><<endevent>><</link>>
		<</if>>
	<</if>>
<</widget>>


<<widget "fishingMoorCatch">>
	<<set _canEatFish to canEatFishTf($fishingHookedFish)>>

	<<if _canEatFish>>
		아주 작은 물고기라, 한입에 다 넣을 수도 있을 것 같다.
		<br><br>
	<</if>>

	<<link [[setup.foodstuff[$fishingHookedFish.type].name + " 보관하기"|Fishing Moor Wait]]>>
		<<tending_give $fishingHookedFish.type 1>>
		<<set $fishingAmbientOverride to "stowAway">>
		<<if baitShopWants($fishingHookedFish.type)>><<set $daily.fishing.baitShopRequest to "ready">><</if>>
		<<endevent>>
	<</link>>
	<br>
	<<link [[놓아준다|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "throwBack">><</link>>
	<<if _canEatFish>>
		<br>
		<<link [[물고기를 먹는다|Fishing Moor Cat Eat]]>><</link>><<fishEatingTf>>
	<</if>>
<</widget>>


:: Fishing Moor Cut
<<if $daily.fishing.fishingMoor.fox.phase is "watching">>
	<<fishingMoorLineCutFox>>
<<else>>
	<<fishingMoorLineCut>>
<</if>>


:: Widgets Fishing Moor Cut [widget]
<<widget "fishingMoorLineCut">>
	<<effects>>
	당신은 낚싯줄을 <span class="purple">끊어버렸고</span>, <<= setup.foodstuff[$fishingHookedFish.type].name>>【은는】 깊은 물 속으로 헤엄쳐 도망간다.
	<br><br><br>

	<<fishingMinigameResultUi $fishingMinigame.fishDistance "cut">>
	<br><br>

	<<unset $fishingHookedFish>>
	<<run fishingMinigameEnd()>>
	<<link [[미끼를 꿰어 낚싯줄을 던진다 (0:03)|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "reHook">><<pass 3>><</link>>
	<br>
	<<link [[떠난다|Moor]]>><<set $eventskip to 1>><</link>>
<</widget>>


<<widget "fishingMoorLineCutFox">>
	<<effects>>
	<<loadNPC 0 "moor_fishing_fox">>
	당신은 낚싯줄을 <span class="purple">끊어버렸고</span>, <<= setup.foodstuff[$fishingHookedFish.type].name>>【은는】 깊은 물 속으로 헤엄쳐 도망간다.
	<br><br><br>

	<<fishingMinigameResultUi $fishingMinigame.fishDistance "cut">>
	<br><br>

	<<unset $fishingHookedFish>>
	<<fishingMoorFoxFishLostReaction>>
	<br><br>

	<<run fishingMinigameEnd()>>
	<<link [[미끼를 꿰어 낚싯줄을 던진다 (0:03)|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "reHook">><<endevent>><<pass 3>><</link>>
	<br>
	<<link [[떠난다|Moor]]>><<endevent>><<set $eventskip to 1>><</link>>
<</widget>>

<<widget "fishingMoorFoxFishLostReaction">>
	<<switch random(1, 3)>>
		<<case 1>>
			<<beasttype>>【은는】 물고기가 있던 자리의 잔물결을 쳐다보다가 당신을 올려다본다. <<bHe>>【은는】 짧게 콧김을 내뿜고는 앞발에 턱을 괸 채 엎드린다.
		<<case 2>>
			<<beasttype>>의 귀가 축 처진다. <<bHe>>【은는】 잠시 물가를 바라보다가, 전혀 감흥이 없는 듯 고개를 돌린다.
		<<case 3>>
			<<beasttype>>【은는】 물가 냄새를 킁킁 맡더니, 실망한 표정으로 당신을 돌아본다.
	<</switch>>
<</widget>>

:: Fishing Moor Snapped
<<if $daily.fishing.fishingMoor.fox.phase is "watching">>
	<<fishingMoorLineSnappedFox>>
<<elseif ["sit", "campfire"].includes($daily.fishing.fishingMoor.hikers.phase) and !(playerIsPregnant() and playerAwareTheyArePregnant())>>
	<<fishingMoorLineSnappedHikers>>
<<else>>
	<<fishingMoorLineSnapped>>
<</if>>


:: Widgets Fishing Moor Snapped [widget]
<<widget "fishingMoorLineSnappedFox">>
	<<effects>>
	<<loadNPC 0 "moor_fishing_fox">>
	갑자기 낚싯줄이 느슨해지고, <<= setup.foodstuff[$fishingHookedFish.type].name>>【은는】 깊은 물 속으로 사라진다.
	<br><br><br>

	<<fishingMinigameResultUi $fishingMinigame.fishDistance "lineSnapped">>

	<<unset $fishingHookedFish>>
	<<fishingMoorFoxFishLostReaction>>
	<br><br>

	<<run fishingMinigameEnd()>>
	<<link [[미끼를 꿰어 낚싯줄을 던진다 (0:03)|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "reHook">><<endevent>><<pass 3>><</link>>
	<br>
	<<link [[떠난다|Moor]]>><<endevent>><<set $eventskip to 1>><</link>>
<</widget>>


<<widget "fishingMoorLineSnappedHikers">>
	<<loadNPC 0 "moor_hiker_1">><<person1>>
	<<loadNPC 1 "moor_hiker_2">><<person2>>
	갑자기 낚싯줄이 느슨해지고, <<= setup.foodstuff[$fishingHookedFish.type].name>>【은는】 깊은 물 속으로 사라진다.
	<br><br><br>

	<<fishingMinigameResultUi $fishingMinigame.fishDistance "lineSnapped">>

	<<unset $fishingHookedFish>>
	<<switch random(1, 3)>>
		<<case 1>>
			<<person1>><<personsimple>>【은는】 당신의 어깨를 한 번 툭 친다. "아, 운이 없었네."
		<<case 2>>
			<<person2>><<personsimple>>【은는】 안타까운 듯 혀를 찬다. "거의 다 잡았었는데." 
		<<case 3>>
			<<person1>><<personsimple>>【은는】 얼굴을 찡그린다. "안타깝네. 거의 잡았었는데."
	<</switch>>

	<<run fishingMinigameEnd()>>
	<<if $daily.fishing.fishingMoor.hikers.drinkCount is 0 and $rng gte 50>>
		<<He>>【은는】 가방에 손을 넣어 캔 하나를 꺼내 내민다. "자, 위로의 선물."
		<br><br>

		<<link [[받는다|Fishing Moor Wait]]>><<endevent>><<set $daily.fishing.fishingMoor.hikers.drinkCount to 10>><<set $daily.fishing.fishingMoor.hikers.drinkOffered to true>><</link>>
		<br>
		<<link [[거절한다|Fishing Moor Wait]]>><<endevent>><</link>>
	<<else>>
		<br><br>

		<<link [[다시 미끼를 꿰어 낚싯줄을 던진다 (0:03)|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "reHook">><<endevent>><<pass 3>><</link>>
		<br>
		<<link [[떠난다|Moor]]>><<endevent>><<set $eventskip to 1>><</link>>
	<</if>>
<</widget>>


<<widget "fishingMoorLineSnapped">>
	낚싯줄이 팽팽해지더니, 이내 <span class="red">끊어진다.</span> <<= setup.foodstuff[$fishingHookedFish.type].name>>【은는】 사라졌다.
	<br><br><br>

	<<fishingMinigameResultUi $fishingMinigame.fishDistance "lineSnapped">>
	<br><br>

	<<unset $fishingHookedFish>>
	<<run fishingMinigameEnd()>>
	<<link [[미끼를 꿰어 낚싯줄을 던진다 (0:03)|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "reHook">><<pass 3>><</link>>
	<br>
	<<link [[떠난다|Moor]]>><<set $eventskip to 1>><</link>>
<</widget>>


:: Fishing Moor Fish Too Far
<<if $daily.fishing.fishingMoor.fox.phase is "watching">>
	<<fishingMoorLineSnappedFox>>
<<elseif ["sit", "campfire"].includes($daily.fishing.fishingMoor.hikers.phase) and !(playerIsPregnant() and playerAwareTheyArePregnant())>>
	<<fishingMoorLineSnappedHikers>>
<<else>>
	<<fishingMoorFishTooFar>>
<</if>>


:: Widgets Fishing Moor Fish Too Far [widget]
<<widget "fishingMoorFishTooFar">>
	<<= setup.foodstuff[$fishingHookedFish.type].name>>【이가】 낚싯줄 끝까지 도달해 바늘을 풀고 <span class="red">도망쳤다</span>.
	<br><br><br>

	<<fishingMinigameResultUi $fishingMinigame.fishDistance "fishOffHook">>
	<br><br>

	<<unset $fishingHookedFish>>
	<<run fishingMinigameEnd()>>
	<<link [[미끼를 꿰어 낚싯줄을 던진다 (0:03)|Fishing Moor Wait]]>><<set $fishingAmbientOverride to "reHook">><<pass 3>><</link>>
	<br>
	<<link [[떠난다|Moor]]>><<set $eventskip to 1>><</link>>
<</widget>>
