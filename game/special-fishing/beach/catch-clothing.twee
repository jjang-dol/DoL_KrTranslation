:: Fishing Beach Clothing Catch
<<effects>>
<<if $daily.fishing.fishingBeach.fisher.phase is "fishing">>
	<<fishingBeachCatchClothingFisher>>
<<else>>
	<<fishingBeachCatchClothing>>
<</if>>

:: Widgets Fishing Beach Clothing Catch [widget]
<<widget "fishingBeachCatchClothingFisher">>
	<<fishingClothingCatchText>>
	<br><br>

	<<if $rng lt 50>>
		<<loadNPC 0 "fishing_beach_npc_fisher">><<person1>>
		<<switch random(1, 2)>>
			<<case 1>>
				"어떤 날엔 물고기보다 쓰레기가 더 많다니까," 당신이 건져올린 것을 흘끗 보며 <<personsimple>>【이가】 말한다.
			<<case 2>>
				<<personsimple>>【은는】 고개를 내젓는다. "사람들은 쓰레기를 아무 데나 버린단 말이야. 이곳에 대한 예의가 없어."
		<</switch>>
		<br><br>
	<</if>>

	<<link [[챙긴다|Fishing Beach Wait]]>><<endevent>><<set $fishingAmbientOverride to "keepClothing">><</link>>
	<br>
	<<link [[버린다|Fishing Beach Wait]]>><<endevent>><<set $fishingAmbientOverride to "tossClothing">><</link>>
<</widget>>


<<widget "fishingBeachCatchClothing">>
	<<fishingClothingCatchText>>
	<br><br>

	<<link [[챙긴다|Fishing Beach Wait]]>><<set $fishingAmbientOverride to "keepClothing">><</link>>
	<br>
	<<link [[버린다|Fishing Beach Wait]]>><<set $fishingAmbientOverride to "tossClothing">><</link>>
<</widget>>
