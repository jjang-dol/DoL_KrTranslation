:: Fishing Beach Wait
<<effects>>
<<run initFishingBeach()>>
<<wearActiveFishingRodProp>>

<<set _fishingEditBaitEnabled to true>>
<<fishingLocationDescription $bus>>
<<fishingLocationPopulation $bus>>
<<fishingBeachAmbient>>
<br><br>

<<set _exhibitionismCheck to Weather.dayState is "night" or (($exposed isnot 1 or hasSexStat("exhibitionism", 3)) and ($exposed lt 2 or hasSexStat("exhibitionism", 5)))>>

<<if $stress gte $stressmax>>
	<<if isPregnancyEnding()>>
		<<pregnancyPassout "beach">>
	<<else>>
		<<passoutbeach>>
	<</if>>
<<else>>
	<<if $exposed gte 1>>
		<<exhibitionism "beachFishing">>
		<br><br>
	<</if>>
	<<if $arousal gte $arousalmax>>
		<<orgasmFishingBeach>>
	<<elseif _exhibitionismCheck>>
		<<fishingBeachWaitAmbient>>
	<</if>>

	<br><br>

	<<if !_exhibitionismCheck>>
		<<insufficientStat "exhibitionism" "심하게 노출한 상태로 서있기엔">>
		<br>
		<<link [[해변으로 돌아간다|Beach]]>><<set $bus to "beach">><</link>>
	<<else>>
		<<link [[입질을 기다린다 (0:05)|Fishing Beach Wait Loop]]>><<pass 5>><</link>>
		<br>
		<<link [[해변으로 돌아간다|Beach]]>><<set $eventskip to 1>><<set $bus to "beach">><</link>>
	<</if>>
<</if>>

<<if $options.fishingBaitSelection is "dropdown">>
	<br><br>
	<<baitMobileDropdown>>
<<elseif $options.images isnot 1>>
	<br>
	<<link "미끼를 바꾼다">><<run openBaitOverlay()>><</link>>
<</if>>

<<fishingBeachDebugLinks>>


:: Fishing Beach Wait Loop
<<run V.fishing.waitsSinceLastCatch++>>
<<cleareventpool>>

<<addinlineevent "bite" fishingCatchEventWeight("fishingBeach", 10)>>
	<<set $fishingHookedFish to rollFish("fishingBeach")>>
	<<set _isPreferredBait to $fishing.currentBait !== undefined && setup.fishing.lootTables.fish[$fishingHookedFish.type].preferredBait is $fishing.currentBait>>
	<<run onBaitLoss()>>
	<<if fishTriggersMinigame($fishingHookedFish)>>
		<<run fishingMinigameStart($fishingHookedFish.type)>>
		<<include "Fishing Beach Minigame Loop">>
	<<else>>
		<<= setup.foodstuff[$fishingHookedFish.type].name>>【이가】 <<if _isPreferredBait>> 게걸스럽게<</if>> <<if $fishing.currentBait>>미끼를<<else>>낚싯바늘을<</if>> 물자 낚싯줄이 팽팽해지는 것이 느껴진다. 낚싯줄을 힘껏 당겨 녀석과 힘겨루기할 틈도 주지 않고 물 밖으로 건져 올린다.
		<<onFishCaught>>
		<<fishingCatchFishText $fishingHookedFish>>
		<br><br>

		<<include "Fishing Beach Catch">>
	<</if>>
<</addinlineevent>>

<<addinlineevent "trash" 1>>
	<<set $fishingTrash to rollFishingTrash("fishingBeach")>>
	<<include "Fishing Beach Trash Catch">>
<</addinlineevent>>

<<addinlineevent "clothing" 1>>
	<<set $clothingItem to rollFishingClothing("fishingBeach")>>
	<<include "Fishing Beach Clothing Catch">>
<</addinlineevent>>

/* Fisher event start */
<<if $daily.fishing.fishingBeach.fisher.phase is undefined and fishingMinutesIntoSession(30) and Time.hour gte 6 and Time.hour lt 20 and !["heavyPrecipitation", "storm", "thunderstorm"].includes(Weather.name)>>
	<<addinlineevent "fisherArrive" 0.5>>
		<<include "Fishing Beach Fisher Arrive">>
	<</addinlineevent>>
<</if>>

/* Fisher cliff tip */
<<if $daily.fishing.fishingBeach.fisher.phase is "fishing" and numberOfFishCaught() gte 50 and !$fishing.locationsFound.includes("fishingCoastPath")>>
	<<addinlineevent "fisherCliffTipOffer" 10>>
		<<include "Fishing Beach Fisher Cliff Tip Offer">>
	<</addinlineevent>>
<</if>>

/* Fisher leaves */
<<if $daily.fishing.fishingBeach.fisher.phase is "fishing">>
	<<if Time.hour gte 20>>
		<<addinlineevent "fisherLeaveNight" 10>>
			<<include "Fishing Beach Fisher Leave Night">>
		<</addinlineevent>>
	<<elseif ["heavyPrecipitation", "storm", "thunderstorm"].includes(Weather.name)>>
		<<addinlineevent "fisherLeaveWeather" 10>>
			<<include "Fishing Beach Fisher Leave Weather">>
		<</addinlineevent>>
	<</if>>

	<<if Time.hour gte 22>>
		<<set $eventPoolOverride to "fisherLeaveNight">>
	<</if>>
<</if>>

/* Fisher attacks if player is exposed */
<<if $daily.fishing.fishingBeach.fisher.phase is "fishing" and fishingHasMinutesPassedSinceNpcArrival(60) and $exposed gte 1>>
	<<addinlineevent "fisherExposedAttack" fishingDangerEventWeight($daily.fishing.fishingBeach.fisherOgle)>>
		<<include "Fishing Beach Fisher Exposed Attack">>
	<</addinlineevent>>
<</if>>

/* Bystander notices exposed player */
<<if $exposed gte 1 and Weather.dayState is "day">>
	<<addinlineevent "exposedNoticed" fishingDangerEventWeight(1)>>
		<<beachex1>>
	<</addinlineevent>>
	<<addinlineevent "exposedMolestation" fishingDangerEventWeight(1)>>
		<<beachex2>>
	<</addinlineevent>>
<</if>>

/* Wind blows skirt */
<<addinlineevent "beachWind" .2>>
	<<beachday4>>
<</addinlineevent>>

/* Wave soaks the PC */
<<if isPlayerFishingAlone()>>
	<<addinlineevent "beachWave" .2>>
		<<include "Fishing Beach Wave">>
	<</addinlineevent>>
<</if>>

/* Dog tearing at clothing */
<<if [undefined, "finished"].includes($daily.fishing.fishingBeach.fisher.phase) and !$worn.lower.type.includes("naked")>>
	<<addinlineevent "beachDog" fishingDangerEventWeight(0.75)>>
		<<beachday2>>
	<</addinlineevent>>
<</if>>

<<if Weather.dayState is "day">>
	/* Beach molestation */
	<<if [undefined, "finished"].includes($daily.fishing.fishingBeach.fisher.phase)>>
		<<addinlineevent "beachMolestation" fishingDangerEventWeight(0.75)>>
			<<include "Fishing Beach Molestation">>
		<</addinlineevent>>
	<</if>>

	/* See a parent on the beach */
	<<addinlineevent "beachParent" 1>>
		<<beachday3>>
	<</addinlineevent>>

	/* Classmates approach */
	<<addinlineevent "beachClassmates" 1>>
		<<include "Fishing Beach Classmates">>
	<</addinlineevent>>
<</if>>


<<if Weather.dayState is "night">>
	<<addinlineevent "nightDog" fishingDangerEventWeight(0.75)>>
		<<beachnight1>>
	<</addinlineevent>>
	<<addinlineevent "beachNightTentacles" fishingDangerEventWeight(0.75)>>
		<<include "Fishing Beach Tentacles">>
	<</addinlineevent>>
<</if>>

/* Nothing happens, wait loop continues */
<<addinlineevent "wait" 40>>
	<<include "Fishing Beach Wait">>
<</addinlineevent>>
<<runeventpool>>

:: Fishing Beach Cat Eat
<<effects>>
당신은 입을 크게 벌리고 <<= setup.foodstuff[$fishingHookedFish.type].name>>【을를】 통째로 밀어 넣는다. <<fishingEatFishTfProgress>><<lstress>><<stress -6>>
<<unset $fishingHookedFish>>
<br><br>

<<link [[다음|Fishing Beach Wait]]>><<set $fishingAmbientOverride to "castOut">><</link>>

:: Widgets Fishing Beach Wait Flavor [widget]
<<widget "fishingBeachAmbient">>
	<<if $daily.fishing.fishingBeach.fisher.phase is "fishing">>
		<<fishingBeachFisherAmbient>>
	<</if>>
<</widget>>

<<widget "fishingBeachWaitAmbient">>
	<<if $fishingAmbientOverride is "throwBack">>
		<<if $fishing.currentBait>>
			당신은 <<fishingRebaitMid>> 물고기를 다시 바다로 던진다.
		<<else>>
			당신은 물고기를 바다로 던져 넣고 다시 낚싯줄을 던진다.
		<</if>>
	<<elseif $fishingAmbientOverride is "stowAway">>
		<<if $fishing.currentBait>>
			당신은 <<fishingRebaitMid>> 물고기를 챙겨 둔다.
		<<else>>
			당신은 물고기를 챙겨 두고 다시 낚싯줄을 던진다.
		<</if>>
	<<elseif $fishingAmbientOverride is "reHook">>
		<<if $fishing.currentBait>>
			<<fishingRebaitStart>>
		<<else>>
			당신은 낚싯바늘을 다시 꿰고 바다를 향해 낚싯줄을 던진다.
		<</if>>
	<<elseif $fishingAmbientOverride is "keepClothing">>
		<<generalSend "wardrobe" $clothingItem.slot $clothingItem.item.name $clothingItem.colour>>
		당신은 <<= $clothingItem.item.name>>【을를】 꾹 짜내고 챙겨 둔다.
	<<elseif $fishingAmbientOverride is "tossClothing">>
		당신은 흠뻑 젖은 <<= $clothingItem.item.name>>【을를】 들고 모래사장 가장자리에 있는 쓰레기통으로 가 버린다.
	<<elseif $fishingAmbientOverride is "castOut">>
		당신은 물을 향해 낚싯줄을 던진다.
	<<else>>
		<<cleareventpool>>
		<<fishingWaitAmbient $bus>>

		<<if beachCampfirePartyPresent()>>
			<<fishingWaitAmbientCampfireParty>>
		<</if>>
		<<runeventpool>>
	<</if>>
	<<unset $fishingAmbientOverride>><<unset $clothingItem>>
<</widget>>
