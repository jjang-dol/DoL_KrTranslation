/* Hooks into and reuses the forest rescue system (<<forestRescueSetup>>, <<forestRescueCheck>>, <<forestRescue>> widgets) */
:: Fishing Forest Lake Bear Attack
<<effects>>
<<beastNEWinit 1 bear>>
<<if $settings.bestialityEnabled>>
	<<set $fishingBearMouthTarget to random(1, 4)>>
	등 뒤의 숲에서 우당탕하는 소리가 터져 나온다. 당신이 미처 돌아보기도 전에 거대한 <<beasttype>>【이가】 당신을 덮치고,
	<<if $fishingBearMouthTarget is 1>>
		<span class="red"><<bhis>> 입이 당신의 목을 물어뜯는다</span>.
	<<elseif $fishingBearMouthTarget is 2>>
		<span class="red"><<bhis>> 턱이 당신의 머리를 향해 덤벼든다</span>.
	<<else>>
		당신을 바닥으로 쓰러뜨린다.
	<</if>>
	<br><br>

	<<link [[싸운다|Fishing Forest Lake Bear Molestation]]>><<set $molestationstart to 1>><</link>>
<<else>>
	등 뒤의 숲에서 우당탕하는 소리가 터져 나온다. 거대한 <<beasttype>>【이가】 당신에게 돌진한다. 낚싯대로 쳐내며 간신히 쫓아냈지만, 상처를 피하지는 못했다.<<beastescape>>
	<br><br>

	<<link [[다음|Fishing Forest Lake Wait]]>><<endevent>><</link>>
<</if>>


:: Fishing Forest Lake Bear Molestation
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<beastCombatInit>>
	<<set $enemytrust -= 40>>
	<<set $enemyanger += 40>>
	<<set $enemyhealthmax to 400>>
	<<set $enemyhealth to 400>>
	<<set $enemyarousalmax to 1000>>
	
	<<if $fishingBearMouthTarget is 1>>
		<<set $NPCList[0].mouth to "neck">>
		<<set $head to "grappled">>
	<<elseif $fishingBearMouthTarget is 2>>
		<<set $NPCList[0].mouth to "hair">>
		<<set $head to "grappled">>
	<</if>>
	<<unset $fishingBearMouthTarget>>
	<<forestRescueSetup>>
<</if>>

<<effects>>
<<effectsman>>

<<forestRescueCheck "bear">>
<br>
<<beast $enemyno>>
<br><br>

<<stateman>>
<br><br>

<<actionsman>>

<<if _combatend>>
	<span id="next"><<link [[다음|Fishing Forest Lake Bear Molestation Finish]]>><</link>></span>
<<else>>
	<span id="next"><<link [[다음|Fishing Forest Lake Bear Molestation]]>><</link>></span>
<</if>>


:: Fishing Forest Lake Bear Molestation Finish
<<effects>>
<<set $fishing.fishingForestLake.event to "none">>
<<set $fishing.fishingForestLake.eventDanger to 0>>

<<if $enemyarousal gte $enemyarousalmax>>
	<<beastejaculation>>

	만족한 <<beasttype>>【은는】 숲으로 돌아간다.
	<br><br>

	<<tearful>> 당신은 짐을 챙겨 호숫가에서 물러난다.
	<br><br>

	<<clotheson>>
	<<endcombat>>

	<<link [[다시 낚시한다|Fishing Forest Lake Wait]]>><</link>>
	<br>
	<<link [[떠난다|Lake Fishing Rock]]>><<set $eventskip to 1>><</link>>
<<elseif $enemyhealth lte 0>>
	당신은 덩치 큰 <<beasttype>>【을를】 겁주어 쫓아냈다. <<bHe>>【은는】 나무들을 부러뜨리며 호숫가에서 도망친다.
	<br><br>

	<<tearful>> 당신은 짐을 챙겨 호숫가에서 물러난다.
	<br><br>

	<<clotheson>>
	<<endcombat>>

	<<link [[다시 낚시한다|Fishing Forest Lake Wait]]>><</link>>
	<br>
	<<link [[떠난다|Lake Fishing Rock]]>><<set $eventskip to 1>><</link>>
<<elseif $rescue is 1 and $alarm is 1>>
	<<forestRescue>>
<</if>>


:: Widgets Fishing Forest Lake Bear [widget]
/* Text that can appear while waiting if a bear will attack soon */
<<widget "fishingForestLakeBearAttackWaitAmbient">>
	<<addinlineevent 20>>
		<<print either(
			"바람에 젖은 짐승 털의 퀴퀴한 냄새가 실려 온다.",
			"숲 어딘가에서 쿵쿵거리는 무거운 발소리가 들린다.",
			"등 뒤 숲에서 나뭇가지가 부러지는 소리가 난다.",
			"무언가 당신을 지켜보고 있는 것 같은 기분이 든다."
		)>>
		<<set $fishing.fishingForestLake.eventDanger += 1>>
	<</addinlineevent>>
<</widget>>
