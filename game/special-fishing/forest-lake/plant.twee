/* Hooks into and reuses the forest rescue system (<<forestRescueSetup>>, <<forestRescueCheck>>, <<forestRescue>> widgets) */
:: Fishing Forest Lake Plant Attack
<<effects>>
당신이 낚싯대를 손에 쥐고 바위에 몸을 기대고 있을 때, 흙을 뚫고 솟아오른 뿌리들이 다리에 엉겨 붙어 다리를 벌리게 한 뒤 당신을 공중으로 들어 올린다.

<<set $leftleg to "bound">><<set $rightleg to "bound">>
<br><br>

<<link [[싸운다|Fishing Forest Lake Plant Molestation]]>><<set $molestationstart to 1>><</link>>


:: Fishing Forest Lake Plant Molestation
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<molested>>
	<<set $combat to 1>>
	<<set $enemytype to "tentacles">>
	<<tentaclestart 10 15 "root" "vine" true>>
	<<forestRescueSetup>>
<</if>>

<<statetentacles>>

<<effects>>
<<effectstentacles>>

<<forestRescueCheck>>

<<tentacles>>
<<actionstentacles>>

<<if $tentacles.active lte ($tentacles.max / 2)>>
	<span id="next"><<link [[다음|Fishing Forest Lake Plant Molestation Finish]]>><</link>></span>
<<else>>
	<span id="next"><<link [[다음|Fishing Forest Lake Plant Molestation]]>><</link>></span>
<</if>>


:: Fishing Forest Lake Plant Molestation Finish
<<effects>>
<<set $fishing.fishingForestLake.event to "none">>
<<set $fishing.fishingForestLake.eventDanger to 0>>
<<if $alarm is 1 and $rescue is 1>>
	<<forestRescue>>
<<else>>
	덩굴들은 당신에게 흥미를 잃고 진흙 속으로 물러난다. <<tearful>> 당신은 일어나서 낚싯대에 엉킨 덩굴을 풀어낸다.
	<br><br>

	<<clotheson>>
	<<endcombat>>

	<<link [[다시 낚시한다|Fishing Forest Lake Wait]]>><</link>>
	<br>
	<<link [[떠난다|Lake Fishing Rock]]>><<set $eventskip to 1>><</link>>
<</if>>


:: Widgets Fishing Forest Lake Plant [widget]
/* Text that can appear while waiting if vines will attack soon */
<<widget "fishingForestLakePlantAttackWaitAmbient">>
	<<addinlineevent 20>>
		<<print either(
			"취할 것 같은 달콤한 꽃내음이 바람을 타고 물 위로 밀려온다.",
			"근처 나무에 매달린 덩굴들이 기묘한 형태로 구불거리는 것이 눈에 띈다."
		)>>
		<<set $fishing.fishingForestLake.eventDanger += 1>>
	<</addinlineevent>>
<</widget>>
