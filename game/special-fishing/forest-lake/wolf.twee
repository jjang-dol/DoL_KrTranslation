/* Hooks into and reuses the forest rescue system (<<forestRescueSetup>>, <<forestRescueCheck>>, <<forestRescue>> widgets) */
:: Fishing Forest Lake Wolf Attack
<<effects>>
<<if Weather.dayState is "night">>
	<<set $fishingWolfCount to 2>>
<<else>>
	<<set $fishingWolfCount to 1>>
<</if>>
<<beastNEWinit $fishingWolfCount wolf>>
<<if $settings.bestialityEnabled>>
	<<set $fishingWolfMouthTarget to random(1, 4)>>
	낚싯줄이 물 위를 떠다니는 것을 지켜보고 있을 때, 숲속에서 으르렁거리는 소리가 터져 나온다.
	<<if $fishingWolfCount is 1>>
		<<beasttype>>【이가】 숲에서 튀어나와,
		<<if $fishingWolfMouthTarget is 1>>
			미처 반응하기도 전에 <span class="red"><<bhis>> 턱으로 당신의 목을 꽉 문다</span>.
		<<elseif $fishingWolfMouthTarget is 2>>
			미처 반응하기도 전에 <span class="red">당신의 얼굴을 향해 이빨을 드러내며 달려든다</span>.
		<<else>>
			미처 반응하기도 전에 당신을 향해 돌진한다.
		<</if>>
	<<else>>
		두 마리의 <<beastsplural>>【이가】 숲에서 튀어나와,
		<<if $fishingWolfMouthTarget is 1>>
			미처 반응하기도 전에 <span class="red">그중 한 마리가 턱으로 당신의 목을 꽉 문다</span>.
		<<elseif $fishingWolfMouthTarget is 2>>
			미처 반응하기도 전에 <span class="red">그중 한 마리가 당신 위로 뛰어올라</span> 얼굴을 향해 이빨을 드러낸다.
		<<else>>
			미처 반응하기도 전에 호숫가에서 당신을 에워싼다.
		<</if>>
	<</if>>
	<br><br>

	<<link [[싸운다|Fishing Forest Lake Wolf Molestation]]>><<set $molestationstart to 1>><</link>>
<<else>>
	낚싯줄이 물 위를 떠다니는 것을 지켜보고 있을 때, 숲속에서 으르렁거리는 소리가 터져 나온다.
	<<if $fishingWolfCount is 1>>
		<<beasttype>>【이가】 튀어나와 당신을 향해 이빨을 드러낸다. 간신히 쳐냈지만, 상처를 피하지는 못했다.
	<<else>>
		두 마리의 <<beastsplural>>【이가】 으르렁거리며 튀어나온다. 간신히 쳐냈지만, 상처 없이 빠져나오지는 못했다.
	<</if>><<beastescape>>
	<br><br>

	<<link [[다음|Fishing Forest Lake Wait]]>><<endevent>><</link>>
<</if>>


:: Fishing Forest Lake Wolf Molestation
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<beastCombatInit>>
	<<beastTrainGenerate>>
	<<unset $fishingWolfCount>>
	<<set $enemytrust -= 40>>
	<<set $enemyhealthmax to 600>>
	<<set $enemyhealth to 600>>
	<<set $enemyarousalmax to 500>>
	<<if $fishingWolfMouthTarget is 1>>
		<<set $NPCList[0].mouth to "neck">>
		<<set $head to "grappled">>
	<<elseif $fishingWolfMouthTarget is 2>>
		<<set $NPCList[0].mouth to "hair">>
		<<set $head to "grappled">>
	<</if>>
	<<unset $fishingWolfMouthTarget>>
	<<forestRescueSetup>>
<</if>>

<<effects>>
<<effectsman>>

<<forestRescueCheck>>
<br>
<<beast $enemyno>>
<br><br>

<<stateman>>
<br><br>

<<actionsman>>

<<if _combatend>>
	<span id="next"><<link [[다음|Fishing Forest Lake Wolf Molestation Finish]]>><</link>></span>
<<else>>
	<span id="next"><<link [[다음|Fishing Forest Lake Wolf Molestation]]>><</link>></span>
<</if>>


:: Fishing Forest Lake Wolf Molestation Finish
<<effects>>
<<set $fishing.fishingForestLake.event to "none">>
<<set $fishing.fishingForestLake.eventDanger to 0>>

<<if $enemyarousal gte $enemyarousalmax>>
	<<beastejaculation>>
	<<if $combatTrain.length gt 0>>
		<<beasttype>>【은는】 만족한 듯 끙끙거리고는, 자리를 대신 차지하려는 두 번째 <<beasttype>>에게 떠밀려 당신에게서 떨어진다.
		<br><br>

		<<combatTrainAdvance>>
		<<link [[다음|Fishing Forest Lake Wolf Molestation]]>><</link>>
	<<else>>
		<<beasttype>>【은는】 만족한 듯 끙끙거리며 호숫가에서 물러난다.
		<br><br>

		<<tearful>> 당신은 낚싯대를 집어 들고 짐을 챙긴다.
		<br><br>

		<<clotheson>>
		<<endcombat>>
		<<link [[다시 낚시한다|Fishing Forest Lake Wait]]>><</link>>
		<br>
		<<link [[떠난다|Lake Fishing Rock]]>><<set $eventskip to 1>><</link>>
	<</if>>
<<elseif $enemyhealth lte 0>>
	<<if $combatTrain.length gt 0>>
		<<beasttype>>【은는】 깨갱거리며 숲으로 도망친다. 이에 굴하지 않고 두 번째 <<beasttype>>【이가】 당신에게 다가온다.
		<br><br>

		<<combatTrainAdvance>>
		<<link [[다음|Fishing Forest Lake Wolf Molestation]]>><</link>>
	<<else>>
		<<beasttype>>【은는】 깨갱거리며 숲으로 도망치고, 당신만 홀로 남겨진다.
		<br><br>

		<<tearful>> 당신은 낚싯대를 집어 들고 짐을 챙긴다.
		<br><br>

		<<clotheson>>
		<<endcombat>>

		<<link [[다시 낚시한다|Fishing Forest Lake Wait]]>><</link>>
		<br>
		<<link [[떠난다|Lake Fishing Rock]]>><<set $eventskip to 1>><</link>>
	<</if>>
<<elseif $rescue is 1 and $alarm is 1>>
	<<forestRescue>>
<</if>>


:: Widgets Fishing Forest Lake Wolf [widget]
/* Text that can appear while waiting if a wolf will attack soon */
<<widget "fishingForestLakeWolfAttackWaitAmbient">>
	<<addinlineevent 20>>
		<<print either(
			"바람에 젖은 짐승 털의 퀴퀴한 냄새가 실려 온다.",
			"등 뒤 숲에서 나뭇가지가 부러지는 소리가 난다.",
			"무언가 당신을 지켜보고 있는 것 같은 기분이 든다."
		)>>
		<<set $fishing.fishingForestLake.eventDanger += 1>>
	<</addinlineevent>>
<</widget>>
