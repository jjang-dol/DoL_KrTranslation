			<<set $fishing.fishingForestLake.eventDanger to 0>>
		<</link>>
		<br>
		<<link [[바위 미끄러짐|Fishing Debug Forest Lake Pulled In]]>><</link>>
		<br>
		<<link [[벌레 떼|Fishing Forest Lake Swarm]]>><</link>>
		<br>
		<<link [[포획|Fishing Debug Forest Lake Catch]]>><</link>>
	<</if>>
<</widget>>

<<widget "fishingMoorDebugLinks">>
	<<if V.debug is 1>>
		<br><br><br><br><br>
		낚시 이벤트 디버그
		<br><br>
		<<link [[입질|Fishing Moor Catch]]>>
			<<set $fishingHookedFish to rollFish("fishingMoor")>>
		<</link>>
		<br>
		<<link [[미니게임|Fishing Moor Minigame Loop]]>>
			<<set $fishingHookedFish to rollFish("fishingMoor")>>
			<<for _i to 0; _i lt 67 and !setup.fishing.lootTables.fish[$fishingHookedFish.type].minigame; _i++>>
				<<set $fishingHookedFish to rollFish("fishingMoor")>>
			<</for>>
			<<set $fishingHookedFish.size to Math.max(setup.fishing.lootTables.fish[$fishingHookedFish.type].maxSize, 35)>>

			<<run fishingMinigameStart($fishingHookedFish.type)>>
		<</link>>
		<br>
		<<link [[쓰레기 낚음|Fishing Moor Trash Catch]]>>
			<<set $fishingTrash to rollFishingTrash("fishingMoor")>>
		<</link>>
		<br>
		<<link [[고양이 습격|Fishing Moor Cat Attack]]>>
			<<set $fishing.fishingMoor.event to "none">>
			<<set $fishing.fishingMoor.eventDanger to 0>>
		<</link>>
		<br>
		<<link [[괴생물 습격|Fishing Moor Lurker Attack]]>>
			<<set $fishing.fishingMoor.event to "none">>
			<<set $fishing.fishingMoor.eventDanger to 0>>
		<</link>>
		<br>
		<<link [[등산객 습격|Fishing Moor Hiker Attack]]>>
			<<set $fishing.fishingMoor.event to "none">>
			<<set $fishing.fishingMoor.eventDanger to 0>>
			<<set $daily.fishing.fishingMoor.hikers.phase to undefined>>
		<</link>>
		<br>
		<<link [[등산객 등장|Fishing Moor Hiker Arrive]]>>
			<<set $fishing.fishingMoor.event to "moorHikers">>
			<<set $fishing.fishingMoor.eventDanger to 0>>
			<<set $daily.fishing.fishingMoor.hikers.phase to undefined>>
			<<run Weather.set("clear", true)>>
		<</link>>
		<br>
		<<link [[등산객 술 권유|Fishing Moor Hiker Drink Offer]]>>
			<<set $daily.fishing.fishingMoor.hikers.phase to "sit">>
			<<set $daily.fishing.fishingMoor.hikers.drinkOffered to undefined>>
			<<set $daily.fishing.fishingMoor.hikers.drinkCount to 0>>
		<</link>> (등산객 등장을 먼저 실행해야 함)
		<br>
		<<link [[등산객 퇴장|Fishing Moor Hiker Leave]]>>
			<<set $daily.fishing.fishingMoor.hikers.phase to "sit">>
		<</link>> (등산객 등장을 먼저 실행해야 함)
		<br>
		<<link [[등산객 악천후 퇴장|Fishing Moor Hiker Leave Weather]]>>
			<<set $daily.fishing.fishingMoor.hikers.phase to "sit">>
		<</link>> (등산객 등장을 먼저 실행해야 함)
		<br>
		<<link [[등산객 황혼 퇴장|Fishing Moor Hiker Leave Dusk]]>>
			<<set $daily.fishing.fishingMoor.hikers.phase to "sit">>
		<</link>> (등산객 등장을 먼저 실행해야 함)
		<br>
		<<link [[등산객 야간 퇴장|Fishing Moor Hiker Leave Night]]>>
			<<set $daily.fishing.fishingMoor.hikers.phase to "sit">>
		<</link>> (등산객 등장을 먼저 실행해야 함)
		<br>
		<<link [[여우 등장|Fishing Moor Fox Arrive]]>>
			<<set $fishing.fishingMoor.event to "none">>
			<<set $daily.fishing.fishingMoor.fox.phase to undefined>>
			<<set $daily.fishing.fishingMoor.hikers.phase to undefined>>
		<</link>>
		<br>
		<<link [[등산객 추파|Fishing Moor Hiker Flirt]]>>
			<<set $daily.fishing.fishingMoor.hikers.phase to "sit">>
			<<set $daily.fishing.fishingMoor.hikers.flirt to undefined>>
		<</link>> (등산객 등장을 먼저 실행해야 함)
		<br>
		<<link [[약물 탄 술|Fishing Moor Spiked Drink 1]]>>
			<<set $daily.fishing.fishingMoor.hikers.phase to "sit">>
			<<set $daily.fishing.fishingMoor.hikers.drinkCount to 1>>
			<<set $daily.fishing.fishingMoor.hikers.spike to true>>
		<</link>> (등산객 등장을 먼저 실행해야 함)
		<br>
		<<link [[포획: 등산객|Fishing Debug Moor Catch Hikers]]>><</link>> (등산객 등장을 먼저 실행해야 함)
		<br>
		<<link [[포획: 모닥불 조리|Fishing Debug Moor Catch Campfire Cook]]>><</link>> (등산객 등장을 먼저 실행해야 함)
		<br>
		<<link [[포획: 여우|Fishing Debug Moor Catch Fox]]>><</link>>
	<</if>>
<</widget>>

<<widget "fishingPierDebugLinks">>
	<<if V.debug is 1>>
		<br><br><br><br><br>
		낚시 이벤트 디버그
		<br><br>
		<<link [[입질|Fishing Pier Catch]]>>
			<<set $fishingHookedFish to rollFish("fishingPier")>>
		<</link>>
		<br>
		<<for _fishKey, _fishConfig range setup.fishing.lootTables.fish>>
			<<if _fishConfig.minigame>>
				<<capture _fishKey, _fishConfig>>
					<<link [["미니게임: " + _fishKey + " (" + _fishConfig.minigame.behavior + ")" + " (" + _fishConfig.minigame.maxStamina + ")"|Fishing Pier Minigame Loop]]>>
						<<set $fishingHookedFish to { type: _fishKey, size: _fishConfig.maxSize }>>
						<<run fishingMinigameStart(_fishKey)>>
					<</link>>
				<</capture>>
				<br>
			<</if>>
		<</for>>
		<<link [[쓰레기 낚음|Fishing Pier Trash Catch]]>>
			<<set $fishingTrash to rollFishingTrash("fishingPier")>>
		<</link>>
		<br>
		<<link [[어부 등장|Fishing Pier Fisher Arrive]]>>
			<<set $daily.fishing.fishingPier.fisher.phase to undefined>>
			<<set $daily.fishing.fishingPier.whitney.phase to undefined>>
			<<run Weather.set("clear", true)>>
		<</link>>
		<br>
		<<link [[휘트니가 어부를 괴롭힘|Fishing Pier Whitney Bully Fisher]]>>
			<<set $daily.fishing.fishingPier.fisher.phase to "fishing">>
			<<set $daily.fishing.fishingPier.whitney.phase to undefined>>
		<</link>> (어부 등장을 먼저 실행해야 함)
		<br>
		<<link [[촉수|Fishing Pier Tentacles]]>>
			<<set $daily.fishing.fishingPier.whitney.phase to undefined>>
		<</link>>
		<br>
		<<link [[바람|Fishing Pier Wind]]>>
			<<run Weather.set("storm", true)>>
		<</link>>
		<br>
		<<link [[어부 야간 퇴장|Fishing Pier Fisher Leave Night]]>>
			<<set $daily.fishing.fishingPier.fisher.phase to "fishing">>
		<</link>> (어부 등장을 먼저 실행해야 함)
		<br>
		<<link [[어부 부두 구조|Fishing Pier Fisher Saved On Pier]]>>
			<<set $daily.fishing.fishingPier.fisher.phase to "fishing">>
			<<set $phase to 0>>
		<</link>> (어부 등장을 먼저 실행해야 함)
		<br>
		<<link [[어부 물에서 구조|Fishing Pier Fisher Saved From Water]]>>
			<<set $daily.fishing.fishingPier.fisher.phase to "fishing">>
			<<set $phase to 1>>
		<</link>> (어부 등장을 먼저 실행해야 함)
		<br>
		<<link [[휘트니 사이다 권유|Fishing Whitney Drink Offer]]>>
			<<set $daily.fishing.fishingPier.whitney.phase to "idle">>
			<<set $daily.fishing.fishingPier.whitney.pcCider to 0>>
		<</link>>
		<br>
		<<link [[휘트니 내기|Fishing Whitney Pier Bet]]>>
			<<set $daily.fishing.fishingPier.whitney.phase to "idle">>
		<</link>>
		<br>
		<<link [[휘트니 한가로이 퇴장|Fishing Pier Whitney Idle Leave]]>>
			<<set $daily.fishing.fishingPier.whitney.phase to "idle">>
			<<set $daily.fishing.fishingPier.whitney.age to 13>>
		<</link>>
		<br>
		<<link [[휘트니 한가로이 퇴장: 야간|Fishing Pier Whitney Leave Night]]>>
			<<set $daily.fishing.fishingPier.whitney.phase to "idle">>
		<</link>>
		<br>
		<<link [[휘트니 내기 퇴장: 야간|Fishing Pier Whitney Bet Leave Night]]>>
			<<set $daily.fishing.fishingPier.whitney.phase to "bet">>
		<</link>>
		<br>
		<<link [[파도|Fishing Pier Wave]]>><</link>>
		<br>
		<<link [[벌레 떼|Fishing Pier Swarm]]>><</link>>
		<br>
		<<link [[포획: 갈매기|Fishing Debug Pier Catch Seagull]]>><</link>>
		<br>
		<<link [[포획: 휘트니 키스|Fishing Debug Pier Catch Whitney Kiss]]>><</link>>
		<br>
		<<link [[포획: 휘트니 내기 승리|Fishing Debug Pier Catch Whitney Bet]]>><</link>>
		<br>
		<<link [[포획: 취한 어부|Fishing Debug Pier Catch Fisher Drunk]]>><</link>> (어부 등장을 먼저 실행해야 함)
		<br>
		<<link [[의류 낚음|Fishing Pier Clothing Catch]]>>
			<<set $clothingItem to rollFishingClothing("fishingPier")>>
		<</link>>
	<</if>>
<</widget>>


:: Fishing Debug Forest Lake Catch
<<set $fishingHookedFish ??= rollFish("fishingForestLake")>>
<<include "Fishing Forest Lake Catch">>


:: Fishing Debug Forest Lake Pulled In
<<set $fishingHookedFish ??= rollFish("fishingForestLake")>>
<<run fishingMinigameStart($fishingHookedFish.type)>>
<<include "Fishing Forest Lake Pulled In">>


:: Fishing Debug Beach Parent
<<beachday3>>


:: Fishing Debug Beach Night Dog
<<beachnight1>>


:: Fishing Debug Beach Night Molestation
<<beachnight2>>


:: Fishing Debug Beach Catch Seagull
<<set $fishingHookedFish ??= rollFish("fishingBeach")>>
<<set $daily.fishing.seagullSteal to undefined>>
<<fishingSeagullCatch $fishingHookedFish "fishingBeach">>


:: Fishing Debug Beach Catch Campfire Cook
<<set $fishingHookedFish ??= rollFish("fishingBeach")>>
<<set $daily.fishing.fishingBeach.partyFeed to undefined>>
<<fishingBeachCatchCampfireCook>>


:: Fishing Debug Beach Catch Fisher Drunk
<<set $fishingHookedFish ??= rollFish("fishingBeach")>>
<<set $daily.fishing.fishingBeach.fisher.phase to "fishing">>
<<set $daily.fishing.fishingBeach.fisher.drunk to 1>>
<<fishingBeachCatchFisherDrunk>>


:: Fishing Debug Coast Path Catch Seagull
<<set $fishingHookedFish ??= rollFish("fishingCoastPath")>>
<<set $daily.fishing.seagullSteal to undefined>>
<<fishingSeagullCatch $fishingHookedFish "fishingCoastPath">>


:: Fishing Debug Pier Catch Seagull
<<set $fishingHookedFish ??= rollFish("fishingPier")>>
<<set $daily.fishing.seagullSteal to undefined>>
<<fishingSeagullCatch $fishingHookedFish "fishingPier">>


:: Fishing Debug Pier Catch Whitney Kiss
<<set $fishingHookedFish ??= rollFish("fishingPier")>>
<<set $daily.fishing.fishingPier.whitney.phase to "idle">>
<<set $daily.fishing.fishingPier.whitney.fishKiss to undefined>>
<<fishingPierCatchWhitneyKiss>>


:: Fishing Debug Pier Catch Whitney Bet
<<set $fishingHookedFish ??= rollFish("fishingPier")>>
<<set $daily.fishing.fishingPier.whitney.phase to "bet">>
<<fishingPierCatchWhitneyBet>>


:: Fishing Debug Pier Catch Fisher Drunk
<<set $fishingHookedFish ??= rollFish("fishingPier")>>
<<set $daily.fishing.fishingPier.fisher.phase to "fishing">>
<<set $daily.fishing.fishingPier.fisher.drunk to 4>>
<<fishingPierCatchFisherDrunk>>


:: Fishing Debug Moor Catch Hikers
<<set $fishingHookedFish ??= rollFish("fishingMoor")>>
<<set $daily.fishing.fishingMoor.hikers.phase to "sit">>
<<fishingMoorCatchHikers>>


:: Fishing Debug Moor Catch Campfire Cook
<<set $fishingHookedFish ??= rollFish("fishingMoor")>>
<<set $daily.fishing.fishingMoor.hikers.phase to "sit">>
<<loadNPC 0 "moor_hiker_1">><<person1>>
<<loadNPC 1 "moor_hiker_2">><<person2>>
<<include "Fishing Moor Campfire Cook">>


:: Fishing Debug Moor Catch Fox
<<set $fishingHookedFish ??= rollFish("fishingMoor")>>
<<beastNEWinit 1 fox>><<saveNPC 0 "moor_fishing_fox">>
<<set $daily.fishing.fishingMoor.fox.phase to "watching">>
<<set $daily.fishing.fishingMoor.fox.closeness to 8>>
<<fishingMoorCatchFox>>
