:: Fishing Pier Trash Catch
<<effects>>
<<if $daily.fishing.fishingPier.whitney.phase is "bet">>
	<<fishingPierCatchTrashWhitneyBet>>
<<elseif $daily.fishing.fishingPier.fisher.phase is "fishing">>
	<<fishingPierCatchTrashFisher>>
<<else>>
	<<fishingPierCatchTrash>>
<</if>>


:: Widgets Fishing Pier Trash Catch [widget]
<<widget "fishingPierCatchTrashWhitneyBet">>
	<<fishingTrashCatchText $fishingTrash>>
	<<unset $fishingTrash>>
	<<set $daily.fishing.trashCaught to ($daily.fishing.trashCaught ?? 0) + 1>>
	<br><br>

	<<fishingPierWhitneyBetNonFish>>
<</widget>>

<<widget "fishingPierCatchTrashFisher">>
	<<fishingTrashCatchText $fishingTrash>>
	<<set $daily.fishing.trashCaught to ($daily.fishing.trashCaught ?? 0) + 1>>
	<br><br>

	<<if setup.fishing.lootTables.fishingTrash[$fishingTrash].isLitter and $rng lt 50>>
		<<loadNPC 0 "fishing_pier_npc_fisher">><<person1>>
		<<switch random(1, 2)>>
			<<case 1>>
				"어떤 날엔 물고기보다 쓰레기가 더 많지." 당신이 낚은 것을 힐끗 보며 <<personsimple>>【이가】 말한다.
			<<case 2>>
				<<personsimple>>【은는】 고개를 젓는다. "사람들이 아무 데나 쓰레기를 버린다니까. 이 장소에 대한 예의가 없어."
		<</switch>>
		<br><br>
	<</if>>
	<<unset $fishingTrash>>

	<<link [[다음|Fishing Pier Wait]]>><<endevent>><</link>>
<</widget>>


<<widget "fishingPierCatchTrash">>
	<<fishingTrashCatchText $fishingTrash>>
	<<unset $fishingTrash>>
	<<set $daily.fishing.trashCaught to ($daily.fishing.trashCaught ?? 0) + 1>>
	<br><br>

	<<link [[다음|Fishing Pier Wait]]>><</link>>
<</widget>>
