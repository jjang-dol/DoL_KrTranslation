:: Widgets Dance Actions [widget]
<<widget "danceactions">>
	<<exposure>>
	<<if $danceevent is 0>>
		<<if $exposed gte 2 and !hasSexStat("exhibitionism", 5) and $forceddance isnot 1 and !$danceStudio.job?.exposed and ($corruptionDancing is undefined or $dancelocation isnot "brothel")>>
			<!--
				No dancing if:
				Under 75 exhib, fully exposed, not forced, haven't chosen to dance despite exposure, (not at brothel or not corrupt dance)
			-->
		<<elseif $exposed gte 1 and !hasSexStat("exhibitionism", 3) and $forceddance isnot 1 and !$danceStudio.job?.exposed and ($corruptionDancing is undefined or $dancelocation isnot "brothel") and !$worn.under_lower.type.includes("dance")>>
			<!--
				No dancing if:
				Under 35 exhib, half exposed, not forced, haven't chosen to dance despite exposure,
				not wearing dance clothes, (not at brothel or not corrupt Dancing)
			-->
		<<else>>
			<!-- Generate "dance near" boxes -->
			<<if $audience gte 1>>
				<<for $_audienceMemberIndex to 0; $_audienceMemberIndex lt $enemyno; $_audienceMemberIndex++>> <!-- For each audience member 1-6 -->
					<<personselect $_audienceMemberIndex>>
					<div class="dance_box"><label>
						<<if $NPCList[$_audienceMemberIndex].masturbating gte 1>>
							<<if $NPCList[$_audienceMemberIndex].traits.includes("relaxed") and _danceaction is "sophisticated">>
								<span class="pink"><<person>>【이가】 자위를 한다.</span>
							<<elseif $NPCList[$_audienceMemberIndex].traits.includes("sociable") and _danceaction is "cool">>
								<span class="pink"><<person>>【이가】 자위를 한다.</span>
							<<elseif $NPCList[$_audienceMemberIndex].traits.includes("brooding") and _danceaction is "sensual">>
								<span class="pink"><<person>>【이가】 자위를 한다.</span>
							<<elseif $NPCList[$_audienceMemberIndex].traits.includes("lecher") and _danceaction is "sexual">>
								<span class="pink"><<person>>【이가】 자위를 한다.</span>
							<<else>>
								<<person>>【이가】 자위를 한다.
							<</if>>
							<<dance_npc_masturbation_chance $_audienceMemberIndex>>
						<<else>>
							<<person>>【이가】 지켜보고 있다.
						<</if>>
						<<capture $_audienceMemberIndex>>
							| <<him>> 근처에서 춤을 춘다. <<radiobutton "$dance_place" $_audienceMemberIndex autocheck>>
						<</capture>>
					</label></div>
					<br>
				<</for>>
				<br>
			<</if>>
			<!-- Generate general dance actions -->
			<<if $danceactiondefault is "cool">>
				<label>멋지게 춤을 춘다 (0:01) <<radiobutton "$danceaction" "cool" checked>></label> |
			<<elseif $danceactiondefault is 0>>
				<label>멋지게 춤을 춘다 (0:01) <<radiobutton "$danceaction" "cool" checked>></label> |
			<<else>>
				<label>멋지게 춤을 춘다 (0:01) <<radiobutton "$danceaction" "cool">></label> |
			<</if>>
			<br>
			<<if $danceactiondefault is "sophisticated">>
				<label>세련되게 춤을 춘다 (0:01) <<radiobutton "$danceaction" "sophisticated" checked>></label> |
			<<else>>
				<label>세련되게 춤을 춘다 (0:01) <<radiobutton "$danceaction" "sophisticated">></label> |
			<</if>>
			<br>
			<<if $danceactiondefault is "seductive">>
				<label><span class="meek">유혹적인 춤을 춘다</span> (0:01) <<combatexhibitionist1>> <<radiobutton "$danceaction" "seductive" checked>></label> |
			<<else>>
				<label><span class="meek">유혹적인 춤을 춘다</span> (0:01) <<combatexhibitionist1>> <<radiobutton "$danceaction" "seductive">></label> |
			<</if>>
			<br>
			<<if hasSexStat("exhibitionism", 2)>>
				<<if $danceactiondefault is "sexual">>
					<label><span class="sub">성적인 춤을 춘다</span> (0:01) <<combatexhibitionist2>> <<radiobutton "$danceaction" "sexual" checked>></label> |
				<<else>>
					<label><span class="sub">성적인 춤을 춘다</span> (0:01) <<combatexhibitionist2>> <<radiobutton "$danceaction" "sexual">></label> |
				<</if>>
				<br>
			<</if>>
			<<goocount>>
			<<if $cat gte 6 and $liquidoutsidecount gte 1 and !pcAreArmsBound("any")>>
				<<if $danceactiondefault is "groom">>
					<label><span class="sub">털을 고른다</span> (0:01) <span class="blue">고양이</span> <<radiobutton "$danceaction" "groom" checked>></label> |
				<<else>>
					<label><span class="sub">털을 고른다</span> (0:01) <span class="blue">고양이</span> <<radiobutton "$danceaction" "groom">></label> |
				<</if>>
			<</if>>
			<!-- Generate stripping dance actions -->
			<<dancestripactions>>
			<br><br>
			<<link [[계속한다|$passage]]>><</link>>
			<br>
		<</if>>
	<<elseif $danceevent is "vip">>
		<<link [[허락한다|$passage]]>><<set $danceaction to "vipallow">><</link>>
		<br>
		<<link [[밀쳐낸다|$passage]]>><<set $danceaction to "vippush">><</link>>
		<br>
	<<elseif $danceevent is "darryl">>
		<<link [[안심시킨다|$passage]]>><<set $danceaction to "darrylreassure">><<npcincr Darryl love 1>><</link>><<glove "Darryl" "simple">>
		<br>
		<<link [[데릴을 무대 위로 끌어올린다|$passage]]>><<set $danceaction to "darrylpull">><</link>>
		<br>
	<<elseif $danceevent is "briar">>
		<<link [[브라이어에게 윙크한다|$passage]]>><<set $danceaction to "briarwink">><<npcincr Briar love 1>><</link>><<glove "Briar" "simple">>
		<br>
		<<if hasSexStat("promiscuity", 3)>>
			<<link [[브라이어를 유혹한다|$passage]]>><<set $danceaction to "briarseduce">><</link>><<promiscuous3>>
			<br>
		<<else>>
			<span class="blue">브라이어를 유혹하고 싶다는 생각이 스쳐 지나가지만, 당신은 그만큼 음란하지 않다.</span>
			<br>
		<</if>>
	<<elseif $danceevent is "strippertrouble">>
		<<link [[개입한다|$passage]]>><<set $danceaction to "stripperhelp">><</link>>
		<br>
		<<link [[무시한다|$passage]]>><<set $danceaction to "stripperignore">><</link>>
		<br>
	<<elseif $danceevent is "note">>
		<<link [[접근한다|$passage]]>><<set $danceaction to "noteapproach">><</link>>
		<br>
		<<link [[무시한다|$passage]]>><<set $danceaction to "noteignore">><</link>>
		<br>
	<<elseif $danceevent is "rape">>
	<<elseif $danceevent is "molest">>
		<<link [[은근슬쩍 더듬게 내버려 둔다|$passage]]>><<set $danceaction to "cop">><</link>>
		<br>
		<<if $dancelocation is "brothel" and $corruptionDancing isnot undefined>>
			귓속의 슬라임이 쇼를 끝내지 못하게 막는다.
		<<elseif $forceddance isnot 1>>
			<<link [["너무 위험하니 쇼를 끝낸다"|$passage]]>><<set $danceaction to "finish">><</link>>
			<br>
		<</if>>
	<<elseif $danceevent is "skirtstrip">>
		<<link [[옷을 지키기 위해 몸부림친다|$passage]]>><<set $danceaction to "skirtstruggle">><</link>>
		<br>
		<<link [[옷을 순순히 내준다|$passage]]>><<set $danceaction to "skirtsurrender">><</link>>
		<br>
	<<elseif $danceevent is "overlowerstrip">>
		<<link [[옷을 지키기 위해 몸부림친다|$passage]]>><<set $danceaction to "overlowerstruggle">><</link>>
		<br>
		<<link [[옷을 순순히 내준다|$passage]]>><<set $danceaction to "overlowersurrender">><</link>>
		<br>
	<<elseif $danceevent is "lowerstrip">>
		<<link [[옷을 지키기 위해 몸부림친다|$passage]]>><<set $danceaction to "lowerstruggle">><</link>>
		<br>
		<<link [[옷을 순순히 내준다|$passage]]>><<set $danceaction to "lowersurrender">><</link>>
		<br>
	<<elseif $danceevent is "overupperstrip">>
		<<link [[옷을 지키기 위해 몸부림친다|$passage]]>><<set $danceaction to "overupperstruggle">><</link>>
		<br>
		<<link [[옷을 순순히 내준다|$passage]]>><<set $danceaction to "overuppersurrender">><</link>>
		<br>
	<<elseif $danceevent is "upperstrip">>
		<<link [[옷을 지키기 위해 몸부림친다|$passage]]>><<set $danceaction to "upperstruggle">><</link>>
		<br>
		<<link [[옷을 순순히 내준다|$passage]]>><<set $danceaction to "uppersurrender">><</link>>
		<br>
	<<elseif $danceevent is "understrip">>
		<<link [[옷을 지키기 위해 몸부림친다|$passage]]>><<set $danceaction to "understruggle">><</link>>
		<br>
		<<link [[옷을 순순히 내준다|$passage]]>><<set $danceaction to "undersurrender">><</link>>
		<br>
	<<elseif $danceevent is "underupperstrip">>
		<<link [[옷을 지키기 위해 몸부림친다|$passage]]>><<set $danceaction to "underupperstruggle">><</link>>
		<br>
		<<link [[옷을 순순히 내준다|$passage]]>><<set $danceaction to "underuppersurrender">><</link>>
		<br>
	<<elseif $danceevent is "private" and $dancelocation isnot "underground">>
		<<link [[무시한다|$passage]]>><<set $danceaction to "privaterefuse">><</link>>
		<br>
	<<elseif $danceevent is "leighton">>
		<<link [[무시한다|$passage]]>><<set $weekly.leightonDanceRefused to true>><</link>>
		<br>
	<<elseif $danceevent is "robin">>
		<<link [[무시한다|$passage]]>><<set $danceaction to "robinignore">><<npcincr Robin love -5>><<npcincr Robin dom -20>><</link>>
		<br>
	<<elseif $danceevent is "drink">>
		<<if playerIsPregnant() and playerAwareTheyArePregnant()>>
			<span class="blue">아이를 가졌다는 걸 알면서 술을 마실 수는 없다.</span>
			<br>
		<<else>>
			<<link [[마신다|$passage]]>><<set $danceaction to "drink">><</link>><<dancedifficulty 1 `800 + $drunk`>><<gdrunk>>
			<br>
			<<link [[조심스럽게 마신다|$passage]]>><<set $danceaction to "drink_careful">><</link>><<gdrunk>>
			<br>
		<</if>>
		<<link [[무시한다|$passage]]>><<set $danceaction to "drink_ignore">><</link>>
		<br>
	<<elseif $danceevent is "light">>
		<<if hasSexStat("exhibitionism", 5)>>
			<<link [[과시한다|$passage]]>><<set $danceaction to "light_flaunt">><</link>><<ginterest>>
			<br>
		<</if>>
		<<if $forceddance is 1 or $danceStudio.job?.exposed>>
			<<link [[몸을 가린다|$passage]]>><<set $danceaction to "light_cover">><</link>>
			<br>
		<</if>>
	<<elseif $danceevent is "corruptionDance">>
		<<if hasSexStat("promiscuity", 5) and $submissive gte 1900>>
			<<link [[기꺼이 복종한다|$passage]]>>
				<<corruption 3>><<pain -8>><<stress -12>><<trauma -24>><<sub 2>>
				<<set $corruptionResult to "submit">><<set $danceaction to "corruptionResult">>
			<</link>><<promiscuous5>><<ggcorruption>><<llpain>><<llltrauma>><<llstress>>
			<br>
		<</if>>
		<<link [[복종한다|$passage]]>>
			<<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 1>>
			<<set $corruptionResult to "obey">><<set $danceaction to "corruptionResult">>
		<</link>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
		<br>
		<<link [[반항한다|$passage]]>>
			<<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>>
			<<set $corruptionResult to "defy">><<set $danceaction to "corruptionResult">>
		<</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
		<br>
	<</if>>
<</widget>>

:: Widgets Dance Audience [widget]
<<widget "danceaudience">>
	<<if $danceevent is 0>>
		<<if $worn.feet.type.includes("heels")>>
			<<set _heelBonus to $worn.feet.reveal / 100>>
		<<else>>
			<<set _heelBonus to -4>>
		<</if>>
		<<rng>>
		<<if ($allure / 100 + currentSkillValue('danceskill') / 20 + $audienceexcitement / 5 + $audiencearousal / 5 + _heelBonus) gte $rng>>
			<<if $audience gte 0 and $audience lte 5>>
				<<generatel>><<personselect $audience>>
				<<person>>【이가】 당신을 지켜보기 시작한다.
			<<else>>
				다른 누군가 관객에 합류한다.
			<</if>>
			<<set $audience += 1>>
			<<person_dance>>
		<</if>>
		<<if $audience is 0>>
			아무도 당신에게 관심을 주지 않는다.
		<<elseif $audience is 1>>
			<<person>>【이가】 당신을 뚫어지게 쳐다보고 있다.
		<<elseif $audience is 2>>
			두어 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 3>>
			몇 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 4>>
			네 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 5>>
			다섯 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 6>>
			여섯 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 7>>
			일곱 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 8>>
			여덟 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 9>>
			아홉 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 10>>
			열 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 11>>
			열한 명의 사람이 당신을 지켜보고 있다.
		<<elseif $audience is 12>>
			열두 명 남짓한 사람들이 당신을 지켜보고 있다.
		<<elseif $audience lte 24>>
			작은 군중이 당신을 지켜보고 있다.
		<<elseif $audience lte 36>>
			꽤 많은 인파가 몰려들었다.
		<<else>>
			커다란 인파가 당신을 지켜보고 있다. 뒤에 있는 사람들은 조금이라도 잘 보려고 애쓰고 있다.
		<</if>>
		<<dancespeech>>
		<<dance_npc_masturbation>>
		<<person_dance>>
		<br><br>
		<<if $audience gte 1>>
			당신의 관객은
			<<if $audienceexcitement is 0>>
				<span class="red">집중하지 못하고</span>
			<<elseif $audienceexcitement lte 20>>
				<span class="pink">무관심하며</span>
			<<elseif $audienceexcitement lte 40>>
				<span class="purple">집중하고 있으며</span>
			<<elseif $audienceexcitement lte 60>>
				<span class="blue">흥미로워하고</span>
			<<elseif $audienceexcitement lte 80>>
				<span class="lblue">감명받았으며</span>
			<<elseif $audienceexcitement lte 99>>
				<span class="teal">몰두하고 있으며</span>
			<<else>>
				<span class="green">집착하고 있으며</span>
			<</if>>
			그리고
			<<if $audiencearousal is 0>>
				<span class="blue">점잖다.</span>
			<<elseif $audiencearousal lte 20>>
				<span class="lblue">내성적이다.</span>
			<<elseif $audiencearousal lte 40>>
				<span class="teal">온건하다.</span>
			<<elseif $audiencearousal lte 60>>
				<span class="green">흥분해 있다.</span>
			<<elseif $audiencearousal lte 80>>
				<span class="purple">음욕에 차 있다.</span>
			<<elseif $audiencearousal lte 99>>
				<span class="pink">호색적이다.</span>
			<<else>>
				<span class="red">육욕으로 가득 차 있다.</span>
			<</if>>
			<<if $dance_stage_cum gte 10>>
				무대에 정액이 묻지 않은 곳이 <span class="red">단 한 치도 없다.</span>
			<<elseif $dance_stage_cum gte 8>>
				무대가 정액으로 <span class="pink">흠뻑 젖어 있다.</span>
			<<elseif $dance_stage_cum gte 6>>
				무대가 정액으로 <span class="purple">칠해져 있다.</span>
			<<elseif $dance_stage_cum gte 4>>
				무대가 정액으로 <span class="blue">젖어 있다.</span>
			<<elseif $dance_stage_cum gte 2>>
				무대에 정액이 <span class="lblue">크게</span> 웅덩이져 있다.
			<<elseif $dance_stage_cum gte 1>>
				무대에 정액이 <span class="teal">작게</span> 웅덩이져 있다.
			<</if>>
			<<set $audiencemod to Math.clamp($audiencemod, 1, 10)>>
			<br>
			경외심: <<statbarinverted $audiencemod 10>>

			<<rng>>
			<<if ($allure / 100 + currentSkillValue('danceskill') / 20 + $audienceexcitement / 5 + $audiencearousal / 5) gte $rng + 50>>
				<<rng 10>>
				<<set $dancetip to ($rng * $audience * $venuemod * $audiencemod)>>
				<<if $worn.feet.type.includes("heels")>>
					<<set $dancetip *= (1 + $worn.feet.reveal / 3000)>>
				<<else>>
					<<set $dancetip *= 0.9>>
				<</if>>
				<<set $dancetip *= 1 + ($mathstrait / 4)>>
				<<if $dancetip gte 5000>>
					당신의 공연에 열광한 관객들이 당신에게 현금 세례를 쏟아붓는다.
				<<elseif $dancetip gte 500>>
					누군가 당신에게 두둑한 팁을 던져준다.
				<<else>>
					누군가 당신에게 꽤 괜찮은 팁을 던져준다.
				<</if>>
				<<set $dancetip = Math.trunc($dancetip)>>
				<<if $dancetip gte 50>>
					<<set $dancetip to 100 * Math.round( $dancetip / 100.0 )>>
				<<else>>
					<<set $dancetip to 5 * Math.round( $dancetip / 5.0 )>>
				<</if>>
				<<set $dancetip to Math.max( $dancetip, 5 )>>
				<<if $venuemod is 0>>
					그들은 당신이 팁을 가지도록 내버려두지 않을 것이다.
				<<else>>
					<<printmoney $dancetip>>【을를】 얻었다.
					<<if $dancelocation>>
						<<switch $dancelocation>>
							<<case "stage">><<set _tipSource to "danube">>
							<<case "club">><<set _tipSource to "stripClub">>
							<<default>><<set _tipSource to $dancelocation>>
						<</switch>>
						<<set _tipSource += "DanceTips">>
					<<else>>
						<<set _tipSource to "danceTips">>
					<</if>>
					<<money $dancetip _tipSource>>
				<</if>>
			<</if>>
			<br><br>
			<<rng>><<rngWraith 2 "night">>
			<<if ($wraith.state is "haunt" or $wraith.offspring is "dead") and _wraithEvent and $rng lte 10>>
				<<danceWraith>>
				<<set $_blockDancingEvents to true>>
			<<elseif currentSkillValue('danceskill') lt ( ($dance_stage_cum * 50) + random(1,250) )>>
				<<if currentSkillValue('danceskill') gte ( ($dance_stage_cum * 40) + random(1,100) )>>
					정액으로 뒤덮인 무대에서 발이 미끄러지지만, <span class="green">당신은 균형을 되찾으며,</span> 자연스레 춤 동작의 일부로 만들어 넘긴다.
				<<else>>
