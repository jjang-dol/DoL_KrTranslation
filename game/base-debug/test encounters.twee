:: The Pod
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<generate1>><<generate2>><<generate3>><<generate4>><<generate5>><<generate6>><<person1>>
	방이 흔들리더니 옆으로 이동하는 것이 느껴진다. 정신을 차려보니 아무것도 없는 검은 방 안, 당신은 $enemyno명의 무리와 밧줄 뒤의 관중과 함께 있다. 벽에는 밝은 주황색 글씨로 <span class="orange">디버그</span>라고 쓰인 표지판과 함께, 당신이 이해할 수 없는 다른 통계들이 적혀 있다.
	<br><br>
	<span class="red">무리가 다가온다...</span>
	<br><br>
	<<controlloss>>
	<br>
	<<violence 1>>
	<<neutral 1>>
	<<maninit>>
<</if>>

<span class="orange">디버그 그룹:</span> <span class="red">신뢰: $enemytrust 체력: <<print Math.trunc($enemyhealth)>> : $enemyhealthmax 흥분: <<print Math.trunc($enemyarousal)>> : $enemyarousalmax 분노: $enemyanger : $enemyangermax </span>
<br>
<span class="orange">디버그 창관 이벤트:</span> 현재 적 $enemynomax 중 (1 - 6): $enemyno
<br>
<span class="green">디버그: 적 #: 체력 설명 성별 대명사 성기 질 입 왼손 오른손 의상</span>
<br>
<<for _ii = 0; _ii < $enemynomax; _ii++>>
	디버그: _ii: <<print Math.trunc($NPCList[_ii].health)>> $NPCList[_ii].description $NPCList[_ii].gender $NPCList[_ii].pronoun $NPCList[_ii].penis $NPCList[_ii].vagina $NPCList[_ii].mouth $NPCList[_ii].lefthand $NPCList[_ii].righthand $NPCList[_ii].clothes.upper.name $NPCList[_ii].clothes.lower.name
	<br>
<</for>>
디버그 PC (P/V/A/M/LARM): $penisstate $vaginastate $anusstate $mouthstate $leftarm
<br><br>

<<effects>>
<<effectsman>>
<<alarmstate>>
<<man>>
<<audience>>
<<stateman>>
<br><br>
<<actionsman>>

<<if $alarm is 1>>
	<<if $rescue is 0>>
		<<set $alarm to 0>>
		<<if ($enemyarousal gte $enemyarousalmax) or ($enemyhealth lte 0)>>
			<span id="next"><<link [[다음|The Pod Finish]]>><</link>></span><<nexttext>>
		<<else>>
			<span id="next"><<link [[다음|The Pod]]>><</link>></span><<nexttext>>
		<</if>>
	<</if>>
<<elseif ($enemyarousal gte $enemyarousalmax) or ($enemyhealth lte 0)>>
	<span id="next"><<link [[다음|The Pod Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|The Pod]]>><</link>></span><<nexttext>>
<</if>>

:: The Pod Finish
<<effects>>

<<if $enemyhealth lte 0>>
	<<He>>【은는】 고통에 몸을 움츠려, 당신에게 필요한 기회를 준다. <<tearful>> 당신은 바닥에 쓰러진 무리를 뒤로하고 도망친다.
	<br>
	방이 다시 한번 바뀌는 것을 느끼고, 당신의 침실에 와 있는 것을 발견한다.
	<br><br>
	<<clotheson>>
	<<endcombat>>
	<<link [[다음|Bedroom]]>><</link>>
<<elseif $enemyarousal gte $enemyarousalmax>>
	<<ejaculation>>
	<<if $audience is 1>>
		<<person1>><<person>>【이가】 절정에 달하자 군중 속에서 환호성이 터져 나온다. <<tearful>> 당신은 다른 누군가가 딴생각을 품기 전에 간신히 비틀거리며 자리를 피한다.
	<<elseif $audience lte 6>>
		<<person1>><<person>>【와과】 <<person2>><<person>>【이가】 서로 하이파이브를 한다. <<tearful>> 관중들이 서로 축하하는 동안 당신은 간신히 비틀거리며 자리를 피한다.
	<<else>>
		군중 속에서 환호성이 터져 나온다. 쇼가 마음에 든 모양이다. <<tearful>> 당신은 다른 누군가가 딴생각을 품기 전에 간신히 비틀거리며 자리를 피한다.
	<</if>>
	<br><br>
	<<stealclothes>>
	<<clotheson>>
	<<endcombat>>
	방이 다시 한번 바뀌는 것을 느끼고, 당신의 침실에 와 있는 것을 발견한다.
	<br><br>
	<<link [[다음|Bedroom]]>><</link>>
<</if>>

:: The Farm
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<generateBEAST 1 dog>>
	<<generateBEAST 2 pig>>
	<<generateBEAST 3 cat>>
	<<generateBEAST 4 fox>>
	<<generateBEAST 5 lizard>>
	<<generateBEAST 6 creature>>
	<<beastTrainGenerate>>
		숲에서 비틀거리며 나오자 가파른 절벽 가장자리에 다다른다. 균형을 잃은 <span class="red">당신은 가장자리 너머로 넘어져 바닥까지 굴러떨어진다.</span>
		<br><br>
		정신을 차리자 작은 농장의 주 마당에 있는 자신을 발견한다. 여러 동물들이 당신 주위에서 춤추며... 노래하는 것을 보고 깜짝 놀란다...
		<br><br>
		<span class="green">맥도날드 할배의 강간 농장
		<br>
		이-아이-이-아이-오
		<br>
		이 농장에서 우린 걸레를 찾았지
		<br>
		이-아이-이-아이-오</span>
		<br><br>
		<span class="red">그들은 노래를 멈추고 당신에게 다가온다</span>
		<br>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>
	<<beastCombatInit>>
<</if>>
<<effects>>
<<effectsman>>
<br>
<<beast $enemyno>>
<br><br>
<<if $replayScene is undefined>>
	디버그 야수 이벤트: 현재 적 $enemynomax 중 (1 - 6): $enemyno
	<br>
	<span class="green">디버그: 적 #: 생성 대명사 유형 몬스터 자세 자지 질</span>
	<br>
	<<for _ii = 0; _ii < $enemynomax; _ii++>>
		디버그: _ii: $NPCList[_ii].gender $NPCList[_ii].pronoun $NPCList[_ii].type $NPCList[_ii].monster $NPCList[_ii].stance $NPCList[_ii].penis $NPCList[_ii].vagina
		<br>
	<</for>>
	<br><br>
<</if>>
<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend>>
	<span id="next"><<link [[다음|The Farm Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|The Farm]]>><</link>></span><<nexttext>>
<</if>>

:: The Farm Finish
<<effects>>
<<if $enemyhealth lte 0>>
	<<beastwound>>
	<<if $combatTrain.length gt 0>>
		<<print window.KR.getBeastTypeKr($NPCList[0].type)>>【은는】 고통과 공포에 움츠러들지만, 다른 짐승이 차례를 노리고 있다.
		<<combatTrainAdvance>>
		<br><br>
		<<link [[다음|The Farm]]>><</link>>
	<<else>>
		<<print window.KR.getBeastTypeKr($NPCList[_na].type)>>【은는】 고통과 공포에 움츠러든다.
		<br><br>
		<<link [[다음|The Farm Finish]]>><<set $finish to 1>><</link>>
	<</if>>
<<elseif $enemyarousal gte $enemyarousalmax>>
	<<beastejaculation>>
	<<if $combatTrain.length gt 0>>
		만족한 <<print window.KR.getBeastTypeKr($NPCList[0].type)>>【이가】 물러나자 다른 짐승이 차례를 차지한다.
		<<combatTrainAdvance>>
		<br><br>
		<<link [[다음|The Farm]]>><</link>>
	<<else>>
		만족한 <<print window.KR.getBeastTypeKr($NPCList[0].type)>>【이가】 당신에게서 멀어진다.
		<br><br>
		<<link [[다음|The Farm Finish]]>><<set $finish to 1>><</link>>
	<</if>>
<<elseif $finish is 1>>
	<<if $enemywounded is 1 and $enemyejaculated is 0>>
		<<print window.KR.getBeastTypeKr($NPCList[_na].type)>>【은는】 낑낑거리며 헛간으로 도망친다.
	<<elseif $enemywounded is 0 and $enemyejaculated is 1>>
		<<print window.KR.getBeastTypeKr($NPCList[_na].type)>>【은는】 당신을 풀밭에 내버려 두고 떠난다.
	<<elseif $enemywounded gte 2 and $enemyejaculated is 0>>
		당신이 감당하기엔 너무 귀찮다고 느꼈는지, 동물들은 근처 헛간으로 도망친다.
	<<elseif $enemywounded is 0 and $enemyejaculated gte 2>>
		동물들은 기진맥진해 풀밭 위에서 떨고 있는 당신을 내버려 두고 떠난다.
	<<elseif $enemywounded gte 1 and $enemyejaculated gte 1>>
		동물들은 기진맥진해 풀밭 위에서 떨고 있는 당신을 내버려 두고 떠난다.
	<</if>>
	<br><br>
	<<tearful>> 당신은 몸을 추스른다.
	<br><br>
	<<clotheson>>
	<<endcombat>>
	어디선가 염소 한 마리가 헛간에서 달려 나온다. 뒷발로 일어선 <span class="green">그것은 당신을 걷어차 도무스 가의 당신 침실 창문까지 날려 보낸다.</span>
	<br>
	<<link [[다음|Bedroom]]>><</link>>
<</if>>

:: Beast Parade
<!-- Used to debug Beast generation by displaying all attributes. -->
<span class="red">총 짐승 종류: $BeastList.length</span>
<br>

<<for _i = 0; _i lt $BeastList.length; _i++>>
	/% <<generateBEAST 1 $BeastList[_i]>><!-- This can call all m/f if specified --> %/
	<<beastNEWinit 1 $BeastList[_i]>>
	<br>
	짐승 <<print _i>> 소개: <span class="green">$NPCList[0].description $NPCList[0].type</span>
	<br>
	대명사: <span class="red">$NPCList[0].pronoun</span> 성별: <span class="red">$NPCList[0].gender</span>
	<br>
	성기 크기, 설명: <span class="gold">$NPCList[0].penissize, <<= window.KR.getPenisDescKr($NPCList[0].penisdesc)>></span> 가슴 크기, 설명: <span class="gold">$NPCList[0].breastsize, <<= window.KR.getBreastSizeKr($NPCList[0].breastsdesc)>></span>
	<br>
	성기 활성: <span class="gold">$NPCList[0].penis</span> 질 활성: <span class="gold">$NPCList[0].vagina</span>
	<br>
	/% DOM: $NPCList[0].dom LUST $NPCList[0].lust RAGE: $NPCList[0].rage TRAUMA $NPCList[0].trauma<br> %/
	/% STATE: $NPCList[0].state<br> %/
<</for>>

<<link [[다음|Bedroom]]>><</link>>

:: Beast Train
