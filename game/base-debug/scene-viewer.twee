	<</if>>
	<<if $harper_appointments.hypnosis gte 5>>
		<<set $scenePassages.pushUnique("HarperHypnosisTrance4")>>
	<</if>>
	<<if $harper_appointments.exam gte 1>>
		<<set $scenePassages.pushUnique("HarperHypnosisExam1")>>
	<</if>>
	<<if $harper_appointments.exam gte 2>>
