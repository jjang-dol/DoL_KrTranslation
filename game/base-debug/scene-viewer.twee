		<<if $nightmaresSeen.includes("harper")>>
			<<set $scenePassages.pushUnique("NightmareHarper")>>
		<</if>>
		<<if $nightmaresSeen.includes("sydneyCorrupt")>>
			<<set $scenePassages.pushUnique("NightmareCorruptSydney")>>
		<</if>>
		<<if $nightmaresSeen.includes("Alex")>>
			<<set $scenePassages.pushUnique("NightmareAlex")>>
		<</if>>
		<<if $nightmaresSeen.includes("witch")>>
			<<set $scenePassages.pushUnique("NightmareWitch")>>
		<</if>>
		<<if $nightmaresSeen.includes("gwylan")>>
			<<set $scenePassages.pushUnique("NightmareGwylan")>>
		<</if>>
		<<if $nightmaresSeen.includes("office")>>
			<<set $scenePassages.pushUnique("NightmareOffice")>>
		<</if>>
	<</if>>
	<<if $harper_appointments.hypnosis gte 1>>
		<<set $scenePassages.pushUnique("HarperHypnosisIntro")>>
	<</if>>
	<<if $harper_appointments.hypnosis gte 2>>
