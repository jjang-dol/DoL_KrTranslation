	<<elseif beastMaleChance() is 0>>
		<<set _estate_cards_monsters to "cows">>
	<<else>>
		<<set _estate_cards_monsters to "both">>
	<</if>>
<<else>>
	<<set _estate_cards_monsters to "beasts">>
<</if>>

<<if Time.dayState is "day" and Time.hour gte 12>>
	렌은 일행을 커다란 헛간 쪽으로 이끈다. 당신은 그곳을 지나 울타리의 문으로 이어지는 진흙길을 따라 계속 걷는다. 그 너머에는 울타리로 둘러싸인 들판이 있다.
	당신은
	<<switch _estate_cards_monsters>>
	<<case "bulls">>
		강가에서 켄타우로스들이 물을 마시는 동안, 불보이들이 풀을 뜯는 것을 본다.
		<br><br>
	<<case "cows">>
		켄타우로스들이 강에서 물을 마시는 동안, 카우걸들이 풀을 뜯고 있다.
		<br><br>
	<<case "both">>
		켄타우로스들이 강에서 물을 마시는 동안, 불보이와 카우걸들이 풀을 뜯고 있다.
		<br><br>
		<<if random(1, 2) is 2>>
			<<set _estate_cards_centaur to "m">>
		<<else>>
			<<set _estate_cards_centaur to "f">>
		<</if>>
	<<default>>
		강가에서 말들이 물을 마시는 동안, 소들이 풀을 뜯는 것을 본다.
		<br><br>
	<</switch>>

	"너희들은 여기서 기다려." 렌이 말하고는 앞으로 걸어 나간다.
	<<if $estate.cards.wren_top is 0 or $estate.cards.wren_bottoms is 0 or $estate.cards.wren_under_top is 0 or $estate.cards.wren_under_bottoms is 0>>
		<<He>>【은는】 수줍어하는 경비원과 몇 마디 나누고 들판으로 들어간다. <<he>>【은는】 바로 바깥에 있는 바구니에서 사과 하나를 집어 든다.
	<<else>>
		<<He>>【은는】 경비원과 몇 마디 나누고 들판으로 들어간다. <<he>>【은는】 바로 바깥에 있는 바구니에서 사과 하나를 집어 든다.
	<</if>>
	<<switch _estate_cards_monsters>>
	<<case "bulls">>
		<<He>>【은는】 풀을 뜯는 불보이들을 지나 켄타우로스에게 다가간다. 한 켄타우로스가 <<him>>【을를】 맞으러 앞으로 나선다. 그는 경계하는 표정을 짓고 있다.
		<br><br>

		렌은 말을 하기 전에 사과를 한 입 베어 문다. <<his>> 말은 알아들을 수 없지만, 켄타우로스의 대답은 더 잘 들린다. "가축처럼?!" 그가 고함친다. "다시 한번 그따위로 말하면 진흙 속에 쳐박아주마."
		<br><br>

		렌은 돌아서서 <<his>> 어깨 너머로 사과 심지를 던진다. 켄타우로스는 사과 심지가 가슴에 튕겨도 침착함을 유지하지만, 그의 시선은 문으로 향하는 렌을 끝까지 쫓는다.
		<br><br>
	<<case "cows">>
		<<He>>【은는】 풀을 뜯는 카우걸들을 지나 켄타우로스에게 다가간다. 한 켄타우로스가 <<him>>【을를】 맞으러 앞으로 나선다. 그녀는 경계하는 표정을 짓고 있다.
		<br><br>

