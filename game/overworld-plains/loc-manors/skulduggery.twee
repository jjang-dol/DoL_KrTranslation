		<</if>>
	<</if>>
<<elseif $farmland_dungeon.gauntlet_left is "rattle">>
	<<if $farmland_dungeon.gauntlet_right is "calm">>
		그러자 왼쪽에서 손 하나가 나타나,
		<<if !$worn.upper.type.includes("naked")>>
			당신의 <<print $worn.lower.name>>【을를】 잡아당기고 찢는다.<<set $worn.lower.integrity -= 10>><<integritycheck>>
		<<elseif !$worn.under_upper.type.includes("naked")>>
