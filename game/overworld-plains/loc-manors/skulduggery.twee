		<br>
		<<link [[발로 찬다|Farmland Dungeon Gauntlet Continue]]>><<set $phase to 1>><<pain 2>><<set $farmland_dungeon.npc_pain += 1>><</link>><<gpain>> | <span class="blue"> + ? ? ? </span>
		<br>
	<<else>>
		<<link [[기다린다|Farmland Dungeon Gauntlet]]>><<stress 6>><<set $phase += 1>><</link>><<gstress>>
		<br>
	<</if>>
<</if>>

:: Farmland Dungeon Gauntlet Continue
<<effects>>

<<if $phase is 1>>
	<<set $phase to 0>>
	<<if $farmland_dungeon.npc_pain gte 7>>
		당신은 발로 <<persons>> 발목을 걸어, <span class="green">비튼다.</span>
	<<elseif $farmland_dungeon.npc_pain is 6>>
		당신은 발밑으로 <<persons>> 발가락을 <span class="teal">으스러뜨린다.</span>
	<<elseif $farmland_dungeon.npc_pain is 5>>
		당신은 <<persons>> 발을 <span class="lblue">짓밟는다.</span>
	<<elseif $farmland_dungeon.npc_pain is 4>>
		당신은 <<persons>> 정강이에 발을 <span class="blue">세게 내리꽂는다.</span>
	<<elseif $farmland_dungeon.npc_pain is 3>>
		당신은 <<person>>의 정강이에 발을 <span class="purple">찔러 넣는다.</span>
	<<elseif $farmland_dungeon.npc_pain is 2>>
		당신은 자신의 발로 <<persons>> 발을 <span class="pink">가격한다.</span>
	<<else>>
		당신은 <<person>>【을를】 향해 <span class="red">발길질</span>하고, 당신의 발뒤꿈치가 <<his>> 정강이에 부딪힌다.
	<</if>>
	<<He>>【은는】 비명을 지르며 당신을 앞으로 밀어붙이고,
<<else>>
	당신은 앞으로 나아가고,
<</if>>

<<if $farmland_dungeon.gauntlet_left is "calm">>
	<<if $farmland_dungeon.gauntlet_right is "calm">>
