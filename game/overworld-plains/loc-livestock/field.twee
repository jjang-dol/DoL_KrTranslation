		<<getouticon "hole">><<link [[탈출한다|Livestock Dig Escape]]>><</link>>
		<br>
		<<refuseicon>><<link [[기다린다|Livestock Field Night]]>><</link>>
		<br>
	<<elseif $livestock.dig.fence gte 0 and $livestock.dig.fence lte 24 or ($livestock.dig.fence is undefined)>>
		울타리를 살펴보았지만, 부서진 곳은 보이지 않는다. 이미 땅굴을 파기 시작했지만, 반대편에 도달하려면 아직 더 파야 한다.
		<br><br>
		<span class="teal">해가 뜨면</span> 땅 파는 것을 계속하는 게 좋을 것 같다.
		<br><br>
		<<link [[뒤로 물러선다|Livestock Field Night]]>><</link>>
	<</if>>
<<else>>
	<<if pcAreArmsBound("both")>>
		<span class="red">팔이 묶여 있으면 땅을 팔 수 없다.</span>
		<br><br>
		<<link [[다음|Livestock Field]]>><</link>>
		<br>

	<<else>>

		<<if $livestock.dig.fence gte 25 or ($livestock.dig.fence gte 24 and $physiquesize lte 12000) or ($livestock.dig.fence gte 23 and $physiquesize lte 9000) or ($livestock.dig.fence gte 22 and $physiquesize lte 6000)>>
			땅굴 안으로 기어 들어가 땅을 파기 시작한다. 커다란 돌을 빼내자 흙이 머리 위로 무너져 내린다. 흙을 털어내자 위쪽으로 햇빛이 언뜻 보인다.
			<br><br>

			밖으로 머리를 내밀어 본다. 울타리 반대편이다. 탈출할 수는 있겠지만, 여전히 시골 한복판이고 레미도 곧 당신이 없어진 것을 알아챌 것이다. 위험할 수도 있다.

		<<elseif $livestock.dig.fence gte 20>>
			땅굴 안으로 기어 들어가 땅을 파기 시작한다. 땅굴 끝이 울타리 반대편 아래에 있을 것 같아 위쪽으로 굴을 파기 시작한다.
		<<elseif $livestock.dig.fence gte 12>>
			구멍은 이제 땅굴에 가까워졌다. 안으로 들어가 땅을 파고, 파낸 흙은 풀숲 사이에 흩뿌린다. 들키지 않도록 조심한다.
		<<elseif $livestock.dig.fence gte 6>>
			풀밭에 무릎을 꿇고 구멍에 몸을 기댄다. 이제 몸의 절반이 들어갈 만큼 깊어졌다. 울타리 쪽으로 굴을 파며 흙을 더 파낸다.
		<<elseif $livestock.dig.fence gte 1>>
			풀밭에 웅크리고 작업을 시작한다. 그냥 풀을 뜯는 것처럼 보이길 바란다. 구멍을 더 깊고 넓게 판다.
		<<else>>
			농장 인부들이 가끔 경계를 순찰하기 때문에, 울타리에서 약간 떨어진 곳, 키 큰 풀이 당신의 장난을 가려줄 만한 장소를 고른다. 땅을 파기 시작한다. 땅은 단단하다. 맨손으로 파려니 힘들고 더디지만, 조금씩 흙을 파헤친다.
			<br><br>

			한 시간이 지났다. 구멍을 만들었다. 너무 좁고 얕지만, 노력하면 해낼 수 있을 것이다.

		<</if>>
		<br><br>

		<<if $livestock.dig.fence gte 25>>
			<<getouticon "hole">><<link [[탈출한다|Livestock Dig Escape]]>><</link>>
			<br>
			<<refuseicon>><<link [[기다린다|Livestock Field]]>><</link>>
			<br>
		<<elseif $livestock.dig.fence gte 24 and $physiquesize lte 12000 or ($livestock.dig.fence gte 23 and $physiquesize lte 9000) or ($livestock.dig.fence gte 22 and $physiquesize lte 6000)>>
			<<getouticon "hole">><<link [[탈출한다|Livestock Dig Escape]]>><</link>><<small_text>>
			<br>
			<<refuseicon>><<link [[기다린다|Livestock Field]]>><</link>>
			<br>
		<<else>>
			<<pass 60>>
			<<set $livestock.dig.fence += 1>>
			<<if $rng gte 51>>
				<<livestock_overhear>>

				<<link [[다음|Livestock Field]]>><</link>>
				<br>
			<<elseif $rng gte 31>>
				<<generate1>><<person1>>
				"거기 아래서 뭐 하는 거야?" 울타리 너머에서 목소리가 들린다.
				<br><br>

				<<if $cow gte 6>>
					<<link [[음메 운다|Livestock Field Dig Moo]]>><<livestock_obey 1>><<transform cow 1>><</link>><<gobey>>
					<br>
				<<else>>
					<<link [[음메 우는 척한다|Livestock Field Dig Moo]]>><<livestock_obey 1>><<transform cow 1>><</link>><<gobey>>
					<br>
				<</if>>
				<<link [[주의를 돌린다|Livestock Field Dig Distract]]>><</link>><<exhibitionist1>>
				<br>
				<<link [[모욕한다|Livestock Field Dig Insult]]>><<livestock_obey -1>><<stress -6>><</link>><<lobey>><<lstress>>
				<br>
				<<link [[계속 땅을 판다|Livestock Field Dig Keep]]>><<livestock_obey -1>><</link>><<lobey>>
				<br>
			<<else>>

				<<link [[다음|Livestock Field]]>><</link>>
				<br>
			<</if>>
		<</if>>
	<</if>>
<</if>>

:: Livestock Field Dig Moo
<<effects>>

당신은 <<person>>에게 음메 하고 운다. "그냥 멍청한 암소처럼 구는 거군." <<he>>【이가】 웃는다. "계속해."
<br><br>
당신은 다시 땅을 파기 시작한다.
<br><br>

<<link [[다음|Livestock Field]]>><<endevent>><</link>>
<br>

:: Livestock Field Dig Insult
<<effects>>

<<if $speech_attitude is "meek">>
	"마, 말하기 싫어요, 심술쟁이." 당신은 용기를 내어 말한다. "저리 가요."
<<elseif $speech_attitude is "bratty">>
	"네 뇌를 찾고 있어." 당신이 말한다. "잃어버린 것 같아서. 더 멍청한 질문 있어?"
<<else>>
	"너 같은 변태한테는 아무것도 말 안 해." 당신이 말한다. "저리 가."
<</if>>
<br><br>

"말조심해, 멍청한 암캐야." <<person>>【이가】 대답한다. "아니, 멍청한 <<pcow>> 말이야. 내가 기분이 좋은 줄 알아."
<br><br>
당신은 다시 땅을 파기 시작한다.
<br><br>

<<link [[다음|Livestock Field]]>><<endevent>><</link>>
<br>

:: Livestock Field Dig Keep
<<effects>>

당신은 <<person>>【을를】 무시하고 계속 땅을 판다. 긴 풀 때문에 <<he>>【이가】 당신이 뭘 하는지 제대로 볼 수는 없겠지만, 의심하고 있는 게 틀림없다.
<br><br>

<<link [[다음|Livestock Field]]>><<endevent>><</link>>
<br>

:: Livestock Field Dig Distract
<<effects>>

"나?" 당신은 똑바로 서서 <<bottom>>【을를】 흔들며 묻는다. "그냥 소가 하는 일을 하고 있었어. 이 들판에서 벌거벗고 말이야." <<His>> 눈이 당신의 몸을 훑는다. 긴 풀 너머로 당신을 엿보려는 것이다. <<He>>【은는】 원래 질문은 잊어버리고 더 잘 보이는 각도를 잡으려 몸을 움직인다.
<<exhibitionism1>>

당신은 풀 속에 몸을 낮게 숨기고 계속 땅을 판다.
<br><br>

<<link [[다음|Livestock Field]]>><<endevent>><</link>>
<br>

:: Livestock Dig Escape
<<effects>>
<<if Time.dayState is "night">>
	<<set $livestock.escape to "night">>
	당신은 구멍에서 빠져나와 달린다. 작은 언덕을 올라 반대편으로 내려간다. 이제 들판에서는 보이지 않을 것이다.
	<br><br>
	당신이 없어진 걸 알아챌 때까지 얼마나 시간이 있을지 모르기에, 당신은 계속 움직인다.
	<br><br>

	<<link [[다음|Livestock Escape Town]]>><<livestockescape>><<badEndTrackingEnd "Underground Farm" { reason: "uFarmEscapedNightHole" }>><</link>>
	<br>
<<else>>
	<<set $livestock.escape to "hole">>
	당신은 구멍에서 빠져나와 달린다. 작은 언덕을 올라 반대편으로 내려간다. 이제 들판에서는 보이지 않을 것이다.
	<br><br>

	<<pass 1>>1분 후, 등 뒤에서 날카로운 휘파람 소리가 들리고, 이어서 고함 소리와 개 짖는 소리가 들린다. 레미의 목소리가 다른 소리들 위로 울려 퍼진다. <span class="red">당신은 추격당하고 있습니다.</span><<lllobey>><<livestock_obey -20>>
	<br><br>
	<<link [[다음|Livestock Escape]]>><</link>>
	<br>
<</if>>

:: Livestock Tunnel
<<effects>>

당신은 굴 쪽으로 걸어간다. 굴은 아직 그 자리에 있지만, 양쪽 모두 긴 풀에 가려져 가까이 가기 전까지는 보이지 않는다.
<br><br>

<<link [[탈출한다|Livestock Dig Escape]]>><</link>>
<<if $livestock.dig.fence lte 24>>
	<<small_text>>
<</if>>
<br>
<<link [[기다린다|Livestock Field]]>><</link>>
<br>

:: Livestock Field Horse
<<effects>>
<!-- Modified for Monster People -->

<<if maleChance() lte 0>>
	<<set _horse_gender to "f">>
<<elseif maleChance() gte 100>>
	<<set _horse_gender to "m">>
<<else>>
	<<set _horse_gender to "b">>
<</if>>

레미의 말들에게 다가간다.

<<if ($settings.monsterChance gte 1 and $hallucinations gte 1) or ($settings.monsterChance gte 1 and !$settings.monsterHallucinationsOnly)>>
	멀리서는 말처럼 보이지만, 가까이 다가가자 머리와 몸통이
	<<if _horse_gender is "f">>
		여성이다.
	<<elseif _horse_gender is "m">>
		남성이다.
	<<else>>
		남성과 여성이다.
	<</if>>
	길고 잘 관리된 갈기가 등과 가슴을 따라 늘어져 있다.
	<<if _horse_gender is "f">>
		그들은 맨가슴에 대해 개의치 않는 것 같다.
	<<elseif _horse_gender is "b">>
		여성들은 맨가슴에 대해 개의치 않는 것 같다.
	<</if>>
	<br><br>
	몇몇은 몸을 굽혀 강물을 마신다. 다른 이들은 자신의 모습을 비춰보며 손가락으로 머리카락을 쓸어 넘긴다.
<<else>>
	그들의 털은 옅은 색부터 짙은 갈색까지 다양하며, 모두 잘 손질되어 있다.
	<br><br>
	대부분은 강물을 마시거나 풀을 뜯기 위해 몸을 굽히고 있다.
<</if>>
<br><br>

<<if $livestock.horse.reputation gte 2>>
	<<if ($settings.monsterChance gte 1 and $hallucinations gte 1) or ($settings.monsterChance gte 1 and !$settings.monsterHallucinationsOnly)>>
		<span class="green">당신이 다가가자 몇몇이 고개를 끄덕이며 인사한다.</span>
	<<else>>
		<span class="green">당신이 다가가자 그들이 더 가까이 다가온다.</span>
	<</if>>
<<elseif $livestock.horse.reputation gte 1>>
	<<if ($settings.monsterChance gte 1 and $hallucinations gte 1) or ($settings.monsterChance gte 1 and !$settings.monsterHallucinationsOnly)>>
		당신이 다가가는 것을 지켜본다. 몇몇은 재미있어하는 것 같다.
	<<else>>
		당신이 다가가는 것을 지켜본다. 그들은 차분해 보인다.
	<</if>>
<<else>>
	<<beastNEWinit 1 horse>>
	<<if $monster is 1>>
		그들 중 유난히 덩치가 크고 검은 머리를 한 개체가 당신이 다가가자 마주 본다. "저리 가라, 가축." <<bhe>>【은는】 고개를 더 높이 쳐들며 말한다. "여긴 우리 구역이다." 다른 이들도 당신을 지켜본다.
	<<else>>
		그들 중 유난히 덩치가 크고 검은 털을 가진 개체가 당신이 다가가자 깊은 울음소리를 낸다. 경고처럼 들린다. 다른 이들이 고개를 든다. 그들이 당신을 지켜보고 있다.
	<</if>>
<</if>>
<br><br>

<<if $livestock.horse.reputation lt 1 or $livestock.horse.reputation is undefined>>
	<<link [[친근하게 군다|Livestock Field Horse Intro]]>><<set $livestock.horse.reputation to 1>><<set $phase to 1>><</link>>
	<br>
	<<link [[단호하게 군다|Livestock Field Horse Intro]]>><<set $livestock.horse.reputation to 1>><<set $phase to 2>><</link>>
	<br>
	<<link [[자리를 뜬다|Livestock Field]]>><<endevent>><</link>>
	<br>
<<elseif Time.betweenHours(19, 20)>>
	레미가 당신을 찾는 것 같다. <span class="red">나가야 한다.</span>
	<br><br>
	<<getouticon>><<link [[떠난다|Livestock Field]]>><<endevent>><</link>>
	<br>
<<else>>
	<<rng>> /* I'm not sure this is necessary, but I think there's a way to loop through these scenes without alterting RNG, so lets stop that */
	<<if $daily.livestock and $daily.livestock.horses_satisfied is undefined>><<set $daily.livestock.horses_satisfied to 0>><</if>>
	<<clearnpc>><<beastNEWinit 1 horse>>

	<!-- Modified for Monster People -->
	<<if random(1,2) is 1 and $awareness gte 200 and $daily.livestock.horses_satisfied lt 6 and $settings.horsesEnabled and ($settings.bestialityEnabled or $monster is 1)>>
		뒤쪽에 있는 <<beasttype>> 한 마리가 안절부절못하는 것 같다. <<bHe>>【은는】 다른 이들을 향해 발을 구르며,
		<<if $monster is 1>>
			무례하고 까다롭게 굴고 있다.
		<<else>>
			좌절하며 울고 있다.
		<</if>>
		<<set _agitated to 1>>
		<br><br>
	<</if>>

	<<if pcAreArmsBound("both")>>
		<span class="red">팔이 묶여 있는 동안에는 그들의 머리를 빗어줄 수 없습니다.</span>
	<<else>>
		<<petshopicon "brush">><<link [[머리를 빗겨준다 (1:00)|Livestock Field Horse Brush]]>><<pass 60>><<tending 6>><<stress -6>><</link>><<gtending>><<lstress>>
	<</if>>
	<br>

	<<if _agitated is 1>>
		<<animalicon "horse">><<link [[안절부절못하는 <<beasttype>>의 아래를 살펴본다 (0:01)|Livestock Field Deviancy]]>><<set $phase to 1>><<pass 1>><<set $daily.livestock.horses_satisfied += 1>><</link>><<deviant1>>
		<br>
	<</if>>

	<<if $livestock.food>>
		<<foodstufficon "apple">><<link [[사과 바구니를 건넨다|Livestock Field Horse Apples]]>><<trauma -18>><<unset $livestock.food>><<endevent>><</link>><<lltrauma>>
		<br>
	<</if>>

	<<getouticon>><<link [[떠난다|Livestock Field]]>><<endevent>><</link>>
	<br>
<</if>>

:: Livestock Field Horse Intro
<<effects>>

<<if $monster is 1>>
	<<if $phase is 1>>
		<<if $speech_attitude is "meek">>
			"화, 화내지 마세요." 당신은 말한다. "그냥 친구가 되고 싶어요."
		<<elseif $speech_attitude is "bratty">>
			"내가 보기엔," 당신이 말한다. "우리는 이 들판을 함께 쓰고 있으니, 서로 익숙해져야 해요."
		<<else>>
			"해칠 생각은 없어요." 당신은 말한다. "그냥 궁금해서요."
		<</if>>
		켄타우로스가 웃는다.

	<<elseif $phase is 2>>
		<<if $speech_attitude is "meek">>
			"무례하게 굴지 마세요." 당신은 스스로도 놀랄 만큼 자신감 있는 목소리로 말한다. "당신들은 이 들판에서 마음대로 다닐 자유가 있어요. 저도 똑같이 그러고 싶을 뿐이에요."
		<<elseif $speech_attitude is "bratty">>
			"넌 날 겁줄 수 없어." 당신은 비웃는다. "난 내가 가고 싶은 곳에 갈 거야."
		<<else>>
			"난 여기 있고 싶은데." 당신은 말한다. "그게 문제라도 돼?"
		<</if>>
		팔짱을 낀 채, 켄타우로스는 당신을 똑바로 쳐다본다.
	<</if>>
	<br><br>
	"다른 놈들보단 용감하군. 좋아, 하지만 조심해라."
<<else>>

	<<if $phase is 1>>
		당신은 느리고 일정한 속도를 유지하며 계속 다가간다. 팔을 뻗어 커다란 말의 머리를 쓰다듬는다.
	<<elseif $phase is 2>>
		당신은 일정한 속도를 유지하되, 속도를 늦추지 않는다. 커다란 말에게 똑바로 걸어가 머리에 손을 얹는다.
	<</if>>
	<br><br>
	말은 거친 소리를 내지만, 다시 먹기 시작한다. 다른 말들도 그 뒤를 따른다.
<</if>>

<br><br>

<<link [[다음|Livestock Field Horse]]>><<endevent>><</link>>
<br>

:: Livestock Field Horse Brush
<<effects>>

<<if maleChance() lte 0>>
	<<set _horse_gender to "f">>
<<elseif maleChance() gte 100>>
	<<set _horse_gender to "m">>
<<else>>
	<<set _horse_gender to "b">>
<</if>>

<<if ($settings.monsterChance gte 1 and $hallucinations gte 1) or ($settings.monsterChance gte 1 and !$settings.monsterHallucinationsOnly)>>
	<<if $livestock.horse.reputation gte 2>>
		당신은 손가락으로 켄타우로스들의 머리카락을 빗어준다. 켄타우로스들은 자기 차례를 받으려고 서로 밀친다. 등에는 털이 거의 없는데도 등을 긁어달라고 조르기도 한다.
	<<else>>
		당신은 손가락으로 켄타우로스들의 머리카락을 빗어준다. 켄타우로스들은 경계하면서도 당신을 거부하지는 않는다. 겉으로 드러내는 것보다 더 즐기고 있다는 느낌이 든다.
	<</if>>
<<else>>
	<<if $livestock.horse.reputation gte 2>>
		당신은 손가락으로 말들의 털을 빗어준다. 말들은 자기 차례를 받으려고 서로 밀친다. 이따금 당신에게 부드럽게 코를 비벼오기도 한다.
	<<else>>
		당신은 손가락으로 말들의 털을 빗어준다. 말들은 경계하면서도 당신을 거부하지는 않는다. 겉으로 드러내는 것보다 더 즐기고 있다는 느낌이 든다.
	<</if>>
<</if>>
<br><br>

<<if dangerEvent(0.5)>> /* Reduced allure effect since PC is always nude */
