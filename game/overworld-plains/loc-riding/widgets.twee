:: Widgets Riding [widget]
<<widget "steed_text">>
	<<if $steed is "male">>
		<<set _text_output to "켄타우로스">>
	<<elseif $steed is "female">>
		<<set _text_output to "켄타우로스">>
	<<elseif $steed is "mare">>
		<<set _text_output to "암말">>
	<<elseif $steed is "stallion">>
		<<set _text_output to "수말">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "steed_he">>
	<<if $steed is "male">>
		<<set _text_output to "그">>
	<<elseif $steed is "female">>
		<<set _text_output to "그녀">>
	<<elseif $steed is "mare">>
		<<set _text_output to "그것">>
	<<elseif $steed is "stallion">>
		<<set _text_output to "그것">>
	<</if>>
	<<print _text_output>>
<</widget>>

