	<br><br>

	<<clotheson>>
	<<endcombat>>
	<<npc "Great Hawk">><<person1>>
	<<= $syndromebird is 1 ? "당신의" : "한">> <<if $monster isnot 1>>거대한<</if>> <<beasttype>>【이가】 하늘에서 빠르게 내려온다.
	<br><br>

	<<set $phase to 0>>
