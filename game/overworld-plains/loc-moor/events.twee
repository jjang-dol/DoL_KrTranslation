<<elseif $timer is 8 and random(1, 2) is 2>>
	<<struggle_add 1 2>>/*Adds more creatures, with a specific health.*/
	<span class="pink">세 번째 생물이 헤더 덤불에서 뛰어오른다!</span>
	<br><br>
<</if>>

<<struggle>>

