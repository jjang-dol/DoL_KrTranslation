			<br>
			<<link [[내버려 둔다|Farm Road Leave]]>><</link>>
			<br>
		<<else>>
			<br><br>

			<<destinationfarmroad>>
		<</if>>
	<<else>>
		<<hitchhike>>
	<</if>>
<<else>>
	<<if $arousal gte $arousalmax>>
		<<orgasmLocation "countryside">>
	<</if>>
	<<if $exposed lte 1>>
		<<skinicon "hitchhike">><<link [[히치하이킹한다 (0:15)|Farm Hitchhike]]>><<pass 15>><</link>>
		<br>
	<<else>>
		<span class="blue">너무 노출이 심해 히치하이킹을 할 수 없습니다!</span>
		<br>
	<</if>>
	<<roadicon>><<link [[시골로 더 들어간다 (0:30)|Farm Road 5]]>><<set $phase to 1>><<tiredness 3>><</link>><<gtiredness>>
