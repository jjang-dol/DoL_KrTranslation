:: Farm Cottage
<<set $location to "alex_cottage">><<set $outside to 0>><<effects>>
<<farm_work_update>>
<<if $slimeFarmNakedStored is true>>
	당신은 옷을 입는다.
	<<storeon "farmHidingSpot">>
	<<exposure>>
	<<unset $slimeFarmNakedStored>>
<</if>>
<<if $farm_stage gte 7>><<unset $farm_naked>><</if>>

<<if $alexSomnoAngry is 0>>
	당신이 아래층으로 내려오자 알렉스가 당신을 노려본다.
	<br><br>
	<<set $alexSomnoAngry to 1>>
<</if>>

당신은 알렉스의 오두막 아래층에 있다. 비좁지만 아늑한 곳이다. 현대식 가전제품과 작은 식탁이 놓인 주방, 소파와 안락의자가 있는 거실이 보인다.
<br><br>

<!-- Flavour text of Alex coming down, going up, or being upstairs -->
<<if Time.hour is 21 and $alex_to_bed is undefined and $farm_end isnot 1>>
	<<npc Alex>><<person1>>
	<<if $farm_end isnot 1>>
		<<set $farm_end to 1>>
		/* If it's 21:00 and you go to the cottage, the farm work needs to be stopped. */
		알렉스가 오두막으로 들어온다. "오늘 일도 끝났네," <<he>>【이가】
		<<if $exposed gt 0>>
			얼굴을 붉히며 말한다. "점점 추워질 테니까, 옷 좀 더 챙겨 입는 게 좋을 거야." <<glust>><<npcincr Alex lust 1>>
		<<else>>
			미소를 지으며 말한다.
		<</if>>
		<<if $farm_count gte 1 and $farm_stage lte 6>>
			"여기, 수고비 조금 더 얹어줄게." <<he>>【이가】 당신에게 <<moneyGain $farm.wage>>【을를】 건넨다.
		<</if>>
		<br><br>
	<</if>>
	<<set $alex_to_bed to 1>>
	알렉스가 방으로 올라가자 계단이 삐걱거린다.
	<<endevent>>
	<br><br>
<<elseif Time.hour gte 21 or Time.hour lte 4>>
	위층에서 알렉스가 코를 고는 소리가 들린다.
	<br><br>
<<elseif Time.hour is 5 and ($alex_bed is "player" or $alex_bed is undefined) and $alexSomnoAngry is undefined>>
	<<set $alex_bed to "none">><<npc Alex>><<person1>>
	알렉스가 계단을 삐걱거리며 내려온다. <<covered>> "아침 준비해야겠네," <<he>>【이가】 주방으로 걸어가며 말한다.
	<<if $exposed gte 1>>
		<<he>>【은는】 곁을 지나치며 힐끔거리지 않는 척 애를 쓴다.<<glust>><<npcincr Alex lust 1>>
	<</if>>
	<<endevent>>
	<br><br>
<<elseif $farm_work.alex is "admin" or ($farm_work.alex is "clearing" and $farm_stage is 12)>>
	위층에서 알렉스가 통화하는 소리가 들린다.
	<br><br>
<</if>>

<!-- Main options of available actions -->

<<if $farm.build_finished.includes("nursery")>>
	<<run $farm.build_finished.delete("nursery")>>
	<<set C.npc.Alex.pregnancy.nursery to true>>
	<<unset $cottage_nursery_prep>>

	새로운 육아실이 증축되었습니다. <span class="gold">이제 당신과 알렉스의 아이들이 농장에서 생활할 수 있습니다.</span>
	<br><br>
	<<link [[다음|Farm Cottage]]>><</link>>

<<elseif isPregnancyEnding()>>
	<<pcFarmBirth>>

<<elseif npcPregnancyEnding("Alex")>>
	<<npc "Alex">>
	"씨, 씨발..." 알렉스가 소리치는 것이 들린다. 당신은 <<him>>에게 달려간다.
	<br>

	"무슨 일이야?" 당신이 묻는다. 다가가 보니, <<his>> 허벅지를 타고 액체가 흘러내리고 있다.
	<br>

	"나올 것 같아," <<he>>【이가】 말한다.
	<br><br>

	심장이 평소보다 훨씬 거세게 방망이질 친다. "병원으로 데려가 줄까?" 당신이 묻는다.<<gstress>><<stress 6>>
	<br><br>

	"아냐, 됐어. 난 그런 곳 별로 안 좋아해. 마을 의사 좀 불러줄래?" <<he>>【이가】 말한다. <<he>>【은는】 주머니에서 휴대전화를 꺼내 당신에게 건넨다.
	<br><br>

	<<link [[다음|Farm Alex Birth]]>><</link>>

<<elseif playerIsPregnant() and playerBellyVisible() and !talkedAboutPregnancy("pc","Alex")>>
	<<npc "Alex">>
	<<setTalkedAboutPregnancy "pc" "Alex">>
	<<if $farm_stage gte 7>>
		알렉스가 경악한 눈으로 당신의 배를 응시하는 것이 보인다. "너... 너 임신한 거야?! 나한테 아무 말도 안 했잖아..."

		<<set _preg to getPlayerPregnancy()>>
		<<if _preg and (_preg.possibleDonors.length gte 2 or !couldBeDonor(_preg, "Alex"))>>
			<<he>>의 목소리에 실망감이 묻어난다.
			<br><br>

			"뭐... 몸 상태가 안 좋으면 언제든지 농장 일은 쉬어도 돼," <<he>>【이가】 말한다.
			<br><br>

			<<link [[다음|Farm Work]]>><<endevent>><</link>>

		<<else>>
			<br><br>
			<<he>>【은는】 대답을 기다리듯 당신을 바라본다.

			"그보다, 일단 좀 앉아볼래?" 알렉스가 말한다.
			<br><br>

			<<link [[다음|Farm PC Pregnancy Reveal]]>><<set $phase to 3>><</link>>

		<</if>>

	<<else>>
		알렉스가 당신의 배를 쳐다보는 것이 보인다. "어라, 임신한 거야? 버겁다 싶으면 농장 일은 쉬어도 돼. 난 괜찮으니까," <<he>>【이가】 말한다.
		<br><br>

		<<link [[다음|Farm Work]]>><<endevent>><</link>>

	<</if>>

<<elseif npcIsPregnant("Alex") and !talkedAboutPregnancy("Alex","pc") and npcBellySize("Alex") gte 1>>
	<<alex_cottage_pregnancy_reveal>>

<<elseif ($farm_countdown lte 0 or $farm_countdown is undefined) and ($renttime lte -2 or ($renttime lte 0 and Time.hour gte 4 and Time.hour lte 21))>>
	<<unset $farm_countdown>><<unset $baileyReunionScene>>
	<span class="red">문 두드리는 소리가 들린다.</span>
	<br><br>

	<<if Time.hour gte 21 or Time.hour lte 4>>
		위층에서 알렉스가 뒤척인다.
		<br><br>

		<<link [[문을 열어준다|Farm Cottage Bailey]]>><<set $phase to 0>><</link>>
		<br>
		<<link [[알렉스가 열게 둔다|Farm Cottage Bailey]]>><<set $phase to 1>><</link>>
		<br>

	<<elseif Time.hour is 5>>
		알렉스가 걱정스러운 표정으로 당신을 바라본다.
		<br><br>

		<<link [[문을 열어준다|Farm Cottage Bailey]]>><<set $phase to 0>><</link>>
		<br>
		<<link [[알렉스가 열게 둔다|Farm Cottage Bailey]]>><<set $phase to 1>><</link>>
		<br>
	<<else>>
		<<link [[문을 열어준다|Farm Cottage Bailey]]>><<set $phase to 2>><</link>>
		<br>
		<<link [[알렉스가 열게 둔다|Farm Cottage Bailey]]>><<set $phase to 3>><</link>>
		<br>
	<</if>>
<<elseif $stress gte $stressmax>>
	<<passoutfarmroad>>
<<elseif $farm_attack_timer is 0 and Time.hour gte 21>>
	<<npc Alex>><<person1>>
	알렉스가 우당탕거리며 계단을 뛰어내려온다. <span class="red">"<<nnpc_Hes Remy>> 놈들이 왔어,"</span> <<he>>【이가】 말한다. "레미 녀석이야. 우린 할 수 있어. 가서 준비해, 난
	<<if $farm.tower_guard>>
		$farm.tower_guard 상태를 확인해 볼게."
	<<else>>
		"찾아낼 수 있는지 볼게."
	<</if>>
	<br><br>

	<<farm_assault_intro>>
	<br><br>

	<<link [[준비한다|Farm Assault Wardrobe]]>><<endevent>><<set $phase to 3>><</link>>
	<br>
<<elseif Time.hour is 5 and $alex_breakfast is undefined>>
	<<if $alexSomnoAngry lte 1>>
		<<foodicon "pancakes">><<link [[아침 식사 준비를 돕는다|Farm Breakfast Reject]]>><<set $alex_breakfast to 1>><<set $phase to 0>><</link>>
		<br>
		<<foodicon "eat">><<link [[아침 식사를 한다|Farm Breakfast Reject]]>><<set $alex_breakfast to 1>><<set $phase to 1>><</link>>
	<<else>>
		<<foodicon "pancakes">><<link [[아침 식사 준비를 돕는다 (0:20)|Farm Breakfast Make]]>><<set $alex_breakfast to 1>><<pass 20>><<npcincr Alex love 1>><<stress -6>><<tiredness -6>><</link>><<glove>><<lstress>><<ltiredness>>
		<br>
		<<foodicon "eat">><<link [[아침 식사를 한다 (0:20)|Farm Breakfast Eat]]>><<set $alex_breakfast to 1>><<pass 20>><<stress -12>><<tiredness -6>><</link>><<llstress>><<ltiredness>>
	<</if>>
	<br>
	<<farm_cottage_options>>
<<elseif Time.hour is 5 and $alexSomnoAngry is undefined>>
	알렉스가 거실에 앉아 TV를 보고 있다.
	<br><br>

	<<npc Alex>><<person1>>
	<<if $alex_tea is undefined>>
		<<set $alex_tea to 1>>
		<<if Time.days % 2 is 0>>
			<<if C.npc.Alex.dom gte 1>>
				"차 한잔하고 싶은데," <<he>>【이가】 말한다. "물 좀 올려줄래?"
				<br><br>

				<<link [[차 한 잔을 끓인다 (0:05)|Farm Breakfast Tea]]>><<npcincr Alex love 1>><<pass 5>><</link>><<glove>>
				<br>
				<<link [[차 두 잔을 끓인다 (0:05)|Farm Breakfast Tea 2]]>><<npcincr Alex love 1>><<pass 5>><<stress -6>><</link>><<glove>><<lstress>>
				<br>
				<<link [[거절한다|Farm Breakfast Tea Refuse]]>><<npcincr Alex dom -1>><<npcincr Alex love -1>><</link>><<llove>><<ldom>>
				<br>
			<<else>>
				"차 한잔하고 싶은데," <<he>>【이가】 자리에서 일어나며 말한다. "너도 한잔할래?"
				<br><br>

				<<link [[수락한다 (0:05)|Farm Breakfast Tea Receive]]>><<pass 5>><<stress -6>><</link>><<lstress>>
				<br>
				<<link [[거절한다|Farm Cottage]]>><<endevent>><</link>>
				<br>
			<</if>>
		<<else>>
			<<farm_cottage_tv_options>>
			<<farm_cottage_options>>
		<</if>>
	<<else>>
		<<farm_cottage_tv_options>>
		<<farm_cottage_options>>
	<</if>>
<<else>>
	<<farm_cottage_options>>
<</if>>



:: Farm Bedroom
<<set $outside to 0>><<effects>><<getTarget true>>
<<farm_work_update>>
당신은 알렉스의 오두막에 있는 당신의 방에 있다. 비좁지만 고아원의 방보다는 넓다. 침대 맞은편에는 옷장이 서 있다. 농장이 내려다보이는 창가에는 책상이 있다.
<br><br>

<<if $unbind is 1>>
	<<unset $unbind>>
	당신은 결박을 푼다.
	<br><br>
<</if>>

<<if $alex_bed is "player">>
	알렉스가 당신의 침대에서 코를 골고 있다.
	<<if Time.hour is 5>>
		<<set $alex_bed to "none">><<npc Alex>><<person1>>
		<<He>>【이가】 하품을 하고는 이불을 걷어낸다. <<covered>> "아침 먹을 시간이야." <<he>>【이가】 말한다.
		<<if $daily.alex.bedOrgasm>>
			<<if $exposed gte 2>>
				알렉스는 물수건으로 <<his>> 옷을 서둘러 닦고는, 시선을 피하며 당신에게 새 수건을 건넨다.
				<br><br>
				<<switch random(1, 3)>>
					<<case 1>>
						"ㅇ, 이 변태. 이거 방금 빨았는데." <<he>>【이가】 얼굴을 붉히며 말한다.
					<<case 2>>
						"ㄴ, 누가 먼저 시작했네. 변태." <<He>>【은는】 얼굴을 붉히고 있다.
					<<case 3>>
						"ㅈ, 자연 알람 고맙다." <<He>>【이가】 얼굴을 붉힌다. "수탉보다 훨씬 낫네."
				<</switch>>
			<<else>>
				알렉스는 물수건을 가져와 당신의 축축한 부분을 가리키고는 시선을 돌린다.
				<br><br>
				<<switch random(1, 3)>>
					<<case 1>>
						<<He>>【이가】 기지개를 켠다. "빨래는 금방 할게. 근데 일단 배고파 죽겠다."
					<<case 2>>
						"대단한 꿈을 꿨나 보네, 파트너." <<He>>【이가】 씨익 웃으며 <<his>> 팔꿈치로 당신을 쿡 찌른다. "나도 나왔어?"
					<<case 3>>
						"자연 알람 고맙다." <<he>>【이가】 킥킥 웃는다. "수탉보다 훨씬 낫네."
				<</switch>>
			<</if>>
		<</if>>
		<<if $exposed gte 1>>
			<<He>>【이가】 방을 나가면서 당신을 훔쳐보지 않는 척한다.<<glust>><<npcincr Alex lust 1>>
		<<else>>
			<<He>>【이가】 방을 나가자, 계단이 삐걱거리는 소리가 들린다.
		<</if>>
		<<endevent>>
	<</if>>
	<br><br>
<</if>>

<<if $stress gte $stressmax and !$possessed>>
	<<passoutfarmroad>>
<<elseif $farm_attack_timer is 0 and Time.hour gte 21 and !$possessed>>
	<<npc Alex>><<person1>>
	알렉스가 계단을 쿵쾅거리며 내려온다. <span class="red">"<<nnpc_Hes Remy>> 왔어."</span> <<he>>【이가】 말한다. "레미야. 우리 할 수 있어. 가서 준비해, 난
	<<if $farm.tower_guard>>
		$farm.tower_guard【을를】 확인해볼게."
	<<else>>
		"놈들을 발견할 수 있는지 볼게."
	<</if>>
	<br><br>

	<<farm_assault_intro>>
	<br><br>

	<<link [[준비한다|Farm Assault Wardrobe]]>><<endevent>><<set $phase to 3>><</link>>
	<br>
<<else>>
	<<if $possessed and (pcAreArmsBound("any") or $feetuse is "bound" or $worn.feet.type.includes("shackle"))>>
		당신은 결박을 내려다본다.
		<<if breakableSoftBinding()>>
			당신이 잡아당기자, 결박이 당신의 힘을 버티지 못하고 부서져 버린다.
			<<if ["ankle cuffs", "ball and chain"].includes($worn.feet.name)>>
				딸깍하는 소리가 들리더니, 당신의 $worn.feet.name【이가】 땅으로 떨어진다.
			<</if>>
		<<else>>
			딸깍하는 소리가 들리고, 당신의 $worn.feet.name【이가】 바닥으로 떨어진다.
		<</if>>
		<br><br>
		<<unbind>>
	<<elseif breakableSoftBinding()>>
		<<undobindingsicon>><<link [[결박 풀기 (0:10)|Farm Bedroom]]>><<set $unbind to 1>><<pass 10>><<unbind>><</link>>
		<br><br>
	<</if>>
	<<if !($earSlime.event and $earSlime.noSleep)>>
		<<set _farmbed to isLoveInterest("Alex") ? "alex" : "farm">>
		<<bedicon _farmbed>><<link [[옷을 벗고 침대로 들어간다|Farm Bed]]>><<undressSleep "Farm Bed">><</link>>
		<br>
		<<listsleepoutfits "Farm Bed">>
		<<roomoptions>>
		<<safehouseEvents>>

		<<wardrobeicon>><<link [[옷장|Farm Wardrobe]]>><</link>>
		<br>
	<<else>>
		<br>
		<<if $possessed>>
			<span class="red">머릿속의 슬라임이 조용하다.</span>
		<<else>>
			<<ind>><span class="red">슬라임은 당신이 잠자리에 들기 전에 <<print $earSlime.event>>하기를 원한다.</span>
		<</if>>
		<br>
	<</if>>
	<<if playerHasSexToys()>>
		<<sextoysicon>><<link [[섹스 토이|Sextoys Inventory]]>><<set $sextoyInvReturnLink to $passage>><</link>>
		<br>
	<</if>>
	<<if $nextPassageCheck is "Farm Mirror">>
		<span class="nextLink"><<mirroricon>><<link [[거울|Farm Mirror]]>><<preMirror>><</link>></span>
	<<else>>
		<<mirroricon>><<link [[거울|Farm Mirror]]>><<preMirror>><</link>>
	<</if>>
	<br>
	<br>
	<<farmicon "alexbed">><<link [[알렉스의 방 (0:01)|Farm Alex Bedroom]]>><<pass 1>><</link>>
	<br>
	<<main_hall_icon>><<link [[아래층으로 내려가기 (0:01)|Farm Cottage]]>><<pass 1>><</link>>
	<br>
	<br>
	<<link [[게임플레이 설정|Farm Settings]]>><</link>>
	<br>
	<<attitudesControlCheck>>
	<<if $attitudesControl.showGoldLink is true>>
		<span class="goldLink"><<link [[태도|Attitudes]]>><<set $attitudesExitPassage to $passage>><</link>> </span><span class="red">!!</span>
	<<else>>
		<<link [[태도|Attitudes]]>><<set $attitudesExitPassage to $passage>><</link>>
	<</if>>
	<br>
<</if>>

:: Farm Mirror
<<effects>>
<<set _farmbed to isLoveInterest("Alex") ? "alex" : "farm">>
<<bedicon _farmbed>><<link [[물러난다|Farm Bedroom]]>><<unset $mirrorMenu>><<postMirror>><</link>>
<br>

<<mirror>>
<br><br>

:: Farm Bed
<<effects>>
<<wearoutfit>>

<<set $bus to "farm_bedroom">><<effects>>
이불 속으로 파고든다.
<<if $alex_bed is "player">>
	알렉스가 옆에서 코를 곤다.
<</if>>
<<if $wraith.state and $wraithPrison and ($moonstate is "evening" or $moonstate is _nightstate)>>
	불안감을 느끼자, 당신의 시선이 거울로 향한다.
<</if>>
<br><br>

<<if numberOfEarSlime() and $alex_bed isnot "player" and random(0,100) lt 3 + Math.floor($earSlime.growth / 100) - $earSlime.eventTimer and !$earSlime.event>>
	<<set $slimeBedExit to "Farm Bed">>
	<<set $slimeBedroomExit to "Farm Bedroom">>
	<<setSlimeSleepEvents>>
	<<if $earSlimeEvent>>
		<<slimeSleepEvents>>
	<</if>>
<</if>>
<<farm_sleep_options>>

:: Farm Sleep
<<set _autosavehere to true>>
<<sleep>>
<<effects>>
<<if $bus is "farm_alex_room">>
	<<if $exposed gte 2>>
		<<npcincr Alex lust 3>>
	<<else>>
		<<npcincr Alex lust 1>>
	<</if>>
<</if>>
<<if $bus is "farm_alex_room" or $alex_bed is "player">>
	<<set $bedGuest to "Alex">>
<</if>>
<<if $wraith.nightmare is 2 and Time.isBloodMoon()>>
	<<sleepeffects>>
