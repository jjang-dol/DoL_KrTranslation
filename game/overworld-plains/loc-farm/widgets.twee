<<widget "barn_img">>
	<<machine_init>>

	<<if _args[2] and _args[2] isnot "no_pump">>
		<<set $_prop to _args[2]>>
	<<else>>
		<<set $_prop to "haybale">>
	<</if>>

	<<if _args[0] is "penis">>
		<<if _args[1] is "livestock">>
			<<set _barn_semen to $livestock.semen>>
		<<elseif _args[1] is "half_livestock">>
			<<set _barn_semen to ($livestock.semen / 2)>>
		<<elseif _args[1] is "no_livestock">>
			<<set _barn_semen to 0>>
		<<else>>
			<<set _barn_semen to $semen_amount>>
		<</if>>
		<<if _barn_semen gte 3000>>
			<<set _semen_img to "semen_7">>
		<<elseif _barn_semen gte 2000>>
			<<set _semen_img to "semen_6">>
		<<elseif _barn_semen gte 1500>>
			<<set _semen_img to "semen_5">>
		<<elseif _barn_semen gte 1000>>
			<<set _semen_img to "semen_4">>
		<<elseif _barn_semen gte 500>>
			<<set _semen_img to "semen_3">>
		<<elseif _barn_semen gte 200>>
			<<set _semen_img to "semen_2">>
		<<else>>
			<<set _semen_img to "semen_1">>
		<</if>>
		<<if _args[2] is "no_pump">>
			<<prop $_prop semen>>
		<<else>>
			<<prop $_prop semen penis_pump>>
		<</if>>
	<<elseif _args[0] is "breasts">>
		<<if _args[1] is "livestock">>
			<<set _barn_milk to $livestock.milk>>
		<<elseif _args[1] is "half_livestock">>
			<<set _barn_milk to ($livestock.milk / 2)>>
		<<elseif _args[1] is "no_livestock">>
			<<set _barn_milk to 0>>
		<<else>>
			<<set _barn_milk to $milk_amount>>
		<</if>>
		<<if _barn_milk gte 3000>>
			<<set _milk_img to "milk_7">>
		<<elseif _barn_milk gte 2000>>
			<<set _milk_img to "milk_6">>
		<<elseif _barn_milk gte 1500>>
			<<set _milk_img to "milk_5">>
		<<elseif _barn_milk gte 1000>>
			<<set _milk_img to "milk_4">>
		<<elseif _barn_milk gte 500>>
			<<set _milk_img to "milk_3">>
		<<elseif _barn_milk gte 200>>
			<<set _milk_img to "milk_2">>
		<<else>>
			<<set _milk_img to "milk_1">>
		<</if>>
		<<if _args[2] is "no_pump">>
			<<prop $_prop milk>>
		<<else>>
			<<prop $_prop milk breast_pump>>
		<</if>>
	<<else>>
		<<if _args[1] is "livestock">>
			<<set _barn_semen to $livestock.semen>>
			<<set _barn_milk to $livestock.milk>>
		<<elseif _args[1] is "half_livestock">>
			<<set _barn_semen to ($livestock.semen / 2)>>
			<<set _barn_milk to ($livestock.milk / 2)>>
		<<elseif _args[1] is "no_livestock">>
			<<set _barn_semen to 0>>
			<<set _barn_milk to 0>>
		<<else>>
			<<set _barn_semen to $semen_amount>>
			<<set _barn_milk to $milk_amount>>
		<</if>>
		<<if _barn_semen gte 3000>>
			<<set _semen_img to "semen_7">>
		<<elseif _barn_semen gte 2000>>
			<<set _semen_img to "semen_6">>
		<<elseif _barn_semen gte 1500>>
			<<set _semen_img to "semen_5">>
		<<elseif _barn_semen gte 1000>>
			<<set _semen_img to "semen_4">>
		<<elseif _barn_semen gte 500>>
			<<set _semen_img to "semen_3">>
		<<elseif _barn_semen gte 200>>
			<<set _semen_img to "semen_2">>
		<<else>>
			<<set _semen_img to "semen_1">>
		<</if>>
		<<if _barn_milk gte 3000>>
			<<set _milk_img to "milk_7">>
		<<elseif _barn_milk gte 2000>>
			<<set _milk_img to "milk_6">>
		<<elseif _barn_milk gte 1500>>
			<<set _milk_img to "milk_5">>
		<<elseif _barn_milk gte 1000>>
			<<set _milk_img to "milk_4">>
		<<elseif _barn_milk gte 500>>
			<<set _milk_img to "milk_3">>
		<<elseif _barn_milk gte 200>>
			<<set _milk_img to "milk_2">>
		<<else>>
			<<set _milk_img to "milk_1">>
		<</if>>
		<<if _args[2] is "no_pump">>
			<<prop $_prop semen milk>>
		<<else>>
		<<prop $_prop semen penis_pump milk breast_pump>>
		<</if>>
	<</if>>
	<<set _crHideCloseImages to true>>
	<<animateCombat>>
<</widget>>

<<widget "farmCatchChance">>
	<<if _args[0] gt 0 or _args[0] lt 0>>
		<<set $farm.milking.catchChance to Math.clamp(parseFloat($farm.milking.catchChance) + parseFloat(_args[0]),0,100).toFixed(3)>>
	<</if>>
<</widget>>

<<widget "farm_fight_init">>
	<<set $farm_fight to {}>>
	<<set $farm_fight.action to "rest">>
	<<set $farm_fight.stage to 0>>
	<<set $farm_fight.distraction to 0>>
	<<set $farm_fight.door to 14>>
	<<set $farm_fight.screws to 10>>
<</widget>>

<<widget "farm_fight_alex">>
	<<person1>>
	<<if $farm_fight.distraction is 2>>
		<<set $farm_fight.distraction -= 1>>
		<<He>>【은는】 <<him>>【을를】 에워싼 불량배들 사이를 누비며, 놈들이 가까이 올 때마다 잽을 날린다.
	<<elseif $farm_fight.distraction is 1>>
		<<set $farm_fight.distraction -= 1>>
		<span class="green">알렉스가 <<person1>><<his>> 왼쪽에 있는 <<person2>><<person>>의 주먹을 피한다.</span>
		<<if $farm_fight.stage gte 5>>
			<span class="pink">하지만 <<person6>><<person>>【이가】 등 뒤에서 <<person1>><<him>>에게 돌진하더니, 다시 한번 <<his>> 팔을 붙잡는다.</span>
		<<else>>
			<<if $farm_fight.stage gte 5>>
				<span class="pink">하지만 <<person6>><<person>>【이가】 곧바로 뒤쫓아와 등 뒤에서 <<person1>><<him>>【을를】 붙잡는다.</span> 불량배들이 포위망을 좁힌다.
			<<else>>
				<span class="pink">하지만 <<person3>><<person>>【이가】 곧바로 뒤쫓아와 <<person1>><<him>>의 균형을 무너뜨린다.</span> 불량배들이 포위망을 좁힌다.
			<</if>>
		<</if>>
	<<else>>

		<<switch $farm_fight.stage>>
			<<case 0>>
				알렉스가 <<person1>><<him>>【을를】 붙잡고 있는 <<person3>><<person>>【을를】 발로 차고, <span class="teal">가까스로 벗어난다.</span>
			<<case 1>>
				<span class="lblue">알렉스가 고개를 숙여 <<person4>><<person>>의 휘두른 주먹을 피한다.</span>
			<<case 2>>
				<<person5>><<person>>【이가】 알렉스의 팔을 붙잡지만, <span class="lblue"><<person1>><<he>>【은는】 가까스로 팔을 빼낸다.</span>
			<<case 3>>
				<<person6>><<person>>【이가】 알렉스를 향해 <<his>> 주먹을 휘두르지만, <span class="blue">젊은 농부는 마지막 순간에 고개를 숙여 피한다.</span>
			<<case 4>>
				불량배들은 알렉스를 겹겹이 에워싸고 있다. 그들은 다가가기를 주저하지만, <span class="blue">알렉스도 지쳐가고 있다.</span>
			<<case 5>>
				<<person5>><<person>>【이가】 다시 한번 알렉스를 붙잡으려 시도하고, <<person6>><<person>>【이가】 <<person5>><<him>>【을를】 뒤에서 지원한다. <span class="purple">알렉스는 앞의 공격은 피했지만, 뒤에서 다가온 자에게 <<person1>><<his>> 팔을 붙잡히고 만다.</span><<npcincr Alex dom -1>><<ldom>>
			<<case 6>>
				<span class="purple">알렉스는 <<person6>><<persons>> 손아귀에서 벗어나려 발버둥친다.</span>
			<<case 7>>
				<<person2>><<person>>【이가】 발버둥치는 알렉스에게 정면으로 다가온다. 알렉스가 발길질로 간신히 <<him>>【을를】 막아내지만, <span class="pink"><<person6>><<person>>【은는】 억지로 <<person1>><<him>>【을를】 무릎 꿇린다.</span><<npcincr Alex dom -3>><<lldom>>
			<<case 8>>
				<span class="pink">뒤에서 양팔이 붙들린 채 무릎 꿇은 알렉스를, <<person4>><<person>>【와과】 <<person5>><<person>>【이가】 발로 걷어찬다.</span> <<person1>><<He>>【은는】 얼굴을 찡그리며 견뎌낸다.
			<<case 9>>
				<span class="red">알렉스는 더 이상 견디지 못한다. <<He>>【은는】 바닥에 쓰러져 몸을 웅크린다.</span><<npcincr Alex dom -9>><<llldom>>
			<<default>>
				<span class="red">알렉스는 바닥에 웅크린 채로, 사방에서 날아오는 발길질과 주먹질을 고스란히 얻어맞는다.</span>
		<</switch>>
		<<set $farm_fight.stage += 1>>
<</if>>
<</widget>>

<<widget "farm_fight_door">>
	<<if $farm_fight.door gte 14>>
		<span class="pink">문은 단단하다.</span>
	<<elseif $farm_fight.door gte 11>>
		<span class="purple">문에 가느다란 금이 갔다.</span>
	<<elseif $farm_fight.door gte 8>>
		<span class="blue">문의 금이 더 벌어졌다.</span>
	<<elseif $farm_fight.door gte 5>>
		<span class="lblue">문에 생긴 굵은 틈새로 외풍이 새어 들어온다.</span>
	<<elseif $farm_fight.door gte 2>>
		<span class="teal">문의 금이 벌어져서 팔이 하나 들어갈 정도가 되었다.</span>
	<<else>>
		<span class="green">문은 산산조각이 났다. 더 이상 버티지 못할 것이다.</span>
	<</if>>
	<<if $farm_fight.screws gte 10>>
		<span class="pink">문의 나사가 모두 온전하다.</span>
	<<elseif $farm_fight.screws gte 8>>
		<span class="purple">문의 나사가 대부분 온전하다.</span>
	<<elseif $farm_fight.screws gte 6>>
		<span class="blue">문의 나사가 많이 뽑혀 나갔지만, 여전히 튼튼하다.</span>
	<<elseif $farm_fight.screws gte 4>>
		<span class="blue">문의 나사가 많이 뽑혀 나갔다. 문이 바람에 흔들리며 덜컥거린다.</span>
	<<elseif $farm_fight.screws gte 2>>
		<span class="teal">문의 나사가 대부분 뽑혀 나갔다.</span>
	<<else>>
		<span class="green">나사 하나만이 문을 간신히 고정하고 있다.</span>
	<</if>>
<</widget>>

<<widget "farm_fight_options">>
	<<link [[문을 들이받는다|Farm Fight]]>><<set $farm_fight.action to "bash">><</link>><<physiquedifficulty 9000 18000>>
	<br>
	<<if $farm_fight.toolbox is 1>>
		<<link [[망치로 문을 때려 부순다|Farm Fight]]>><<set $farm_fight.action to "hammer">><</link>><<physiquedifficulty 5000 15000>>
		<br>
		<<link [[문 나사를 푼다|Farm Fight]]>><<set $farm_fight.action to "unscrew">><</link>>
		<br>
	<</if>>
	<<if $farm_fight.sheet is 1>>
		<<if $farm_fight.chainsaw is 2>>
			<<link [[전기톱으로 문을 자른다|Farm Fight]]>><<set $farm_fight.action to "chainsaw">><</link>>
			<br>
		<<elseif $farm_fight.chainsaw is 1>>
			<<if $farm_fight.cupboard is 1>>
				<<link [[전기톱에 연료를 넣는다|Farm Fight]]>><<set $farm_fight.action to "refuel">><</link>>
				<br>
			<</if>>
		<<elseif $farm_fight.chainsaw is undefined>>
			<<link [[전기톱 켜는 법을 알아낸다|Farm Fight]]>><<set $farm_fight.action to "science">><</link>><<skill_difficulty `currentSkillValue("science")` "과학" 1 700>>
			<br>
		<</if>>
	<</if>>
	<<if $farm_fight.shelf is undefined or $farm_fight.toolbox is undefined or $farm_fight.cupboard is undefined or $farm_fight.rakes is undefined or $farm_fight.sheet is undefined>>
		<<link [[헛간을 뒤진다|Farm Fight Search]]>><<set $farm_fight.action to 0>><</link>>
		<br>
	<</if>>
	<<if $farm_fight.stage gte 2 and $farm_fight.distraction lte 0>>
		<<if $farm_fight.breasts isnot 1>>
			<<if $player.sex is "f" or $player.gender_appearance is "f">>
				<<if hasSexStat("exhibitionism", 4)>>
					<<link [[창문으로 가슴을 드러낸다|Farm Fight]]>><<set $farm_fight.action to "breasts">><<set $farm_fight.breasts to 1>><</link>><<exhibitionist4>>
					<br>
				<</if>>
			<<else>>
				<<link [[창문으로 가슴을 드러낸다|Farm Fight]]>><<set $farm_fight.action to "chest">><<set $farm_fight.breasts to 1>><</link>><<exhibitionist1>>
				<br>
			<</if>>
		<</if>>
		<<if $farm_fight.bottom isnot 1>>
			<<if hasSexStat("exhibitionism", 3)>>
				<<link [[창문으로 엉덩이를 드러낸다|Farm Fight]]>><<set $farm_fight.action to "bottom">><<set $farm_fight.bottom to 1>><</link>><<exhibitionist3>>
				<br>
			<</if>>
		<</if>>
		<<if $farm_fight.genitals isnot 1>>
			<<if hasSexStat("exhibitionism", 5)>>
				<<if $player.penisExist and $player.vaginaExist>>
					<<link [[창문으로 성기를 드러낸다|Farm Fight]]>><<set $farm_fight.action to "penis">><<set $farm_fight.genitals to 1>><</link>><<exhibitionist5>>
					<br>
				<<elseif $player.penisExist>>
					<<link [[창문으로 자지를 드러낸다|Farm Fight]]>><<set $farm_fight.action to "penis">><<set $farm_fight.genitals to 1>><</link>><<exhibitionist5>>
					<br>
				<<else>>
					<<link [[창문으로 보지를 드러낸다|Farm Fight]]>><<set $farm_fight.action to "vagina">><<set $farm_fight.genitals to 1>><</link>><<exhibitionist5>>
					<br>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "farm_sleep_options">>
	<<nightmareCheck "Farm Sleep">>

	<<generateSleepLinks "Farm Sleep">>
	<<if $bus is "farm_alex_room">>
		<<link [[침대에서 나온다|Farm Alex Bedroom]]>>
			<<storeon "farm alex bed" "check">>
			<<if _store_check is 1>>
				<<storeon "farm alex bed">>
				<<set $wardrobe_location to "alexFarm">>
				<<wardrobeSelection true>>
			<</if>>
			<<loadTempHairStyle>>
		<</link>>
		<br>
	<<else>>
		<<link [[침대에서 나온다|Farm Bedroom]]>><<storeon "Farm Bed">><<set $wardrobe_location to "alexFarm">><<loadTempHairStyle>><<wardrobeSelection>><<loadTempHairStyle>><</link>>
	<</if>>
	<br><br>
<</widget>>

<<widget "farm_tell_alex">>
	<<set _alex to C.npc.Alex>>
	<<set _alex_rng to random(1, 14)>>
	<<if _alex_rng is 14 and $fame.model gte 30>>
		당신은 당신의 모델 일에 대해 이야기한다.
		<<if $rng gte 61 and $alex_countdown is undefined and $farm_stage gte 7>>
			"너 모델이야? 그럴 줄 알았어." <<He>>【이가】 얼굴을 붉힌다. "넌 정말 예쁘니까."
		<<elseif $rng gte 31 and $farm_stage gte 6>>
			<<loadNPC 1 "alexs_parent1">>
			"네가 너무 유명해지지 않았으면 좋겠어," <<he>>【이가】 말한다. "우리 <<person2>><<mum>>한테 그 얘기만 듣고 살아야 할 테니까."<<person1>>
		<<else>>
			"너무 우쭐해하지는 말고," <<he>>【이가】 놀린다. "TV에서 너를 본다면, 내가 소리를 지를지도 모른다고."
		<</if>>
	<<elseif _alex_rng is 13 and $fame.scrap gte 30>>
		당신은 자신을 지키는 방법을 안다고 <<him>>에게 말한다.
		<<if isLoveInterest("Alex")>>
			"내 <<girl>>【이가】 터프하다는 건 알고 있었지." <<He>>【이가】 씩 웃는다. "무슨 일이 있어도 난 네 편이야."
		<<elseif $bodysize lte 0>>
			"너같이 조그만 애가 그런다니 좀 놀라운데," <<he>>【이가】 웃는다. "기분 나쁘라고 한 소린 아니야."
		<<else>>
			<<He>>【이가】 찬성한다는 듯 고개를 끄덕인다. "누구나 가져야 할 좋은 기술이지," <<he>>【이가】 말한다. "변태들은 꺼져야 해."
		<</if>>
	<<elseif _alex_rng is 12 and $fame.good gte 30>>
		당신은 남들을 돕기 위해 무던히 애를 쓴다고 <<him>>에게 말한다. 어떤 이들은 당신을 천사라고 부르기도 한다고.
		<<if _alex.love lte -10>>
			"뭔가 앞뒤가 안 맞는데." <<he>>【이가】 성가신 듯 말한다. "미안, 무례하게 굴려던 건 아니었어. 하지만 나한테는 좀 더 친절하게 대해줄 수 있잖아."
		<<elseif $alex_countdown is undefined and $farm_stage gte 7>>
			"넌 나의 천사야," <<he>>【이가】 속삭이며 활짝 웃는다. "그리고 내 <<woman>>이지."
		<<elseif $angel gte 6 and $transformationParts.angel.halo isnot "hidden" and $transformationParts.angel.wings isnot "hidden">>
			"내가 예외가 아니라는 게 다행이네." <<He>>【이가】 당신에게 미소 짓는다. "넌 확실히 그렇게 생기긴 했어."
		<<elseif $demon gte 2>>
			"네가 정의로운 타입인 줄은 몰랐네," <<he>>【이가】 놀린다. "그 악마 같은 미소를 짓고 말이야."
		<<else>>
			"글쎄다," <<he>>【이가】 눈을 굴리는 시늉을 하며 말한다. "농담이야. 널 처음 봤을 때부터 마음씨가 착하다는 걸 알 수 있었어."
		<</if>>
	<<elseif _alex_rng is 11 and $fame.business gte 30>>
		당신은 자신이 사업가라고 <<him>>에게 말한다.
		<<if $farm_stage gte 7>>
			"너 꽤 열심히 하던데." <<He>>【이가】 들판을 가리키며 씩 웃는다. "널 공동 소유주로 만든 건 내가 내린 최고의 결정 중 하나야."
		<<else>>
			<<He>>【이가】 고개를 끄덕이며 웃는다. "지금까지 네가 해온 일들이 마음에 들어. 계속 수고해 줘."
		<</if>>
	<<elseif _alex_rng is 10 and $fame.social gte 30>>
		당신은 시내에서 사람들과 잘 어울린다고 <<him>>에게 말한다. "마을의 엘리트가 나 같은 시골 <<nnpc_gendery "Alex">>【와과】 엮이면서 손을 더럽힌다는 게 멋진걸," <<he>>【이가】 놀리듯 말한다.
	<<elseif _alex_rng is 9 and $adultshopclerk>>
		당신은 당신이 성인용품점 점원이라고 <<him>>에게 말한다. "직원 할인도 받아? 나 좀 더 필요한데-" <<He>>【이가】 말을 끊는다. "아무것도 아니야."
	<<elseif _alex_rng is 8 and $spa_job gte 1>>
		당신은 시내 스파에서 손님들을 마사지해 준다고 <<him>>에게 말한다. "나도 마사지 받을 때가 지났는데," <<he>>【이가】 말한다. "머드 목욕 해본 적 있어? 한 번 추천해 볼게."
	<<elseif _alex_rng is 7 and $oceanbreezejob is 1>>
		마을 카페에서도 웨이터로 일한다고 <<him>>에게 말한다. "나라면 첫날 바로 짤렸을 거야," <<he>>【이가】 말한다. "난 희롱당하는 걸 가만히 못 참거든."
	<<elseif _alex_rng is 6 and $chef_state gte 1>>
		당신은 마을 카페에서 요리사로 일하기도 한다고 <<him>>에게 말한다. "꽤나 괜찮은 일거리네." <<He>>【이가】 미소 짓는다. "우리 나중에 요리 대결이라도 한 번 해야겠어."
	<<elseif _alex_rng is 5 and $docks.hired>>
		당신은 부두 노동자이기도 하다고 <<him>>에게 말한다. "허리 조심해," <<he>>【이가】 경고한다. "나 믿어. 내 경험에서 우러나온 충고니까."
	<<elseif _alex_rng is 4 and $stripclubbartendingintro is 1>>
		당신은 밤에 바텐더로도 일한다고 <<him>>에게 말한다. "네가 술을 만든다고? 왜 진작 말 안 했어?" <<His>> 얼굴이 밝아지더니, 술에 대해 열광적으로 이야기하기 시작한다.
	<<elseif _alex_rng is 3 and $stripclubdancingintro is 1 or $danceStudio.jobOffered>>
		당신은 또한 춤꾼이기도 하다고 <<him>>에게 말한다. <<He>>【이가】 한참 동안 웃는다. "나도 꽤 잘 추는 것 같아. 사람들이 꽤 많이 몰려들었거든." 당신이 생각하는 그런 춤을 의미한 건 아닌 것 같다.
	<<elseif _alex_rng is 2 and $brotheljob is 1 and $fame.prostitution gte 30>>
		"창관에서 네 소문을 들었어. 네가 아직도 여기에 나타나다니 놀라워. 네가 벌어들일 돈의 액수를 생각하면 말이야." <<He>>【이가】 당신을 위아래로 훑어보더니, 웃으며 고개를 돌린다.
		<<if $uncomfortable.lewd is true>>
			<<stress 6>><<gstress>>
		<</if>>
	<<elseif _alex_rng is 1 and $fame.sex gte 400>>
		"소문에 의하면 네가 꽤 많은 상대와 자봤다고 하던데." <<He>>【이가】 감탄한 듯 웃는다.
		<<if $alex_countdown is undefined and $farm_stage gte 7>>
			"너 나랑 취향이 아주 똑같은 <<woman>>인거, 그거 알아?"
		<<else>>
			"정말 빡세게 살았구나. 존경해."
		<</if>>
	<<else>>
		당신은 어깨를 으쓱이고는 <<if Time.hour is 5>>창밖을 내다본다.<<else>>하늘을 올려다본다.<</if>> <<He>>도 그렇게 한다.
	<</if>>
<</widget>>

<<widget "farm_cottage_options">>
	<<set _farmbed to isLoveInterest("Alex") ? "alex" : "farm">>
	<<bedicon _farmbed>><<link [[당신의 방 (0:01)|Farm Bedroom]]>><<pass 1>><<endevent>><</link>>
	<br>
	<<farmicon "alexbed">><<link [[알렉스의 방 (0:01)|Farm Alex Bedroom]]>><<pass 1>><<endevent>><</link>>
	<br>
	<<kitchenicon "stove-farm">><<link [[부엌 (0:01)|Farm Kitchen]]>><<pass 1>><<endevent>><</link>>
	<br>
	<<if $farm.stock>>
		<<icon "tending/basket.png">><<link [[재고 확인|Farm Stock]]>><<endevent>><</link>>
		<br>
	<</if>>
	<br>

	<<if C.npc.Alex.pregnancy.nursery is true>>
		<<if $exposed gt 0 or ["split dress", "short ballgown", "large towel", "cropped hoodie", "slut shirt,", "tie-front top", "towel top"].includes($worn.upper.name) or ["split dress skirt", "short ballgown skirt", "micro pleated skirt", "miniskirt", "towel skirt"].includes($worn.lower.name)>>
			<span class="pink">당신의 옷차림이 너무 남사스러워 아기 방에 들어갈 수 없다.</span>
		<<elseif $liquidcount gte 1>>
			<span class="pink">아기 방에 들어가려면 먼저 몸을 깨끗하게 씻어야 한다.</span>
		<<else>>
			<<childicon "crib">><<link [[보육실|Childrens Home]]>><<set $exitPassage to $passage>><</link>>
		<</if>>
		<br><br>

	<</if>>

	<<getouticon>><<link [[밖으로 나간다 (0:01)|Farm Work]]>>
		<<pass 1>><<endevent>>
		<<if $farm_stage gte 7 and ((hasSexStat("exhibitionism", 5) and $exposed gte 2) or (hasSexStat("exhibitionism", 4) and $exposed gte 1))>>
			<<set $farm_naked to 1>>
		<</if>>
	<</link>>
	<br>
<</widget>>

<<widget "farm_cottage_tv_options">>

	<<if C.npc.Alex.pregnancy.pcKnowledge is true and C.npc.Alex.pregnancy.ultraSoundPics is true and C.npc.Alex.pregnancy.sample isnot true and getPlayerPregnancy()?.possibleDonors.length is 1>>
		<<ind>><<link [[알렉스에게 초음파 사진을 보여준다 (0:05)|Farm PC Ultrasound Pics Show]]>><</link>>
