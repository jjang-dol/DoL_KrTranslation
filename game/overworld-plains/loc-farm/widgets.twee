		<br>
	<<else>>
		<<link [[다음|Farm Work]]>><<endevent>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "cottage_bailey_options">>
	<<babyRent>>
	<<rent_avery>>
	<<if $money gte $rentmoney + ($babyRent or 0)>>
		<<link [[돈을 낸다|Farm Cottage Bailey Pay]]>><</link>>
		<br>
		<<link [[거절한다|Farm Cottage Bailey Refuse]]>><<def 1>><</link>>
		<br>
	<<else>>
		<<set $baileypaychain to 0>>
		<<if $speech_attitude is "meek">>
			"도-돈이 없어요," 베일리에게 말한다. "제발 알렉스를 해치지 말아주세요."
		<<elseif $speech_attitude is "bratty">>
			"돈 없어," 베일리에게 말한다. "설령 있다 해도 십 원 한 장 안 줄 거야."
		<<else>>
			"돈 없어," 베일리에게 말한다. "시간 낭비야."
		<</if>>
		<br>
		알렉스가 당신의 어깨에 손을 얹는다. "협박 따위엔 안 굴복해," 침입자를 노려보며 <<he>>【이가】 말한다. "당장
		<<if C.npc.Alex.dom gte 20>>
			내
		<<else>>
			우리
		<</if>>
		땅에서 꺼져."
		<br><br>

		"좋아," 베일리가 말한다. "내 친구들이 기뻐하겠군." <<nnpc_He Bailey>>【은는】 돌아서서 걸어간다.
		<br><br>

		<<if $bailey_encroach gte 1>>
			<span class="pink"><i>베일리가 레미에게 더 많은 지원을 쏟을 것이며, 이에 따라 침식도가 더욱 빠르게 상승할 것입니다. 레미가 공격할 때마다 <<nnpc_He Bailey>>【은는】 증원군을 보낼 것입니다.</i></span>
		<<else>>
			<span class="pink"><i>베일리가 농장에 대한 레미의 공격을 지원할 것이며, 이에 따라 침식도가 더 빠르게 상승할 것입니다. 레미가 공격할 때마다 <<nnpc_He Bailey>>【은는】 증원군을 보낼 것입니다.</i></span>
		<</if>>
		<br><br>

		<<link [[다음|Farm Cottage Bailey Refuse 2]]>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "farm_build_day">>
	<<if $farm_stage gte 7>>
		<<if $farm.build_timer gte 1>>
			<<set $farm.build_timer -= 1>>
		<</if>>
		<<if $farm.build_timer lte 0>>
			<<switch $farm.build>>
				<<case "wall 1">>
					<<set $farm.wall to 1>>
				<<case "wall 2">>
					<<set $farm.wall to 2>>
				<<case "wall 3">>
					<<set $farm.wall to 3>>
				<<case "wall 4">>
					<<set $farm.wall to 4>>
				<<case "tower 1">>
					<<set $farm.tower to 1>>
				<<case "tower 2">>
					<<set $farm.tower to 2>>
				<<case "woodland 1">>
					<<set $farm.woodland to 1>>
				<<case "woodland 2">>
					<<set $farm.woodland to 2>>
				<<case "woodland 3">>
					<<set $farm.woodland to 3>>
				<<case "kennel 1">>
					<<set $farm.kennel to 1>>
				<<case "barn 1">>
					<<set $farm.barn to 1>>
				<<case "barn 2">>
					<<set $farm.barn to 2>>
				<<case "stable 1">>
					<<set $farm.stable to 1>>
				<<case "coop 1">>
					<<set $farm.coop to 1>>
				<<case "coop 2">>
					<<set $farm.coop to 2>>
				<<case "parasites 1">>
					<<set $farm.parasitebarn to 1>>
				<<case "parasites 2">>
					<<set $farm.parasitebarn to 2>>
					<<set _container to $container.farm>>
					<<set _container.upgrades.capacity to 1>>
					<<set _container.maxCount to 7>>
					<<set _container.upgrades.foodStorage to 1>>
					<<set _container.maxDaysWithoutFood to 31>>
					<<set _container.upgrades.luxury to 3>>
				<<case "irrigation">>
					<<if $farm.irrigation is undefined>>
						<<set $farm.irrigation to 1>>
					<<elseif $farm.irrigation lt 9>>
						<<set $farm.irrigation++>>
					<</if>>
			<</switch>>
			<<if $farm.build_finished is undefined or $farm.build_finished is 0>>
				<<set $farm.build_finished to []>>
			<</if>>
			<<run $farm.build_finished.pushUnique($farm.build)>>
			<<set $farm.build to 0>>
		<</if>>
	<</if>>
<</widget>>

<<widget "farm_fence_damage">>
	<<if _args[0]>>
		<<set _fence_mod to 1>>
		<<if $farm.wall gte 2>>
			<<set _fence_mod -= 0.5>>
		<</if>>
		<<set $farm_work.fence_damage += (_args[0] * _fence_mod)>>
		<<set $farm_work.fence_damage = Math.clamp($farm_work.fence_damage, 0, 100)>>
	<</if>>
<</widget>>

<<widget "farm_fence">>
	<<if $farm.wall gte 3>>
		<<set _text_output to "울타리">>
	<<elseif $farm.wall gte 1>>
		<<set _text_output to "벽">>
	<<else>>
		<<set _text_output to "울타리">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "guard_terms">>
	<<farm_guard_wage>>
	보안 기술: <<guard_skill_text>>
	<br>
	주급: <<printmoney $farm.tower_guard_wage>>
	<br>
	<i>시간이 지나면서 기술이 향상되겠지만, 향상됨에 따라 <<he>>【은는】 더 많은 급여를 요구할 것입니다.</i>
<</widget>>

<<widget "guard_skill_text">><<silently>>
	<<if _args[0] is "tower" and $farm.tower_guard_skill isnot undefined>>
		<<set _guard_skill to $farm.tower_guard_skill>>
	<<else>>
		<<set _guard_skill to $NPCList[0].skills.security>>
	<</if>>
	<<if _guard_skill gte 1000>>
		<<set _text_output to '<span class="green">S</span>'>>
	<<elseif _guard_skill gte 800>>
		<<set _text_output to '<span class="teal">A</span>'>>
	<<elseif _guard_skill gte 600>>
		<<set _text_output to '<span class="lblue">B</span>'>>
	<<elseif _guard_skill gte 400>>
		<<set _text_output to '<span class="blue">C</span>'>>
	<<elseif _guard_skill gte 200>>
		<<set _text_output to '<span class="purple">D</span>'>>
	<<else>>
		<<set _text_output to '<span class="pink">F</span>'>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "farm_guard_pay">>
	<<if $farm.tower_guard_unpaid gte 1>>
		<<set _owed to ($farm.tower_guard_wage * $farm.tower_guard_unpaid)>>
		당신은 <<him>>에게 밀린 임금 <<printmoney _owed>>【을를】 지불해야 한다.
		<br>
		<<if $money gte _owed>>
			<<link [[임금을 지불한다|Farm Tower Pay]]>><<money `-_owed` "farm">><<set $NPCList[0].trust += 1>><<farm_guard_paid>><</link>><<gtrust>><<note "+ 보안 기술" "green">><<note "+ 임금 지출" "red">>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "farm_guard_wage">>
	<<set $farm.tower_guard_wage to 30000 + ($NPCList[0].skills.security * 100)>>
<</widget>>

<<widget "farm_guard_paid">>
	<<set $NPCList[0].skills.security += (20 * $farm.tower_guard_unpaid)>>
	<<set $NPCList[0].skills.security to Math.clamp($NPCList[0].skills.security, 0, 1000)>>
	<<set $farm.tower_guard_skill to clone($NPCList[0].skills.security)>>
	<<farm_guard_wage>>
	<<set $farm.tower_guard_unpaid to 0>>
	<<if $NPCList[0].skills.security gte 1000>>
		<<earnFeat "Reliable Employer">>
	<</if>>
<</widget>>

<<widget "farm_stock_init">>
	<<set $farm.stock to {}>>
	<<set $farm.stock.truffles to 0>>
	<<set $farm.stock.eggs to 0>>
	<<set $farm.stock.milk to 0>>
	<<set $farm.stock.cream to 0>>
<</widget>>

<<widget "farm_stock">>
	<<if _args[0]>>
		<<if _args[1] and _args[2]>>
			<<set $farm.stock[_args[0]] += random(_args[1], _args[2])>>
		<<elseif _args[1]>>
			<<set $farm.stock[_args[0]] += _args[1]>>
		<<else>>
			<<set $farm.stock[_args[0]] += 1>>
		<</if>>
	<</if>>
<</widget>>

<<widget "farm_ride_events">>
	<<rng 4>>
	<<if $rng is 4>>
		<<if $farm.aggro gte 80>>
			뒤에서 말발굽 소리가 다가오는 것이 들린다. 레미의 부하 두 명이 <span class="red">전속력으로</span> 당신을 뒤쫓고 있다.
			<br><br>

			<<generate2>><<generate3>>
			<<link [[더 빨리 달린다|Farm Ride Aggro Faster]]>><</link>><<skill_difficulty `currentSkillValue("thighskill")` "허벅지 스킬" 400 1400>>
			<br>
			<<link [[맞선다|Farm Ride Aggro Confront]]>><</link>>
			<br>
		<<elseif $farm.aggro gte 40>>
			뒤에서 말발굽 소리가 다가오는 것이 들린다. 레미의 부하 두 명이 당신의 뒤를 쫓고 있다. 그들이 점점 거리를 좁혀온다.
			<br><br>
			<<generate2>><<generate3>>
			<<link [[더 빨리 달린다|Farm Ride Faster]]>><</link>><<skill_difficulty `currentSkillValue("thighskill")` "허벅지 스킬" 1 1000>>
			<br>
			<<link [[맞선다|Farm Ride Confront]]>><</link>>
			<br>
		<<else>>
			뒤에서 말발굽 소리가 다가오는 것이 들린다. 레미의 부하 두 명이 당신의 뒤를 쫓지만, 어느 정도 거리를 유지하고 있다.<<gstress>><<stress 6>><<gaggro>><<farm_aggro 1>>
			<br><br>

			<<destination_farm_ride>>
		<</if>>
	<<elseif $rng is 3>>
		<<if $farm.beasts.horses lt -20 and $settings.horsesEnabled and ($monster is 1 or $settings.bestialityEnabled)>>
			<<beasttype>>【이가】 갑자기 방향을 틀더니 전속력으로 달리기 시작해, 넓은 들판을 가로지른다. <<bHe>>【은는】 건초더미 옆에 멈춰 서서 상체를 휙 숙여, 당신을 안장 아래로 떨어뜨린다.
			<br><br>
			당신은 건초더미 위로 떨어지지만, 도망치기도 전에 <<beasttype>>【이가】 <<bhis>> 무게로 당신을 억누른다.
			<<if $monster gte 1>>
				"너의 임무를 다할 시간이야." <<bhe>>【이가】 말한다. "이 걸레 같은 년아."
			<</if>>
			<<if $NPCList[0].penis isnot "none">>
				단단한 물건이 당신의 <<bottom>>【을를】 압박한다.
			<</if>>
			<br><br>

			<<link [[다음|Farm Ride Rape]]>><<set $molestationstart to 1>><</link>>
			<br>
		<<elseif $farm.beasts.horses lt 0 and $settings.horsesEnabled and ($monster is 1 or $settings.bestialityEnabled)>>
			<<beasttype>>【이가】 멈춰 서서는 더 이상 발걸음을 떼려 하지 않는다.
			<<if $monster is 1>>
				"나 욕구불만이야." <<bhe>>【이가】 말한다. "이걸 풀어주는 게 네 일이잖아."
			<<else>>
				그것이 짜증 섞인 울음소리를 낸다.
			<</if>>
			<br><br>


			<<if hasSexStat("deviancy", 3)>>
				<<link [[손으로 해준다|Farm Ride Hand]]>><</link>><<deviant3>>
				<br>
			<</if>>
			<<link [[억지로 계속하게 만든다|Farm Ride Force]]>><</link>><<skill_difficulty `currentSkillValue("thighskill")` "허벅지 스킬" 1 1400>>
			<br>
			<<link [[걸어서 계속 간다|Farm Ride Foot]]>><</link>>
			<br>
		<<elseif $farm.beasts.horses lt 20>>
			<<if $monster gte 1>>
				당신이 올라탄 동안 <<beasttype>>【은는】 아무 소리도 내지 않고, 생각에 잠긴 듯하다.
			<<else>>
				당신이 올라타 있는 동안 <<beasttype>>【은는】 아무런 말썽도 피우지 않는다.
			<</if>>
			<br><br>
			<<destination_farm_ride>>
		<<else>>
			<<if $monster gte 1>>
				당신이 올라타 있는 동안 <<beasttype>>【은는】 수다를 떨며, 당신의 농장 경영을 칭찬한다.
			<<else>>
				<<beasttype>>【은는】 다리를 뻗으며 달릴 수 있어서 기뻐 보이고, 당신이 자신을 타는 것도 즐거워하는 것 같다.
			<</if>>
			<br><br>
			<<destination_farm_ride>>
		<</if>>
	<<elseif $rng is 2>>
		<<beasttype>>【이가】 속도를 늦춘다. <<bHe>>【은는】 벌써 지친 모양이다.
		<br><br>

		<<link [[<<bhim>>【을를】 쉬게 해준다 (0:10)|Farm Ride Break]]>><<pass 10>><</link>>
		<br>
		<<link [[<<bhim>>【을를】 계속 몰아붙인다|Farm Ride Push]]>><</link>><<skill_difficulty `currentSkillValue("thighskill")` "허벅지 스킬" 1 1000>>
		<br>
	<<else>>
		차가 지나가면서 경적을 울리자, 당신의 <<beasttype>>【이가】 흥분한다. <<bHe>>【은는】 길에서 벗어나 도랑으로 곤두박질칠 뻔한다.
		<br><br>

		<<link [[달랜다|Farm Ride Soothe]]>><</link>><<tendingdifficulty 1 1200>>
		<br>
		<<link [[통제권을 쥔다|Farm Ride Charge]]>><<def 1>><</link>><<skill_difficulty `currentSkillValue("thighskill")` "허벅지 스킬" 1 1200>>
		<br>
		<<link [[무시한다|Farm Ride Ignore]]>><<farm_horses -1>><</link>><<lrespect>>
		<br>
	<</if>>
<</widget>>

<<widget "destination_farm_ride">>
	<<if $bus is "farm">>
		농장에 도착하여, 타고 있던 말에서 내린다.
		<br><br>

		<<link [[다음|Farm Work]]>><<endevent>><</link>>
		<br>
	<<else>>
		저 앞에 마을이 보인다. 타고 온 말을 들판에 풀어 풀을 뜯게 하고, 남은 길은 걸어서 간다.
		<br><br>

		<<link [[다음|Harvest Street]]>><<endevent>><<set $eventskip to 1>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "farm_attack_auto">>
	<<switch $farm_stage>>
		<<case 12>>
			<<set _farm_damage to 9>>
		<<case 11>>
			<<set _farm_damage to 8>>
		<<case 10>>
			<<set _farm_damage to 7>>
		<<case 9>>
			<<set _farm_damage to 6>>
		<<case 8>>
			<<set _farm_damage to 5>>
		<<default>>
			<<set _farm_damage to 4>>
	<</switch>>
	<<if $bailey_encroach>>
		<<set _farm_damage += 2>>
	<</if>>
	<<if $farm.kennel gte 1>>
		<<set _farm_damage -= 1>>
	<</if>>
	<<if $farm.wall gte 4>>
		<<set _farm_damage -= 4>>
	<<elseif $farm.wall gte 3>>
		<<set _farm_damage -= 3>>
	<<elseif $farm.wall gte 2>>
		<<set _farm_damage -= 2>>
	<<elseif $farm.wall gte 1>>
		<<set _farm_damage -= 1>>
	<</if>>
	<<if $farm.tower gte 2 and $farm.tower_guard>>
		<<set _farm_damage -= Math.trunc($farm.tower_guard_skill / 250)>>
	<<elseif $farm.tower gte 1 and $farm.tower_guard>>
		<<set _farm_damage -= Math.trunc($farm.tower_guard_skill / 500)>>
	<</if>>
	<<if _farm_damage lte 0 and $farm_stage gte 12>>
		<<run $timeMessages.pushUnique("heroicVictory")>>
	<</if>>
	<<damage_farm "loop" _farm_damage>>
	<<set $farm_attack_timer to random(17, 24)>>
	<<set $farm_attacked to 1>>
<</widget>>

<<widget "damage_farm">>
	<<if $fields_damaged is undefined>>
		<<set $fields_damaged to []>>
	<</if>>
	<<if _args[0] is "target">>
		<<clear_plot farm _args[1]>>
		<<set $fields_damaged.push(_args[1])>>
	<<elseif _args[0] is "loop">>
		<<set _field_number to _args[1]>>
		<<for _i to 0; _i lt _field_number; _i++>>
			<<if $plots.farm[_i]>>
				<<if $plots.farm[_i].stage gte 1>>
					<<clear_plot farm _i>>
					<<set $fields_damaged.push(_i)>>
				<<else>>
					<<set _field_number++>>
				<</if>>
			<<else>>
				<<set $farm_destroyed to true>>
				<<break>>
			<</if>>
		<</for>>
	<</if>>
<</widget>>

<<widget "farm_damage_report">>
	<<if $fields_damaged.length is 0>>
		<<if $farm_destroyed is true>>
			당신이 없는 동안 농장이 습격을 받았지만, <span class="blue">불태울 밭이 없었다.</span>
		<<else>>
			당신이 없는 동안 농장이 습격을 받았지만, <span class="green">방어자들이 용감히 싸워 밭을 하나도 잃지 않았다.</span>
		<</if>>
	<<elseif $fields_damaged.length is 1>>
		당신이 없는 동안 농장이 습격을 받았고, 방어자들이 그들을 쫓아내기 전에 <span class="purple">밭 한 곳이 불탔다.</span><<gtrauma>><<trauma 6>>
	<<elseif $fields_damaged.length is 9>>
		당신이 없는 동안 농장이 습격을 받아 방어자들이 패배했고, <span class="red">모든 밭이 불탔다.</span><<gggtrauma>><<trauma 24>>
	<<else>>
		당신이 없는 동안 농장이 습격을 받았고, 방어자들이 그들을 쫓아내기 전에 <span class="pink"><<ordinalList $fields_damaged.map(x=>x+1).toSorted()>> 밭이 불탔다.</span><<ggtrauma>><<trauma 12>>
	<</if>>
	<br><br>
	<<set $fields_damaged to []>>
	<<unset $farm_destroyed>>
	<<unset $farm_attacked>>
<</widget>>

<<widget "farm_assault_intro">>
	<span class="green">알렉스는 싸울 준비가 되어 있다.</span>
	<br>
	<<if $farm.kennel gte 1>>
		<span class="green">사냥개들은 훈련을 받았고 주인을 지킬 준비가 되어 있다.</span>
	<<else>>
		<span class="blue">사냥개들은 농장을 지킬 준비는 되어 있지만, 특별한 훈련을 받지는 않았다.</span>
	<</if>>
	<br>
	<<if $farm.tower gte 2>>
		<<if $farm.tower_guard>>
			<span class="green">감시탑과 탐조등은 $farm.tower_guard【이가】 조작하고 있으며,</span> <<guard_skill_text "tower">>급 보안 기술을 보유하고 있다.
		<<else>>
			<span class="red">감시탑은 비어 있지만,</span> 더 넓은 시야를 확보하는 데 사용할 수 있다.
		<</if>>
	<<elseif $farm.tower gte 1>>
		<<if $farm.tower_guard>>
			<span class="teal">감시탑은 $farm.tower_guard【이가】 조작하고 있으며,</span> <<guard_skill_text "tower">>급 보안 기술을 보유하고 있다.
		<<else>>
			<span class="red">감시탑은 비어 있지만,</span> 더 넓은 시야를 확보하는 데 사용할 수 있다.
		<</if>>
	<</if>>
	<br>
	<<if $farm.wall gte 4>>
		<span class="green">농장 주변의 가시 돋친 철조망은 기어오를 수 없다. 침입자들은 절단하고 들어와야 하므로, 시간이 꽤 걸릴 것이다.</span>
	<<elseif $farm.wall gte 3>>
		<span class="teal">농장 주변의 높은 철조망이 침입자들의 속도를 크게 늦출 것이다.</span>
	<<elseif $farm.wall gte 2>>
		<span class="lblue">농장 주변의 강화된 벽이 침입자들의 속도를 늦출 것이다.</span>
	<<elseif $farm.wall gte 1>>
		<span class="blue">농장 주변의 벽이 침입자들의 속도를 약간 늦출 것이다.</span>
	<<else>>
		<span class="purple">농장을 둘러싼 벽과 울타리는 형편없는 방벽에 불과하다.</span>
	<</if>>
<</widget>>

<<widget "farm_upgrades_current">>
	<<if $farm.build>>
		<<switch $farm.build>>
			<<case "parasites 1">>
				기생충 헛간이 건설되는 중이다.
			<<case "parasites 2">>
				기생충 헛간이 확장되는 중이다.
			<<case "wall 1">>
				벽이 대대적으로 수리되는 중이다.
			<<case "wall 2">>
				벽이 보강되는 중이다.
			<<case "wall 3">>
				돌담 위에 금속 울타리가 건설되는 중이다.
			<<case "wall 4">>
				울타리 위에 철조망이 부착되는 중이다.
			<<case "tower 1">>
				밭 가장자리에 감시탑이 건설되는 중이다.
			<<case "tower 2">>
				감시탑 위에 탐조등이 부착되는 중이다.
			<<case "kennel 1">>
				경비견 훈련 시설이 건설되는 중이다.
			<<case "barn 1" "barn 2">>
				헛간이 확장되는 중이다.
			<<case "woodland 1" "woodland 2" "woodland 3">>
				근처 숲 주변에 울타리가 건설되는 중이다.
			<<case "stable 1">>
				마구간이 확장되는 중이다.
			<<case "coop 1" "coop 2">>
				닭장이 확장되는 중이다.
			<<case "irrigation">>
				밭에 관개 시설이 설치되는 중이다.
			<<case "nursery">>
				오두막에 아기방이 건설되는 중이다.
		<</switch>>
		<<if $farm.build_timer is 1>>
			내일 완성될 것이다.
		<<else>>
			<<number $farm.build_timer>>일 뒤에 완성될 것이다.
		<</if>>
		<br><br>
	<</if>>
<</widget>>

<<widget "farm_upgrades_status">>
	<<set _upgrade_count to 0>>
	<<if $cottage_nursery_prep is 1 or C.npc.Alex.pregnancy.nursery is true>>
		오두막:
		<span class ="green">거주하기 좋은 곳</span>
		<br>

	<<elseif talkedAboutPregnancy("Alex","pc") or (talkedAboutPregnancy("pc","Alex") and getActivePregnancies("pc").some(p => p.donor === "Alex" && p.possibleDonors.length === 1)) or C.npc.Alex.pregnancy.knowledge is true>>
		오두막:
		<<link [[아기방|Farm Upgrades Nursery]]>><</link>>
		<br>
	<</if>>

	벽:
	<<if $farm.wall gte 4 or $farm.build is "wall 4">>
		<span class="green">더할 나위 없이 튼튼함</span>
		<<set _upgrade_count += 1>>
	<<elseif $farm.wall is 3 or $farm.build is "wall 3">>
		<<link [[철조망|Farm Upgrades Wall 4]]>><</link>>
	<<elseif $farm.wall is 2 or $farm.build is "wall 2">>
		<<link [[금속 울타리|Farm Upgrades Wall 3]]>><</link>>
	<<elseif $farm.wall is 1 or $farm.build is "wall 1">>
		<<link [[보강|Farm Upgrades Wall 2]]>><</link>>
	<<else>>
		<<link [[전면 수리|Farm Upgrades Wall 1]]>><</link>>
	<</if>>
	<br>
	<<if $farm_stage gte 8>>
		보안:
		<<if $farm.tower is 2 or $farm.build is "tower 2">>
			<span class="green">더할 나위 없이 철저함</span>
			<<set _upgrade_count += 1>>
		<<elseif $farm.tower is 1 or $farm.build is "tower 1">>
			<<link [[탐조등|Farm Upgrades Tower 2]]>><</link>>
		<<else>>
			<<link [[감시탑|Farm Upgrades Tower]]>><</link>>
		<</if>>
		<br>
		숲:
		<<if $farm.woodland gte 3 or $farm.build is "woodland 3">>
			<span class="green">농장에 편입됨</span>
			<<set _upgrade_count += 1>>
		<<elseif $farm.woodland gte 2 or $farm.build is "woodland 2">>
			<<link [[더 많이 매입|Farm Upgrades Woodland 3]]>><</link>>
		<<elseif $farm.woodland gte 1 or $farm.build is "woodland 1">>
			<<link [[추가 매입|Farm Upgrades Woodland 2]]>><</link>>
		<<else>>
			<<link [[매입|Farm Upgrades Woodland 1]]>><</link>>
		<</if>>
		<br>
		개집:
		<<if $farm.kennel gte 1 or $farm.build is "kennel 1">>
			<span class="green">최신식</span>
			<<set _upgrade_count += 1>>
		<<else>>
			<<link [[훈련 시설을 갖춘다|Farm Upgrades Kennel 1]]>><</link>>
		<</if>>
		<br>
		헛간:
		<<if $farm.barn gte 2 or $farm.build is "barn 2">>
			<span class="green">더할 나위 없이 튼튼함</span>
			<<set _upgrade_count += 1>>
		<<elseif $farm.barn gte 1 or $farm.build is "barn 1">>
			<<link [[확장|Farm Upgrades Barn 2]]>><</link>>
		<<else>>
			<<link [[새 착유 장비를 갖춘다|Farm Upgrades Barn 1]]>><</link>>
		<</if>>
		<br>
		마구간:
		<<if $farm.stable gte 1 or $farm.build is "stable 1">>
			<span class="green">더할 나위 없이 정교함</span>
			<<set _upgrade_count += 1>>
		<<else>>
			<<link [[확장|Farm Upgrades Stable 1]]>><</link>>
		<</if>>
		<br>
		닭장:
		<<if $farm.coop gte 2 or $farm.build is "coop 2">>
			<span class="green">더할 나위 없이 거대함</span>
			<<set _upgrade_count += 1>>
		<<elseif $farm.coop gte 1 or $farm.build is "coop 1">>
			<<link [[추가 확장|Farm Upgrades Coop 2]]>><</link>>
		<<else>>
			<<link [[확장|Farm Upgrades Coop 1]]>><</link>>
		<</if>>
		<br>
		농장 관개 시설:
		<<if $farm.irrigation gte 9>>
			<span class="green">모든 밭에 관개 시설이 설치됨</span>
			<<set _upgrade_count += 1>>
		<<elseif $farm.irrigation is $plots.farm.length>>
			<span class="green">현재 모든 밭에 관개 시설이 설치됨</span>
		<<else>>
			<<link [[밭 관개 시설을 짓는다|Farm Upgrades Irrigation]]>><</link>>
		<</if>>
		<br>
		<<if ($sexStats.anus.pregnancy.motherStatus gte 1 or $sexStats.vagina.pregnancy.motherStatus gte 1) and ($farm.parasitebarn gte 1 or $farm.build is "parasites 1")>>
			기생충 헛간:
			<<if $farm.parasitebarn gte 2 or $farm.build is "parasites 2">>
				<span class="green">더할 나위 없이 거대함</span>
			<<else>>
				<<link [[확장|Farm Upgrades Parasite Barn 2]]>><</link>>
			<</if>>
			<br>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "alex_pregnancy_comment">>
	<<if playerBellyVisible()>>
		<<if !talkedAboutPregnancy("pc","Alex")>>
			<<setTalkedAboutPregnancy "pc" "Alex">>
			<<if $farm_stage gte 7>>
				알렉스가 기겁하며 당신의 배를 멍하니 응시한다. "너... 너 임신한 거야?! 왜 나한테 아무 말도 안 했어..."

				<<if getPlayerPregnancy()?.possibleDonors.length gte 2>>
					<<He>>【은는】 눈에 띄게 실망한 기색이다.
					<br><br>

					"그-그래, 몸이 좀 안 좋다 싶으면 언제든 농장 일은 쉬어도 되니까," <<he>>【이가】 얼버무리듯 덧붙인다.
					<br><br>

				<<else>>
					<br><br>
					<<He>>【은는】 마치 당신의 대답을 기다리듯 빤히 쳐다본다.

					"그나저나, 일단 오두막으로 들어갈까?" 알렉스가 당신을 안으로 이끈다.
					<br><br>

				<</if>>

			<<else>>
				<<He>>【은는】 당신의 배를 흘긋 본다. "아, 임신했구나? 일하다가 벅차면 무리하지 말고 좀 쉬어. 난 괜찮으니까," <<he>>【이가】 털털하게 말한다.
				<br><br>

			<</if>>

		<<else>>
			<<if $farm_stage gte 7 and $alex_countdown is undefined>>
				"몸이 조금이라도 안 좋으면 제발 좀 쉬어," <<he>>【이가】 말한다.
				<br><br>
			<<else>>
				<<He>>【은는】 당신의 배를 내려다본다. "몸 안 좋으면 언제든 농장 일 쉬어도 된다는 거 알지?" <<he>>【이가】 말한다.
				<br><br>

			<</if>>

		<</if>>

	<</if>>

<</widget>>

<<widget "alex_cottage_pregnancy_reveal">>

	<<npc "Alex">>

	<<if Time.betweenHours(5, 6)>>
		알렉스는 어딘가 안절부절못하며 초조해 보인다.

	<<else>>
		알렉스의 방에서 평소보다 부산스러운 소리가 들려온다. 호기심에 방 안으로 들어가 보니, <<he>>【이가】 초조한 기색으로 서성거리고 있다.

	<</if>>
	<br><br>

	당신은 <<him>>【에게】 다가간다.

	<<if $speech_attitude is "meek">>
		"ㅁ-무슨 일 있어? 걱정돼서 그래..." 당신이 묻는다.
	<<elseif $speech_attitude is "bratty">>
		"무슨 일인데 그래? 너답지 않게 왜 이래?" 당신이 묻는다.
	<<else>>
		"괜찮아? 평소 모습이랑 다른데," 당신이 묻는다.
	<</if>>
	<br><br>

	<<He>>【은는】 돌아보며 초조함을 감추려는 듯 씩 웃어 보인다.

	<<if pregnancyCountBetweenParents("Alex", "pc") lte 0 or pregnancyCountBetweenParents("pc", "Alex") lte 0>>
		"미안, 이런 상황엔 어떻게 굴어야 할지 영 감이 안 잡혀서. 일단 앉을래?" 당신은 고개를 끄덕인다.

	<<else>>
		"참 우습지, 두 번째엔 좀 더 익숙해질 줄 알았는데 말이야. 일단 앉을래?" 당신은 고개를 끄덕인다.

	<</if>>
	<br><br>

	<<link [[다음|Farm Alex Pregnancy Reveal]]>><<endevent>><</link>>

<</widget>>

<<widget "pcPregnancyRevealToAlex">>
<<if !$npc.includes("Alex")>>
	<<npc "Alex">><<person1>>
<</if>>
	<<if talkedAboutPregnancy("pc","Alex")>>
		<<if C.npc.Alex.pregnancy.pcKnowledge isnot true>>
			<<if getActivePregnancies("pc").some(p => p.donor === "Alex" && p.possibleDonors.length === 1)>>
				<span class="blue">어쩌면 알렉스에게 <<he>>【이가】 아이 아빠라는 사실을 말하기 좋은 기회일지도 모른다.</span>
				<br>

				<<link [[알렉스에게 <<he>>【이가】 아이 아빠라고 말한다|Farm PC Pregnancy Reveal]]>><</link>>

				<<if $passage is "Farm Rest" or $passage is "Farm Rest Refuse">>
					<<if $farm_work.alex_relax lt 3>>
						<br>
