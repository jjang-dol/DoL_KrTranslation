	<</if>>

	<<if $alex_countdown is undefined>>
		<<couchicon>><<link [[알렉스를 껴안는다 (0:20)|Farm Breakfast Cuddle]]>><<npcincr Alex love 1>><<pass 20>><</link>><<glove>>
		<br>
		<<farmicon "tv">><<link [[알렉스와 TV【을를】 본다 (0:20)|Farm Breakfast TV]]>><<stress -2>><<pass 20>><</link>><<lstress>>
		<br>
	<<else>>
		<<farmicon "tv">><<link [[알렉스와 TV【을를】 본다 (0:20)|Farm Breakfast TV]]>><<stress -2>><<pass 20>><</link>><<lstress>>
		<br>
	<</if>>
	<br>
<</widget>>

<<widget "destination_farm">>
