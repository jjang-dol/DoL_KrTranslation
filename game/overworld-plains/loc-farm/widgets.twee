:: Farm Widgets [widget]
<<widget "destinationfarmroad">>
	<<if $bus is "farmroad1">>
		<<link [[다음|Farm Road 1]]>><<endevent>><<set $eventskip to 1>><</link>>
	<<elseif $bus is "farmroad2">>
		<<link [[다음|Farm Road 2]]>><<endevent>><<set $eventskip to 1>><</link>>
	<<elseif $bus is "farmroad3">>
		<<link [[다음|Farm Road 3]]>><<endevent>><<set $eventskip to 1>><</link>>
	<<elseif $bus is "farmroad4">>
		<<link [[다음|Farm Road 4]]>><<endevent>><<set $eventskip to 1>><</link>>
	<<elseif $bus is "farmroad5">>
		<<link [[다음|Farm Road 5]]>><<endevent>><<set $eventskip to 1>><</link>>
	<<else>>
		<<link [[다음|Farm Road 6]]>><<endevent>><<set $eventskip to 1>><</link>>
	<</if>>
<</widget>>

<<widget "fox_gen">>
	<!-- Modified for monster people -->
	<<if ($settings.monsterChance gte 1 and $hallucinations gte 1) or ($settings.monsterChance gte 1 and !$settings.monsterHallucinationsOnly)>>
		<<if maleChance() lt random(1, 100)>>
			<<set $foxGen to "female">>
		<<else>>
			<<set $foxGen to "male">>
		<</if>>
	<<else>>
		<<if beastMaleChance() lt random(1, 100)>>
			<<set $foxGen to "vixen">>
		<<else>>
			<<set $foxGen to "reynard">>
		<</if>>
	<</if>>
<</widget>>

<<widget "fox_text">>
	<<if $foxGen is "male">>
		<<set _text_output to "여우 소년">>
	<<elseif $foxGen is "female">>
		<<set _text_output to "여우 소녀">>
	<<elseif $foxGen is "vixen">>
		<<set _text_output to "암여우">>
	<<elseif $foxGen is "reynard">>
		<<set _text_output to "여우">>
	<</if>>
	<<print _text_output>>
<</widget>>

<<widget "farm_work_time">>
	<!-- Math.trunc means any time from 6:00 AM to 6:19 AM will be set to "1".
		It seems this is coded so that farm work only officially begins when 1 <= _farm_work_time <= 45  -->
	<<set _farm_work_time to Math.trunc(((Time.hour * 60) / 20) - 17)>>
	<<if _farm_work_time gte 46 or _args[0] is "midnight">>
		<<set _farm_work_time to 46>>
	<</if>>
<</widget>>

<<widget "farm_milk_check">>
	<<farm_work_time>>
	<<if _farm_work_time gte 30>>
		<<set $farm_work.cattle_need to (18 - $farm_work.cattle_milked)>>
	<<elseif _farm_work_time gte 10>>
		<<set $farm_work.cattle_need to (12 - $farm_work.cattle_milked)>>
	<<else>>
		<<set $farm_work.cattle_need to (6 - $farm_work.cattle_milked)>>
	<</if>>
<</widget>>

<<widget "farm_work_update">>
	<<alexclamp>>
	<<farm_work_time _args[0]>>

	<<if _args[0] is "midnight" and $farm_work>>
		<<if $farm_work.recent_shift gte 660>>
			<<if _disableFarmWorkFeat>>
				<<run $timeMessages.pushUnique("dawnToDusk")>>
			<<else>>
				<<earnFeat "Dawn to Dusk">>
			<</if>>
		<</if>>
	<</if>>

	<<if $farm_work is undefined>>
		<<set $farm_work to {}>>
		<<set $farm_work.time to 0>>
		<<set $farm_work.shower to 0>>
		<<set $farm_work.border to 0>>
		<<set $farm_work.yard to 0>>
		<<set $farm_work.chickens_fed to 0>>
		<<set $farm_work.chickens_out to 0>>
		<<set $farm_work.pigs_fed to 0>>
		<<set $farm_work.pigs_out to 0>>
		<<set $farm_work.horses_brushed to 0>>
		<<set $farm_work.horses_out to 0>>
		<<set $farm_work.horses_satisfied to 0>>
		<<set $farm_work.cattle_out to 0>>
		<<set $farm_work.cattle_milked to 0>>
		<<set $farm_work.cattle_need to 0>>
		<<set $farm_work.dogs_fed to 0>>
		<<set $farm_work.alex_relax to 0>>
		<<set $farm_work.still to 0>>
		<<set $farm_work.tending to 0>>
		<<set $farm_work.hay to 0>>
		<<set $farm_work.admin to 0>>
		<<if $farm>>
			<<if $farm.woodland>>
				<<set $farm_work.woodland to 0>>
				<<set $farm_work.forage to 0>>
			<</if>>
		<</if>>
		<<set $farm_work.event_time to random(60, 300)>>
		<<set $farm_work.recent_shift to 0>>
		<<if $farm_stage gte 5>>
			<<set $farm_work.fence_damage to 0>>
			<<farm_fence_damage 6>>
		<<else>>
			<<if random(1, 3) is 3>>
				<<set $farm_work.fence_damage to random(0, 6)>>
			<</if>>
		<</if>>

		<<set $farm_work.dog to {}>>
		<<set $farm_work.pig to {}>>
		<<set $farm_work.horse to {}>>
		<<set $farm_work.cattle to {}>>
			<!-- Modified for monster people -->
		<<set $farm_work.horse.monster_roll to false>>
		<<set $farm_work.pig.monster_roll to false>>
		<<set $farm_work.dog.monster_roll to false>>
		<<set $farm_work.cattle.monster_roll to false>>
		<<if $hallucinations gte 1 or !$settings.monsterHallucinationsOnly>>
			<<set $farm_work.horse.monster_roll to $settings.monsterChance gte random(1, 100)>>
			<<set $farm_work.pig.monster_roll to $settings.monsterChance gte random(1, 100)>>
			<<set $farm_work.dog.monster_roll to $settings.monsterChance gte random(1, 100)>>
			<<set $farm_work.cattle.monster_roll to $settings.monsterChance gte random(1, 100)>>
		<</if>>
		<<unset $farm_kennel>>
		<<farm_gen_all>>
	<</if>>
	<<set _farm_alex_actions to _farm_work_time - $farm_work.time>>

	<<for _i = 0; _i < _farm_alex_actions; _i++>>
		<<if $farm_work.chickens_panic gte 1>>
			<<set $farm_work.chickens_panic to 0>>
			<<set $farm_work.alex to "chickens_panic">>
			<<continue>>
		<</if>>
		<<if $farm_work.pigs_panic gte 1>>
			<<set $farm_work.pigs_panic to 0>>
			<<set $farm_work.alex to "pigs_panic">>
			<<continue>>
		<</if>>
		<<if $farm_work.horses_panic gte 1>>
			<<set $farm_work.horses_panic to 0>>
			<<set $farm_work.alex to "horses_panic">>
			<<continue>>
		<</if>>
		<<if $farm_work.cattle_panic gte 1>>
			<<set $farm_work.cattle_panic to 0>>
			<<set $farm_work.alex to "cattle_panic">>
			<<continue>>
		<</if>>
		<<if $farm_work.dogs_panic gte 1>>
			<<set $farm_work.dogs_panic to 0>>
			<<set $farm_work.alex to "dogs_panic">>
			<<continue>>
		<</if>>
		<<if $farm_work.shower lt 1>>
			<<set $farm_work.shower to 1>>
			<<set $farm_work.alex to "shower">>
			<<continue>>
		<</if>>
		<<if $farm_work.border lt 1>>
			<<set $farm_work.border to 1>>
			<<set $farm_work.alex to "border">>
			<<continue>>
		<</if>>
		<<if $farm_work.yard lt 1>>
			<<set $farm_work.yard to 1>>
			<<set $farm_work.alex to "yard">>
			<<continue>>
		<</if>>
		<<if $farm_work.chickens_fed lt 1>>
			<<set $farm_work.chickens_fed to 1>>
			<<set $farm_work.alex to "chickens_fed">>
			<<continue>>
		<</if>>
		<<if $farm_work.chickens_out lt 1>>
			<<set $farm_work.chickens_out to 1>>
			<<set $farm_work.alex to "chickens_out">>
			<<continue>>
		<<elseif $farm_work.chickens_out lt 2 and _farm_work_time gte 40>>
			<<set $farm_work.chickens_out to 2>>
			<<set $farm_work.alex to "chickens_in">>
			<<continue>>
		<</if>>
		<<if $farm_work.pigs_out lt 1>>
			<<set $farm_work.pigs_out to 1>>
			<<set $farm_work.alex to "pigs_out">>
			<<continue>>
		<<elseif $farm_work.pigs_out lt 2 and _farm_work_time gte 40>>
			<<set $farm_work.pigs_out to 2>>
			<<set $farm_work.alex to "pigs_in">>
			<<continue>>
		<</if>>
		<<if $farm_work.horses_out lt 1>>
			<<set $farm_work.horses_out to 1>>
			<<set $farm_work.alex to "horses_out">>
			<<continue>>
		<<elseif $farm_work.horses_out lt 2 and _farm_work_time gte 40>>
			<<set $farm_work.horses_out to 2>>
			<<set $farm_work.alex to "horses_in">>
			<<continue>>
		<</if>>
		<<if $farm_work.cattle_out lt 1>>
			<<set $farm_work.cattle_out to 1>>
			<<set $farm_work.alex to "cattle_out">>
			<<continue>>
		<<elseif $farm_work.cattle_out lt 2 and _farm_work_time gte 40>>
			<<set $farm_work.cattle_out to 2>>
			<<set $farm_work.alex to "cattle_in">>
			<<continue>>
		<</if>>
		<<if $farm_work.fence_damage gte 1>>
			<<set $farm_work.fence_damage -= 1>>
			<<set $farm_work.alex to "fence_damage">>
			<<continue>>
		<</if>>
		<<if $farm_work.hay lt 6>>
			<<set $farm_work.hay += 1>>
			<<set $farm_work.alex to "hay">>
			<<continue>>
		<</if>>
		<<if $farm>>
			<<if $farm.woodland>>
				<<if $farm_work.woodland lt $farm.woodland>>
					<<set $farm_work.woodland += 1>>
					<<set $farm_work.alex to "woodland">>
					<<continue>>
				<</if>>
			<</if>>
		<</if>>
		<<if $farm_work.cattle_milked lt 6>>
			<<set $farm_work.cattle_milked += 6>>
			<<set $farm_work.alex to "cattle_milked">>
			<<continue>>
		<<elseif $farm_work.cattle_milked lt 12 and _farm_work_time gte 16>>
			<<set $farm_work.cattle_milked += 6>>
			<<set $farm_work.alex to "cattle_milked">>
			<<continue>>
		<<elseif $farm_work.cattle_milked lt 18 and _farm_work_time gte 36>>
			<<set $farm_work.cattle_milked += 6>>
			<<set $farm_work.alex to "cattle_milked">>
			<<continue>>
		<</if>>
		<<farm_milk_check>>
		<<if $farm_work.chicken_eggs lt 1 and _farm_work_time gte 26>>
			<<set $farm_work.chicken_eggs to 1>>
			<<set $farm_work.alex to "chicken_eggs">>
			<<continue>>
		<</if>>
		<<if $farm_work.dogs_fed lt 1 or (_farm_work_time gte 40 and $farm_work.dogs_fed lt 2)>>
			<<set $farm_work.dogs_fed += 1>>
			<<set $farm_work.alex to "dogs_fed">>
			<<continue>>
		<</if>>
		<<if $farm_work.pigs_fed lt 6>>
			<<set $farm_work.pigs_fed += 1>>
			<<set $farm_work.alex to "pigs_fed">>
			<<continue>>
		<</if>>
		<<if $farm_work.horses_brushed lt 6>>
			<<set $farm_work.horses_brushed += 6>>
			<<set $farm_work.alex to "horses_brushed">>
			<<continue>>
		<</if>>
		<<if $farm_work.alex_relax lt 3 and _farm_work_time gte 16>>
			<<set $farm_work.alex_relax += 1>>
			<<set $farm_work.alex to "relax">>
			<<continue>>
		<</if>>
		<<if $farm_work.still lt 3>>
			<<set $farm_work.still += 1>>
			<<set $farm_work.alex to "still">>
			<<continue>>
		<</if>>
		<<if $farm_stage gte 7>>
			/*The PC handles the fields from this point.*/
		<<elseif $farm_stage gte 6>>
			<<if $farm_work.tending lt 18>>
				<<set $farm_work.tending += 1>>
				<<set $farm_work.alex to "tending">>
				<<continue>>
			<</if>>
		<<elseif $farm_stage gte 5>>
			<<if $farm_work.tending lt 14>>
				<<set $farm_work.tending += 1>>
				<<set $farm_work.alex to "tending">>
				<<continue>>
			<</if>>
		<<elseif $farm_stage gte 4>>
			<<if $farm_work.tending lt 10>>
				<<set $farm_work.tending += 1>>
				<<set $farm_work.alex to "tending">>
				<<continue>>
			<</if>>
		<<else>>
			<<if $farm_work.tending lt 6>>
				<<set $farm_work.tending += 1>>
				<<set $farm_work.alex to "tending">>
				<<continue>>
			<</if>>
		<</if>>
		<<if $farm_work.admin lt 6 or $farm_stage is 12>>
			<<set $farm_work.admin += 1>>
			<<set $farm_work.alex to "admin">>
			<<continue>>
		<</if>>

		<<set $farm.clearing -= 1>>
		<<set $farm_work.alex to "clearing">>
	<</for>>


	<<if _farm_work_time gte 0 or _args[0] is "midnight">>
		<<set $farm_work.time to _farm_work_time>>
	<</if>>
<</widget>>

<<widget "farm_alex">>
	<span class="lblue">
		<<switch $farm_work.alex>>
			<<case "shower">>
				농장 저택 옆 헛간에서 물이 흐르는 소리가 들린다. 알렉스가 샤워를 하고 있다.
			<<case "border">>
				알렉스가 농장 경계를 따라 돌며, 벽과 울타리에 손상된 곳이 없는지 확인하고 있다.
			<<case "yard">>
				<<if Weather.isSnow>>
					알렉스가 마당에 쌓인 눈을 치우고 있다.
				<<else>>
					알렉스가 마당에 떨어진 낙엽을 치우고 있다.
				<</if>>
			<<case "chickens_fed">>
				알렉스가 닭들에게 먹이를 주고 있다.
			<<case "chickens_out">>
				알렉스가 마당에 닭들을 내보낸 뒤, 닭장을 청소하고 있다.
			<<case "chickens_in">>
				알렉스가 닭들을 다시 닭장으로 몰아넣고 있다.
			<<case "pigs_out">>
				알렉스가 <<farm_text_many pig>>【을를】 야외 우리로 내보낸 뒤, 돼지우리를 청소하고 있다.
			<<case "pigs_in">>
				알렉스가 <<farm_text_many pig>>【을를】 다시 돼지우리로 몰아넣고 있다.
			<<case "horses_out">>
				알렉스가 <<farm_text_many horse>>【을를】 목초지로 이끌고 있다.
			<<case "horses_in">>
				알렉스가 <<farm_text_many horse>>【을를】 다시 마구간으로 몰아넣고 있다.
			<<case "cattle_out">>
				알렉스가 <<farm_text_many cattle>>【을를】 목초지로 내보낸 뒤, 외양간을 청소하고 있다.
			<<case "cattle_in">>
				알렉스가 <<farm_text_many cattle>>【을를】 다시 외양간으로 몰아넣고 있다.
			<<case "cattle_milked">>
				알렉스가 <<farm_text_many cattle>>에게 착유기를 부착하고 있다.
			<<case "chicken_eggs">>
				알렉스가 달걀을 줍고 있다.
			<<case "pigs_fed">>
				알렉스가 돼지 사료가 가득 찬 무거운 양동이를 들고 마당을 가로지르고 있다.
			<<case "horses_brushed">>
				알렉스가 말들을 빗질해주고 있다.
			<<case "relax">>
				알렉스가 나무 아래에서 쉬고 있다.
			<<case "still">>
				<<if $farm_stage gte 9>>
					알렉스가 연구실에서 작업하고 있다.
				<<else>>
					알렉스가 오래된 돌 건물 안으로 사라졌다. 문은 잠겨 있다.
				<</if>>
			<<case "tending">>
				알렉스가 농작물을 돌보고 있다.
			<<case "clearing">>
				<<if $farm_stage is 12>>
					알렉스가 농장 저택 윗층 창가에 기대어 전화 통화를 하고 있다.
				<<else>>
					알렉스가 오래된 밭을 뒤덮은 잡초들과 사투를 벌이고 있다.
				<</if>>
			<<case "chickens_panic">>
				알렉스가 닭들을 진정시키고 있다.
			<<case "pigs_panic">>
				알렉스가 <<farm_text_many pig>>【와과】 씨름하며 진정시키려 애쓰고 있다.
			<<case "horses_panic">>
				알렉스가 <<farm_text_many horse>>【을를】 달래고 있다.
			<<case "cattle_panic">>
				알렉스가 <<farm_text_many cattle>>【을를】 진정시키고 있다.
			<<case "dogs_panic">>
				알렉스가 <<farm_text_many dog>>【을를】 쓰다듬고 있다.
			<<case "panic">>
				알렉스가 동물들을 진정시키기 위해 바쁘게 뛰어다니고 있다.
			<<case "fence_damage">>
				알렉스가 울타리를 수리하고 있다.
			<<case "dogs_fed">>
				알렉스가 <<farm_text_many dog>>에게 먹이를 주고 있다.
			<<case "hay">>
				<<if Time.season is "winter">>
					알렉스가 건물들에 서리로 인한 피해가 없는지 확인하고 있다.
				<<elseif Time.season is "spring">>
					알렉스가 건초 밭을 관리하고 있다.
				<<else>>
					알렉스가 건초를 모으고 있다.
				<</if>>
			<<case "woodland">>
				알렉스가 숲에서 일하고 있다.
			<<case "admin">>
				알렉스가 농장 저택 윗층 창가에 기대어 전화 통화를 하고 있다.
		<</switch>>
	</span>
	<br><br>
<</widget>>

<<widget "farm_status">>
	<span class="purple">
		<<if $farm_work.border lt 1>>
			누군가 침입의 흔적이나 다른 피해가 없는지 경계를 살펴야 한다.
			<br>
		<<elseif $farm_work.fence_damage gte 10>>
			<span class="red">주변 방벽의 수리가 시급하다.</span>
			<br>
		<<elseif $farm_work.fence_damage gte 5>>
			<span class="pink">주변 방벽의 수리가 시급하다.</span>
			<br>
		<<elseif $farm_work.fence_damage gte 1>>
			<span class="purple">주변 방벽의 수리가 필요하다.</span>
			<br>
		<</if>>
		<<if $farm_work.yard lt 1>>
			<<if Weather.isSnow>>
				마당이 눈으로 뒤덮여 있다.
			<<else>>
				마당이 낙엽으로 뒤덮여 있다.
			<</if>>
			<br>
		<</if>>
		<<if $farm_work.chickens_panic gte 1>>
			<span class="pink">닭들이 신경을 긁는 합창으로 꼬꼬댁거린다.</span>
			<br>
		<<elseif $farm_work.chickens_out lt 1>>
			닭들이 닭장 끄트머리에 모여, 밖으로 나가고 싶어서 꼬꼬댁거린다.
			<br>
		<<elseif $farm_work.chickens_fed lt 1>>
			배고픈 닭들이 마당을 건너는 당신을 졸졸 따라다닌다.
			<br>
		<<elseif $farm_work.chickens_out lt 2 and _farm_work_time gte 36>>
			닭들이 짙어지는 그림자를 피한다.
			<br>
		<</if>>
		<<if $farm_work.pigs_panic gte 1>>
			<span class="pink"><<farm_text_many pig>>【이가】 미친 듯이 꽥꽥거린다. 녀석들은 땅을 파고 밖으로 빠져나가려 하고 있다.</span>
			<br>
		<<elseif $farm_work.pigs_out lt 1>>
			<<farm_text_many pig>>【이가】 불안해 보인다.
			<br>
		<<elseif $farm_work.pigs_fed lt 1>>
			<<farm_text_many pig>>【이가】 진흙탕을 뒤적이며 남은 음식물 쓰레기를 찾는다.
			<br>
		<<elseif $farm_work.pigs_fed lt 6>>
			<<farm_text_many pig>>에게 약간의 먹이는 있지만, 녀석들의 식욕을 채우기에는 역부족이다.
			<br>
		<<elseif $farm_work.pigs_out lt 2 and _farm_work_time gte 36>>
			<<farm_text_many pig>>【이가】 온기를 나누려 바짝 모여 옹송그리고 있다.
			<br>
		<</if>>
		<<if $farm_work.horses_panic gte 1>>
			<<if $farm_work.horses_out lt 1 or $farm_work.horses_out gte 3>>
				<span class="pink"><<farm_text_many horse>>【이가】 패닉에 빠져 울음소리를 내며 밭 주변을 내달린다.</span>
			<<else>>
				<span class="pink"><<farm_text_many horse>>【이가】 빠져나가려 마구간 문에 몸 부딪친다.</span>
			<</if>>
			<br>
		<<elseif $farm_work.horses_out lt 1>>
			<<if $farm_work.horse.monster is true>>
				켄타우로스들이 당신에게 밖으로 내보내 달라고 소리친다.
				<br>
			<<else>>
				말들이 마구간을 서성인다.
				<br>
			<</if>>
		<<elseif $farm_work.horses_brushed lt 1>>
			<<if $farm_work.horse.monster is true>>
				켄타우로스들에게 빗질을 해 주어야 한다.
				<br>
			<<else>>
				말들에게 빗질을 해 주어야 한다.
				<br>
			<</if>>
		<<elseif $farm_work.horses_brushed lt 2>>
			<<if $farm_work.horse.monster is true>>
				켄타우로스 한 명은 빗질을 마쳤지만, 다른 이들도 손질해 주어야 한다.
				<br>
			<<else>>
				말 한 마리는 빗질을 마쳤지만, 다른 녀석들도 손질해 주어야 한다.
				<br>
			<</if>>
		<<elseif $farm_work.horses_brushed lt 6>>
			<<if $farm_work.horse.monster is true>>
				켄타우로스들에게 좀 더 빗질을 해 주어야 한다.
				<br>
			<<else>>
				말들에게 좀 더 빗질을 해 주어야 한다.
				<br>
			<</if>>
		<<elseif $farm_work.horses_out lt 2 and _farm_work_time gte 36>>
			<<if $farm_work.horse.monster is true>>
				일부 켄타우로스들은 하루 종일 지쳤는지 잔디에 누워 있다.
				<br>
			<<else>>
				일부 말들은 하루 종일 지쳤는지 잔디에 누워 있다.
				<br>
			<</if>>
		<<elseif hasSexStat("deviancy", 3) and $farm_work.horses_satisfied lt 6 and $farm_work.horses_out lt 2>>
			<<if $farm_work.horse.monster is true and $settings.horsesEnabled>>
				켄타우로스들이 초조해 보인다. 그들에게는 "특별한" 관리가 필요하다.
				<br>
			<<elseif $settings.bestialityEnabled and $settings.horsesEnabled>>
				말들이 초조해 보인다. 녀석들에게는 "특별한" 관리가 필요하다.
				<br>
			<</if>>
		<</if>>
		<<if $farm_work.cattle_panic gte 1>>
			<span class="pink"><<farm_text_many cattle>>【이가】 서성이며 몸을 떨고 있다.</span>
			<br>
		<<elseif $farm_work.cattle_out lt 1>>
			<<farm_text_many cattle>>【이가】 헛간 밖으로 나가고 싶어 애타게 울음소리를 낸다.
			<br>
		<<elseif $farm_work.cattle_milked lt 6>>
			<<farm_text_many cattle>>【이가】 불편한 듯 서성인다. 젖을 짜 주어야 한다.
			<br>
		<<elseif $farm_work.cattle_milked lt 12 and _farm_work_time gte 10>>
			<<farm_text_many cattle>>【이가】 불편한 듯 서성인다. 젖을 짜 주어야 한다.
			<br>
		<<elseif $farm_work.cattle_milked lt 18 and _farm_work_time gte 30>>
			<<farm_text_many cattle>>【이가】 불편한 듯 서성인다. 젖을 짜 주어야 한다.
			<br>
		<<elseif $farm_work.cattle_out lt 2 and _farm_work_time gte 36>>
			<<farm_text_many cattle>>【이가】 짙어지는 그림자에 겁을 먹고 헛간 주변에 옹기종기 모여든다.
			<br>
		<</if>>
		<<if $farm_work.dogs_panic gte 1>>
			<span class="pink"><<farm_text_many dog>>【이가】 하늘을 향해 하울링한다.</span>
			<br>
		<<elseif $farm_work.dogs_fed lt 1 or ($farm_work.dogs_fed lt 2 and _farm_work_time gte 36)>>
			<<farm_text_many dog>>【이가】 식사를 고대하며 밭으로 통하는 문을 뚫어지게 쳐다본다.
			<br>
		<</if>>
		<<if $farm_stage is 6 and $farm_work.tending lte 18>>
			농작물들을 가꿔야 한다.
			<br>
		<<elseif $farm_stage is 5 and $farm_work.tending lte 14>>
			농작물들을 가꿔야 한다.
			<br>
		<<elseif $farm_stage is 4 and $farm_work.tending lte 10>>
			농작물들을 가꿔야 한다.
			<br>
		<<elseif ($farm_stage is 3 or $farm_stage is 2) and $farm_work.tending lte 6>>
			농작물들을 가꿔야 한다.
			<br>
		<</if>>
		<<if $farm_work.woodland lt $farm.woodland>>
			삼림을 가꿔야 한다.
			<br>
		<</if>>
	</span>
	<br>
<</widget>>

<<widget "farm_actions">>
	<<farm_gen_all>>
	<<set _actions to 0>>
	<<if $farm_work.alex is "shower" and !$daily.farmAlexShowerSpy>>
		<<set $skulduggerydifficulty to 700>>
		<<bathroomicon "shower">><<link [[알렉스를 훔쳐본다 (0:20)|Farm Spy]]>><<pass 20>><</link>><<promiscuous1>><<skulduggerydifficulty>>
		<br>
	<</if>>
	<<if Time.hour gte 6>>
		<<if $farm_work.border lt 1>>
			<<investigateicon>><<link [[주변 울타리를 조사한다 (0:20)|Farm Border]]>><<farm_count 20>><<set $farm_work.border to 1>><<pass 20>><</link>><<run _actions++>>
			<br>
		<<elseif $farm_work.fence_damage gte 1>>
			<<if $farm_work.alex is "fence_damage">>
				<<if pcAreArmsBound("both")>>
					<span class="red">두 팔이 묶여 있기 때문에</span>, 알렉스가 울타리를 수리하는 것을 도울 수 없다.
				<<else>>
					<<choreicon "fix">><<link [[알렉스가 주변 울타리를 수리하는 것을 돕는다 (0:20)|Farm Perimeter Alex]]>><<npcincr Alex love 1>><<farm_count 20>><<set $farm_work.fence_damage -= 1>><<pass 20>><</link>><<glove>><<run _actions++>>
				<</if>>
				<br>
			<<else>>
				<<if pcAreArmsBound("both")>>
					<span class="red">두 팔이 묶여 있기 때문에</span>, 울타리를 수리할 수 없다.
				<<else>>
					<<choreicon "fix">><<link [[주변 울타리를 수리한다 (0:20)|Farm Perimeter]]>><<farm_count 20>><<set $farm_work.fence_damage -= 1>><<pass 20>><</link>><<run _actions++>>
				<</if>>
				<br>
			<</if>>
		<</if>>
	<</if>>
		<<if $farm_work.yard lt 1>>
			<<if pcAreArmsBound("both")>>
				<span class="red">두 팔이 묶여 있기 때문에</span>, 마당을 치울 수 없다.
			<<else>>
				<<farmicon "clear yard">><<link [[마당을 치운다 (0:20)|Farm Yard]]>><<farm_count 20>><<set $farm_work.yard to 1>><<pass 20>><<tiredness 2>><</link>><<gtiredness>><<run _actions++>>
			<</if>>
			<br>
		<</if>>
	<<if Time.hour gte 6>>
		<<if pcAreArmsBound("both")>>
			<span class="red">두 팔이 묶여 있기 때문에</span>, 동물을 돌보는 일을 할 수 없다.
			<br>
		<<else>>
			<<if $farm_work.chickens_panic gte 1>>
				<<animalicon "chicken">><<link [[닭들을 진정시킨다 (0:20)|Farm Chickens Calm]]>><<farm_count 20>><<pass 20>><</link>><<tendingdifficulty 1 300>><<run _actions++>>
				<br>
			<<elseif $farm_work.chickens_out lt 1>>
				<<animalicon "chicken">><<link [[닭들을 밖으로 내보낸다 (0:20)|Farm Chickens Out]]>><<farm_count 20>><<set $farm_work.chickens_out to 1>><<pass 20>><</link>><<run _actions++>>
				<br>
			<<elseif $farm_work.chickens_fed lt 1>>
				<<animalicon "chicken">><<link [[닭들에게 먹이를 준다 (0:20)|Farm Chickens Feed]]>><<farm_count 20>><<set $farm_work.chickens_fed to 1>><<pass 20>><</link>><<run _actions++>>
				<br>
			<<elseif $farm_work.chickens_out lt 2 and _farm_work_time gte 36>>
				<<animalicon "chicken">><<link [[닭들을 닭장으로 몰아넣는다 (0:20)|Farm Chickens In]]>><<farm_count 20>><<set $farm_work.chickens_out to 2>><<pass 20>><</link>><<run _actions++>>
				<br>
			<</if>>
			<<if $farm_work.pigs_panic gte 1>>
				<<animalicon "pig">><<link [[<<farm_text_many pig>>【을를】 진정시킨다 (0:20)|Farm Pigs Calm]]>><<farm_count 20>><<pass 20>><</link>><<physiquedifficulty 1 $physiquemax>><<run _actions++>>
				<br>
			<<elseif $farm_work.pigs_out lt 1>>
				<<animalicon "pig">><<link [[<<farm_text_many pig>>【을를】 밖에 내보낸다 (0:20)|Farm Pigs Out]]>><<farm_count 20>><<set $farm_work.pigs_out to 1>><<pass 20>><</link>><<run _actions++>>
				<br>
			<<elseif $farm_work.pigs_fed lt 6>>
				<<if $farm_work.alex is "pigs_fed">>
					<<animalicon "pig">><<link [[알렉스가 <<farm_text_many pig>>에게 먹이 주는 것을 돕는다 (0:20)|Farm Pigs Feed Alex]]>><<farm_count 20>><<set $farm_work.pigs_fed += 1>><<pass 20>><</link>><<run _actions++>>
					<br>
				<<else>>
					<<animalicon "pig">><<link [[<<farm_text_many pig>>에게 먹이를 준다 (0:20)|Farm Pigs Feed]]>><<farm_count 20>><<set $farm_work.pigs_fed += 1>><<tiredness 2>><</link>><<gtiredness>><<run _actions++>>
					<br>
				<</if>>
			<<elseif $farm_work.pigs_out lt 2 and _farm_work_time gte 36>>
				<<animalicon "pig">><<link [[<<farm_text_many pig>>【을를】 돼지우리로 몰아넣는다 (0:20)|Farm Pigs In]]>><<farm_count 20>><<set $farm_work.pigs_out to 2>><<pass 20>><</link>><<run _actions++>>
				<br>
			<</if>>
			<<if $farm_work.horses_panic gte 1>>
				<<animalicon "horse">><<link [[<<farm_text_many horse>>【을를】 진정시킨다 (0:20)|Farm Horses Calm]]>><<farm_count 20>><<pass 20>><</link>><<tendingdifficulty 1 1000>><<run _actions++>>
				<br>
			<<elseif $farm_work.horses_out lt 1>>
				<<if $farm_work.horse.monster is true>>
					<<animalicon "horse">><<link [[켄타우로스들을 밖으로 내보낸다 (0:20)|Farm Horses Out]]>><<farm_count 20>><<set $farm_work.horses_out to 1>><<pass 20>><</link>><<run _actions++>>
				<<else>>
					<<animalicon "horse">><<link [[말들을 밖으로 내보낸다 (0:20)|Farm Horses Out]]>><<farm_count 20>><<set $farm_work.horses_out to 1>><<pass 20>><</link>><<run _actions++>>
				<</if>>
				<br>
			<<elseif $farm_work.horses_brushed lt 6>>
				<<if $farm_work.horse.monster is true>>
					<<animalicon "horse">><<link [[켄타우로스 한 마리를 빗질한다 (0:20)|Farm Horses Brush]]>><<farm_count 20>><<set $farm_work.horses_brushed += 1>><<pass 20>><<tending 2>><<trauma -2>><</link>><<gtending>><<ltrauma>><<run _actions++>>
				<<else>>
					<<animalicon "horse">><<link [[말 한 마리를 빗질한다 (0:20)|Farm Horses Brush]]>><<farm_count 20>><<set $farm_work.horses_brushed += 1>><<pass 20>><<tending 2>><<trauma -2>><</link>><<gtending>><<ltrauma>><<run _actions++>>
				<</if>>
				<br>
			<<elseif $farm_work.horses_out lt 2 and _farm_work_time gte 36>>
				<<if $farm_work.horse.monster is true>>
					<<animalicon "horse">><<link [[켄타우로스들을 마구간으로 몰아넣는다 (0:20)|Farm Horses In]]>><<farm_count 20>><<set $farm_work.horses_out to 2>><<pass 20>><</link>><<run _actions++>>
				<<else>>
					<<animalicon "horse">><<link [[말들을 마구간으로 몰아넣는다 (0:20)|Farm Horses In]]>><<farm_count 20>><<set $farm_work.horses_out to 2>><<pass 20>><</link>><<run _actions++>>
				<</if>>
				<br>

			<<elseif hasSexStat("deviancy", 3) and $farm_work.horses_satisfied lt 6 and $farm_work.horses_out lt 2 and $settings.horsesEnabled>>
				<<if $farm_work.horse.monster is true>>
					<<animalicon "horse">><<link [[켄타우로스에게 다가간다|Farm Horses Lewd]]>><</link>><<run _actions++>>
				<<elseif $settings.bestialityEnabled>>
					<<animalicon "horse">><<link [[말에게 다가간다|Farm Horses Lewd]]>><</link>><<run _actions++>>
				<</if>>
				<br>
			<</if>>
			<<if $farm_work.cattle_panic gte 1>>
				<<animalicon "cow">><<link [[<<farm_text_many cattle>>【을를】 진정시킨다 (0:20)|Farm Cattle Calm]]>><<farm_count 20>><<pass 20>><</link>><<tendingdifficulty 1 500>><<run _actions++>>
				<br>
			<<elseif $farm_work.cattle_out lt 1>>
				<<animalicon "cow">><<link [[<<farm_text_many cattle>>【을를】 밖에 내보낸다 (0:20)|Farm Cattle Out]]>><<farm_count 20>><<set $farm_work.cattle_out to 1>><<pass 20>><</link>><<run _actions++>>
				<br>
			<<elseif $farm_work.cattle_milked lt 6>>
				<<animalicon "cow">><<link [[소들의 젖을 짠다|Farm Cattle Milk]]>><</link>><<run _actions++>>
				<br>
			<<elseif $farm_work.cattle_milked lt 12 and _farm_work_time gte 10>>
				<<animalicon "cow">><<link [[소들의 젖을 짠다|Farm Cattle Milk]]>><</link>><<run _actions++>>
				<br>
			<<elseif $farm_work.cattle_milked lt 18 and _farm_work_time gte 30>>
				<<animalicon "cow">><<link [[소들의 젖을 짠다|Farm Cattle Milk]]>><</link>><<run _actions++>>
				<br>
			<<elseif $farm_work.cattle_out lt 2 and _farm_work_time gte 36>>
				<<animalicon "cow">><<link [[<<farm_text_many cattle>>【을를】 외양간으로 몰아넣는다 (0:20)|Farm Cattle In]]>><<farm_count 20>><<pass 20>><<set $farm_work.cattle_out to 2>><</link>><<run _actions++>>
				<br>
			<</if>>
			<<if $farm_work.dogs_panic gte 1>>
				<<animalicon "dog">><<link [[<<farm_text_many dog>>【을를】 진정시킨다 (0:20)|Farm Dogs Calm]]>><<farm_count 20>><<pass 20>><</link>><<tendingdifficulty 1 700>><<run _actions++>>
				<br>
			<<elseif $farm_work.dogs_fed lt 1 or _farm_work_time gte 36 and $farm_work.dogs_fed lt 2>>
				<<animalicon "dog">><<link [[<<farm_text_many dog>>에게 먹이를 준다 (0:20)|Farm Dogs Feed]]>><<farm_count 20>><<pass 20>><<set $farm_work.dogs_fed += 1>><</link>><<run _actions++>>
				<br>
			<</if>>
		<</if>>
	<</if>>

	<<if $farm_work.alex is "relax" and ($exposed lt 2 or hasSexStat("exhibitionism", 5))>>
		<<farmicon "relax">><<link [[알렉스와 함께 쉰다 (0:20)|Farm Rest]]>><<farm_count 20>><<trauma -2>><<stress -2>><<npcincr Alex love 1>><<set $phase to 1>><<pass 20>><</link>><<glove>><<ltrauma>><<lstress>>
		<br>
	<<if $farm_stage gte 4 and $milkshake gte 2>>
		<<foodicon "milkshake">><<link [[밀크쉐이크를 건넨다 (0:20)|Alex Give Milkshake]]>><<farm_count 20>><<pass 20>><<set $milkshake -= 2>><<set $daily.alex.milkshake to true>><<npcincr Alex love 1>><<stress -5>><</link>><<glove>><<lstress>>
		<br>
	<</if>>
	<<if $farm_stage gte 7 and $alex_countdown is undefined and $milkshake gte 1>>
		<<foodicon "milkshake">><<link [[밀크쉐이크를 나눠 마신다 (0:20)|Alex Share Milkshake]]>><<farm_count 20>><<pass 20>><<set $milkshake -= 1>><<set $daily.alex.milkshake to true>><<npcincr Alex love 2>><<stress -10>><</link>><<gglove>><<lstress>>
		<br>
	<</if>>
	<</if>>
	<<if $farm_stage gte 7>>
		/*The PC tends the field in more detail via the tending system after this point.*/
	<<elseif pcAreArmsBound("both")>>
		<span class="red">두 팔이 묶여 있기 때문에</span>, 농작물을 돌볼 수 없다.
		<br>
	<<elseif $farm_stage gte 6 and $farm_work.tending lte 18>>
		<<if $farm_work.alex is "tending">>
			<<if ($exposed lt 2 or hasSexStat("exhibitionism", 5))>>
				<<gardenicon "till">><<link [[알렉스가 농작물을 돌보는 것을 돕는다 (0:20)|Farm Tending Alex]]>><<farm_count 20>><<physique 2>><<pass 20>><<tending 2>><<tiredness 2>><<set $farm_work.tending += 1>><</link>><<gtiredness>><<gtending>><<run _actions++>>
				<br>
			<</if>>
		<<else>>
			<<gardenicon "till">><<link [[농작물을 돌본다 (0:20)|Farm Tending]]>><<farm_count 20>><<physique 2>><<pass 20>><<tending 2>><<tiredness 2>><<set $farm_work.tending += 1>><</link>><<gtiredness>><<gtending>><<run _actions++>>
			<br>
		<</if>>
	<<elseif $farm_stage gte 5 and $farm_work.tending lte 14>>
		<<if $farm_work.alex is "tending">>
			<<if ($exposed lt 2 or hasSexStat("exhibitionism", 5))>>
				<<gardenicon "till">><<link [[알렉스가 농작물을 돌보는 것을 돕는다 (0:20)|Farm Tending Alex]]>><<farm_count 20>><<physique 2>><<pass 20>><<tending 2>><<tiredness 2>><<set $farm_work.tending += 1>><</link>><<gtiredness>><<gtending>><<run _actions++>>
				<br>
			<</if>>
		<<else>>
			<<gardenicon "till">><<link [[농작물을 돌본다 (0:20)|Farm Tending]]>><<farm_count 20>><<physique 2>><<pass 20>><<tending 2>><<tiredness 2>><<set $farm_work.tending += 1>><</link>><<gtiredness>><<gtending>><<run _actions++>>
			<br>
		<</if>>
	<<elseif $farm_stage gte 4 and $farm_work.tending lte 10>>
		<<if $farm_work.alex is "tending">>
			<<if ($exposed lt 2 or hasSexStat("exhibitionism", 5))>>
				<<gardenicon "till">><<link [[알렉스가 농작물을 돌보는 것을 돕는다 (0:20)|Farm Tending Alex]]>><<farm_count 20>><<physique 2>><<pass 20>><<tending 2>><<tiredness 2>><<set $farm_work.tending += 1>><</link>><<gtiredness>><<gtending>><<run _actions++>>
				<br>
			<</if>>
		<<else>>
			<<gardenicon "till">><<link [[농작물을 돌본다 (0:20)|Farm Tending]]>><<farm_count 20>><<physique 2>><<pass 20>><<tending 2>><<tiredness 2>><<set $farm_work.tending += 1>><</link>><<gtiredness>><<gtending>><<run _actions++>>
			<br>
		<</if>>
	<<elseif ($farm_stage is 3 or $farm_stage is 2) and $farm_work.tending lte 6>>
		<<if $farm_work.alex is "tending">>
			<<if ($exposed lt 2 or hasSexStat("exhibitionism", 5))>>
				<<gardenicon "till">><<link [[알렉스가 농작물을 돌보는 것을 돕는다 (0:20)|Farm Tending Alex]]>><<farm_count 20>><<physique 2>><<pass 20>><<tending 2>><<tiredness 2>><<set $farm_work.tending += 1>><</link>><<gtiredness>><<gtending>><<run _actions++>>
				<br>
			<</if>>
		<<else>>
			<<gardenicon "till">><<link [[농작물을 돌본다 (0:20)|Farm Tending]]>><<farm_count 20>><<physique 2>><<pass 20>><<tending 2>><<tiredness 2>><<set $farm_work.tending += 1>><</link>><<gtiredness>><<gtending>><<run _actions++>>
			<br>
		<</if>>
	<</if>>
	<<if $farm_stage isnot 12 and $farm_work.alex is "clearing" and ($exposed lt 2 or hasSexStat("exhibitionism", 5)) and Time.dayState isnot "night">>
		<<if pcAreArmsBound("both")>>
			<span class="red">두 팔이 묶여 있기 때문에</span>, 알렉스가 밭을 개간하는 것을 도울 수 없다.
		<<else>>
			<<farmicon "clear yard">><<link [[알렉스가 밭을 개간하는 것을 돕는다 (0:20)|Farm Clearing]]>><<farm_count 20>><<physique 2>><<pass 20>><<tiredness 2>><<set $farm.clearing -= 1>><</link>><<gtiredness>><<run _actions++>>
		<</if>>
		<br>
	<</if>>
	<<if $farm_stage isnot 12 and $farm_stage gte 7 and _actions is 0 and $farm_work.alex isnot "clearing" and ($exposed lt 2 or hasSexStat("exhibitionism", 5))>>
		<<if pcAreArmsBound("both")>>
			<span class="red">두 팔이 묶여 있기 때문에</span>, 혼자서 밭을 개간할 수 없다.
		<<else>>
			<<farmicon "clear yard">><<link [[혼자서 밭을 개간한다 (0:40)|Farm Clearing Alone]]>><<farm_count 40>><<physique 4>><<pass 40>><<tiredness 4>><<set $farm.clearing -= 1>><</link>><<ggtiredness>><<run _actions++>>
		<</if>>
		<br>
	<</if>>

	<<if (_actions lt 2 or $farm_stage lt 7) and ($farm_work.alex isnot "relax" or $exposed gte 0)>>
		<!-- as worker you can be lazy any time, but as partner you only get that luxury when there's (nearly) nothing else to do.
			also, if Alex is resting you should join them unless you're too naked for comfort -->
		<<relaxicon>><<link [[마구간 근처에서 쉰다 (0:15)|Farm Stables Rest]]>><<pass 15>><<stress -2>><</link>><<lstress>>
	<</if>>
	<br>
<</widget>>

<<widget "farm_work">>
	<<if Time.dayState isnot "night">>
		<<farm_alex>>
		<<farm_status>>
	<</if>>
	<<farm_actions>>
	<br>
<</widget>>

<<widget "fields_init">>
	<<plots_init farm 4 earth 3 large>>
<</widget>>

<<widget "farm_init">>
	<<farm_work_update>>
	<<if $farm_work.horses_out lt 1>>
		<<set $farm_work.horses_out to 1>>
	<</if>>
	<<if $farm_work.chickens_fed lt 1>>
		<<set $farm_work.chickens_fed to 1>>
	<</if>>
	<<if $farm_work.cattle_out lt 1>>
		<<set $farm_work.cattle_out to 1>>
	<</if>>
	<<if $farm_work.cattle_milked lt 6>>
		<<set $farm_work.cattle_milked to 6>>
	<</if>>
	<<set $farm to {}>>
	<<set $farm.beasts to {}>>
	<<set $farm.wage to 15>>
	<<set $farm.beasts.pigs to 0>>
	<<set $farm.beasts.horses to 0>>
	<<set $farm.beasts.cattle to 0>>
	<<set $farm.beasts.dogs to 0>>
	<<set $farm_naked_alex to 1>>
	<<set $farm.clearing to 100>>

	<<farm_update>>

	<<set $fields_damaged to []>>
<</widget>>

<<widget "farm_update">>
	<<if $farm isnot undefined>>
		<<if $farm.milking is undefined>>
			<<set $farm.milking to {
				caught: false,
				alexNightEvent: false,
				catchChance: 0,
				dayMilking: false,
			}>>
		<</if>>
		<<if $farm.milking.catchChance is NaN>>
			<<set $farm.milking.catchChance to 0>>
		<</if>>
		<<if $farm.build_finished is undefined or $farm.build_finished is 0>>
			<<set $farm.build_finished to []>>
		<</if>>
	<</if>>
<</widget>>

<<widget "farm_pigs">>
	<<if _args[0]>>
		<<set $farm.beasts.pigs += _args[0]>>
		<<set $farm.beasts.pigs = Math.clamp($farm.beasts.pigs, -30, 30)>>
	<</if>>
<</widget>>

<<widget "farm_horses">>
	<<if _args[0]>>
		<<set $farm.beasts.horses += _args[0]>>
		<<set $farm.beasts.horses = Math.clamp($farm.beasts.horses, -30, 30)>>
	<</if>>
<</widget>>

<<widget "farm_cattle">>
	<<if _args[0]>>
		<<set $farm.beasts.cattle += _args[0]>>
		<<set $farm.beasts.cattle = Math.clamp($farm.beasts.cattle, -30, 30)>>
	<</if>>
<</widget>>

<<widget "farm_dogs">>
	<<if _args[0]>>
		<<set $farm.beasts.dogs += _args[0]>>
		<<set $farm.beasts.dogs = Math.clamp($farm.beasts.dogs, -30, 30)>>
	<</if>>
<</widget>>

<<widget "farm_trust">>
	<<if _args[0] is "horses">>
		<<set $enemytrust += ($farm.beasts.horses * 3)>>
	<<elseif _args[0] is "pigs">>
		<<set $enemytrust += ($farm.beasts.pigs * 3)>>
	<<elseif _args[0] is "cattle">>
		<<set $enemytrust += ($farm.beasts.cattle * 3)>>
	<<elseif _args[0] is "dogs">>
		<<set $enemytrust += ($farm.beasts.dogs * 3)>>
	<</if>>
<</widget>>

<<widget "farm_gen">>
	<<if $farm_work[_args[0]].monster_roll is true and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly)>>
		<<set $farm_work[_args[0]].monster to true>>
		<<if beastMaleChance() gte 100>>
			<<set $farm_work[_args[0]].gender_plural to "m">>
		<<elseif beastMaleChance() gte 1>>
			<<set $farm_work[_args[0]].gender_plural to "b">>
		<<else>>
			<<set $farm_work[_args[0]].gender_plural to "f">>
		<</if>>
		<<if beastMaleChance() gte random(1, 100)>>
			<<set $farm_work[_args[0]].gender to "m">>
			<<if $settings.maleNPCVaginaChance gte random(1, 100)>>
				<<set $farm_work[_args[0]].genitals to "vagina">>
			<<else>>
				<<set $farm_work[_args[0]].genitals to "penis">>
			<</if>>
		<<else>>
			<<set $farm_work[_args[0]].gender to "f">>
			<<if $settings.femaleNPCPenisChance gte random(1, 100)>>
				<<set $farm_work[_args[0]].genitals to "penis">>
			<<else>>
				<<set $farm_work[_args[0]].genitals to "vagina">>
			<</if>>
		<</if>>
	<<else>>
		<<set $farm_work[_args[0]].monster to false>>
		<<if beastMaleChance() gte 100>>
			<<set $farm_work[_args[0]].gender_plural to "m">>
		<<elseif beastMaleChance() gte 1>>
			<<set $farm_work[_args[0]].gender_plural to "b">>
		<<else>>
			<<set $farm_work[_args[0]].gender_plural to "f">>
		<</if>>
		<<if beastMaleChance() gte random(1, 100)>>
			<<set $farm_work[_args[0]].gender to "m">>
			<<set $farm_work[_args[0]].genitals to "penis">>
		<<else>>
			<<set $farm_work[_args[0]].gender to "f">>
			<<set $farm_work[_args[0]].genitals to "vagina">>
		<</if>>
	<</if>>
<</widget>>

<<widget "farm_gen_all">>
	<<farm_gen horse>>
	<<farm_gen pig>>
	<<farm_gen dog>>
	<<farm_gen cattle>>
<</widget>>

<<widget "farm_brush">>
	<<wearProp "brush">>
	<<if currentSkillValue('tending') gte 600>>
		당신은 <<farm_his horse>> 털을 빗질한다. 손질해야 할 곳이 많지만, <span class="green"><<farm_text horse>>【이가】 정말로 어디를 빗질받고 싶어하는지 알 수 있다</span>. <<farm_He horse>>【은는】 그 손길을 즐긴다.
		<br><br>

		다른 <<farm_text horse>>【이가】 자신의 차례를 기다린다. 당신은 첫 번째 녀석의 빗질을 빠르게 끝내고, 두 번째 녀석으로 넘어간다.
		<br><br>
		<<set $farm_work.horses_brushed += 1>>
	<<else>>
		당신은 <<farm_his horse>> 털을 빗질한다. 손질해야 할 곳이 많아 꽤 오랜 시간이 걸리지만, <<farm_text horse>>【은는】 즐거워하는 것 같다.
		<br><br>
	<</if>>

	<<if dangerEvent()>>
	<!-- Modified for monster people -->
		<<if $settings.horsesEnabled and ($settings.bestialityEnabled or $farm_work.horse.monster is true)>>
			당신은 마무리를 한 뒤, 빗에 엉킨 털을 치우며 문 쪽으로 걸어간다. 등 뒤로 발굽 소리가 들려온다. <<farm_text horse>>【이가】 당신을 쫓아온 것이다.
			<br><br>

			<<if $farm_work.horse.monster is true>>
				"난 아직 안 끝났어." <<farm_he horse>>【이가】 말한다. "이리 돌아와."
			<<else>>
				그것은 화가 난 듯 당신을 향해 울음소리를 낸다.
			<</if>>
			<br><br>

			<<link [[달아난다|Farm Horses Brush Run]]>><<handheldon>><</link>><<athleticsdifficulty 1 1100>>
			<br>
			<<link [[기다린다|Farm Horses Brush Wait]]>><<handheldon>><<farm_horses -1>><<stress 6>><</link>><<gstress>><<lrespect>>
			<br>
		<<else>>
			당신이 멈추자 <<farm_text horse>>【은는】 더 바라는 듯 당신의 어깨를 살짝 문다.<<gpain>><<gstress>><<pain 4>><<stress 6>>
			<br><br>

			<<link [[다음|Farm Work]]>><<endevent>><</link>>
			<br>
		<</if>>
	<<else>>
		당신은 마무리를 하고 빗에 엉킨 털을 치운다.
		<br><br>
		<<link [[다음|Farm Work]]>><<endevent>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "farm_milk_actions">>
	<<farm_milk_check>>
	<<farm_gen cattle>>
	<<set $outside to 0>>
	<<if $farm_work.cattle_need gte 1>>
		<span class="purple">$farm_work.cattle_need</span>마리의 젖을 짜야 한다.
		<br>
	<<else>>
		<span class="teal">소들은 만족스러워한다.</span>
		<br><br>
	<</if>>

	<<if Time.hour is 21 and $farm_end is undefined and $alex_to_bed isnot 1>>
		<<set $farm_end to 1>>
		<<npc Alex>><<person1>>
		알렉스가 헛간으로 들어와, 이마의 땀을 닦으며 당신에게 다가온다. "오늘 일도 끝이네." <<he>>【이가】 말한다,
		<<if $exposed gt 0 and Time.season is "winter">>
			얼굴을 붉히며. "날이 꽤 쌀쌀해지는데, 좀 더 따뜻하게 입는 게 좋겠어." <<glust>><<npcincr Alex lust 1>>
		<<elseif $exposed gt 0>>
			얼굴을 붉히며. "날씨가 추워질 테니까, 옷을 조금 더 챙겨 입는 게 좋겠어." <<glust>><<npcincr Alex lust 1>>
		<<else>>
			미소를 지으며.
		<</if>>
		<<if $farm_count gte 1 and $farm_stage lte 6>>
			<<wearProp "cash two">>
			"여기, 덤으로 좀 챙겨줄게." <<He>>【은는】 당신에게 <<moneyGain $farm.wage>>【을를】 건넨다.
		<</if>>
		<br><br>
		"여긴 내가 닫을게." 당신이 밖으로 걸어나가자 <<he>>【이가】 말한다. <<if $farm_stage lt 7>>"조심히 들어가."<<set _exitfarm to true>><</if>>
		<br><br>

	<<elseif $farm_work.cattle_need gte 1>>
		<<beastNEWinit 1 cow>><<person1>>
		<<farmicon "milk">><<link [[기계로 젖을 짠다 (0:20)|Farm Cattle Milk Machine]]>><<pass 20>><<endevent>><<farm_count 20>><<tending 2>>
			<<if $farm_work.cattle_need gte 6>>
				<<set $farm_work.cattle_milked += 6>>
				<<set $cattle_milked += 6>>
			<<else>>
				<<set $farm_work.cattle_milked += $farm_work.cattle_need>>
				<<set $cattle_milked += $farm_work.cattle_need>>
			<</if>>
		<</link>><<gtending>>
		<br>
	<!-- Modified for monster people -->

		<<beasttype>>【이가】 괴로운 듯 울음소리를 낸다.
		<br>
		<<if currentSkillValue('tending') gte 1500>>
			<<set _cattleMilkHand to 3>>
		<<elseif currentSkillValue('tending') gte 1200>>
			<<set _cattleMilkHand to 4>>
		<<else>>
			<<set _cattleMilkHand to 5 * (6 - Math.ceil(Math.clamp(currentSkillValue('tending'), 0, 1000) / 200))>>
		<</if>>
		<<farmicon "bucket">><<link [["손으로 젖을 짠다 (0:" + String(_cattleMilkHand).padStart(2, '0') + ")"|Farm Cattle Milk Hand]]>><<farm_yield 1>><<set $cattle_milked += 1>><<set $farm_work.cattle_milked += 1>><<tending 1>><<farm_cattle 1>><<set $phase to _cattleMilkHand>><<pass _cattleMilkHand>><</link>><<deviant1>><<gfarm>><<gtending>><<grespect>>
		<br>
		<<if hasSexStat("deviancy", 4) and ($settings.bestialityEnabled or $monster is 1)>>
			<<brothelicon>><<link [[입으로 젖을 짠다 (0:03)|Farm Cattle Milk Mouth]]>><<set $cattle_milked += 1>><<set $farm_work.cattle_milked += 1>><<tending 1>><<farm_count 3>><</link>><<deviant4>><<gtending>>
			<<if $NPCList[0].penis isnot "none" and $player.virginity.oral is true>>
				<<oralvirginitywarning>>
			<</if>>
			<br>
		<</if>>

	<<elseif hasSexStat("deviancy", 2) and $farm.milking.dayMilking is true>>
		<<if $settings.breastFeedingEnabled and $milk_amount gte 1>>
			<<farmicon "milk">><<link [[스스로 젖을 짠다 (0:30)|Farm Barn Breasts]]>><<pass 30>><</link>><<deviant2>>
			<br>
		<</if>>
		<<if $player.penisExist and $semen_amount gte 1>>
			<<if playerChastity("penis")>>
				<span class="blue"><<print $worn.genitals.name>>【이가】 가로막고 있지 않았다면, 정액을 직접 짤 수 있을 것이다.</span>
				<br>
			<<else>>
				<<farmicon "milk">><<link [[스스로 정액을 짠다 (0:30)|Farm Barn Penis]]>><<pass 30>><</link>><<deviant2>>
				<br>
			<</if>>
		<</if>>
	<</if>>
	<<if _exitfarm>>
		<<link [[다음|Farmland]]>><<endevent>><</link>>
	<<else>>
		<br>
		<<getouticon>><<link [[떠난다|Farm Work]]>><<endevent>><</link>>
	<</if>>

	<br>
<</widget>>

<<widget "farm_count">>
	<<if _args[0]>>
		<<set $farm_count to ($farm_count || 0) + _args[0]>>
		<<set $farm_shift += _args[0]>>
		<<set $farm_work.recent_shift += _args[0]>>
	<</if>>
<</widget>>

<<widget "farm_aggro">>
	<<if _args[0] and $farm>>
		<<set _aggro_mod to 1>>
		<<if _args[0] gt 0>>
			<<if $farm.wall gte 1>>
				<<set _aggro_mod -= 0.05>>
			<</if>>
			<<if $farm.tower gte 2 and $farm.tower_guard>>
				<<set _aggro_mod -= 0.10>>
				<<set _aggro_mod -= (0.02 * ($farm.tower_guard_skill / 200))>>
			<<elseif $farm.tower gte 1 and $farm.tower_guard>>
				<<set _aggro_mod -= 0.05>>
				<<set _aggro_mod -= (0.02 * ($farm.tower_guard_skill / 200))>>
			<</if>>
			<<if $farm.kennel gte 1>>
				<<set _aggro_mod -= 0.10>>
			<</if>>
		<</if>>
		<<if ndef $farm.aggro>>
			<<set $farm.aggro to 0>>
		<</if>>
		<<set $farm.aggro += (_args[0] * _aggro_mod)>>
		<<set $farm.aggro = Math.clamp($farm.aggro, 0, 100)>>
		<<set $farm.aggro = Math.trunc($farm.aggro)>>
	<</if>>
<</widget>>

<<widget "farm_relax_chat">>
	<<switch random(1, 10)>>
		<<case 1>>
			<<if !$per_npc.alexs_parent1>>
				<<generate2>>
				<<saveNPC 1 "alexs_parent1">>
			<<else>>
				<<loadNPC 1 "alexs_parent1">>
			<</if>>
			알렉스는 당신과 수다를 떨다가 <<person1>><<his>> 가족에 대해 이야기한다. "형제가 12명이나 돼." <<he>>【이가】 어느 순간 말한다. "<<person2>><<Mum>>도 우리들을 어떻게 다뤄야 할지 몰라 해."<<person1>>
		<<case 2>>
			알렉스가 당신과 수다를 떨며 농장의 돼지들에 대해 이야기한다. "돼지 밥을 나르는 게 좀 힘들긴 해," <<person1>><<he>>【이가】 문득 말한다. "그래도 송로버섯을 찾아주는 걸 생각하면 그럴만한 가치가 있지."
		<<case 3>>
			알렉스가 당신과 수다를 떨며 농장의 말들에 대해 이야기한다. "대부분의 주인들은 부유한 마을 사람들이야," <<person1>><<he>>【이가】 말한다. "그 녀석들은 활동적이고 건강하게 관리받아야 하거든."
		<<case 4>>
			알렉스는 당신과 수다를 떨며 농장의 소들에 대해 이야기한다. "소들은 정말 큰 녀석들이야," <<person1>><<he>>【이가】 어느 순간 말한다. "하지만 순해. 다른 동물들도 다루기 쉬웠으면 좋겠어."
		<<case 5>>
			알렉스는 당신과 수다를 떨며 농장의 개들에 대해 이야기한다. "저 개들은 애완동물이 아니야." 어느새 <<person1>><<he>>【이가】 말한다. "기를 죽여두는 걸 두려워하지 마."
		<<case 6>>
			<<if $farm_stage gte 12>>
				알렉스가 당신과 수다를 떨며 밭에 대해 이야기한다. "우리가 아홉 개를 다 개간할 수 있을 거라고는 아무도 생각 못 했을 거야," <<person1>><<he>>【이가】 어느 순간 말한다. "숲이 빠르게 자라나고 있으니 계속 관리해야 해."
			<<else>>
				알렉스는 당신과 수다를 떨며 밭에 대해 이야기한다. "총 9개야." 어느 순간 <<person1>><<he>>【이가】 말한다. "과거형인가. 숲이 대부분을 덮어버렸거든. 하룻밤 사이에 나무가 솟아난 것 같더라니까." <<He>>【이가】 웃는다.
			<</if>>
		<<case 7>>
			알렉스는 당신과 수다를 떨며 마을 생활에 대해 묻는다. "난 소음은 별로 좋아하지 않을 것 같아," 어느 순간 <<person1>><<he>>【이가】 말한다. "적응하겠지, 아마."
		<<case 8>>
			알렉스는 당신과 수다를 떨며 학교에 대해 묻는다. "부모님이 날 가르쳐 주셨어," 어느 순간 <<person1>><<he>>【이가】 말한다. "가끔 형이나 누나들이 도와주기도 했지."
		<<case 9>>
			알렉스가 당신과 대화를 나누다 황야에 대해 이야기한다. "밤에는 거기 가지 마," <<person1>><<he>>【이가】 경고한다. "아니, 가능하다면 아예 가지 마. 사람들이 사라지곤 하거든."
		<<case 10>>
			알렉스가 당신과 수다를 떨며 바다에 대해 이야기한다. "멀리 걸어갈 필요는 없어," <<person1>><<he>>【이가】 말한다. "길을 안다면 말이야."
	<</switch>>
<</widget>>

<<widget "farm_relax_end">>
	<<farm_work_update>>
	<<if $farm_work.alex_relax lt 3>>
		<<person1>><<He>>【은는】 시계를 한 번 들여다보고는, 푹 기대어 누워 모자챙을 당겨 얼굴을 덮는다.
		<br><br>

		<<if playerIsPregnant() and playerAwareTheyArePregnant() and getActivePregnancies("pc").some(p => couldBeDonor(p, "Alex")) and (C.npc.Alex.pregnancy.pcKnowledge isnot true or C.npc.Alex.pregnancy.test is true) and C.npc.Alex.pregnancy.ultraSound isnot "requested">>
			<<pcPregnancyRevealToAlex>>

		<<else>>
			<<link [[떠난다|Farm Work]]>><<endevent>><<unset $farm_relax_drink>><</link>>
			<br>

		<</if>>

		<<link [[휴식을 취한다 (0:20)|Farm Rest]]>><<endevent>><<trauma -2>><<stress -2>><<npcincr Alex love 1>><<pass 20>><</link>><<glove>><<ltrauma>><<lstress>>
		<br>

	<<else>>
		<<person1>><<He>>【은는】 시계를 들여다보고는 한숨을 내쉰다. "다시 일하러 가봐야겠네." <<he>>【이가】 자리에서 일어서며 말한다. "같이 있어줘서 고마워."
		<br><br>

		<<if playerIsPregnant() and playerAwareTheyArePregnant() and getActivePregnancies("pc").some(p => couldBeDonor(p, "Alex")) and (C.npc.Alex.pregnancy.pcKnowledge isnot true or C.npc.Alex.pregnancy.test is true) and C.npc.Alex.pregnancy.ultraSound isnot "requested">>
			<<pcPregnancyRevealToAlex>>

		<<else>>
			<<link [[다음|Farm Work]]>><<endevent>><<unset $farm_relax_drink>><<set $farm_work.alex to "still">><</link>>
			<br>

		<</if>>


	<</if>>
<</widget>>

<<widget "eventsfarm">>
	<<if $farm.build isnot undefined and $farm.build isnot 0 and Time.hour gte 6 and random(1, 3) gte 2>>
		<<if $exposed gte 2 and $uncomfortable.nude is true or $exposed is 1 and $uncomfortable.underwear is true>>
			당신은 헛간 주위를 살핀다. 그 너머 마당은 안전해 보인다. 당신은 심호흡을 하고 공터로 달려간다.
			<br><br>

			아무도 보지 않는다고 생각하지만, 심장이 여전히 요동친다. 마당을 거의 다 건너갈 때쯤 <span class="pink">옆에서 누군가의 목소리가 들린다.</span><<gstress>><<stress 6>>
			<br><br>

			헛간으로 후퇴할 수도 있지만, 앞쪽 별장이 더 가깝다. 또 문손잡이가 막혔을 위험이 있다. 목소리를 피해 도망칠 수도 있다. 길은 도로 쪽으로 내려가 있고, 지형이 당신을 숨겨줄지도 모른다.
			<br><br>

			<<link [[별장으로 달린다|Farm Builders Exposed Cottage]]>><</link>>
			<br>
			<<link [[헛간으로 달린다|Farm Builders Exposed Shed]]>><</link>><<athleticsdifficulty 1 1100>>
			<br>
			<<link [[도로로 달린다|Farm Builders Exposed Road]]>><</link>>
			<br>
		<<else>>
			<<rng 5>>
			<<switch $rng>>
			<<case 1>>
				<<npc Alex>><<generate2>><<generate3>><<generate4>><<person2>>
				<<if $player.breastsize gte 3 and random(1, 2) is 2>>
					"가슴 예쁜데," <<personssimple>>【이가】 말한다.
				<<elseif $player.bottomsize gte 3 and random(1, 2) is 2>>
					"엉덩이 좋은데," <<personssimple>>【이가】 말한다.
				<<else>>
					늑대 휘파람 소리가 들린다.
				<</if>>
				당신은 고개를 돌려 범인을 본다. 건축업자 중 한 명인 <<person>>【이】다. <<He>>【은는】 <<his>> 연장을 들고 거만하게 마당을 가로지른다. 두 명의 친구들이 <<him>>【을를】 둘러싸고 있다. <<He>>【은는】 당신을 보며 씩 웃는다.
				<br><br>
				<<person1>>
				<<link [[무시한다|Farm Work]]>><<stress 6>><<endevent>><</link>><<gstress>>
				<br>
				<<link [[거드름 피운다|Farm Builders Strut]]>><</link>><<exhibitionist1>>
				<br>
				<<link [[화낸다|Farm Builders Angry]]>><<def 1>><</link>>
				<br>
				<<if displayDefiantOption(500)>>
					<<link [[위협한다|Farm Builders Threaten]]>><<trauma -6>><<wolfDefiant 500>><<def 1>><</link>><<ltrauma>><<defianttext 500>>
					<br>
				<</if>>
			<<case 2>>
				<<generate1>><<generate2>><<generate3>>
				몇몇 건축업자들, 즉 <<fullGroup>>【이가】 앉아서
				<<if Weather.precipitation is "snow">>
					별장 현관에서 휴식을 취하며 눈을 피하고 있다.
				<<elseif Weather.precipitation is "rain">>
					별장 현관에서 휴식을 취하며 비를 피하고 있다.
				<<else>>
					헛간 옆에서 휴식을 취하며 차를 마시고 있다.
				<</if>>
				<br><br>

				그들은 당신이 지나갈 때 고개를 끄덕인다.
				<br><br>
				<<link [[격려한다 (0:15)|Farm Builders Encourage]]>><<pass 15>><</link>><<note "건설 속도를 높일 확률이 낮음" "green">>
				<br>
				<<link [[그저 마주 고개를 끄덕인다|Farm Work]]>><<endevent>><</link>>
				<br>

			<<case 3>>
				<<generate1>><<person1>>
				건축업자 중 한 명인 <<person>>【이가】 당신을 부른다. "자기야, 우리 차 한 잔 갖다 줄 수 있어?"
				<br><br>

				<<link [[차를 탄다 (0:05)|Farm Builders Tea]]>><</link>>
				<br>
				<<link [[차를 타고 대화를 나눈다 (0:20)|Farm Builders Tea Chat]]>><<pass 20>><</link>>
				<br>
				<<link [[화낸다|Farm Builders Tea Angry]]>><<trauma -6>><</link>><<ltrauma>>
				<br>
				<<link [[무시한다|Farm Work]]>><<endevent>><</link>>
				<br>
			<<case 4>>
				<<generate1>><<generate2>><<generate3>><<person1>>
				건축업자들이 마당 가로질러 자재를 나르고 있다.
				<br><br>

				<<link [[돕는다 (1:00)|Farm Builders Help]]>><<pass 60>><</link>><<physiquedifficulty 1 15000>><<note "성공하면 건설 속도를 높일 수 있음" "green">>
				<br>
				<<link [[무시한다|Farm Work]]>><<endevent>><</link>>
				<br>
			<<default>>
				<<generate1>><<person1>>
				<<if $worn.over_lower.name is "naked" and setup.clothes.lower[clothesIndex('lower', $worn.lower)].skirt is 1>>
					건축업자 중 한 명인 <<person>>【이가】 당신이 지나갈 때 당신의 치마를 걷어 올린다.<<gstress>><<stress 6>>
					<br><br>

					<<if $worn.under_lower.name is "naked">>
						"<<panties>>【을를】 안 입었네," <<he>>【이가】 말한다. "나쁜 <<girl>> 같으니."<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
						<br><br>
					<</if>>
					<<link [[무시한다|Farm Work]]>><<endevent>><<stress 6>><</link>><<gstress>>
					<br>
					<<link [[화낸다|Farm Builders Skirt Angry]]>><<trauma -6>><<def 1>><</link>><<ltrauma>>
					<br>
					<<if $worn.under_lower.name is "naked">>
						<<if hasSexStat("exhibitionism", 4)>>
							<<link [[자랑한다|Farm Builders Skirt Flaunt]]>><<set $phase to 1>><</link>><<exhibitionist4>>
							<br>
						<</if>>
					<<else>>
						<<if hasSexStat("exhibitionism", 2)>>
							<<link [[자랑한다|Farm Builders Skirt Flaunt]]>><<set $phase to 0>><</link>><<exhibitionist2>>
							<br>
						<</if>>
					<</if>>
				<<else>>
					건축업자 중 한 명인 <<person>>【이가】 당신이 지나갈 때 당신의 <<bottom>>【을를】 움켜쥔다.<<gstress>><<stress 6>><<gtrauma>><<trauma 6>>
					<br><br>

					<<link [[무시한다|Farm Work]]>><<endevent>><<stress 6>><</link>><<gstress>>
					<br>
					<<link [[화낸다|Farm Builders Skirt Angry]]>><<def 1>><<trauma -6>><</link>><<ltrauma>>
					<br>
					<<link [[유혹한다|Farm Builders Bottom Flirt]]>><</link>><<promiscuous1>>
					<br>

				<</if>>
			<</switch>>
		<</if>>
	<<else>>
		<<rng 11>>
		<<switch $rng>>
			<<case 1>>
				새된 소리가 공기를 찢는다. 황야에서 난 소리이며, <span class="pink">그 소리에 동물들이 공황 상태에 빠져 날뛴다.</span><<llfarm>><<farm_yield -5>>
				<br><br>

				알렉스가 마당을 가로질러 뛰어와 동물들을 진정시키려 애쓴다.
				<<set $farm_work.alex to "panic">>
				<br><br>

				<<link [[다음|Farm Work]]>><</link>>
				<br>
				<<set $farm_work.horses_panic to 1>>
				<<set $farm_work.chickens_panic to 1>>
				<<set $farm_work.pigs_panic to 1>>
				<<set $farm_work.dogs_panic to 1>>
				<<set $farm_work.cattle_panic to 1>>
			<<case 2>>
				<<npc Alex>><<person1>><<generate2>><<person2>>
				<<if $farm_work.horses_out lt 1 or $farm_work.horses_out gte 3>>
					알렉스가 어떤 <<person2>><<person>>【와과】 서서 말들이 들판에서 달리는 것을 지켜본다.
				<<else>>
					알렉스가 어떤 <<person2>><<person>>【와과】 마구간 옆에 서 있다.
				<</if>>
				<br><br>

			<<person2>><<person>>【이가】 당신을 쳐다본다. "이쪽이 네 농장 일꾼 중 하나인가 보군," <<he>>【이가】 말한다.
			<br>
			<<person1>>
			"<<print $farm_stage gte 7 ? "사실 공동 소유주야," : "맞아,">>" 알렉스가 대답한다.
			<<if $exposed gte 1>>
				<<He>>【은는】 당신을 바라보다가, 옷차림을 보고는 시선을 돌린다. "저, 저희 고객 중 한 분이야," <<he>>【이가】 <<person2>><<person>>【을를】 가리키며 말하고, 그 사람은 턱을 쓰다듬으며 당신의 몸을 훑어본다. <<covered>>
			<<else>>
				<<He>>【은는】 당신을 바라보다가, <<person2>><<person>>【을를】 가리킨다. "우리 고객 중 한 분이야. 우리가 저분 승용마를 돌봐드리고 있어."
			<</if>>
			<br><br>

				<<if $farm_work.horse.monster is true>>
					<<if $farm_work.horse.gender is "f">>
						문제의 애마는 가슴 아래로 팔을 꼰 채 지켜보는 켄타우로스다.
					<<else>>
						문제의 애마는 팔을 꼰 채 지켜보는 켄타우로스다.
					<</if>>
					<<if $farm.beasts.horses gte 5>>
						<<farm_He horse>>【이가】 당신을 향해 돌아서서 존경의 의미로 고개를 끄덕인다.
					<<elseif $farm.beasts.horses lte -5>>
						<<farm_He horse>>【이가】 당신을 향해 돌아서서 조롱하듯 웃는다.
					<</if>>
				<<else>>
					<<if $farm_work.horse.gender is "f">>
						문제의 애마는 흔들림 없는 시선으로 지켜보는 암말이다.
					<<else>>
						문제의 애마는 흔들림 없는 시선으로 지켜보는 수말이다.
					<</if>>
					<<if $farm.beasts.horses gte 5>>
						<<farm_He horse>>【이가】 당신을 향해 돌아서서 즐겁게 울음소리를 낸다.
					<<elseif $farm.beasts.horses lte -5>>
						<<farm_He horse>>【이가】 당신을 향해 돌아서서 조롱하듯 코웃음을 친다.
					<</if>>
				<</if>>
				<br><br>
				<<if $farm.beasts.horses gte 5>>
					"<<farm_he horse>>【이가】 널 마음에 들어 하는 것 같군," <<person2>><<person>>【이가】 말한다. "계속 수고해 줘."<<gfarm>><<farm_yield 1>>
				<<elseif $farm.beasts.horses lte -5>>
					"<<farm_he horse>>【이가】 널 별로 안 좋아하는 모양이군?" <<person>>【이가】 낄낄거린다. "어쩔 수 없지."
				<<else>>
					"내가 본 것들은 마음에 들어," <<person>>【이가】 말한다. "계속 수고해 줘."
				<</if>>
				<br><br>

				<<if $exposed gte 1>>
					고객은 알렉스가 농장 끝까지 안내하는 동안에도 계속 당신을 힐끔거린다.
				<<else>>
					알렉스가 고객을 농장 끝까지 안내한다.
				<</if>>
				<br><br>

				<<link [[다음|Farm Work]]>><<endevent>><</link>>
				<br>
			<<case 3>>
				<<npc Alex>><<person1>>
				<<if $exposed gte 1>>
					"저기," 얼굴을 붉힌 알렉스가 당신에게 다가오며 말한다. "식료품 좀 사와야 해. 네가 좀 해줄 수 있어?" <<He>>【은는】 당신에게 돈, 수건과 함께 쇼핑 목록을 내민다. "밖으로 나가려면 무-무언가로 덮어야 할 거야. 안 그러면 사람들이 우리가 뭘 꾸미고 있는지 궁금해할 테니까."
					<br><br>
				<<else>>
					"저기," 알렉스가 당신에게 다가오며 말한다. "식료품 좀 사와야 해. 네가 좀 해줄 수 있어?" <<He>>【은는】 당신에게 돈과 함께 쇼핑 목록을 내민다.
					<br><br>
				<</if>>

				<<link [[쇼핑하러 간다 (0:30)|Farm Shopping]]>><<farm_count 30>><<pass 30>><<npcincr Alex love 1>><<towelup>><</link>><<glove>>
				<br>
				<<link [[거절한다|Farm Shopping Refuse]]>><<npcincr Alex love -1>><<npcincr Alex dom -1>><</link>><<llove>><<ldom>>
				<br>
			<<case 4>>
				<<npc Alex>><<person1>>
				"숲까지 경주!" 알렉스가 당신 뒤에서 나타나며 말한다. <<He>>【은는】 재빨리 지나간다.
				<br><br>
				<<link [[경주한다 (0:02)|Farm Race]]>><<pass 2>><<farm_count 2>><</link>><<athleticsdifficulty 800 1000>><<glove>>
				<br>
				<<link [[알렉스 뒤를 따라 걷는다 (0:05)|Farm Race Walk]]>><<pass 5>><<farm_count 5>><</link>>
				<br>
				<<link [[거절한다|Farm Race Refuse]]>><<npcincr Alex love -1>><</link>><<llove>>
				<br>
			<<case 5>>
				<<if $farm.aggro gte 10 and ($farm.wall is undefined or $farm.wall lt 3)>>
					<<generate1>><<generate2>><<person1>>
					<<if $farm.wall gte 3>>
						날카롭고 금속성인 둔탁한 소리가 연이어 들린다. 소리가 나는 쪽으로 가보니 <<fullGroup>>【이가】 도끼로 울타리를 공격하고 있다.
					<<elseif $farm.wall gte 1>>
						둔탁하고 갈라지는 소리가 연이어 들린다. 소리가 나는 쪽으로 가보니 <<fullGroup>>【이가】 도끼로 벽을 공격하고 있다.
					<<else>>
						둔탁한 소리와 나무가 삐걱대는 소리가 연이어 들린다. 소리가 나는 쪽으로 가보니 <<fullGroup>>【이가】 도끼로 울타리를 공격하고 있다.
					<</if>>
					<br><br>

					<<person1>><<person>>【이가】 동료를 쿡 찌르자, 그들 모두가 당신을 쳐다본다.
					<br><br>

					<<link [[알렉스를 부른다|Farm Axe Alex]]>><<farm_aggro 5>><<npcincr Alex dom 1>><<npcincr Alex love 1>><<farm_fence_damage 1>><</link>><<gaggro>><<gdom "알렉스">><<glove>>
					<br>
					<<link [[위협한다|Farm Axe Threaten]]>><<def 1>><</link>><<englishdifficulty 400 1200>>
					<br>
					<<link [[싸운다|Farm Axe Attack]]>><<def 1>><</link>>
					<br>
				<<else>>
					<<generate1>><<person1>>
					농장 밖 언덕에 사람 형체가 서 있는 것을 발견한다. 이 거리에서는 잘 알 수 없지만, <<he>>【이가】 당신을 똑바로 쳐다보고 있는 것 같은 느낌이 든다.
					<<if $farm_stage gte 5>>
