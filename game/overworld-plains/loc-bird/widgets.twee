	<<default>>
		<<bHe>>【은는】 
		<<if $syndromebird is 1>><<select_random_clothes>><<else>><<select_random_clothes_limited "upper" "lower" "under_upper" "under_lower" "hands" "legs">><</if>>
		<<if setup.clothes[_random_slot][_random_index].plural isnot 1>>
			<<if setup.clothes[_random_slot][_random_index].word is "an">>
				/* Article omitted in Korean */
			<<else>>
				/* Article omitted in Korean */
			<</if>>
		<</if>>
		_random_clothes【을를】 <<bhis>> <<if $monster is 1>>발톱<<else>>부리<</if>>에 물고 돌아온다.
		<<if $monster is 1>>
			"<<print either(
			"추워 보여서 가져왔어.",
			"이걸 어떻게 입는 건지는 모르겠지만... 자.",
			"날개 없는 것들은 이런 걸로 짝을 유혹하는 거지?",
			"멀리서도 화려한 색이 눈에 띄더라.",
			"네 깃털도 예쁘지만, 이것도 도움이 될 것 같아서.",
			"땅바닥에 붙어 사는 것들이 방치해뒀기에 집어 왔어. 이걸 물고 날아오르니 고래고래 소리를 지르더군.",
			"난 이 촉감이 맘에 드는데. 당신도 그래?",
			"내가 곁에 없을 때 당신을 따뜻하게 해 줬으면 좋겠어. 이거... 당신을 따뜻하게 유지시켜 주는 거 맞지?"
			)>>"
		<</if>>
		<<bHe>>【은는】 
		<<if setup.clothes[_random_slot][_random_index].plural isnot 1>>
			그것을
		<<else>>
			그것들을
		<</if>>
		당신의 발치에 떨어뜨리고, 당신을 바라보며 대답을 기다린다.
		<br><br>

		<<if $bird.upgrades.wardrobe is 1>>
			<<if $worn[_random_slot].name isnot "naked" and _random_clothes isnot "piece of fabric">>
				<<link [[입는다|Bird Tower Clothes]]>><<generalWear _random_slot _random_index>><<bird_loot clothes 20>><<npcincr "Great Hawk" love 1>><<transform bird 1>><<bird_stockholm 1>><</link>><<gbirdstockholm>><<glove>>
				<br>
				<span class="blue">당신의 $worn[_random_slot].name【은는】 옷장에 들어갈거다.</span><<gfabric>>
				<br>
			<<elseif _random_clothes isnot "piece of fabric">>
				<<link [[입는다|Bird Tower Clothes]]>><<generalWear _random_slot _random_index>><<bird_loot clothes 20>><<npcincr "Great Hawk" love 1>><<transform bird 1>><<bird_stockholm 1>><</link>><<gbirdstockholm>><<glove>>
				<br>
			<</if>>
			<<if _random_clothes isnot "piece of fabric">>
				<<link [[옷장에 넣는다|Bird Tower Clothes Keep]]>><<generalSend "birdTower" _random_slot _random_index>><<bird_loot clothes 20>><<npcincr "Great Hawk" love 1>><<transform bird 1>><<bird_stockholm 1>><</link>><<gbirdstockholm>><<glove>>
				<br>
			<</if>>
		<<else>>
			<<if $worn[_random_slot].name isnot "naked" and _random_clothes isnot "piece of fabric">>
			<<link [[입는다|Bird Tower Clothes]]>><<generalRuined _random_slot>><<generalWear _random_slot _random_index>><<bird_loot clothes 20>><<npcincr "Great Hawk" love 1>><<transform bird 1>><<set $bird.materials.fabric += 1>><<bird_stockholm 1>><</link>><<gbirdstockholm>><<glove>>
				<span class="blue">당신의 $worn[_random_slot].name【은는】 교체될 거다.</span><<gfabric>>
				<br>
			<<elseif _random_clothes isnot "piece of fabric">>
				<<link [[입는다|Bird Tower Clothes]]>><<generalWear _random_slot _random_index>><<bird_loot clothes 20>><<npcincr "Great Hawk" love 1>><<transform bird 1>><<bird_stockholm 1>><</link>><<gbirdstockholm>><<glove>>
				<br>
			<</if>>
		<</if>>
		<<link [[감사한다|Bird Tower Fabric]]>><<bird_loot clothes 20>><<npcincr "Great Hawk" love 1>><<transform bird 1>><<set $bird.materials.fabric += 1>><<bird_stockholm 1>><</link>><<gbirdstockholm>><<glove>><<gfabric>>
		<br>
		<<link [[꾸짖는다|Bird Tower Clothes Scold]]>><<bird_loot clothes -20>><<npcincr "Great Hawk" dom -1>><<transform bird 1>><<def 1>><<set $bird.materials.fabric += 1>><<bird_stockholm 1>><</link>><<gbirdstockholm>><<ldom>><<gfabric>>
		<br>
		<<link [[아무것도 하지 않는다|Bird Tower Clothes Nothing]]>><<bird_loot clothes -10>><<npcincr "Great Hawk" love -1>><<set $bird.materials.fabric += 1>><</link>><<llove>><<gfabric>>
		<br>
	<</switch>>
<</widget>>

<<widget "bird_hunt_timer">>
	<<if $syndromebird isnot 1>>
		<<set $bird.timer to random(30, 90)>>
	<<elseif !$bird.hunts.unlocked>>
		<<set $bird.timer to random(45, 120)>>
	<<else>>
		<<set $bird.timer to random(60, 120)>>
	<</if>>
<</widget>>

<<widget "bird_stockholm">>
	<<if _args[0] and $bird.syndrome isnot undefined>>
		<<set $bird.syndrome += _args[0]>>
	<</if>>
<</widget>>

<<widget "gbirdstockholm">>
	<<if $syndromebird isnot 1>>
		<<gstockholm>>
	<</if>>
<</widget>>

<<widget "ggbirdstockholm">>
	<<if $syndromebird isnot 1>>
		<<ggstockholm>>
	<</if>>
<</widget>>

<<widget "gggbirdstockholm">>
	<<if $syndromebird isnot 1>>
		<<gggstockholm>>
	<</if>>
<</widget>>

<<widget "lbirdstockholm">>
	<<if $syndromebird isnot 1>>
		<<lstockholm>>
	<</if>>
<</widget>>

<<widget "llbirdstockholm">>
	<<if $syndromebird isnot 1>>
		<<llstockholm>>
	<</if>>
<</widget>>

<<widget "lllbirdstockholm">>
	<<if $syndromebird isnot 1>>
		<<lllstockholm>>
	<</if>>
<</widget>>

<<widget "bird_schedule">>
	<<set $_eggCount to nestEggCount()>>
	<<if $syndromebird gte 1 and !$daily.birdNightFlightCheck and !$weekly.birdNightFlight and !Weather.bloodMoon and !Weather.isFrozen("lake") and !$bird.injured>>
		<<set $daily.birdNightFlightCheck to true>>
		<<if $rng lte C.npc["Great Hawk"].love>>
			<<set $daily.birdNightFlightTrigger to true>>
		<</if>>
	<</if>>
	<<if $bird.override>>
		<<set $bird.activity to $bird.override>>
	<<elseif Time.hour gte 21 or Time.hour lte 5>>
		<<set $bird.activity to "sleep">>
	<<elseif Time.hour lte 9>>
		<<set $bird.activity to "sing">>
	<<elseif Time.hour lte 12 and !$daily.birdWash>>
		<<set $bird.activity to "bathe">>
	<<elseif Time.hour lte 15>>
		<<if $bird.injured gt 1>>
			<<set $bird.activity to "rest">>
		<<elseif $_eggCount and $rng gte 51>>
			<<set $bird.activity to "brood">>
			<<set $bird.override to "brood">>
			<<set $bird.overrideTimer to 60>>
		<<elseif npcIsPregnant("Great Hawk") and talkedAboutPregnancy("Great Hawk", "pc") and npcBellySize("Great Hawk") gte 12 and $rng gte 51>>
			<<set $bird.activity to "rest">>
			<<set $bird.override to "rest">>
			<<set $bird.overrideTimer to 60>>
		<<else>>
			<<set $bird.activity to "build">>
		<</if>>
	<<elseif Time.hour lte 17>>
		<<if $bird.injured gt 1 or npcIsPregnant("Great Hawk") and talkedAboutPregnancy("Great Hawk", "pc") and npcBellySize("Great Hawk") gte 12>>
			<<set $bird.activity to "rest">>
		<<else>>
			<<set $bird.activity to "groom">>
		<</if>>
	<<else>>
		<<set $bird.activity to "sing">>
	<</if>>
<</widget>>

<<widget "bird_greeting">>
	<<if $daily.birdGreeting isnot 1>>
		<<set $daily.birdGreeting to 1>>
		<<if $monster is 1>>
			<<if Time.hour lte 3 or Time.hour gte 18>>
				"좋은 저녁이야,
			<<elseif Time.hour lte 12>>
				"좋은 아침이야,
			<<else>>
				"좋은 오후야,
			<</if>>
			<<wife>>."
		<<else>>
			<<bHe>>【이가】 낮게 짹짹거리며 당신을 반긴다.
		<</if>>
	<</if>>
<</widget>>

<<widget "hawkRescueSetup">>
	<<if $moor_hunt gte 1>>
		<<enable_rescue>>
	<<else>>
		<<set $_rescueChance to 5>>
		<<if $harpy gte 6>><<set $_rescueChance += 5>><</if>>
		<<if $syndromebird gte 1>><<set $_rescueChance += 10>><</if>>
		<<if $enemynomax gte 3>><<set $_rescueChance += 10>><</if>>
		<<if $enemytype is "man">><<set $_rescueChance += 5>><</if>>
		<<set $_rescueChance += Math.floor($moor / 5)>>
		<<if $_rescueChance gte random(1, 100)>><<enable_rescue>><</if>>
	<</if>>
	<<if $bird and $bird.injured gt 1>>
		<<set $_rescueChance to 0>>
	<</if>>
<</widget>>

<<widget "hawkScreechDesc">>
	<<if $syndromebird>>반가운<<elseif C.npc["Great Hawk"].init is 1>>익숙하면서도 끔찍한<<else>>끔찍한<</if>> 비명
<</widget>>

<<widget "hawkRescueApproachSentence">>
	<<if $syndromebird is 1>>구원<<else>>공포<</if>>【이가】 <<print ["머리 위를 맴돈다", "접근한다", "내려앉는다", "당신에게 그림자를 드리운다"][random(!Weather.overcast ? 3 : 2)]>>.
<</widget>>

<<widget "hawkCaughtYouSpeech">>
	<<if $monster is 1>>
		<<if $birdescaped gte 1>>
			"<<Wife>>【은는】 <<if $birdescaped gte 2>>계속 도망쳐서는<<else>>도망쳐서는<</if>> 안 돼," <<bhe>>【이가】 말한다. "<<if $harpy gte 6>><<Wife>>【은는】 아직 나는 법도 모르잖아<<else>>지상을 돌아다니는 건 위험해<</if>>."
		<<else>>
			"잡았다," <<bhis>> 등 뒤의 날개를 맹렬하게 퍼덕이며 <<bhe>>【이가】 말한다.
		<</if>>
	<<else>>
		<<beasttype>>【은는】 
		<<if $birdescaped gte 1>>
			<<if understandsBirdBehaviour()>>안도하는<<else>>부드러운<</if>>
		<<else>>
			<<if understandsBirdBehaviour()>>의기양양한<<else>>날카로운<</if>>
		<</if>>
		울음소리를 낸다.
	<</if>>
<</widget>>

<<widget "your_bird_text">><<silently>>
	<<if $greathawkmonster is 2 or ($greathawkmonster is 1 and $hallucinations gte 1)>>
		<<set _text_output to "harpy">>
	<<else>>
		<<set _text_output to "hawk">>
	<</if>>
	<<if $syndromebird is 1>>
        <<if $monster is 1>>
            <<beasttype>><<set $_birdText to either("당신의 반려", "당신의 " + _text_output)>>
        <<else>>
            <<beasttype>><<set $_birdText to "당신의 " + _text_output>>
        <</if>>
    <<else>>
        <<beasttype>>
        <<set $_birdText to "그 " + _text_output>>
    <</if>>
    <<if _args[0] is "cap">>
        <<set $_birdText to $_birdText.toUpperFirst()>>
    <</if>>
<</silently>><<print $_birdText>><</widget>>

<<widget "bird_perch_options">>
	<<if $bird.state is "hunting" and $bird.timer lte 0>>
		<<endevent>>
		<<npc "Great Hawk">>
		<<beasttype>>【이가】 돌아오며 날갯짓을 퍼덕이는 소리가 들린다.

		<<bHe>>【은는】 내려앉아 당신을 향해 <<if $monster is 1>>걸어온다<<else>>폴짝거리며 다가온다<</if>>.
		<<bird_hunt_return>>
	<<elseif $bird.state is "home" and !["brood","sleep","sing","groom"].includes($bird.activity) and !$bird.override and Weather.dayState isnot "night" and $bird.timer lte 0>>
		<<endevent>>
		<<npc "Great Hawk">>
		<<bird_hunt_start>>
	<<elseif $bird.activity is "sleep" and $birdSleep is undefined and $bird.state is "home">>
		<<if $daily.birdNightFlightTrigger and !$weekly.birdNightFlight and ["clear","lightClouds"].includes(Weather.name) and !Weather.bloodMoon and !Weather.isFrozen("lake") and !$bird.injured>>
			<<endevent>>
			<<npc "Great Hawk">>
			<<set $weekly.birdNightFlight to true>>
			<<unset $birdPerch>><<unset $birdBask>>
			<<your_bird_text "cap">>【이가】 횃대에서 일어선다. 달빛이 은빛으로 <<bhim>> 물들인다.
			<br><br>

			<<if $monster is 1>>
				"이리 와, <<wife>>. 나와 함께 날자." 다정하게 애원하는 목소리로 <<bhe>>【이가】 
				<<if $harpy gte 6 and $birdFly is 1 and !$plucked>>
					거대한 발톱을 당신을 향해 내민다.
				<<else>>
					몸을 웅크려 당신이 <<bhis>> 등에 올라탈 수 있게 공간을 내어준다.
				<</if>>
			<<else>>
				<<bHe>>【은는】 낮게 지저귀며 황야를 향해 고개를 끄덕인다. <<bHe>>【은는】 당신이 함께 비행하기를 원하고 있다.
				<<if $harpy lt 6 or $birdFly isnot 1 and !$plucked>>
					<<bHe>>【은는】 몸을 낮추며 <<bhis>> 등에 올라타라고 몸짓한다.
				<</if>>
			<</if>>
			<br><br>

			<<link [[간다|Bird Tower Night Flight]]>><<bird_pass 30>><<npcincr "Great Hawk" love 1>><</link>><<glove>>
			<br>
			<<link [[머문다|Bird Tower Night Flight Stay]]>><</link>>
			<br>
		<<else>>
			<<set $birdSleep to 1>><<unset $birdPerch>><<unset $birdBask>>
			<<endevent>>
			<<npc "Great Hawk">>
			<<if $monster gte 1>>
				<<beasttype>>【은는】 <<bhis>> 팔로 당신을 안아올린다. "밤이 왔어," <<bhe>>【이가】 말한다. "내가 널 침대로 데려가게 해 줘."
				<br><br>
			<<else>>
				<<beasttype>>【은는】 횃대에서 내려와 둥지를 향해 폴짝거린다. <<bHe>>【은는】 당신을 힐끗 쳐다본다.
				<br><br>
			<</if>>

			<<link [[둥지로 간다|Bird Tower Perch Nest]]>><</link>>
			<br>
			<<link [[일어나 있는다|Bird Tower]]>><<endevent>><</link>>
			<br>
		<</if>>
	<<elseif $syndromebird is 1 and ["sing", "groom"].includes($bird.activity) and $birdBask is undefined and $bird.state is "home">>
		<<endevent>>
		<<npc "Great Hawk">>
		<<baskicon>><<link [[햇볕을 쬔다 (0:30)|Bird Tower Bask]]>><<bird_pass 30>><<stress -12>><<endevent>><</link>><<llstress>>
		<br>
		<<birdicon "sing">><<link [[노래한다 (0:30)|Bird Tower Sing]]>><<transform bird 1>><<bird_pass 30>><<trauma -3>><<endevent>><</link>><<ltrauma>>
		<br>
		<<if $bird.state is "home" and !["sleep","rest"].includes($bird.activity) and canGiftFood("Great Hawk")>>
			<<skinicon "give">><<link [[거대 매에게 먹이를 준다|Great Hawk Gifts List]]>><<endevent>><</link>>
			<br>
		<</if>>
		<<if $daily.birdGroom is undefined and $bird.activity is "groom">>
			<<birdicon "preen">><<link [[몸단장한다 (0:15)|Bird Tower Groom]]>><<bird_pass 15>><<trauma -6>><<transform bird 1>><<npcincr "Great Hawk" love 1>><<endevent>><</link>><<ltrauma>><<glove>><br>
		<</if>>
		<<if $harpy gte 6 and $birdFly is 1 and $bird.injured is 0 and $bird.upgrades.decor gte 1 and !$daily.birdCasualFlight>>
			<<if $plucked>>
				<span class="red">당신의 날개는 그윌란의 꼼꼼한 깃털 다듬기에서 아직 회복되지 않았다.</span>
			<<elseif Weather.precipitation is "rain">>
				<span class="purple">비가 너무 많이 와서 가볍게 비행하기에는 무리다.</span>
			<<elseif $tiredness gte (C.tiredness.max / 5) * 4>>
				<span class="red">당신은 비행에 나서기에는 너무 지쳐 있다.</span>
			<<else>>
				<<socialiseicon "ask">><<link [[함께 날아가자고 부탁한다 (1:00)|Bird Tower Casual Flight]]>><<set $daily.birdCasualFlight to true>><<tiredness 3>><<transform bird 1>><<npcincr "Great Hawk" love 1>><<endevent>><</link>><<gtiredness>><<glove>>
			<</if>>
			<br>
		<</if>>
		<<if $syndromebird and $lurkers_held gte 1 and $bird.state is "home" and ["sing", "groom"].includes($bird.activity)>>
		<<birdicon "lurkers_netted">><<link "그물로 잡은 럴커를 <<bhim>>에게 준다" "Bird Tower Give Captured Lurker">><<endevent>><</link>><<glove>><br>
		<</if>>
		<<if $bird.upgrades.telescope is 1>>
			<<birdicon "telescope">><<link [[망원경을 사용한다|Bird Tower Telescope]]>><<endevent>><</link>><br>
		<</if>>
		<<getouticon>><<link [[안으로 돌아간다|Bird Tower]]>><<unset $birdPerch>><<endevent>><</link>>
		<br><br>
		<<bird_fly_options>>
	<<elseif $birdBask is 1 and ["sing", "groom"].includes($bird.activity) and $bird.state is "home">>
		<<endevent>>
		<<npc "Great Hawk">>
		<<baskicon>><<link [[계속해서 햇볕을 쬔다 (0:30)|Bird Tower Bask]]>><<bird_pass 30>><<stress -12>><<endevent>><</link>><<llstress>>
		<br>
		<<birdicon "sing">><<link [[노래한다 (0:30)|Bird Tower Sing]]>><<transform bird 1>><<bird_pass 30>><<trauma -3>><<endevent>><</link>><<ltrauma>>
		<br>
		<<if npcIsPregnant("Great Hawk") and talkedAboutPregnancy("Great Hawk","pc")>>
		<<pregnancyicon "Great Hawk">><<link "<<bhis>> 부른 배를 문질러 준다 (0:30)" "Bird Tower Pregnant Belly Rub">><<transform bird 1>><<bird_pass 30>><<stress -6>><<trauma -6>><<endevent>><</link>><<llstress>><<lltrauma>><br>
		<</if>>
		<<if $harpy gte 6 and $birdFly is 1 and $bird.injured is 0 and $bird.upgrades.decor gte 1 and !$daily.birdCasualFlight>>
			<<if $plucked>>
				<span class="red">당신의 날개는 그윌란의 꼼꼼한 깃털 다듬기에서 아직 회복되지 않았다.</span>
			<<elseif Weather.precipitation is "rain">>
				<span class="purple">비가 너무 많이 와서 가볍게 비행하기에는 무리다.</span>
			<<elseif $tiredness gte (C.tiredness.max / 5) * 4>>
				<span class="red">당신은 비행에 나서기에는 너무 지쳐 있다.</span>
			<<else>>
				<<socialiseicon "ask">><<link [[함께 날아가자고 부탁한다 (1:00)|Bird Tower Casual Flight]]>><<set $daily.birdCasualFlight to true>><<tiredness 3>><<transform bird 1>><<npcincr "Great Hawk" love 1>><<endevent>><</link>><<gtiredness>><<glove>>
			<</if>>
			<br>
		<</if>>
		<<birdicon "perch_up">><<link [[일어난다|Bird Tower Perch]]>><<unset $birdBask>><<endevent>><</link>><br>
		<<getouticon>><<link [[자리를 뜬다|Bird Tower Bask Leave]]>><<unset $birdBask>><<unset $birdPerch>><<endevent>><</link>><br>
	<<else>>
		<<if $birdSingIntro is 1>>
			<<birdicon "sing">><<link [[노래한다 (0:30)|Bird Tower Sing]]>><<set $birdSingAbsent to 1>><<bird_pass 30>><<trauma -2>><<endevent>><</link>><<ltrauma>><br>
		<</if>>
		<<if $bird.state is "home" and !["sleep","rest"].includes($bird.activity) and canGiftFood("Great Hawk")>>
			<<skinicon "give">><<link [[거대 매에게 먹이를 준다|Great Hawk Gifts List]]>><<endevent>><</link>>
			<br>
		<</if>>
		<<if $harpy gte 6>>
			<<birdicon "preen_self">><<link [[당신의 날개를 다듬는다 (0:30)|Bird Tower Preen Self]]>><<bird_pass 30>><<stress -2>><<endevent>><</link>><<lstress>><br>
		<</if>>
		<<if $bird.upgrades.telescope is 1>>
			<<birdicon "telescope">><<link [[망원경을 사용한다|Bird Tower Telescope]]>><<endevent>><</link>><br>
		<</if>>
		<<getouticon>><<link [[안으로 돌아간다|Bird Tower]]>><<unset $birdPerch>><<endevent>><</link>>
		<br><br>
		<<bird_fly_options>>
	<</if>>
	<<unset $birdSingAbsent>>
<</widget>>

<<widget "bird_telescope_options">>
	<<if $bird.state is "hunting" and $bird.timer lte 0>>
		<<endevent>>
		<<npc "Great Hawk">>
		<<beasttype>>【이가】 돌아오며 날갯짓을 퍼덕이는 소리가 들린다.

		<<bHe>>【은는】 내려앉아 당신을 향해 <<if $monster is 1>>걸어온다<<else>>폴짝거리며 다가온다<</if>>.
		<<bird_hunt_return>>
	<<elseif $bird.state is "home" and !["brood","sleep"].includes($bird.activity) and !$bird.override and Weather.dayState isnot "night" and $bird.timer lte 0>>
		<<endevent>>
		<<npc "Great Hawk">>
		<<bird_hunt_start>>
	<<else>>
		<<if Time.dayState is "night" and !Weather.isOvercast>>
			<<if $daily.telescopeBlood and Weather.bloodMoon>>
				<span class="red">당신은 지금 하늘을 올려다보고 싶지 않다.</span>
			<<else>>
				<<link [[하늘을 관찰한다 (1:00)|Bird Tower Telescope Sky]]>><<bird_pass 60>><</link>>
			<</if>>
			<br>
		<</if>>
		<<link [[황야를 관찰한다 (0:20)|Bird Tower Telescope Moor]]>><<bird_pass 20>><</link>>
		<br>
		<<link [[물러난다|Bird Tower Perch]]>><<endevent>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "bird_fly_options">>
	<<if $harpy gte 6>>
		<<if $plucked>>
			바람을 타고 멀리 날아갈 수 있겠지만, <span class="red">그윌란이 깃털을 모조리 다듬어버린 탓에 날개가 아직 회복되지 않았다.</span> 최소한 안전하게 아래로 내려갈 수는 있을 것이다.
			<br>
			<<birdicon "fly_down">><<link [[탑 밑으로 활강한다 (0:01)|Bird Tower Glide 2]]>><<unset $birdPerch>><<bird_pass 1>><<endevent>><</link>><<flight_text>><br>
		<<elseif $birdFly isnot 1>>
			바람을 타고 멀리 날아갈 수 있겠지만, <span class="red">당신은 나는 법을 모른다.</span> 최소한 안전하게 아래로 내려갈 수는 있을 것이다.
			<br>
			<<if ($bird.activity is "sing" or $bird.activity is "groom") and $bird.state is "home">>
				<<socialiseicon "ask">><<link [[거대 매에게 비행을 가르쳐 달라고 부탁한다|Bird Tower Fly Intro]]>><<endevent>><</link>><<flight_text>><br>
				<<if $syndromebird isnot 1>>
					<span class="red">거대 매가 지켜보고 있어 활강해 내려갈 수 없다.</span><br>
				<<else>>
					<<birdicon "fly_down">><<link [[탑 밑으로 활강한다 (0:01)|Bird Tower Glide 2]]>><<unset $birdPerch>><<bird_pass 1>><<endevent>><</link>><<flight_text>><br>
				<</if>>
			<<else>>
				<<birdicon "fly_down">><<link [[탑 밑으로 활강한다 (0:01)|Bird Tower Glide 2]]>><<unset $birdPerch>><<bird_pass 1>><<endevent>><</link>><<flight_text>><br>
			<</if>>
		<<elseif $birdFly is 1>>
			<<flight_time_check 60>>
			<<if $bird.hunts.unlocked is true and ($bird.hunts.lurkers is true or $bird.hunts.materials is true or $bird.hunts.valuables is true)>>
				<<if pcAreArmsBound("both")>>
					<span class="red">양팔이 모두 묶여 있어</span> 사냥을 할 수 없습니다.
				<<else>>
					<<birdicon "hunt">><<link [[사냥을 준비한다|Bird Hunt Start]]>><<endevent>><</link>><<flight_text>><br>
				<</if>>
				<br>
			<</if>>
			날아간다.
			<br>
			<<if $exposed gte 2 and !hasSexStat("exhibitionism", 4)>>
				<<insufficientStat "exhibitionism" "to fly exposed towards the town or farmlands">>
				<br>
			<<else>>
				<<farmicon>><<link [[농경지 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Tower Farmlands]]>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<unset $birdPerch>><<endevent>><</link>><<flight_text>><<print _fatigueText>><<if $exposed gte 2>><<exhibitionist4>><</if>>
				<br>
				<<entertownicon>><<link [[마을 (<<print getTimeString(_hoursPassedLong, _minutesPassedLong)>>)|Bird Tower Town]]>><<set $fatigueMod to (_fatigueMod + 1)>><<set $flightTime to _flightTimeLong>><<bird_pass _flightTimeLong>><<unset $birdPerch>><<endevent>><</link>><<flight_text>><<print _fatigueText>><<if $exposed gte 2>><<exhibitionist4>><</if>>
				<br>
			<</if>>
			<<foresticon>><<link [[숲 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Tower Forest]]>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<unset $birdPerch>><<endevent>><</link>><<flight_text>><<print _fatigueText>>
			<br>
			<<birdicon "fly_down">><<link [[탑 밑 (0:01)|Bird Tower Glide 2]]>><<unset $birdPerch>><<bird_pass 1>><<endevent>><</link>><<flight_text>>
			<br>
		<</if>>
	<<elseif $angel gte 6 or $demon gte 6 or $fallenangel gte 2>>
		<<if $pain gte 21>>
			날개로 날아내려갈 수 있겠지만, <span class="purple">지금은 부상이 너무 심해 위험한 도약을 감행할 수 없다.</span>
			<br><br>
		<<else>>
			날개로 날아내려갈 수 있을 것이다.
			<<if $syndromebird isnot 1 and ($bird.activity is "sing" or $bird.activity is "groom") and $bird.state is "home">>
				<span class="red">하지만 거대 매가 지켜보고 있어 멀리 가지는 못할 것이다.</span>
				<br><br>
			<<elseif $birdFly is 1 or $birdGlide is 1>>
				<br><br>
				<<glideicon>><<link [[활강하여 내려간다 (0:02)|Bird Tower Glide]]>><<unset $birdPerch>><<bird_pass 2>><<endevent>><</link>><<flight_text>>
			<<elseif currentSkillValue('willpower') lt 250>>
				<span class="red">하지만 시도할 의지나 용기가 부족하다.</span>
			<<elseif $daily.glideScared>>
				<span class="red">지금은 너무 겁이 나서 다시 시도할 수 없다.</span>
			<<else>>
				<br><br>
				<<glideicon>><<link [[활강을 시도한다 (0:02)|Bird Tower Glide Attempt]]>><<unset $birdPerch>><<bird_pass 2>><<endevent>><</link>><<flight_text>><<willpowerdifficulty 250 1100>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "flight_time_check">>
	<<if _args[0] isnot undefined>>
		<<set _flightTimeBase to _args[0]>>
	<<else>>
		<<set _flightTimeBase to 60>>
	<</if>>
	<<if _args[1] isnot "silent" and !$settings.blindStatsEnabled>>
		<<set $_printAlerts to true>>
	<</if>>
	<<if $bird.hunts and $bird.hunts.weight>>
		/* this is not always an integer */
		<<set _flightTimeBase += $bird.hunts.weight>>
	<</if>>
	<<set _flightTime to _flightTimeBase>>
	<<switch Weather.name>>
		<<case "heavyClouds">>
			<<set _flightTime -= Math.floor(_flightTimeBase / 3)>>
			<<set _fatigueText to "<<gtiredness>>">>
			<<set _fatigueMod to 0.5>>
			<<if $_printAlerts>><span class="gold">강한 바람 덕분에 비행이 쉽고 빨라질 것입니다.</span><</if>>
		<<case "lightPrecipitation" "heavyPrecipitation" "storm" "thunderstorm">>
			<<if Weather.precipitation is "snow">>
				<<set _flightTime += Math.floor(_flightTimeBase / 6)>>
				<<set _fatigueText to "<<ggtiredness>>">>
				<<set _fatigueMod to 2>>
				<<if $_printAlerts>><span class="blue">눈 속을 비행하면 시야가 가려지고 속도가 느려질 것입니다.</span><</if>>
			<<else>>
				<<set _flightTime += 1>>
				<<for _active_clothes range Object.keys($worn)>>
					<<if !$worn[_active_clothes].type.includes("naked") and !$worn[_active_clothes].type.includes("swim")>>
						<<switch _active_clothes>>
							<<case "over_upper" "over_lower">>
								<<set _flightTime += Math.floor(_flightTimeBase / 6)>><<set _slowText to true>>
							<<case "upper" "lower">>
								<<set _flightTime += Math.floor(_flightTimeBase / 9)>><<set _slowText to true>>
							<<case "under_upper" "under_lower" "feet">>
								<<set _flightTime += Math.floor(_flightTimeBase / 18)>><<set _slowText to true>>
							<<default>>
						<</switch>>
					<</if>>
				<</for>>
				<<if _slowText>>
					<<if _flightTime gte Math.floor(_flightTimeBase + (_flightTimeBase * 0.5))>>
						<<set _fatigueText to "<<gggtiredness>>">>
						<<set _fatigueMod to 3>>
						<<if $_printAlerts>><span class="red">빗속을 비행하면 옷이 젖어 속도가 크게 느려지고 몸이 훤히 드러날 것입니다.</span><</if>>
					<<elseif _flightTime gte Math.floor(_flightTimeBase + (_flightTimeBase * 0.25))>>
						<<set _fatigueText to "<<gggtiredness>>">>
						<<set _fatigueMod to 3>>
						<<if $_printAlerts>><span class="pink">빗속을 비행하면 옷이 젖어 속도가 느려지고 몸이 드러날 것입니다.</span><</if>>
					<<elseif _flightTime gt _flightTimeBase>>
						<<set _fatigueText to "<<ggtiredness>>">>
						<<set _fatigueMod to 2>>
						<<if $_printAlerts>><span class="blue">빗속을 비행하면 옷이 젖어 속도가 약간 느려지고 몸이 드러날 것입니다.</span><</if>>
					<<else>>
						<<set _fatigueText to "<<gtiredness>>">>
						<<set _fatigueMod to 2>>
						<<if $_printAlerts>><span class="green">현재 옷차림으로는 빗속을 비행해도 전혀 속도가 느려지지 않을 것입니다.</span><</if>>
					<</if>>
				<<else>>
					<<set _fatigueText to "<<gtiredness>>">>
					<<set _fatigueMod to 2>>
					<<if $_printAlerts>><span class="green">현재 옷차림으로는 빗속을 비행해도 전혀 속도가 느려지지 않을 것입니다.</span><</if>>
				<</if>>
			<</if>>
		<<default>>
			<<set _fatigueText to "<<gtiredness>>">>
			<<set _fatigueMod to 1>>
			<<if $_printAlerts>><span class="green">날씨가 비행에 영향을 주지는 않을 것입니다.</span><</if>>
	<</switch>>
	<<if $_printAlerts>><br><</if>>
	<<if currentSkillValue('athletics') gt 0>>
		<<set _flightTime -= Math.floor((_flightTime / 20) * (currentSkillValue('athletics') / 100))>>
	<</if>>
	<<if _flightTime lte 0>>
		<<set _flightTime to 1>>
	<</if>>
	/* I put floor here to protect from other modifiers if added later, feel free to add it on the line commented above */
	<<set _flightTime to Math.floor(_flightTime)>>
	<<set _hoursPassed to Math.floor(_flightTime / 60)>>
	<<set _minutesPassed to _flightTime % 60>>

	<<set _flightTimeLong to Math.floor(_flightTime + 15)>>
	<<set _hoursPassedLong to Math.floor(_flightTimeLong / 60)>>
	<<set _minutesPassedLong to _flightTimeLong % 60>>

	<<set _flightTimeSearch to Math.floor(_flightTime + 3)>>
	<<set _hoursPassedSearch to Math.floor(_flightTimeSearch / 60)>>
	<<set _minutesPassedSearch to _flightTimeSearch % 60>>
<</widget>>

<<widget "flight_effects">>
	<<if $flightTime>>
		<<if Weather.precipitation is "rain">>
			<<if !$worn.upper.type.includes("swim") and !$worn.upper.type.includes("naked")>>
				<<upperwet `Math.floor($flightTime * 4)`>>
			<</if>>
			<<if !$worn.lower.type.includes("swim") and !$worn.lower.type.includes("naked")>>
				<<lowerwet `Math.floor($flightTime * 4)`>>
			<</if>>
			<<if !$worn.under_lower.type.includes("swim") and !$worn.under_lower.type.includes("naked")>>
				<<underlowerwet `Math.floor($flightTime * 4)`>>
			<</if>>
			<<if !$worn.under_upper.type.includes("swim") and !$worn.under_upper.type.includes("naked")>>
				<<underupperwet `Math.floor($flightTime * 4)`>>
			<</if>>
		<</if>>
		<<set _tempTired to (Math.floor($flightTime / 4) + 1)>>
		<<set Weather.BodyTemperature.addActivity("physique")>>
		<<tiredness _tempTired>>
		<<unset $flightTime>>
		<<unset $fatigueMod>>
	<</if>>
<</widget>>

<<widget "flight_distance_check">>
	<<set _distanceNorthSouth to Math.abs($bird.hunts.distanceNorth)>>
	<<set _distanceEastWest to Math.abs($bird.hunts.distanceEast)>>
	<<set _distanceTotal to (_distanceNorthSouth + _distanceEastWest)>>
	<<set _returnTime to 0>>
	<<set _returnTime to (5 * _distanceTotal)>>
<</widget>>

<<widget "flight_hunt_options">>
	<<flight_time_check 20 "silent">>
	<<if $bird.hunts.goal is "hawk">>
		<<set _directionPool to []>>
		<<if $bird.hunts.distanceNorth lt 5 and !($bird.hunts.distanceNorth is -1 and _distanceEastWest is 0)>>
			<<run _directionPool.pushUnique("north")>>
		<</if>>
		<<if $bird.hunts.distanceEast lt 5 and !($bird.hunts.distanceEast is -1 and _distanceNorthSouth is 0)>>
			<<run _directionPool.pushUnique("east")>>
		<</if>>
		<<if $bird.hunts.distanceNorth gt -5 and !($bird.hunts.distanceNorth is 1 and _distanceEastWest is 0)>>
			<<run _directionPool.pushUnique("south")>>
		<</if>>
		<<if $bird.hunts.distanceEast gt -5 and !($bird.hunts.distanceEast is 1 and _distanceNorthSouth is 0)>>
			<<run _directionPool.pushUnique("west")>>
		<</if>>
		<<set $bird.hunts.direction to _directionPool.pluck()>>
		<<switch $bird.hunts.direction>>
			<<case "north">><<set _distanceNorthSouth to 1>><<set _distanceEastWest to 0>>
			<<case "east">><<set _distanceNorthSouth to 0>><<set _distanceEastWest to 1>>
			<<case "south">><<set _distanceNorthSouth to -1>><<set _distanceEastWest to 0>>
			<<case "west">><<set _distanceNorthSouth to 0>><<set _distanceEastWest to -1>>
		<</switch>>
		<<capture _distanceNorthSouth _distanceEastWest _fatigueMod _flightTime _fatigueText>>
			<<link [[`사냥을 계속한다 (${getTimeString(_hoursPassed, _minutesPassed)})`|Bird Hunt Event]]>>
				<<handheldon>>
				<<set $bird.hunts.distanceNorth += _distanceNorthSouth>>
				<<set $bird.hunts.distanceEast += _distanceEastWest>>
				<<set $fatigueMod to _fatigueMod>>
				<<set $flightTime to _flightTime>>
				<<bird_pass _flightTime>>
			<</link>><<print _fatigueText>>
		<</capture>>
		<br><br>

		<<link [[다른 것을 사냥하자고 한다|Bird Hunt Goal]]>><<endevent>><<set $phase to 2>><</link>>
		<br>
		<<flight_time_check _returnTime "silent">>
		<<link [[`성으로 돌아가자고 한다 (${getTimeString(_hoursPassed, _minutesPassed)})`|Bird Hunt Return Ask]]>>
			<<handheldon>>
			<<set $fatigueMod to _fatigueMod>>
			<<set $flightTime to _flightTime>>
			<<bird_pass _flightTime>>
		<</link>><<print _fatigueText>>
		<br>
	<<else>>
		<<if _distanceNorthSouth gte 4 or _distanceEastWest gte 4>>
			여기서는 탑이 보이지 않는다.
		<<elseif _distanceNorthSouth is 0 and _distanceEastWest is 0>>
			황야가 당신의 눈앞에 펼쳐져 있다.
		<<else>>
			탑이 있는 방향:
			<<if $bird.hunts.distanceNorth lte -1>>북<<elseif $bird.hunts.distanceNorth gte 1>>남<</if>><<if $bird.hunts.distanceEast lte -1>>동<<elseif $bird.hunts.distanceEast gte 1>>서<</if>>쪽.
		<</if>>
		<br>
		<<if between($bird.hunts.distanceNorth, ($daily.huntRemyCampNorth - 1), ($daily.huntRemyCampNorth + 1)) and between($bird.hunts.distanceEast, ($daily.huntRemyCampEast - 1), ($daily.huntRemyCampEast + 1))>>
			<<if !($bird.hunts.distanceNorth is $daily.huntRemyCampNorth and $bird.hunts.distanceEast is $daily.huntRemyCampEast)>>
				연기가 피어오르는 방향:
				<<if $bird.hunts.distanceNorth lt $daily.huntRemyCampNorth>>북<<elseif $bird.hunts.distanceNorth gt $daily.huntRemyCampNorth>>남<</if>><<if $bird.hunts.distanceEast lt $daily.huntRemyCampEast>>동<<elseif $bird.hunts.distanceEast gt $daily.huntRemyCampEast>>서<</if>>쪽.
				<br>
			<</if>>
		<</if>>
		<<if $daily.emptyCamp and between($bird.hunts.distanceNorth, ($daily.emptyCampNorth - 1), ($daily.emptyCampNorth + 1)) and between($bird.hunts.distanceEast, ($daily.emptyCampEast - 1), ($daily.emptyCampEast + 1))>>
			<<if !($bird.hunts.distanceNorth is $daily.emptyCampNorth and $bird.hunts.distanceEast is $daily.emptyCampEast)>>
				버려진 야영지가 있는 방향:
				<<if $bird.hunts.distanceNorth lt $daily.emptyCampNorth>>북<<elseif $bird.hunts.distanceNorth gt $daily.emptyCampNorth>>남<</if>><<if $bird.hunts.distanceEast lt $daily.emptyCampEast>>동<<elseif $bird.hunts.distanceEast gt $daily.emptyCampEast>>서<</if>>쪽.
				<br>
			<</if>>
		<</if>>
		<<if between($bird.hunts.distanceNorth, -4, -2) and between($bird.hunts.distanceEast, 2, 4)>>
			<<if !($bird.hunts.distanceNorth is -3 and $bird.hunts.distanceEast is 3)>>
				언덕 꼭대기에 커다란 바위가 있는 방향:
				<<if $bird.hunts.distanceNorth lt -3>>북<<elseif $bird.hunts.distanceNorth gt -3>>남<</if>><<if $bird.hunts.distanceEast lt 3>>동<<elseif $bird.hunts.distanceEast gt 3>>서<</if>>쪽.
				<br>
			<</if>>
		<</if>>
		<<if between($bird.hunts.distanceNorth, -4, -2) and between($bird.hunts.distanceEast, -4, -2)>>
			<<if !($bird.hunts.distanceNorth is -3 and $bird.hunts.distanceEast is -3)>>
				언덕 꼭대기에 커다란 바위가 있는 방향:
				<<if $bird.hunts.distanceNorth lt -3>>북<<elseif $bird.hunts.distanceNorth gt -3>>남<</if>><<if $bird.hunts.distanceEast lt -3>>동<<elseif $bird.hunts.distanceEast gt -3>>서<</if>>쪽.
				<br>
			<</if>>
		<</if>>
		<<if $bird.hunts.distanceNorth is 5>>
			북쪽으로 농장이 펼쳐져 있으며, 당신의 영토는 여기까지다.
			<br>
		<<elseif $bird.hunts.distanceEast is 5>>
			동쪽으로 더 가면 낯설고 위험한 영역에 들어가게 된다.
			<br>
		<<elseif $bird.hunts.distanceNorth is -5>>
			남쪽으로 갈수록 방향 감각이 흐려진다. 기수를 돌리는 것이 현명하리라.
			<br>
		<<elseif $bird.hunts.distanceEast is -5>>
			<<if $bogProgress gte 1>>
				서쪽으로는 늪지가, 그 너머에는 숲이 펼쳐져 있다.
			<<else>>
				서쪽으로는 숲이 펼쳐져 있다.
			<</if>>
			<br>
		<</if>>
		어느 방향으로 날아갈 것인가?
		<br>
		<<capture _hoursPassed _minutesPassed _fatigueMod _flightTime _fatigueText>>
			<<if $bird.hunts.distanceNorth lt 5>>
				<<link [[북쪽 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Event]]>><<handheldon>><<set $bird.hunts.direction to "north">><<set $bird.hunts.distanceNorth++>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><</link>><<print _fatigueText>>
				<br>
			<</if>>
			<<if $bird.hunts.distanceEast lt 5>>
				<<link [[동쪽 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Event]]>><<handheldon>><<set $bird.hunts.direction to "east">><<set $bird.hunts.distanceEast++>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><</link>><<print _fatigueText>>
				<br>
			<</if>>
			<<if $bird.hunts.distanceNorth gt -5>>
				<<link [[남쪽 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Event]]>><<handheldon>><<set $bird.hunts.direction to "south">><<set $bird.hunts.distanceNorth-->><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><</link>><<print _fatigueText>>
				<br>
			<</if>>
			<<if $bird.hunts.distanceEast gt -5>>
				<<link [[서쪽 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Event]]>><<handheldon>><<set $bird.hunts.direction to "west">><<set $bird.hunts.distanceEast-->><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><</link>><<print _fatigueText>>
				<br>
			<</if>>
		<</capture>>
		<br>

		<<link [[다른 것을 사냥한다|Bird Hunt Goal]]>><<endevent>><<set $phase to 1>><</link>>
		<br>
		<<flight_distance_check>>
		<<flight_time_check _returnTime "silent">>
		<<link [[성으로 돌아간다 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Return]]>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<endevent>><<set $phase to 1>><</link>><<print _fatigueText>>
		<br>
	<</if>>
<</widget>>

<<widget "flight_hunt_return">>
	<<if $bird.hunts.duo is true and birdEggsReady("Great Hawk")>>
		<<endevent>><<set $bird.hunts.duo to false>><<set $bird.state to "home">>
		<<npc "Great Hawk">><<person1>>
		<<your_bird_text "cap">>【이가】 갑자기 창백해지더니, <<bhis>> 비행이 조금 불안정해진다.
		<br><br>

		<<if $monster is 1>>
			"<<Wife>>. 우리 집으로 돌아가야 한다. 당장."
		<</if>>
		당신이 무슨 일인지 묻기도 전에, <<bhe>>【은는】 성을 향해 더 빠르게 날기 시작한다. <<bHe>>【은는】 순식간에 당신을 앞질러 간다.
		<br><br>

		<<flight_distance_check>>
		<<flight_time_check _returnTime "silent">>
		<<link [[뒤따른다 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Return]]>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<endevent>><</link>><<print _fatigueText>>
		<br>
		<<link [[계속 사냥한다|Bird Hunt Exit]]>><<endevent>><</link>>
		<br>
	<<elseif ($bird.hunts.weight gte 3 and $bird.hunts.duo is false) or $bird.hunts.weight gte 5>>
		더 이상 물건을 나를 수 없을 것이다. 당신은 탑으로 돌아가기 시작한다.
		<br><br>

		<<flight_distance_check>>
		<<flight_time_check _returnTime "silent">>
		<<link [[성으로 돌아간다 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Return]]>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<endevent>><</link>><<print _fatigueText>>
		<br>
	<<elseif $stress gte $stressmax or isPregnancyEnding()>>
		<<handheldon>>
		계속 비행할 힘이 남아있지 않다. 날개에 힘이 풀리며 조종이 먹히지 않은 채로 빠르게 추락하기 시작한다. 당신은 의식을 잃는다.
		<br><br>

		<<if $bird.hunts.duo is false>>
			둔탁하게 물보라가 튀는 소리가 들리고, 몸이 차갑게 식는다.
			<br><br>

			<<passout_moor>>
		<<else>>
			공중에서 무언가가 당신을 낚아채는 것이 느껴지고, 다시 솟아오르기 시작하면서 귀가 먹먹해진다.
			<br><br>

			<<flight_distance_check>>
			<<flight_time_check _returnTime "silent">>
			<<link [[다음 (?:??)|Bird Hunt Passout]]>><<bird_pass _returnTime>><</link>>
			<br>
		<</if>>
	<<elseif $pain gte 90>>
		<<if $bird.hunts.duo is true>>
			<<endevent>>
			<<npc "Great Hawk">><<person1>>
			<<if $monster is 1>>
				"다쳤구나," <<your_bird_text>>【이가】 말한다. "당장 집으로 돌아간다."
			<<else>>
				<<your_bird_text "cap">>【이가】 당신에게 까악 소리를 내며, <<bhis>> 날개로 당신을 매만진다. 당신은 고통에 움찔한다. 부상이 심해 더 이상 사냥을 계속할 수 없다. 당신은 경로를 바꿔 집으로 향한다.
			<</if>>
		<<else>>
			부상이 심해 더 이상 사냥을 계속할 수 없다. 당신은 기수를 돌려 집으로 돌아간다.
		<</if>>
		<br><br>

		<<flight_distance_check>>
		<<flight_time_check _returnTime "silent">>
		<<link [[성으로 돌아간다 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Return]]>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<endevent>><</link>><<print _fatigueText>>
		<br>
	<<elseif $bird.hunts.duo is true and $bird.hunts.timer gte 360>>
		<<endevent>>
		<<npc "Great Hawk">><<person1>>
		<<your_bird_text "cap">>【은는】 매우 지쳐 보인다.
		<<if $monster is 1>>
			"너무 오래 날았다. 집으로 돌아간다."
		<<else>>
			<<bHe>>【이가】 당신을 쳐다보며 까악거린다. 몇 시간이나 비행했으니, 이제 집으로 돌아가야 한다.
		<</if>>
		<<bHe>>【이가】 성으로 돌아가기 위해 몸을 돌리고, 당신도 뒤따른다.
		<br><br>

		<<flight_distance_check>>
		<<flight_time_check _returnTime "silent">>
		<<link [[성으로 돌아간다 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Return]]>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<endevent>><</link>><<print _fatigueText>>
		<br>
	<<elseif $bird.hunts.duo is true and npcIsPregnant("Great Hawk") and talkedAboutPregnancy("Great Hawk","pc") and $bird.hunts.timer gte (360 - (npcBellySize("Great Hawk") * 10))>>
		<<endevent>>
		<<npc "Great Hawk">><<person1>>
		<<your_bird_text "cap">>【은는】 매우 지쳐 보인다.
		<<if $monster is 1>>
			"너무 오래 날았다. 집으로 돌아간다." <<bHe>>【은는】 손을 <<bhis>> <<bellyDescription "Great Hawk">> 위에 얹는다.
		<<else>>
			<<bHe>>【이가】 피곤한 기색으로 당신을 보며 까악거린다.
		<</if>>
		<<bHis>> 임신이 평소보다 사냥을 더 고되게 만드는 모양이다. <<bHe>>【이가】 성으로 돌아가려 몸을 돌리고, 당신도 그 뒤를 따른다.
		<br><br>

		<<flight_distance_check>>
		<<flight_time_check _returnTime "silent">>
		<<link [[성으로 돌아간다 (<<print getTimeString(_hoursPassed, _minutesPassed)>>)|Bird Hunt Return]]>><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<endevent>><</link>><<print _fatigueText>>
		<br>
	<<else>>
		당신은 더 높은 하늘로 돌아간다.
		<<if $bird.hunts.duo is true and $bird.hunts.timer gte 300>>
			<<endevent>>
			<<npc "Great Hawk">><<person1>>
			<<your_bird_text "cap">>【은는】 지쳐 보이기 시작한다.
		<<elseif $bird.hunts.duo is true and Time.dayState is "dusk" and $bird.hunts.timer gte 120 and !$daily.birdNightWarning>>
			<<endevent>>
			<<npc "Great Hawk">><<person1>>
			<<set $daily.birdNightWarning to true>>
			<<your_bird_text "cap">>【은는】 지는 해를 바라본다.
			<<if $monster is 1>>
				"곧 밤이다. 사냥이 힘들어질 거다."
			<<else>>
				그러고는 <<bHe>>【이가】 당신을 돌아보며 까악거린다. 시간이 늦어지고 있다. 밤에 사냥하는 것은 더 힘들 것이다.
			<</if>>
		<</if>>
		<br><br>

		<<endevent>>
		<<if _huntFail is 1>><<set $phase to 2>><</if>>
		<<flight_hunt_options>>
	<</if>>
	<<if _loot>>
		<<wearProp _loot>>
	<</if>>
<</widget>>

<<widget "flight_hunt_chance">>
	<<if $bird.hunts.goal is "hawk">>
		<<bird_loot_select>>
		<<switch _bird_loot_select>>
			<<case "food" "lurker">><<set $_goal to "lurkers">>
			<<case "trash" "clothes">><<set $_goal to "materials">>
			<<case "valuables">><<set $_goal to "valuables">>
		<</switch>>
	<<else>>
		<<set $_goal to $bird.hunts.goal>>
	<</if>>
	<<set _flight_hunt_chance to {
		nothing: 2,
		lurkers: random(1, 3),
		materials: random(1, 2),
		valuables: random(0, 2),
		other: 1
	}>>
	<<set _flight_hunt_chance[$_goal] += ($bird.hunts.goal is "hawk" ? 3 : 1 + Math.floor(currentSkillValue("skulduggery") / 500))>>
	<<if Weather.precipitation isnot "none">>
		<<set _flight_hunt_chance.nothing += 2>>
	<</if>>
	<<if Time.dayState is "night">>
		<<set _flight_hunt_chance.nothing += 2>>
	<</if>>
	<<if $daily.huntRemyCampNorth is undefined>>
		<<set $daily.huntRemyCampNorth to random(2,5)>>
		<<set $daily.huntRemyCampEast to random(-5,5)>>
	<</if>>
	<<if $daily.emptyCampNorth is undefined>>
		<<set $daily.emptyCampNorth to random(2,5)>>
		<<set $daily.emptyCampEast to random(-5,5)>>
		<<if $daily.emptyCampNorth is $daily.huntRemyCampNorth and $daily.emptyCampEast is $daily.huntRemyCampEast>>
			<<if $daily.emptyCampNorth is 5>>
				<<set $daily.emptyCampNorth -= 1>>
			<<else>>
				<<set $daily.emptyCampNorth += 1>>
			<</if>>
			<<set $daily.emptyCampEast to random(-5,5)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "flight_hunt_get">>
	<<if !_args[0]>>
		<<run Errors.report("No argument specified for widget flight_hunt_get")>>
	<<elseif typeof _args[0] isnot "string">>
		<<run Errors.report("Non-string provided as first argument for widget flight_hunt_get")>>
	<<elseif !_args[1] or typeof _args[1] isnot "number">>
		<<run Errors.report("No number argument specified for widget flight_hunt_get")>>
	<<else>>
		<<set $_looted to _args[0]>><<set $_amount to _args[1]>>
		<<if $_looted is "valuables">>
			<<if _args[2]>>
				<<set $_info to _args[2]>>
				<<if $bird.hunts.loot.valuables is undefined>>
					<<set $bird.hunts.loot.valuables to {[$_info]: 0}>>
				<</if>>
				<<if $bird.hunts.loot.valuables[$_info] is undefined>>
					<<set $bird.hunts.loot.valuables[$_info] to 0>>
				<</if>>
				<<set $bird.hunts.loot.valuables[$_info] += $_amount>>
				<<set $bird.hunts.lootAmount += $_amount>>
				<<birdicon $_info>><span class="green">$_info $_amount개가 추가되었습니다.</span>
			<<else>>
				<<run Errors.report("Invalid special loot of type; " + $_looted + " " + _args[2])>>
				<<exit>>
			<</if>>
		<<elseif $_looted is "clothing">>
			<!-- args: 2 = slot, 3 = index, 4 = whether to take the item or wear it, defaults to take, 5 = damaged, 6 = colour, 7 = accessory colour -->
			<!-- Yes most of this is ripped straight from the equipClothesItemFromDefault widget -->
			<<if _args[2] and _args[3]>>
				<<set $_lootClothingSlot to _args[2]>><<set $_lootClothingIndex to _args[3]>>
				<<set $_item to clone(setup.clothes[$_lootClothingSlot][$_lootClothingIndex])>>
				<<if $_item.colour_options.length gt 0>>
					<<if _args[6]>>
						<<set $_item.colour to _args[5]>>
						<<if $_item.colour is "custom">>
							<<set $_item.colourCustom to customColour($customColors.color.primary, $customColors.saturation.primary, $customColors.brightness.primary, $customColors.contrast.primary, $customColors.sepia.primary)>>
						<</if>>
					<<else>>
						<<set _colorOption to clone($_item.colour_options)>>
						<<run _colorOption.delete("custom")>>
						<<set $_item.colour to _colorOption.random()>>
					<</if>>
				<</if>>
				<<if $_item.accessory_colour_options.length gt 0 and $_item.accessory_colour_sidebar>>
					<<if _args[7]>>
						<<set $_item.accessory_colour to _args[6]>>
						<<if $_item.accessory_colour is "custom">>
							<<set $_item.accessory_colourCustom to customColour($customColors.color.secondary, $customColors.saturation.secondary, $customColors.brightness.secondary, $customColors.contrast.secondary, $customColors.sepia.secondary)>>
						<</if>>
					<<else>>
						<<set _accessoryColorOption to clone($_item.accessory_colour_options)>>
						<<run _accessoryColorOption.delete("custom")>>
						<<set $_item.accessory_colour to _accessoryColorOption.random()>>
					<</if>>
				<</if>>
				<<if _args[4] is "wear">>
					<<generalWear $_lootClothingSlot $_lootClothingIndex _args[6] _args[7]>>
					<<set $_wear to true>>
				<</if>>
				<<if _args[5] is "damaged">>
					<<if ["upper", "under_upper", "lower", "under_lower"].includes($_lootClothingSlot)>>
						<<if $_wear is true>>
							<<set $worn[$_lootClothingSlot].integrity to ($_item.integrity_max - random(40, 80))>><<if $worn[$_lootClothingSlot].integrity lte 0>><<set $worn[$_lootClothingSlot].integrity to 10>><</if>>
						<<else>>
							<<set $_item.integrity to ($_item.integrity_max - random(40, 80))>><<if $_item.integrity lte 0>><<set $_item.integrity to 10>><</if>>
						<</if>>
					<</if>>
				<</if>>
				<<run clothesDataTrimmer($_item)>>
				<<if $bird.hunts.loot.clothing is undefined>>
					<<set $bird.hunts.loot.clothing to {
						[$_item.name]: {
							amount: 0,
							wear: $_wear,
							slot: $_lootClothingSlot,
							full: $_item
						}
					}>>
				<</if>>
				<<if $bird.hunts.loot.clothing[$_item.name] is undefined>>
					<<set $bird.hunts.loot.clothing[$_item.name] to {
						amount: 0,
						wear: $_wear,
						slot: $_lootClothingSlot,
						full: $_item
					}>>
				<</if>>
				<<set $bird.hunts.loot.clothing[$_item.name].amount += $_amount>>
				<<set $bird.hunts.lootAmount += $_amount>>
				<span class="green"><<clothingicon $_item $_lootClothingSlot>> $_item.name【이가】 추가되었습니다.</span>
			<<else>>
				<<run Errors.report("Invalid special loot of type; " + $_looted + " " + _args[2])>>
				<<exit>>
			<</if>>
		<<elseif $bird.materials[$_looted] is undefined and $bird.upgrades[$_looted] is undefined>>
			<<run Errors.report("Invalid loot of type; " + $_looted)>>
			<<exit>>
		<<else>>
			<<if $bird.hunts.loot[$_looted] is undefined>>
				<<set $bird.hunts.loot[$_looted] to 0>>
			<</if>>
			<<set $bird.hunts.loot[$_looted] += $_amount>>
			<<set $bird.hunts.lootAmount += $_amount>>
			<span class="green"><<birdicon $_looted>> $_amount
		<<switch $_looted>>
			<<case "tools">>
				도구 상자
			<<case "sticks">>
				<<pluralise $_amount "나뭇가지" "나뭇가지">>
			<<case "leaves">>
				<<pluralise $_amount "나뭇잎" "나뭇잎">>
			<<case "lurkers">>
				<<pluralise $_amount "럴커" "럴커">>
			<<case "feathers">>
				<<pluralise $_amount "깃털" "깃털">>
			<<default>>
				$_looted
			<</switch>>
			추가되었습니다.</span>
		<</if>>
		<<switch $_looted>>
			<<case "tarp">><<set $bird.hunts.weight += 5>>
			<<case "tools" "pot">><<set $bird.hunts.weight += 2>>
			<<case "wood">><<set $bird.hunts.weight += (2 * $_amount)>>
			<<case "leaves">><<set $bird.hunts.weight += (0.5 * $_amount)>>
			<<case "valuables" "junk">><<set $bird.hunts.weight += (0.2 * $_amount)>>
			<<case "feathers">><!-- No weight -->
			<<default>><<set $bird.hunts.weight += $_amount>>
		<</switch>>
	<</if>>
<</widget>>

<<widget "flight_hunt_remove">>
	<<if !_args[0]>>
		<<run Errors.report("No argument specified for widget flight_hunt_remove")>>
	<<elseif typeof _args[0] isnot "string">>
		<<run Errors.report("Non-string provided as first argument for widget flight_hunt_remove")>>
	<<elseif !_args[1] or typeof _args[1] isnot "number">>
		<<run Errors.report("No number argument specified for widget flight_hunt_remove")>>
	<<else>>
		<<set $_looted to _args[0]>><<set $_amount to _args[1]>>
		<<if $bird.materials[$_looted] is undefined>>
			<<run Errors.report("Invalid loot of type; " + $_looted)>>
		<<elseif $bird.hunts.loot[$_looted] is undefined>>
			<<run Errors.report("No loot found of type; " + $_looted)>>
		<<else>>
			<<set $bird.hunts.loot[$_looted] -= $_amount>>
			<<set $bird.hunts.lootAmount -= $_amount>>
		<</if>>
		<<switch $_looted>>
			<<case "tarp">><<set $bird.hunts.weight -= 5>>
			<<case "tools" "pot">><<set $bird.hunts.weight -= 2>>
			<<case "wood">><<set $bird.hunts.weight -= (2 * $_amount)>>
			<<case "leaves">><<set $bird.hunts.weight -= (0.5 * $_amount)>>
			<<case "valuables" "junk">><<set $bird.hunts.weight -= (0.2 * $_amount)>>
			<<case "feathers">><!-- No change -->
			<<default>><<set $bird.hunts.weight -= $_amount>>
		<</switch>>
		<span class="red"><<birdicon $_looted>> $_amount
		<<switch $_looted>>
			<<case "tools">>
				도구 상자
			<<case "sticks">>
				<<pluralise $_amount "나뭇가지" "나뭇가지">>
			<<case "leaves">>
				<<pluralise $_amount "나뭇잎" "나뭇잎">>
			<<case "lurkers">>
				<<pluralise $_amount "럴커" "럴커">>
			<<case "feathers">>
				<<pluralise $_amount "깃털" "깃털">>
			<<default>>
				$_looted
		<</switch>>
		제거되었습니다.</span>
		<<if $bird.hunts.loot[$_looted] lte 0>>
			<<run delete $bird.hunts.loot[$_looted]>>
		<</if>>
	<</if>>
<</widget>>

<<widget "flight_hunt_get_random">>
	<<rng 5>>
	/* set _loot, to be called in <<flight_hunt_return>>. if scene does not use <<flight_hunt_return>>, manually add <<wearProp _loot>> to scene */
	<<switch $rng>>
		<<case 1>>그저 커다란 막대기다. 그래도 챙긴다. <<set _loot to "stick">><<flight_hunt_get "sticks" 1>>
		<<case 2>>방금 막 잡은 럴커다. 챙긴다. <<set _loot to "lurker">><<flight_hunt_get "lurkers" 1>>
		<<case 3>>찢어진 천 조각이다. 챙긴다. <<set _loot to "rag">><<flight_hunt_get "fabric" 1>>
		<<case 4>>그저 유난히 반짝이는 돌이다. 그래도 챙긴다. <<set _loot to "disc">><<flight_hunt_get "junk" 1>>
		<<default>>
			<<set _loot to either("watch", "ring", "necklace", "bracelet")>>
			<<birdLootKr _loot>>【이】다, 또다시 도둑맞은 것 같다. <<flight_hunt_get "valuables" 1 _loot>>
	<</switch>>
<</widget>>

<<widget "flight_hunt_get_ambush">>
	<<set $_ambushLootList to ["towel", "clothing", "clothing", "junk", "firestarter", "wallet", "watch", "money"]>>
	<<set $_lootAmount to _args[0] || random(3,5)>>
	<<for $_lootPass to 0; $_lootPass lt $_lootAmount; $_lootPass++>>
		<<set $_ambushLooted to $_ambushLootList.pluck()>>
		<<switch $_ambushLooted>>
			<<case "towel">>커다란 수건<<flight_hunt_get "fabric" 2>><<set _loot to "rag">>
			<<case "junk">>반짝이는 장신구들<<flight_hunt_get "junk" 1>><<set _loot to "junk">>
			<<case "firestarter">>불피우기 도구<<flight_hunt_get "wood" 2>><<set $bird.hunts.weight -= 2>><<set _loot to "wood">>
			<<case "wallet">>카드와 신분증이 든 지갑<<flight_hunt_get "valuables" 1 "wallet">><<set _loot to "wallet">>
			<<case "watch">>근사한 시계<<flight_hunt_get "valuables" 1 "watch">><<set _loot to "watch">>
			<<case "clothing">>
				<<select_random_clothes_limited "upper" "lower" "under_upper" "under_lower" "legs" "hands">>
				<<if _random_clothes isnot "piece of fabric">>
					<<if setup.clothes[_random_slot][_random_index].word is "an">>
						/* Article omitted in Korean */
					<<elseif setup.clothes[_random_slot][_random_index].word is "a">>
						/* Article omitted in Korean */
					<<else>>
						한 벌의 
					<</if>>
					_random_clothes
				<<else>>
					찢어진 옷가지
				<</if>>
				<<if _random_clothes is "piece of fabric" or $bird.upgrades.wardrobe lt 1>>
					<<flight_hunt_get "fabric" 1>>
				<<else>>
					<<flight_hunt_get "clothing" 1 _random_slot _random_index>>
				<</if>>
				<<set _loot to "rag">>
			<<default>>
				현금 <<moneyGain 30 true true>>
				<<set _loot to "wallet">>
		<</switch>>
		<<if $_lootPass lt $_lootAmount - 1>>
			, 
		<</if>>
	<</for>>
	【을를】 발견했습니다.
	<<wearProp _loot>>
<</widget>>

<<widget "flight_hunt_loot">>
	<<set $_hordeLoot to 0>><<set $_lurkerLoot to 0>><<set $_otherLoot to 0>>
	획득한 물품:
	<br>
	<<for $_lootType, $_tempNum range $bird.hunts.loot>>
		<<if $_lootType is "valuables">>
			<<set $_tempNum to Object.values($_tempNum).reduce((tot, c) => tot + c)>>
		<</if>>
		<<if $_lootType is "clothing">>
			<<set $_tempNum to Object.values($_tempNum).reduce((sum, a) => sum + a.amount, 0)>>
		<</if>>
		<<if $_lootType is "valuables">>
		<<elseif $_lootType is "clothing">>
			<<shopicon "clothing">>
		<<else>>
			<<birdicon $_lootType>>
		<</if>>
		<span class="green">$_tempNum</span>
		<<switch $_lootType>>
			<<case "tools">>
				<<set $_otherLoot++>><<set $bird.upgrades.tools to 1>>
				도구 상자. 안전한 곳에 둔다.
			<<case "pot">>
				<<set $_otherLoot++>><<set $bird.upgrades.pot to 1>>
				냄비. 빗물 웅덩이 근처에 둔다.
			<<case "wood">>
				<<set $_matLoot += $_tempNum>><<set $bird.materials.wood += $_tempNum>>
				나무 조각 $_tempNum개.
			<<case "fabric">>
				<<set $_matLoot += $_tempNum>><<set $bird.materials.fabric += $_tempNum>>
				천 조각 $_tempNum개.
			<<case "sticks">>
				<<set $_matLoot += $_tempNum>><<set $bird.materials.sticks += $_tempNum>>
				나뭇가지 $_tempNum개.
			<<case "leaves">>
				<<set $_matLoot += $_tempNum>><<set $bird.materials.leaves += $_tempNum>>
				큰 나뭇잎 $_tempNum개.
			<<case "junk">>
				<<set $_hordeLoot += $_tempNum>><<set $bird.materials.junk += $_tempNum>>
				반짝이는 잡동사니 $_tempNum개.
			<<case "lurkers">>
				<<set $_lurkerLoot += $_tempNum>><<set $bird.materials.lurkers += $_tempNum>>
				러커 $_tempNum마리.
			<<case "leather">>
				<<set $_matLoot += $_tempNum>><<set $bird.materials.leather += $_tempNum>>
				가공된 가죽 조각 $_tempNum개.
			<<case "feathers">>
				<<set $_matLoot += $_tempNum>><<set $bird.materials.feathers += $_tempNum>>
				깃털 $_tempNum개.
			<<case "tarp">>
				<<set $_hordeLoot++>><<set $bird.upgrades.tarp to 1>>
				큰 방수포.
			<<case "clothing">>
				<<set $_matLoot += $_tempNum>>
				의상 $_tempNum개:
				<<for $_lootClothingType, $_tempObjClothing range $bird.hunts.loot.clothing>>
					<br>
					<<ind>><<clothingicon $_tempObjClothing.full $_tempObjClothing.slot>> <span class="teal">$_tempObjClothing.amount</span>
					$_tempObjClothing.full.name
					<<if !$_tempObjClothing.wear>>
						<<set $wardrobe_location to "birdTower">>
						<<wardrobeSelection true>>
						<<set $_wardrobe to selectWardrobe()>>
						<<if $_wardrobe.space - $_wardrobe[$_tempObjClothing.slot].length lte 0>>
							<span class="red">(공간이 없습니다! 조각 천으로 분해되었습니다.)</span><<set $bird.materials.fabric += 1>>
						<<else>>
							<<set $_wardrobe[$_tempObjClothing.slot].push(clone($_tempObjClothing.full))>>
						<</if>>
					<</if>>
				<</for>>
			<<case "valuables">>
				<<set $_hordeLoot += $_tempNum>>
				귀중품 $_tempNum개:
				<<for $_lootValType, $_tempNumVal range $bird.hunts.loot.valuables>>
					<<if $bird.materials.valuables[$_lootValType] is undefined>>
						<<set $bird.materials.valuables[$_lootValType] to 0>>
					<</if>>
					<<set $bird.materials.valuables[$_lootValType] += $_tempNumVal>>
					<br>
					<<birdicon $_lootValType>><span class="teal">$_tempNumVal</span> <<pluralise $_tempNumVal $_lootValType>>.
				<</for>>
			<<default>>
		<</switch>>
		<br>
	<</for>>
	<<if $_hordeLoot gte 1 and $_matLoot gte 1 and $_otherLoot gte 1>>
		당신은 모든 것을 깔끔하게 무더기로 분류한다.
		<br><br>
	<<elseif $_matLoot gte 2>>
		새로운 재료들을 무더기에 더한다.
		<br><br>
	<<elseif $_hordeLoot gte 2>>
		귀중품들을 저장소에 쌓아둔다.
		<br><br>
	<<elseif $_hordeLoot + $_matLoot + $_otherLoot gte 1>>
		무더기에 추가한다.
		<br><br>
	<<elseif $_hordeLoot + $_matLoot + $_otherLoot is 1>>
		무더기에 추가한다.
		<br><br>
	<</if>>

	<<if $_lurkerLoot gte 1>>
		<<if $bird.hunts.duo is true and $_lurkerLoot gte 2>>
			<<if getChildrenAt("tower").find(child => child.species is "hawk" and childIsBorn(child)) and !$daily.birdBabyFeed>>
				<<getChildrenIds `{location:"tower", excludeUnhatched:true}` "both">>
				<<set _childrenTotal to _childrenIds.length>>
				<<set $daily.birdBabyFeed to true>>
				당신의 반려가 럴커 중 한 마리를 둥지로 가져온다. <<set $bird.materials.lurkers -=1>>
				<<bird_hunt_children_events>>
			<<else>>
				당신의 반려가 럴커 중 한 마리를 순식간에 먹어 치운다. <<set $bird.materials.lurkers -=1>><<feedLurker>>
			<</if>>
			<br><br>
		<<elseif $bird.injured gt 1 and $bird.state is "home">>
			<<link [[거대 매에게 럴커를 먹인다|Bird Tower Hunt End Injured Eat]]>><<set $bird.materials.lurkers -=1>><<endevent>><</link>>
			<br>
		<<elseif npcIsPregnant("Great Hawk") and talkedAboutPregnancy("Great Hawk","pc") and $bird.state is "home">>
			<<link [[거대 매에게 럴커를 먹인다|Bird Tower Hunt End Preggy Eat]]>><<set $bird.materials.lurkers -=1>><<endevent>><</link>>
			<br>
		<</if>>

		<<if getChildrenAt("tower").find(child => child.species is "hawk" and childIsBorn(child)) and !$daily.birdBabyFeed>>
			<<getChildrenIds `{location:"tower", excludeUnhatched:true}` "both">>
			<<set _childrenTotal to _childrenIds.length>>
			<<if _childrenTotal gte 2>>
				<<link [[아이들에게 러커를 먹인다|Bird Tower Hunt End Children]]>><<set $bird.materials.lurkers -=1>><<endevent>><</link>>
			<<else>>
				<<link [[아이에게 러커를 먹인다|Bird Tower Hunt End Children]]>><<set $bird.materials.lurkers -=1>><<endevent>><</link>>
			<</if>>
			<br>
		<</if>>
		<<link [[럴커를 먹는다|Bird Tower Hunt End Eat]]>><<hunger -2000>><<set $bird.materials.lurkers -=1>><<endevent>><</link>>
		<br>
		<<if $bird.upgrades.pot gte 2>>
			<<if getBirdBurnTime() gt 0>>
				<<link [[럴커를 요리해 먹는다 (0:15)|Bird Tower Hunt End Eat Cook]]>><<hunger -2000>><<set $bird.materials.lurkers -=1>><<endevent>><<bird_pass 15>><</link>>
				<br>
			<<else>>
				<span class="red">럴커를 요리하려면 불을 피워야 합니다.</span>
				<br>
				<<link [[화덕으로 간다|Bird Tower Firepit]]>><<endevent>><</link>>
				<br>
			<</if>>
		<</if>>
	<</if>>
	<<link [[계속한다|Bird Tower]]>><<endevent>><</link>>
	<br>
	<<flight_hunt_end>>
<</widget>>

<<widget "towerValuables">>
	<<if $bird.upgrades.decor is 5>>
		<<birdicon "silver">> 은괴가 여느 때처럼 눈부시게 빛난다.
		<br>
	<</if>>
	<<for _valuable, _amount range $bird.materials.valuables>>
		<<if _amount lt 1>><<continue>><</if>>
		<<set $_valuablesMessage to true>>
		<<birdicon _valuable>> _amount 
		<<switch _valuable>>
			<<case "antique bullet">><<pluralise _amount "앤틱 탄환" "앤틱 탄환">>
			<<case "wallet">><<pluralise _amount "지갑" "지갑">>
			<<case "necklace">><<pluralise _amount "목걸이" "목걸이">>
			<<default>><<pluralise _amount _valuable>>
		<</switch>>
		<<capture _valuable _amount>>
			<<link "하나 챙긴다">>
				<<if _valuable is "antique bullet">>
					<<set $antiquemoney += 50>>
					<<museumAntiqueStatus "antiquebullet" "found">>
				<<elseif ["wallet", "necklace"].includes(_valuable)>>
					<<set $blackmoney += 100>>
				<<else>>
					<<set $blackmoney += 50>>
				<</if>>
				<<set $bird.materials.valuables[_valuable] -= 1>>
				<<replace "#towerVal">><<towerValuables>><</replace>>
			<</link>> |
			<<link "전부 챙긴다">>
				<<if $_valuable is "antique bullet">>
					<<set $antiquemoney += (50 * _amount)>>
					<<museumAntiqueStatus "antiquebullet" "found">>
				<<elseif ["wallet", "necklace"].includes(_valuable)>>
					<<set $blackmoney += (100 * _amount)>>
				<<else>>
					<<set $blackmoney += (50 * _amount)>>
				<</if>>
				<<set $bird.materials.valuables[_valuable] to 0>>
				<<replace "#towerVal">><<towerValuables>><</replace>>
			<</link>>
			<br>
		<</capture>>
	<</for>>
	<<if $bird.materials.junk gt 0>>
		<<set $_valuablesMessage to true>>
		<<birdicon "junk">> <<print $bird.materials.junk>>개의 반짝이는 잡동사니
		<br>
	<</if>>
	<<if !$_valuablesMessage>>
		<span class="black">아무것도 없음</span>
		<br>
	<</if>>
<</widget>>

<<widget "flight_hunt_end">>
	<<run delete $bird.hunts.duo>>
	<<run delete $bird.hunts.goal>>
	<<run delete $bird.hunts.weight>>
	<<run delete $bird.hunts.direction>>
	<<run delete $bird.hunts.distanceNorth>>
	<<run delete $bird.hunts.distanceEast>>
	<<run delete $bird.hunts.returnAccept>>
	<<run delete $bird.hunts.loot>>
	<<run delete $bird.hunts.lootAmount>>
	<<run delete $bird.hunts.timer>>
	<<unset $tentLootAmount>>
	<<unset $hkTime>>
	<<unset $ambushTarget>>
	<<unset $birdAmbushTrap>>
<</widget>>

<<widget "eatLurker">>
	<<set $bird.lurkersEaten++>>
	<<if $harpyEggsPrevent and !$harpyEggs and !playerIsPregnant()>>
		<<set $harpyEggsPrevent-->>
		<span class="lewd">알을 낳은 몸이 조금 더 빨리 회복되는 것이 느껴진다.</span>
	<<elseif playerIsPregnant() and playerNormalPregnancyType() is "hawk">>
		<<run addEggCare(getLabouringPregnancy("pc").pregnancyId, 6 * TimeConstants.secondsPerHour)>>
		<<if playerAwareTheyArePregnant()>>
			<span class="lewd">당신의 알에 영양이 공급되었다. 더 빨리 산란할 준비가 될 것이다.</span>
		<<else>>
			<span class="lewd">당신은 몸 안의 무언가가 자리 잡는 것을 느낀다.</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "feedLurker">>
	<<wearProp "lurker">>
	<<if $bird.injured gt 1>>
		<<set $bird.injured-->>
	<</if>>
	<<set _hawkPregnancy to getActivePregnancies("Great Hawk").find(p => childBaseSpecies(p.donorSpecies) is "hawk")>>
	<<if _hawkPregnancy>>
		<<run addEggCare(_hawkPregnancy.pregnancyId, 6 * TimeConstants.secondsPerHour)>>
	<</if>>
<</widget>>

<<widget "firepitTime">>
	남은 연소 시간: <<print getTimeString(getBirdBurnTime())>>
	<<if Weather.precipitation is "rain" and $bird.upgrades.shelter is 0>>
		<span class="red">비를 피할 가림막이 있다면 두 배는 더 오래 탈 것이다.</span>
	<</if>>
<</widget>>

<<widget "firepitActions">>
	<<if !$bird.upgrades.firepit>><<exit>><</if>>
	<<firepitTime>>
	<br><br>

	<<set $_maxTime to Math.floor($bird.firepit.maxBurnTime / 60)>>
	<<birdicon "firepit">>당신의 화덕은 최대 <<print Math.floor($_maxTime / 60)>>시간 정도 연소할 수 있습니다.
	<br>

	<<set _maxTimeAllowed to Math.clamp($_maxTime - getBirdBurnTime(), 0, $_maxTime)>>

	<<if _maxTimeAllowed is 0>>
		<span class="green">불길이 이미 매우 강력합니다.</span>
		<br>
	<</if>>

	<<if $bird.materials.wood is 0>>
		<<birdicon "wood">><span class="red">추가할 장작이 없습니다.</span>
		<br>
	<<elseif _maxTimeAllowed gt 0>>
		<<set _timeWood to 240>>
		<<if Weather.precipitation is "rain" and $bird.upgrades.shelter is 0>>
			<<set _timeWood to Math.floor(_timeWood / 2)>>
		<</if>>
		<<set _timeLteMax to _timeWood lte _maxTimeAllowed>>

		당신은 장작 $bird.materials.wood <<pluralise $bird.materials.wood "개" "개">>【을를】 가지고 있습니다.
		<br>
		<<birdicon "wood">><<link "장작 1개 추가">>
			<<set $bird.materials.wood-->>
			<<run Cooker.addBurnTime($bird.firepit, _timeWood * 60)>>
			<<replace #firepitActions>><<firepitActions>><</replace>>
			<<run Weather.Observables.checkForUpdate()>>
		<</link>><<note `"+ " + getTimeString(Math.min(_timeWood, _maxTimeAllowed))` `_timeLteMax ? "green" : "orange"`>>
		<br>
		<<if $bird.materials.wood gte 2 and _timeWood lt _maxTimeAllowed>>
			<<set _timeLteMax to _timeWood * 2 lte _maxTimeAllowed>>
			<<birdicon "wood">><<link "장작 2개 추가">>
				<<set $bird.materials.wood -= 2>>
				<<run Cooker.addBurnTime($bird.firepit, _timeWood * 120)>>
				<<replace #firepitActions>><<firepitActions>><</replace>>
				<<run Weather.Observables.checkForUpdate()>>
			<</link>><<note `"+ " + getTimeString(Math.min(_timeWood * 2, _maxTimeAllowed))` `_timeLteMax ? "green" : "orange"`>>
			<br>
		<</if>>
		<<if $bird.materials.wood gte 3 and _timeWood * 2 lt _maxTimeAllowed>>
			<<set _timeLteMax to _timeWood * 3 lte _maxTimeAllowed>>
			<<birdicon "wood">><<link "장작 3개 추가">>
				<<set $bird.materials.wood -= 3>>
				<<run Cooker.addBurnTime($bird.firepit, _timeWood * 180)>>
				<<replace #firepitActions>><<firepitActions>><</replace>>
				<<run Weather.Observables.checkForUpdate()>>
			<</link>><<note `"+ " + getTimeString(Math.min(_timeWood * 3, _maxTimeAllowed))` `_timeLteMax ? "green" : "orange"`>>
			<br>
		<</if>>
	<</if>>
	<br>

	<<if $bird.materials.sticks is 0>>
		<<birdicon "sticks">><span class="red">추가할 나뭇가지가 없습니다.</span>
		<br>
	<<elseif _maxTimeAllowed gt 0>>
		<<set _timeSticks to 60>>
		<<if Weather.precipitation is "rain" and $bird.upgrades.shelter is 0>>
			<<set _timeSticks to Math.floor(_timeSticks / 2)>>
		<</if>>
		<<set _timeLteMax to _timeSticks lte _maxTimeAllowed>>

		나뭇가지 $bird.materials.sticks <<pluralise $bird.materials.sticks "개" "개">>【을를】 가지고 있습니다.
		<br>
		<<birdicon "sticks">><<link "나뭇가지 1개 추가">>
			<<set $bird.materials.sticks-->>
			<<run Cooker.addBurnTime($bird.firepit, _timeSticks * 60)>>
			<<replace #firepitActions>><<firepitActions>><</replace>>
			<<run Weather.Observables.checkForUpdate()>>
		<</link>><<note `"+ " + getTimeString(Math.min(_timeSticks, _maxTimeAllowed))` `_timeLteMax ? "green" : "orange"`>>
		<br>
		<<if $bird.materials.sticks gte 3 and _timeSticks lt _maxTimeAllowed>>
			<<set _timeLteMax to _timeSticks * 3 lte _maxTimeAllowed>>
			<<birdicon "sticks">><<link "나뭇가지 3개 추가">>
				<<set $bird.materials.sticks -= 3>>
				<<run Cooker.addBurnTime($bird.firepit, _timeSticks * 180)>>
				<<replace #firepitActions>><<firepitActions>><</replace>>
				<<run Weather.Observables.checkForUpdate()>>
			<</link>><<note `"+ " + getTimeString(Math.min(_timeSticks * 3, _maxTimeAllowed))` `_timeLteMax ? "green" : "orange"`>>
			<br>
		<</if>>
		<<if $bird.materials.sticks gte 5 and _timeSticks * 3 lt _maxTimeAllowed>>
			<<set _timeLteMax to _timeSticks * 5 lte _maxTimeAllowed>>
			<<birdicon "sticks">><<link "나뭇가지 5개 추가">>
				<<set $bird.materials.sticks -= 5>>
				<<run Cooker.addBurnTime($bird.firepit, _timeSticks * 300)>>
				<<replace #firepitActions>><<firepitActions>><</replace>>
				<<run Weather.Observables.checkForUpdate()>>
			<</link>><<note `"+ " + getTimeString(Math.min(_timeSticks * 5, _maxTimeAllowed))` `_timeLteMax ? "green" : "orange"`>>
			<br>
		<</if>>
	<</if>>
	<br>

	<<if $bird.materials.lurkers is 0>>
		<<set $_noLurkers to true>>
		<span class="red">럴커가 0마리 있습니다.</span>
	<<elseif $bird.materials.lurkers gte 1>>
		럴커 $bird.materials.lurkers <<pluralise $bird.materials.lurkers "마리" "마리">>【을를】 가지고 있습니다.
	<</if>>
	<br>
	<<if $bird.upgrades.rack gte 1>>
		<<set $_rackMax to $bird.firepit.maxItems>>
		<<set _lurkersDrying to Cooker.getItemsNotReady($bird.firepit)>>
		<<set $_nLurkersDrying to _lurkersDrying.length>>
		<<set _nLurkersReady to $bird.firepit.items.length - $_nLurkersDrying>>

		<<birdicon "rack">>당신의 건조대는 최대 $_rackMax마리의 럴커를 걸 수 있습니다.
		<br>
		<<if $_nLurkersDrying gte 1>>
			<<birdicon "lurkers">>
			<<if $bird.firepit.items.length is $_rackMax>>
				<i class="blue">현재 꽉 차 있으며,</i> $_nLurkersDrying <<pluralise $_nLurkersDrying "마리" "마리">>【을를】 건조 중입니다.
			<<else>>
				현재 $_nLurkersDrying <<pluralise $_nLurkersDrying "마리" "마리">>【을를】 건조 중입니다.
			<</if>>
			<<if getBirdBurnTime() gt 0>>
				<<if $bird.upgrades.rack lt 3>>
					<span class="lewd"><<if $_nLurkersDrying gte 2>>그것들에서<<else>>그것에서<</if>> 기묘한 연기가 뿜어져 나오고 있다.</span> <<gdrugged>>
				<<else>>
					<span class="teal"><<if $_nLurkersDrying gte 2>>그것들에서<<else>>그것에서<</if>> 피어오른 기묘한 연기가 무해하게 탑 밖으로 빠져나간다.</span>
				<</if>>
			<<else>>
				<span class="pink">화덕에 불을 피우면 과정이 빨라질 것이다.</span>
			<</if>>
			<br>
			<<if $debug is 1>>
				<span class="gold">DEBUG:</span> 럴커 남은 시간
				<br>
				<<for $_i to 0; $_i lt _lurkersDrying.length; $_i++>>
					- 럴커 <<print $_i + 1>>:
					<<print getTimeString(Math.floor((
						($bird.firepit.cookTime.lurker - _lurkersDrying[$_i].timeBonus - _lurkersDrying[$_i].bonusElapsed)
						- ($timeStamp - _lurkersDrying[$_i].startedAt)
					) / 60))>>
					<br>
				<</for>>
			<</if>>
		<<else>>
			<<birdicon "lurkers">>건조 중인 럴커가 없습니다.
			<br>
		<</if>>
		<<if $bird.firepit.items.length is $_rackMax or $_noLurkers>>
		<<else>>
			<<birdicon "rack">><<link [[건조대에 럴커를 올린다 (0:02)|Bird Tower Firepit]]>>
				<<set $bird.materials.lurkers-->>
				<<run Cooker.cookItem($bird.firepit, Cooker.createItem($bird.firepit, 'lurker', true))>>
				<<bird_pass 2>>
			<</link>>
			<br>
		<</if>>
		<<if $_nLurkersDrying gte 1>>
			<<birdicon "rack">>
			<<link "럴커 하나 꺼내기">>
				/* assumes last item is the most recently added lurker */
				<<run $bird.firepit.items.pop()>>
				<<set $bird.materials.lurkers++>>
				<<replace #firepitActions>><<firepitActions>><</replace>>
			<</link>>
			<<if $_nLurkersDrying gte 2>> |
				<<link "모든 럴커 꺼내기">>
					<<set $bird.materials.lurkers += _lurkersDrying.length>>
					<<set $bird.firepit.items to Cooker.getItemsReady($bird.firepit)>>
					<<replace #firepitActions>><<firepitActions>><</replace>>
				<</link>>
			<</if>>
			<br>
		<</if>>
		<<if _nLurkersReady gte 1>>
			<<birdicon "lurkers">><span class="green">_nLurkersReady마리의 럴커가<<if _nLurkersReady gte 2>> 모두<<else>><</if>> 준비되었습니다.</span>
			<br>
			<<birdicon "leather">><<link `"가죽 " + _nLurkersReady + "개 획득"`>>
				<<set $bird.materials.leather += _nLurkersReady>>
				<<set $bird.firepit.items to _lurkersDrying>>
				<<replace #firepitActions>><<firepitActions>><</replace>>
			<</link>>
		<<else>>
			<<birdicon "lurkers">>준비된 럴커가 없습니다.
		<</if>>
		<br>
	<</if>>
	<br>

	<<if getBirdBurnTime() gt 0>>
		<<birdicon "firepit">><<link [[휴식 (0:15)|Bird Tower Firepit Warmth]]>><<bird_pass 15>><</link>><<gwarmth>>
		<br>
	<</if>>
	<<if $bird.upgrades.pot gte 2 and !$_noLurkers and getBirdBurnTime() gt 0>>
		<<birdicon "pot_cook">><<link [[럴커를 요리한다 (0:15)|Bird Tower Lurker Cook]]>><<set $bird.materials.lurkers -= 1>><<bird_pass 15>><</link>>
		<br>
	<</if>>
	<br>
<</widget>>

<<widget "towerBuildOption">>
	<div>
		<<set _upgrade to _args[0]>>
		<<if _towerUpgrades is undefined>><<set _towerUpgrades to {}>><</if>>
		<<set _towerUpgrades[_upgrade] to {}>>
		<<set $_upgrade to _towerUpgrades[_upgrade]>>
		<<switch _upgrade>>
			<<case "duster">>
				<span class="teal">깃털 먼지떨이</span>: 탑을 청소하기 더 쉬워집니다.
				<<set $_upgrade.passage to "Bird Tower Build Duster">>
				<<set $_upgrade.timeTaken to 10>>
				<<set $_upgrade.materialsUsed to {
					sticks: 1,
					fabric: 1,
					feathers: 6
				}>>
				<<set $_upgrade.housekeeping to 100>>
				<<set $_upgrade.clothingSlot to "handheld">>
				<<set $_upgrade.clothingIndex to 10>>
			<<case "clip">>
				<span class="teal">깃털 머리핀</span>: 붕 뜬 기분이 들게 해줍니다.
				<<set $_upgrade.passage to "Bird Tower Build Clip">>
				<<set $_upgrade.timeTaken to 10>>
				<<set $_upgrade.materialsUsed to {
					fabric: 1,
					junk: 1,
					feathers: 3
				}>>
				<<set $_upgrade.upgradesRequired to {
					tools: 1
				}>>
				<<set $_upgrade.housekeeping to 200>>
				<<set $_upgrade.clothingSlot to "head">>
				<<set $_upgrade.clothingIndex to 31>>
				<<set $_upgrade.colourSelectNeeded to true>>
			<<case "shelter">>
				<<switch $bird.upgrades.shelter>>
					<<case 0>>
						<span class="red">허술한 은신처 (0)</span>: 비가 샙니다.
						<<set $_upgrade.passage to "Bird Tower Build Shelter 1">>
						<<set $_upgrade.timeTaken to 15>>
						<<set $_upgrade.materialsUsed to {
							fabric: 1,
							leaves: 5
						}>>
						<<set $_upgrade.housekeeping to 0>>
					<<case 1>>
						<span class="purple">임시 은신처 (1)</span>: 비를 막아주지만, 쉽게 부서질 수 있습니다.
						<<set $_upgrade.passage to "Bird Tower Build Shelter 2">>
						<<set $_upgrade.timeTaken to 90>>
						<<set $_upgrade.materialsUsed to {
							wood: 2,
							sticks: 2,
							leaves: 5,
						}>>
						<<set $_upgrade.upgradesRequired to {
							tools: 1,
							tarp: 1
						}>>
						<<set $_upgrade.housekeeping to 100>>
					<<case 2>>
						<span class="teal">방수포 은신처 (2)</span>: 비를 막아줍니다.
						<<set $_upgrade.passage to "Bird Tower Build Shelter 3">>
						<<set $_upgrade.timeTaken to 120>>
						<<set $_upgrade.materialsUsed to {
							wood: 4,
							fabric: 2,
							sticks: 10,
							leather: 2
						}>>
						<<set $_upgrade.upgradesRequired to {
							tools: 1,
							tarp: 1
						}>>
						<<set $_upgrade.gradeRequired to {
							science: 2
						}>>
						<<set $_upgrade.housekeeping to 200>>
					<<case 3>>
						<span class="green">개량된 방수포 은신처 (3)</span>: 비를 막아주면서도 연기가 빠져나갈 수 있게 환기가 잘 됩니다.
				<</switch>>
			<<case "nest">>
				<<switch $bird.upgrades.nest>>
					<<case 0>>
						<span class="red">나무 둥지 (0)</span>: 수면의 질이 나쁩니다. 불편합니다.
						<<set $_upgrade.passage to "Bird Tower Build Nest 1">>
						<<set $_upgrade.timeTaken to 30>>
						<<set $_upgrade.materialsUsed to {
							fabric: 2,
							leaves: 2
						}>>
						<<set $_upgrade.housekeeping to 100>>
					<<case 1>>
						<span class="purple">푹신한 둥지 (1)</span>: 수면의 질을 약간 개선합니다. 가시가 박히지 않습니다.
						<<set $_upgrade.passage to "Bird Tower Build Nest 2">>
						<<set $_upgrade.timeTaken to 90>>
						<<set $_upgrade.materialsUsed to {
							wood: 2,
							fabric: 6,
							sticks: 2,
							leaves: 6,
						}>>
						<<set $_upgrade.activityRequired to ["build","brood","rest","sleep"]>>
						<<set $_upgrade.housekeeping to 300>>
					<<case 2>>
						<span class="teal">쿠션이 있는 둥지 (2)</span>: 수면의 질을 개선합니다. 편안합니다.
						<<set $_upgrade.passage to "Bird Tower Build Nest 3">>
						<<set $_upgrade.timeTaken to 240>>
						<<set $_upgrade.materialsUsed to {
							wood: 8,
							fabric: 8,
							sticks: 8,
							leaves: 10,
							junk: 4,
							leather: 4,
							feathers: 16
						}>>
						<<set $_upgrade.upgradesRequired to {
							tools: 1
						}>>
						<<set $_upgrade.activityRequired to ["build","brood","rest","sleep"]>>
						<<set $_upgrade.housekeeping to 500>>
					<<case 3>>
						<span class="green">고급스러운 둥지 (3)</span>: 수면의 질을 크게 개선합니다. 보기에도 좋습니다.
				<</switch>>
			<<case "firepit">>
				<<switch $bird.upgrades.firepit>>
					<<case 0>>
						<span class="red">화덕 없음 (0)</span>: 밤이 어둡고 춥습니다.
						<<set $_upgrade.passage to "Bird Tower Build Firepit 1">>
						<<if Weather.precipitation is "rain" and $bird.upgrades.shelter is 0>>
							<<set $_upgrade.timeTaken to 60>>
						<<else>>
							<<set $_upgrade.timeTaken to 15>>
						<</if>>
						<<set $_upgrade.materialsUsed to {
							wood: 2,
							sticks: 2
						}>>
						<<set $_upgrade.housekeeping to 0>>
					<<case 1>>
						<span class="purple">임시 화덕 (1)</span>: 따뜻함을 유지해주지만 금방 타버립니다. 걱정할 만큼 많은 연기를 내지는 않습니다. 이보다 큰 화덕은 제대로 된 환기 시설이 필요합니다.
						<<set $_upgrade.passage to "Bird Tower Build Firepit 2">>
						<<set $_upgrade.timeTaken to 60>>
						<<set $_upgrade.materialsUsed to {
							wood: 6,
							sticks: 10,
							junk: 2
						}>>
						<<set $_upgrade.upgradesRequired to {
							shelter: 3
						}>>
						<<set $_upgrade.housekeeping to 0>>
					<<case 2>>
						<span class="teal">튼튼한 화덕 (2)</span>: 더 오래 탑니다. 럴커 건조 속도를 높여줍니다.
						<<set $_upgrade.passage to "Bird Tower Build Firepit 3">>
						<<set $_upgrade.timeTaken to 120>>
						<<set $_upgrade.materialsUsed to {
							wood: 8,
							sticks: 12,
							junk: 4,
							leather: 2
						}>>
						<<set $_upgrade.upgradesRequired to {
							shelter: 3
						}>>
						<<set $_upgrade.housekeeping to 0>>
					<<case 3>>
						<span class="green">모닥불 (3)</span>: 오랫동안 탑니다. 럴커를 빠르게 굽고 건조시킵니다. 아늑합니다.
				<</switch>>
			<<case "pot">>
				<!-- This is set up as intended, I know it looks weird but the upgrade value gets set to 1 when the player finds the cooking pot -->
				<<switch $bird.upgrades.pot>>
					<<case 0>>
						<span class="red">조리용 냄비 없음 (0)</span>: 캠프장 같은 곳에서 찾아야 합니다.
						<<set $_upgrade.passage to "Bird Tower Build Cooking">>
						<<set $_upgrade.timeTaken to 60>>
						<<set $_upgrade.materialsUsed to {
							wood: 3,
							fabric: 3,
							sticks: 3
						}>>
						<<set $_upgrade.upgradesRequired to {
							pot: 1,
							firepit: 1
						}>>
						<<set $_upgrade.housekeeping to 0>>
					<<case 1>>
						<span class="purple">설치되지 않은 냄비 (1)</span>: 사용하려면 화덕 위에 거치대가 필요합니다.
						<<set $_upgrade.passage to "Bird Tower Build Cooking">>
						<<set $_upgrade.timeTaken to 60>>
						<<set $_upgrade.materialsUsed to {
							wood: 3,
							fabric: 3,
							sticks: 3
						}>>
						<<set $_upgrade.upgradesRequired to {
							pot: 1,
							firepit: 1
						}>>
						<<set $_upgrade.housekeeping to 100>>
					<<case 2>>
						<span class="teal">조리용 냄비 (2)</span>: 럴커를 요리할 수 있습니다. 기지를 발휘한다면, 빗물 목욕물을 데우는 데 쓸 수도 있을 것입니다.
						<<set $_upgrade.passage to "Bird Tower Build Heating">>
						<<set $_upgrade.timeTaken to 180>>
						<<set $_upgrade.materialsUsed to {
							wood: 6,
							fabric: 8,
							sticks: 6,
							junk: 4,
							leather: 8
						}>>
						<<set $_upgrade.upgradesRequired to {
							tools: 1,
							firepit: 3
						}>>
						<<set $_upgrade.gradeRequired to {
							science: 4
						}>>
						<<set $_upgrade.housekeeping to 300>>
					<<case 3>>
						<span class="green">조리용 냄비 및 가열 장치 (3)</span>: 럴커를 요리할 수 있습니다. 빗물 목욕물을 기분 좋게 따뜻한 온도로 데워줍니다.
				<</switch>>
			<<case "rack">>
				<<switch $bird.upgrades.rack>>
					<<case 0>>
						<span class="red">건조대 없음 (0)</span>: 럴커를 말릴 수 없습니다.
						<<set $_upgrade.passage to "Bird Tower Build Rack 1">>
						<<set $_upgrade.timeTaken to 60>>
						<<set $_upgrade.materialsUsed to {
							wood: 1,
							fabric: 1,
							sticks: 2
						}>>
						<<set $_upgrade.upgradesRequired to {
							firepit: 1
						}>>
						<<set $_upgrade.housekeeping to 0>>
					<<case 1>>
						<span class="purple">임시 건조대 (1)</span>: 가죽을 위해 럴커를 건조시킬 수 있습니다. 화덕에 불을 피우면 속도가 눈에 띄게 빨라집니다.
						<<set $_upgrade.passage to "Bird Tower Build Rack 2">>
						<<set $_upgrade.timeTaken to 60>>
						<<set $_upgrade.materialsUsed to {
							wood: 4,
							fabric: 4,
							sticks: 4,
							junk: 2,
							leather: 4
						}>>
						<<set $_upgrade.upgradesRequired to {
							tools: 1
						}>>
						<<set $_upgrade.housekeeping to 200>>
					<<case 2>>
						<span class="teal">확장된 건조대 (2)</span>: 한 번에 더 많은 럴커를 말릴 수 있습니다.
						<<set $_upgrade.passage to "Bird Tower Build Rack 3">>
						<<set $_upgrade.timeTaken to 120>>
						<<set $_upgrade.materialsUsed to {
							wood: 8,
							sticks: 12,
							leaves: 4,
							junk: 4,
							leather: 8
						}>>
						<<set $_upgrade.upgradesRequired to {
							tools: 1,
							shelter: 3
						}>>
						<<set $_upgrade.housekeeping to 600>>
					<<case 3>>
						<span class="green">밀폐형 건조대 (3)</span>: 한 번에 많은 럴커를 건조시킬 수 있습니다. 유해한 가스가 새어나오지 않습니다.
				<</switch>>
			<<case "snare">>
				<<switch $bird.upgrades.snare>>
					<<case 0>>
						<span class="red">덫 없음 (0)</span>: 덫을 만들어 안뜰에서 럴커를 잡으세요.
						<<set $_upgrade.passage to "Bird Tower Build Snare 1">>
						<<set $_upgrade.timeTaken to 120>>
						<<set $_upgrade.materialsUsed to {
							wood: 2,
							fabric: 2,
							sticks: 1,
							leaves: 2,
							junk: 1,
							leather: 3
						}>>
						<<set $_upgrade.upgradesRequired to {
							tools: 1
						}>>
						<<set $_upgrade.housekeeping to 500>>
					<<case 1>>
						<span class="green">임시 덫 (1)</span>: 안뜰에서 가끔 럴커를 잡습니다.
				<</switch>>
			<<case "decor">>
				<<switch $bird.upgrades.decor>>
					<<case 0>>
						<span class="red">사냥 전리품 없음 (0)</span>: 사냥 후 스트레스 감소 효과가 없습니다.
						<<set $_upgrade.passage to "Bird Tower Build Decor 1">>
						<<set $_upgrade.timeTaken to 120>>
						<<set $_upgrade.materialsUsed to {
							wood: 2,
							fabric: 2,
							sticks: 2,
							leaves: 2,
							junk: 4,
							lurkers: 2,
							feathers: 4
						}>>
						<<set $_upgrade.housekeeping to 200>>
					<<case 1>>
						<span class="purple">간단한 사냥 전리품 (1)</span>: 사냥을 성공하고 돌아올 때마다 스트레스를 약간 줄여줍니다.
						<<set $_upgrade.passage to "Bird Tower Build Decor 2">>
						<<set $_upgrade.timeTaken to 240>>
						<<set $_upgrade.materialsUsed to {
							wood: 3,
							fabric: 3,
							sticks: 3,
							leaves: 3,
							junk: 6,
							lurkers: 6,
							feathers: 6
						}>>
						<<set $_upgrade.upgradesRequired to {
							tools: 1
						}>>
						<<set $_upgrade.housekeeping to 400>>
					<<case 2>>
						<span class="blue">만족스러운 사냥 전리품 (2)</span>: 사냥을 성공하고 돌아올 때마다 스트레스를 줄여줍니다.
						<<set $_upgrade.passage to "Bird Tower Build Decor 3">>
						<<set $_upgrade.timeTaken to 240>>
						<<set $_upgrade.materialsUsed to {
							wood: 4,
							fabric: 10,
							sticks: 4,
							leaves: 4,
							junk: 10,
							lurkers: 8,
							feathers: 12
						}>>
						<<set $_upgrade.upgradesRequired to {
							mirror: 1,
							tools: 1,
							shelter: 2,
							nest: 2
						}>>
						<<set $_upgrade.activityRequired to ["build","brood","rest","sleep"]>>
						<<set $_upgrade.housekeeping to 600>>
					<<case 3>>
						<span class="teal">인상적인 사냥 전리품 (3)</span>: 사냥을 성공하고 돌아올 때마다 스트레스를 크게 줄여줍니다.
						<<set $_upgrade.passage to "Bird Tower Build Decor 4">>
						<<set $_upgrade.timeTaken to 240>>
						<<set $_upgrade.materialsUsed to {
							wood: 6,
							sticks: 10,
							junk: 40,
							lurkers: 30,
							feathers: 15
						}>>
						<<set $_upgrade.upgradesRequired to {
							mirror: 1,
							tools: 1,
							tarp: 1,
							telescope: 1,
							shelter: 3,
							nest: 3,
							wardrobe: 1
						}>>
						<<set $_upgrade.activityRequired to ["build","brood","rest","sleep"]>>
						<<set $_upgrade.housekeeping to 800>>
					<<case 4>>
						<span class="green">경이로운 사냥 전리품 (4)</span>: 성공적인 사냥 후 스트레스가 엄청나게 줄어들며 트라우마도 일부 감소합니다. 하지만 여전히 무언가 부족합니다...
						<<set $_upgrade.passage to "Bird Tower Build Decor Silver">>
						<<set $_upgrade.timeTaken to 120>>
						<<set $_upgrade.materialsUsed to {
							wood: 6,
							fabric: 5,
							sticks: 2,
							junk: 4,
							leather: 4
						}>>
						<<set $_upgrade.activityRequired to ["build","brood","rest","sleep"]>>
					<<case 5>>
						<span class="gold">전설적인 사냥 전리품 (5)</span>: 성공적인 사냥 후 스트레스가 완전히 사라지며 트라우마도 일부 감소합니다. 공포는 이제 적수를 만났습니다.
				<</switch>>
			<<case "wardrobe">>
				<<switch $bird.upgrades.wardrobe>>
					<<case 0>>
						<span class="red">옷장 없음</span>: 옷을 보관할 수 없습니다.
						<<set $_upgrade.passage to "Bird Tower Build Wardrobe">>
						<<set $_upgrade.timeTaken to 60>>
						<<set $_upgrade.materialsUsed to {
							wood: 20,
							fabric: 8,
							sticks: 10,
							leaves: 10,
							junk: 6,
							lurkers: 4,
							leather: 4,
							feathers: 6
						}>>
						<<set $_upgrade.upgradesRequired to {
							mirror: 1,
							tools: 1
						}>>
						<<set $_upgrade.housekeeping to 700>>
					<<case 1>>
						<span class="green">옷장</span>: 의류를 이용할 수 있습니다.
				<</switch>>
			<<default>>
				<span class="red">잘못된 옵션: _upgrade</span>
		<</switch>>

		<<if !$_upgrade.passage>>
			<<exit>>
		<</if>>

		<<if currentSkillValue('housekeeping') lt $_upgrade.housekeeping>>
			<br>
			<span class="black">
				<<skilllettergrade $_upgrade.housekeeping>> 가사 스킬이 필요합니다.
			</span>
			<<set $_disableBuild to true>>
		<</if>>

		<<if $_upgrade.gradeRequired>>
			<<for $_grade range Object.keys($_upgrade.gradeRequired)>>
				<<if V[$_grade + "trait"] lt $_upgrade.gradeRequired[$_grade]>>
					<<set $_spColour to "black">>
					<<set $_disableBuild to true>>
				<<else>>
					<<set $_spColour to "green">>
				<</if>>
				<<set $_gradeDisplay to ({ english: "영어", maths: "수학", science: "과학", history: "역사" })[$_grade] || $_grade>>
				<br>
				<span @class="$_spColour">
				<<switch $_upgrade.gradeRequired[$_grade]>>
					<<case 1>>나쁘지 않은 $_gradeDisplay 성적이 필요합니다
					<<case 2>>꽤 좋은 $_gradeDisplay 성적이 필요합니다
					<<case 3>>좋은 $_gradeDisplay 성적이 필요합니다
					<<case 4>>훌륭한 $_gradeDisplay 성적이 필요합니다
				<</switch>>
				</span>
			<</for>>
		<</if>>

		<<if $_upgrade.activityRequired>>
			<br>
			<<if $bird.state isnot "home" or !$_upgrade.activityRequired.includes($bird.activity)>>
				<span class="red">거대 매가 둥지에 있어야 합니다.</span>
				<<set $_disableBuild to true>>
			<<else>>
				<span class="green">거대 매가 둥지에 있어야 합니다.</span>
			<</if>>
		<</if>>

		<<if $_upgrade.upgradesRequired>>
			<<set _birdUpgradeKr to { tools: "도구", telescope: "망원경", tarp: "방수포", pot: "냄비", mirror: "거울", wardrobe: "옷장", firepit: "화덕", nest: "둥지", shelter: "쉼터" }>>
			<<for $_uReq range Object.keys($_upgrade.upgradesRequired)>>
				<<if $bird.upgrades[$_uReq] lt $_upgrade.upgradesRequired[$_uReq]>>
					<<set $_spColour to "black">>
					<<set $_disableBuild to true>>
				<<else>>
					<<set $_spColour to "green">>
				<</if>>
				<br>
				<<birdicon $_uReq>>
				<span @class="$_spColour">
				<<if ["tools", "telescope", "tarp", "pot", "mirror", "wardrobe"].includes($_uReq)>>
					<<print _birdUpgradeKr[$_uReq] || $_uReq>>【이가】 필요합니다
				<<else>>
					$_upgrade.upgradesRequired[$_uReq]단계 <<print _birdUpgradeKr[$_uReq] || $_uReq>>【이가】 필요합니다
				<</if>>
				</span>
			<</for>>
		<</if>>

		<<if $_upgrade.materialsUsed>>
			<<set _birdMaterialKr to { wood: "목재", sticks: "나뭇가지", leaves: "나뭇잎", fabric: "천", leather: "가죽", feathers: "깃털", lurkers: "럴커", junk: "잡동사니", silver: "은괴" }>>
			<<for $_material, $_amtReq range $_upgrade.materialsUsed>>
				<<if $bird.materials[$_material] lt $_amtReq>>
					<<set $_spColour to "black">>
					<<set $_disableBuild to true>>
				<<else>>
					<<set $_spColour to "green">>
				<</if>>
				<br>
				<<birdicon $_material>>
				<span @class="$_spColour">
					<<print _birdMaterialKr[$_material] || $_material>>【이가】 필요합니다
					(<<print $bird.materials[$_material]>>/$_amtReq)
				</span>
			<</for>>
			<<if _upgrade is "decor" and $bird.upgrades.decor is 4>>
				<br>
				<<if $bird.hunts.estate isnot "complete">>
					<<set $_disableBuild to true>>
					<span class="black">뭔가 특별한 것...</span>
				<<else>>
					<<birdicon "silver">> <span class="green">은괴 필요</span>
				<</if>>
			<</if>>
		<</if>>

		<<if $_upgrade.clothingSlot>>
			<<if $worn[$_upgrade.clothingSlot].cursed is 1>>
				<br>
				<span class="red">$worn[$_upgrade.clothingSlot].name【을를】 벗을 수 없습니다!</span>
				<<set $_disableBuild to true>>
			<<elseif $worn[$_upgrade.clothingSlot].index is $_upgrade.clothingIndex>>
				<br>
				<span class="purple">이미 이것을 <<if $_upgrade.clothingSlot is "handheld">>들고<<else>>입고<</if>> 있습니다!</span>
				<<set $_disableBuild to true>>
			<<elseif $_upgrade.clothingIndex is 12 and $bird.duster is true>>
				<br>
				<span class="purple">이것은 이미 걸려 있습니다.</span>
				<<set $_disableBuild to true>>
			<<elseif $bird.upgrades.wardrobe is 1 and getOwnedClothingCount($_upgrade.clothingIndex, $_upgrade.clothingSlot) gte 1>>
				<br>
				<span class="blue">당신은 이미 이것을 <<print getOwnedClothingCount($_upgrade.clothingIndex, $_upgrade.clothingSlot)>>개 가지고 있습니다.</span>
			<<elseif $worn[$_upgrade.clothingSlot].name isnot "naked">>
				<br>
				<span class="blue">현재 장비한 <<print $worn[$_upgrade.clothingSlot].name>>【을를】 교체합니다</span>
			<</if>>
		<</if>>

		<<if _upgrade is "firepit" and $bird.firepit.items.length>>
			<br>
			<span class="red">화덕에 현재 아이템이 들어 있습니다</span>
			<<set $_disableBuild to true>>
		<</if>>

		<<if $_disableBuild>>
			<<exit>>
		<</if>>

		<<set $_linkText to ($bird.upgrades[_upgrade] is 0 or $bird.upgrades[_upgrade] is undefined ? "Build" : "Improve")>>
		<<if $_upgrade.timeTaken>>
			<<set $_linkText += ` (${getTimeString($_upgrade.timeTaken)})`>>
		<</if>>

		<br>
		<<capture _upgrade>>
			<<link [[$_linkText|_towerUpgrades[_upgrade].passage]]>>
				<<if _towerUpgrades[_upgrade].clothingSlot>>
					<<if !_towerUpgrades[_upgrade].colourSelectNeeded>>
						<<generalWear _towerUpgrades[_upgrade].clothingSlot _towerUpgrades[_upgrade].clothingIndex>>
					<</if>>
				<<else>>
					<<set $bird.upgrades[_upgrade]++>>
				<</if>>
				<<if _towerUpgrades[_upgrade].timeTaken>><<bird_pass _towerUpgrades[_upgrade].timeTaken>><</if>>
				<<if _towerUpgrades[_upgrade].materialsUsed>>
					<<run Object.entries(_towerUpgrades[_upgrade].materialsUsed).forEach(([mat, amt]) => {
						V.bird.materials[mat] -= amt;
					})>>
				<</if>>
				<<if _towerUpgrades[_upgrade].housekeeping gt 0>>
					<<set _houseKeepingUp to ($bird.upgrades[_upgrade] * 4)>>
					<<housekeeping _houseKeepingUp>>
				<</if>>
			<</link>>
		<</capture>>
	</div>
<</widget>>

<<widget "birdEggLayEvent">>
	<<endevent>>
	<<npc "Great Hawk">>
	<<if _args[0] isnot undefined and typeof _args[0] is "string">>
		<<set $birdEggContext to _args[0]>>
	<</if>>
	<<if $birdEggContext is "sleep">>
		잠에서 깨어 둥지 한쪽에 앉아 있는 <<your_bird_text>>【을를】 본다.
	<<elseif $birdEggContext is "perch">>
		<<your_bird_text "cap">>【이가】 갑자기 불편해 보인다. <<bHe>>【은는】 <<if $birdBask>>당신을 풀어주고 <</if>>떨며 일어서더니, <<if $monster is 1>>비틀거리며<<else>>뛰어서<</if>> 둥지 쪽으로 다가간다.
		<br><br>

		<<unset $birdBask>><<unset $birdPerch>>
		<<bHe>>【은는】 그 안에 반쯤 쓰러진다.
	<<else>>
		둥지 안에 앉아 있는 <<your_bird_text>>【을를】 본다.
	<</if>>
	<<if $monster is 1>>
		숨을 가쁘게 몰아쉰다. <<bHe>>【은는】 당신이 쳐다보는 것을 눈치채고, <<bhis>> 얼굴이 붉어진다. <<if $syndromebird is 1>>당신은 <<bhim>>에게서 당황하는 기색을 자주 보지 못한다.<</if>>
		<br><br>

		"<<Wife>>... <span class="lewd">알이...</span>" <<bhe>>【은는】 간신히 말하지만, 이내 <<bhis>> 얼굴이 고통으로 일그러진다.
	<<else>>
		몸을 좌우로 흔든다. <<bHe>>【은는】 낮고 고통스러운 신음을 내뱉는다. <span class="lewd"><<bHe>>【은는】 알을 낳고 있다.</span>
	<</if>>
	<br><br>

	<<link [[고개를 돌린다|Bird Tower Great Hawk Egg Laying]]>><<set $phase to 0>><<npcincr "Great Hawk" dom 1>><</link>><<gdom>>
	<br>
	<<link [[지켜본다|Bird Tower Great Hawk Egg Laying]]>><<set $phase to 1>><</link>>
	<br>
	<<if birdEggsReady("Great Hawk") is "fertilised">>
		<<link [[달래준다|Bird Tower Great Hawk Egg Laying]]>><<set $phase to 2>><<npcincr "Great Hawk" love 1>><<npcincr "Great Hawk" dom -1>><<bird_stockholm 3>><</link>><<glove>><<ldom>><<ggbirdstockholm>><<deviant1>>
		<br>
		<<if hasSexStat("deviancy", 3) and ($sciencetrait gte 2 or $harpy gte 6)>>
			<<link [[돕는다|Bird Tower Great Hawk Egg Laying]]>><<set $phase to 3>><<npcincr "Great Hawk" love 3>><<npcincr "Great Hawk" dom -5>><<bird_stockholm 5>><</link>><<gglove>><<llldom>><<gggbirdstockholm>><<deviant3>>
		<<elseif $sciencetrait lt 2 and $harpy lte 5>>
			<span class="blue">당신은 <<bhe>>【이가】 <<bhis>> 알을 낳도록 돕는 방법을 모른다.</span>
		<<else>>
			<span class="blue">당신은 <<bhe>>【이가】 <<bhis>> 알을 낳도록 도울 만큼 충분히 변태적이지 않다.</span>
		<</if>>
	<<else>>
		<<link [[달래준다|Bird Tower Great Hawk Egg Laying]]>><<set $phase to 2>><<npcincr "Great Hawk" love 1>><<npcincr "Great Hawk" dom -1>><<bird_stockholm 1>><</link>><<glove>><<ldom>><<gbirdstockholm>><<deviant1>>
		<br>
		<<if hasSexStat("deviancy", 3) and ($sciencetrait gte 2 or understandsBirdBehaviour())>>
			<<link [[돕는다|Bird Tower Great Hawk Egg Laying]]>><<set $phase to 3>><<npcincr "Great Hawk" love 3>><<npcincr "Great Hawk" dom -5>><<bird_stockholm 3>><</link>><<gglove>><<llldom>><<ggbirdstockholm>><<deviant3>>
		<<elseif $sciencetrait lt 2 and !understandsBirdBehaviour()>>
			<span class="blue">당신은 <<bhe>>【이가】 <<bhis>> 알을 낳도록 돕는 방법을 모른다.</span>
		<<else>>
			<span class="blue">당신은 <<bhe>>【이가】 <<bhis>> 알을 낳도록 도울 만큼 충분히 변태적이지 않다.</span>
		<</if>>
	<</if>>
	<br>
<</widget>>

<<widget "endBirdEggLaying">>
	<<set $bird.override to "rest">>
	<<set $bird.overrideTimer to 240>>
	<<set $bird.timer to 240>>
	<<unset $eggLayNumber>>
	<<unset $eggLayText>>
	<<unset $birdEggContext>>
<</widget>>

<<widget "playerEggLayEvent">>
	<<set $_eggnantGenital to playerLabouringOrifice()>>
	<<set $_eggnantGenital to $_eggnantGenital is "vagina" ? "cervix" : "ass">>
	<<set _litter to getLabouringLitter("pc")>>
	<<if $passage is "Bird Tower Sleep" and ($bedGuest is "Great Hawk" or $bird.state is "home" or (playerIsPregnant() and playerNormalPregnancyType() is "hawk" and $bird.state is "hunting"))>>
		<<set _eggLayingWake to true>>
	<<elseif ($passage is "Robin Sleep" or $passage is "Sleep") and $robinbed>>
		<<set _eggLayingWake to true>>
	<<else>>
		<<if playerIsPregnant() and playerNormalPregnancyType() is "hawk">>
			<<if $location is "tower">>
				<<set _eggIcon to _litter.length>><<wearProp `"hawk egg " + Math.clamp(_eggIcon, 1, 3)`>>
				당신은 혼란스러운 기분으로 깨어나며 하복부에서 압박감이 커지는 것을 느낀다. 짐승의 본능이 당신을 휩쓴다. 당신은 <<if $harpy gte 6 and V.transformationParts.bird.plumage isnot "hidden">>깃털을 곤두세우고 <</if>>손과 무릎을 짚고 엎드린다.
				뭔가 거대한 것이 당신 안에서 움직이며 당신의 내벽을 문지를 때마다 고통과 쾌락의 파도를 보낸다. <<arousal 4000>><<pain 12>><<gggarousal>><<ggpain>>
				<br><br>

				당신은 숨을 헐떡이며,
				<<if $_eggnantGenital is "cervix">>
					<<if _litter.length gte 2>>
						알들이 자궁경부를 통과하고 있는 것을 느낀다. 그것들은 질을 따라 미끄러지며 온몸에 전율을 보낸다. 당신은 알들이 머리를 내밀기 시작하자 둥지를 움켜쥔다.
						첫 번째가 가장 힘들다. 당신의 통로가 반복적으로 수축하며, 당신을 관통하는 더 큰 쾌락의 파도를 보낸다. 그것은 조금 빠져나왔다가, 이내 다시 안으로 되돌아간다. 당신이 꼬박 1분 동안 힘을 주자, 마침내 알이 뽁 하고 튀어나온다. <<arousal 4000>><<garousal>>
						<br>
						<<if $arousal gte $arousalmax>>
							<<orgasm>>
						<<else>>
							<br>
						<</if>>
						<<if _litter.length is 2>>
							두 번째 알은 훨씬 수월하게 빠져나와, 둥지 안에 있는 형제와 합류한다.
						<<elseif _litter.length is 3>>
							두 번째 알은 쉽게 통과하지만, 세 번째 알은 뒤에서 밀어줄 것이 없어 중간에 걸려버린다. 당신은 거기에 앉아 몇 분 동안 더 고통스럽게 힘을 주었고, 결국 간신히 밀어낸다. 당신의 <<pussy>>【은는】 살짝 벌려진 채로 남아 있다. 당신은 힘이 빠져 헐떡이며 어지러움을 느낀다.
						<<else>>
							다음 알들은 쉽게 통과하지만, 마지막 알은 뒤에서 밀어줄 것이 없어 중간에 걸려버린다. 당신은 거기에 앉아 몇 분 동안 더 고통스럽게 힘을 주었고, 결국 간신히 밀어낸다. 당신의 <<pussy>>【은는】 살짝 벌려진 채로 남아 있다. 당신은 힘이 빠져 헐떡이며 어지러움을 느낀다.
						<</if>>
					<<else>>
						알 하나가 자궁경부를 통과하고 있는 것을 느낀다. 그것은 질을 따라 미끄러지며 온몸에 전율을 보낸다. 당신은 알이 머리를 내밀기 시작하자 둥지를 움켜쥔다.
						단 하나뿐이지만, 그 엄청난 크기는 마치 평범한 인간 아기가 들어찬 듯한 느낌을 준다. 당신은 다리를 더 넓게 벌린다. 당신의 <<pussy>>【은는】 알이 빠져나갈 공간을 만들려고 노력하듯 더욱 늘어난다. 몇 분 동안 고통스럽게 힘을 준 끝에, 마침내 알이 빠져나온다. 당신은 힘이 빠져 헐떡이며 어지러움을 느낀다.
					<</if>>
				<<else>>
					<<if _litter.length gte 2>>
						<span class="lewd"><<= _litter.length>>개의 수정된 새의 알</span>이 당신의 $_eggnantGenital【을를】 통과하며, 각각의 알이 당신의 입구를 천천히 넓히고는 툭 떨어져 당신의 둥지에 안착한다.
					<<else>>
						<span class="lewd">수정된 새의 알</span>이 당신의 $_eggnantGenital【을를】 통과하며, 당신의 입구를 천천히 넓히고는 툭 떨어져 당신의 둥지에 안착한다.
					<</if>>
				<</if>>
				<<if $arousal gte $arousalmax>>
					<<orgasm>>
				<<else>>
					<br><br>
				<</if>>

				당신은 모성애가 주는 더없는 행복감으로 가득 차오른다. 당신의 배우자도 기뻐할 것이다. <<Number `_litter.length`>>개의 <<birdicon "eggs">> 수정된 새의 <<pluralise `_litter.length` "알이" "알들이">> 둥지에 추가되었다.
				<<if _litter.length gte 2>>알들은 꽤 커서, 애초에 어떻게 그것들이 당신 몸 안에 다 들어가 있었는지 의문이 들 정도다.<<else>>알은 꽤 커서, 낳는 과정이 왜 더 아프지 않았는지 의문이 들 정도다.<</if>>
				<<set $bird.eggReact to _litter.length>>
				<<pregnancyFeats "pc">>
				<<endPlayerPregnancy "tower" "tower">>
				<<set $harpyEggsPrevent to 28>>
			<<else>>
				<<set _eggIcon to _litter.length>><<wearProp `"hawk egg " + Math.clamp(_eggIcon, 1, 3)`>>
				당신은 혼란스러운 기분으로 깨어나며 하복부에서 압박감이 커지는 것을 느낀다. 짐승의 본능이 당신을 휩쓴다. 당신은 <<if $harpy gte 6 and V.transformationParts.bird.plumage isnot "hidden">>깃털을 곤두세우고 <</if>>손과 무릎을 짚고 엎드린다.
				뭔가 거대한 것이 당신 안에서 움직이며 당신의 내벽을 문지를 때마다 고통과 쾌락의 파도를 보낸다. <<arousal 4000>><<garousal>>
				<br><br>

				당신은 숨을 헐떡이며,
				<<if $_eggnantGenital is "cervix">>
					<<if _litter.length gte 2>>
						알들이 자궁경부를 통과하고 있는 것을 느낀다. 그것들은 질을 따라 미끄러지며 온몸에 전율을 보낸다. 당신은 알들이 머리를 내밀기 시작하자 주변을 꽉 붙잡는다.
						첫 번째가 가장 힘들다. 당신의 통로가 반복적으로 수축하며, 당신을 관통하는 더 큰 쾌락의 파도를 보낸다. 그것은 조금 빠져나왔다가, 이내 다시 안으로 되돌아간다. 당신이 꼬박 1분 동안 힘을 주자, 마침내 알이 뽁 하고 튀어나온다. <<arousal 4000>><<garousal>>
						<br>
						<<if $arousal gte $arousalmax>>
							<<orgasm>>
						<<else>>
							<br>
						<</if>>
						<<if _litter.length is 2>>
							두 번째 알은 훨씬 수월하게 빠져나와, 당신의 침대 위에 있는 형제와 합류한다.
						<<elseif _litter.length is 3>>
							두 번째 알은 쉽게 통과하지만, 세 번째 알은 뒤에서 밀어줄 것이 없어 중간에 걸려버린다. 당신은 거기에 앉아 몇 분 동안 더 고통스럽게 힘을 주었고, 결국 간신히 밀어낸다. 당신의 <<pussy>>【은는】 살짝 벌려진 채로 남아 있다. 당신은 힘이 빠져 헐떡이며 어지러움을 느낀다.
						<<else>>
							다음 알들은 쉽게 통과하지만, 마지막 알은 뒤에서 밀어줄 것이 없어 중간에 걸려버린다. 당신은 거기에 앉아 몇 분 동안 더 고통스럽게 힘을 주었고, 결국 간신히 밀어낸다. 당신의 <<pussy>>【은는】 살짝 벌려진 채로 남아 있다. 당신은 힘이 빠져 헐떡이며 어지러움을 느낀다.
						<</if>>
					<<else>>
						알 하나가 자궁경부를 통과하고 있는 것을 느낀다. 그것은 질을 따라 미끄러지며 온몸에 전율을 보낸다. 당신은 알이 머리를 내밀기 시작하자 주변을 꽉 붙잡는다.
						단 하나뿐이지만, 그 엄청난 크기는 마치 평범한 인간 아기가 들어찬 듯한 느낌을 준다. 당신은 다리를 더 넓게 벌린다. 당신의 <<pussy>>【은는】 알이 빠져나갈 공간을 만들려고 노력하듯 더욱 늘어난다. 몇 분 동안 고통스럽게 힘을 준 끝에, 마침내 알이 빠져나온다. 당신은 힘이 빠져 헐떡이며 어지러움을 느낀다.
					<</if>>
				<<else>>
					<<if _litter.length gte 2>>
						<span class="lewd"><<= _litter.length>>개의 수정된 새의 알</span>이 당신의 $_eggnantGenital【을를】 통과하며, 각각의 알이 당신의 입구를 천천히 넓히고는 툭 떨어져 당신의 둥지에 안착한다.
					<<else>>
						<span class="lewd">수정된 새의 알</span>이 당신의 $_eggnantGenital【을를】 통과하며, 당신의 입구를 천천히 넓히고는 툭 떨어져 당신의 둥지에 안착한다.
					<</if>>
				<</if>>
				<<if $arousal gte $arousalmax>>
					<<orgasm>>
				<<else>>
					<br><br>
				<</if>>

				당신은 모성애가 주는 더없는 행복감과 함께, 알 수 없는 초조함을 느낀다. <span class="blue"><<if _litter.length gte 2>>그것들을<<else>>그것을<</if>> 둥지로 가져가야 한다.</span> 당신은 <<number `_litter.length`>>개의 <<birdicon "eggs">> 수정된 새의 <<pluralise `_litter.length` "알">>을 집어 든다.
				<<if _litter.length gte 2>>알들은 꽤 커서, 애초에 어떻게 그것들이 당신 몸 안에 다 들어가 있었는지 의문이 들 정도다.<<else>>알은 꽤 커서, 낳는 과정이 왜 더 아프지 않았는지 의문이 들 정도다.<</if>>
				/* Might be best changing the location variable here */
				<<pregnancyFeats "pc">>
				<<endPlayerPregnancy $location "inventory">>
				<<set $harpyEggsPrevent to 28>>
			<</if>>
		<<elseif !playerIsPregnant() and $harpyEggs>>
			당신은 혼란스러운 기분으로 깨어나며 하복부에서 압박감이 커지는 것을 느낀다. 짐승의 본능이 당신을 휩쓴다. 당신은 <<if $harpy gte 6 and V.transformationParts.bird.plumage isnot "hidden">>깃털을 곤두세우고 <</if>>손과 무릎을 짚고 엎드린다.
			뭔가 당신 안에서 움직이며 당신의 내벽을 문지를 때마다 쾌락의 파도를 보낸다. <<arousal 2000>><<garousal>>
			<br><br>

			당신은 숨을 헐떡이며,
			<<if $_eggnantGenital is "cervix">>
				<<if $harpyEggs.count gte 2>>
					알들이 자궁경부를 통과하고 있는 것을 느낀다. 그것들은 질을 따라 미끄러지며 온몸에 전율을 보낸다. 당신은 알들이 머리를 내밀기 시작하자 주변을 꽉 붙잡는다.
					첫 번째가 가장 힘들다. 당신의 통로가 반복적으로 수축하며, 당신을 관통하는 더 큰 쾌락의 파도를 보낸다. 그것은 조금 빠져나왔다가, 이내 다시 안으로 되돌아간다. 당신이 꼬박 1분 동안 힘을 주자, 마침내 알이 뽁 하고 튀어나온다. <<arousal 4000>><<garousal>>
					<br>
					<<if $arousal gte $arousalmax>>
						<<orgasm>>
					<<else>>
						<br>
					<</if>>
					<<if $harpyEggs.count is 2>>
						두 번째 알은 훨씬 수월하게 빠져나와, <<if $location is "tower">>둥지 안<<else>>침대 위<</if>>에 있는 형제와 합류한다.
					<<elseif $harpyEggs.count is 3>>
						두 번째 알은 쉽게 통과하지만, 세 번째 알은 뒤에서 밀어줄 것이 없어 중간에 걸려버린다. 당신은 거기에 앉아 몇 분 동안 더 고통스럽게 힘을 주었고, 결국 간신히 밀어낸다. 당신의 <<pussy>>【은는】 살짝 벌려진 채로 남아 있다. 당신은 힘이 빠져 헐떡이며 어지러움을 느낀다.
					<<else>>
						다음 알들은 쉽게 통과하지만, 마지막 알은 뒤에서 밀어줄 것이 없어 중간에 걸려버린다. 당신은 거기에 앉아 몇 분 동안 더 고통스럽게 힘을 주었고, 결국 간신히 밀어낸다. 당신의 <<pussy>>【은는】 살짝 벌려진 채로 남아 있다. 당신은 힘이 빠져 헐떡이며 어지러움을 느낀다.
					<</if>>
				<<else>>
					알 하나가 자궁경부를 통과하고 있는 것을 느낀다. 그것은 질을 따라 미끄러지며 온몸에 전율을 보낸다. 당신은 알이 머리를 내밀기 시작하자 주변을 꽉 붙잡는다.
					뒤에서 밀어줄 다른 알들이 없어서, 그것은 중간에 걸려버린다. 당신의 <<pussy>>【은는】 알이 당신을 틀어막은 채 반쯤 벌려진 상태로 남는다. 잠시 후 그것은 다시 안으로 들어간다. 당신은 숨을 고르려 노력하지만, 숨을 쉴 때마다 무겁게 느껴진다. 당신은 다시 힘을 주고, 이번에는 그것을 밖으로 완전히 빼내는 데 성공한다.
				<</if>>
			<<else>>
				<<if $harpyEggs.count gte 2>>
					<span class="lewd">$harpyEggs.count개의 새의 알</span>이 당신의 $_eggnantGenital【을를】 통과하며, 각각의 알이 당신의 입구를 천천히 넓히고는 툭 떨어져 당신의 둥지에 안착한다.
				<<else>>
					<span class="lewd">새의 알</span>이 당신의 $_eggnantGenital【을를】 통과하며, 당신의 입구를 천천히 넓히고는 툭 떨어져 당신의 둥지에 안착한다.
				<</if>>
			<</if>>
			<<if $arousal gte $arousalmax>>
				<<orgasm>>
				<<set $orgasmcurrent to 0>>
			<<else>>
				<br><br>
			<</if>>

			당신은 모성애가 주는 더없는 행복감으로 가득 차오르지만, <span class="blue">당신은 <<pluralise $harpyEggs.count "그것이" "그것들이">> 무정란이라는 것을 알고 있다.</span> <<tending_pick bird_egg $harpyEggs.count $harpyEggs.count>>
			<<wearProp `"hawk egg " + Math.clamp($harpyEggs.count, 1, 3)`>><<unset $harpyEggs>>
			<<set $harpyEggsPrevent to 14>>
			<<set _eggEvent to true>>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "setTowerTemp">>
	<<if $bird.upgrades.shelter is 0>>
		<<set $outside to 1>>
	<<else>>
		<<set $outside to 0>>
	<</if>>
	<<set $_tempUp to Math.clamp((30 * Math.log(0.034 * (30 - Weather.temperature) + 1)), 1, 40)>>
	<<if getBirdBurnTime() gt 0>>
		<<set Weather.Temperature.override[$outside ? "outside" : "inside"] = Weather.temperature + $_tempUp + (_args[0] is "fire" ? 16 : 0)>>
		<<if _args[0] is "water" and $bird.upgrades.pot gte 3>>
			<<set Weather.Temperature.override.water = Weather.temperature + ($_tempUp + 8)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "hairToFeatherColour">>
	<<switch $haircolour>>
		<<case "red" "crimson" "wine">><<set _colourConverted to "red">>
		<<case "jetblack" "black" "ebony">><<set _colourConverted to "black">>
		<<case "blond" "softblond" "platinumblond" "golden" "ashyblond" "strawberryblond">><<set _colourConverted to "yellow">>
		<<case "darkbrown" "brown" "softbrown" "lightbrown" "copperbrown">><<set _colourConverted to "brown">>
		<<case "burntorange" "ginger" "bloodorange">><<set _colourConverted to "tangerine">>
		<<case "blue" "deepblue" "neonblue" "frostblue">><<set _colourConverted to "blue">>
		<<case "green" "darklime" "toxicgreen" "teal" "aquamarine">><<set _colourConverted to "green">>
		<<case "pink" "brightpink" "hotpink" "softpink" "rosegold">><<set _colourConverted to "pink">>
		<<case "purple" "mediumpurple" "brightpurple">><<set _colourConverted to "purple">>
		<<case "white" "snowwhite" "gray">><<set _colourConverted to "white">>
		<<default>><<set _colourConverted to "red">>
	<</switch>>
<</widget>>

<<widget "bird_hunt_children_events">>
	<<set $daily.birdBabyFeed to true>>
	<<bHe>>【은는】 그것에서 작은 덩어리를 뜯어낸다
	<<if $monster is 1>>
		<<bhis>> 손으로, 그런 다음
	<<else>>
		<<bhis>> 부리로, 잘게 부순 다음
	<</if>>
	<<cleareventpool>>

	<!-- _childrenIds is an array that represents all children that meet the parameters of "getChildrenIds" above.-->
	<!-- the pluck function picks AND REMOVES one random child ID from the array, which means the array can then be used to refer to all children EXCEPT those plucked for use in the scene. -->
	<!-- This method allows temporary variables (or story variables if necessary) to represent child IDs, and allows children to be selected like normal NPCs for use in text widgets. -->
	<!-- Be sure not to try plucking more children than are available, hence the checks in each inline event for total child number. -->
	<<addinlineevent "bird_feed_single">>
		<<set _child1 to _childrenIds.pluck()>>
		<<set _childrenEating to [_child1]>>
		<<childSelect _child1>>
		<<childname>>에게 부드럽게 건네준다. <<childHe>>【은는】 
		<<if $cmonster is 1>>
			<<childhis>> 작은 손으로 그것을 서툴게 움켜쥐고 잇몸으로 씹기 시작한다.
		<<else>>
			그 부드러운 덩어리를 <<childhis>> 부리에 머금는다.
		<</if>>
		<<if _childrenTotal isnot 1>>
			<<if _childrenTotal is 2>>
				<<set _child2 to _childrenIds.pluck()>>
				<<childSelect _child2>>
				<<childname>>【은는】 그것에 관심이 없어 보이지만, <<childhis>> <<childsibling _child1>>【이가】 그것을 갉아먹는 것을 호기심 있게 지켜본다.
			<<elseif _childrenTotal lte 10>>
				<<childrenNames _childrenIds>>【은는】 지금은 럴커에게 아무런 관심이 없어 보이며, <<childname>>【이가】 혼자서 그것을 집어삼키도록 내버려둔다.
			<<else>>
				당신의 다른 아이들은 지금은 럴커에게 아무런 관심이 없어 보이며, <<childname>>【이가】 혼자서 그것을 집어삼키도록 내버려둔다.
			<</if>>
		<</if>>
		<<if !$bird.hunts.duo>>
			<br><br>

			당신의 배우자가 남은 럴커를 들고 당신을 향해 돌아선다. <<bHe>>【은는】 그것을 다시 당신에게 내민다.
		<</if>>
	<</addinlineevent>>

	<<if _childrenTotal gte 2>>
		<<addinlineevent "bird_feed_duo">>
			<<set _child1 to _childrenIds.pluck()>>
			<<set _child2 to _childrenIds.pluck()>>
			<<set _childrenEating to [_child1, _child2]>>
			둥지 안에 조심스럽게 내려놓는다. <<childSelect _child1>><<childname>>【은는】 
			<<if $cmonster is 1>>
				<<childhis>> 작은 손으로 그것을 서툴게 움켜쥐고 잇몸으로 씹기 시작한다.
			<<else>>
				그 부드러운 덩어리를 <<childhis>> 부리에 머금는다.
			<</if>>
			<<if getChildDays(_child1) gte 150 and getChildDays(_child2) lte 50>>
				<<childHe>>【은는】 <<childSelect _child1>><<childhim>>에게 손을 뻗는 <<childSelect _child2>><<childname>>【을를】 바라본다. <<childHe>>【은는】 몇 번의 시도 끝에 고기를 두 조각으로 뜯어내는 데 성공하고, 그 절반을 <<childSelect _child2>><<childname>>에게 준다.
			<<else>>
				<<childSelect _child2>><<childname>> 역시 그것을 붙잡고, 두 마리는<<if $cmonster is 1>> 팔과<</if>> 날개를 퍼덕이며 고기가 두 조각으로 쪼개질 때까지 장난치듯 먹이 싸움을 벌인다.
			<</if>>

			<<if _childrenTotal isnot 2>>
				<<if _childrenTotal is 3>>
					<<set _child3 to _childrenIds.pluck()>>
					<<childSelect _child3>>
					<<childname>>【은는】 그것에 관심이 없어 보이지만, <<childhis>> <<childsiblings `[_child1,_child2]`>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<<elseif _childrenTotal lte 10>>
					<<childrenNames _childrenIds>>【은는】 지금은 럴커에게 관심이 없어 보이지만, 자신들의 <<childsiblings `[_child1,_child2]`>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<<else>>
					당신의 다른 아이들은 지금은 럴커에게 관심이 없어 보이지만, 자신들의 <<childsiblings `[_child1,_child2]`>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<</if>>
			<</if>>
			<<if !$bird.hunts.duo>>
				<br><br>

				당신의 배우자가 남은 럴커를 들고 당신을 향해 돌아선다. <<bHe>>【은는】 그것을 다시 당신에게 내민다.
			<</if>>
		<</addinlineevent>>

		<<addinlineevent "bird_feed_all">>
			<<set _childrenEating to clone(_childrenIds)>>
			<<set _child1 to _childrenIds.pluck()>>
			<<set _child2 to _childrenIds.pluck()>>
			둥지 안에 조심스럽게 내려놓는다. <<childname _child1>>【와과】 <<childname _child2>> 모두 그것을 향해 달려들지만, 거대 매는 재빨리 다른 조각을 떼어내어 <<childname _child2>>에게 준다.

			<<if _childrenTotal is 3>>
				<<set _child3 to _childrenIds.pluck()>>
				<<childSelect _child3>>
				<<bHe>>【은는】 차례를 참을성 있게 기다린 <<childname>>【을를】 위해 한 조각을 더 떼어낸다.
			<<elseif _childrenTotal gte 4>>
				<<bHe>>【은는】 계속해서 나누어 준다. 한 조각씩,
				<<if _childrenTotal gte 20>>
					당신의 모든 아이들에게.
				<<else>>
					<<childrenNames _childrenIds>>.
				<</if>>
			<</if>>
			짹짹거리고 우는 소리는 행복하게 먹이를 먹으며 잦아든다.
			<<if !$bird.hunts.duo>>
				<br><br>

				<<if _childrenTotal gte 6>>
					당신의 배우자는 이제 빈 <<if $monster is 1>>손으로<<else>>부리로<</if>> 당신을 향해 돌아선다.
					<<set _noLurker to true>>
					<<if $monster is 1>>
						"<<wife>>【을를】 위해 조만간 다시 사냥을 할게."
					<<else>>
						<<bHe>>【은는】 미안한 듯 깍악거리지만, 곧 <<bhis>> 시선은 단호해져서 조만간 다시 사냥을 하겠다는 무언의 약속을 한다.
					<</if>>
				<<elseif _childrenTotal gte 4>>
					당신의 배우자가 절반 남은 럴커를 들고 당신을 향해 돌아선다. <<bHe>>【은는】 그것을 다시 당신에게 내민다.
				<<else>>
					당신의 배우자가 남은 럴커를 들고 당신을 향해 돌아선다. <<bHe>>【은는】 그것을 다시 당신에게 내민다.
				<</if>>
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<if _childrenTotal gte 3>>
		<<addinlineevent "bird_feed_trio">>
			<<set _child1 to _childrenIds.pluck()>>
			<<set _child2 to _childrenIds.pluck()>>
			<<set _child3 to _childrenIds.pluck()>>
			<<set _childrenEating to [_child1, _child2, _child3]>>
			둥지 안에 조심스럽게 내려놓는다. <<childSelect _child1>><<childname>>【은는】 
			<<if $childRecords[_child1].features.monster is "monster">>
				<<childhis>> 작은 손으로 그것을 서툴게 움켜쥐고 잇몸으로 씹기 시작한다.
			<<else>>
				그 부드러운 덩어리를 <<childhis>> 부리에 머금는다.
			<</if>>
			거대 매는 고기를 더 떼어내어 한 조각은 <<childSelect _child2>><<childname>>에게, 또 다른 한 조각은 <<childSelect _child3>><<childname>>에게 준다.

			<<if _childrenTotal isnot 3>>
				<<if _childrenTotal is 4>>
					<<set _child4 to _childrenIds.pluck()>>
					<<childSelect _child4>>
					<<childname>>【은는】 지금 당장 먹는 데는 관심이 없어 보이지만, <<childhis>> <<childsiblings `[_child1,_child2,_child3]`>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<<elseif _childrenTotal lte 10>>
					<<childrenNames _childrenIds>>【은는】 지금은 럴커에게 관심이 없어 보이지만, 자신들의 <<childsiblings `[_child1,_child2,_child3]`>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<<else>>
					당신의 다른 아이들은 지금은 럴커에게 관심이 없어 보이지만, 자신들의 <<childsiblings `[_child1,_child2,_child3]`>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<</if>>
			<</if>>
			<<if !$bird.hunts.duo>>
				<br><br>

				당신의 배우자가 남은 럴커를 들고 당신을 향해 돌아선다. <<bHe>>【은는】 그것을 다시 당신에게 내민다.
			<</if>>
		<</addinlineevent>>
	<</if>>

	<!-- Showing off how complex events can be made using this method -->
	<<if _childrenTotal gte 4>>
		<<addinlineevent "bird_feed_quartet">>
			<<set _child1 to _childrenIds.pluck()>>
			<<set _child2 to _childrenIds.pluck()>>
			<<set _child3 to _childrenIds.pluck()>>
			<<set _child4 to _childrenIds.pluck()>>
			<<set _childrenEating to [_child1, _child2, _child3, _child4]>>
			둥지 안에 조심스럽게 내려놓는다. <<childSelect _child1>><<childname>>【은는】 
			<<if $cmonster is 1>>
				<<childhis>> 작은 손으로 그것을 서툴게 움켜쥐고 잇몸으로 씹기 시작한다.
			<<else>>
				그 부드러운 덩어리를 <<childhis>> 부리에 머금는다.
			<</if>>
			거대 매는 고기를 더 떼어내어 당신의 다른 아이들을 위해 둥지에 떨어뜨려 준다.
			<<childSelect _child2>><<childname>>【이가】 고기 조각 하나를 집어들자, <<childname _child3>>【이가】 <<childhis _child3>> <<childhands _child3>>【으로로】 <<childname _child2>>의 얼굴을 밀어버린다.
			그 <<childsiblings _child2 _child3>>【은는】 먹이를 두고 장난스럽게 싸우지만, <<childname _child4>>【이가】 날름 낚아채 거의 통째로 삼켜버린다.
			<br><br>

			그 사실을 알아채지도 못한 채, <<childname _child2>>【와과】 <<childname _child3>>【은는】 <<your_bird_text>>【이가】 둘을 떼어놓고 각자에게 자기 몫의 고기 조각을 나누어줄 때까지 서로 계속 투닥거린다.
			<<if _childrenTotal isnot 4>>
				<<if _childrenTotal is 5>>
					<<set _child5 to _childrenIds.pluck()>>
					<<childSelect _child5>>
					<<childname>>【은는】 <<childhis>> <<childsiblings `[_child1,_child2,_child3,_child4]`>>【을를】 지켜보며 <<childgiggles>>, 하지만 당장 밥을 먹는 것엔 관심이 없어 보인다.
				<<elseif _childrenTotal lte 10>>
					<<childrenNames _childrenIds>>【은는】 지금은 럴커에게 관심이 없어 보이지만, 자신들의 <<childsiblings `[_child1,_child2,_child3,_child4]`>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<<else>>
					당신의 다른 아이들은 지금은 럴커에게 관심이 없어 보이지만, 자신들의 <<childsiblings `[_child1,_child2,_child3,_child4]`>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<</if>>
			<</if>>
			<<if !$bird.hunts.duo>>
				<br><br>

				<<your_bird_text "cap">>【은는】 절반 남은 럴커를 들고 당신을 향해 돌아선다. <<bHe>>【은는】 그것을 다시 당신에게 내민다.
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<if _childrenTotal gte 5>>
		<<addinlineevent "bird_feed_quintet">>
			<<set _child1 to _childrenIds.pluck()>>
			<<set _child2 to _childrenIds.pluck()>>
			<<set _child3 to _childrenIds.pluck()>>
			<<set _child4 to _childrenIds.pluck()>>
			<<set _child5 to _childrenIds.pluck()>>
			<<set _childrenGroup to [_child1, _child2, _child3, _child4, _child5]>>
			<<set _childrenEating to [_child1, _child2, _child3, _child4, _child5]>>
			둥지 안에 조심스럽게 내려놓는다. <<bHe>>【은는】 재빨리 고기를 더 뜯어내어 <<childrenNames _childrenGroup>>에게 한 조각씩 나누어 준다. 그들이 내던 짹짹거리고 우는 소리는 모두 행복하게 먹이를 먹으며 잦아든다.

			<<if _childrenTotal isnot 5>>
				<<if _childrenTotal is 6>>
					<<set _child6 to _childrenIds.pluck()>>
					<<childSelect _child6>>
					<<childname>>【은는】 지금은 먹는 데 관심이 없어 보이지만, <<childhis>> <<childsiblings _childrenGroup>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<<elseif _childrenTotal lte 10>>
					<<childrenNames _childrenIds>>【은는】 지금은 럴커에게 관심이 없어 보이지만, 자신들의 <<childsiblings _childrenGroup>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<<else>>
					당신의 다른 아이들은 지금은 럴커에게 관심이 없어 보이지만, 자신들의 <<childsiblings _childrenGroup>>【이가】 먹는 모습을 호기심 있게 지켜본다.
				<</if>>
			<</if>>
			<<if !$bird.hunts.duo>>
				<br><br>

				<<your_bird_text "cap">>【은는】 절반 남은 럴커를 들고 당신을 향해 돌아선다. <<bHe>>【은는】 그것을 다시 당신에게 내민다.
			<</if>>
		<</addinlineevent>>

		<<addinlineevent "bird_feed_chaos">>
			<<set _childrenEating to clone(_childrenIds)>>
			<<set _child1 to _childrenIds.pluck()>>
			<<set _child2 to _childrenIds.pluck()>>
			<<set _child3 to _childrenIds.pluck()>>
			<<set _childrenGroup to [_child1, _child2, _child3]>>
			<<childSelect _child1>>
			둥지 안에 조심스럽게 내려놓는다. <<childrenNames _childrenGroup>> 모두 일제히 그것을 붙잡으려 서로 엎어지고 넘어지며 거칠게 <<childcry>>!
			<br><br>

			<<set _noLurker to true>>
			거대 매는 그들 중 누구라도 다치는 것을 막기 위해 럴커를 놓아준다. <<childrenNames _childrenIds>>【은는】 천천히 다가와 자신들의 <<childsiblings _childrenGroup>>【와과】 함께 럴커를 쪼아먹는다.
			<<if $monster is 1>>
				<<your_bird_text "cap">>【은는】 한숨을 쉬고, 그들 각자가 먹을 수 있을 만한 크기로 고기를 뜯어내도록 돕기 시작한다. <<if !$bird.hunts.duo>>"미안해, <<wife>>. 조만간 다시 사냥을 할게."<</if>>
			<<else>>
				<<your_bird_text "cap">>【은는】 잠시 멍하니 내려다보다가, 럴커를 부리로 쪼아 좀 더 먹기 편한 크기로 나눈다. <<if !$bird.hunts.duo>><<bHe>>【은는】 당신을 돌아보며 미안한 듯 깍악거리지만, 곧 <<bhis>> 시선은 단호해져서 조만간 다시 사냥을 하겠다는 무언의 약속을 한다.<</if>>
			<</if>>
		<</addinlineevent>>
	<</if>>

	<<runeventpool>>
	<<for $_cc to 0; $_cc lt _childrenEating.length; $_cc++>>
		<<updateChildActivity _childrenEating[$_cc]>>
		<<set $childRecords[_childrenEating[$_cc]].development.activityDay to Time.days>>
		<<set $childRecords[_childrenEating[$_cc]].development.activityHour to (Time.hour - 3)>>
		<<set $childRecords[_childrenEating[$_cc]].development.activity to "lurkerEat">>
	<</for>>
<</widget>>

<<widget "silver_hunt_lurker_caught">>
	당신은 럴커를 떼어내기 위해 싸운다. 약간의 실랑이 끝에, 그것은 당신을 잡고 있던 손을 놓치고, 당신은 그것을 던져버린다. 그것은 이미 빛에 너무 정신이 팔려 다시 공격하려고 시도하지 않는다. <<set $birdSilverHunt.suspicion++>>
	<<switch $birdSilverHunt.suspicion>>
		<<case 0 1>>당신이 발버둥친 탓에 소리가 났지만, 누군가 조사하러 올 정도는 아니었다. <<gsuspicion>>
		<<case 2>>경비원 하나가 이쪽을 본다. 다행히 <<person1>><<he>>【은는】 럴커만 발견하고 그것을 쫓아간다. <<gsuspicion>>
		<<default>>
			<<set _caught to true>>
			"대체 계속 저 소리를 내는 게 누구야?" 누군가 짜증 섞인 목소리로 묻는 소리가 들린다. 경비원 중 한 명이 조사하러 다가온다. 당신은 서둘러 근처 바위 반대편으로 다이빙하지만, 충분히 빠르지 않았다. "뭐- 야! 여기 다른 누군가가 있어!"
			<br><br>

			<span class="red">당신은 잡혔다.</span>
	<</switch>>
	<<set $birdSilverHunt.lurkerSpawn to "none">>
<</widget>>

<<widget "silver_hunt_move_guard">>
	<<if _args[0]>>
		<<set $_guardSelected to $birdSilverHuntGuards[_args[0]]>>
		<<if $_guardSelected.action is "moving">>
			<<set $_guardSelected.position to $_guardSelected.movingTo>>
			<<set $_guardSelected.movingTo to "none">>
			<<if $_guardSelected.position is $birdSilverHunt.player.position>>
				<<set $_guardSelected.action to "move">>
			<<else>>
				<<set $_guardSelected.action to "idle">>
			<</if>>
		<<elseif ["move","moveQueue"].includes($_guardSelected.action)>>
			<<if $_guardSelected.movingTo is "none">>
				<<set $_guardSelected.movingTo to ($_guardSelected.position + random(-2, 2))>>
				<<switch $_guardSelected.movingTo>>
					<<case -1>><<set $_guardSelected.movingTo to 8>>
					<<case -2>><<set $_guardSelected.movingTo to 7>>
					<<case 9>><<set $_guardSelected.movingTo to 0>>
					<<case 10>><<set $_guardSelected.movingTo to 1>>
				<</switch>>
			<</if>>
			<<if $_guardSelected.movingTo is $_guardSelected.position>>
				<<if _args[1]>>
					<!-- forced move disregarding everything else, to prevent players getting hopelessly trapped by an idle guard-->
					<<set $_guardSelected.movingTo to $_guardSelected.position += 2>>
					<<set $_guardSelected.action to "moving">>
					<<silver_hunt_move_guard _args[0]>>
				<<else>>
					<<set $_guardSelected.action to "idle">>
				<</if>>
			<<else>>
				<<if Object.values($birdSilverHuntGuards).find(guard => (guard.index isnot $_guardSelected.index and (guard.position is $_guardSelected.movingTo or guard.movingTo is $_guardSelected.movingTo)))>>
					<<set $_guardSelected.action to "moveQueue">>
				<<else>>
					<<set $_guardSelected.action to "moving">>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "silver_hunt_action_guard">>
	<<if _args[0]>>
		<<set $_guardSelected to $birdSilverHuntGuards[_args[0]]>>
		<<if $_guardSelected.action isnot "none">>
			<<if ["move","moveQueue","moving"].includes($_guardSelected.action)>>
				<<silver_hunt_move_guard _args[0]>>
			<<else>>
				<<set $_guardSelected.action to either("move","move","move","idle")>>
				<<if $_guardSelected.action is "move" and $_guardSelected.movingTo is "none">>
					<<set $_guardSelected.movingTo to ($_guardSelected.position + random(-2, 2))>>
					<<switch $_guardSelected.movingTo>>
						<<case -1>><<set $_guardSelected.movingTo to 8>>
						<<case -2>><<set $_guardSelected.movingTo to 7>>
						<<case 9>><<set $_guardSelected.movingTo to 0>>
						<<case 10>><<set $_guardSelected.movingTo to 1>>
					<</switch>>
				<</if>>
			<</if>>
			<<if $_guardSelected.action is "idle">>
				<<set $_guardSelected.movingTo to "none">>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "bird_fly_reveal_wings">>
	<<set _angelWings to $transformationParts.angel.wings>>
	<<set _fallenAngelWings to $transformationParts.fallenAngel.wings>>
	<<set _demonWings to $transformationParts.demon.wings>>

	<<if $transformationParts.bird.wings is "hidden" and (_angelWings is "hidden" or _angelWings is "disabled") and (_fallenAngelWings is "hidden" or _fallenAngelWings is "disabled") and (_demonWings is "hidden" or _demonWings is "disabled")>>
		<<set $transformationParts.bird.wings to "default">>
	<</if>>
<</widget>>

/* Orphan hawk preview pronouns. */
<<widget "orphanHawkHe">><<if $orphanHawkPreview.gender is "m">>He<<else>>She<</if>><</widget>>
<<widget "orphanHawkhe">><<if $orphanHawkPreview.gender is "m">>he<<else>>she<</if>><</widget>>
<<widget "orphanHawkHis">><<if $orphanHawkPreview.gender is "m">>His<<else>>Her<</if>><</widget>>
<<widget "orphanHawkhis">><<if $orphanHawkPreview.gender is "m">>his<<else>>her<</if>><</widget>>
<<widget "orphanHawkhim">><<if $orphanHawkPreview.gender is "m">>him<<else>>her<</if>><</widget>>
<<widget "orphanHawkhers">><<if $orphanHawkPreview.gender is "m">>his<<else>>hers<</if>><</widget>>
<<widget "orphanHawkson">><<if $orphanHawkPreview.gender is "m">>son<<else>>daughter<</if>><</widget>>
<<widget "orphanHawktype">><<if $orphanHawkPreview.features.monster is "monster">>nestling<<else>>chick<</if>><</widget>>
