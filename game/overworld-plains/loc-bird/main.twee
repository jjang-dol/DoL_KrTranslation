:: Bird Tower Perch
<<setTowerTemp>><<effects>><<npc "Great Hawk">>
<<bird_schedule>>
<<if $bird.state is "home" and ["groom","sing"].includes($bird.activity) and birdEggsReady("Great Hawk") and $birdPerch isnot undefined>>
	<<birdEggLayEvent "perch">>
<<elseif $bird.activity is "bathe" and $bird.state is "home" and $birdPerch isnot undefined>>
	<<unset $birdPerch>>
	<<if $monster is 1>>
		<<beasttype>>【이가】 일어나기 시작하며, 당신에게 <<bhis>> 손을 내민다. "깨끗해져야 한다. 이리 와."
	<<else>>
		<<beasttype>>【이가】 <<bhis>> 날개를 흔든다. <<bHe>>【은는】 횃대에서 물러나 목욕용 연못 쪽으로 걸어간다.
	<</if>>
	<br><br>

	<<link [[따라간다 (0:30)|Bird Tower Bathe Bird]]>><<bird_pass 30>><<endevent>><<set $phase to 1>><</link>><<if $monster is 1>><<handholdingvirginitywarning>><<NPCvirginitywarning "Great Hawk" "handholding">><</if>>
	<br>
	<<link [[머무른다|Bird Tower Perch]]>><<endevent>><</link>>
	<br>
<<elseif ($bird.activity is "sing" or $bird.activity is "groom") and $bird.state is "home">>
	<<if $birdPerch is undefined>>
		<<set $birdPerch to 1>>
		당신은 <<if $bird.upgrades.decor gte 3>>커튼을 밀치고 <</if>><<beasttype>>【와과】 함께 <<bhis>> 횃대에 오른다.
		<<if $syndromebird isnot 1>>
			<<bird_greeting>>
			<<bHe>>【은는】 <<bhis>> 날개를 펼치지만, 당신은 <<bhes>>【이가】 무엇을 하려는지 확신할 수 없다.
			<<if $bird.activity is "sing" and $bird.state is "home">>
				잠시 후, <<bhis>> 날개가 내려가고 <<bhis>> 노래가 계속된다.
			<<else>>
				잠시 후, <<bhis>> 날개가 내려가고 <<bhe>>【은는】 계속해서 깃을 다듬는다.
			<</if>>
			<br><br>
		<<else>>
			<<bird_greeting>>
			<<if $monster is 1>>
				<<bHe>>【은는】 <<bhis>> 날개를 펼쳐, 당신을 <<bhis>> 무릎에 앉으라고 초대한다.
			<<else>>
				<<bHe>>【은는】 <<bhis>> 날개를 펼쳐, 바람으로부터 당신을 보호해주려 한다.
			<</if>>
			<br><br>
		<</if>>
	<<elseif $birdBask is 0>>
		<<unset $birdBask>>
		<<beasttype>>【이가】 <<bhis>> 날개를 들어 올려 당신이 일어설 수 있게 해준다.
		<br><br>
	<<else>>
		당신은 <<beasttypes>> 횃대에 있다. <<bHe>>【은는】 허공에 노래한다. 당신 앞에는 황야가 펼쳐져 있다.
		<br><br>
	<</if>>
	<<bird_perch_options>>

<<else>>
	당신은 <<beasttypes>> 횃대에 서 있다. 당신 앞에는 황야가 펼쳐져 있다.
	<<if $bird.state is "home">>
		<<switch $bird.activity>>
			<<case "bathe">>
				<<your_bird_text "cap">>【이가】 빗물 웅덩이에서 목욕하고 있다.
			<<case "rest">>
				<<your_bird_text "cap">>【은는】 둥지에서 쉬고 있다.
			<<case "build">>
				<<if $birdShelterRepair>>
					<<unset $birdShelterRepair>>
					<span class="teal"><<your_bird_text "cap">>【이가】 나뭇잎과 잔가지로 지붕의 구멍을 메우고 있다.</span>
				<<else>>
					<<your_bird_text "cap">>【이가】 둥지를 보수하고 있다.
				<</if>>
			<<case "brood">>
				<<set _eggCountNest to nestEggCount()>>
				<<your_bird_text "cap">>【이가】 둥지에 앉아 <<pluralise _eggCountNest "알">>을 품고 있다.
			<<default>>
				<<your_bird_text "cap">>【은는】 <<bhis>> 둥지에서 쉬고 있다.
				<<set $birdSleep to 1>>
		<</switch>>
	<<else>>
		<<your_bird_text "cap">>【이가】 사냥을 나갔다.
	<</if>>
	<br><br>
	<<bird_perch_options>>
<</if>>

:: Bird Tower Preen Self
<<setTowerTemp>><<effects>>

<<if $plucked>>
	당신은 날개를 손질하려 하지만, 그윌란이 남겨둔 것이 없다. 당신은 이미 완전히 깃이 뽑혔다.
<<elseif $daily.birdSelfPreen is undefined>>
	<<set $daily.birdSelfPreen to 1>>
	당신은 날개를 손질한다. 혼자서는 더 힘들다.
	<<set _selfFeatherNum to random(1,2)>>
	<<switch _selfFeatherNum>>
		<<case 1>>헐거웠던 깃털 하나가 빠졌다. <span class="teal">당신은 그것을 챙긴다.</span>
		<<case 2>>헐거웠던 깃털 몇 개가 빠졌다. <span class="teal">당신은 그것들을 챙긴다.</span>
	<</switch>>
	<<set $bird.materials.feathers += _selfFeatherNum>>
	<<wearProp "pc feather" "hair">>
<<else>>
	당신은 날개를 손질한다. 지금은 더 이상 뽑을 깃털이 없지만, 그래도 기분이 나아진다.
<</if>>
<br><br>
<<bird_perch_options>>

:: Bird Tower Bask
<!-- This passage is only accessible to a player that already has stockholm syndrome. -->
<<set $player.bodyTemperature to Math.clamp(($player.bodyTemperature + 1), 33, 38)>>
<<setTowerTemp>><<effects>>
<<npc "Great Hawk">>
<<cleareventpool>>
<<if $birdBask is undefined>>
	<<set $birdBask to 1>>
	<<if $monster is 1>>
		당신은 <<beasttype>>의 무릎에 앉는다. <<bhe>>【이가】 당신 주위로 날개를 감싸 <<if Time.dayState is "dawn">>아침의 쌀쌀함<<elseif Time.dayState is "dusk">>저녁의 쌀쌀함<<else>>바람<</if>>【으로로】부터 당신을 보호한다.
	<<else>>
		당신은 <<beasttype>> 아래에 앉아, <<bhe>>【이가】 당신 주위로 날개를 감싸게 둔다.
	<</if>>
<</if>>
<<bird_schedule>>
<<if $bird.state is "home" and ["groom","sing"].includes($bird.activity) and birdEggsReady("Great Hawk")>>
	<<birdEggLayEvent "perch">>
<<elseif $bird.activity is "bathe" and $bird.state is "home">>
	<<unset $birdBask>><<unset $birdPerch>>
	<<if $monster is 1>>
		<<beasttype>>【이가】 일어나기 시작하며, 당신에게 <<bhis>> 손을 내민다. "깨끗해져야 한다. 이리 와."
	<<else>>
		<<beasttype>>【이가】 <<bhis>> 날개를 흔든다. <<bHe>>【은는】 횃대에서 물러나 목욕용 연못 쪽으로 걸어간다.
	<</if>>
	<br><br>
	<<link [[따라간다 (0:30)|Bird Tower Bathe Bird]]>><<bird_pass 30>><<endevent>><<set $phase to 1>><</link>><<if $monster is 1>><<handholdingvirginitywarning>><<NPCvirginitywarning "Great Hawk" "handholding">><</if>><br>
	<<link [[머무른다|Bird Tower Perch]]>><<endevent>><</link>><br>
<<else>>
	<<addinlineevent "bird_bask_wings">>
		<<if $harpy gte 6>>
			<<beasttype>>【이가】 잠시 노래를 멈추고, 당신의 날개를 부드럽게 손질하기 시작한다.
			<<if $monster is 1>>
				<<bhis>> 손길은 섬세하지만 신중하다. 당신의 깃털 사이를 훑는 <<bhis>> 손의 감촉이 몸 전체에 쾌감의 파도를 보낸다. <<arousal 1000>><<garousal>>
			<<else>>
				<<bHe>>【은는】 당신의 깃털 사이로 <<bhis>> 부리를 부드럽게 훑어내리자, 쾌감의 파도가 몸 전체로 퍼져나간다. <<arousal 1000>><<garousal>>
			<</if>>
			<<transform bird 1>>
			<<if $arousal gte $arousalmax>>
				<<orgasm>>
				<<if $monster is 1>>
					당신은 <<bhis>> 팔 안에서 등을 휘며 <<if Time.dayState is "dawn">>아침 공기<<elseif Time.dayState is "dusk">>저녁 공기<<else>>바람<</if>> 속으로 쾌감의 신음을 내지른다. <<bHe>>【이가】 당신을 가까이 껴안는다. "너의 짝짓기 노래는 듣기 좋군. 곧 함께 몸을 씻자."
					당신이 가볍게 떨자, <<bhe>>【이가】 조용히 당신에게 구구거리기 시작한다.
				<<else>>
					당신이 등을 휘자, <<bhe>>【이가】 당신이 떨어지지 않도록 날개로 감싼다. <<bHe>>【이가】 당신에게 조용히 구구거린다.
				<</if>>
				<<npcincr "Great Hawk" dom 5>><<ggdom>>
				<br><br>
				<<if $bird.activity is "sing" or $bird.activity is "groom">>
					<<link [[보상한다|Bird Tower Perch Sex]]>><<set $sexstart to 1>><<set $phase to 1>><<transform bird 1>><<npcincr "Great Hawk" love 1>><</link>><<deviant1>><<glove>><br>
				<</if>>
				<<bird_perch_options>>
			<<else>>
				<br><br>

				<<link [[즐긴다 (0:05)|Bird Tower Bask Groom]]>><<bird_pass 5>><<stress -3>><<npcincr "Great Hawk" love 1>><<npcincr "Great Hawk" dom 1>><</link>><<lstress>><<glove>><<gdom>><br>
				<<link [[밀어낸다|Bird Tower Bask Groom Push]]>><<npcincr "Great Hawk" dom -1>><</link>><<ldom>><br>
			<</if>>
		<<elseif $angel gte 6 or $demon gte 6 or $fallenangel gte 2>>
			<<beasttype>>【이가】 잠시 노래를 멈추고 당신의 날개를 살핀다.
			<<if $monster is 1>>
				"참 이상하군. 내 것과는 달라. 하지만 네 것이니, 여전히 아름다워."
			<<else>>
				<<bHe>>【은는】 이따금씩 쿡쿡 찔러보며, 생각에 잠긴 듯 그것들을 바라본다. <<bHe>>【은는】 아마 왜 <<bhis>> 자신의 것과 다르게 생겼는지 궁금해하는 것 같다.
			<</if>>
			<<bHe>>【은는】 얼마 후 <<bhis>> 노래를 다시 시작한다.
			<br><br>
			<<bird_perch_options>>
		<<else>>
			<<beasttype>>【이가】 당신의 등을 내려다본다. <<bHe>>【이가】 <<bhis>> 날개로 등을 문지른다.
			<<if $monster is 1>>
				"걱정 마. 네 것도 곧 자라날 거야. 그럼 함께 날 수 있겠지." <<if C.npc["Great Hawk"].love gte 50>>당신은 고개를 돌려 <<bhim>>【을를】 마주 본다. "기쁠 거예요. 하늘은 당신이 없으면 너무 텅 비어있으니까요."<</if>>
			<</if>>
				<<bHe>>【은는】 얼마 후 <<bhis>> 노래를 다시 시작한다.
			<br><br>
			<<bird_perch_options>>
		<</if>>
	<</addinlineevent>>

	<<addinlineevent "bird_bask_weather">>
		<<switch Weather.precipitation>>
			<<case "none">>
				<<if !Weather.isOvercast>>
					<<beasttypes>> 품에 안겨 앉아 있자니, <<if Weather.dayState is "dawn">>떠오르는<<elseif Weather.dayState is "dusk">>지는<</if>> 태양의 빛이 당신의 얼굴을 따스하게 감싼다. 평온함이 느껴진다. <<stress -12>><<trauma -3>><<lstress>><<ltrauma>>
				<<else>>
					잿빛 하늘이 마치 당신을 부르는 듯, 함께하자고 애원하는 것 같다. <<stress -3>><<lstress>>
				<</if>>
			<<case "rain">>
				축축한 풀의 희미한 냄새와, 돌에 부딪히는 빗방울의 합창이 <<beasttypes>> 노래와 어우러져 당신을 잠시 잠에 빠뜨린다. <<tiredness -20>><<ltiredness>>
			<<case "snow">>
				얼어붙을 듯한 공기와 멀리서 반짝이는 새로 내린 눈에도 불구하고, <<beasttypes>> 품 안은 완전히 따뜻하게 느껴진다. <<stress -6>><<trauma -3>><<lstress>><<ltrauma>>
			<<default>>
				당신은 <<beasttypes>> 품에 아늑하게 앉아 있다.
		<</switch>>
		<br><br>
		<<bird_perch_options>>
	<</addinlineevent>>

	<<addinlineevent "bird_bask_love_interest">>
		<<run statusCheck("Kylar")>><<checkforloveinterests>>
		당신의 생각은
		<<switch _loveInterest>>
			<<case "Robin">>
				로빈에게로 향한다.
				<<if C.npc.Robin.trauma gte 50>>
					<<nnpc_him "Robin">>【을를】 어떻게 떠나왔는지 기억하자 심장이 내려앉는다. <<stress 12>><<ggstress>>
				<<elseif C.npc.Robin.dom gte 50>>
					<<nnpc_he "Robin">>【이가】 당신을 찾으러 올지 궁금해진다.
				<<else>>
					<<nnpc_hes "Robin">>【이가】 어떻게 지내는지 궁금해지자 잠깐 죄책감이 스친다.
				<</if>>
			<<case "Kylar">>
				카일라에게로 향한다.
				<<if _kylarStatus.includes("Rage")>>
					<<nnpc_he "Kylar">>【이가】 당신을 찾으러 올지 궁금해진다. 곰곰이 생각해보니, '만약'이 아니라 '언제'의 문제라는 것을 깨닫는다. <<stress 3>><<gstress>>
				<<else>>
					당신이 없는 동안 <<nnpc_he "Kylar">>【이가】 괴롭힘당하지 않았으면 좋겠다.
				<</if>>
			<<case "Whitney">>
				휘트니에게로 향한다. 만약 <<nnpc_he "Whitney">>【이가】 이 모든 사실을 알게 된다면 무슨 짓을 할지 상상만 할 수 있을 뿐이다.
			<<case "Sydney">>
				시드니에게로 향한다.
				<<if Time.weekDay is 1>>
					<<nnpc_Hes "Sydney">> 아마 지금쯤 신전에서 열심히 일하고 있을 것이다.
				<<else>>
					<<nnpc_his "Sydney">>의 미소를 생각하니 마음이 따뜻해진다.
				<</if>>
			<<case "Eden">>
				에덴에게로 향한다. <<nnpc_He "Eden">>【은는】 아마 재미 삼아 거대 매를 사냥할 것이다. 특히 <<nnpc_he "Eden">>【이가】 당신이 무슨 짓을 하고 있는지 알게 된다면 말이다.
			<<case "Avery">>
				에이버리에게로 향한다.
				<<if Time.weekDay is 7 and $averyseen isnot 1>>
					<<nnpc_Hes "Avery">> 아마 지금 이 순간에도 당신을 찾고 있을 것이다, 또 다른 데이트를 신청하기 위해서.
				<<elseif $averydate is 1>>
					어쨌든, 나중에 데이트가 있다.
				<<elseif C.npc.Avery.rage gte 20 and $averyragerevealed is 1>>
					적어도 <<nnpc_he "Avery">>【이가】 진정할 때까지는, 이렇게 멀리 떨어져 있어서 다행이다.
				<<else>>
					당신의 현재 상황을 설명하며 체면을 차리려 애쓰는 <<nnpc_him "Avery">>【을를】 상상하니 웃음이 나온다.
				<</if>>
			<<case "Alex">>
				알렉스와 농장으로 향한다.
				<<if $farm.aggro gte 60>>
					레미가 <<nnpc_him "Alex">>에게 너무 많은 문제를 일으키지 않았으면 좋겠다.
				<<elseif $farm.tower_guard_unpaid gte 1>>
					$farm.tower_guard에게 아직 돈을 지불하지 않았다. 이게 거래를 파기할 정도는 아니길 바란다.
				<<else>>
					수확이 좋았으면 좋겠다.
				<</if>>
			<<case "Black Wolf">>
				숲과, 당신의 무리로 향한다. 그들이 당신을 그리워할지 궁금하다.
			<<default>>
				당신이 겪었던 모든 문제들과, 이곳에서는 그것들이 닿을 수 없다는 사실로 향한다. 지금 이 순간, 당신의
				<<if $monster is 1>>
					<<nnpc_wife "Great Hawk">>
				<<else>>
					거대 매,
				<</if>>
				날개에 감싸여, 당신은 누구도 건드릴 수 없을 것 같은 기분이 든다. <<trauma -10>><<lltrauma>>
		<</switch>>
		<br><br>
		<<bird_perch_options>>
	<</addinlineevent>>


	<<addinlineevent "bird_bask_see">>
		<<beasttype>>【이가】 노래를 멈추고 빠르게 고개를 돌려, 황야 저편의 무언가에 시선을 고정한다.
		<<if $monster is 1>>
			"뭔가 보인다. 저기." <<bHe>>【이가】 멀리 있는 무언가를 가리킨다.
		<<else>>
			<<bHe>>【은는】 무언가를 본 것이 틀림없다.
		<</if>>
		<<if $transformationParts.traits.sharpEyes isnot "disabled" or $bird.upgrades.telescope is 1>>
			<<if $transformationParts.traits.sharpEyes isnot "disabled">>
				당신의 뛰어난 시력 덕분에, 당신도 그것을 본다.
			<<else>>
				망원경으로 들여다보니, 당신도 그것을 본다.
			<</if>>
			<<switch random(1,6)>>
				<<case 1>>
					<<endevent>><<beastNEWinit 3 fox>>
					<<beastsplural>> 세 마리가 작은 언덕 위에서 서로 뒹굴고 씨름하고 있다.
					<<endevent>><<npc "Great Hawk">>
					<<if $monster is 1>>
						<<beasttype>>【이가】 작게 웃음을 터뜨리고,
					<<else>>
						<<beasttype>>【이가】 고개를 저으며,
					<</if>>
					노래로 돌아간다.
				<<case 2>>
					수평선 너머로 마을 방향으로 향하는 큰 무리의 사람들이 간신히 보인다.
					<<if $monster is 1>>
						"날개 없는 것들은 무리를 좋아하지. 난 그냥 <<wife>>【이가】 좋아." <<bhe>>【이가】 말하며,
					<<else>>
						<<bHe>>【은는】 당신의 뺨에 코를 비비고,
					<</if>>
					노래로 돌아간다.
				<<case 3>>
					<<if $hallucinations gte 2 and $settings.tentaclesEnabled>>
						멀리서 작고 보라색인 촉수가 땅에서 꿈틀거리며 나온다. 나타났던 것만큼이나 빠르게, 그것은 다시 땅 속으로 사라진다.
						<<if $monster is 1>>
							"저것들은 싫어. 시야를 온통 흐릿하게 만들어."
						<<else>>
							<<beasttype>>【이가】 짧게 비명을 지른다.
						<</if>>
						<<bHe>>【은는】 몇 분 후 노래로 돌아간다.
					<<else>>
						적어도, 당신은 그렇게 생각했다. 분명 무언가 있었던 것 같은데, 놓친 게 틀림없다.
						<<if $monster is 1>>
							"봤어? 작고, 보라색에 끈적이는 거. 난 저것들이 싫어." <<bHe>>【이가】 당신을 조금 더 꽉 껴안고,
						<<else>>
							<<beasttype>>【이가】 짧게 비명을 지르고,
						<</if>>
						몇 분 후 노래로 돌아간다.
					<</if>>
				<<case 4>>
					당신은 작은 언덕 뒤에서 기다리고 있는, 후드가 달린 검은 옷을 입은 수상해 보이는 사람을 본다. 몇 번 눈을 깜빡이자, 그들이 언제 사라졌는지 알 수 없다. <<beasttype>>【은는】 <<bhis>> 노래를 다시 시작한다.
				<<case 5>>
					멀리서 반짝이는 것이 보인다, 아주 빛나는 무언가다. 잠시 후, 당신은 그것이 반사되는 쓰레기 조각이라는 것을 깨닫는다.
					<<if $monster is 1>>
						"가서 가져오고 싶어." <<bhe>>【이가】 말하고는, <<bhis>> 자신의 깃털을 부풀린다. "하지만 지금이 편안해." <<bHe>>【이가】 <<bhis>> 노래를 다시 시작한다.
					<<else>>
						<<beasttype>>【이가】 비명을 지르지만, 어쨌든 <<bhis>> 노래를 다시 시작한다.
					<</if>>
				<<case 6>>
					멀리서 완전히 벌거벗은 사람을 본다.
					<<if $settings.tentaclesEnabled and $settings.plantsEnabled and ($hallucinations gte 2 or $backgroundTraits.includes("plantlover"))>>
						<<Plant_details>> 그들의 머리카락 곳곳에 흩어져 있고, 꿈틀거리는 덩굴들이 그들을 둘러싸고 있다. 처음에는 공격받고 있다고 생각했지만, 그들이 덩굴을 통제하고 있는 것처럼 보인다.
						<br><br>
						<<if $monster is 1>>
							"이상한 생물들이군." <<beasttype>>【이가】 말한다. "날개 없는 것들만큼이나 황야에 속해있어."
						<<else>>
							<<beasttype>>【이가】 의아한 듯 고개를 젓는다.
						<</if>>
					<<else>>
						노출된 몸도, <<if Weather.precipitation isnot "none">><<=window.KR.getWeatherKr(Weather.precipitation)>>도<</if>> 딱히 신경 쓰지 않는 눈치다.
						<<if $monster is 1>>
							"이상한 날개 없는 것이군," <<beasttype>>【이가】 말한다. "보통은 두 번째 깃털로 몸을 가리는 걸 좋아하는데."
						<<else>>
							<<beasttype>>【이가】 의아하다는 듯 고개를 갸웃거린다.
						<</if>>
					<</if>>
					<<bHe>>【은는】 몇 초 후 <<bhis>> 노래를 다시 시작한다.
				<<default>>
			<</switch>>
		<<else>>
			당신은 그것이 무엇이든 간에 제대로 알아볼 수 없다. 얼마 후, <<bhe>>【이가】 진정하고 <<bhis>> 노래를 다시 시작한다.
		<</if>>
		<br><br>
		<<bird_perch_options>>
	<</addinlineevent>>

	<<addinlineevent "bird_bask_cough">>
		<<beasttype>>【은는】 몇 분마다 잠시 멈추며 계속 노래한다.
		<<if $rng is 51>>
			어느 순간, <<bhe>>【이가】 다시 시작하는 데 어려움을 겪는 것처럼 보인다.
			<<if $monster is 1>>
				<<bHe>>【은는】 목을 가다듬기 위해 짧게 기침을 하고, 더 이상 문제없이 다시 시작한다.
			<<else>>
				<<bHe>> 고개를 앞뒤로 움직이기 시작하더니, <<bhis>> 목에서 작은 뼈처럼 보이는 것을 토해낸다. <<bHe>>【은는】 더 이상 문제없이 노래를 다시 시작한다.
			<</if>>
		<</if>>
		<br><br>
		<<bird_perch_options>>
	<</addinlineevent>>

	<<addinlineevent "bird_bask_hug">>
		<<beasttype>>【이가】 노래를 멈추고,
		<<if $monster is 1>>
			<<bhis>> 팔로 당신을 감싼다.
			"<<print either(
				"사랑해.",
				"나와 함께 있어줘서 고마워.",
				"혼자 있는 게 두려웠었지. 다시는 두려워할 필요 없어.",
				"넌 완벽해.",
				"내 거야."
			)>>"
		<<else>>
			<<bhis>> 머리를 당신의 어깨에 기댄다.
		<</if>>
		<br><br>

		<<if $bird.activity is "sing" or $bird.activity is "groom">>
			<<birdicon "kiss">><<link [[키스한다|Bird Perch Monster Kiss]]>><<npcincr "Great Hawk" love 1>><</link>><<glove>><<kissvirginitywarning>><<NPCvirginitywarning "Great Hawk" "kiss">><br>
		<</if>>
		<<bird_perch_options>>
	<</addinlineevent>>

	<<addinlineevent "bird_bask_sing">>
		<<beasttype>>의 목소리가 황야에 울려 퍼진다. 마치 모든 주민에게 보내는 힘찬 <<if Time.dayState is "dawn">>아침 인사<<elseif Time.dayState is "dusk">>저녁 인사<<else>>인사<</if>> 같다. 아니면 그냥 당신을 자랑하는 것일지도 모른다.
		<br><br>
		<<bird_perch_options>>
	<</addinlineevent>>

	<<addinlineevent "bird_bask_bird_to_bird_communication">>
		<<beasttype>>의 노래가 계속된다. 먼 곳에서, <<bhe>>【은는】 답가를 받는다. 두 마리는 서로 노래를 주고받다가, 다른 목소리가 잠잠해진다.
		<<if $monster is 1>>
			"<<print either(
				"하늘과 구름에 대한 지식을 공유했지. 언제나 가치 있는 일이야.",
				"이미 임자가 있다고 말해줘야 했어.",
				"우리의 최고의 사냥 이야기를 들려줬지.",
				"다른 이들의 이야기는 언제나 나를 흥분시켜.",
				"짝을 찾고 있더군. 우리가 잘 살펴봐야겠어."
			)>>"
		<</if>>
		<br><br>
		<<bird_perch_options>>
	<</addinlineevent>>

	<<addinlineevent "bird_bask_silent">>
		황야는 고요하고, 오직 <<beasttypes>> 노래만이 그 침묵을 깬다.
		<br><br>
		<<bird_perch_options>>
	<</addinlineevent>>

	<<addinlineevent "bird_bask_rest">>
		<<beasttype>>【이가】 목소리를 쉬게 한다.
		<br><br>
		<<bird_perch_options>>
	<</addinlineevent>>

	<<addinlineevent "bird_bask_familiar" 0.1>>
		<<if $seabird_lullaby gte 2>>
			잠시 동안, <<beasttypes>> 멜로디는 당신에게 <span class="teal">바다새의 자장가</span>를 떠올리게 한다.
		<<else>>
			<<set $seabird_lullaby to 1>>
			<span class="teal"><<beasttypes>> 멜로디에는 뭔가 익숙한 것이 있다,</span> 하지만 당신은 그것이 무엇인지 정확히 <<if $harpy gte 6>>날개<<else>>손가락<</if>>【으로로】 짚어낼 수 없다.
		<</if>>
		<br><br>
		<<bird_perch_options>>
	<</addinlineevent>>

	<<if !$daily.birdBodyWriting>>
		<<bodywritingExposureCheck>>
		<<if _bodywriting_exposed gte 1 and _bodypart>>
			<<addinlineevent "bird_bask_bodywriting">>
				<<set $daily.birdBodyWriting to true>>
				<<beasttype>>【이가】 노래를 멈춘다. 당신의 <<bodypart _bodypart>>에 있는 <<tattoo _bodypart>>에 끈질기지만 조심스러운 쿡쿡 찌르는 느낌이 든다.
				<br><br>

				<<if $monster is 1>>
					<<beasttype>>【은는】 잉크가 지워지지 않는 것을 알아차리자 당신을 만지는 것을 멈춘다. "<<Wife>>【은는】 깃털 손질이 필요한가? 걱정 마, 내가 도와줄게." <<bhe>>【이가】 말한다. <<bHe>>【은는】 <<bhis>> 손가락 끝을 핥고, 이번에는 더 큰 압력으로 당신의 피부를 다시 문지르기 시작한다.
				<<else>>
					<<beasttype>>【이가】 당신을 만지는 것을 멈춘다. <<bHe>>【이가】 당신의 피부를 핥고, 이번에는 더 큰 압력으로 <<bhis>> 부리를 다시 문지르기 시작한다.
				<</if>>
				<<if ["marker","tattoo","brand","magic"].includes($skin[_bodypart].pen)>>
					<<bhe>>【이가】 무슨 짓을 하든, 잉크는 지워지지 않는다.
				<</if>>
				<br><br>

				<<capture _bodypart>>
					<<link [[허락한다|Bird Tower Tattoo Preen]]>><<set $phase to 0>><</link>>
					<br>
					<<if ["marker","tattoo","brand","magic"].includes($skin[_bodypart].pen)>>
						<<link [[설명하려 한다|Bird Tower Tattoo Preen]]>><<set $phase to 1>><</link>>
					<<else>>
						<<link [[밀어낸다|Bird Tower Tattoo Preen]]>><<set $phase to 2>><<npcincr "Great Hawk" dom -1>><</link>><<ldom>>
					<</if>>
					<br>
				<</capture>>
			<</addinlineevent>>
		<</if>>
	<</if>>

	<<if $weekly.birdRescued>>
		<<addinlineevent "bird_bask_rescued">>
			<<run delete $weekly.birdRescued>>
			햇볕을 쬐는 동안, 당신의 생각은 최근에 겪은 시련으로 향한다.
			<<if $remySeen?.includesAny("farm","livestock","manor") or $livestock.intro isnot undefined>>
				황야에서 레미의 폭력배들과 겪었던 일.
			<<else>>
				황야에서 당신을 납치하려 했던 사람들.
			<</if>>
			당신은 본능적으로 몸을 웅크린다.
			<br><br>


			무언가 따뜻한 것이 당신의 등을 덮는다. <<beasttype>>【이가】 <<bhis>>
			<<if $monster is 1>>
				팔로 당신의 어깨를 감싼다. "<<Wife>>【은는】 나와 함께 여기서 안전해." <<bHe>>【이가】 당신의 머리카락에 코를 묻고, 부드럽게 당신에게 몸을 기댄다. 너무나 평온해서, 당신은 <<bhis>> 포옹에 몸을 기대게 된다.
			<<else>>
				날개로 당신의 어깨를 감싼다. <<bHe>>【이가】 마치 당신이 새끼인 것처럼 극도로 조심스럽게 당신의 귀와 뺨 주위를 쪼아댄다. <<bhis>> 부드러운 움직임이 당신을 진정시킨다.
			<</if>>
			이제 기분이 나아졌다. <<trauma -3>><<stress -3>><<lstress>><<ltrauma>>
			<br><br>
			<<bird_perch_options>>
		<</addinlineevent>>
	<</if>>

	<<if playerIsPregnant() and playerNormalPregnancyType() is "hawk" and talkedAboutPregnancy("pc","Great Hawk")>>
		<<addinlineevent "bird_bask_pregnant_sing_player">>
			<<beasttype>>【이가】 당신의 <<bellyDescription>>에 머리를 숙이고, 부드럽게 노래를 계속한다. <<bHe>>【은는】 당신의 태어나지 않은 새끼들에게 노래를 불러주고 있다. <<lltrauma>><<trauma -6>>
			<br><br>
			<<bird_perch_options>>
		<</addinlineevent>>

		<<if $monster is 1>>
			<<addinlineevent "bird_bask_pregnant_rub_player">>
				<<beasttype>>【이가】 당신의 <<bellyDescription>>에 손을 내리고, 부드럽게 문지른다. <<lltrauma>><<trauma -6>>
				<br><br>
				<<bird_perch_options>>
			<</addinlineevent>>
		<</if>>
	<</if>>

	<<runeventpool>>
<</if>>

:: Bird Tower Tattoo Preen
<<setTowerTemp>><<effects>>
<<if $phase is 0>>
	<<if ["marker","tattoo","brand","magic"].includes($skin[_bodypart].pen)>>
		불가능한 일임에도 불구하고, 당신은 <<beasttype>>【이가】 당신의 피부에서 잉크를 핥아내도록 내버려 둔다.
		<<if $monster is 1>>
			결국, <<bhe>>【은는】 당신을 손질하는 것을 포기한다. "이상한 종류의 새로운 흙이군." <<bhe>>【이가】 말한다. "나중에 물로 씻어내야겠어."
		<<else>>
			결국, <<bhe>>【은는】 당신을 손질하는 것을 포기한다. <<bHe>>【은는】 짜증이 난 듯 깍깍거린다.
		<</if>>
		거칠게 문지르는 바람에 피부가 약간 따끔거린다. <<pain 4>><<gpain>>
	<<else>>
		당신은 <<bhe>>【이가】 계속하도록 내버려 두었고, 마침내 글씨는 사라졌다. <<bodywriting_clear _bodypart>><<npcincr "Great Hawk" dom 1>><<gdom>>
	<</if>>
<<elseif $phase is 1>>
	<<switch $skin[_bodypart].pen>>
		<<case "marker">>
			<<set _tattoo to "permanent marker">>
			<<set _tattwo to "mark hers">>
		<<case "brand">>
			<<set _tattoo to "a brand">>
			<<set _tattwo to "brands">>
		<<default>>
			<<set _tattoo to "a tattoo">>
			<<set _tattwo to "tat twos">>
	<</switch>>
	<<set _tattooKr to {"permanent marker": "유성 매직", "a brand": "낙인", "a tattoo": "문신"}[_tattoo]>>
	<<if $monster is 1>>
		<<if $speech_attitude is "meek">>
			"이건 _tattooKr라는 거야. 미안하지만, 아무리 열심히 닦아도 지울 수 없어." 당신이 말한다.
		<<elseif $speech_attitude is "bratty">>
			"이건 _tattooKr라는 건데, 지워지지 않아." 당신이 말한다. "<<= _tattoo is "permanent marker" ? '적어도 지금은 말이야' : '영원히'>>."
		<<else>>
			"이건 _tattooKr라고 하는데, <<= _tattoo is "permanent marker" ? "음... 영구적이야. 적어도 지금은" : "영구적이야">>." 당신이 말한다.
		<</if>>
		<br><br>

		"정말?" <<beasttype>>【이가】 당신의 <<tattoo _bodypart>>【을를】 살피기 위해 손질을 멈추며 묻는다. "<<Wife>>【은는】 더 조심해야 해. 더 이상... _tattwo가 묻지 않게 해."

		<<if $skin[_bodypart].special is "Great Hawk">>
			<br><br>

			당신은 잉크를 가리키며 그것이 무엇을 의미하는지 설명하려 한다.
			<<if $speech_attitude is "meek">>
				"이건 좀 특별한 거야." 당신이 말한다. "내가 당신의 것이라는 뜻이야."
			<<elseif $speech_attitude is "bratty">>
				"읽을 수는 있어?" 당신이 묻는다. "당신에 대한 내용이 적혀 있어."
			<<else>>
				"이건 특별해. 당신 때문에 새긴 거야." 당신이 설명한다.
			<</if>>
			<br><br>

			<<beasttype>>【은는】 호기심에 고개를 갸웃거리며 당신의 설명을 듣는다. "무슨 뜻인지는 잘 모르겠어. 하지만 <<wife>>【을를】 믿어."
		<</if>>
	<<else>>
		당신은 <<beasttype>>에게 피부의 잉크를 핥아내는 것이 왜 소용없는 일인지 설명하려 한다. <<beasttype>>【은는】 당신이 말하는 동안 손질을 멈추고 당신의 목소리를 듣지만, <<bhe>>【이가】 한 마디라도 이해했는지는 의심스럽다.
	<</if>>
	<<bHe>><<bhis>> 노래로 돌아가고, 당신도 다시 햇볕을 쬐는 것으로 돌아간다.
<<else>>
	당신은 <<bhim>>의 머리를 툭 친다.
	<<if $skin[_bodypart].special is "Great Hawk">>
		<<if $monster is 1>>
			<<if $speech_attitude is "meek">>
				"미안하지만, 이건 특별해. 내가 당신의 것이라는 뜻이야." 당신이 말한다.
			<<elseif $speech_attitude is "bratty">>
				"읽을 수는 있어?" 당신이 묻는다. "당신에 대한 내용이 적혀 있어."
			<<else>>
				"이건 특별해. 당신에 관한 거야." 당신이 설명한다.
			<</if>>
			<br><br>

			<<beasttype>>【은는】 호기심에 고개를 갸웃거리며 당신의 설명을 듣는다. "무슨 뜻인지는 잘 모르겠어. 하지만 <<wife>>【을를】 믿어."
		<<else>>
			당신은 <<beasttype>>에게 그 글이 <<bhim>>에 관한 것이라고 설명하려 한다. <<bHe>>【은는】 당신이 말하는 동안 손질을 멈추고 당신의 목소리를 듣지만, <<bhe>>【이가】 한 마디라도 이해했는지는 의심스럽다.
		<</if>>
	<<else>>
		<<if $monster is 1>>
			"미안, 민감한 부위인 줄 몰랐어." <<bhe>>【이가】 <<bhis>> 이마를 문지르며 말한다.
		<<else>>
			<<bHe>><<bhis>> 머리를 흔들더니, <<bhis>> 노래로 돌아간다.
		<</if>>
	<</if>>
<</if>>
<br><br>
<<bird_perch_options>>

