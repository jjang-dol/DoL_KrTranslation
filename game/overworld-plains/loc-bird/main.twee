:: Bird Tower
<<if $bird.state is undefined>>
	<<bird_init>>/*Fixes rare broken save issue*/
<</if>>
<<set $location to "tower">><<setTowerTemp>><<effects>><<getTarget true>>
<<bird_schedule>>

당신은 황야 깊은 곳, <<if $syndromebird is 1>>당신의 탑<<else>>폐허가 된 탑<</if>> 안에 있다.
<<switch $bird.upgrades.decor>>
	<<case 1>>장식들을 꾸며둔 덕에 돌벽이 조금 더 생기 있어 보인다.
	<<case 2>>당신이 꾸며둔 장식 덕분에, 이곳도 점점 더 쾌적해 보이기 시작한다.
	<<case 3>>당신이 꾸며둔 예쁜 장식들이 이곳을 집처럼 느껴지게 만든다.
	<<case 4 5>>아름다운 전리품과 장식들을 꾸며두니, 그 어느 때보다 보기 좋아졌다.
	<<default>>
<</switch>>
<<if $bird.upgrades.firepit gte 1 and getBirdBurnTime() gt 0>>
	<<if getBirdBurnTime() gt 720>>
		<<if $bird.upgrades.decor gte 3>>
			화덕에서 나오는 많은 빛으로 당신의 전리품들이 기분 좋게 빛난다.
		<<else>>
			화덕의 밝은 빛이 탑 전체를 비춘다.
		<</if>>
	<<elseif getBirdBurnTime() gt 360>>
		<<if $bird.upgrades.decor gte 3>>
			화덕의 밝은 빛이 당신의 전리품들을 멋지게 빛나게 한다.
		<<else>>
			화덕의 불꽃이 탑을 환하게 비춘다.
		<</if>>
	<<elseif getBirdBurnTime() gt 180>>
		타오르는 화덕이 탑을 비춘다.
	<<else>>
		불이 켜진 화덕이 탑을 약간 밝힌다.
	<</if>>
<</if>>
<<if Weather.precipitation is "rain" or Weather.precipitation is "snow">>
	<<switch $bird.upgrades.shelter>>
		<<case 0>><<= Weather.precipitation is "rain" ? "위쪽의 침식된 돌벽돌 사이로 빗물이 샌다" : "위쪽의 침식된 돌벽돌 사이로 눈발이 스며든다">>. <span class="red">임시로 만든 나뭇잎 지붕이 무너졌다.</span>
		<<case 1>><<= Weather.precipitation is "rain" ? "빗방울이 지붕 구멍을 덮은 나뭇잎을 두드린다" : "눈이 지붕 구멍을 덮은 나뭇잎 위에 쌓인다">>.
		<<default>>
	<</switch>>
<</if>>
<<if $syndromebird isnot 1>><<hunger_description>><</if>>
<br><br>

<<if isPregnancyEnding() and !$possessed>>
	<<pregnancyPassout "castle">>
<<elseif !$possessed and getBornChildren().find(child => (child.species is "hawk" and child.development.location is "inventory") or (child.development.location is "tower" and childIsUnhatchedEgg(child) and Time.date.timeStamp gte getHatchDate(getPregnancyOf(child))))>>
	/* Move hawk eggs that the player has to the nest */
	<<run getBornChildren().forEach(child => {
		if (child.species is "hawk" and child.development.location is "inventory") {
			if (!V.eggsMoved) V.eggsMoved = [];
			V.eggsMoved.push(child.childId);
			T.movedToTower to true;
			child.development.location to "tower";
		}
		if (child.development.location is "tower" and childIsUnhatchedEgg(child) and Time.date.timeStamp gte getHatchDate(getPregnancyOf(child))) {
			if (!V.eggsHatched) V.eggsHatched = [];
			V.eggsHatched.push(child.childId);
			T.readyToHatch to true;
		}
	})>>
	<<npc "Great Hawk">>
	<<if _movedToTower and _readyToHatch>>
		<<set _eggIcon to $eggsMoved.length>>
		<span class="blue">당신은 당신의 <<pluralise $eggsMoved.length "알" "알">>【을를】 둥지에 조심스럽게 놓는다.</span> <<pluralise $eggsMoved.length "그것" "그것들">>【이가】 안전한 것을 보자 안도감이 든다. <<if $bird.upgrades.nest gte 2>><<pluralise $eggsMoved.length "그것" "그것들">>【이가】 포근하도록 천을 모아 덮어준다.<</if>> <<Number $eggsMoved.length>> <<birdicon "eggs">> 수정된 새의 <<pluralise $eggsMoved.length "알이" "알들이">> 둥지로 옮겨졌다.
		<br><br>

		<<if $eggsMoved.includesAny($eggsHatched)>>
			<<if $eggsMoved.length gte 2>>마지막 알<<else>>그것<</if>>에서 손을 떼는 바로 그 순간, 알이 아주 살짝 흔들린다. 부드러운 금 가는 소리와 그보다 더 희미한 지저귐이 들린다. <span class="green"><<pluralise $eggsHatched.length "부화하려고 한다" "부화하려고 한다">>!</span>
		<<else>>
			<<pluralise $eggsMoved.length "그것" "그것들">>【을를】 그대로 두고 떠나려는 순간, 다른 알 <<number $eggsHatched.length>>개가 아주 살짝 흔들리기 시작하는 것이 보인다. 부드러운 금 가는 소리와 그보다 더 희미한 지저귐이 들린다. <span class="green"><<pluralise $eggsHatched.length "부화하려고 한다" "부화하려고 한다">>!</span>
		<</if>>
		<br><br>

		<<link [[다음 (0:30)|Bird Tower Hatching]]>><<bird_pass 30>><<set $phase to 1>><</link>>
	<<elseif _readyToHatch>>
		<<if $bird.state is "home">>
			<<if $monster is 1>>
				"<<Wife>>! <<Wife>>, 빨리 와봐!" <<your_bird_text "cap">>【은는】 사랑과 흥분으로 당신을 바라본다
			<<else>>
				흥분한 울음소리와 지저귐이 들린다. <<your_bird_text "cap">>【은는】 당신을 똑바로 쳐다본다
			<</if>>
			둥지 가장자리에서 들린다. 그 안에서 더 부드러운 지저귐이 들려온다. 당신은 서둘러 다가간다.
		<<else>>
			<<set $phase to 1>>
			둥지에서 부드러운 지저귐이 들린다. 당신은 서둘러 다가간다.
		<</if>>
		<<if $eggsHatched.length gte 2>>
			<span class="green">당신의 알 몇 개가 부화하고 있다!</span>
		<<else>>
			<<if getChildrenAt("tower").filter(child => childIsUnhatchedEgg(child) and Time.date.timeStamp lt getHatchDate(getPregnancyOf(child))).length gte 2>>
				<span class="green">당신의 알 하나가 부화하고 있다!</span>
			<<else>>
				<span class="green">당신의 알이 부화하고 있다!</span>
			<</if>>
		<</if>>
		<br><br>

		<<link [[다음 (0:30)|Bird Tower Hatching]]>><<bird_pass 30>><</link>>
	<<else>>
		<<set _eggIcon to $eggsMoved.length>>
		<span class="blue">당신은 당신의 <<pluralise $eggsMoved.length "알" "알">>【을를】 둥지에 조심스럽게 놓는다.</span> <<pluralise $eggsMoved.length "그것" "그것들">>【이가】 안전한 것을 보자 안도감이 든다. <<if $bird.upgrades.nest gte 2>>포근하도록 천을 모아 덮어준다.<</if>> <<Number $eggsMoved.length>> <<birdicon "eggs">> 수정된 새의 <<pluralise $eggsMoved.length "알이" "알들이">> 둥지로 옮겨졌다. <<bird_stockholm 3>><<ggbirdstockholm>>
		<br><br>

		<<if $bird.state is "home">>
			<<your_bird_text "cap">>
			<<switch $bird.activity>>
				<<case "sleep" "rest">>잠에서 깨어나며,
				<<case "build" "brood">>당신을 바라보며,
				<<case "bathe">>빗물 웅덩이에서 뛰쳐나와 재빨리 <<if $monster is 1>>달려<<else>>깡충거리며<</if>> 다가오고,
				<<default>>재빨리 깡충거리며 다가오고,
			<</switch>>
			무엇을 보고 있는지 깨닫자 놀라서 <<bhis>> 깃털을 부풀린다.
			<<if $monster is 1>>
				<<if getChildrenAt("tower").find(child => child.species is "hawk" and childIsBorn(child))>>
					"정말 기뻐, <<wife>>. <span class="lewd">우리 아이들이 더 생겼어</span>!" <<bHe>>【은는】 당신을 번쩍 안아 올린다. <<if $syndromebird gte 1>>당신도 어쩔 수 없이 끌어안는다<<else>>당신은 굳이 저항하지 않는다<</if>>.
				<<else>>
					<span class="lewd">"거대 매와 <<wife>>에게 아이들이 생겼다!"</span> <<bHe>>【은는】 당신을 번쩍 안아 올린다. <<if $syndromebird gte 1>>당신도 어쩔 수 없이 끌어안는다<<else>>당신은 굳이 저항하지 않는다<</if>>.
				<</if>>
			<<else>>
				<<bHe>>【은는】 <<pluralise $eggsMoved.length "그것" "그것들">>【을를】 쿡쿡 찔러보다가, 재빨리 고개를 든다. <<bHe>>【은는】 <<bhis>> 날개를 활짝 펼치고, 승리의 울음소리를 하늘로 내지른다. <<bHe>>【은는】 <<bhis>> 머리를 까딱이며 <<bhis>> 깃털을 부풀린다.
				<<bHe>>【은는】 한동안 우쭐거리더니, 당신에게 머리를 여러 번 들이민다. <<bHe>>【은는】 신이 난 듯하다.
			<</if>>
			<<npcincr "Great Hawk" love 3>><<npcincr "Great Hawk" dom 1>><<gglove>><<gdom>>
			<br><br>

			<<if $syndromebird isnot 1 and $bird.syndrome gte 15>>
				당신의 시선이 <<pluralise $eggsMoved.length "알" "알">>【으로로】 내려간다. 당신의 <<pluralise $eggsMoved.length "아이" "아이들">>. 당신의 마음이 본능적인 목적의식으로 가득 찬다. 당신은 <<bhis>> 어깨에 머리를 기댄다. <<bhis>> 깃털은 정말 부드럽다. <<bhim>>【와과】 함께 여기 머무는 것도 더는 나쁘게 느껴지지 않는다.
				<span class="red"><<bhis>> 탓이 아니다. <<bHe>>【은는】 그저 짝을 원할 뿐이다.
				<br>
				스톡홀름 증후군: 거대 매 특성을 획득했습니다.</span>
				<br><br>
				<<loveInterestAdd "Great Hawk">>
				<<set $syndromebird to 1>>
				<<unset $birdescaped>>
				<<run delete $bird.syndrome>>
				<br><br>
				<<specialClothesUnlock "set" "bird">>
			<</if>>
		<<else>>
			<<set $bird.eggReact to $eggsMoved.length>>
		<</if>>

		<<link [[다음|Bird Tower]]>><<endevent>><<unset $eggsHatched>><<unset $eggsMoved>><</link>>
	<</if>>
	<br>
<<elseif $bird.state is "home" and birdEggsReady("Great Hawk") and !$possessed>>
	<<birdEggLayEvent>>
<<elseif $stress gte $stressmax>>
	몸을 한계까지 밀어붙였다. 모든 것이 암전된다.
	<br><br>

	<<link [[다음|Bird Tower Passout]]>><<passout>><<endevent>><<bird_pass 30>><</link>>
	<br>
<<elseif $bird.state is "home" and $bird.activity isnot "sleep" and $bird.eggReact>>
	<<npc "Great Hawk">>
	당신은 <<your_bird_text>>【이가】 경외감 어린 눈으로 둥지를 들여다보는 것을 본다. <<bHes>> 당신의 <<pluralise $bird.eggReact "알" "알">>【을를】 발견했다. <<bHe>>【은는】 고개를 들고서야 마침내 당신을 알아차린다.
	<<if $monster is 1>>
		<<if getChildrenAt("tower").find(child => child.species is "hawk" and childIsBorn(child))>>
			"정말 기뻐, <<wife>>. <span class="lewd">우리 아이들이 더 생겼어</span>!" <<bHe>>【은는】 당신을 번쩍 안아 올린다. <<if $syndromebird gte 1>>당신도 어쩔 수 없이 끌어안는다<<else>>당신은 굳이 저항하지 않는다<</if>>.
		<<else>>
			<span class="lewd">"거대 매와 <<wife>>에게 아이들이 생겼다!"</span> <<bHe>>【은는】 당신을 번쩍 안아 올린다. <<if $syndromebird gte 1>>당신도 어쩔 수 없이 끌어안는다<<else>>당신은 굳이 저항하지 않는다<</if>>.
		<</if>>
	<<else>>
		<<bHe>>【은는】 <<bhis>> 날개를 활짝 펼치고, 승리의 울음소리를 하늘로 내지른다. <<bHe>>【은는】 <<bhis>> 머리를 까딱이며 <<bhis>> 깃털을 부풀린다.
		<<bHe>>【은는】 한동안 우쭐거리더니, 당신에게 머리를 여러 번 들이민다. <<bHe>>【은는】 신이 난 듯하다.
	<</if>>
	<<npcincr "Great Hawk" love 3>><<gglove>>
	<br><br>

	<<if $syndromebird isnot 1 and $bird.syndrome gte 15>>
		당신의 시선이 <<pluralise $bird.eggReact "알" "알">>【으로로】 내려간다. 당신의 <<pluralise $bird.eggReact "아이" "아이들">>. 당신의 마음이 본능적인 목적의식으로 가득 찬다. 당신은 <<bhis>> 어깨에 머리를 기댄다. <<bhis>> 깃털은 정말 부드럽다. <<bhim>>【와과】 함께 여기 머무는 것도 더는 나쁘게 느껴지지 않는다.
		<span class="red"><<bhis>> 탓이 아니다. <<bHe>>【은는】 그저 짝을 원할 뿐이다.
		<br>
		스톡홀름 증후군: 거대 매 특성을 획득했습니다.</span>
		<br><br>
		<<loveInterestAdd "Great Hawk">>
		<<set $syndromebird to 1>>
		<<unset $birdescaped>>
		<<run delete $bird.syndrome>>
		<br><br>
		<<specialClothesUnlock "set" "bird">>
	<</if>>
	<<run delete $bird.eggReact>>

	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<<elseif $bird.state is "hunting" and $bird.timer lte 0 and !$possessed>>
	<<npc "Great Hawk">>
	<<beasttype>>【이가】 돌아오는 날갯짓 소리가 들린다.

	<<bHe>>【이가】 내려앉더니 당신 쪽으로 <<if $monster is 1>>걸어온다<<else>>깡충깡충 뛰어온다<</if>>.
	<<bird_hunt_return>>
<<elseif $bird.state is "home" and !["brood","sleep"].includes($bird.activity) and !$bird.override and Weather.dayState isnot "night" and $bird.timer lte 0 and !$possessed>>
	<<npc "Great Hawk">>
	<<bird_hunt_start>>
<<elseif $bird.state is "home" and $bird.lock is 1 and $syndromebird is 1 and !$possessed>>
	<<npc "Great Hawk">>
	<<beasttype>>【은는】 방 안쪽으로 더 깊이 <<if $monster is 1>>걸어<<else>>깡충거리며<</if>> 들어온다. <<bHe>>【은는】 다락문 옆에 멈춰 서서 녹슨 자물쇠를 <<bhis>> 발톱 사이에 붙잡는다. <<bHe>>【은는】 한 번에 그것을 으스러뜨리고, 남은 금속을 움켜쥔 뒤 문을 활짝 열어젖힌다.
	<<if $bird.clean lte 15>>
		<<bHe>>【은는】 먼지구름을 피해 펄쩍 물러난다.
	<</if>>
	<br><br>

	<<if $monster is 1>>
		"네가 나가기 더 쉬워져," <<bhe>>【이가】 말한다. "내가 밖에 있으면. 오래 비우지만 마, <<wife>>. 네가 없으면 둥지가 차가워."
	<<else>>
		<<bHe>>【은는】 구멍 쪽으로 고개를 끄덕이고, 다시 둥지를 돌아보며 지저귄다.
	<</if>>
	<br><br>

	어둠 속을 들여다본다. 돌계단이 어둠 속으로 나선형으로 이어진다.
	<br><br>
	<<run delete $bird.lock>>

	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<<elseif $bird.upgrades.mirror is 1 and $bird.mirror_unknown is 1 and $bird.state is "home" and !$possessed>>
	<<run delete $bird.mirror_unknown>>
	<<npc "Great Hawk">>
	끼익거리는 소리가 들린다. <<beasttype>>【은는】 발톱을 뻗은 채 공중에 떠 있고, 시선은 새 거울, 그 안의 <<bhis>> 모습에 고정되어 있다.
	<br><br>

	<<if $speech_attitude is "meek">>
		"그, 그냥 거울이야." 당신이 말한다. "우리 집에 하나 두고 싶었어."
	<<elseif $speech_attitude is "bratty">>
		"징징대지 마." 당신이 말한다. "그냥 거울이잖아."
	<<else>>
		"뭐가 문제야?" 당신이 묻는다. "그냥 거울인데."
	<</if>>
	<br><br>
	<<if $monster gte 1>>
		<<beasttype>>【이가】 내려앉는다. "싫다," <<bhe>>【이가】 말한다. <<bhis>> 발톱이 돌을 파고든다. "위험해. 하지만 네가 좋다면—" <<bHe>>【은는】 얼굴을 찡그린다. "쓰지 않을 때는 뭔가 덮어 둬."
	<<else>>
		<<bHe>>【은는】 지저귀고, <<bhis>> 발톱이 돌을 파고든다. <<bHe>>【은는】 잠시 날아갔다가 커다랗게 찢어진 천 조각을 가져와 거울 위에 떨어뜨린다.
	<</if>>
	<br><br>

	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<<elseif $bird.state is "home" and $bird.activity is "build" and $bird.upgrades.shelter gte 2 and $birdShelterTimer and $birdShelterTimer lte 0 and !$possessed>>
	<<npc "Great Hawk">><<set _loot to either("stick", "leaf")>><<wearProp _loot>>
	<<beasttype>>【이가】 보금자리를 수리하기 위해 나뭇가지와 잎사귀를 나르는 것이 보인다. <<bHe>>【은는】 <<bhe>>【이가】 당신이 낡은 보금자리 자리에 지은 것을 보고 멈춘다.
	<br><br>

	<<if $monster is 1>>
		"이건 <<Wife>>【이가】 한 건가?" <<bHe>>【이가】 방수포를 힘껏 당겨보고, 그것이 버티자 감명받은 듯 보인다. <<bHe>>【은는】 활짝 웃고는 당신에게 다가와 껴안는다.
		"낡은 건 여러 번 고쳐야 했어. 축축하고 잠 못 이루는 밤이 많았지. 고마워." <<bHe>>【은는】 당신을 경애의 눈빛으로 바라본다.
	<<else>>
		<<bHe>>【은는】 방수천을 쿡쿡 찌르고 잡아당기며, 어떤 물건인지 시험해 본다. 당신이 <<bhim>>【을를】 말리려는 순간, <<bhe>>【은는】 당신을 보고 지저귀기 시작한다.
		<<bHe>>【은는】 <<bhis>> 깃털을 부풀리고 <<bhis>> 머리를 까딱이기 시작한다. 당신이 한 일이 마음에 든 것 같다.
	<</if>>
	<<npcincr "Great Hawk" love 6>><<ggglove>>
	<br><br>

	<span class="teal">당신은 <<bhe>>【이가】 가져오던 나뭇가지와 나뭇잎을 나중을 위해 보관한다.</span> <<set $bird.materials.sticks += 2>><<set $bird.materials.leaves += 2>>
	<br><br>
	<<unset $birdShelterTimer>>

	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<<elseif $bird.state is "home" and $bird.activity is "bathe" and $bird.upgrades.pot gte 3 and getBirdBurnTime() gte 1 and $bird.heat_unknown and !$possessed>>
	<<run delete $bird.heat_unknown>>
	<<npc "Great Hawk">>
	당신의 <<if $monster is 1>><<nnpc_wife "Great Hawk">><<else>>짝<</if>>【이가】 빗물 웅덩이로 걸어가는 것이 보인다. <<bHe>>【은는】 그 앞에서 멈춰, 거기서 피어오르는 김을 눈치챈다.
	<br><br>

	<<if $monster is 1>>
		<<bHe>>【은는】 당신을 돌아본다. "<<wife>>【이가】 물에 뭔가 했어? 이제 따뜻해," <<bhe>>【이가】 말한다. 당신은 물을 데울 방법을 찾았다고 <<bhim>>에게 말한다. <<bHe>>【은는】 놀란 표정이다. "<<Wife>>【이가】 그런 것도 할 수 있어? 대단해." <<bHe>>【은는】 당신의 기발한 솜씨에 감탄한다.
	<<else>>
		<<bHe>>【은는】 당신을 바라보며 <<bhis>> 고개를 기울인다. 당신은 물을 데울 방법을 찾았다고 <<bhim>>에게 말한다. <<beasttype>>【은는】 그것이 어떻게 가능한지 궁금한 듯 경외감 어린 눈으로 당신을 바라본다.
	<</if>>
	<br><br>

	<<bHe>>【은는】 물에 들어서더니 몸을 떤다. 아마 처음으로 뜨거운 물을 느끼는 모양이다. 처음에는 조금 긴장한 듯하지만, 곧 따뜻한 목욕이라는 생각에 익숙해진다.
	<<if $monster is 1>>
		"기분 좋다. 고마워, <<wife>>."
	<<else>>
		<<bHe>>【은는】 따뜻한 물이 생겨 기쁜 듯 즐겁게 지저귄다.
	<</if>>
	당신은 <<bhim>>【이가】 물을 즐기도록 내버려 둔다. <<npcincr "Great Hawk" love 1>><<glove>>
	<br><br>

	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<<elseif $bird.state is "home" and $bird.activity is "bathe" and $bird.upgrades.pot gte 3 and getBirdBurnTime() is 0 and !$bird.heat_unknown and !$daily.birdHeatRequest and Weather.temperature lte 15 and !$possessed>>
	<<set $daily.birdHeatRequest to true>>
	<<npc "Great Hawk">>
	<<your_bird_text "cap">>【이가】 당신에게 다가온다.
	<<if $monster is 1>>
		"<<wife>>【이가】 물을 다시 따뜻하게 해줄 수 있을까?" <<bhe>>【이가】 묻는다.
	<<else>>
		<<bHe>>【은는】 목욕 웅덩이 쪽을 가리키며 꽥꽥거린다. 다시 물을 데워 달라고 하는 것이다.
	<</if>>
	<br><br>

	<<birdicon "wood">>
	<<if $bird.materials.wood is 0>>
		<span class="red">넣을 목재가 없다.</span>
	<<else>>
		<<set _timeWood to 240>>
		<<if Weather.precipitation is "rain" and $bird.upgrades.shelter is 0>>
			<<set _timeWood to Math.floor(_timeWood / 2)>>
		<</if>>
		<<link [[나무를 추가한다|Bird Tower Warm Bath]]>>
			<<wearProp "wood">>
			<<set $phase to 1>><<npcincr "Great Hawk" love 1>><<set $bird.materials.wood-->>
			<<run Cooker.addBurnTime($bird.firepit, _timeWood * 60)>>
			<<run Weather.Observables.checkForUpdate()>>
		<</link>><<glove>><<note `"+ " + getTimeString(240)` `"green"`>>
	<</if>>
	<br>
	<<birdicon "sticks">>
	<<if $bird.materials.sticks is 0>>
		<span class="red">넣을 나뭇가지가 없다.</span>
	<<else>>
		<<set _timeSticks to 60>>
		<<if Weather.precipitation is "rain" and $bird.upgrades.shelter is 0>>
			<<set _timeSticks to Math.floor(_timeSticks / 2)>>
		<</if>>
		<<link [[나뭇가지를 추가한다|Bird Tower Warm Bath]]>>
			<<wearProp "stick">>
			<<set $phase to 1>><<npcincr "Great Hawk" love 1>><<set $bird.materials.sticks-->>
			<<run Cooker.addBurnTime($bird.firepit, _timeSticks * 60)>>
			<<run Weather.Observables.checkForUpdate()>>
		<</link>><<glove>><<note `"+ " + getTimeString(60)` `"green"`>>
	<</if>>
	<br>
	<<getouticon>><<link [[거절한다|Bird Tower Warm Bath]]>><<npcincr "Great Hawk" dom -1>><</link>><<ldom>>
	<br>
<<elseif $bird.upgrades.wardrobe is 1 and $bird.wardrobe_timer lte 1 and $bird.state is "home" and !$possessed>>
	<<run delete $bird.wardrobe_timer>>
	<<npc "Great Hawk">>
	<<beasttype>>의 하반신이 당신의 옷장에서 삐져나와 있는 것이 보인다. 당신은 <<bhim>> 뒤로 다가간다.
	<br><br>

	<<if $speech_attitude is "meek">>
		"뭐, 뭐 하는 거야?" 당신이 묻는다.
	<<elseif $speech_attitude is "bratty">>
		"야, 안 돼, 그만해! 왜 내 옷장에 들어가 있어?" 당신이 묻는다.
	<<else>>
		"뭐 하는 거야?" 당신이 묻는다.
	<</if>>
	<<bHe>>【은는】 깜짝 놀라 펄쩍 뛴다.
	<br><br>

	<<if $monster is 1>>
		<<bHes>> 찢어진 천 조각을 들고 있다. 그것을 걸어두려 했던 모양이다. "땅에 사는 것들의 깃털은 아직도 모르겠다. 미안." <<bHe>>【은는】 미안한 듯 그것을 당신에게 건넨 뒤 걸어간다.
	<<else>>
		<<bHe>>【은는】 <<bhis>> 부리에 찢어진 천 조각을 물고 있다. 그것을 당신의 옷장에 넣어두려 했던 모양이다. <<bHe>>【은는】 미안한 듯 당신의 발치에 그것을 떨어뜨리고 깡충깡충 물러난다.
	<</if>>
	<<wearProp "rag">>
	<<set $bird.materials.fabric ++>>
	<br><br>

	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<<elseif $bird.syndrome gte 20 and $syndromebird isnot 1 and $bird.state is "home" and $bird.activity isnot "sleep" and !$possessed>>
	<<npc "Great Hawk">>
	늘 그렇듯 <<bhe>>【이가】 하는 것처럼, 황야를 바라보는 <<beasttype>>【을를】 지켜본다. 어쩌면 빛이 <<bhis>> 깃털에 닿는 방식 때문일지도 모르지만, 오늘따라 <<bhe>>【은는】 더 위엄 있어 보인다. 당신은 순간 자신도 모르게 <<bhim>>【을를】 감상하고 있었다는 걸 깨닫는다. 그 사실을 알아차렸을 때, <<beasttype>> 역시 당신을 바라보고 있다는 것을 눈치챈다.
	<<if $monster is 1>>
		"<<wife>>도 나랑 같이 보러 갈래?" <<bhe>>【이가】 묻는다.
	<<else>>
		<<bHe>>【은는】 당신에게 <<bhis>> 날개를 퍼덕이며, <<bhim>>【와과】 함께 황야를 보러 오라고 손짓한다.
	<</if>>
	<br><br>

	당신은 <<bhim>>의 제안을 받아들이기로 하고, 횃대 위에서 <<bhim>> 옆에 앉는다. <<bHe>>【은는】 날개로 당신을 감싸 바람을 막아준다. 당신은 한동안 <<bhim>>【와과】 함께 황야를 바라본다. 마침내 <<beasttype>>【은는】 당신 쪽으로 더 가까이 다가와
	<<if $monster is 1>>
		말한다. "<<wife>>【이가】 이제 가까이 있고 싶어 해서 기뻐." <<bHe>>의 목소리는 행복해 보인다.
	<<else>>
		부드럽게 지저귄다. <<bHe>>【은는】 당신이 이제 <<bhim>>에게 가까이 다가가려는 것을 기뻐하는 것 같다.
	<</if>>
	<br><br>

	당신은 잠시 더 <<bhim>>에게 몸을 붙이고 있다가, 마침내 떨어진다. <<bHe>>【은는】 실망한 듯 보이지만 불평하지 않는다. 당신은 한 번 더 <<bhim>>【을를】 바라보고 미소 짓는다. 어쩌면 <<bhim>>【와과】 함께 지내는 것도 그리 나쁘지 않을지 모른다.
	<span class="red"><<bhis>> 탓이 아니다. <<bHe>>【은는】 그저 짝을 원할 뿐이다.
	<br>
	스톡홀름 증후군: 거대 매 특성을 획득했습니다.</span>
	<br><br>
	<<loveInterestAdd "Great Hawk">>
	<br><br>
	<<set $syndromebird to 1>>
	<<unset $birdescaped>>
	<<run delete $bird.syndrome>>
	<<specialClothesUnlock "set" "bird">>
	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<<elseif $harpy gte 6 and $bird.hunts.unlocked is true and $bird.hunts.valuables is false and $skulduggery gte 300>>
	<<set $bird.hunts.valuables to true>>
	<span class="blue">탑 안을 둘러보다가 빈 구석이 눈에 들어온다. 모든 것이 얼마나 텅 비고 밋밋한지 새삼 의식되며, 설명하기 어려운 충동이 차오른다. 예쁘고 반짝이는 귀중품이 있다면 당신의 보금자리 분위기가 한결 나아질 것이다.</span>
	<br>
	<span class="gold">이제 귀중품을 사냥할 수 있습니다.</span>
	<br><br>

	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<<elseif $bird.state is "home" and ["clear","lightClouds"].includes(Weather.name) and between(Time.hour, 21, 23) and !Weather.bloodMoon and $daily.birdNightFlightTrigger and !$weekly.birdNightFlight and !Weather.isFrozen("lake") and !$bird.injured>>
	<<npc "Great Hawk">><<person1>>
	<<set $weekly.birdNightFlight to true>>
	<<your_bird_text "cap">>【은는】 풍화된 돌출부에 앉아 있다. 달빛이 <<bhim>>【을를】 은빛으로 물들인다.
	<br><br>

	<<if $monster is 1>>
		"와라, <<wife>>. 나와 함께 날자." <<bhis>> 목소리에는 부드러운 간청이 담겨 있고, <<bhe>>【은는】
		<<if $harpy gte 6 and $birdFly is 1 and !$plucked>>
			<<bhis>> 거대한 발톱을 당신에게 내민다.
		<<else>>
			몸을 낮춰 당신이 <<bhis>> 등에 올라탈 공간을 만들어준다.
		<</if>>
	<<else>>
		<<bHe>>【은는】 낮게 지저귀며 황야 쪽으로 고개를 끄덕인다. <<bHe>>【은는】 당신이 <<bhim>>【와과】 함께 날기를 바란다.
		<<if $harpy lt 6 or $birdFly isnot 1 and !$plucked>>
			<<bHe>>【은는】 몸을 낮추고, <<bhis>> 등에 올라타라는 듯 손짓한다.
		<</if>>
	<</if>>
	<br><br>

	<<link [[간다|Bird Tower Night Flight]]>><<bird_pass 30>><<npcincr "Great Hawk" love 1>><</link>><<glove>>
	<br>
	<<link [[남는다|Bird Tower Night Flight Stay]]>><</link>>
	<br>
<<else>>
	<<npc "Great Hawk">><<person1>>
	<<if $bird.state is "home">>
		<<switch $bird.activity>>
			<<case "sing">>
				<<your_bird_text "cap">>【이가】 탑 가장자리에서 울고 있다.
			<<case "bathe">>
				<<your_bird_text "cap">>【이가】 빗물 웅덩이에서 목욕하고 있다.
			<<case "groom">>
				<<your_bird_text "cap">>【이가】 횃대에 앉아 깃털을 다듬고 있다.
			<<case "rest">>
				<<your_bird_text "cap">>【이가】 둥지에서 쉬고 있다.
			<<case "build">>
				<<if $birdShelterRepair>>
					<<unset $birdShelterRepair>>
					<span class="teal"><<your_bird_text "cap">>【이가】 나뭇잎과 잔가지로 지붕의 구멍을 메우고 있다.</span>
				<<else>>
					<<your_bird_text "cap">>【이가】 둥지를 보수하고 있다.
				<</if>>
			<<case "brood">>
				<<set _eggCountNest to nestEggCount()>>
				<<your_bird_text "cap">>【이가】 둥지에 앉아 <<pluralise _eggCountNest "알">>을 품고 있다.
			<<default>>
				<<your_bird_text "cap">>【이가】 둥지에서 쉬고 있다.
				<<set $birdSleep to 1>>
		<</switch>>
	<<else>>
		<<your_bird_text "cap">>【이가】 사냥을 나갔다.
	<</if>>
	<<if $exposed gte 1>>
		<<if $syndromebird is 1>>
			<<if $arousal gte $arousalmax / 2 and $bird.state isnot "home">>
				당신은 <<your_bird_text>>의 날개가 당신을 따뜻하게 해주길 갈망하는 자신을 발견한다.
			<</if>>
		<<else>>
			<<if $bird.state isnot "home">>
				<<if $uncomfortable.nude is true>>
					노출된 상태에서도 어느 정도 사생활이 보장된다는 사실에 안도감이 든다.
				<</if>>
			<<else>>
				<<if $uncomfortable.nude is true>>
					<<beasttype>> 주위에서 노출된 것에 당혹감을 느낀다.
				<<else>>
					<<beasttype>> 주위에서 노출된 것에 흥분감을 느낀다.
				<</if>>
			<</if>>
		<</if>>
	<</if>>
	<br>
	<<if $syndromebird and $lurkers_held gte 1 and $bird.state is "home" and $bird.activity is "build">>
		<<birdicon "lurkers_netted">><<link "잡은 럴커를 <<bhim>>에게 준다" "Bird Tower Give Captured Lurker">><</link>><<glove>>
		<br>
	<</if>>
	<<if $estate_fence is "quest" and $syndromebird is 1 and $bird.state is "home" and !["sleep","rest"].includes($bird.activity) and $bird.injured is 0>>
		<<socialiseicon "ask">><<link [[레미 저택에 들어가게 도와달라고 부탁한다|Bird Tower Estate]]>><</link>>
		<br>
	<</if>>
	<<if $bird.hunts.estate is "unlocked" and $bird.state is "home" and !["sleep","rest"].includes($bird.activity) and $bird.injured is 0>>
		<<socialiseicon "ask">><<link [[저택에서 훔치는 걸 도와달라고 부탁한다|Bird Hunt Estate Prepare]]>><<endevent>><</link>>
		<br>
	<</if>>

	<br>
	<<if $arousal gte $arousalmax>>
		<<orgasm>>
		<<if $bird.state isnot "home">>
			주변에 당신의 음란함을 목격할 것은 아무것도 없다.
		<<else>>
			<<if $bird.activity is "sleep">>
				<<beasttype>>【이가】 둥지에서 뒤척이지만, 깨어나지는 않는다.
			<<else>>
				따뜻한 날개 한 쌍이 당신을 감싸 안고, 경련이 가라앉을 때까지 당신을 붙잡아주는 것을 느낀다.
				<<if $monster is 1>>
					"<<Wife>>【은는】 해소가 필요했어? 말을 했어야지. 다음엔 도와줄게." <<beasttype>>【은는】 당신의 뺨을 쪼고는, 하던 일로 돌아간다.
				<<else>>
					<<beasttype>>【은는】 당신의 뺨에 쪼고는, 하던 일로 돌아간다.
				<</if>>
			<</if>>
		<</if>>
		<br><br>
	<</if>>
	<<if $possessed and (pcAreArmsBound("any") or $feetuse is "bound" or $worn.feet.type.includes("shackle"))>>
		당신은 결박을 내려다본다.
		<<if breakableSoftBinding()>>
			당신이 당기자, 그것들은 당신의 힘을 견디지 못하고 부서져 버린다.
			<<if ["ankle cuffs", "ball and chain"].includes($worn.feet.name)>>
				곧 딸깍하는 소리가 들리고, $worn.feet.name【이가】 바닥에 떨어진다.
			<</if>>
		<<else>>
			딸깍하는 소리가 들리고, $worn.feet.name【이가】 바닥에 떨어진다.
		<</if>>
		<br><br>
		<<unbind>>
	<<elseif breakableSoftBinding() or ["ankle cuffs", "ball and chain"].includes($worn.feet.name) and $bird.state is "home">>
		<<undobindingsicon>><<link [[결박을 푼다 (0:10)|Bird Tower Unbind]]>><<bird_pass 10>><<unbind>><</link>>
		<br><br>
	<</if>>

	<<birdicon "perch">><<link [[횃대로 다가간다|Bird Tower Perch]]>><</link>>
	<br>
	<<if $syndromebird isnot 1>>
		<<crimeicon "mark">><<link [[탑 밖을 내다본다 (0:05)|Bird Tower Look]]>><<bird_pass 5>><</link>>
		<br>
		<<investigateicon>><<link [[재료를 찾는다 (1:00)|Bird Tower Search]]>><<bird_pass 60>><</link>>
		<br>
	<</if>>
	<<birdicon "rainwater">><<link [[빗물 웅덩이 옆에 앉는다|Bird Tower Rainwater Pool]]>><</link>>
	<br>
	<<if $syndromebird is 1 and !(pcAreArmsBound("any") or $feetuse is "bound")>>
		<<if $bird.upgrades.firepit is 3>>
			<<birdicon "firepit">><<link [[모닥불을 살펴본다|Bird Tower Firepit]]>><</link>><<if getBirdBurnTime()>> | <span class="orange"><<firepitTime>></span><</if>>
			<br>
		<<elseif $bird.upgrades.firepit gte 1>>
			<<birdicon "firepit">><<link [[화덕을 살펴본다|Bird Tower Firepit]]>><</link>><<if getBirdBurnTime()>> | <span class="orange"><<firepitTime>></span><</if>>
			<br>
		<</if>>
	<</if>>
	<br>

	<<if $bird.clean gte 100>>
		<<if $bird.upgrades.decor gte 4>>
			<span class="green">당신의 탑은 흠잡을 데 없이 깨끗하다.</span>
		<<else>>
			<span class="green">당신의 탑은 완벽하게 깨끗하다.</span>
		<</if>>
	<<else>>
		<<if $syndromebird gte 1>>
			<<if $bird.clean gte 80>>
				탑은 <span class="teal">깨끗하다.</span> 석벽돌 사이에 먼지가 조금 남아 있을 뿐이다.
			<<elseif $bird.clean gte 60>>
				탑은 <span class="lblue">정돈되어 있지만,</span> 더 잘할 수 있다는 걸 알고 있다.
			<<elseif $bird.clean gte 40>>
				탑은 <span class="blue">그럭저럭 괜찮다.</span> 헐거운 돌과 흙은 횃대에서 치워냈다.
			<<elseif $bird.clean gte 20>>
				탑은 <span class="purple">조금 지저분하다.</span> 여기저기 표면에 흙먼지가 끈질기게 들러붙어 있다.
			<<elseif $bird.clean gte 10>>
				탑은 <span class="pink">엉망이다.</span> 그래도 처음 왔을 때보다는 낫다.
			<<else>>
				탑은 <span class="red">더럽다.</span> 침식과 방치 탓에 공기에는 퀴퀴한 악취가 감돈다.
			<</if>>
		<</if>>
		<br>
		<<if $tiredness gte (C.tiredness.max / 5) * 4>>
			<span class="red">너무 지쳐서 탑을 청소할 수 없다.</span>
		<<else>>
			<<if $worn.handheld.name is "feather duster" or $bird.duster is true or ($bird.upgrades.wardrobe is 1 and getOwnedClothingCount(10, "handheld") gte 1)>>
				<<choreicon "sweep">><<link [[탑의 먼지를 턴다 (0:30)|Bird Tower Tidy]]>><<tiredness 3>><<if !$daily.birdHousekeepingSyndrome>><<bird_stockholm 1>><<npcincr "Great Hawk" love 1>><<npcincr "Great Hawk" dom 1>><<set $daily.birdHousekeepingSyndrome to true>><</if>><<housekeeping 2 200>><<bird_pass 30>><</link>><<gtiredness>><<ghousekeeping 200 "silent">>
			<<else>>
				<<choreicon "sweep">><<link [[탑을 정리한다 (1:00)|Bird Tower Tidy]]>><<tiredness 6>><<if !$daily.birdHousekeepingSyndrome>><<bird_stockholm 1>><<npcincr "Great Hawk" love 1>><<npcincr "Great Hawk" dom 1>><<set $daily.birdHousekeepingSyndrome to true>><</if>><<housekeeping 2 100>><<bird_pass 60>><</link>><<ggtiredness>><<ghousekeeping 100 "silent">>
			<</if>>
			<<if !$daily.birdHousekeepingSyndrome>><<gbirdstockholm>><<glove>><<gdom>><</if>>
		<</if>>
	<</if>>
	<br>
	<<if $syndromebird is 1 and !(pcAreArmsBound("any") or $feetuse is "bound")>>
		<<choreicon "fix">><<link [[탑을 개선한다|Bird Tower Build]]>><</link>>
		<br>
	<</if>>
	<br>

	<<birdicon "nest">><<link [[둥지에서 잔다|Bird Tower Bed]]>><</link>>
	<br>
	<<if getChildrenAt("tower").find(child => child.species is "hawk" and childIsUnhatchedEgg(child))>>
		<<set _eggIcon to nestEggCount()>>
		<<if _eggIcon gte 2>>
			<<birdicon "eggs">><<link [[당신의 알들을 품는다 (0:30)|Bird Tower Brood]]>><<set $phase to 1>><<transform bird 1>><<trauma -3>><</link>><<ltrauma>>
			<br>
		<<else>>
			<<birdicon "eggs">><<link [[당신의 알을 품는다 (0:30)|Bird Tower Brood]]>><<set $phase to 1>><<transform bird 1>><<trauma -3>><</link>><<ltrauma>>
			<br>
		<</if>>
	<</if>>
	<<if getChildrenAt("tower").find(child => child.species is "hawk" and childIsBorn(child))>>
		<<set _childrenTotal to getChildrenAt("tower").filter(child => childIsBorn(child)).length>>
		<<if _childrenTotal gte 2>>
			<<birdicon "children">><<link [[아이들을 살펴본다|Childrens Home]]>><<set $exitPassage to $passage>><</link>>
		<<else>>
			<<birdicon "children">><<link [[아이를 살펴본다|Childrens Home]]>><<set $exitPassage to $passage>><</link>>
		<</if>>
		<br>
	<</if>>
	<<if $syndromebird isnot 1>>
		<<bedicon "zzz">><<link [[다른 곳에서 잔다|Bird Tower Bed Alone]]>><<bird_stockholm -2>><</link>><<if $syndromebird isnot 1>><<lbirdstockholm>><</if>>
		<br>
	<</if>>
	<<if $bird.upgrades.wardrobe is 1>>
		<<birdicon "wardrobe">><<link [[옷장|Bird Tower Wardrobe]]>><</link>>
		<br>
	<<else>>
		<<if $bird.duster is true>>
			<<icon "clothes/feather-duster.png">><<link [[깃털 먼지떨이를 집어든다|Bird Tower]]>><<handheldstrip>><<handheldwear "feather duster">><<run delete $bird.duster>><</link>>
			<<if $worn.handheld.name isnot "naked">>
				| <span class="blue">$worn.handheld.name【을를】 대신 내려놓습니다</span>
			<</if>>
			<br>
		<<elseif $worn.handheld.name is "feather duster">>
			<<icon "clothes/feather-duster.png">><<link [[깃털 먼지떨이를 걸어둔다|Bird Tower]]>><<if $carried.handheld.name isnot "naked">><<handheldon>><<else>><<handheldruined true>><</if>><<set $bird.duster to true>><</link>>
			<<if $carried.handheld.name isnot "naked">>
				| <span class="blue">$carried.handheld.name【을를】 회수합니다</span>
			<</if>>
			<br>
		<</if>>
	<</if>>
	<<if $bird.upgrades.mirror is 1>>
		<<if $nextPassageCheck is "Bird Tower Mirror">>
			<span class="nextLink"><<birdicon "mirror">><<link [[거울|Bird Tower Mirror]]>><<preMirror>><</link>></span>
		<<else>>
			<<birdicon "mirror">><<link [[거울|Bird Tower Mirror]]>><<preMirror>><</link>>
		<</if>>
		<br>
	<</if>>
	<br>
	<<if $bird.lock is 1>>
		<<birdicon "trapdoor">><<link [[다락문을 살펴본다 (0:05)|Bird Tower Door]]>><<bird_pass 5>><</link>>
		<br>
	<<else>>
		<<birdicon "trapdoor">><<link [[다락문으로 들어간다 (0:05)|Bird Tower Base Descend]]>><<bird_pass 5>><</link>>
		<br>
	<</if>>
	<<if $syndromebird is 1>>
		<br>
		<<link [[게임플레이 설정|Settings]]>><<set $settingsExitPassage to "Bird Tower">><</link>>
		<br>
		<<attitudesControlCheck>>
		<<if $attitudesControl.showGoldLink is true>>
			<span class="goldLink"><<link [[태도|Attitudes]]>><<set $attitudesExitPassage to $passage>><</link>> </span><span class="red">!!</span>
		<<else>>
			<<link [[태도|Attitudes]]>><<set $attitudesExitPassage to $passage>><</link>>
		<</if>>
		<br><br>
	<</if>>
	<<endevent>>
<</if>>

:: Bird Tower Passout
<<setTowerTemp>><<effects>>
<<npc "Great Hawk">>
<<if $syndromebird gte 1>>
	의식을 되찾기 시작하자, 당신은 둥지 안에 있는 자신을 발견한다. 둥지 가장자리에 서 있는 당신의 <<if $monster is 1>><<nnpc_wife "Great Hawk">><<else>>파트너<</if>>【이가】 보인다.
	당신이 깨어나는 것을 본 <<bhe>>【은는】 당신에게 달려온다.
	<<if $monster is 1>>
		"<<Wife>>! 무슨 일이야? 왜 땅바닥에서 잠들었어?" <<bhe>>【이가】 명백히 걱정하며 묻는다.
	<<else>>
		<<bHe>>【이가】 당신을<<if understandsBirdBehaviour()>> 혼란스럽고 걱정스러운 듯<<else>> 강렬하게<</if>> 쳐다본다.
	<</if>>
	당신은 <<bhim>>에게 이제 괜찮다고 말한다.
	<br><br>

	<<if $monster is 1>>
		"정말이야?" <<bhe>>【이가】 여전히 걱정하며 묻는다.
	<<else>>
		<<bHe>>【은는】 약간 안도한 듯 보이지만, 여전히 걱정하고 있다.
	<</if>>
	<br><br>

	<<link "<<bhim>>【을를】 안심시킨다" "Bird Tower Passout Syndrome">><<set $phase to 0>><<npcincr "Great Hawk" dom 1>><</link>><<gdom>>
	<br>
	<<link "<<bhim>>【을를】 무시한다" "Bird Tower Passout Syndrome">><<set $phase to 1>><<npcincr "Great Hawk" dom -1>><</link>><<ldom>>
	<br>
<<else>>
	<<if $trauma gte ($traumamax / 10) * 8>>
		의식을 되찾기 시작하자, 당신은 <<beasttype>>의 둥지 안에 있는 자신을 발견한다. 둥지 가장자리에 서 있는 <<beasttype>>【이가】 보인다.
		<br><br>

		<<bhis>> 시선이 당신을 꿰뚫는 것이 느껴진다. <span class="red">과거에 어떻게 폭행당했는지에 대한 기억이 마음속에 홍수처럼 밀려온다. 공포가 당신을 덮쳐 그 자리에 얼어붙게 만든다.</span>
		<br><br>

		<<beasttype>>【이가】 둥지 안으로 들어와
		<<if $monster is 1>>
			무언가 말하지만,
		<<else>>
			어떤 소리를 내지만,
		<</if>>
		정신이 너무 흐트러져 이해할 수 없다. <<bHe>>【이가】 당신에게 다가오기 시작한다. 몸이 움직이려 하지 않아, 당신은 그저 <<bhe>>【이가】 다가오는 것을 지켜볼 수밖에 없다.
		<br><br>

		<<link [[다음|Bird Tower Passout No Syndrome Trauma]]>><</link>>
		<br>
	<<else>>
		의식을 되찾기 시작하자, 당신은 <<beasttype>>의 둥지 안에 있는 자신을 발견한다. 둥지 가장자리에 서 있는 <<beasttype>>【이가】 보인다.
		<<bHe>>【은는】 당신을 <<if understandsBirdBehaviour()>>걱정스럽게<<else>>강렬하게<</if>> 쳐다보고 있다..
		<br><br>

		<<bHe>>【이가】 둥지 안으로 들어온다.
		<<if $monster is 1>>
			"<<wife>> 아픈가? 무슨 일 있었나?" <<bhe>>【이가】 묻는다.
		<<else>>
			<<bHe>>【은는】 <<if understandsBirdBehaviour()>>부드럽게 <</if>>지저귄다당신을 향해.
		<</if>>
		<br><br>

		<<beasttype>>【이가】 당신에게 <<if understandsBirdBehaviour()>>조심스럽게<<else>>천천히<</if>> 다가오기 시작한다..
		<br><br>

		<<link [[가만히 있는다|Bird Tower Passout No Syndrome]]>><<set $phase to 0>><<bird_stockholm 3>><</link>><<ggbirdstockholm>>
		<br>
		<<link [[몸을 뒤로 뺀다|Bird Tower Passout No Syndrome]]>><<set $phase to 1>><<bird_stockholm -3>><</link>><<llbirdstockholm>>
		<br>
	<</if>>
<</if>>

:: Bird Tower Passout No Syndrome
<<setTowerTemp>><<effects>>

<<if $phase is 0>>
	당신은 <<beasttype>>【이가】 가까이 다가오도록 내버려 둔다. <<bHe>>【은는】 <<bhis>> <<if $monster is 1>>손<<else>>부리<</if>>【으로로】 당신을 만지며 부상 흔적이 있는지 몸을 살피기 시작한다. <<bhis>> 손길은 매우 부드럽게 느껴진다. <<bHe>>【은는】 한동안 당신을 계속 만진다.
	<br><br>

	당신이 <<bhis>> 애무를 즐기기 시작할 때쯤, <<bhe>>【은는】 몸을 뗀다.
	<<if $monster is 1>>
		"<<Wife>>【은는】 심하게 다친 것 같지 않군. 그래도, <<wife>>【은는】 이제 쉬어야 해. 네가 안전했으면 좋겠어." <<bhe>>【이가】 말한다.
	<<else>>
		<<bHe>>【은는】 <<bhis>> 부리로 당신을 마지막으로 한 번 툭 치고는 부드럽게 지저귄다. <<if understandsBirdBehaviour()>><<bHe>>【은는】 당신이 괜찮아 보여서 기쁜 것 같다.<</if>>
	<</if>>
	<br><br>

	<<if $bird.syndrome gte 15 and $syndromebird isnot 1>>
		당신은 <<beasttype>>의 눈에서 보살핌의 시선을 보고 깨달음을 얻는다. <<bHe>>【은는】 지금까지 당신을 돌보려고만 했던 것이다. 당신은 <<bhim>>【와과】 함께라면 안전하다는 것을 안다. 당신은 <<beasttype>>【을를】 끌어안는다.
		<<if $monster is 1>>
			<<bHe>>【은는】 당신의 포옹에 화답한다.
		<<else>>
			<<bHe>>【은는】 답례로 <<bhis>> 날개를 당신 주위로 감싼다.
		<</if>>
		당신은 잠시 <<bhim>>【을를】 안고 있다가 놓아준다. 당신은 <<bhim>>에게 환하게 미소 짓는다.
		<<if $monster is 1>>
			"<<wife>>【이가】 나아져서 기쁘군." <<bhe>>【이가】 말한다.
		<</if>>

		<span class="red">이건 <<bhis>> 잘못이 아니야. <<bHe>>【은는】 그저 짝을 원할 뿐이야.
		<br>
		스톡홀름 증후군: 거대 매 특성을 얻었습니다.</span>
		<br><br>
		<<loveInterestAdd "Great Hawk">>
		<<set $syndromebird to 1>>
		<<unset $birdescaped>>
		<<run delete $bird.syndrome>>
		<<specialClothesUnlock "set" "bird">>
	<<else>>
		당신은 일어나서 둥지 밖으로 나가려고 한다. <<beasttype>>【은는】 당신을 막지 않는다.
	<</if>>
<<else>>
	당신은 둥지 반대편으로 물러난다.
	<<if $speech_attitude is "meek">>
		"제-제발 해치지 마세요." 당신은 흐느낀다.
	<<elseif $speech_attitude is "bratty">>
		"더러운 <<beasttype>>! 만지지 마!" 당신은 소리친다.
	<<else>>
		"저리 가!" 당신은 비명을 지른다.
	<</if>>
	<br><br>

	<<bHe>>【은는】 멈춘다.
	<<if $monster is 1>>
		"<<wife>>【이가】 저렇게 많이 움직일 수 있다면 괜찮은 거겠지, 방해해서 미안해." <<bhe>>【이가】 말한다. <<if understandsBirdBehaviour()>><<bHe>>【은는】 여전히 당신을 걱정하는 것 같다.<</if>>
	<<else>>
		<<bHe>>【은는】 <<if understandsBirdBehaviour()>>당신을 훑어보고,<<else>>잠시 당신을 빤히 바라보다가,<</if>> 곧 약하게 꽥 울음소리를 낸다.
	<</if>>
	당신은 일어나서 둥지 밖으로 나가려고 한다. <<beasttype>>【은는】 당신을 막지 않는다.
<</if>>
<br><br>

<<if $bird.state is "hunting" and $bird.timer lte 0>>
	<<bHe>>【은는】 무언가 기억난 듯 <<if $monster is 1>>걸어갔다가<<else>>깡충 뛰어가<</if>> 잠시 후 다시 당신에게 다가온다.
	<<bird_hunt_return>>
<<else>>
	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<</if>>

:: Bird Tower Passout No Syndrome Trauma
<<setTowerTemp>><<effects>>
<<beasttype>>【이가】 바로 당신 앞에 섰을 때, 당신은 최악의 상황에 대비한다. 잠시 동안, <<bhe>>【은는】 그저 당신을 쳐다보기만 한다. 긴장감은 상황을 더욱 악화시킬 뿐이다. 영원처럼 느껴지는 시간이 흐른 후, <<bhe>>【은는】 마침내 당신에게 손을 뻗는다.
<br><br>

<<bhe>>【이가】 한 일이라곤 <<bhis>>
<<if $monster is 1>>
	손으로 당신의 뺨을 부드럽게 어루만진 것뿐이라 당신은 놀란다. "<<Wife>>, 누가 널 그렇게 아프게 했나?" <<bhe>>【이가】 묻는다. <<if understandsBirdBehaviour()>>당신은 <<bhe>>【이가】 정말 걱정하고 있다는 것을 알 수 있다. <</if>>"아무도 <<wife>>【을를】 해치지 못하게 할 거야, 내가 여기서 <<wife>>【을를】 행복하게 해줄게." <<bhe>>【이가】 선언한다. <<beasttype>>【은는】 <<bhis>> 날개로 당신을 감싸고 <<bhis>> 손을 당신의 머리카락으로 옮긴다. <<bHe>>【은는】 <<bhis>> 손가락으로 머리를 빗기 시작한다. <<bhis>> 손길이 매우 편안하게 느껴진다.
<<else>>
	부리로. <<bHe>>【은는】 부드럽게 지저귀기 시작한다. <<if understandsBirdBehaviour()>><<bHe>>【은는】 당신을 위로하려는 것이 틀림없다. <</if>><<bhis>> 지저귐은 기분 좋을 정도로 딱 알맞은 크기다. <<beasttype>>【은는】 <<bhis>> 날개로 당신을 감싸고 <<bhis>> 부리로 당신의 머리카락을 훑기 시작한다. <<bhis>> 섬세한 쪼는 느낌이 매우 편안하게 느껴진다.
<</if>>
<<stress -6>><<trauma -6>><<bird_stockholm 3>><<lstress>><<ltrauma>><<ggbirdstockholm>>
<br><br>

당신은 여전히 움직일 수 없어서, <<beasttype>>【이가】 한동안 당신을 계속 위로할 수 있게 된다.
<<if $bird.syndrome gte 15 and $syndromebird isnot 1>>
	<<bhis>> 손길이 초마다 점점 더 기분 좋게 느껴지기 시작한다. 생각 없이, 당신은 <<bhis>>
	<<if $monster is 1>>
		손에 머리를 밀어붙이기 시작한다. "기분이 좀 나아졌나, <<wife>>?" <<bhe>>【이가】 묻는다. 당신은 대답으로 <<bhim>>에게 작은 미소를 지어 보인다. 당신은 결국 <<bhe>>【이가】 몇 분 동안 당신의 머리를 쓰다듬게 내버려 둔다.
	<<else>>
		부리에. <<bHe>>【은는】 사랑스럽게 당신을 쳐다본다. 당신은 새로운 감사함으로 <<bhim>>【을를】 돌아본다. 당신은 결국 <<bhe>>【이가】 몇 분 동안 당신의 머리를 다듬게 내버려 둔다.
	<</if>>

	<<bhe>>【이가】 당신의 머리카락을 계속 어루만지는 동안, 당신은 <<bhe>>【이가】 당신에게 얼마나 친절했는지 생각한다. <<bHe>>【은는】 다른 모든 사람들과 다르다. <<bHe>>【은는】 당신을 아낀다. <<bHe>>【은는】 당신을 안전하게 지켜줄 것이다. 당신은 마침내 <<bhim>>【을를】 이해하는 것 같다.
	<span class="red">이건 <<bhis>> 잘못이 아니야. <<bHe>>【은는】 그저 짝을 원할 뿐이야.
	<br>
	스톡홀름 증후군: 거대 매 특성을 얻었습니다.</span>
	<br><br>
	<<loveInterestAdd "Great Hawk">>
	<<set $syndromebird to 1>>
	<<unset $birdescaped>>
	<<run delete $bird.syndrome>>
	<<specialClothesUnlock "set" "bird">>
<<else>>
	당신은 강요된 애정에 대해 상반된 감정을 느낀다. 마침내 자신을 통제할 수 있게 되었을 때, 당신은 <<beasttype>>【을를】 밀쳐낸다. <<bHe>>【은는】 둥지 반대편으로 비틀거린다.
	<<if $monster is 1>>
		"<<Wife>>【은는】 이제 혼자 있고 싶어하는군, 알겠어." <<bhe>>【이가】 말한다.
	<<else>>
		<<bHe>>【은는】 부드럽게 지저귄다.
	<</if>>
	당신은 일어나서 둥지 밖으로 나가려고 한다. <<beasttype>>【은는】 당신을 막지 않는다.
<</if>>
<br><br>

<<if $bird.state is "hunting" and $bird.timer lte 0>>
	<<bHe>>【은는】 무언가 기억난 듯 <<if $monster is 1>>걸어갔다가<<else>>깡충 뛰어가<</if>> 잠시 후 다시 당신에게 다가온다.
	<<bird_hunt_return>>
<<else>>
	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<</if>>

:: Bird Tower Passout Syndrome
<<setTowerTemp>><<effects>>
<<if $phase is 0>>
	당신은 일어나서 <<bhim>>【을를】 껴안는다.
	<<if $speech_attitude is "meek">>"그렇게 신경 써줘서 고마워. 하지만 난 괜찮아." 당신은 말한다.
	<<elseif $speech_attitude is "bratty">>"그렇게 걱정 안 해도 돼, 바보야." 당신은 말한다.
	<<else>>"나 정말 괜찮아. 그래도 확인해줘서 고마워." 당신은 말한다.
	<</if>>
	<br><br>

	<<beasttype>>【은는】 
	<<if $monster is 1>>
		당신의 포옹에 화답하고 당신과 함께 둥지에 앉는다. "<<wife>>【이가】 괜찮아 보여서 다행이야." <<bhe>>【이가】 말한다.
	<<else>>
		당신에게 몸을 비빈다. <<bHe>>【은는】 즐겁게 꽥꽥거리며 당신과 함께 둥지에 앉는다.
	<</if>>
	당신은 당신의 <<if $monster is 1>><<nnpc_wife "Great Hawk">><<else>>파트너<</if>>【을를】 안고 둥지에서 휴식을 취하며 소중한 순간을 보낸다.
	<br><br>

	잠시 후, 당신은 다시 일어선다. 거대 매는 멈추기를 꺼려하지만, 당신을 보내준다.
	<<if $monster is 1>>
		"<<wife>> 기분이 나아졌으면 좋겠네." <<bhe>>【이가】 말한다.
	<<else>>
		<<bHe>>【은는】 한 번 더 지저귄다.
	<</if>>
	당신은 <<bhim>>에게 미소 짓고, 둥지 밖으로 나선다.
<<else>>
	<<if $speech_attitude is "meek">>"나-나는 괜찮아, 정말이야." 당신은 일어서며 말한다.
	<<elseif $speech_attitude is "bratty">>"이미 말했잖아, 난 괜찮다고." 당신은 일어서며 말한다.
	<<else>>"난 괜찮아." 당신은 일어서며 말한다.
	<</if>>
	<br><br>
	<<if $monster is 1>>
		"정말이야?" <<bhe>> 다시 묻는다. 당신은 대답을 반복한다. <<bHe>>【은는】 그 대답에 만족하지 않는 듯한 목소리다.
	<<else>>
		<<bHe>>【은는】 당신의 대답에 만족하지 않는 듯 보인다.
	<</if>>
	<<bHe>>【이가】 당신에 대한 안달을 멈추지만, <<bhe>>【은는】 여전히 다소 걱정스러워 보인다. 당신은 둥지 밖으로 나선다.
<</if>>
<br><br>

<<if $bird.state is "hunting" and $bird.timer lte 0>>
	<<bHe>>【은는】 무언가 기억난 듯 <<if $monster is 1>>걸어갔다가<<else>>깡충 뛰어가<</if>> 잠시 후 다시 당신에게 다가온다.
	<<bird_hunt_return>>
<<else>>
	<<link [[다음|Bird Tower]]>><<endevent>><</link>>
	<br>
<</if>>

:: Bird Tower Estate
<<setTowerTemp>><<effects>>

<<npc "Great Hawk">>
<<if $monster is 1>>
	<<beasttype>>【은는】 <<bhe>>【이가】 듣는 동안 북쪽을 응시한다.
	<<if $bird.hunts.estate is "complete">>
		"또?" <<bhe>>【이가】 묻는다. 당신은 이번에는 들어갈 방법만 필요하다고 설명한다. "위험해. 하지만 도와줄게." <<bHe>>【은는】 더 가까이 다가와 당신의 이마에 키스한다.
	<<else>>
		"나는 그곳을 피해." <<bhe>>【이가】 말한다. "위험해. 땅에 묶인 지도자가 거기서 둥지를 틀고 있어. 하지만 도와줄게." <<bHe>>【은는】 더 가까이 다가와 당신의 이마에 키스한다.
	<</if>>
	<br><br>

	<<bhis>> 날개가 활짝 펴진다. "돌아오는 길에 선물을 찾아올게." <<bHe>>【은는】 횃대에서 날아오른다.
	<br><br>
<<else>>
	<<beasttype>>【은는】 <<bhe>>【이가】 듣는 동안, 혹은 듣는 것처럼 보이는 동안 북쪽을 응시한다. <<bhis>> 날개가 활짝 펴지고, <<bhe>>【은는】 탑에서 날아오른다. 당신은 <<bhe>>【이가】 이해했는지 확신할 수 없다.
	<br><br>
<</if>>

<<set $bird.timer to random(120, 150)>>
<<set $bird.state to "hunting">>
<<set $estate_fence to "bird">>
<<set $bird.estateKnown to true>>

<<link [[다음|Bird Tower]]>><<endevent>><</link>>
<br>

:: Bird Tower Search
<<setTowerTemp>><<effects>>

당신은 탈출에 도움이 될 만한 것을 찾기 위해 나무와 잔해를 뒤진다.
<<if $bird.clean lte 5>>
	탑은 더럽고, 당신이 뒤지는 바람에 먼지와 파편이 일어난다. 당신은 기침한다. <<stress 6>><<gstress>>
	<br><br>
<</if>>

<<if $rng gte 66>>
	<<wearProp "rag">>
	찢어졌지만 튼튼한 천 조각을 발견했다. 밧줄로 쓸 수 있을 것 같다. <<set $bird.materials.fabric += 1>><<gfabric>>
<<else>>
	아무것도 찾지 못했다.
<</if>>
<br><br>

<<link [[다음|Bird Tower]]>><</link>>
<br>

:: Bird Tower Base Descend
<<effects>>

당신은 어둠 속으로 내려가면서 한 걸음 한 걸음 확인한다.
<br><br>

바닥에 도착했다. 벽에 밖으로 이어지는 틈이 있다. 비집고 나갈 수 있을 것 같지만, 반대편에는 약간의 낙차가 있다.
<br><br>

<<link [[다음|Bird Tower Base]]>><</link>>
<br>

:: Bird Tower Base Climb
<<effects>>

당신은 발을 안정적으로 유지하고 몸을 벽에 바싹 붙인 채 돌계단을 오른다.
<br><br>

열린 트랩도어를 통해 나온다.
<br><br>

<<link [[다음|Bird Tower]]>><</link>>
<br>

:: Bird Tower Base
<<effects>>

당신은 황야 깊숙한 곳에 있는 폐허가 된 탑의 기저부에 있다. 벽에는 밖으로 이어지는 틈이 있고, 위로 올라가는 계단이 있다.
<br><br>

<<if $bird.upgrades.mirror isnot 1>>
	<<if $bird.mirror_unknown is 1>>
		방 한가운데에 먼지 덮인 천으로 덮인 거울이 서 있다.
		<br><br>
		<<birdicon "mirror">><<link [[거울을 위층으로 옮긴다 (0:15)|Bird Tower Base Carry]]>><<set $bird.upgrades.mirror to 1>><<bird_pass 15>><<tiredness 3>><</link>>
		<br>
	<<else>>
		방 한가운데에 먼지 덮인 천으로 덮인 키 큰 가구가 서 있다.
		<br><br>
		<<investigateicon>><<link [[가구를 조사한다|Bird Tower Base Mirror]]>><<set $bird.mirror_unknown to 1>><</link>>
		<br>
	<</if>>
<</if>>

<<stairsicon "up">><<link [[계단을 오른다 (0:05)|Bird Tower Base Climb]]>><<bird_pass 5>><</link>>
<br>
<<getouticon>><<link [[탑을 나간다|Bird Tower Base Leave]]>><</link>>
<br>

:: Bird Tower Base Mirror
<<effects>>

천을 들어 올리자 서 있는 거울이 드러난다. 희미한 빛 속에서 당신의 모습을 알아볼 수 있다. 아직 깨지지 않았다.
<br><br>

<<link [[위층으로 옮긴다 (0:15)|Bird Tower Base Carry]]>><<set $bird.upgrades.mirror to 1>><<bird_pass 15>><<tiredness 3>><</link>>
<br>
<<link [[그냥 둔다|Bird Tower Base]]>><</link>>
<br>

:: Bird Tower Base Carry
<<effects>>
<<earnFeat "High Reflection">>
당신은 한 걸음 한 걸음 조심하며 거울을 탑 위로 옮기고, 때때로 땅에 내려놓고 쉰다. 가파른 오르막이지만, 당신은 꼭대기에 도착한다.
<br><br>

둥지 맞은편에 새 가구를 놓을 좋은 자리를 찾는다.
<br><br>

<<link [[다음|Bird Tower]]>><</link>>
<br>

:: Bird Tower Base Leave
<<effects>>

당신은 틈새를 비집고 나와 밖의 땅으로 굴러떨어진다. 당신은 성 안뜰에 있다.
<br><br>

<<link [[다음|Castle]]>><</link>>
<br>

:: Bird Tower Look
<<effects>>

가장자리 너머를 내려다보자 바람이 당신의 머리카락을 잡아챈다. 까마득히 먼 아래다.
<br><br>

당신은 천을 <span class="gold"><<number $bird.materials.fabric>></span><<birdicon "fabric">>조각 가지고 있다.
<<if $syndromebird isnot 1>>
	<<set _naked to setup.clothingLayer.all.find(c => V.worn[c].name !== "naked")>>
	<<if _naked>>
		옷을 찢어 천을 더 마련할 수 있을 것 같다.
	<<else>>
		옷을 입고 있었다면, 옷을 찢어 천을 마련할 수 있었을 것이다.
	<</if>>
<</if>>
<br>

<<if $syndromebird isnot 1>>
	<<if setup.clothes_all_slots.some(slot => $worn[slot].name !== "naked")>>
		다음 옷 찢기:
		<br>
	<</if>>
	<<if $worn.upper.name isnot "naked" and $worn.upper.cursed isnot 1>>
		<<clothingicon $worn.upper "upper">><<link [[$worn.upper.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $bird.materials.fabric += 1>><<set $fabricColour to $worn.upper.colour>><<upperruined>><</link>>
		<br>
	<</if>>
	<<if $worn.lower.name isnot "naked" and $worn.lower.cursed isnot 1>>
		<<clothingicon $worn.lower "lower">><<link [[$worn.lower.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $fabricColour to $worn.lower.colour>><<set $bird.materials.fabric += 1>><<lowerruined>><</link>>
		<br>
	<</if>>
	<<if $worn.under_upper.name isnot "naked" and $worn.under_upper.cursed isnot 1>>
		<<clothingicon $worn.under_upper "under_upper">><<link [[$worn.under_upper.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $fabricColour to $worn.under_upper.colour>><<set $bird.materials.fabric += 1>><<underupperruined>><</link>>
		<br>
	<</if>>
	<<if $worn.under_lower.name isnot "naked" and $worn.under_lower.cursed isnot 1>>
		<<clothingicon $worn.under_lower "under_lower">><<link [[$worn.under_lower.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $fabricColour to $worn.under_lower.colour>><<set $bird.materials.fabric += 1>><<underlowerruined undefined "commando">><</link>>
		<br>
	<</if>>
	<<if $worn.over_upper.name isnot "naked" and $worn.over_upper.cursed isnot 1>>
		<<clothingicon $worn.over_upper "over_upper">><<link [[$worn.over_upper.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $fabricColour to $worn.over_upper.colour>><<set $bird.materials.fabric += 1>><<overupperruined>><</link>>
		<br>
	<</if>>
	<<if $worn.over_lower.name isnot "naked" and $worn.over_lower.cursed isnot 1>>
		<<clothingicon $worn.over_lower "over_lower">><<link [[$worn.over_lower.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $fabricColour to $worn.over_lower.colour>><<set $bird.materials.fabric += 1>><<overlowerruined>><</link>>
		<br>
	<</if>>
	<<if $worn.over_head.name isnot "naked" and $worn.over_head.cursed isnot 1>>
		<<clothingicon $worn.over_head "over_head">><<link [[$worn.over_head.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $bird.materials.fabric += 1>><<set $fabricColour to $worn.over_head.colour>><<overheadruined>><</link>>
		<br>
	<</if>>
	<<if $worn.head.name isnot "naked" and $worn.head.cursed isnot 1>>
		<<clothingicon $worn.head "head">><<link [[$worn.head.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $bird.materials.fabric += 1>><<set $fabricColour to $worn.head.colour>><<headruined>><</link>>
		<br>
	<</if>>
	<<if $worn.face.name isnot "naked" and $worn.face.cursed isnot 1>>
		<<clothingicon $worn.face "face">><<link [[$worn.face.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $bird.materials.fabric += 1>><<set $fabricColour to $worn.face.colour>><<faceruined>><</link>>
		<br>
	<</if>>
	<<if $worn.neck.name isnot "naked" and $worn.neck.cursed isnot 1>>
		<<clothingicon $worn.neck "neck">><<link [[$worn.neck.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $bird.materials.fabric += 1>><<set $fabricColour to $worn.neck.colour>><<neckruined>><</link>>
		<br>
	<</if>>
	<<if $worn.hands.name isnot "naked" and $worn.hands.cursed isnot 1>>
		<<clothingicon $worn.hands "hands">><<link [[$worn.hands.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $bird.materials.fabric += 1>><<set $fabricColour to $worn.hands.colour>><<handsruined>><</link>>
		<br>
	<</if>>
	<<if $worn.handheld.name isnot "naked" and $worn.handheld.cursed isnot 1>>
		<<clothingicon $worn.handheld "handheld">><<link [[$worn.handheld.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $bird.materials.fabric += 1>><<set $fabricColour to $worn.handheld.colour>><<handheldruined>><</link>>
		<br>
	<</if>>
	<<if $worn.legs.name isnot "naked" and $worn.legs.cursed isnot 1>>
		<<clothingicon $worn.legs "legs">><<link [[$worn.legs.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $bird.materials.fabric += 1>><<set $fabricColour to $worn.legs.colour>><<legsruined>><</link>>
		<br>
	<</if>>
	<<if $worn.feet.name isnot "naked" and $worn.feet.cursed isnot 1>>
		<<clothingicon $worn.feet "feet">><<link [[$worn.feet.name.toUpperFirst()|Bird Tower Rope Clothes]]>><<set $bird.materials.fabric += 1>><<set $fabricColour to $worn.feet.colour>><<feetruined>><</link>>
		<br>
	<</if>>
		<br>
<</if>>

<<if $harpy gte 6>>
	<!-- Redirects the player to the Perch, where flight can happen. Moved everything to widgets.twee in the "bird_fly_options" widget.-->
	더 좋은 도약 지점만 있다면, 바람을 타고 멀리 날아갈 수 있을 것이다. <span class="blue">횃대가 안성맞춤일지도 모른다.</span>
	<br><br>
<<elseif $angel gte 6 or $demon gte 6 or $fallenangel gte 2>>
	<<if $pain gte 21>>
		날개로 날아내려갈 수 있겠지만, <span class="purple">지금은 부상이 너무 심해 위험한 도약을 감행할 수 없다.</span>
	<<else>>
		더 좋은 도약 지점만 있다면 날개로 날아내려갈 수 있을 것이다. <span class="blue">횃대가 안성맞춤일지도 모른다.</span>
	<</if>>
	<br><br>
<</if>>
<<if $bird.rope lt 7>>
	<<if $bird.materials.fabric gte 1>>
		<<if $bird.rope is 0>>
			<<link [[밧줄 만들기 (0:30)|Bird Tower Rope]]>><<set $bird.materials.fabric -= 1>><<set $bird.rope += 1>><<bird_pass 30>><</link>>
			<br>
		<<else>>
			<<link [[밧줄 만들기 (0:30)|Bird Tower Rope Add]]>><<set $bird.materials.fabric -= 1>><<bird_pass 30>><<set $bird.rope += 1>><</link>>
			<br>
		<</if>>
	<<else>>
		<span class="grey">밧줄을 만들려면 천이 더 필요합니다.</span>
		<br>

	<</if>>
<<else>>
	<<link [[탈출 (0:05)|Bird Tower Rope Escape]]>><<bird_pass 5>><</link>>
	<br>
<</if>>
<<link [[물러선다|Bird Tower]]>><</link>>
<br>

:: Bird Tower Rope Clothes
<<effects>>
<<set $fabricColour to [0, "custom"].includes($fabricColour) ? "white" : $fabricColour>>
<<wearProp "rag" $fabricColour>>

당신은 옷을 찢어, 작업에 쓸 재료를 더 확보한다.
<<if $exposed gte 1>>
	산들바람에 몸이 떨린다.
<</if>>
<<covered>>
<br><br>

<<link [[다음|Bird Tower Look]]>><<run delete $fabricColour>><</link>>
<br>

:: Bird Tower Rope
<<effects>>
<<wearProp "fabric rope" "white">>

천과 다른 재료들을 찢고 묶어 밧줄의 시작 부분을 만든다. 아래로 내려가려면 재료가 더 필요할 것이다.
<br><br>

<<link [[다음|Bird Tower]]>><</link>>
<br>

:: Bird Tower Rope Add
<<effects>><<wearProp "fabric rope" "white">>

천과 다른 재료들을 찢고 묶어 밧줄에 덧댄다.
<<if $bird.rope gte 7>>
	<span class="green">바닥까지 닿을 것 같다.</span>
<<elseif $bird.rope gte 6>>
	<span class="teal">거의 다 됐다.</span>
<<elseif $bird.rope gte 4>>
	<span class="lblue">절반 정도는 내려갈 수 있을 것이다.</span>
<<else>>
	<span class="blue">아직 한참 멀었다.</span>
<</if>>
<br><br>

<<link [[다음|Bird Tower]]>><</link>>
<br>

:: Bird Tower Rope Escape
<<effects>><<wearProp "fabric rope climb">>

밧줄 한쪽 끝을 위로 솟은 돌덩이에 묶고, 다른 쪽 끝을 가장자리 너머로 던진다. 바닥에 거의 닿는다. 이 정도면 충분하다.
<br><br>

<<if $syndromebird isnot 1>>
	<<set $bird.rope to 1>>
	<<set $birdescaped = ($birdescaped || 0) + 1>>
<</if>>

<<if $bird.state is "home" and $syndromebird isnot 1>>
	<<npc "Great Hawk">>
	<<beasttype>>【을를】 힐끗 본다. <<bHe>>【은는】 신경 쓰지 않고 있다. 당신은 밧줄을 양손으로 잡고 몸을 돌려 탑 벽을 따라 조심스럽게 내려간다.
	<br><br>
	마지막 몇 피트를 남기고 뛰어내려, 성 안뜰에 착지한다.

	<<if $bird.activity isnot "sleep">>
		<<set $moor_hunt to 9>>

		<span class="red"> 끔찍한 비명이 들린다.</span> <<beasttype>>【이가】 당신의 탈출을 알아차리는 데는 오래 걸리지 않았다.
	<<elseif $bird.activity is "sleep" and $rng lte 70>>
		<<set $moor_hunt to 9>>

		<span class="red"> 끔찍한 비명이 들린다.</span> <<beasttype>>【이가】 당신의 탈출을 알아차리는 데는 오래 걸리지 않았다.
	<</if>>
	<br><br>
<<else>>
	밧줄을 양손으로 잡고 몸을 돌려 탑 벽을 따라 조심스럽게 내려간다. 마지막 몇 피트를 남기고 뛰어내려, 성 안뜰에 착지한다.
	<br><br>
<</if>>
<<link [[다음|Castle]]>><<endevent>><<set $moor to 100>><</link>>
<br>

:: Bird Tower Glide Attempt
<<effects>>
가장자리로 더 가까이 걸어가기 시작한다. 이 높이에서 보는 광경에 감탄하지 않을 수 없다.
<<if $willpowerSuccess>>
	<<set $birdGlide to 1>>
	<span class="green">뱃속이 울렁거림에도 불구하고 계속 나아간다.</span><<gwillpower>><<willpower 1>>
	<br><br>
	<<link [[활강하여 내려간다|Bird Tower Glide]]>><<endevent>><</link>><<flight_text>>
<<else>>
	<<set $daily.glideScared to true>>
	<span class="red">당신은 멈춰 서서, 공포에 질려 가장자리에서 물러난다.</span> 너무 가까이 가는 것은 좋지 않은 생각인 것 같다.
	<br>
<</if>>
<br>
<<link [[물러선다|Bird Tower Perch]]>><<endevent>><</link>>

:: Bird Tower Glide
<<effects>>
<<if $bird.activity is "sing" and $bird.state is "home">>
	<<npc "Great Hawk">>
	<<if $monster is 1>>
		"부디 곧 돌아와 주시오, <<wife>>." 당신이 횃대 가장자리로 다가가자 <<bhe>>【이가】 말한다. "사랑하오."
	<<else>>
		<<bHe>>【은는】 당신이 횃대 가장자리로 다가가자 곧 돌아오라며 울음소리를 낸다.
	<</if>>
	<<endevent>>
<</if>>
당신은 뛰어내린다. 몇 피트 정도 떨어지자 바람이 당신을 붙잡는다. 당신은 부드럽게 아래로 떠내려가, 폐허가 된 안뜰에 착지한다.
<br><br>

<<if $bird.state is "home" and $syndromebird isnot 1>>
	<<set $birdescaped = ($birdescaped || 0) + 1>>
	<<npc "Great Hawk">>
	<span class="red">끔찍한 비명이 들린다.</span> <<beasttype>>【이가】 당신의 비행을 알아차리는 데는 오래 걸리지 않았다.
	<br><br>
	<<set $moor_hunt to 9>>
	<<endevent>>
<</if>>
<<link [[다음|Castle]]>><<set $moor to 100>><</link>>
<br>

:: Bird Tower Glide 2
<<effects>>
<<if ($bird.activity is "sing" or $bird.activity is "groom") and $bird.state is "home">>
	<<npc "Great Hawk">>
	<<if $monster is 1>>
		<<if playerIsPregnant() and playerBellySize() gte 12>>
			"이렇게 취약한 상태인데 <<wife>>【이가】 떠나야만 하오?" <<bHe>>【은는】 당신의 <<bellyDescription>>【을를】 걱정스럽게 쳐다본다. "부디 무사히 돌아오시오." 당신이 횃대 가장자리로 다가가자 <<bhe>>【이가】 말한다. "사랑하오."
		<<else>>
			<<if Weather.precipitation is "rain">>"성난 하늘을 조심하시오<<else>>"부디 곧 돌아와 주시오<</if>>, <<wife>>." 당신이 횃대 가장자리로 다가가자 <<bhe>>【이가】 말한다. "사랑하오."
		<</if>>
	<<else>>
		<<bHe>>【은는】 당신이 횃대 가장자리로 다가가자 곧 돌아오라며 울음소리를 낸다.
	<</if>>
	<<endevent>>
<</if>>
당신은 탑에서 뛰어내려 바람에 몸을 맡긴다. 당신은 폐허가 된 안뜰로 급강하한다.
<br><br>

<<link [[다음|Castle]]>><<set $moor to 100>><</link>>
<br>

:: Bird Tower Farmlands
<<effects>><<flight_effects>>
<<if ($bird.activity is "sing" or $bird.activity is "groom") and $bird.state is "home">>
	<<npc "Great Hawk">>
	<<if $monster is 1>>
		<<if Weather.precipitation is "rain">>"성난 하늘을 조심하시오<<else>>"부디 곧 돌아와 주시오<</if>>, <<wife>>." 당신이 횃대 가장자리로 다가가자 <<bhe>>【이가】 말한다. "사랑하오."
	<<else>>
		<<bHe>>【은는】 당신이 횃대 가장자리로 다가가자 곧 돌아오라며 울음소리를 낸다.
	<</if>>
	<<endevent>>
<</if>>
당신은 탑에서 뛰어내린다. 강한 기류가 당신을 붙잡고, 활강하기 시작한다. 바람이 당신을 황야 위로 실어 나른다. 하늘을 날아오르는 동안 혼자만의 생각에 잠길 수 있는 시간이 주어진다.
<br><br>

바람이 대부분의 일을 해주지만, 농장에 도착할 때쯤에는 날개가 지친다. <<physique 1>><<athletics 2>>
<br><br>
<<unset $moor_hunt>>
<<link [[다음|Farmland]]>><<set $moor to 0>><</link>>
<br>

:: Bird Tower Town
<<effects>><<flight_effects>>
<<if ($bird.activity is "sing" or $bird.activity is "groom") and $bird.state is "home">>
	<<npc "Great Hawk">>
	<<if $monster is 1>>
		<<if Weather.precipitation is "rain">>"성난 하늘을 조심하시오<<else>>"부디 곧 돌아와 주시오<</if>>, <<wife>>." 당신이 횃대 가장자리로 다가가자 <<bhe>>【이가】 말한다. "사랑하오."
	<<else>>
		<<bHe>>【은는】 당신이 횃대 가장자리로 다가가자 곧 돌아오라며 울음소리를 낸다.
	<</if>>
	<<endevent>>
<</if>>
당신은 탑에서 뛰어내린다. 강한 기류가 당신을 붙잡고, 활강하기 시작한다. 바람이 당신을 황야 위로 실어 나른다. 하늘을 날아오르는 동안 혼자만의 생각에 잠길 수 있는 시간이 주어진다.
<br><br>

바람이 대부분의 일을 해주지만, 지붕 위를 날아오르는 동안 날개가 지친다. 당신은 공원에 착륙한다. 아무도 당신을 보지 못한 것 같다. <<physique 1>><<athletics 2>>
<br><br>
<<unset $moor_hunt>>
<<link [[다음|Park]]>><<set $moor to 0>><</link>>
