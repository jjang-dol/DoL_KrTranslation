:: Dance Widgets [widget]
<<widget "dancestripeffects">>
	<<outfitChecks>>
	<<switch $danceaction>>
		<<case "stripOverOutfit">>
			<<if $worn.upper.name isnot "naked" and $worn.lower.name isnot "naked">>
				우아하게 $worn.over_upper.name【을를】 벗어 <<outfit>>【을를】 드러낸다. 너무 많은 것을 보여주지 않으려 조심하지만, 그럼에도 이런 음란한 몸짓은 흥분을 돋운다.
				<<set $audiencearousal += 3>><<set $audienceexcitement += 3>><<set $audiencemod += 1>><<arousal 100>><<overupperstrip>><<exhibitionism1>>
			<<elseif $worn.upper.name isnot "naked">>
				<<if !$worn.under_lower.type.includes("naked")>>
					우아하게 $worn.over_upper.name【을를】 벗어 $worn.under_lower.name【을를】 드러낸다. 속옷 차림으로 보이는 것은 흥분을 돋운다.
					<<set $audiencearousal += 6>><<set $audienceexcitement += 6>><<set $audiencemod += 2>><<arousal 300>><<overupperstrip>><<exhibitionism3>>
				<<else>>
					우아하게 $worn.over_upper.name【을를】 벗어 <<genitals 1>>【을를】 드러낸다.
					<<if $worn.upper.type.includes("naked")>>
						몸이 완전히 드러나자, 흥분으로 몸을 떤다.
					<<else>>
						<<allTops>>【이가】 벌거벗은 하반신을 유난히 눈에 띄게 만든다.
					<</if>>
					<<set $audiencearousal += 10>><<set $audienceexcitement += 10>><<set $audiencemod += 4>><<arousal 300>><<overupperstrip>><<exhibitionism5>>
					<<dance_crossdress_reveal>>
				<</if>>
			<<elseif $worn.lower.name isnot "naked">>
				<<if !$worn.under_upper.type.includes("naked")>>
					우아하게 $worn.over_upper.name【을를】 벗어 $worn.under_upper.name【을를】 드러낸다. 속옷 차림으로 보이는 것은 흥분을 돋운다.
					<<set $audiencearousal += 6>><<set $audienceexcitement += 6>><<set $audiencemod += 2>><<arousal 300>><<overupperstrip>><<exhibitionism3>>
				<<else>>
					<<if $player.breastsize gte 3>>
						우아하게 $worn.over_upper.name【을를】 벗어 $worn.lower.name【와과】 <<breasts>>【을를】 드러낸다. 가슴이 노출되자 쓰라리면서도 예민해진다.
						<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<overupperstrip>><<exhibitionism4>>
					<<elseif $player.gender_appearance isnot "m" and $worn.lower.gender isnot "m">>
						<<if $player.sex is "m">>
							우아하게 $worn.over_upper.name【을를】 벗어 $worn.lower.name【와과】 <<breasts>>【을를】 드러낸다. 여성스러운 생김새가 드러난 가슴을 더욱 음란해 보이게 만든다.
						<<else>>
							우아하게 $worn.over_upper.name【을를】 벗어 $worn.lower.name【와과】 <<breasts>>【을를】 드러낸다. 가슴이 드러나자 젖꼭지가 빳빳하게 굳는 것이 느껴진다.
						<</if>>
						<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<overupperstrip>><<exhibitionism4>>
					<<else>>
						우아하게 $worn.over_upper.name【을를】 벗어 $worn.lower.name【와과】 <<breasts>>【을를】 드러낸다. 가슴이 드러나자 젖꼭지가 빳빳하게 굳는 것이 느껴진다.
						<<set $audiencearousal += 6>><<set $audienceexcitement += 6>><<set $audiencemod += 2>><<arousal 300>><<overupperstrip>><<exhibitionism3>>
					<</if>>
				<</if>>
			<<else>>
				<<if !$worn.under_upper.type.includes("naked") and !$worn.under_lower.type.includes("naked")>>
					우아하게 $worn.over_upper.name【을를】 벗어 $worn.under_upper.name【와과】 $worn.under_lower.name【을를】 드러낸다. 속옷 차림으로 보이는 것은 흥분을 돋운다.
					<<set $audiencearousal += 6>><<set $audienceexcitement += 6>><<set $audiencemod += 2>><<arousal 300>><<overupperstrip>><<exhibitionism3>>
				<<elseif !$worn.under_lower.type.includes("naked")>>
					<<if $player.breastsize gte 3>>
						우아하게 $worn.over_upper.name【을를】 벗어 $worn.under_lower.name【와과】 <<breasts>>【을를】 드러낸다. 가슴이 노출되자 쓰라리면서도 예민해진다.
						<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<overupperstrip>><<exhibitionism4>>
					<<elseif $player.gender_appearance isnot "m" and $worn.lower.gender isnot "m">>
						<<if $player.sex is "m">>
							우아하게 $worn.over_upper.name【을를】 벗어 $worn.under_lower.name【와과】 <<breasts>>【을를】 드러낸다. 여성스러운 생김새가 드러난 가슴을 더욱 음란해 보이게 만든다.
						<<else>>
							우아하게 $worn.over_upper.name【을를】 벗어 $worn.under_lower.name【와과】 <<breasts>>【을를】 드러낸다. 가슴이 드러나자 젖꼭지가 빳빳하게 굳는 것이 느껴진다.
						<</if>>
						<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<overupperstrip>><<exhibitionism4>>
					<<else>>
						우아하게 $worn.over_upper.name【을를】 벗어 $worn.under_lower.name【와과】 <<breasts>>【을를】 드러낸다. 가슴이 드러나자 젖꼭지가 빳빳하게 굳는 것이 느껴진다.
						<<set $audiencearousal += 6>><<set $audienceexcitement += 6>><<set $audiencemod += 2>><<arousal 300>><<overupperstrip>><<exhibitionism3>>
					<</if>>
				<<elseif !$worn.under_upper.type.includes("naked")>>
					우아하게 $worn.over_upper.name【을를】 벗어 <<genitals 1>>【을를】 드러낸다.
					<<set $audiencearousal += 10>><<set $audienceexcitement += 10>><<set $audiencemod += 4>><<arousal 300>><<overupperstrip>><<exhibitionism5>>
					<<dance_crossdress_reveal>>
				<<else>>
					우아하게 $worn.over_upper.name【을를】 벗어 <<genitals 1>>【을를】 드러낸다. 몸이 완전히 드러나자, 흥분으로 몸을 떤다.
					<<set $audiencearousal += 10>><<set $audienceexcitement += 10>><<set $audiencemod += 4>><<arousal 300>><<overupperstrip>><<exhibitionism5>>
					<<dance_crossdress_reveal>>
				<</if>>
			<</if>>
			<<set $danceaction to 0>>
		<<case "stripOverUpper">>
			<<if $worn.upper.name isnot "naked">>
				우아하게 $worn.over_upper.name【을를】 벗어 $worn.upper.name【을를】 드러낸다. 너무 많은 것을 보여주지 않으려 조심하지만, 그럼에도 이런 음란한 몸짓은 흥분을 돋운다.
				<<set $audiencearousal += 3>><<set $audienceexcitement += 3>><<set $audiencemod += 1>><<arousal 100>><<overupperstrip>><<exhibitionism1>>
			<<elseif !$worn.under_upper.type.includes("naked")>>
				우아하게 $worn.over_upper.name【을를】 벗어 $worn.under_upper.name【을를】 드러낸다. 이제 주변의 굶주린 시선들로부터 가슴을 가려주는 것은 옷 한 벌뿐이다.
				<<set $audiencearousal += 2>><<set $audienceexcitement += 2>><<set $audiencemod += 1>><<arousal 100>><<overupperstrip>><<exhibitionism1>>
			<<else>>
				<<if $player.breastsize gte 3>>
					우아하게 $worn.over_upper.name【을를】 벗어 <<breasts>>【을를】 드러낸다. 가슴이 노출되자 쓰라리면서도 예민해진다.
					<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<overupperstrip>><<exhibitionism4>>
				<<elseif $player.gender_appearance isnot "m" and $worn.lower.gender isnot "m">>
					<<if $player.sex is "m">>
						우아하게 $worn.over_upper.name【을를】 벗어 <<breasts>>【을를】 드러낸다. 여성스러운 생김새가 드러난 가슴을 더욱 음란해 보이게 만든다.
					<<else>>
						우아하게 $worn.over_upper.name【을를】 벗어 <<breasts>>【을를】 드러낸다. 가슴이 드러나자 젖꼭지가 빳빳하게 굳는 것이 느껴진다.
					<</if>>
					<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<overupperstrip>><<exhibitionism4>>
				<<else>>
					우아하게 $worn.over_upper.name【을를】 벗어 <<breasts>>【을를】 드러낸다. 가슴이 드러나자 젖꼭지가 빳빳하게 굳는 것이 느껴진다.
					<<set $audiencearousal += 2>><<set $audienceexcitement += 2>><<set $audiencemod += 1>><<arousal 300>><<overupperstrip>><<exhibitionism1>>
				<</if>>
			<</if>>
			<<set $danceaction to 0>>
		<<case "stripOverLower">>
			<<if $worn.lower.name isnot "naked">>
				우아하게 $worn.over_lower.name【을를】 벗어 $worn.lower.name【을를】 드러낸다. 너무 많은 것을 보여주지 않으려 조심하지만, 그럼에도 이런 음란한 몸짓은 흥분을 돋운다.
				<<set $audiencearousal += 3>><<set $audienceexcitement += 3>><<set $audiencemod += 1>><<arousal 100>><<overlowerstrip>><<exhibitionism1>>
			<<elseif !$worn.under_lower.type.includes("naked")>>
				우아하게 $worn.over_lower.name【을를】 벗어 $worn.under_lower.name【을를】 드러낸다. 속옷 차림으로 보이는 것은 흥분을 돋운다.
				<<set $audiencearousal += 6>><<set $audienceexcitement += 6>><<set $audiencemod += 2>><<arousal 300>><<overlowerstrip>><<exhibitionism3>>
			<<else>>
				우아하게 $worn.over_lower.name【을를】 벗어 <<genitals 1>>【을를】 드러낸다.
				<<if $worn.upper.type.includes("naked") or $worn.over_upper.type.includes("naked")>>
					몸이 완전히 드러나자, 흥분으로 몸을 떤다.
				<<else>>
					<<allTops>>【이가】 벌거벗은 하반신을 유난히 눈에 띄게 만든다.
				<</if>>
				<<set $audiencearousal += 10>><<set $audienceexcitement += 10>><<set $audiencemod += 4>><<arousal 300>><<overlowerstrip>><<exhibitionism5>>
				<<dance_crossdress_reveal>>
			<</if>>
			<<set $danceaction to 0>>
		<<case "stripOutfit">>
			<<if !$worn.under_upper.type.includes("naked") and !$worn.under_lower.type.includes("naked")>>
				<<if $player.breastsize gte 3 or $player.gender_appearance isnot "m">>
					우아하게 $worn.upper.name【을를】 벗어 <<upperstrip>><<lowerstrip>><<underoutfit>>【을를】 드러낸다. 속옷 차림으로 보이는 것은 흥분을 돋운다.
					<<set $audiencearousal += 10>><<set $audienceexcitement += 10>><<set $audiencemod += 4>><<arousal 500>><<exhibitionism4>>
				<<else>>
					우아하게 $worn.upper.name【을를】 벗어 <<upperstrip>><<lowerstrip>><<underoutfit>>【을를】 드러낸다. 속옷 차림으로 보이는 것은 흥분을 돋운다.
					<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<exhibitionism3>>
				<</if>>
			<<elseif !$worn.under_lower.type.includes("naked")>>
				<<if $player.breastsize gte 3>>
					우아하게 $worn.upper.name【을를】 벗어 <<upperstrip>><<lowerstrip>><<underoutfit>>【을를】 드러낸다. 가슴이 노출되자 쓰라리면서도 예민해진다.
					<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<exhibitionism4>>
				<<elseif $player.gender_appearance isnot "m" and $worn.lower.gender isnot "m">>
					<<if $player.sex is "m">>
						우아하게 $worn.upper.name【을를】 벗어 <<upperstrip>><<lowerstrip>><<underoutfit>>【을를】 드러낸다. 여성스러운 생김새가 드러난 가슴을 더욱 음란해 보이게 만든다.
					<<else>>
						우아하게 $worn.upper.name【을를】 벗어 <<upperstrip>><<lowerstrip>><<underoutfit>>【을를】 드러낸다. 가슴이 드러나자 <<nipples>>【이가】 빳빳하게 굳는 것이 느껴진다.
					<</if>>
					<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<exhibitionism4>>
				<<else>>
					우아하게 $worn.upper.name【을를】 벗어 <<upperstrip>><<lowerstrip>><<underoutfit>>【을를】 드러낸다. 속옷 차림으로 보이는 것은 흥분을 돋운다.
					<<set $audiencearousal += 6>><<set $audienceexcitement += 6>><<set $audiencemod += 2>><<arousal 300>><<exhibitionism3>>
				<</if>>
			<<else>>
				우아하게 $worn.upper.name【을를】 벗어 나체를 드러낸다. <<genitals 1>>【이가】 완전히 드러난 채로, 흥분으로 몸을 떤다.
				<<set $audiencearousal += 10>><<set $audienceexcitement += 10>><<set $audiencemod += 4>><<arousal 300>><<upperstrip>><<lowerstrip>><<exhibitionism5>>
				<<dance_crossdress_reveal>>
			<</if>>
			<<set $danceaction to 0>>
		<<case "stripUpper">>
			<<if !$worn.under_upper.type.includes("naked")>>
				<<if $player.breastsize gte 3 or $player.gender_appearance isnot "m">>
					우아하게 $worn.upper.name【을를】 벗어 $worn.under_upper.name【을를】 드러낸다. 이제 주변의 굶주린 시선들로부터 가슴을 가려주는 것은 옷 한 벌뿐이다.
					<<set $audiencearousal += 4>><<set $audienceexcitement += 4>><<set $audiencemod += 2>><<arousal 200>><<upperstrip>><<exhibitionism3>>
				<<else>>
					우아하게 $worn.upper.name【을를】 벗어 $worn.under_upper.name【을를】 드러낸다. 이제 주변의 굶주린 시선들로부터 가슴을 가려주는 것은 옷 한 벌뿐이다.
					<<set $audiencearousal += 2>><<set $audienceexcitement += 2>><<set $audiencemod += 1>><<arousal 100>><<upperstrip>><<exhibitionism1>>
				<</if>>
			<<else>>
				<<if $player.breastsize gte 3>>
					우아하게 $worn.upper.name【을를】 벗어 <<breasts>>【을를】 드러낸다. 가슴이 노출되자 쓰라리면서도 예민해진다.
					<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<upperstrip>><<exhibitionism4>>
				<<elseif $player.gender_appearance isnot "m" and $worn.lower.gender isnot "m">>
					<<if $player.sex is "m">>
						우아하게 $worn.upper.name【을를】 벗어 <<breasts>>【을를】 드러낸다. 여성스러운 생김새가 드러난 가슴을 더욱 음란해 보이게 만든다.
					<<else>>
						우아하게 $worn.upper.name【을를】 벗어 <<breasts>>【을를】 드러낸다. 가슴이 드러나자 젖꼭지가 빳빳하게 굳는 것이 느껴진다.
					<</if>>
					<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<upperstrip>><<exhibitionism4>>
				<<else>>
					우아하게 $worn.upper.name【을를】 벗어 <<breasts>>【을를】 드러낸다. 가슴이 드러나자 젖꼭지가 빳빳하게 굳는 것이 느껴진다.
					<<set $audiencearousal += 2>><<set $audienceexcitement += 2>><<set $audiencemod += 1>><<arousal 300>><<upperstrip>><<exhibitionism1>>
				<</if>>
			<</if>>
			<<set $danceaction to 0>>
		<<case "stripLower">>
			<<if $worn.over_lower.name isnot "naked">>
				우아하게 $worn.over_lower.name 아래에서 $worn.lower.name【을를】 벗어낸다. 너무 많은 것을 보여주지 않으려 조심하지만, 그럼에도 이런 음란한 몸짓은 흥분을 돋운다.
				<<set $audiencearousal += 3>><<set $audienceexcitement += 3>><<set $audiencemod += 1>><<arousal 100>><<lowerstrip>><<exhibitionism1>>
			<<elseif !$worn.under_lower.type.includes("naked")>>
				우아하게 $worn.lower.name【을를】 벗어 $worn.under_lower.name【을를】 드러낸다. 속옷 차림으로 보이는 것은 흥분을 돋운다.
				<<set $audiencearousal += 6>><<set $audienceexcitement += 6>><<set $audiencemod += 2>><<arousal 300>><<lowerstrip>><<exhibitionism3>>
			<<else>>
				우아하게 $worn.lower.name【을를】 벗어 <<genitals 1>>【을를】 드러낸다.
				<<if $worn.upper.type.includes("naked") or $worn.over_upper.type.includes("naked")>>
					몸이 완전히 드러나자, 흥분으로 몸을 떤다.
				<<else>>
					<<allTops>>【이가】 벌거벗은 하반신을 유난히 눈에 띄게 만든다.
				<</if>>
				<<set $audiencearousal += 10>><<set $audienceexcitement += 10>><<set $audiencemod += 4>><<arousal 300>><<lowerstrip>><<exhibitionism5>>
				<<dance_crossdress_reveal>>
			<</if>>
			<<set $danceaction to 0>>
		<<case "stripUnderOutfit">>
			우아하게 $worn.under_upper.name【을를】 벗어 <<genitals 1>>【을를】 드러낸다. 몸이 완전히 드러나자, 흥분으로 몸을 떤다.
			<<set $audiencearousal += 8>><<set $audienceexcitement += 8>><<set $audiencemod += 3>><<arousal 300>><<underupperstrip>><<exhibitionism5>>
			<<dance_crossdress_reveal>>
			<<set $danceaction to 0>>
		<<case "stripUnderUpper">>
			<<if (!$worn.upper.type.includes("naked") and $worn.upper.open is 1) and $worn.over_upper.type.includes("naked")>>
				우아하게 $worn.upper.name 아래에서 $worn.under_upper.name【을를】 벗어낸다. 너무 많은 것을 보여주지 않으려 조심하지만, 그럼에도 이런 음란한 몸짓은 흥분을 돋운다.
