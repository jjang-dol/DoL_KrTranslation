:: Widgets Underground Robin [widget]
<<widget "undergroundRobinTopic">>
	<<if $undergroundbrothel.robin>>
		<<set $_state to _args[1] ? _args[1] : "discussed">>
		<<set $undergroundbrothel.robinTopics[_args[0]] to $_state>>
	<</if>>
<</widget>>

<<widget "undergroundEscapeForestRobin">>
	<<clearNPC handler>>
	<<endcombat>>
	<<clotheson>>

	당신은 숲으로 나와 무작정 뛰기 시작하고, 로빈도 당신의 뒤를 바짝 쫓는다. <span class="red"><<nnpc_Hes "Robin">> 당신을 쫓고 있는 유일한 존재가 아니다.</span>
	<br><br>

	<<link [[다음|Underground Robin Escape Stalk]]>><<set $molestationstart to 1>><</link>>
<</widget>>

<<widget "undergroundRobinTopicRefresh">>
	<<if Object.entries(V.undergroundbrothel.robinTopics).filter(pair => pair[1] === "undiscussed").length lte 0>>
		<<set $undergroundbrothel.robinTopics to {
			"cold": "논의되지 않음",
			"lonely": "논의되지 않음",
			"dark": "논의되지 않음",
			"scared": "논의되지 않음",
			"touch": "논의되지 않음"
		}>>
	<</if>>
<</widget>>

<<widget "undergroundRobinInterlude">>
	<<set $robinSeen.pushUnique("ubDouble")>>
	<<set _rRNG to random(1,3)>>
	<<if _rRNG gte 2>>
		<<print either(
			"로빈이 소리치는 소리가 들린다.",
			"로빈이 고통스럽게 소리친다.",
			"로빈이 훌쩍인다."
		)>>
		<<npcincr Robin trauma 1>><<grtrauma true>>
		<br><br>
	<</if>>
<</widget>>

<<widget "undergroundRobinKiss">>
	<<set $speechdisable to 1>>
	<<if $robinFucked>>
		<<if _args[0] is "kissback">>
			<<print either(
				"<<He>>【은는】 망설이며 당신에게 키스를 돌려주고, <<person3>><<person>>【이가】 <<person2>><<him>>【을를】 짓찧을 때마다 훌쩍인다.",
				"당신이 <<him>>에게 키스하자 <<He>>【은는】 <<his>> 눈을 질끈 감고, <<person3>><<person>>【이가】 찌를 때마다 몸을 움찔거린다.",
				"<<He>>【은는】 <<person3>><<persons>> 야만적인 찌르기에 맞춰 당신의 입술 너머로 비명을 지른다."
			)>>
		<<else>>
			<<print either(
				"<<He>>【은는】 흐느끼고, <<person3>><<person>>【은는】 웃는다.",
				"<<He>>【은는】 <<person3>><<person>>【이가】 <<person2>><<him>>【을를】 찌를 때마다 훌쩍인다.",
				"<<He>>【은는】 몸을 떨며 당신에게 매달려 울부짖는다. <<person3>><<person>>【이가】 <<person2>><<his>> 목줄을 확 잡아당길 때마다 <<His>> 몸이 떨린다."
			)>>
		<</if>>
		<<npcincr Robin trauma 3>><<grtrauma true>>
	<<elseif $timer gte 5>>
		<<if _args[0] is "kissback">>
			<<He>>【은는】 <<person3>><<persons>> 손아귀 안에서 버둥거리며, 당신의 키스에 몸을 기댄다.
		<<else>>
			로빈은 <<person3>><<persons>> 손아귀 안에서 버둥거린다.
		<</if>>
	<<elseif $timer gte 3>>
		<<if _args[0] is "kissback">>
			<<person3>><<person>>【이가】 로빈의 목줄을 확 잡아당기자, <<person2>><<he>>【은는】 당신의 입술 너머로 짤막한 비명을 지른다.
		<<else>>
			<<person3>><<person>>【이가】 로빈의 목줄을 확 잡아당기자, <<person2>><<he>>【은는】 짤막한 비명을 지른다.
		<</if>>
	<<elseif $timer gte 1>>
		<<if _args[0] is "kissback">>
			로빈은 두려움에 <<his>> 눈을 질끈 감고, 당신의 입술에 집중하려 애쓴다.
		<<else>>
			로빈은 두려움에 당신의 입술에 대고 흐느끼며, <<his>> 고개를 저으려 애쓴다.
		<</if>>
	<<else>>
		<<set $robinFucked to 1>>
		<span class="red"><<person3>><<person>>【이가】 <<his>> <<npcPenis>>【을를】 로빈의
			<<if _robin.vagina isnot "none">>
				<<NPCVirginityTakenByOther "Robin" "vaginal" $NPCList[2].fullDescription>>
				<<if _npcVirgin.vaginal is true>>
					보지에 처음으로 찔러넣자 로빈이 비명을 지른다.
				<<else>>
					보지에 찔러넣자 로빈이 비명을 지른다.
				<</if>>
			<<else>>
				<<NPCVirginityTakenByOther "Robin" "anal" $NPCList[2].fullDescription>>
				<<if _npcVirgin.vaginal is true>>
					항문에 처음으로 찔러넣자 로빈이 비명을 지른다.
				<<else>>
					항문에 찔러넣자 로빈이 비명을 지른다.
				<</if>>
			<</if>>
		</span>
		<<npcincr Robin trauma 5>><<ggrtrauma true>><<control -10>><<lcontrol>>
	<</if>>

	<<if _args[0] is "kissback">>
		<<set $kissTurns++>>
	<</if>>
<</widget>>

:: Underground Cell Robin Talk
<<set $outside to 0>><<set $location to "underground">><<effects>>
<<set _robin to statusCheck("Robin")>>
<<npc Robin>>

<<if $undergroundbrothel.robin>>
	당신은 자신의 감방과 로빈의 감방을 이어주는 구멍으로 다가가 <<person1>><<him>>【을를】 부른다.
<</if>>
<<switch $undergroundbrothel.robinTalk>>
	<<case 0>> /* First interaction */
		"우리가 어디에 있는지 알아?" 로빈이 묻는다. <<him>>【이가】 당신 쪽으로 몸을 움직이는 소리가 들린다.
		<br><br>

		"지하 감옥 같은 곳이야," 당신은 벽에 기대어 주저앉으며 대답한다.
		<br><br>

		로빈이 <<his>> 감방 안을 더듬거리는 소리가 들린다. "여기서 나갈 방법이 분명 있을 텐데..."
		<<He>>【은는】 다시 주변을 뒤척인다. "<<print (_robin.dom gte 60 ? "너한테" : "우리한테")>> 이런 일이 일어나게 두진 않을 거야."
	<<case 6>> /* Sixth interaction. They'll have been here a while by this point. */
		<<if $undergroundbrothel.escape is 0>>
			로빈이 대답한다. "여길 나갈 방법을 아직 찾는 중이야. 불빛이라도 좀 주면 도움이 될 텐데."
		<<else>>
			로빈이 대답한다. "매트리스 밑에 있는 구멍을 계속 파고 있어. 녀석들이 알았다면 진작에 날 막으려고 무슨 짓이든 했겠지." <<his>> 목소리에 실낱같은 희망이 서려 있다.
		<</if>>
	<<default>>
		<!-- select a random topic from robinTopics that is undiscussed. Priority topics always happen before undiscussed -->
		<<set _topicList to Object.entries(V.undergroundbrothel.robinTopics)>>
		<<if _topicList.filter(pair => pair[1] === "priority").length gte 1>>
			<<set _topic to _topicList.filter(pair => pair[1] === "priority").random()[0]>>
		<<elseif _topicList.filter(pair => pair[1] === "undiscussed").length gte 1>>
			<<set _topic to _topicList.filter(pair => pair[1] === "undiscussed").random()[0]>>
		<</if>>
		<<if _topic>>
			<<undergroundRobinTopic _topic>>
		<</if>>
		<<switch _topic>>
			<<case "scared">>
				"이런 일이 일어날 리 없어..." 로빈의 목소리는 낮고 힘이 없다.
				<br><br>

				<<if $speech_attitude is "meek">>
					"괘, 괜찮아?" 당신은 벽에 손을 얹는다.
				<<elseif $speech_attitude is "bratty">>
					"왜 그래? 녀석들이 너한테 무슨 짓이라도 한 거야?" 당신의 목소리가 높아진다.
				<<else>>
					"로빈? 괜찮아?" 당신이 묻는다.
				<</if>>
				<br><br>

				<<if _robin.dom gte 70>>
					"미안, 그냥. 방금 잠깐 벅차올라서 그랬어," 로빈이 떨리는 목소리로 말한다.
					"마음 굳게 먹어야지." <<He>>【은는】 다른 누구보다도 자기 자신을 다잡기 위해 그렇게 말하는 것 같다.
				<<else>>
					"여기서 죽고 싶지 않아." 로빈이 흐느끼는 소리가 들린다.
					<br><br>

					<<if $speech_attitude is "meek">>
						"제발 희망을 버리지 마, 우린 해낼 수 있어," 당신은 다정하게 말한다.
					<<elseif $speech_attitude is "bratty">>
						"녀석들이 바라는 게 바로 그거야. 네가 포기하고 현실을 받아들이는 거." 당신은 손으로 벽을 친다.
					<<else>>
						"걱정하지 마. 우린 여길 나갈 거야. 약속해," 당신이 말한다.
					<</if>>
					<br><br>

					"고마워. 정말 큰 힘이 돼." 로빈의 흐느낌이 잦아들며 멎는다.
				<</if>>
			<<case "touch">>
				"너를... 만져봐도 돼?" 로빈의 목소리가 떨리고 있다. <<if $robinromance is 1>>"진짜 따뜻한 손길이 너무 그리워."<<else>>"미안해, 그냥... 네가 여기 있다는 걸 확인하고 싶어서."<</if>>
				<br><br>

				당신은 둘 사이를 연결하는 구멍에 손가락을 집어넣는다. 간신히 들어가는 크기다. 곧바로 그 손가락에 따뜻한 온기가 맞닿아 오는 것이 느껴진다.
				잠시 동안 그러고 있자, 로빈이 당신의 손가락을 돌려주기 전에 조심스럽게 손가락 끝에 <<if $robinromance is 1>>입을 맞추는<<else>>손을 꼭 쥐는<</if>> 것이 느껴진다.
				<br><br>

				"고마워... 생각했던 것보다 훨씬 힘이 났어."
			<<case "dark">>
				"어둠 속에서 돌아다니는 건 정말 적응하기 힘드네," 로빈이 헛웃음을 짓는다. "물을 가지러 갈 때마다 매트리스에 계속 걸려 넘어져."
				<br><br>

				<<if $speech_attitude is "meek">>
					"눈이 멀어버릴 것만 같아," 당신은 공감하며 말한다.
				<<elseif $speech_attitude is "bratty">>
					"상품들이 여기서 너무 편하게 지내는 꼴은 못 보겠다는 거지." 당신은 팔짱을 낀다.
				<<else>>
					"나도 마찬가지야," 당신은 공감하며 말한다.
				<</if>>
				<br><br>

				"어쩌면 나중엔 야간 시야가 생길지도 몰라! 아니면 초음파 탐지라든가! 박쥐처럼 말이야!" 로빈이 당신의 기운을 북돋아 주려 애쓰고 있다는 게 느껴진다. 효과가 있다.
			<<case "lonely">>
				"저기..." 로빈의 목소리에 낙담이 묻어난다.
				<<if _robin.dom gte 60>>
					"다른 고아원 아이들이 보고 싶어. 다들 잘 지내고 있어야 할 텐데."
					<br><br>

					<<if $speech_attitude is "meek">>
						"다들 잘 지내고 있을 거야," 당신은 <<him>>【의】 기운을 북돋아 주려 한다.
					<<elseif $speech_attitude is "bratty">>
						"그럼 당장 여기서 나가서 애들을 확인해 보면 되잖아," 당신이 말한다.
					<<else>>
						"그럼 가능한 한 빨리 아이들에게 돌아가자," 당신이 말한다.
					<</if>>
					<br><br>

					"네 말이 맞아. 내가 이렇게 축 처져 있는 걸 보면 아이들도 속상해할 거야. 굳세게 마음먹어야지." 로빈의 목소리가 평소의 모습으로 조금 돌아온다.
				<<else>>
					"너랑 같이 놀던 때가 그리워. 다시 집으로 돌아가고 싶다."
					<br><br>

					<<if $speech_attitude is "meek">>
						"저기, 희망을 잃지 마, 응?" 당신이 부드럽게 말한다.
					<<elseif $speech_attitude is "bratty">>
						"녀석들이 네 머릿속을 헤집어 놓게 두지 마. 우린 반드시 여길 나갈 거야. 약속해," 당신은 자신 있게 말한다.
					<<else>>
						"곧 그렇게 될 거야. 걱정하지 마." 당신은 어둠 속에서 미소를 짓는다.
					<</if>>
					<br><br>

					"고마워," 로빈이 말한다. "여기 혼자 남겨졌다면 어떻게 됐을지 상상도 안 가."
				<</if>>
			<<case "cold">>
				"저, 저기, 너, 넌 어떻게 버, 버티고 있어?" 로빈이 말할 때마다 이가 덜덜 부딪히는 소리가 들린다.
				<br><br>

				<<if $speech_attitude is "meek">>
					"괘, 괜찮아?" 당신이 묻는다.
				<<elseif $speech_attitude is "bratty">>
					"로빈, 너 괜찮은 거야?" 당신은 벽 쪽으로 더 가까이 다가간다.
				<<else>>
					"무슨 일이야?" 당신이 묻는다.
				<</if>>
				<br><br>

				"오, 옷 상태가 많이 엉망이거든," 로빈이 대답한다. "이 추위를 막기엔 역부족이야." <<He>>【은는】 잠시 말을 멈추었다가 잇는다.
				<<if _robin.dom gte 60>>
					"내 걱정은 마. 핫초코 팔 때랑 똑같은걸!"
				<<else>>
					"최소한 이 방들에 난방이라도 좀 해줬으면 좋겠어."
				<</if>>
			<<case "tattoo">>
				"너도 문신 새겨졌어?" 로빈의 목소리가 짓눌려 있다. "난 164번이야." <<He>>【이가】 잠시 말을 멈춘다.
				"우리가 여길 나갈 <<print (_robin.trauma gte 70 ? "수 있다면" : "때면")>> 이걸 지울 수 있을까? 난 지금 내 이름이 훨씬 좋은데."
				<<He>>【이가】 괴로운 듯 메마른 웃음을 흘린다.
				<br><br>

				<<if $speech_attitude is "meek">>
					"너까지 그런 일을 겪게 해서 미안해," 당신은 떨리는 목소리로 말한다.
				<<elseif $speech_attitude is "bratty">>
					"그 빌어먹을 자식들이 나한테도 낙인을 찍어놨어. 분명 네 바로 직전이었을 거야." 당신은 피부에 새겨진 '163'이라는 숫자를 손으로 쓸어내린다.
				<<else>>
					"'163번'." 당신의 목소리는 멍하다.
				<</if>>
			<<case "pig">>
				<<if !$settings.bestialityEnabled or $settings.monsterChance gte 100>>
					<<set _animals to "괴물">>
				<<else>>
					<<set _animals to "동물">>
				<</if>>
				"저기," 로빈이 말한다. <<He>>【은는】 밝은 척 목소리를 내지만, 억지로 꾸며내고 있다는 걸 알 수 있다. "돼지가 세상에서 가장 똑똑한 _animals 중 하나라는 거 알고 있었어?
				무언가를 정말 빠르게 배우고, 기억력도 정말 좋대. 진흙투성이라는 편견과 달리 실은 아주 깨끗한 아이들이야. 어릴 땐 돼지를 정말 좋아했었는데."
				<br><br>

				<<He>>【은는】 몇 초간 침묵한다. "이젠 돼지가 좋지 않은 것 같아," 힘없는 목소리로 <<he>>【이가】 말한다.
			<<case "dice">>
				"이젠 주사위를 예전과 같은 눈으로 볼 수 없을 것 같아," 로빈이 <<if _robin.trauma gte 40>>목소리를 떨며<<else>>억지 웃음을 지으며<</if>> 말한다. "그게 녀석들이 생각하는 게임이었을까?"
				<br><br>

				<<if $speech_attitude is "meek">>
					"나도 주사위를 예전처럼 보진 못할 것 같아," 당신은 속삭인다.
				<<elseif $speech_attitude is "bratty">>
					"그 거대한 주사위로 녀석들 면상을 갈겨버릴 수 있었으면 좋았을 텐데," 당신이 중얼거린다.
				<<else>>
					"당연히 게임이지," 당신이 중얼거린다. "여긴 원래 그런 곳이니까."
				<</if>>
				<br><br>

				<<if _robin.trauma gte 70>>
					"녀석들한텐 그저 게임일 뿐이지," 로빈이 되뇐다. <<He>>【은는】 공허한 웃음을 흘린다. "이걸로 게임 오버인가 봐."
				<<else>>
					"비디오 게임이기만 했어도 좋았을 텐데," <<he>>【이가】 말한다. "그랬다면 레이저 검이랑 깃털 대포를 들고 돌파했을 거야. 그리고 네가 맨날 쓰던 그 콤보도 쓰고 말이지." 다시 집 생각을 하자 <<he>>【의】 목소리가 한결 밝아진다.
				<</if>>
			<<case "tentacles">>
				<<if $robinromance is 1>>"네가 그런 일을 겪게 해서 미안해," 로빈이 중얼거린다. "날 절정에 이르게 해준 거 말이야. 그 쇠붙이들이 널 공격하고 있었는데도."<<else>>"네가... 그런 일을 겪게 해서 미안해," 로빈이 중얼거린다. "나랑... 그걸 하게 만들었잖아. 그 쇠붙이들이 널 공격하고 있었는데도. 난—" <<His>> 숨이 턱 막힌다. "이러고 싶지 않았어. 정말이야."<</if>>
				<br><br>

				<<if $speech_attitude is "meek">>
					<<if $robinromance is 1>>"너랑 하는 건 좋아," 당신이 대답한다. "그저... 그런 식은 아니었으면 했을 뿐이야."<<else>>"네 잘못이 아니야," 당신은 간신히 들릴 듯한 속삭임으로 대답한다. "너도... 넌 아무것도 할 수 없었잖아."<</if>>
				<<elseif $speech_attitude is "bratty">>
					<<if $robinromance is 1>>"벌치고는 별거 아니었어," 당신은 으스대듯 말한다. "내 <<nnpc_girlfriend "Robin">>이랑 섹스하는 거잖아? 녀석들은 그게 끔찍한 벌이라도 될 줄 알았나 보지?"<<else>>"너무 자책하지 마," 당신은 코웃음 친다. "다 그 역겨운 녀석들 잘못이야. 게다가 그렇게 끔찍하지도 않았어. 진짜야."<</if>>
					<<if $trauma gte ($traumamax * 0.6)>>
						당신은 목소리가 떨리지 않도록 필사적으로 참아낸다. 대체로는 성공적이다.
					<</if>>
				<<else>>
					"<<if $robinromance isnot 1>>알아, 로빈. <</if>>네가 다치지 않아서 다행일 뿐이야," 당신이 말한다.
				<</if>>
				<br><br>

				로빈은 몇 초간 침묵한다. "녀석들이 내게 강제로 뭘 먹였어. 걸쭉하고 시큼한 음료 같은 거였는데. 온몸이 마비되고 차가워져서... 네가 하는 행동을 아무것도 느낄 수가 없었어."
			<<case "machineHigh">>
				<<set _noOptions to true>>
				<<He>>【은는】 잠시 뜸을 들인 뒤 대답한다. 들려온 <<his>> 목소리는 텅 비어 있다. "아팠어."
				<br><br>

				당신이 자세한 이야기를 기다리자, <<he>>【이가】 코를 훌쩍인다. "기계가 날 너무 아프게 했어. 너무 빠르고, 너무 거칠어서, 지금은 제대로 앉아있지도 못하겠어. 그런데 대체 왜? 왜 내 쪽 출력을 올리라고 한 거야?" 로빈의 목소리에 눈물이 가득 차오른다. "내가 아플 거라는 거 알고 있었잖아, 맞지? 도대체 왜 그런 거야?"
				<br><br>

				<<if $speech_attitude is "meek">>
					"미, 미안해," 당신은 중얼거린다. 다른 어떤 말도 떠오르지 않는다.
				<<elseif $speech_attitude is "bratty">>
					당신은 무슨 말이라도 해보려 한다. 하지만 말이 목구멍에 엉겨 붙어 나오지 않는다.
				<<else>>
					"너무 무서웠어," 당신이 조용히 말한다.
				<</if>>
				<br><br>

				"왜 그랬어?" 로빈이 목소리를 높이며 계속 다그친다. "내가 아플 거라는 걸 알았으면서! 너무너무 아팠단 말이야! 왜 나한테 그런 짓을 한 거야? 도대체 무슨 생각이었어?!"
				<<stress 6>><<gstress>>
				<br><br>

				당신은 마른침을 삼킨다. "로빈—"
				<br><br>

				"넌 날 지켜주기로 했잖아!" <<he>>【이가】 쏘아붙인다. "지켜주기는 개뿔!"
				<<stress 12>><<trauma 12>><<ggstress>><<ggtrauma>>
				<br><br>

				<<link [[사과한다|Underground Cell Robin Talk 2]]>><<stress 6>><<npcincr Robin love 1>><<npcincr Robin dom 1>><<set $phase to "machineHighApologise">><</link>><<gstress>><<glove>><<gdom>>
				<br>
				<<link [[침묵을 지킨다|Underground Cell Robin Talk 2]]>><<trauma -6>><<npcincr Robin dom -10>><<set $phase to "machineHighSilent">><</link>><<ltrauma>><<lldom>>
			<<case "machineNormal">>
				잠시 후 로빈이 떨리는 목소리로 대답한다. "저, 저기.
				<<if _robin.dom gte 50>>
					괜찮아?" <<He>>【이가】 당신을 위로한다. "너무 심하게 다치지 않았어야 할 텐데."
				<<else>>
					"진짜 아팠어." 말하는 <<his>> 목소리에서 고통이 고스란히 묻어난다. 잠시 말을 멈추더니 <<he>>【이가】 덧붙인다. "넌 괜찮아?"
				<</if>>
				<br><br>

				<<if $pain gte 60>>
					<<if $speech_attitude is "meek">>
						당신은 고통을 덜어내려 흐느끼며 눈물을 쏟아낸다.
					<<elseif $speech_attitude is "bratty">>
						"난 괘, 괜찮아." 뺨을 타고 눈물이 흘러내리며 목소리가 갈라져 나와, 말이 무색해진다.
					<<else>>
						"아, 아니," 뺨을 타고 눈물을 흘리며 당신이 말한다.
					<</if>>
					<br><br>

					로빈은 처음엔 놀란 눈치였지만, 금세 마음을 다잡는다. "괜찮을 거야. 우린 여길 빠져나갈 거고, 그럼 그자들도 우릴 더는 다치게 하지 못할 테니까."
					잠시 침묵이 흐른 뒤 <<he>>【이가】 속삭인다. "내가 우리 둘 몫까지 강해질게."
					<<pain -20>><<lpain>><<npcincr Robin dom 2>><<gdom>>
				<<else>>
					<<if $speech_attitude is "meek">>
						"난 괜찮을 거야, 그래도 걱정해 줘서 고마워." <<his>> 걱정에 절로 미소가 번진다.
					<<elseif $speech_attitude is "bratty">>
						"겨우 이 정도로 내가 쓰러질 줄 알고." 당신은 로빈을 위해 씩씩한 척을 해 보인다.
					<<else>>
						"응, 괜찮아. 너도 무사해서 다행이다," 당신은 감방을 나누는 벽에 등을 기대며 말한다.
					<</if>>
					<br><br>

					<<if _robin.trauma gte 70>>
						로빈이 코를 훌쩍인다. "그냥, 다 끝나서 다행이야."
					<<else>>
						로빈이 안정을 되찾는다. "우린 여길 나갈 수 있어, 꼭 그럴 수 있을 거야."
					<</if>>
				<</if>>
			<<case "machineLow">>
				"괜찮아?" 로빈이 목소리에 걱정을 가득 담아 거의 곧바로 대답한다.
				<<if _robin.dom gte 50>>
					"그자들에게 대답을 기다려줄 리 없다는 걸 진작 알았어야 했는데," <<he>>【이가】 말한다.
				<<else>>
					"정말 미안해, 네가 대답할 때까지 안 기다려줄 줄은 몰랐어," <<he>>【이가】 말한다.
				<</if>>
				"내가 어떻게 해주면 기분이 좀 나아질까?" 로빈이 당신을 위로하려 애쓴다.
				<br><br>

				<<if $pain gte 60>>
					<<if $speech_attitude is "meek">>
						"제, 제발 잡아줘." 당신이 구멍 사이로 손가락을 밀어 넣자, 로빈이 조심스럽게 잡아준다.
						<br><br>

						"괜찮아." 당신이 흐느끼기 시작하자 <<he>>【은는】 당신의 손가락을 쥐고 부드럽게 문질러준다. "쉬이, 다 괜찮아질 거야."
					<<elseif $speech_attitude is "bratty">>
						"난 괜찮을 거야," 숨이 턱 막힌 채 억지로 말을 뱉어보지만, 로빈은 전혀 믿지 않는 눈치다.
						<br><br>

						"여기서 나가면 내가 아이스크림 사주는 건 어때?" 말하는 로빈의 목소리에서 미소가 느껴질 듯하다.
						"내가 쏠게."
					<<else>>
						"우리 지, 집에 갈 수 있을까?" 당신이 흐느낀다.
						<br><br>

						"그냥 다 털어내," 작게 우는 당신을 로빈이 달래준다. "집에 돌아가면, <<if $robinromance is 1>>이런 일은 전부 잊어버릴 만큼 활짝 웃게 해줄게.<<else>>이런 일은 싹 다 잊어버릴 만큼 실컷 놀고 게임도 같이 하자.<</if>>"
					<</if>>
					<<pain -20>><<lpain>><<trauma -5>><<ltrauma>><<npcincr Robin dom 2>><<gdom>>
				<<else>>
					<<if $speech_attitude is "meek">>
						"괜찮은 것 같아, 고마워," 당신은 가볍게 떨며 말한다.
					<<elseif $speech_attitude is "bratty">>
						"한동안 좀 쑤시기야 하겠지만, 그것 말고는 멀쩡해. 안 죽어," 당신이 말한다.
					<<else>>
						"다 끝나서 다행이야, 정말 끔찍했거든," 당신이 말한다.
					<</if>>

					"무사해서 다행이다. 필요한 거 있으면 꼭 말해줘, 알겠지?" 로빈의 목소리에 안도가 서린다.
				<</if>>
			<<case "machinePlayer">>
				"괜찮아?" 로빈이 목소리에 걱정을 가득 담아 거의 곧바로 대답한다.
				"멈춰줘서 다행이야, 조금만 더 일찍 멈췄으면 좋았을 텐데. 녀석들이..." <<He>>【은는】 말을 끝맺지 못한다.
				<br><br>

				<<if $speech_attitude is "meek">>
					당신이 벽을 끌어안자, 잠시 반대편에서 로빈의 온기가 그대로 전해지는 듯한 기분이 든다.
					"괘, 괜찮을 것 같아. 고마워."
				<<elseif $speech_attitude is "bratty">>
					"너한테까지 손을 뻗치지 않아서 다행이지 뭐." 당신은 억지로 떠오르는 기억들을 떨쳐내며 억지 미소를 짓는다.
				<<else>>
					"난 괜찮을 거야," 당신은 둘을 이어주는 벽에 손을 얹으며 말한다. "약속할게."
				<</if>>
			<<case "machineNone">>
				<<if _robin.trauma lte 40>>
					"우리가 본때를 보여줬어!" 로빈의 목소리가 들떠 있다. "다시 우릴 고문하려 들 땐 생각을 고쳐먹겠지."
				<<else>>
					"우리가 무사해서 정말 다행이야. 그 기계에 부, 부서지는 꼴은 도저히 못 버텼을 텐데." 로빈의 목소리에는 안도감이 묻어나면서도 여전히 불안이 서려 있다.
				<</if>>
				<br><br>

				<<if $speech_attitude is "meek">>
					"우리 둘 다 다치지 않아서 다행이야. 그 기계들 정말 무서웠어." 당신은 안도의 한숨을 내쉰다.
				<<elseif $speech_attitude is "bratty">>
					"우리한테 그런 짓을 하려 드니까 꼴좋게 당한 거지." 이 모든 상황 속에서도 절로 미소가 지어진다.
				<<else>>
					"그자들이 포기해서 다행이야. 혹시 다시 하려고 들까 봐 조마조마했거든." 당신은 미소를 짓는다.
				<</if>>
			<<case "kissBack">>
				<<if $robinromance is 1>>"아까 뽀뽀해 줘서 고마워," <<he>>【이가】 말한다. 잠시 침묵이 흐른다. "이상하게 들릴지도 모르겠지만... 무슨 일이 일어나고 있는지 신경을 끄는 데 도움이 됐어. 딴생각을 할 수 있었거든."<<else>>"저기," <<he>>【이가】 말한다. 잠시 침묵이 흐른다. "우리... 우리 아직 친구 맞지? 아, 아까 네가 뽀뽀했을 때, 난..." <<him>>【이가】 떨리는 숨을 내쉬는 소리가 들린다. 다시 입을 연 <<his>> 목소리는 작고 조심스럽다. "...도움이 됐어. 딴생각을 할 수 있었거든."<</if>>
				<br><br>

				<<if $speech_attitude is "meek">>
					<<if $robinromance is 1>>"오히려 내가 더 고마워해야지," 당신이 말한다.<<else>>"미, 미안해," 당신은 떨리는 목소리로 말한다. "도와줄 수 있는 방법이 그것밖에 안 떠올랐어. 그냥 내가 곁에 있다는 걸 알려주고 싶어서..."<</if>>
				<<elseif $speech_attitude is "bratty">>
					<<if $robinromance is 1>>"내가 더 뭔가를 해줬어야 했는데," 당신은 이를 악물며 말한다. "그놈들 다 혐오스러워."<<else>>"미안," 당신은 이를 악문다. "딴생각이라도 하게 해주고 싶었어. 넌 내 친구잖아, 로빈, 난..." 주먹을 꽉 쥔다. "더 도와줄 수 있었으면 좋았을 텐데. 그놈들 다 혐오스러워."<</if>>
				<<else>>
					<<if $robinromance is 1>>"그 정도는 당연히 해줄 수 있는걸," 당신이 말한다.<<else>>"그냥 다른 쪽에 집중하게 해주고 싶었어," 목이 메어오며 당신이 말한다. "도움이 될 줄 알았거든."<</if>>
				<</if>>
			<<case "hunt">>
				<<if _robin.dom gte 70>>
					"코앞까지 갔었는데," <<he>>【이가】 중얼거린다. "숲속에 있었잖아, 우리가 해낼 수도 있었는데..." <<He>>【이가】 한숨을 내쉰다. "내가 더 강했어야 했어. 그랬다면 널 구해서 같이 여길 빠져나갈 수 있었을 텐데."
					<br><br>

					<<if $speech_attitude is "meek">>
						"네, 네가 날 지켜줄 필요까진 없는데," 당신이 조용히 말한다.
					<<elseif $speech_attitude is "bratty">>
						"일을 그르친 게 너 혼자만은 아니잖아," 당신이 중얼거린다.
					<<else>>
						"자책하지 마," 당신이 말한다. "우리 같이 겪은 일이잖아. 내 탓이기도 해."
					<</if>>
					<br><br>

					로빈은 몇 초간 침묵한다. "우린 여길 나갈 거야. 다음번에 녀석들이 실수로라도 해를 보여주면, 바로 도망치는 거야."
				<<else>>
					"햇살을 다시 볼 수 있어서 좋았어," 밝게 말해보려 애쓰며 <<he>>【이가】 말한다. "풀밭을 밟는 것도. 그건... 참 좋았는데."
					<br><br>

					<<if $speech_attitude is "meek">>
						"따, 따뜻했지," 희망을 잃지 않으려 당신이 말한다. 긍정적인 마음을 유지하기란 쉽지 않다. "여기도 그렇게 춥지만 않았으면 좋았을 텐데."
					<<elseif $speech_attitude is "bratty">>
						"이딴 곳보단 훨씬 낫지," 벽을 툭 차며 당신이 중얼거린다. "여긴 시발 아무것도 안 보이잖아. 불이라도 좀 켜주든가."
					<<else>>
						"밖에서 조금만 더 오래 있을 수 있었으면 좋았을 텐데," 당신이 말한다.
					<</if>>
					<br><br>

					"응," 로빈이 동의한다. "그리고 난..." <<He>>【은는】 말끝을 흐린다. "얼른 여길 나가고 싶어."
				<</if>>
			<<default>>
				<<Hes>> 조용하다. "괜찮아?" 당신이 묻는다.
				<br><br>

				잠시 침묵이 흐른 뒤 로빈이 대답한다.
				<<if _robin.trauma gte 70>>
					"여, 여길 꼭 나가야 해..." 로빈의 목소리가 떨리고 있다.
				<<else>>
					"난 괜찮을 거야." <<He>>【이가】 힘없이 웃는다. "그냥 마음 굳게 먹고 있으면 돼." 입 밖으로 내는 말과 달리 로빈의 목소리는 파리하게 떨리고 있다.
				<</if>>
				<<undergroundRobinTopicRefresh>>
		<</switch>>
<</switch>>
<<set $undergroundbrothel.timepass to false>><<set $undergroundbrothel.robinTalk++>><<set $undergroundbrothel.robinSpoke to true>>
<br><br>

