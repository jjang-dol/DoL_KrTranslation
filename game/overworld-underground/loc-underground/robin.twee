		<</if>>
	</span>

	<span id="die_2">
		<<if $options.images is 1>>
			<img src="img/misc/prop/die-stone-roll.gif">
		<<else>>
			?
		<</if>>
	</span>
	<br>
	=
	<br>
</div>

<<timed 2s>>
	<<replace "#die_1">>
	<<if $options.images is 1>>
		<img @src="'img/misc/prop/die-stone-' + $uDice1 + '.png'">
	<<else>>
		$uDice1
	<</if>>
	<</replace>>
<</timed>>
<<timed 4s>>
	<<replace "#die_2">>
	<<if $options.images is 1>>
		<img @src="'img/misc/prop/die-stone-' + $uDice2 + '.png'">
	<<else>>
		$uDice2
	<</if>>
	<</replace>>
<</timed>>

<<timed 5s>>
	<span id="die_text">
		<<if $uDice1 is $uDice2>>
			<<switch $uDice1>>
				<<case 1>>
					<span @class="_d1Color">뱀눈</span>
				<<case 6>>
					<span @class="_d1Color">박스카</span>
				<<default>>
					<span @class="_d1Color"><<number $uDice1>> 더블</span>
			<</switch>>
		<<else>>
			<span @class="_d1Color"><<Number $uDice1>></span> 그리고 <span @class="_d2Color"><<number $uDice2>></span>
		<</if>>
	</span>
	<<replace "#temp_br">>
		<br>
	<</replace>>
<</timed>>

<<timed 6s>>
	<<replace "#temp_br">>
