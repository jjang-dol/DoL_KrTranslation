	<br><br>
	<<if $nextPassageCheck is "Sewers Possessed">>
		<<laddericon>><span class="nextLink"><<link [[밖으로 기어 올라간다.|Sewers Possessed]]>><<pass 4>><</link>></span>
		<br>
	<<elseif $sewerschased isnot 1>>
