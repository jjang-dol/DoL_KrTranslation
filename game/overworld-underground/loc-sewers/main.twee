:: Widgets Drain Descriptions [widget]
<<widget "draindescription">>
	<<if Weather.precipitation is "rain">>
		배수로 중앙으로 물이 세차게 밀려들어, 양옆의 좁은 보행로까지 물에 잠길 지경이다.
	<<elseif Weather.isFreezing>>
		얼음덩어리들이 섞인 채 배수로 중앙으로 거칠게 흘러내려가고 있다.
	<<else>>
		배수로 중앙으로 물이 콸콸 흘러내리고 있고, 양옆으로는 좁은 보행로가 나 있다.
	<</if>>
	<<wHunt "drain">>
	<br><br>
	이곳에서 마을 여러 구역으로 접근할 수 있다.
	<br><br>
	<<if isPubfameTaskAccepted("morgan")>>
		미키는 그 USB가 하수도 어딘가에 있고, 아마 <<if $sewersintro is 1>>모건이 갖고 있을 거라고 했다.<<else>>아래의 누군가가 갖고 있을 거라고 했다. 밑으로 내려가는 사다리가 보인다.<</if>>
		<br><br>
	<</if>>
<</widget>>

<<widget "drainlinks">>
	<<if $stress gte $stressmax and !$possessed>>
		<<passoutdrain>>
	<<else>>
		<<rng>>
		<<if Weather.precipitation isnot "none" and $rng gte 76 and $eventskip is 0>>
			<<eventsdrain>>
		<<elseif ($rng gte 92 or $eventforced) and $eventskip is 0>>
			<<eventsdrain>>
		<<else>>
			<<if $arousal gte $arousalmax and $bus isnot "drainexit">>
				<<orgasmLocation "sewers">>
			<</if>>
			<<switch $bus>>
				<<case "industrialdrain">>
					<<industrialdrainlinks>>
				<<case "commercialdrain">>
					<<commercialdrainlinks>>
				<<case "residentialdrain">>
					<<residentialdrainlinks>>
				<<case "drainexit">>
					<<drainexitlinks>>
			<</switch>>
		<</if>>
		<<displayLinks>>
	<</if>>
<</widget>>

<<widget "industrialdrainlinks">>
	<<drainladderdownlink "industrial">>
	<<commercialdrain>>
	<br>
	<<drainexit>>
	<br>
	<<if $exposed gte 1 and Time.dayState isnot "night">>
	<<else>>
		<<elk>>
		<<mer>>
		<<harvest>>
	<</if>>
	<br>
	<<industrial>>
<</widget>>

<<widget "commercialdrainlinks">>
	<<drainladderdownlink "commercial">>
	<<residentialdrain>>
	<br>
	<<industrialdrain>>
	<<if $exposed gte 1 and Time.dayState isnot "night">>
	<<else>>
		<<high>>
		<<connudatus>>
		<<cliff>>
		<<nightingale>>
		<<starfish>>
		<<oxford>>
	<</if>>
	<br>
	<<commercial>>
	<<park>>
	<br>
	<<if $historytrait gte 2 and $schooldrainintro gte 1>>
		<<bathroomicon "toilet">><<link [[학교 화장실로 이어지는 비밀 통로 (0:02)|School Toilets]]>><<pass 2>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "residentialdrainlinks">>
	<<drainladderdownlink "residential">>
	<<commercialdrain>>
	<br>
	<<if $exposed gte 1 and Time.dayState isnot "night">>
	<<else>>
		<<domus>>
		<<barb>>
		<<danube>>
		<<wolf>>
	<</if>>
	<br>
	<<residential>>
	<<if $loft_wren gte 2>>
		<<gardenicon>><<link [[사다리를 타고 고아원 정원으로 올라간다|Garden]]>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "drainexitlinks">>
	<<if $scienceproject is "ongoing" and $sciencelichendrain is 0>>
		<<scienceicon "violet lichen">><<link [[이끼를 조사한다|Drain Lichen]]>><<set $sciencelichendrain to 1>><</link>>
		<br>
	<</if>>
	<<industrialdrain>>
	<br><br>
<</widget>>

<<widget "drainladderdownlink">>
	<<if $sewersintro is 1>>
		<<laddericon>>
		<<set _dest to "Sewers " + _args[0].toLocaleUpperFirst()>>
		<<link [[내려간다|_dest]]>> <<sewersstart>><<set $eventskip to 1>><</link>>
		<br><br>
	<<elseif $historytrait gte 1 or isPubfameTaskAccepted("morgan")>>
		<<laddericon>><<link [[내려가는 사다리를 조사한다|Drain Ladder]]>><</link>>
		<br><br>
	<</if>>
<</widget>>

:: Widgets Drain Water [widget]
<<widget "movealongdrainwater">>
	<<if $bus is "residentialdrain">>
		<<set $bus to "commercialdrain">>
	<<elseif $bus is "commercialdrain">>
		<<set $bus to "industrialdrain">>
	<<elseif $bus is "industrialdrain">>
		<<set $bus to "drainexit">>
	<</if>>
<</widget>>

:: Drain Lights Work
<<effects>>

당신은 벽과 물을 조사한다.
<<if currentSkillValue("history") gte random(1, 1000)>>
	<<if $bus is "residentialdrain">>
		<<set $drains_rescue_location to "residential">>
		나뭇잎, 풀, 그리고 다른 정원 부스러기들이 떠내려간다. 공원 관리인들이 쓰레기를 그렇게 함부로 처리하지는 않을 테니까. 당신은 주거 구역 아래에 있다.
	<<elseif $bus is "commercialdrain">>
		<<set $drains_rescue_location to "commercial">>
		물에 쓰레기가 많이 떠다닌다. 당신은 상업 구역 아래에 있다.
	<<else>>
		<<set $drains_rescue_location to "industrial">>
		이상한 얼룩들. 틀림없는 오염 물질의 냄새. 당신은 공업 구역 아래에 있다.
	<</if>>
	격자무늬 틈으로 건물의 벽을 이루는 벽돌들을 바라본다. 그런 식으로 지어진 건물은 단 하나뿐이다. <span class="green">어디인지 알 것 같다.</span>
	<br><br>

	구조가 필요할지도 모르겠다.
	<br><br>
<<else>>
	하지만 빗물 배수로는 상당히 똑같이 생겼다. <span class="red">어디에 있는지 알 수 없다.</span>
	<br><br>

	당신은 조명과 불쾌한 소리들을 뒤로한 채 빗물 배수로를 계속 나아간다.
	<br><br>
<</if>>

<<if $bus is "residentialdrain">>
	<<getouticon>><<link [[다음|Residential Drain]]>><</link>>
	<br>
<<elseif $bus is "commercialdrain">>
	<<getouticon>><<link [[다음|Commercial Drain]]>><</link>>
	<br>
<<else>>
	<<getouticon>><<link [[나간다|Industrial Drain]]>><</link>>
	<br>
<</if>>

:: Drain Lights Leave
<<effects>>

당신은 조명과 불쾌한 소리들을 뒤로한 채 빗물 배수로를 계속 나아간다.
<br><br>

<<if $bus is "residentialdrain">>
	<<getouticon>><<link [[다음|Residential Drain]]>><</link>>
	<br>
<<elseif $bus is "commercialdrain">>
	<<getouticon>><<link [[다음|Commercial Drain]]>><</link>>
	<br>
<<else>>
	<<getouticon>><<link [[다음|Industrial Drain]]>><</link>>
	<br>
<</if>>

:: Drain Deluge Hide
<<effects>>

당신은 벽을 따라 난 물때 자국 위, 커다란 파이프 위로 올라간다.
<<if $rng lt 70>>
	그리고 지나갈 때까지 기다린다.
	<br><br>
<<else>>
	그리고 기다린다. 처음에는 아무 일도 일어나지 않는다. 그러다 물이 코너를 돌아 쇄도해 온다. 물이 지나갈 때까지 발이 젖지 않도록 무릎을 바짝 굽히고 있는다.
	<br><br>
<</if>>

<<drainlinks>>

:: Drain Deluge Chance
<<effects>>

<<if $rng lt 70>>
	당신은 소리를 무시하고 길을 계속 나아간다. <span class="green">당신을 휩쓸어 갈 홍수는 오지 않는다.</span>
	<br><br>

	<<drainlinks>>
<<else>>
	당신은 소리를 무시하고 길을 계속 나아간다. <span class="red">물이 굉음을 내며 덮쳐와 당신을 수로로 휩쓸어 버린다.</span>
	<br>
	<<silently>><<water>><</silently>>
	<br>
	<<set $worn.over_upper.integrity -= 10>><<set $worn.over_lower.integrity -= 10>><<set $worn.upper.integrity -= 10>><<set $worn.lower.integrity -= 10>><<set $worn.under_lower.integrity -= 10>><<pain 1>>
	<<link [[다음|Drain Water]]>><</link>>
<</if>>
