:: Forest

<<location "forest">><<effects>><<wPersist "forest">><<getTarget true>><<set $bus to "forest">>
<<if $foresthunt gte 1>>
	<<if $forestHunter is "Eden" and (hasSharpSenses() or $foresthunt gte 7)>>
		<<print either(
			`<span class="red">당신은 사냥당하고 있다. 바닥에 다 쓴 탄피가 떨어져 있는 것이 보인다.</span>`,
			`<span class="red">당신은 사냥당하고 있다. 바닥에 부츠 자국이 찍힌 것이 보인다.</span>`,
			`<span class="red">당신은 사냥당하고 있다. 멀리서 총성이 들린다.</span>`
		)>>
	<<elseif $forestHunter is "Black Wolf" and (hasSharpSenses() or $foresthunt gte 7)>>
		<<print either(
			`<span class="red">당신은 사냥당하고 있다. 나무에 엉킨 늑대 털이 보인다.</span>`,
			`<span class="red">당신은 사냥당하고 있다. 바닥에 늑대 발자국이 찍힌 것이 보인다.</span>`,
			`<span class="red">당신은 사냥당하고 있다. 멀리서 으르렁거리는 소리가 들린다.</span>`
		)>>
	<<elseif $forestHunter is "Gwylan" and (hasSharpSenses() or $foresthunt gte 7 or $gwylan?.lureSong)>>
		<<if isGwylanAbsent() is "nobody">>
			<<set $eventskip to 1>>
			<<print either(
				`<span class="red">당신은 사냥당하고 있다. 아무 소리도 들리지 않는다.</span>`,
				`<span class="red">당신은 사냥당하고 있다. 숲은 텅 비어 있다.</span>`,
				`<span class="red">당신은 사냥당하고 있다. 아무도 보이지 않는다.</span>`,
				`<span class="red">아무도 당신을 사냥하고 있지 않다.</span>`
			)>>
		<<else>>
			<<if $gwylan?.lureSong>>
				<span class="red">사냥당하고 있다. <<if $gwylan.lureSong is 1>>멀리서 노랫소리가 들려온다.<</if>></span>
				<<if $gwylan.lureSong is 1 and $islander_language gte 100>>
					그 언어를 알아듣는다. <span class="blue">섬 주민의 언어다.</span>
					<br><br>
				<<elseif $islander_language gte 100>>
					<br><br>
				<</if>>
				<<gwylanSong>>
			<<else>>
				<<print either(
					`<span class="red">당신은 사냥당하고 있다. 멀리서 달래는 듯한 노랫소리가 들린다.</span>`,
					`<span class="red">당신은 사냥당하고 있다. 숲이 유난히 고요하다.</span>`,
					`<span class="red">당신은 사냥당하고 있다. 호기심 어린 시선이 꽂히는 듯하다.</span>`
				)>>
			<</if>>
		<</if>>
	<<elseif $wraith.hunt and $forestHunter is "Wraith">>
		<<if $moonstate is "morning" and Time.hour gte 6 and Time.hour lte 20>>
			해가 떠오르자 안도감이 밀려온다. 공포가 사라진다. <span class="blue"><i>다음 붉은 달까지는 안전합니다.</i></span>
			<<clearWraith>>
		<<else>>
			<<print either(
				`<span class="red">당신은 사냥당하고 있다. 붉은 달빛이 사방에 불길한 그림자를 드리운다.</span><<stress 6>><<gstress>>`,
				`<span class="red">당신은 사냥당하고 있다. 멀리서 웃음소리가 들린다.</span> <<trauma 6>><<gtrauma>>`,
				`<span class="red">당신은 사냥당하고 있다. 숨쉬기가 점점 어려워진다.</span> <<stress 6>><<gstress>><<trauma 6>><<gtrauma>>`
			)>>
		<</if>>
	<<else>>
		<!-- generic text for when a hunt is happening but we haven't written a more specific version of the text, or the player's senses aren't sharp enough to know who's hunting them. -->
		<span class="red">사냥당하고 있다.</span>
	<</if>>
	<br><br>
<</if>>

<<if $arousal gte $arousalmax>>
	<<orgasmforest>>
<</if>>

<<set $forest to Math.clamp($forest, 0, 100)>>

<<forestmove>>

<<if $stress gte $stressmax and !$possessed>>
	<<passoutforest>>
<<elseif $foresthunt gte 10 and !$possessed>>
	<<foresthunt>>
<<elseif $forest lte 0>>

	<<if $eventskip is 0>>
		<<rng>>
		<<if $rng gte 81 or ($forest_search is true and $rng gte 61)>>
			<<eventforestitem>>
		<<elseif dangerEvent($forestmod)>>
			<<eventforestoutskirts>>
		<<else>>
			<<eventforestsafe>>
		<</if>>
	<<elseif $town_projects.road is 1>>
		<<set $town_projects.road to 2>>
		숲 외곽이다. 나무들 사이로 마을이 보인다.
		<br><br>

		낡은 벽돌에 걸려 넘어질 뻔했다. 그러자 주변의 다른 벽돌들도 눈에 들어온다. 예전에는 이곳에 마을과 호수를 잇는 길이 있었다. <span class="teal">좋은 생각이 떠오른다.</span> 길이 복구된다면, 당신과 다른 학생들 모두 더 안전하게 다닐 수 있을 것이다.
		<br><br>

		<i>시청에 가서 길에 대해 문의해볼 수 있겠다.</i>
		<br><br>

		<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<br>
	<<elseif $town_projects.road is 3>>
		<<set $town_projects.road to 4>>
		숲 외곽이다. 나무들 사이로 마을이 보인다.
		<br><br>

		시장실은 발 빠르게 움직였다. 길이 숲속으로 뻗어 시야 밖으로 굽이쳐 사라진다. <span class="green">호수를 오가는 것이 훨씬 수월해졌습니다.</span>
		<br><br>

		<<earnFeat "Safe Trail">>
		<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<br>
	<<elseif $eventskip gte 1>>
		숲 외곽이다. 나무들 사이로 마을이 보인다.
		<br><br>

		<<if $exposed lte 1 or $gwylanSeen?.includes("lights")>>
			<<if $forest_shop_intro is 1>>
				<<if $hypnosis_traits.devotion gte 5 and ($gwylanSeen?.includes("romance") or $gwylan?.timer?.petBed)>>
					<<set _forestShopText to "숲 가장자리에 당신의 집이 자리하고 있다.">>
					<<set _forestShopLinkText to "집">>
				<<elseif $gwylanSeen?.includes("yearning") and isGwylanAbsent() isnot "nobody">>
					<<set _forestShopText to "숲 가장자리에 그윌란의 가게가 자리하고 있다.">>
					<<set _forestShopLinkText to "그윌란의 가게">>
				<<else>>
					<<set _forestShopText to "숲 가장자리에 숲속 상점이 자리하고 있다.">>
					<<set _forestShopLinkText to "숲속 상점">>
				<</if>>
				<<= _forestShopText>><br>
				<<if $daily.gwylan.locked or Time.isBloodMoon() or C.npc.Gwylan.state is "scorned">>
					<<shopicon "forest">><<link [[_forestShopLinkText|Forest Shop Locked]]>><<endevent>><</link>>
				<<else>>
					<<shopicon "forest">><<link [[_forestShopLinkText|Forest Shop Entrance]]>><<endevent>><<set $enteringForestShop to true>><</link>>
				<</if>>
			<<else>>
				성처럼 생긴 이상한 가게가 숲 가장자리에 자리하고 있다.<br>
				<<if Time.isBloodMoon() or isGwylanAbsent() and C.npc.Gwylan.init isnot 0>>
					<<shopicon "forest">><<link [[이상한 가게|Forest Shop Locked]]>><<endevent>><</link>>
				<<else>>
					<<shopicon "forest">><<link [[이상한 가게|Forest Shop Entrance]]>><<endevent>><<set $enteringForestShop to true>><</link>>
				<</if>>
			<</if>>
			<br><br>
		<</if>>

		<<forestdeeper>>
		<br><br>

		<<forestsearch>>
		<br><br>

		숲을 떠나기
		<br>
		<<danubeicon>><<link [[다뉴브 가 (0:10)|Danube Street]]>><<pass 10>><<set $foresthunt to 0>><</link>>
		<br>
		<<wolficon>><<link [[울프 가 (0:10)|Wolf Street]]>><<pass 10>><<set $foresthunt to 0>><</link>>
		<br>
		<<nightingaleicon>><<link [[나이팅게일 가 (0:10)|Nightingale Street]]>><<pass 10>><<set $foresthunt to 0>><</link>>
		<br>
		<<if $temple_rank isnot undefined and $temple_rank isnot "prospective">>
			<<templeicon "garden">><<link [[신전 정원 (0:10)|Temple Garden]]>><<pass 10>><<set $foresthunt to 0>><</link>>
			<br>
		<</if>>
		<br><br>

		<<if $historytrait gte 2 and $thicket_tunnel_intro is 1>>
			<<foresticon "bush">><<link [[비밀 통로를 통해 거주 지구 골목으로 가기 (0:05)|Residential Thicket]]>><<pass 5>><<set $foresthunt to 0>><</link>>
			<br>
		<</if>>
		<<if $historytrait gte 3>>
			<<forestroadicon "secret">>
			<<link [[비밀 통로를 따라 숲 더 깊은 곳으로 가기 (0:10)|Forest]]>>
				<<set $forestmod to 1.5>><<set $forest += 50>><<set $forestmove to "secretin">><<pass 10>>
				<<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>>
				<<if $forestHunter is "Gwylan" and $foresthunt gte 1>><<set $foresthunt += 5>><</if>>
			<</link>>
			<br>
		<</if>>
	<</if>>

<<elseif $forest lte 20>>

	<<if $eventskip is 0>>
		<<rng>>
		<<if $rng gte 81 or ($forest_search is true and $rng gte 61)>>
			<<eventforestitem>>
		<<elseif dangerEvent($forestmod)>>
			<<eventforestoutskirts>>
		<<else>>
			<<eventforestsafe>>
		<</if>>
	<<elseif $eventskip gte 1>>
		숲속이다. 나무가 꽤 듬성듬성한 것을 보니, 마을에서 그리 멀리 떨어지지 않은 것 같다.
		<br><br>

		<<if $forest gte 10 and $forest lte 14>>
			<<foresticon "churchyard">><<link [[오래된 교회 묘지 (0:05)|Churchyard]]>><<pass 5>><</link>>
			<br><br>
		<</if>>

		<<if $smuggler_location is "forest" and $smuggler_timer is 0 and Time.dayState is "night" and Time.hour gte 18>>
			<span class="gold">나무들 사이로 무언가 깜빡이는 것이 보인다. 불꽃 같다.</span>
			<br><br>
		<</if>>

		<<if $smuggler_location is "forest" and $smuggler_timer is 0 and Time.dayState is "night" and Time.hour gte 18>>
			<<link [[불꽃에 접근하기|Smuggler Forest]]>><</link>>
			<br><br>
		<</if>>

		<<forestdeeper>>
		<br><br>

		<<forestsearch>>
		<br><br>

		<<forestlessdeep>>
	<</if>>

<<elseif $forest lte 50>>

	<<if $eventskip is 0>>
		<<rng>>
		<<if $rng gte 81 or ($forest_search is true and $rng gte 61)>>
			<<eventforestitem>>
		<<elseif dangerEvent($forestmod)>>
			<<eventforest>>
		<<else>>
			<<eventforestsafe>>
		<</if>>
	<<elseif $eventskip gte 1>>
		숲속이다. 사방이 자연으로 둘러싸여 있다.
		<br><br>

		<<if $forest lte 30>>
			<<if $nextPassageCheck is "Lake Shore">>
				<span class="nextLink"><<lakeicon>><<link [[호수.|Lake Shore]]>><<pass 10>><</link>></span>
			<<else>>
				<<lakeicon>><<link [[호수 (0:10)|Lake Shore]]>><<pass 10>><</link>>
			<</if>>
		<<elseif $forest lte 40>>
			<<lakeicon>><<link [[호수 (0:10)|Lake Waterfall]]>><<pass 10>><</link>>
		<<else>>
			<<if $nextPassageCheck is "Lake Fishing Rock">>
				<span class="nextLink"><<lakeicon>><<link [[호수.|Lake Fishing Rock]]>><<pass 10>><</link>></span>
			<<else>>
				<<lakeicon>><<link [[호수 (0:10)|Lake Fishing Rock]]>><<pass 10>><</link>>
			<</if>>
		<</if>>
		<br><br>

		<<forestdeeper>>
		<br><br>

		<<forestsearch>>
		<br><br>

		<<forestlessdeep>>
		<br><br>

		<<if $historytrait gte 3>>
			<<forestroadicon "secret">>
			<<link [[비밀 통로를 이용해 숲 밖으로 나가기 (0:10)|Forest]]>>
				<<set $forestmod to 1.5>><<set $forest -= 50>><<set $forestmove to "secretout">><<pass 10>>
				<<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>>
				<<if $forestHunter is "Gwylan" and $foresthunt gte 1>><<set $foresthunt += 5>><</if>>
			<</link>>
			<br>
		<</if>>
	<</if>>

<<elseif $forest lte 99>>

	<<if $eventskip is 0>>
		<<rng>>
		<<if $rng gte 81 or ($forest_search is true and $rng gte 61)>>
			<<eventforestitem>>
		<<elseif dangerEvent($forestmod)>>
			<<eventforestdeep>>
		<<else>>
			<<eventforestsafe>>
		<</if>>
	<<elseif $eventskip gte 1>>
		숲 깊은 곳이다. 나무들은 높고 어두우며, 그 가지들이 서로 뒤엉켜 숲의 지붕을 이룬다.
		<br><br>
		<<if $edenfreedom gte 1 or $syndromeeden gte 1>>
			<<if $edenFluidsCheck is "cleanLeave" and ($goocount + $semencount gte 10) and Time.hour gte 7 or $edenFluidsCheck is "run">>
				<<edenicon>><<link [[에덴의 오두막 (0:10)|Eden Fluids Punishment]]>><<pass 10>><</link>>
			<<elseif !$edenHotSpring and Weather.isFreezing>>
				<<edenicon>><<link [[에덴의 오두막 (0:10)|Eden Hot Spring Creation 1]]>><</link>>
			<<else>>
				<<edenicon>><<link [[에덴의 오두막 (0:10)|Eden Clearing]]>><<pass 10>><</link>>
			<</if>>
			<br>
		<</if>>
		<<if $syndromewolves gte 1>>
			<<if $caveHumanPregnancyDiscovered isnot 1 or !playerIsPregnant()>>
				<<wolfcaveicon "entrance">><<link [[늑대 동굴 (0:10)|Wolf Cave Clearing]]>><<pass 10>><</link>>
				<br>
			<<else>>
				<span class="blue">임신이 끝날 때까지 늑대들이 당신을 받아주지 않을 것입니다.</span>
				<br>
			<</if>>
		<</if>>
		<<if $pubtask is "forest" and $pubtask2 isnot 1>>
			<<rng>>
			<!-- Modified for Monster People -->
			<<if $pubtasksetting is "bear">>
				<<crimeicon "black box">><<link [[랜드리의 블랙박스 찾기|Forest Bear Box]]>><</link>>
			<<elseif $pubtasksetting is "pair">>
				<<crimeicon "black box">><<link [[랜드리의 블랙박스 찾기|Forest Box]]>><</link>>
			<<elseif $rng gte 51>>
				<<crimeicon "black box">><<link [[랜드리의 블랙박스 찾기|Forest Bear Box]]>><</link>>
			<<else>>
				<<crimeicon "black box">><<link [[랜드리의 블랙박스 찾기|Forest Box]]>><</link>>
			<</if>>
			<br>
		<</if>>
		<<if $forest gte 80 and $forest lte 90 and $brookIntro gte 1>>
			<<if $worn.feet.type.includes("heels")>>
				<span class="red">힐을 신고 개울을 따라가는 것은 불가능합니다.</span>
			<<else>>
				<<foresticon "river">><<link [[개울을 따라가기 (0:20)|Forest Brook]]>><<pass 20>><</link>>
			<</if>>
			<br>
		<</if>>
		<br>

		<<forestdeeper>>
		<br><br>

		<<forestsearch>>
		<br><br>

		<<forestlessdeep>>
	<</if>>

<<elseif $forest gte 100>>
	<<if $eventskip is 0>>
		<<rng>>
		<<if $rng gte 81 or ($forest_search is true and $rng gte 61)>>
			<<eventforestitem>>
		<<elseif dangerEvent($forestmod)>>
			<<eventforestdeep>>
		<<else>>
			<<eventforestsafe>>
		<</if>>
	<<elseif $eventskip gte 1>>
		숲 깊은 곳이다. 나무들 사이로 정신병원이 보인다.
		<br><br>

		<<forestsearch>>
		<br><br>

		<<forestlessdeep>>
	<</if>>
<</if>>

<<unset $forest_search>>
<<set $eventskip to 0>>

:: Forest Bear Box
<<location "forest">><<effects>>
<<beastNEWinit 1 bear>>

<<if $pubtasksetting is "bear">>
	랜드리의 검은 상자를 찾을 수 있는 동굴로 돌아왔다. 안에서 거대한 무언가가 숨 쉬는 소리가 들린다.
<<else>>
	<<set $pubtasksetting to "bear">>

	랜드리가 검은 상자를 찾을 수 있을 거라 말했던 동굴에 도착했다. 상자는 분명 안에 있을 것이다.
	<br><br>

	두 걸음도 채 떼기 전에 깊은 으르렁거리는 소리가 들린다. 안에는 커다란 무언가가 있다.
<</if>>
<br><br>

<<if $monster is 1 or $settings.bestialityEnabled>>
	<<getinicon>><<link [[들어간다|Forest Bear Box Molestation]]>><<set $molestationstart to 1>><</link>>
	<br>
<<else>>
	<<getinicon>><<link [[들어간다|Forest Bear Box Molestation Finish]]>><<set $phase to 1>><</link>>
	<br>
<</if>>
<<getouticon>><<link [[떠난다|Forest]]>><<endevent>><</link>>

:: Forest Box
<<location "forest">><<effects>>

<<if $pubtasksetting is "pair">>
	<<generate1>><<generate2>>
	허름한 오두막이 있는 공터로 돌아왔다. <<fullGroup>>【은는】 아직 그곳에 있다.
	"마음이 바뀌었나?" <<person1>><<person>>【이가】 말한다. "네 몸을 우리 마음대로 쓰게 해주면, 검은 상자를 주지."
<<else>>
	<<set $pubtasksetting to "pair">>

	<<generate1>><<generate2>>
	검은 상자가 있다는 공터에 도착했다. 중앙에는 허름한 나무 오두막이 있다.
	<<fullGroup>>【이가】 모닥불 옆에 앉아 있다. 당신이 다가가자 그들이 고개를 든다.
	"이거 의외인데," <<person1>><<person>>【이가】 말한다. "이런 데까지 무슨 일이지?"
	<br><br>

	작은 검은 상자를 찾고 있다고 말한다. "오," <<he>>【이가】 말한다. "이거 말하는 건가?" <<He>>【은는】 일어서서 <<his>> 주머니에서 검은 상자를 꺼낸다.
	"설득만 잘하면 이걸 넘겨줄 수도 있지. 대신 대가가 좀 필요하겠지만." <<He>>【은는】 당신에게 더 가까이 다가온다.
	"귀여운 녀석이네. 랜드리도 사람 보는 눈은 있군. 우리한테 대주면 상자는 주지." <<person2>><<person>>【이가】 히죽거린다.
<</if>>
<br><br>

<<if hasSexStat("promiscuity", 2)>>
	<<link [[받아들인다|Forest Box Molestation]]>><<set $sexstart to 1>><</link>><<promiscuous2>>
	<br>
<</if>>
<<if displayDefiantOption(500)>>
	<<link [[공격한다|Forest Box Molestation]]>><<set $molestationstart to 1>><<set $phase to 2>><<wolfDefiant 500>><</link>><<defianttext 500>>
	<br>
<</if>>
<<link [[거절한다|Forest Box Refuse]]>><</link>>
<br>

:: Forest Bear Box Molestation
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<controlloss>>
	<<violence 1>>
	<<neutral 1>>
	<<molested>>

	<<beastCombatInit>><<set $enemytrust -= 40>><<set $enemyanger += 40>><<set $enemyhealthmax to 400>><<set $enemyhealth to 400>>
