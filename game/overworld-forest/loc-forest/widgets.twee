:: Widgets Forest [widget]
<<widget "forestmove">>
	<<if $possessed>>
		당신은 숲을 가로질러 터덜터덜 걷는다. 당신은 어디로 가고 있는지 알고 있다.
	<<elseif $forestmove is "quickly">>
		당신은 거칠고 나무가 우거진 지형이 허락하는 한 가장 빠르게 움직인다. 잔가지와 부러진 나뭇가지들이 발밑에서 휘어지고 부러진다.
	<<elseif $forestmove is "normally">>
		당신은 나무 사이를 걷는다. 부드러운 소리와 향기가 기분 좋은 여정을 만들어준다.
	<<elseif $forestmove is "carefully">>
		당신은 가능한 한 기척을 내지 않도록 주의하며 덤불 속을 은밀히 지나간다.
	<<elseif $forestmove is "hobble">>
		당신은 넘어지지 않게 조심하며 덤불 사이를 절뚝이며 지나간다.
	<<elseif $forestmove is "secretin">>
		어디를 봐야 할지 몰랐다면 보이지도 않았을 길을 따라 걷는다. 주변으로 나무들이 빽빽이 들어선다. 당신은 숲속 훨씬 깊은 곳으로 들어섰다.
	<<elseif $forestmove is "secretout">>
		어디를 봐야 할지 몰랐다면 보이지도 않았을 길을 따라 걷는다. 이내 저 앞쪽에서 마을 소리가 들려온다. 숲의 가장자리에 가까워졌다.
	<<elseif $forestmove is "quick_search">>
		거칠고 수목이 울창한 지형이 허락하는 한 빠르게 땅에 떨어진 나뭇가지들을 치워가며 아래를 살펴본다.
	<<elseif $forestmove is "normal_search">>
		나무 사이사이에 숨겨진 쓸 만한 물건이 없는지 수색한다.
	<<elseif $forestmove is "careful_search">>
		<<if $forest gte 50>>
			당신은 빽빽한 양치식물 사이에서 가치 있는 것을 찾아보며, 덤불 속을 은밀하게 헤치고 지나간다.
		<<else>>
			당신은 가치 있는 것이 없나 땅바닥을 훑어보며, 덤불 속을 은밀히 지나간다.
		<</if>>
	<<elseif $forestmove is "road">>
		당신은 야생의 위험으로부터 안전한 매끄러운 도로를 따라 걷는다.
	<</if>>
	<<if Weather.precipitation is "rain">>
		나무 위 잎사귀들에 맺혀 있던 굵은 빗방울들이 당신 주위로 떨어진다.
	<</if>>
	<<if $forestmove or $possessed>>
		<br><br>
	<</if>>
<<set $forestmove to 0>>
<</widget>>

<<widget "forestdeeper">>
	숲속으로 더 깊이 들어간다
	<br>
	<<if $worn.feet.type.includes("heels") and !$possessed>>
		<<heelsicon "hobble">><<link [[하이힐을 신고 절뚝인다 (0:30)|Forest]]>><<set $forestmod to 3>><<set $forest += 5>><<pass 30>><<set $forestmove to "hobble">><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>><<gharass>>
		<<if $town_projects.road gte 4 and $forest lte 24>>
			<br>
			<<forestroadicon "deep">><<link [[길을 따라간다 (0:10)|Forest]]>><<set $forestmod to 1>><<set $forest += 5>><<set $forestmove to "road">><<pass 10>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><<set $eventskip to 1>><</link>><<noharass>>
		<</if>>
	<<else>>
		<<if !$worn.feet.type.includes("shackle")>>
			<<runicon>><<link [[빠르게 간다 (0:05)|Forest]]>><<set $forestmod to 3>><<set $forest += 5>><<pass 5>><<set $forestmove to "quickly">><<if $foresthunt gte 1>><<set $foresthunt += 0.5>><</if>><</link>><<gharass>>
			<br>
		<</if>>
		<<if $nextPassageCheck is "Forest Blood Deeper">>
			<span class="nextLink"><<walkicon>><<link [[호수.|Forest Blood Deeper]]>><<set $forestmod to 1.5>><<set $forest += 5>><<set $forestmove to "normally">><</link>></span>
		<<else>>
			<<walkicon>><<link [[평소처럼 걷는다 (0:10)|Forest]]>><<set $forestmod to 1.5>><<set $forest += 5>><<set $forestmove to "normally">><<pass 10>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><</link>>
		<</if>>
		<br>
		<<sneakicon>><<link [[조심스럽게 간다 (0:30)|Forest]]>><<set $forestmod to 1>><<set $forest += 5>><<pass 30>><<set $forestmove to "carefully">><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>><<lharass>>
		<<if $town_projects.road gte 4 and $forest lte 24>>
			<br>
			<<forestroadicon "deep">><<link [[길을 따라간다 (0:05)|Forest]]>><<set $forestmod to 1>><<set $forest += 5>><<set $forestmove to "road">><<pass 5>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><<set $eventskip to 1>><</link>><<noharass>>
		<</if>>
	<</if>>
<</widget>>

<<widget "forestsearch">>
	이 구역을 수색한다 <<gtreasure>>
	<br>
	<<if !$worn.feet.type.includes("shackle")>>
		<<runicon>><<link [[빠르게 (0:05)|Forest]]>><<set $forest_search to true>><<set $forestmod to 3>><<pass 5>><<set $forestmove to "quick_search">><<if $foresthunt gte 1>><<set $foresthunt += 0.5>><</if>><</link>><<gharass>>
		<br>
	<</if>>
	<<walkicon>><<link [[보통 속도로 (0:10)|Forest]]>><<set $forest_search to true>><<set $forestmod to 1.5>><<set $forestmove to "normal_search">><<pass 10>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><</link>>
	<br>
	<<sneakicon>><<link [[조심스럽게 (0:30)|Forest]]>><<set $forest_search to true>><<set $forestmod to 1>><<pass 30>><<set $forestmove to "careful_search">><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>><<lharass>>
<</widget>>

<<widget "forestlessdeep">>
	마을 방향으로 간다
	<br>
	<<if $worn.feet.type.includes("heels") and !$possessed>>
		<<heelsicon "hobble">><<link [[하이힐을 신고 절뚝인다 (0:30)|Forest]]>><<set $forestmod to 3>><<set $forest -= 5>><<pass 30>><<set $forestmove to "hobble">><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>><<gharass>>
		<<if $town_projects.road gte 4 and $forest lte 25 and $forest gte 1>>
			<br>
			<<forestroadicon "town">><<link [[길을 따라간다 (0:10)|Forest]]>><<set $forestmod to 1>><<set $forest -= 5>><<set $forestmove to "road">><<pass 10>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><<set $eventskip to 1>><</link>><<noharass>>
		<</if>>
	<<else>>
		<<if !$worn.feet.type.includes("shackle")>>
			<<runicon>><<link [[빠르게 간다 (0:05)|Forest]]>><<set $forestmod to 3>><<set $forest -= 5>><<pass 5>><<set $forestmove to "quickly">><<if $foresthunt gte 1>><<set $foresthunt += 0.5>><</if>><</link>><<gharass>>
			<br>
		<</if>>
		<<if $nextPassageCheck is "Forest Blood Less Deep">>
			<span class="nextLink"><<walkicon>><<link [[호수.|Forest Blood Less Deep]]>><<set $forestmod to 1.5>><<set $forest -= 5>><<set $forestmove to "normally">><</link>></span>
		<<else>>
			<<walkicon>><<link [[평소처럼 걷는다 (0:10)|Forest]]>><<set $forestmod to 1.5>><<set $forest -= 5>><<set $forestmove to "normally">><<pass 10>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><</link>>
		<</if>>
		<br>
		<<sneakicon>><<link [[조심스럽게 간다 (0:30)|Forest]]>><<set $forestmod to 1>><<set $forest -= 5>><<pass 30>><<set $forestmove to "carefully">><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>><<lharass>>
		<<if $town_projects.road gte 4 and $forest lte 25 and $forest gte 1>>
			<br>
			<<forestroadicon "town">><<link [[길을 따라간다 (0:05)|Forest]]>><<set $forestmod to 1>><<set $forest -= 5>><<set $forestmove to "road">><<pass 5>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><<set $eventskip to 1>><</link>><<noharass>>
		<</if>>
	<</if>>
<</widget>>

<<widget "eventforestoutskirts">>
	<<if $foresthunt lte 0 and npcCanHunt("Ivory Wraith") and $wraith.state and ($wraith.hunt or $wraith.timer gte random(0, 40))>>
		<<wHunt "forest">>
	<<else>>
		<<cleareventpool>>
		<<addinlineevent "forestoutskirts_hikers">>
			<<if numberOfEarSlime() and $earSlime.growth gte 80 - ($earSlime.promiscuity * 10)>>
				앞에서 두 사람의 소리가 들린다, 당신이 걷는 것과 같은 오솔길 위다.
				<br><br>

				<span class="lewd">당신은 머릿속의 귀 슬라임이 두 사람에게 몸을 맡기라고 명령하는 것을 느낀다.</span> 그것은 복종하면 보상을 주겠다고 약속하고, 따르지 않으면 대가를 치를 것이라며 협박한다.
				<br><br>

				<<if hasSexStat("promiscuity", 4) and $submissive gte 1900>>
					<<link [[자진해서 복종한다|Forest Slime Pair Submit willingly]]>><<corruption 3>><<pain -8>><<stress -12>><<trauma -24>><<sub 2>><</link>><<promiscuous4>><<ggcorruption>><<llpain>><<llltrauma>><<llstress>>
					<br>
				<</if>>
				<<link [[복종한다|Forest Slime Pair Obey]]>><<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 2>><</link>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
				<br>
				<<link [[저항한다|Forest Slime Pair Defy]]>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>><</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
				<br>

			<<else>>
				<<if $exposed is 1>>
					앞에서 두 사람의 소리가 들린다, 당신이 걷는 것과 같은 오솔길 위다.

					<<if hasSexStat("exhibitionism", 3)>>
						자신의 <<lewdness>> 상태를 내려다보자 음탕한 전율이 온몸을 휘감는다. 그들이 당신을 본다 해도 그리 나쁘지 않을지도 모른다.
						<br><br>

						<<rng>>
						<<if $rng gte 61>>
							<<link [[오솔길을 계속 걷는다|Forest Molestation]]>><<set $molestationstart to 1>><</link>><<exhibitionist3>>
							<br>
						<<else>>
							<<link [[오솔길을 계속 걷는다|Forest Avoid]]>><<set $phase to 2>><</link>><<exhibitionist3>>
							<br>
						<</if>>
						<<link [[그들을 피한다 (0:20)|Forest Avoid]]>><<set $phase to 0>><<set $eventskip to 1>><<pass 20>><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>>
					<<else>>
						자신의 <<lewdness>> 상태를 내려다보자 불안감이 밀려온다. 오솔길을 벗어나지 않으면 들키고 말 것이다.
						<br><br>

						<<link [[그들을 피한다 (0:20)|Forest Avoid]]>><<set $phase to 0>><<set $eventskip to 1>><<pass 20>><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>>
					<</if>>
				<<elseif $exposed gte 2>>

					앞에서 두 사람의 소리가 들린다, 당신이 걷는 것과 같은 오솔길 위다.
					<<rng>>
					<<if hasSexStat("exhibitionism", 5)>>
						자신의 <<lewdness>> 상태를 내려다보자 음탕한 전율이 온몸을 휘감는다. 그들이 당신을 본다 해도 그리 나쁘지 않을지도 모른다.
						<br><br>

						<<if $rng gte 41>>
							<<link [[오솔길을 계속 걷는다|Forest Molestation]]>><<set $molestationstart to 1>><</link>><<exhibitionist5>>
							<br>
						<<else>>
							<<link [[오솔길을 계속 걷는다|Forest Avoid]]>><<set $phase to 3>><</link>><<exhibitionist5>>
							<br>
						<</if>>
						<<link [[그들을 피한다 (0:20)|Forest Avoid]]>><<set $phase to 0>><<set $eventskip to 1>><<pass 20>><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>>
					<<else>>
						자신의 <<lewdness>> 상태를 내려다보자 불안감이 밀려온다. 오솔길을 벗어나지 않으면 들키고 말 것이다.
						<br><br>

						<<link [[그들을 피한다 (0:20)|Forest Avoid]]>><<set $phase to 0>><<set $eventskip to 1>><<pass 20>><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>>
					<</if>>
				<<else>>
					앞에서 두 사람의 소리가 들린다, 당신이 걷는 것과 같은 오솔길 위다. 어쩐지 그들에게서 긴장감이 느껴진다.
					<br><br>

					<<link [[그들을 피한다 (0:20)|Forest Avoid]]>><<set $phase to 0>><<pass 20>><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><</link>>
					<br>
					<<rng>>
					<<if $rng gte 81>>
						<<link [[오솔길을 계속 걷는다|Forest Molestation]]>><<set $molestationstart to 1>><</link>>
						<br>
					<<else>>
						<<link [[오솔길을 계속 걷는다|Forest Avoid]]>><<set $phase to 1>><</link>>
						<br>
					<</if>>
				<</if>>
			<</if>>
		<</addinlineevent>>
		<<addevent "forestwolfspy">>
		<<addevent "forestwolf" 0.33>>
		<<addinlineevent "forestoutskirts_safeperson">>
			<<if Time.dayState is "night">>
				<<generate1>><<person1>>
				당신은 나무 사이로 나무에 기대어 담배를 피우고 있는 <<person>>【을를】 본다.

				<<if $exposed gte 1>>
					자신의 <<lewdness>> 상태를 보이고 싶지 않은 당신은 다른 길을 따라간다.
					<<gstress>><<stress 6>>
				<<else>>
					<<He>>【은는】 당신이 지나갈 때 당신을 힐끗 보지만, 아무 말도 하지 않는다.
				<</if>>
				<br><br>

				<<endevent>>
				<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
			<<else>>
				<<generate1>><<person1>>
				당신은 나무 사이로 가시덤불 속에 손을 뻗고 있는 <<person>>【을를】 본다. <<He>>【은는】 한쪽 손에 산딸기가 가득 담긴 바구니를 들고 있다.

				<<if $exposed gte 1>>
					자신의 <<lewdness>> 상태를 보이고 싶지 않은 당신은 더 깊은 길을 따라간다.
					<<gstress>><<stress 6>>
				<<else>>
					<<He>>【은는】 당신을 보자 손을 흔들고, 당신도 마주 흔들어준다.
					<<ltrauma>><<trauma -6>>
				<</if>>
				<br><br>

				<<endevent>>
				<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
				<br>
			<</if>>
		<</addinlineevent>>
		<<addevent "forestrock" 0.33>>
		<<addinlineevent "forestoutskirts_treebranch">>
			당신은 덤불을 헤치며 나아간다.
			<<set $stripintegrity to 10>><<set $stripobject to "나뭇가지">><<stripobject>>
			<br><br>

			<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<</addinlineevent>>

		<<if $hypnosis_traits.devotion>>
			<<addevent "forestcurious" 0.33>>
			<<addevent "forestcharms" 0.15>>
		<</if>>
		<<if $foresthunt lte 0 and npcCanHunt("Gwylan")>>
			<<set $_gwylanHuntChance to $gwylan?.hunting || 1>>
			<<addinlineevent "forestgwylanhunt" $_gwylanHuntChance>>
				/* Gwylan uses unique hunt start chance in shallow forest. */
				<<foresthuntstart "Gwylan">>
			<</addinlineevent>>
		<</if>>
		<<if $foresthunt lte 0 and ($hypnosis_traits.devotion gte 2 or $fox gte 6 or $wolfgirl gte 6 or $dryad gte 6) and $gwylan?.ritualMissed and !$weekly.gwylanNoLure>>
			<<if npcCanHunt("Gwylan") and ["garden", "shop"].includes(gwylanSchedule()) and !Time.isBloodMoon()>>
				<<set _lureChance to ($hypnosis_traits.devotion / 2) || 0.5>>
				<<addevent "forestgwylanlure" _lureChance>>
			<</if>>
		<<elseif $foresthunt lte 0 and !$weekly.forestLullaby and ["garden", "shop"].includes(gwylanSchedule()) and (!$gwylanSeen?.includes("ritual_beast") or $gwylan?.ritualMissed)>>
			<<addinlineevent "forestlullaby" 0.2>>
				<<set $weekly.forestLullaby to true>>
				멀리서 노랫소리가 들린다. 어렴풋하지만,
				<<if $islander_language gte 100>>
					섬 주민들의 말과 비슷하게 들린다. 당신은 '친애하는 동족이여,' 와 '잠들라,' 와 같은 몇몇 단어만 간신히 알아듣는다.
				<<else>>
					어쩐지 다른 언어로 부르는 것 같다.
				<</if>>
				<br><br>

				<<if $gwylanSeen?.includes("ritual_beast")>>
					잠시 귀를 기울인 후, 그것이 그윌란의 목소리 같다는 것을 깨닫는다.
				<<else>>
					그 선율은 마음을 사로잡으며, <span class="teal">어렴풋이 낯이 익다</span>.
				<</if>>
				당신의 몸과 마음이 이완되는 것을 느낀다. <<stress -3>><<trauma -3>><<lstress>><<ltrauma>>
				<br><br>

				<<link [[다음|Forest]]>><<endevent>><<set $eventskip to 1>><</link>>
				<br>
			<</addinlineevent>>
		<</if>>
		<<if !$daily.gwylan.spy and ["garden", "shop"].includes(gwylanSchedule())>>
			<<addinlineevent "forestgwylanspy" 0.2>>
				<<set $daily.gwylan.spy to true>>
				<<run statusCheck("Gwylan")>>
				당신은 날카로운 시선이 꽂히는 것을 느낀다. 고개를 들어 확인해본다. 어쩌면
				<<if $syndromeeden gte 1 and $syndromewolves gte 1>>
					에덴이나 검은 늑대,
				<<elseif $syndromeeden gte 1>>
					에덴,
				<<elseif $syndromewolves gte 1>>
					검은 늑대,
				<<else>>
					어떤 동물일 수도 있다고 생각했지만,
				<</if>>
				<<if !$gwylanSeen or $hallucinations gte 2 and random(1, 4) is 1 or isGwylanAbsent()>>
					그 대신 잎사귀 너머로 세 개의 녹색 눈동자가 당신을 노려보고 있다. 눈이 마주친 순간, 시선 너머의 생물은 재빨리 달아나 버린다. <<stress 12>><<ggstress>>
				<<else>>
					<<npc Gwylan>><<person1>>
					그 대신 그윌란을 보게 된다.
					<<set _gwylanBeingWeirdChance to 1 + $gwylanSeen.count("ritual_sex") + $gwylanSeen.count("yearning") + $gwylanSeen.count("partners") + $gwylanSeen.count("romance")>>
					<<if _gwylanBeingWeirdChance gte random(1, 7) or $forestHunter is "Gwylan">>
						<<He>>【은는】 멍한 표정으로 당신을 지켜보고 있다. <<He>>【은는】 호기심에 고개를 갸웃거리더니, 뒷걸음질 치며 마치 숲의 일부인 것처럼 나무 사이로 사라진다. <<stress 3>><<gstress>>
					<<else>>
						<<He>>【은는】 산딸기와 약초가 가득 담긴 바구니를 들고 있다. <<He>>【은는】 당신을 향해 미소 지으며 손을 흔들고는, 숲의 경계 너머로 사라진다. <<stress -1>><<lstress>>
						<<if $hypnosis_traits.devotion gte 3>>
							<<arousal 500>><<garousal>>
						<</if>>
					<</if>>
				<</if>>
				<br><br>

				<<link [[다음|Forest]]>><<endevent>><<set $eventskip to 1>><</link>>
				<br>
			<</addinlineevent>>
		<</if>>
		<<runeventpool>>
	<</if>>
<</widget>>

<<widget "eventforest">>
	<<if $foresthunt lte 0 and npcCanHunt("Ivory Wraith") and $wraith.state and ($wraith.hunt or $wraith.timer gte random(0, 40))>>
		<<wHunt "forest">>
	<<elseif $foresthunt lte 0 and random(1, 12) is 1 and npcCanHunt("forest trio")>>
		/* 1 in 12 gives a 5% trigger rate when searching at max allure (given the 60% chance of calling eventforest).
		 * Not part of the eventpool, as having a fixed percent chance simplifies game balancing.
		 * This way, adding new encounters to this event pool won't reduce the risk of being hunted.
		 * Also, players don't get punished with an increased hunt rate if they disable some encounter types.
		 */
		<<foresthuntstart>>
	<<else>>
		<<cleareventpool>>
		<<outfitChecks>>
		<<addevent "forestwolfspy" 0.25>>
		<<addevent "forestboar" 0.20>>
		<<if _bottomless is false>>
			<<addevent "ForestBullies" 0.20>>
		<</if>>
		<<addevent "forestwolf" 0.33>>
		<<addevent "forestbear" 0.15>>
		<<addevent "forestrock" 0.25>>
		<<addinlineevent "forest_clothingdamage">>
			당신은 덤불을 헤치며 나아간다.
			<<set $stripintegrity to 10>><<set $stripobject to "나뭇가지">><<stripobject>>
			<br><br>

			<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<</addinlineevent>>
		<<addevent "forestcutter" 0.15>>
		<<set _forestNestUnsafe to true>>
		<<addevent "forest_nest" 0.15>>
		<<if $fox_grudge>>
			<<addevent "fox_grudge" 0.33>>
		<</if>>
		<<if $hypnosis_traits.devotion>>
			<<addevent "forestcurious" 0.15>>
		<</if>>
		<<if Weather.isSnow>>
			<<addevent "forestsnow" 0.33>>
		<</if>>
		<<if $foresthunt lte 0 and ($hypnosis_traits.devotion gte 2 or $fox gte 6 or $wolfgirl gte 6 or $dryad gte 6) and $gwylan?.ritualMissed and !$weekly.gwylanNoLure>>
			<<if npcCanHunt("Gwylan") and ["garden", "shop"].includes(gwylanSchedule()) and !Time.isBloodMoon()>>
				<<set _lureChance to ($hypnosis_traits.devotion / 3) || 0.3>>
				<<addevent "forestgwylanlure" _lureChance>>
			<</if>>
		<</if>>
		<<runeventpool>>
	<</if>>
<</widget>>

<<widget "eventforestdeep">>
	<<if $foresthunt lte 0 and npcCanHunt("Ivory Wraith") and $wraith.state and ($wraith.hunt or $wraith.timer gte random(0, 20))>>
		<<wHunt "forest">>
	<<elseif $foresthunt lte 0 and random(1, 6) is 1 and npcCanHunt("forest trio")>>
		/* 1 in 6 gives a 10% trigger rate when searching at max allure (given a 60% chance of calling eventforestdeep).
		 * Not in eventpool: see eventforest.
		 */
		<<foresthuntstart>>
	<<else>>
		<<cleareventpool>>
		<<addevent "forestwolfspy2">>
		<<addinlineevent "deepforest_wolf2">>
			<<beastNEWinit 2 wolf>>
			한 쌍의
			<<if ($monster isnot 1) or ($NPCList[0].pronoun is "m" and $NPCList[1].pronoun is "m") or ($NPCList[0].pronoun is "f" and $NPCList[1].pronoun is "f")>>
				<<beastsplural>>
			<<else>>
				남녀 늑대인간들이
			<</if>>
			이빨을 드러내며 나무 사이에서 나타난다.
			<<if $monster is 1>>
				"찾았다," 하나가 짖듯이 말한다. "수적 열세군. 넌 이제 우리 거다."
			<</if>>
			<br><br>

			<!-- Modified for monster people -->
			<<if $monster is 1 or $settings.bestialityEnabled>>
				<<link [[다음|Forest Wolf2]]>><<set $molestationstart to 1>><</link>>
				<br>
			<<else>>
				그들은 숲 속으로 당신을 쫓아온다. 당신은 등 뒤에서 그들의 소리가 더 이상 들리지 않을 때까지 달린다. 당신이 그들을 따돌린 것인지 그들이 지루해진 것인지 확신할 수 없다.
				<<physique 2>><<beastescape>><<gtiredness>><<tiredness 8>><<gathletics>><<athletics 4>>
				<br><br>

				<<link [[다음 (0:20)|Forest]]>><<pass 20>><<endevent>><<set $eventskip to 1>><</link>>
			<</if>>
		<</addinlineevent>>
		<<if $settings.voreEnabled and $settings.bestialityEnabled>>
			<<addevent "forestsnake" 0.33>>
		<</if>>
		<<addevent "forestbear">>
		<<if $settings.tentaclesEnabled and $settings.voreEnabled and ($hallucinations gte 2 or $backgroundTraits.includes("plantlover"))>>
			<<addinlineevent "deepforest_slimecontrol">>
				당신은 빽빽한 덤불을 뚫고 걷는다. 공기 중에는 꽃가루가 짙게 퍼져 있지만, 꽃은 보이지 않는다. 머리가 어지러워지기 시작한 당신은 나무 기둥에 몸을 기댄다. 하얀 안개가 공기 중에 맴돈다.
				<br><br>
				<<if numberOfEarSlime() and $earSlime.growth gte 50>>
					<span class="lewd">당신은 머릿속의 슬라임이 특정 방향으로 계속 나아가라고 명령하는 것을 느낀다.</span> 그것은 복종하면 보상을 주겠다고 약속하고, 따르지 않으면 대가를 치를 것이라며 협박한다.
					<br><br>

					<<link [[복종한다|Forest Pitcher Slime Obey]]>><<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 1>><<set $slimeObey to true>><</link>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
					<br>
					<<link [[저항한다|Forest Pitcher Slime Defy]]>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>><</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
					<br>
				<<else>>
					<<link [[이 느낌이 가라앉을 때까지 몸을 추스른다 (0:30)|Forest Pitcher Wait]]>><<pass 30>><<arousal 1200>><<drugs 30>><</link>><<ggarousal>>
					<br>
					<<link [[계속 나아간다|Forest Pitcher Ignore]]>><</link>><<willpowerdifficulty 1 $willpowermax>>
					<br>
					<<link [[굴복한다|Forest Pitcher Give In]]>><<arousal 500>><<drugs 20>><</link>><<garousal>>
					<br>
				<</if>>
			<</addinlineevent>>
		<</if>>
		<<if $settings.plantsEnabled and $settings.tentaclesEnabled and ($hallucinations gte 2 or $backgroundTraits.includes("plantlover"))>>
			<<addevent "forestplant_kiss">>
			<<addevent "forestplant_snare">>
			<<addinlineevent "deepforest_roots">>
				무언가가 당신의 발목을 쥐어잡아, 발이 걸려 넘어진다. 뒤를 돌아보니 나무뿌리가 당신을 칭칭 감고 있다. 덤불 속에서 다른 여러 뿌리들도 뱀처럼 꿈틀대며 다가온다.
				<br><br>

				<<link [[발버둥친다|Forest Tentacles]]>><<set $molestationstart to 1>><</link>>
				<br>
				<<if hasSexStat("deviancy", 5)>>
					<<link [[그들이 당신을 감싸게 둔다|Forest Tentacles]]>><<set $molestationstart to 2>><</link>><<deviant5>>
				<</if>>
			<</addinlineevent>>
		<</if>>
		<<addevent "forestrock">>
		<<if $settings.bestialityEnabled and $settings.waspsEnabled>>
			<<addevent "forestwasps">>
		<</if>>
		<<addinlineevent "deepforest_clothingdamage">>
			당신은 덤불을 헤치며 나아간다.
			<<set $stripintegrity to 10>><<set $stripobject to "나뭇가지">><<stripobject>>
			<br><br>

			<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<</addinlineevent>>
		<<set _forestNestUnsafe to true>>
		<<addevent "forest_nest">>
		<<if $fox_grudge>>
			<<addevent "fox_grudge" 0.33>>
		<</if>>
		<<if Weather.isSnow>>
			<<addevent "forestsnow" 0.5>>
		<</if>>
		<<runeventpool>>
	<</if>>
<</widget>>

<<widget "eventforestsafe">>
	<<cleareventpool>>
	<<if playerRutMinArousal()>>
		<<addinlineevent "safeforest_wolfhowl_rut">>
			멀리서 늑대 울음소리가 들린다. 깊고 웅장한 소리다.
			<<if $wolfgirl gte 3>>
				그것은 당신의 몸속 깊은 원초적인 무언가를 뒤흔든다. 당신은 당장이라도 그 부름에 답하고 싶어 미칠 지경이다.
				<<garousal>><<arousal 1000>>
			<<elseif $sciencetrait gte 3 and $awareness gte 100>>
				당신은 시리스에게 이 지역 종의 러트와 발정기에 대해 배웠던 것을 기억해 낸다. 지체하지 않는 편이 좋다.
				<<gstress>><<stress 10>>
			<<else>>
				이유는 모르겠지만 늑대들의 소리가 평소와 다르게 들린다고 생각한다.
				<<gstress>><<stress 1>>
			<</if>>
			<br><br>

			<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
			<br>
		<</addinlineevent>>
	<<else>>
		<<addinlineevent "safeforest_wolfhowl">>
			멀리서 늑대 울음소리가 들린다.
			<<if $wolfgirl gte 3>>
				<<garousal>><<arousal 600>>
			<<else>>
				<<gstress>><<stress 1>>
			<</if>>
			<br><br>

			<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
			<br>
		<</addinlineevent>>
	<</if>>
	<<addinlineevent "safeforest_easytrail" 0.33>>
		당신은 걷기 한결 수월한 오솔길을 찾아낸다.
		<<lstress>><<stress -2>>
		<br><br>

		<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<br>
	<</addinlineevent>>
	<<addinlineevent "event_ambient">>
		<<eventAmbient>>
		<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<br>
	<</addinlineevent>>
	<<if $forest lte 60>>
		<<addevent "forestriver" 0.33>>
	<<else>>
		<<addinlineevent "safeforest_deer" 0.33>>
			공터에 들어서자 산들바람이 당신의 얼굴을 스친다. 그 한가운데 사슴 한 마리가 서 있다. 사슴은 당신을 알아차리고 먹이 먹는 것을 멈추지만, 달아나지는 않는다.
			<br><br>

			<<link [[다가간다|Forest Deer]]>><</link>>
			<br>
			<<link [[무시한다|Forest]]>><<set $eventskip to 1>><</link>>
			<br>
		<</addinlineevent>>
	<</if>>
	<<if $hairlength gte 1000>>
		<<addinlineevent "foresthairstuck" 1>>
			툭 튀어나온 나뭇가지들을 지나친다. 그 순간, 머리카락이 거세게 당겨지는 느낌이 든다. 뒤를 돌아보니 머리카락 한 가닥이 잔가지에 단단히 휘감겨 있다.<<pain 3>><<gpain>>
			<br><br>
			잠시 시간을 들여 나무에서 머리카락을 풀어낸 뒤 다시 길을 나선다.
			<br><br>

			<<link [[다음|Forest]]>><<set $eventskip to 1>><<pass 5>><</link>>
			<br>
		<</addinlineevent>>
	<</if>>
	<<if $halloween is 1 and Time.monthDay is 31 and !$halloween_lake>>
		<<addevent "halloween_lake_invite" 1000>>
	<</if>>
	<<if $asylum_tunnels gte 6 and Time.dayState is "night" and $forest gte 21>>
		<<addevent "forest_eyes" 0.15>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "eventforestitem">>
	<<rng>>
	<<if $rng lte 25>>
		/* Not part of the eventpool, as having a fixed percent chance simplifies game balancing.
		 * This way, adding new encounters and items to the event pool won't change the difficulty of
		 * mushroom-hunting between game versions.
		 * Similarly, players modifying their toggles (eg the bees toggle, here) won't affect the mushroom drop rate.
		 *
		 * Note that other items in the pool will still be affected: so within the event pool,
		 * the forest gem drop chance is 1:11 because of the bees event, while
		 * the dagger and arrow are 1:7 as the bee event is not in their eventpool.
		 * Multiplying that by 0.75 (not a mushroom) and 0.4 (searching), the overall chance
		 * of getting a museum item each time you search is 2.7% in the deep forest, 4.3% elsewhere.
		 */
		<<mushroompick>>
		<<exit>>
	<</if>>
	<<cleareventpool>>
	/* To calculate the overall odds of getting these when searching or walking, multiply by:
	 * 0.75% (not a mushroom) * (0.2 for walking or 0.4 for searching) * odds within the event pool*/
	<<addevent "forestgather" 4>>
	<<addevent "forest_nest" 1>>
	<<if $forest lte 20>>
		<<addevent "forestarrow" 2>>
	<<elseif $forest lte 50>>
		<<addevent "forestdagger" 2>>
	<<else>>
		<<addevent "forestgem" 2>>
		<<addinlineevent "eventforestitem_bees" 4>>
			<<if $settings.bestialityEnabled and $settings.beesEnabled>>
				앞에서 부드러운 윙윙거리는 소리가 들린다. 커다란 벌집이 나무에 매달려 있다. 일벌들이 꽃가루를 찾아 안팎으로 날아다닌다. 꿀은 꽤 가치가 있을 것이다.
				<br><br>

				<<if currentSkillValue('tending') gte 800>>
					<<if pcAreArmsBound("both")>>
						<span class="red">두 팔이 모두 묶여 있어</span>, 벌집을 채집할 수 없다.
					<<else>>
						<<foodstufficon "wild_honeycomb">><<link [[벌집을 캔다 (0:20)|Forest Honey Pick]]>><<pass 20>><</link>><<tendingdifficulty 800 1100>>
					<</if>>
					<br>
				<<else>>
					<span class="blue">야생 벌집을 캐려면 더 높은 관리 스킬이 필요하다.</span>
					<br>
				<</if>>
				<<getouticon>><<link [[떠난다|Forest]]>><<set $eventskip to 1>><</link>>
				<br>
			<<else>>
				/* This event must exist whether or not $beedisable, so changing toggles won't affect drop rates. */
				당신은 쓰러진 나무를 넘어가기 위해 잠시 멈췄다가, 다시 아무 일 없이 계속 나아간다.
				<br><br>
				<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
			<</if>>
			<</addinlineevent>>
	<</if>>
	<<runeventpool>>
<</widget>>

<<widget "forestwolfspy">>
	양치식물 밑의 어둠 속에서 두 눈이 빤히 쳐다본다.
	<<gstress>><<stress 6>>
	<br><br>

	<<beastNEWinit 1 wolf>>
	<!-- Modified for monster people -->
	<<if numberOfEarSlime() and ($settings.bestialityEnabled or $monster is 1) and ($earSlime.growth gte 80 - ($earSlime.deviancy * 10))>>
		<span class="lewd">머릿속 슬라임이 네 발로 엎드리라고 명령하는 것이 느껴진다.</span> 순순히 따르면 보상을 주겠다고 약속하고, 따르지 않으면 대가를 치르게 하겠다고 협박한다.
		<br><br>

		<<if hasSexStat("deviancy", 4) and $submissive gte 1900>>
			<<link [[자진해서 복종한다|Forest Slime Wolf Submit willingly]]>><<corruption 3>><<pain -8>><<stress -12>><<trauma -24>><<sub 2>><</link>><<deviant4>><<ggcorruption>><<llpain>><<llltrauma>><<llstress>>
			<br>
		<</if>>
		<<link [[순종한다|Forest Slime Wolf Obey]]>><<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 1>><</link>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
		<br>
		<<link [[반항한다|Forest Slime Wolf Defy]]>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>><</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
		<br>

	<<else>>
		<<if hasSexStat("deviancy", 2) and ($settings.bestialityEnabled or $monster is 1)>>
			<<link [[교미 자세를 취한다|Forest Wolf Mate]]>><</link>><<deviant2>>
			<br>
		<</if>>
		<<if $wolfgirl gte 6>>
			<<link [[울부짖는다|Forest Howl]]>><<endevent>><<stress -12>><<trauma -6>><<set $phase to 0>><</link>><<ltrauma>><<lstress>><<wolfgirl>>
			<br>
		<</if>>
		<<link [[계속한다|Forest]]>><<endevent>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><<set $eventskip to 1>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "forestwolfspy2">>
	나무 사이의 어둠 속에서 두 쌍의 눈이 빤히 쳐다본다.
	<<gstress>><<stress 6>>
	<br><br>

	<<beastNEWinit 2 wolf>>
	<<if hasSexStat("deviancy", 3) and ($settings.bestialityEnabled or $monster is 1)>>
		<<link [[교미 자세를 취한다|Forest Wolf Mate2]]>><</link>><<deviant3>>
		<br>
	<</if>>
	<<if $wolfgirl gte 6>>
		<<link [[울부짖는다|Forest Howl]]>><<endevent>><<stress -12>><<trauma -6>><<set $phase to 1>><</link>><<ltrauma>><<lstress>><<wolfgirl>>
		<br>
	<</if>>
	<<link [[계속한다|Forest]]>><<endevent>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><<set $eventskip to 1>><</link>>
	<br>
<</widget>>

<<widget "forestcutter">>
	<<generate1>><<person1>>
	앞쪽에서 규칙적인 소음이 들린다. 다가가 보니 <<person>>【이가】 나무를 베고 있는 것이 보인다.
	<<if $exposed gte 1>>
		당신은 덤불 뒤에 웅크려 앉아 당신의 <<nudity>>【을를】 가린다.<<print _nudityExtra>>
		<br><br>

		<<if $exposed gte 2>>
			<<if hasSexStat("exhibitionism", 5)>>
				<<link [[<<him>>에게 모습을 보여준다|Forest Cutter Exhibitionism]]>><<set $phase to 2>><</link>><<exhibitionist5>>
				<br>
			<</if>>
		<<else>>
			<<if hasSexStat("exhibitionism", 3)>>
				<<link [[<<him>>에게 모습을 보여준다|Forest Cutter Exhibitionism]]>><<set $phase to 1>><</link>><<exhibitionist3>>
				<br>
			<</if>>
		<</if>>
		<<link [[몰래 돌아간다|Forest]]>><<endevent>><<set $eventskip to 1>><</link>>
		<br>
	<<else>>
		<<He>>【이가】 당신에게 손을 흔든다.
		<br><br>

		<<link [[다가간다|Forest Cutter]]>><</link>>
		<br>
		<<link [[손을 흔들어 답하고 계속 간다|Forest]]>><<stress -12>><<set $eventskip to 1>><<endevent>><</link>><<lstress>>
		<br>
	<</if>>
<</widget>>

<<widget "forestsnake">>
	당신은 나무를 돌자마자 얼굴에서 불과 몇 인치 떨어진 곳에 떠 있는 두 눈과 마주친다. 근육에서 모든 힘이 빠져나가고, 당신은 바닥에 쓰러진다. 뱀이 숲 바닥으로 스르륵 기어간다.
	<<set $trance to 1>>
	<br><br>

	<<link [[다음|Forest Snake]]>><<set $molestationstart to 1>><</link>>
	<br>
<</widget>>

<<widget "ForestBullies">>
	앞쪽 길가에 동급생 무리가 길에서 살짝 벗어나 숨어있는 것을 발견했다. 뭔가 안 좋은 꿍꿍이가 있는 것 같다.
	<br><br>
	<<link [[우회한다 (0:20)|Forest]]>><<pass 20>><<set $eventskip to 1>><</link>>
	<br>
	<<link [[그들을 지나쳐 간다|Forest Bully Walk]]>><</link>>
	<br>
<</widget>>

<<widget "forestboar">>
	<<beastNEWinit 1 boar>><<person1>>
	나뭇가지가 부러지는 소리에 이어 나뭇잎이 바스락거리는 소리와 콧김을 뿜는 소리가 들린다. <<beasttype>>【이가】 빠르게 다가오고 있다.
	<br><br>

	<<if $monster is 1>>
		<<bHe>>【은는】 고사리 덤불을 뚫고 나오면서도 속도를 늦추지 않는다. "내 영역이다," <<bhe>>【이가】 꿀꿀거리더니, 방향을 틀어 속도를 높인다. "침입자!" <<bHe>>【이가】 당신을 향해 똑바로 돌진한다!
	<<else>>
		<<bHe>>【은는】 고사리 덤불을 뚫고 나오면서도 속도를 늦추지 않는다. <<bHe>>【은는】 방향을 틀더니 속도를 높여 당신을 향해 똑바로 돌진한다!
	<</if>>
	<br><br>

	<<if $settings.bestialityEnabled or $monster is 1>>
		<<link [[버틴다|Forest Boar Brace]]>><</link>>
		<br>
		<<link [[피한다|Forest Boar Dodge]]>><</link>><<dancedifficulty 1 600>>
		<br>
	<<else>>
		짐승이 달려오는 경로에서 뛰어올라 피했지만 가시덤불에 착지하고 만다. 짐승은 당신에게 신경 쓰지 않고 숲속으로 질주해 버린다.<<beastescape>>
		<br><br>

		<<link [[다음|Forest]]>><<set $eventskip to 1>><<endevent>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "forestbear">>
	흙에 새로 찍힌 곰 발자국이 보인다.
	<br><br>

	<<beastNEWinit 1 bear>>
	<<if $foresthunt gte 1>>
		당신을 쫓는 무언가가 더 가까이 다가오는 것이 느껴진다.
		<br><br>
	<</if>>

	<<link [[우회한다 (0:30)|Forest]]>><<endevent>><<pass 30>><<if $foresthunt gte 1>><<set $foresthunt += 2>><</if>><<set $eventskip to 1>><</link>>
	<br>
	<!-- Modified for Monster People -->
	<<if random(1, 5) is 5 and ($settings.bestialityEnabled or $monster is 1)>>
		<<link [[무시한다|Forest Bear Molestation]]>><<set $molestationstart to 1>><</link>>
		<br>
	<<else>>
		<<link [[무시한다|Forest]]>><<endevent>><<set $eventskip to 1>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "forestwolf">>
	<<beastNEWinit 1 wolf>>

	<!-- Modified for monster people -->
	외로운 <<beasttype>>【이가】 이빨을 드러낸 채 나무 사이에서 나타난다.
	<<if $monster is 1>>
		<<if $forest lt 50>>
			"찾았다." <<bhe>>【이가】 짖는다. "내 거야."
		<<else>>
			"사냥감. 저항 마라."
		<</if>>
	<</if>>
	<br><br>

	<<if $monster is 1 or $settings.bestialityEnabled>>
		<<link [[다음|Forest Wolf]]>><<set $molestationstart to 1>><</link>>
		<br>
	<<else>>
		그것은 숲속에서 당신을 쫓아온다. 당신은 뒤에서 소리가 들리지 않을 때까지 달린다. 당신이 도망친 건지, 놈이 지루해진 건지는 확실치 않다.
		<<beastescape>><<gtiredness>><<tiredness 4>><<gathletics>><<athletics 2>><<silently>><<physique 1>><</silently>>
		<br><br>

		<<link [[다음 (0:20)|Forest]]>><<pass 20>><<set $eventskip to 1>><<endevent>><</link>>
	<</if>>
<</widget>>

<<widget "forestspider">>
	당신이 작은 골짜기 위를 걸어가던 중 땅이 무너져 내린다. 비탈길을 굴러떨어지자 속이 울렁거린다.
	<<if $rng gte 71 and $settings.spidersEnabled>>
		당신은 갑자기 멈춰선다. 마치 공중에 떠 있는 듯한 느낌이 들어 상황을 파악하는 데 잠시 시간이 걸린다. 움직이려 하지만 움직일 수 없다. 주위를 둘러보고서야 당신은 자신이 <span class="red">거대한 거미줄에 붙잡혀 있다는 것을</span> 깨닫는다.
		<<gtrauma>><<gstress>><<trauma 6>><<stress 6>>
		<br><br>

		거미줄의 다른 곳에서 움직임이 느껴진다. 당신의 위쪽이다. 고개를 들어 올린다. 수많은 눈이 당신을 마주 본다. 거대한 거미가 소름 끼치게 다가온다.
		<br><br>
	<<else>>
		당신은 다치지 않고 바닥에 도착한다. 그렇게 무섭지만 않았다면 꽤 재밌었을지도 모른다.
		<<gstress>>
		<br><br>

		<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "forestrock">>
	<<if $worn.feet.type.includes("naked") or $worn.feet.type.includes("shackle")>>
		당신은 맨발로 딱딱하고 삐죽삐죽한 돌을 밟는다. 많이 아프진 않지만, 그 충격에 중심을 잃고 고사리 덤불 속으로 엎어진다.
		<<gstress>><<gpain>><<stress 6>><<pain 6>>
		<br><br>

		<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<br>
	<<else>>
		이곳의 땅바닥은 딱딱하고 삐죽삐죽 솟아오른 바위들로 덮여 있다. 풀 속에 가려져 눈에 잘 띄지는 않지만, 당신의 $worn.feet.name【이가】 버텨낸다.
		<br><br>

		<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "forestwasps">>
	주변 나무들에서 윙윙거리는 소리가 들린다.
	<<if $settings.analEnabled>>
		소리는 당신의 뒤에서 가장 크게 들리지만, 당신이 돌아보기도 전에 어두운 형태가 숲 지붕에서 튀어나와 당신의 <<bottom>>【으로로】 내려앉는다.
	<<else>>
		두 개의 형태가 숲 지붕에서 떨어져 나와 당신을 향해 날아온다.
	<</if>>
	<br><br>

	<<if hasSexStat("deviancy", 4) and $exposed lt 2>>
		<<link [[옷을 벗는다|Forest Wasps Strip]]>><</link>><<deviant4>>
		<br>
	<</if>>
	<<link [[얼어붙는다|Forest Wasps]]>><<set $struggle_start to 1>><</link>>
	<br>
<</widget>>

<<widget "forestplant_kiss">>
	<<generatePlant1>><<person1>>
	"안녕!" 옆에서 목소리가 들린다. 엉킨 덩굴 덤불 옆에 선 <<person "normal">>【이가】 당신을 향해 명랑하게 손을 흔들고 있다. <<He>>【은는】 <<his>> 머리카락 군데군데에 <<plant_details>>【을를】 달고 있으며, <<he>>【은는】 완전한 알몸 상태이다.
	<<arousal 600>><<garousal>>
	<br><br>

	"너같이 귀여운 애들은 보통 숲속 이렇게 깊은 곳까지 안 들어오는데," <<he>>【이가】 말한다. "이렇게 깊이 들어오면 위험해.
	<<if $liquidoutsidecount gte 25>>
		무사히 잘 왔냐고 물어보고 싶지만..." <<He>>【은는】 당신의 몸을 뒤덮은 음란한 액체들을 위아래로 훑어본다. "그래, 꽤나 즐거운 시간을 보낸 모양이네."
	<<else>>
		"무슨 봉변이라도 당한 게 아니길 바라. 그랬다면 정말 끔찍할 테니까."
	<</if>>
	<br><br>

	<<person "normal">>【은는】 잠시 생각하더니, 이내 미소 짓는다. "저기, 가기 전에 키스라도 한 번 어때? 알잖아, 행운을 빈다는 의미로." <<He>>【은는】 두 눈을 감고 앞으로 몸을 기울이며, 손가락으로 <<his>> 입술을 톡톡 두드린다.
	<br><br>

	<<if $backgroundTraits.includes("plantlover") and $nectar_timer lte 14>>
		<span class="pink"><<he>>【이가】 <<personsimple>>【이】라는 것을 알고 있다. 여기서도 <<his>> 입술에 밴 넥타르 향기를 맡을 수 있다.</span> 심장이 미친 듯이 뛰고, 도무지 생각을 할 수가 없다. <<his>> 넥타르가 필요하다. 그 달콤하고 취할 듯한 넥타르가, 더 많이 필요하다.
		<br><br>

		<<link [[<<him>>에게 키스한다|Forest Plant Kiss]]>><</link>><<promiscuous1>><<kissvirginitywarning>>
		<br>
		<<link [[거절한다|Forest Plant Kiss Refuse]]>><<stress 12>><</link>><<ggstress>>
	<<else>>
		<<link [[<<him>>에게 키스한다|Forest Plant Kiss]]>><</link>><<promiscuous1>><<kissvirginitywarning>>
		<br>
		<<link [[거절한다|Forest Plant Kiss Refuse]]>><</link>>
	<</if>>
<</widget>>

<<widget "forestplant_snare">>
	<<generatePlant1>><<person1>>
	<<if currentSkillValue('skulduggery') gte random(200,700)>>
		당신은 <span class="green">곁눈질로 무언가를 알아채고</span>, 아래를 내려다본다. 땅에는 덩굴로 만들어진 올가미 덫이 숨겨져 있다. 덩굴 한 가닥이 땅을 가로질러 근처 덤불 속으로 이어져 있다.
		<br><br>

		<<link [[그 위를 넘어간다|Forest Plant Snare]]>><<set $phase to 0>><</link>>
		<br>
		<<link [[일부러 그 안에 발을 들인다|Forest Plant Snare]]>><<set $phase to 1>><<control 35>><</link>><<gcontrol>>
	<<else>>
		숲속을 걷고 있는데 <span class="red">올가미 덫이 당신의 다리를 휘감아온다</span>. 그것은 꽉 조여들며 당신을 바닥으로 끌어내리더니, 이내 여러 갈래로 나뉘어 당신의 양 다리를 쩍 벌려버린다. 덩굴로 만들어진 올가미 같다.
		<br><br>

		머리카락에 <<plant_details>>【을를】 달고 <span class="purple">꿈틀거리는 덩굴들을 뒤에 매단 채</span>, 한 <<person "normal">>【이가】 덤불 속에서 당신에게로 달려온다. "잡았다!" <<person>>【은는】 환호성을 지른다. "여섯 시간밖에 안 기다렸는데 말이야. 나 완전 사냥꾼 다 됐네." <<He>>【은는】 입술을 핥고 당신을 향해 다가오며, 손가락을 음란하게 까닥거린다.
		<br><br>

		<<link [[다음|Forest Plant Sex]]>><<set $molestationstart to 1>><<set $leftleg to "bound">><<set $rightleg to "bound">><<set $phase to 1>><</link>>
	<</if>>
<</widget>>

<<widget "forestdagger">>
	<<wearProp "antique dagger">>
	단단한 무언가를 밟았다. 무릎을 꿇고 숲의 잔해 속에서 그것을 꺼낸다. 고대의 단검이다, 닳을 대로 닳아 쓸 수는 없다. 수집가가 돈을 주고 살지도 모른다.
	<br><br>

	<<set $antiquemoney += 40>><<museumAntiqueStatus "antiqueforestdagger" "found">>
	<<link [[다음|Forest]]>><<handheldon>><<set $eventskip to 1>><</link>>
	<br>
<</widget>>

<<widget "forestgem">>
	<<wearProp "antique forest gem">>
	나무 그루터기 밑동에서 무언가 반짝인다. 당겨서 빼낸다. 평온함이 몸을 감싼다.
	<<lstress>><<stress -3>>
	<br><br>

	반투명한 녹색 보석이다. 수집가가 돈을 주고 살지도 모른다.
	<br><br>

	<<set $antiquemoney += 100>><<museumAntiqueStatus "antiqueforestgem" "found">>
	<<link [[다음|Forest]]>><<handheldon>><<set $eventskip to 1>><</link>>
	<br>
<</widget>>

<<widget "forestarrow">>
	<<wearProp "antique arrow">>
	당신은 발밑의 떨어진 나무껍질 사이에서 녹슨 금속 조각을 발견한다. 화살촉이다. 수집가가 돈을 주고 살지도 모른다.
	<br><br>

	<<set $antiquemoney += 20>><<museumAntiqueStatus "antiqueforestarrow" "found">>
	<<link [[다음|Forest]]>><<handheldon>><<set $eventskip to 1>><</link>>
	<br>
<</widget>>

<<widget "foresthuntstart">>
	<<if _args[0] && npcCanHunt(_args[0])>>
		/* Override argument, only use if you're certain the NPC can hunt the player */
		<<set $_hunters to [_args[0]]>>
	<<else>>
		<<set $_hunters to []>>
		<<if npcCanHunt("Eden")>>
			<<set $_hunters.push("Eden")>>
		<</if>>
		<<if npcCanHunt("Black Wolf")>>
			<<set $_hunters.push("Black Wolf")>>
		<</if>>
		<<if npcCanHunt("Ivory Wraith")>>
			<<set $_hunters.push("Ivory Wraith")>>
		<</if>>
		<<if npcCanHunt("Gwylan")>>
			<<set $_hunters.push("Gwylan")>>
		<</if>>
	<</if>>

	<<if $_hunters.length is 0>>
		/* No hunters, meaning the outside case to call foresthuntstart is faulty or npcCanHunt broke. */
		어떤 원초적인 본능이 경고하듯, 등골을 타고 오싹한 기운이 흐른다. <span class="red">무언가가 당신을 사냥하고 있다.</span>
		<br><br>

		...그리고 주위에 당신을 사냥할 자가 없으므로 그 감각은 즉시 사라진다. <span class='red'>이것은 버그입니다. 버그 리포트를 작성해 주세요.</span>
		<br><br>

		<<link [[다음|Forest]]>><<endevent>><<set $eventskip to 1>><</link>>
		<br>
	<<else>>
		/* Pick an available hunter. */
		<<set $forestHunter to $_hunters.pluck()>>
		<<if $forestHunter is "Ivory Wraith">>
			/* Wraith has its own handler for hunt starting. */
			<<wHunt "forest">>
		<<else>>
			/* If the player doesn't have special senses, the hunt will be shorter as it took them longer to realise they were being hunted. */
			<<if !hasSharpSenses()>>
				어떤 원초적인 본능이 경고하듯, 등골을 타고 오싹한 기운이 흐른다. <span class="red">무언가가 당신을 사냥하고 있다.</span>
			<<else>>
				<<if hasSharpSenses("instincts")>>
					당신의 <span class="green"><<= hasSharpSenses("instincts")>></span>【이가】 경고하듯, 등골을 타고 오싹한 기운이 흐른다. <span class="red">무언가가 당신을 사냥하고 있다.</span>
				<<else>>
					어떤 원초적인 본능이 경고하듯, 등골을 타고 오싹한 기운이 흐른다. 당신의 <span class="green"><<= hasSharpSenses()>></span>【은는】 그 징후를 쉽게 잡아낸다. <span class="red">무언가가 당신을 사냥하고 있다.</span>
				<</if>>
			<</if>>
			<br><br>
			<<set $foresthunt to 1>>
			<<if !hasSharpSenses()>>
				<<set $foresthunt += 2>>
			<</if>>
			<<if $forestHunter is "Gwylan">>
				<<run statusCheck("Gwylan")>>
				<<if $gwylan and isGwylanAbsent() isnot "nobody" and $gwylan?.hunting gte 2 and ($islander_language gte 100 or hasSharpSenses())>>
					<<set $gwylan.lureSong to 1>>
				<<elseif $gwylan>>
					<<set $gwylan.lureSong to 0>>
				<</if>>
				<<if $forest lte 25>>
					/* If hunt starts in forest outskirts, Gwylan starts much closer to the player */
					<<set $foresthunt += 3>>
				<<else>>
					<<set $foresthunt += 1>>
				<</if>>
				<<if _gwylanStatus?.includes("heat")>>
					<<set $foresthunt += 1>>
				<</if>>
			<</if>>

			<<link [[다음|Forest]]>><<endevent>><<set $eventskip to 1>><</link>>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "foresthunt">>
	<<set $foresthunt to 0>>
	<<if $wraith.hunt>>
		<<set $wraith.hunt to 0>>
		<<if $location is "forest">>
			<<set $wraith.exit to "forest">>
		<<elseif $location is "lake_ruin">>
			<<set $wraith.exit to "lake_ruin">>
		<<else>>
			<<set $wraith.exit to "lake">>
		<</if>>
		<<wraithCaught>>
	<<elseif $forestHunter is "Black Wolf">>
		<!-- Modified for monster people -->
		<<npc "Black Wolf">>/*<<beastNNPCinit>>*/
		<<if playerNormalPregnancyType() isnot "wolf" and isPregnancyEnding()>>
			검은 늑대가 당신을 향해 달려온다! <<bHe>>【은는】 잠시 당신을 살피더니, 울부짖는다.
			<<if $monster is 1>>
				"인간이 낳기에 좋은 장소 아니다," <<bhe>>【이가】 두려움이 섞인 목소리로 말한다. "와라. 내 털 잡아라. 내가 데려간다."
			<<else>>
