		<</if>>

		<<if _args.includesAny("river","snow")>>
			<<nnpc_He "Gwylan">>【은는】 당신의 팔을 잡고 <<= _args.includes("river") ? "물" : "눈">> 속에서 끌어올린다.
		<</if>>
		/* Prevents towelup when the player has clothes */
		<<silently>><<clotheson>><</silently>>
		<<if $exposed gte 1>>
			<<nnpc_He "Gwylan">>【은는】 당신에게 낡은 수건 몇 장을 건네며, <<if _args.includesAny("river","snow")>>몸을 닦고 <</if>>덮으라고 말한다.<<dry_towel>>
		<</if>>
		<<if $pain gte 50>>
			<<if $gwylanSeen?.includes("partners")>>
				<<nnpc_He "Gwylan">>【은는】 당신의 뺨에 입을 맞춘 뒤 상처 몇 군데를 치료해 준다.
			<<else>>
				<<nnpc_He "Gwylan">>【은는】 멍든 곳을 쓰다듬어 주며 잠시 시간을 보낸다.
			<</if>>
			<<pain -15>>
		<</if>>

		<<if _gwylanFirstRescue is "bear">>
