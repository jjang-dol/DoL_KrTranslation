<<elseif $gwylan.lureDistance lte 0>>
	땅에 기어 들어갈 수 있을 만큼 작은 구멍이 보인다. 구멍은 당신의 눈앞에서 더 넓게 입을 벌린다.
	<br><br>

	<span class="red">당신은 기어 들어간다.</span>
	<br><br>

	<<if $islander_language gte 100>>
		<<for $_s to $gwylan.lureSong; $_s lt 6; $_s++>>
			<<gwylanSong>>
			<br><br>
		<</for>>
	<</if>>
	<<gwylanSong "end">>
	<br><br>

