	<br><br>

	<<link [[다음|Gwylan Ritual Start Forced]]>><<pass $forest>><<set $forest to 0>><<endevent>><<set $phase to "forced">><</link>>
	<br>
<<elseif $enemyarousal gte $enemyarousalmax>>
