	<<gspraymax>><<set $spraymax += 1>><<spray 5>>
	<br><br>
	<span class="gold">후추 스프레이 충전 횟수가 추가로 1회 늘어났습니다.</span>
	<br><br>
<</if>>
<<if $monster is 1>>
