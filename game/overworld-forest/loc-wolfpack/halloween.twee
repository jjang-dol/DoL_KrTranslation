		<<combatTrainAdvance>>
		<br><br>
		<<link [[다음|Wolf Halloween Fight Finish]]>><<set $finish to 1>><</link>>
	<</if>>
<<elseif $enemyarousal gte $enemyarousalmax>>
	<<beastejaculation>>
	<<if $combatTrain.length gt 0>>
