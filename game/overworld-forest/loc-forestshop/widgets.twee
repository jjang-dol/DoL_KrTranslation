<<widget "gwylanStalkInit">>
	<<set $_skillAdded to C.npc.Gwylan.lust + C.npc.Gwylan.dom>>
	<<if $location is "forest">>
		<<set $_skillAdded += 200>>
	<</if>>
	<<set $NPCList[0].skills.security to 600 + $_skillAdded + random(10, 100)>>
	<<set $NPCList[0].skills.athletics to 600 + $_skillAdded + random(10, 100)>>
	<<run statusCheck("Gwylan")>>
	<<if _gwylanStatus.includes("wounded")>>
		<<set $NPCList[0].skills.athletics -= 500>>
	<</if>>
	<<if _gwylanStatus.includesAny("reunion", "heat", "badEndReady") or $gwylan?.hunting gte 2>>
		<<set $NPCList[0].bold to 10000>>
		<<set $combatgoal to "confront">>
	<<elseif $gwylan?.hunting is 1 and ($settings.hypnosisEnabled or $hypnosis_devotion)>>
		<<set $NPCList[0].bold to 10000>>
		<<set $combatgoal to "confront">>
	<<else>>
		<<set $NPCList[0].bold to (($allure / 20) + (C.npc.Gwylan.lust * 2) + (C.npc.Gwylan.dom * 2) + (C.npc.Gwylan.love * 2))>>
	<</if>>
<</widget>>

<<widget "gwylanHuntStart">>
	<<set $huntGame to {
		otherHealth: 3,
		hunter: "other",
		hunterKnown: false,
		adversary: "Gwylan",
		adversaryText: "Gwylan",
		adversaryKnown: true,
		otherTracked: false,
		otherAction: "",
		playerHealth: 3,
		playerTracked: false,
		playerTrackedKnown: false,
		playerAction: "",
		consensual: 1,
		event: "",
		turn: 0,
		distance: 5,
	}>>
	<<set $_difficultyAdded to C.npc.Gwylan.lust + C.npc.Gwylan.dom>>
	<<set $huntGame.skills to {
		danceMin: 400 + $_difficultyAdded,
		danceMax: 700 + $_difficultyAdded,
		athleticsMin: 400 + $_difficultyAdded,
		athleticsMax: 700 + $_difficultyAdded,
		skulduggeryMin: 400 + $_difficultyAdded,
		skulduggeryMax: 800 + $_difficultyAdded,
	}>>
	<<set $_skillAdded to C.npc.Gwylan.lust + C.npc.Gwylan.dom>>
	<<if $location is "forest">>
		<<set $_skillAdded += 200>>
	<</if>>
	<<set $NPCList[0].skills.security to 600 + $_skillAdded + random(10, 100)>>
	<<set $NPCList[0].skills.athletics to 600 + $_skillAdded + random(10, 100)>>
	<<run statusCheck("Gwylan")>>
	<<if _gwylanStatus.includes("wounded")>>
		<<set $NPCList[0].skills.athletics -= 500>>
	<</if>>
<</widget>>

