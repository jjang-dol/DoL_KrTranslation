						<span class="lewd"><<He>>【은는】 당신이 러트 상태라는 것을 냄새로 확실히 알아챌 수 있을 것이며, 아마 이미 당신의 체취를 맡았을 것이다.</span>
					<<else>>
						<span class="lewd"><<He>>【은는】 당신이 발정기 상태라는 것을 냄새로 확실히 알아챌 수 있을 것이며, 아마 이미 당신의 체취를 맡았을 것이다.</span>
					<</if>>
				<</if>>
				<<set $huntGame.playerTracked to "scent">><<set $huntGame.playerTrackedKnown to true>>
			<<elseif $huntGame.playerTrackedKnown>>
				<br>
				<span class="pink">당신은 <<he>>【이가】 당신을 추적했다는 것을 알고 있다.</span>
			<</if>>
		<<else>>
			<span class="green">당신이 사냥꾼이다.</span>
			<<if $huntGame.playerTrackedKnown>>
				<br>
				<span class="pink">당신은 <<he>>【이가】 당신을 추적했다는 것을 알고 있다.</span>
			<</if>>
		<</if>>
		<<if $huntGame.adversary is "Gwylan" and _gwylanTF?.known and _gwylanStatus?.includes("heat")>>
			<br>
			<span class="pink">당신은 <<he>>【이가】 <<if C.npc.Gwylan.vagina isnot "none">>발정기<<else>>러트<</if>> 상태라는 것을 냄새로 알 수 있다.</span>
			<<set $huntGame.otherTracked to "scent">>
		<</if>>
	<<else>>
		<<if $huntGame.hunterKnown>>
			<<if $huntGame.hunter is "other">>
				<span class="red"><<= window.KR.gatPersonNameDictKR($huntGame.adversaryText).toUpperFirst()>>【이가】 당신을 사냥하고 있다.</span>
			<<else>>
				<span class="green">당신은 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【을를】 사냥하고 있다.</span>
			<</if>>
			<<if $huntGame.playerTrackedKnown>>
				<br>
				<span class="pink">당신은 <<he>>【이가】 당신을 추적했다는 것을 알고 있다.</span>
			<</if>>
		<<else>>
			<span class="blue">당신이 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【을를】 사냥하고 있는지, 아니면 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【이가】 당신을 사냥하고 있는지 확실하지 않다.</span>
		<</if>>
	<</if>>
	<<if $huntGame.otherTracked>>
		<br>
		<<if $huntGame.otherTracked is "scent">>
			당신은 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>의 냄새를 통해 그가
		<<else>>
			당신은 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【이가】
		<</if>>
		<<if $huntGame.distance gte 5>>
			<span class="teal">멀리 있다</span>는 것을 알 수 있다.
		<<elseif $huntGame.distance gte 4>>
			<span class="blue">이 지역 내에 있다</span>는 것을 알 수 있다.
		<<elseif $huntGame.distance gte 3>>
			<span class="purple">꽤 가까이에 있다</span>는 것을 알 수 있다.
		<<elseif $huntGame.distance gte 2>>
			<span class="pink">매우 가까이에 있다</span>는 것을 알 수 있다.
		<<else>>
			<span class="red">바로 여기에 있다</span>는 것을 알 수 있다!
		<</if>>
	<</if>>
	<br><br>
<</widget>>

<<widget "gwylanHuntEffects">>
	<<if $huntGame.timer gte 20>>
		<<set _forceConfrontation to true>>
		<<set $huntGame.distance to 0>>
	<</if>>

	/* Player actions */
	<<switch $huntGame.playerAction>>
		<<case "hunt">>
			<<if $huntGame.hunterKnown and $huntGame.hunter is "other">>
				당신은 <<his>> <<if $huntGame.otherTracked is "scent">>냄새<<else>>발자취<</if>>【을를】 쫓으며 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>의 뒤로 돌아가려 시도한다.
			<<else>>
				당신은 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>의 <<if $huntGame.otherTracked is "scent">>냄새<<else>>발자취<</if>>【을를】 쫓는다.
			<</if>>
			<<if $huntGame.otherAction is "run">>
				<br>
				<<if $athleticsSuccess>>
					<<set $_actionPassed to true>>
					<<set $huntGame.distance -= 1>>
					<<if $huntGame.hunter is "player">>
						<<set $huntGame.distance -= 1>>
						<span class="green">당신이 <<him>>에게 가까워지고 있다는 것을 알 수 있다.</span>
					<<else>>
						<span class="purple">이대로라면 얼마 지나지 않아 맞닥뜨리게 될 것이다.</span>
					<</if>>
				<<else>>
					<<if $huntGame.hunter is "player">>
						<<set $huntGame.distance -= 1>>
						<span class="purple">당신은 <<him>>【와과】 일정한 거리를 유지하고 있다.</span>
					<<else>>
						<span class="purple">이대로라면 얼마 지나지 않아 맞닥뜨리게 될 것이다.</span>
					<</if>>
				<</if>>
			<<else>>
				<<set $huntGame.distance -= 2>>
			<</if>>
		<<case "track">>
			<<if hasSharpSenses("instincts")>>
				당신은 공기의 냄새를 맡으며 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>의 체취를 찾으려 애쓴다.
			<<else>>
				당신은 몸을 낮추고 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【이가】 지나간 흔적이 있는지 확인한다.
			<</if>>
			<<if ["hide", "stealth"].includes($huntGame.otherAction)>><<set $skulduggerydifficulty += 100>><</if>>
			<<skulduggerycheck "silent">>
			<<if $skulduggerysuccess is 1>>
				<<set $_actionPassed to true>>
				<<if hasSharpSenses("instincts") and random(0, 1)>>
					<<set $huntGame.otherTracked to "scent">>
					<span class="green">그러자, 바람결에 묻어오는 희미한 체취가 맡아진다. 당신은 <<him>>【을를】 찾아냈다.</span>
				<<else>>
					<<set $huntGame.otherTracked to "trail">>
					<span class="green">당신은 어떻게든 <<print either("어지럽혀진 나뭇잎들", "부러진 나뭇가지", "희미한 발자국 몇 개")>>【을를】 발견해낸다. 당신은 <<his>> 발자취를 잡아냈다.</span>
				<</if>>
				<br><br>

				<span class="purple">사냥이 격렬해진다...</span> <<note "+ 속임수 난이도" "purple">>
				<<set $huntGame.skills.skulduggeryMin += 20>><<set $huntGame.skills.skulduggeryMax += 20>>
			<<else>>
				<span class="red">당신은 아무것도 찾아내지 못했다.</span>
			<</if>>
		<<case "stealth">>
			당신은 흔적을 최대한 남기지 않으려 애쓰며, 덤불 속을 살금살금 나아간다.
			<<skulduggerycheck "silent">>
			<<if $skulduggerysuccess is 1>>
				<<if $huntGame.hunterKnown and $huntGame.hunter is "other" and $huntGame.otherTracked and $huntGame.playerTracked and $huntGame.playerTrackedKnown>>
					<span class="gold">당신은 <<he>>【이가】 당신의 흔적을 놓치게 만들었다고 확신한다.</span>
					<<set $huntGame.playerTracked to false>><<set $huntGame.playerTrackedKnown to false>>
					<br><br>

					<span class="purple">사냥이 격렬해진다...</span> <<note "+ 속임수 난이도" "purple">>
					<<set $huntGame.skills.skulduggeryMin += 20>><<set $huntGame.skills.skulduggeryMax += 20>>
				<<else>>
					<span class="green">당신은 흔적 없이 지나가서, <<he>>【이가】 당신을 추적하기 더 어렵게 만든다.</span>
				<</if>>
				<<set $_actionPassed to true>>
				<<if $huntGame.hunter is "player">>
					<<set $huntGame.distance-->>
				<<else>>
					<<set $huntGame.distance++>>
				<</if>>
			<<else>>
				<span class="red">적당한 성공만 거둔다.</span>
			<</if>>
		<<case "hide">>
			<<if $huntGame.playerActionLast is "hide">>
				당신은 숨은 자리에 계속 웅크리고 있다. <<he>>【이가】 당신의 정확한 위치를 아는지 전혀 알 길이 없다.
			<<else>>
				당신은 은신처를 찾아 웅크린다.
			<</if>>
			<<skulduggerycheck "silent">>
			<<if $skulduggerysuccess is 1>>
				<<if $huntGame.hunterKnown and $huntGame.hunter is "other" and $huntGame.otherTracked and $huntGame.playerTracked and $huntGame.playerTrackedKnown>>
					<br>
					당신은 호흡을 가다듬고 집중한다. 숲이 당신을 정적으로 감싼다. <span class="gold">당신은 <<he>>【이가】 당신의 흔적을 놓치게 만들었다고 확신한다.</span>
					<<set $huntGame.playerTracked to false>><<set $huntGame.playerTrackedKnown to false>>
					<br><br>

					<span class="purple">사냥이 격렬해진다...</span> <<note "+ 속임수 난이도" "purple">>
					<<set $huntGame.skills.skulduggeryMin += 20>><<set $huntGame.skills.skulduggeryMax += 20>>
				<</if>>
				<<set $_actionPassed to true>>
			<</if>>
		/* Actions that lead into a proper chase or confrontation */
		<<case "ambush">>
			<<if $physiqueSuccess>>
				<span class="green"><<He>>【은는】 당신이 다가오는 것을 눈치채지 못한다.</span>
				<<if $huntGame.consensual and $huntGame.hunter is "other">>
					<br>
					<span class="gold">이제 당신이 사냥꾼이다.</span>
					<<set $huntGame.hunter to "player">>
				<</if>>
				<<set $huntGame.end to "ambushSuccess">>
			<<else>>
				<span class="red"><<He>>【은는】 당신을 맞이할 준비가 되어 있다.</span>
				<<set $huntGame.end to "ambushFailed">>
			<</if>>
			<<exit>>
		<<case "hideKeep">>
			<<if _forceConfrontation>>
				<span class="red"><<He>>【은는】 갑자기 당신을 향해 돌아서더니, 당신에게 달려온다!</span>
				<<set $huntGame.end to "caught">><<set $phase to "noDodge">>
				<<exit>>
			<<elseif $skulduggerysuccess>>
				잠시 탐색한 후, <span class="green"><<he>>【이가】 계속 이동한다. 당신은 은밀하게 그 뒤를 밟는다.</span>
				<<if $huntGame.consensual and $huntGame.hunter is "other">>
					<br>
					<span class="gold">이제 당신이 사냥꾼이다.</span>
					<<set $huntGame.hunter to "player">>
				<</if>>
				<br><br>

				<span class="purple">사냥이 격렬해진다...</span> <<note "+ 속임수 난이도" "purple">>
				<<set $huntGame.skills.skulduggeryMin += 20>><<set $huntGame.skills.skulduggeryMax += 20>>
				<<set $huntGame.otherTracked to "trail">><<set $huntGame.distance to 2>>
			<<else>>
				<span class="red"><<He>>【은는】 갑자기 당신을 향해 돌아서더니, 당신에게 달려온다!</span>
				<<set $huntGame.end to "caught">><<set $phase to "noDodge">>
				<<exit>>
			<</if>>
	<</switch>>
	<br><br>

	/* Adversary actions */
	<<if !$huntGame.playerTracked and ($huntGame.hunter is "other" or $huntGame.distance gte 3)>>
		<<set $huntGame.otherAction to "track">>
		<<set $_otherTrackingDiff to currentSkillValue("skulduggery")>>
		<<if ["stealth", "hide"].includes($huntGame.playerAction) and $_actionPassed>>
			/* Failed to track */
		<<elseif $NPCList[0].skills.security gte random(1, $_otherTrackingDiff)>>
			<<set $huntGame.playerTracked to true>>
		<</if>>

		<<if ["hide"].includes($huntGame.playerAction) or $huntGame.playerAction is "stealth" and !$_actionPassed>>
			<<set $huntGame.distance-->>
		<</if>>
	<<elseif $huntGame.hunter is "player">>
		<<if ["hide", "ambush"].includes($huntGame.otherAction) and !$huntGame.noMoreHiding>>
			<<set $huntGame.otherHideTimer-->>
			<<if random(0, 2)>>
				<<set $huntGame.otherAction to "ambush">>
			<</if>>
			<<if $huntGame.otherHideTimer lte 0>>
				<<set $huntGame.noMoreHiding to true>>
			<</if>>
		<<elseif $huntGame.distance gte 3 and random(0, 1) and !$huntGame.noMoreHiding>>
			<<set $huntGame.otherAction to "hide">>
			<<set $huntGame.otherHideTimer ||= 3>>
		<<elseif $huntGame.distance gte 2>>
			<<set $huntGame.otherAction to "stealth">>
			<<if $huntGame.playerTracked and !($huntGame.playerAction is "hunt" and $huntGame.otherTracked and $_actionPassed)>>
				<<set $huntGame.distance++>>
			<<elseif !$huntGame.playerTracked>>
				<<set $huntGame.distance += random(-1, 1)>>
			<</if>>
		<<else>>
			<<set $huntGame.otherAction to "run">>
			<<if $huntGame.playerTracked and !($huntGame.playerAction is "hunt" and $huntGame.otherTracked and $_actionPassed)>>
				<<set $huntGame.distance += 2>>
			<<elseif $huntGame.playerTracked>>
				<<set $huntGame.distance += 1>>
			<<else>>
				<<set $huntGame.distance += random(-1, 2)>>
			<</if>>
		<</if>>
	<<elseif $huntGame.playerTracked>>
		<<set $huntGame.otherAction to "hunt">>
		<<set $huntGame.distance-->>
	<<else>>
		<<set $huntGame.otherAction to "stealth">>
	<</if>>

	/* Give player information if tracked */
	<<if $huntGame.otherTracked>>
		<<if $huntGame.playerAction is "tracked" and $_actionPassed>>
			당신은 한동안 그것을 쫓아가다가 이내 깨닫는다,
			<<if $huntGame.otherAction is "track">>
				<<if $huntGame.playerTracked>>
					<<set $huntGame.hunterKnown to true>><<set $huntGame.playerTrackedKnown to true>>
					<<he>>【이가】 당신을 추적하고 있다는 것을. <span class="pink">서로가 서로를 맴돌고 있다.</span> 이제 고양이와 쥐의 싸움이다.
				<<else>>
					<<set $huntGame.hunterKnown to true>>
					<<he>>【이가】 당신을 추적하려 하고 있다는 것을. <span class="green"><<He>>【은는】 아직 당신이 어디 있는지 모르는 것 같다!</span>
					<<if $huntGame.consensual and $huntGame.hunter is "other">>
						<br>
						<span class="gold">이제 당신이 사냥꾼이다.</span>
						<<set $huntGame.hunter to "player">>
					<</if>>
				<</if>>
			<<elseif $huntGame.otherAction is "stealth">>
				<<he>>【이가】 느리고 은밀하게 움직이고 있다는 것을. 아직 충분히 은밀하지는 않다.
			<<elseif $huntGame.otherAction is "run">>
				<<he>>【이가】 달리고 있다.
				<<if $huntGame.playerTracked>>
					<<He>>【은는】 당신이 <<his>> 흔적을 잡았다는 것을 알고 있을 것이다.
				<<else>>
					막연하게나마. <<He>>【은는】 당신이 정확히 어디 있는지 알지 못한다.
				<</if>>
			<<elseif $huntGame.otherAction is "hunt">>
				<<set $huntGame.hunterKnown to true>><<set $huntGame.playerTrackedKnown to true>>
				<<he>>【이가】 당신을 사냥하고 있다는 것을. <span class="pink">서로가 서로를 맴돌고 있다.</span> 이제 고양이와 쥐의 싸움이다.
			<<else>>
				<<he>>【이가】 전방 어딘가에 숨어 있을 가능성이 높다는 것을.
			<</if>>
		<<else>>
			<<if ["hide"].includes($huntGame.playerAction) and $huntGame.otherTracked>>
				<<set $huntGame.otherTracked to false>>
				<span class="red">당신은 <<his>> 발자취를 놓친다.</span>
			<<else>>
				<<switch $huntGame.otherAction>>
					<<case "track">>
						<<he>>【이가】 당신을 추적하려고 한다는 것을 알 수 있다.
						<<if $huntGame.playerTracked>>
							<<set $huntGame.hunterKnown to true>><<set $huntGame.playerTrackedKnown to true>>
							<span class="pink">서로가 서로를 맴돌고 있다.</span>
						<<else>>
							<<set $huntGame.hunterKnown to true>>
							<span class="green"><<He>>【은는】 아직 당신이 어디 있는지 모르는 것 같다!</span>
							<<if $huntGame.consensual and $huntGame.hunter is "other">>
								<br>
								<span class="gold">이제 당신이 사냥꾼이다.</span>
								<<set $huntGame.hunter to "player">>
							<</if>>
						<</if>>
					<<case "stealth">>
						당신은 <<he>>【이가】 느리고 체계적으로 움직이고 있다는 것을 알 수 있다.
						<<if !($huntGame.playerAction is "track" and $_actionPassed)>>
							<<set $skulduggerydifficulty to random($huntGame.skills.skulduggeryMin, $huntGame.skills.skulduggeryMax)>>
							<<skulduggerycheck "silent">>
						<</if>>
						<<if $skulduggerysuccess>>
							<span class="green">일단 아직은 <<his>> 흔적을 잡고 있다.</span>
							<<set $huntGame.skills.skulduggeryMin += 20>><<set $huntGame.skills.skulduggeryMax += 20>>
						<<else>>
							<span class="red"><<He>>【은는】 꽤 능숙하다. 당신은 <<his>> 발자취를 놓친다.</span>
							<<set $huntGame.otherTracked to false>>
						<</if>>
					<<case "run">>
						당신은 <<he>>【이가】 달아나고 있다는 것을 알 수 있다.
						<<if $huntGame.playerTracked>>
							<<He>>【은는】 당신이 <<his>> 흔적을 잡았다는 것을 알고 있을 것이다.
						<<else>>
							막연하게나마. <<He>>【은는】 당신이 정확히 어디 있는지 알지 못한다.
						<</if>>
					<<case "hunt">>
						<<set $huntGame.hunterKnown to true>><<set $huntGame.playerTrackedKnown to true>>
						<<His>> 움직임이 공격적이다. <<He>>【은는】 당신을 사냥하고 있다.
						<<if $huntGame.hunter is "player">>
							<br>
							<span class="red">당신은 더 이상 사냥꾼이 아니다.</span>
							<<set $huntGame.hunter to "other">>
						<</if>>
					<<default>>
						<<he>>【이가】 어딘가에 숨어 있다는 것을 알 수 있다.
						<<if !($huntGame.playerAction is "track" and $_actionPassed)>>
							<<set $skulduggerydifficulty to random($huntGame.skills.skulduggeryMin, $huntGame.skills.skulduggeryMax)>>
							<<skulduggerycheck "silent">>
						<</if>>
						<<if $skulduggerysuccess>>
							<span class="green">일단 아직은 <<his>> 흔적을 잡고 있다.</span>
							<<set $huntGame.skills.skulduggeryMin += 20>><<set $huntGame.skills.skulduggeryMax += 20>>
						<<else>>
							<span class="red"><<He>>【은는】 꽤 능숙하다. 당신은 <<his>> 발자취를 놓친다.</span>
							<<set $huntGame.otherTracked to false>>
						<</if>>
				<</switch>>
			<</if>>
		<</if>>
		<br><br>
	<</if>>

	/* Confrontation */
	<<if $huntGame.distance lte 1 and $huntGame.playerAction isnot "hide" or _forceConfrontation>>
		<<if ["hide","ambush"].includes($huntGame.otherAction) and $huntGame.hunter is "player" and $huntGame.playerAction is "stealth" and $_actionPassed and !_forceConfrontation>>
			<<set $huntGame.end to "chase">><<set $huntGame.chaseDistance to 1>>
			전방의 덤불 속에 숨어있는 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【을를】 발견했다! <span class="green">은밀한 움직임 덕분에, 당신이 <<him>>【을를】 먼저 발견했다.</span>
			<br><br>

			당신은 기습에 성공한다. <<He>>【은는】 달아나기 시작하지만, 당신은 이미 <<him>>의 바로 뒤에 붙어 있다.
		<<elseif $huntGame.otherAction is "ambush" or _forceConfrontation>>
			<<set $huntGame.end to "caught">>
			수풀에서 부스럭거리는 소리가 들린다. <<He>>【은는】 매복한 채 당신을 기다리고 있었다!
			<<if $huntGame.hunterKnown>>
				<br>
				<span class="red">당신은 더 이상 사냥꾼이 아니다.</span>
			<</if>>
			<<set $huntGame.hunter to "other">>
			<<set $huntGame.playerTracked to true>>
		<<elseif $huntGame.hunter is "player">>
			<<set $huntGame.end to "chase">>
			당신은 전방의 덤불 속을 살금살금 헤쳐가는 <<him>>【을를】 발견한다. <<He>>【은는】 역시 당신을 본다. <<He>>【은는】 달리기 시작한다!
		<<else>>
			<<set $huntGame.end to "caught">>
			가까이서 달리는 소리가 들린다. <<He>>【은는】 당신을 찾아냈다!
		<</if>>
		<<exit>>
	<</if>>

	<<set $huntGame.turn++>>
	<<if $huntGame.hunter is "player">>
		<<set $huntGame.playerHuntTimer ||= 7>>
		<<set $huntGame.playerHuntTimer-->>
		<<if !$huntGame.playerHuntTimer or _forceConfrontation>>
			<<if $huntGame.hunterKnown>>
				바람의 흐름이 변한다. 당신은 갑자기 몸이 무방비하게 노출된 것처럼 느낀다.
				<br>
				<span class="red">당신은 더 이상 사냥꾼이 아니다.</span>
				<br><br>
			<</if>>
			<<set $huntGame.hunter to "other">>
			<<set $huntGame.playerTracked to true>>
		<</if>>
	<</if>>
	<<set $huntGame.distance to Math.clamp($huntGame.distance, 0, 7)>>
	<<set $huntGame.playerActionLast to $huntGame.playerAction>>
	<<pass 2>>
<</widget>>

<<widget "gwylanHuntOptions">>
	<<set $skulduggerydifficulty to random($huntGame.skills.skulduggeryMin, $huntGame.skills.skulduggeryMax)>>
	<<if $huntGame.distance lte 1 and $huntGame.playerAction is "hide">>
		당신은 은신처에서 고개를 내밀어 <<he>>【이가】 당신을 찾고 있는 것을 지켜본다. <span class="green"><<He>>【은는】 아직 당신을 보지 못했다.</span>
		<br><br>

		<<link [[기습한다|$huntGame.event]]>><<set $huntGame.playerAction to "ambush">><<transform fox 1>><</link>><<physiquedifficulty 4000 17000>>
		<br>
		<<if $huntGame.consensual>>
			<<link [[계속 숨어 있다가, <<he>>【이가】 떠나면 <<him>>【을를】 추적한다|$huntGame.event]]>><<set $huntGame.playerAction to "hideKeep">><</link>><<skulduggerydifficulty>>
		<<else>>
			<<link [[계속 숨어 있다가, <<he>>【이가】 떠나면 도망친다|$huntGame.event]]>><<set $huntGame.playerAction to "hideKeepEscape">><</link>><<skulduggerydifficulty>>
		<</if>>
		<br>
	<<else>>
		<<if $huntGame.otherTracked>>
			<<if $huntGame.hunterKnown and $huntGame.hunter is "other">>
				<<link [[정면으로 맞닥뜨린다|$huntGame.event]]>><<set $huntGame.playerAction to "hunt">><</link>><<note "- - 거리" "teal">>
			<<else>>
				<<link [[<<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【을를】 사냥한다|$huntGame.event]]>><<set $huntGame.playerAction to "hunt">><</link>><<note "- 거리" "teal">>
				<<if $huntGame.otherTracked and $huntGame.otherAction is "run">><<athleticsdifficulty $huntGame.skills.athleticsMin $huntGame.skills.athleticsMax>><</if>>
			<</if>>
		<<else>>
			<<link [[<<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【을를】 추적한다|$huntGame.event]]>><<set $huntGame.playerAction to "track">><</link>><<skulduggerydifficulty>>
		<</if>>
		<br>
		<<if $huntGame.hunterKnown and $huntGame.hunter is "other" and $huntGame.otherTracked and $huntGame.playerTracked and $huntGame.playerTrackedKnown>>
			<<link [[은밀하게 움직이며, <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【이가】 당신의 흔적을 놓치도록 유도한다|$huntGame.event]]>><<set $huntGame.playerAction to "stealth">><</link>><<skulduggerydifficulty>>
			<br>
		<<elseif $huntGame.hunterKnown and $huntGame.hunter is "other" and $huntGame.otherTracked>>
			<<link [[<<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>에게서 은밀하게 멀어진다|$huntGame.event]]>><<set $huntGame.playerAction to "stealth">><</link>><<skulduggerydifficulty>>
			<br>
		<<else>>
			<<link [[은밀하게 움직인다|$huntGame.event]]>><<set $huntGame.playerAction to "stealth">><</link>><<skulduggerydifficulty>>
			<br>
		<</if>>
		<<link [[숨는다|$huntGame.event]]>><<set $huntGame.playerAction to "hide">><</link>><<skulduggerydifficulty>>
		<br>
	<</if>>
<</widget>>

<<widget "gwylanCombatInit">>
	<<run statusCheck("Gwylan")>>
	<<set $enemyarousalmax to 1200>>
	<<set $enemyarousal += C.npc.Gwylan.lust>>
	<<if _gwylanStatus.includes("heat")>>
		<<set $enemyarousal += 100>>
	<</if>>
	<<set $combat_player_orgasm_target to Math.clamp(Math.ceil((C.npc.Gwylan.lust + C.npc.Gwylan.dom) / 100) + _gwylanStatus.count("heat"), 1, 10)>>
	<<if $arousal gte ($arousalmax / 5) * 4 and $combat_player_orgasm_target lte 1>>
		<<set $combat_player_orgasm_target++>>
	<</if>>
	<<if !_gwylanStatus.includes("wantsPregnancy")>>
		<<set $disableNormalImpregnation to true>>
		<<set $disableImpregnation to true>>
	<</if>>

	/* ToDo: Gwylan - delete when pregnancy is to be enabled */
	<<set $disableNormalImpregnation to true>>
	<<set $disableImpregnation to true>>

	/* ToDo: Gwylan - Start combat effects from hypnosis traits or bad end triggers? */
	<<set $_hypnoMessages to []>>
	<<if $gwylan.silence>>
		<<set $combat_silenced to true>>
		<<set $_hypnoMessages.push("<span class='red'>그윌란이 당신의 목소리를 앗아간다</span>")>>
	<</if>>
	<<if $gwylan.trance>>
		<<set $trance to 1>><<set $timer to $hypnosis_traits.devotion>>
		<<set $_hypnoMessages.push("<span class='lewd'>당신은 매혹당했다</span>")>>
	<</if>>
	<<if $_hypnoMessages.length>>
		<<hypnosisText "<<= formatList($_hypnoMessages, '', true, '. ')>>.">>
		<br><br>
	<</if>>
<</widget>>

<<widget "gwylanNobody">>
	<<set $_banishedDays to _args[0] || 9>>
	<<if $gwylan.timer and ["active", "scorned"].includes(C.npc.Gwylan.state) and typeof $_banishedDays is "number">>
		<<set $gwylan.timer.nobody to new DateTime(Time.date).addDays($_banishedDays).timeStamp>>
		<<if $worn.neck.name is "familiar collar">>
			<<set $worn.neck.type.delete("leash")>>
			<<set $worn.neck.cursed to 0>>
		<</if>>
	<</if>>
<</widget>>

<<widget "gwylanDesc">><<silently>>
	<<if $forest_shop_intro or $gwylan_rescue or $gwylan_cafe_intro>>
		<<set _text_output to "그윌란">>
	<<elseif _args.includes("the")>>
		<<set _text_output to "소심한 <<nnpc_gendery 'Gwylan'>>">>
	<<else>>
		<<set _text_output to "소심한 <<nnpc_gendery 'Gwylan'>>">>
	<</if>>
	<<if _args.includes("cap")>><<set _text_output to _text_output.toUpperFirst()>><</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "shopkeeperDesc">><<silently>>
	<<if $forest_shop_intro or $gwylan_rescue or $gwylan_cafe_intro>>
		<<set _text_output to "상점 주인">>
	<<else>>
		<<set _text_output to "<<nnpc_gendery 'Gwylan'>>">>
	<</if>>
	<<if _args.includes("cap")>><<capitalise>><</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "gwylanRescueStats">>
	<<if !$gwylanRescue>>
		<<set $gwylanRescue to {
			seen: [],
			failed: "",
			count: 0,
			eden: 0,
		}>>
	<</if>>

	<<if !$gwylanRescue.seen.includes(_args[1])>>
		<<set _gwylanFirstRescue to _args[1]>>
	<</if>>

	<<if _args[0] is true>>
		<<set $rescued++>>
		<<set $gwylanRescue.count++>>
		<<if _args[2] is "Eden" and !$edenCagedEscape>>
			<<set $gwylanRescue.eden++>>
		<</if>>
		<<set $gwylanRescue.seen.pushUnique(_args[1])>>
	<<else>>
		<<set $gwylanRescue.failed to _args[1]>>
		<<set $gwylanRescue.seen.pushUnique(_args[1] + "Failed")>>
	<</if>>
<</widget>>

<<widget "gwylanReunion">>
	당신은 <<him>>에게 <<badEndProse $badEndStats.last()?.source "at">> 보냈던 시간에 대해 말해준다. <<He>>【은는】 당신의 머리를 쓰다듬으며 아무 말 없이 듣기만 한다. 이야기가 끝나자, <<he>>【이가】 당신의 이마에 입을 맞춘다.
	<<switch $badEndStats.last()?.source>>
		<<case "Underground Farm">>
			<<if $brownFoxRevealed>>
				"하이 엘크에서 도망치다니 운이 좋았네. <<nnpc_Hes "Remy">> 강력한 <<nnpc_gender "Remy">>【이】니까. 특히 <<nnpc_his "Remy">> 식인 여우와 함께라면 더더욱 그렇지."
			<<else>>
				"레미에게서 도망치다니 운이 좋았네. <<nnpc_Hes "Remy">> 강력한 <<nnpc_gender "Remy">>. "
			<</if>>
			<<He>>【은는】 양손으로 당신의 뺨을 감싸며 눈을 들여다본다.
			<<if $dissociation gte 1>>
				"그들이 네 두 눈에서 빛을 앗아가 버렸구나." <<He>>【은는】 더욱 강하게 당신을 껴안는다.
			<<else>>
				"네가 여전히 인간이라는 걸 명심해. 놈들이 무슨 짓을 해도 그 사실은 변하지 않아." <<He>>【은는】 더욱 강하게 당신을 껴안는다.
			<</if>>
			<<if !$gwylanTalked.includes("underground_farm")>>
				<<set _badEndFollowup to true>>
			<</if>>
		<<case "Wolf Cave">>
			"늑대들은 평소엔 참 얌전한데, 그 검은 놈은 점점 대담해지고 있네," <<he>>【이가】 말한다. "<<if ($settings.monsterChance gte random(1, 100) and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly)) or $blackwolfmonster is 2>><<nnpc_he "Black Wolf">>【이가】 <<else>>그 녀석이<</if>> 널 그렇게 만들다니 정말 유감이야."
			<<if !$gwylanTalked.includes("loincloth")>>
				<<set _badEndFollowup to true>>
			<</if>>
		<<case "Eden">>
			"숲은 다 알고 있지," <<he>>【이가】 말한다. "<<nnpc_he "Eden">>【은는】 그저 빼앗고 파괴할 뿐이야." <<His>> 눈빛이 어두워진다.
			<<if !$gwylanTalked.includes("loincloth")>>
				<<set _badEndFollowup to true>>
			<</if>>
		<<case "Underground Dungeon">>
			"그건 끔찍할 정도네. 사람을 쓰다 버릴 물건처럼 밀매하다니, 너처럼 탈출할 행운조차 얻지 못한 이들이 얼마나 많을지 상상하는 것만으로도 끔찍해." <<He>>【은는】 당신을 더 꽉 끌어안는다. "네가 탈출해서 정말 천만다행이야."
			<<if !$gwylanTalked.includes("underground_brothel")>>
				<<set _badEndFollowup to true>>
			<</if>>
		<<case "Mines">>
			"우리 발밑에서 그런 사악한 일이 벌어지고 있다니 믿을 수가 없네," <<he>>【이가】 말한다. "살아 돌아오다니, 넌 정말 강해."
		<<case "Asylum">>
			"그런 취급을 받으면 누구라도 미쳐버릴 텐데," <<he>>【이가】 말한다. "<<if $gwylanSeen.includes("hypnosis_removal")>>기억해, 만약<<else>>만약<</if>> 그 <<nnpc_gender "Harper">>【이가】 네가 평소라면 절대 생각지도 못할 것들을 생각하게 만들었다면, <span class="blue">부디 상점으로 날 찾아와 줘</span>. 내가 도와줄 수 있으니까."
			<<if !$gwylanTalked.includes("asylum")>>
				<<set _badEndFollowup to true>>
			<</if>>
		<<case "Prison">>
			"우린 모두 뿌린 대로 거두는 법이야," <<he>>【이가】 말한다. "하지만 때로는 죗값에 비해 형벌이 너무 과혹할 때가 있지.
			<<if $badEndStats.find(stat => stat.source === "Prison").reasonEnd is "prisonServed">>
				네가 시들어버리지 않고 그 기나긴 형기를 무사히 버텨내서 기뻐."
			<<else>>
				기지를 발휘해 탈출해서 다행이야."
			<</if>>
			<<if !$gwylanTalked.includes("prison")>>
				<<set _badEndFollowup to true>>
			<</if>>
		<<case "Pound">>
			<<if isLoveInterest("Gwylan")>>"<span class="lewd">널 그렇게 대할 수 있는 건 오직 나뿐인데.</span>"<<else>>"사람을 짐승으로 만들다니 잔인함을 넘어서는 짓이네. 네가 누군지 잊지 않기를 바라."<</if>>
		<<case "Kylar Abduction">>
			"네 친구라고?" <<He>>【은는】 별로 놀란 눈치가 아니다. "<<nnpc_him "Kylar">>【을를】 그런 극단적인 수단으로 내몬 게 무엇이든 간에, 너희 둘 다 버텨내기 힘들었겠네."
			<br><br>

			<<if $syndromekylar is 1>>
				<<if !$gwylanTalked.includes("vampire")>>
					<<set _badEndFollowup to true>>
				<</if>>
				"힘들었지만, 이해해요," 당신이 말한다. "<<nnpc_Hes "Kylar">> 단지 오해했을 뿐이고, 친구가 필요한 거니까요.
			<<else>>
				"네," 당신이 말한다. "전 도저히 <<nnpc_him "Kylar">>【을를】 이해할 수가 없어요.
			<</if>>
			"이제 끝나서 다행일 뿐이에요."
			<br><br>

			"나도 그래," <<he>>【이가】 말한다. <<if isLoveInterest("Gwylan")>>"보고 싶었어."<</if>>
		<<case "Pirate Ship">>
			"그건... 꽤 낯익은 이야기네," <<he>>【이가】 말한다. "엄청난 모험을 한 것 같아. 바다 한가운데의 마음이라니... 네가 그 깊은 속에서 길을 잃진 않았기를 바라."
		<<default>>
			그윌란이 <<his>> 귀에 새끼손가락을 집어넣는다. "방금 뭐라고? 미안, <span class="red">아무래도 여기 버그가 난 것 같네</span>. 내가 아니라 <span class="gold">PurityGuy</span>에게 네가 뭘 하고 다녔는지 가서 말해봐."
	<</switch>>
<</widget>>

<<widget "schoolWalkChat">>
	<<set _gwylan to statusCheck("Gwylan")>><<set _robin to statusCheck("Robin")>>
	<<set _gwylanPresent to _args.includes("gwylan")>><<set _robinPresent to _args.includes("robin")>>
	<<cleareventpool>>

	<<if _gwylanPresent>>
		<<if !$weekly.gwylan_school_talk_classes>>
			<<addinlineevent "school_gwylan_classes" 1>>
				<<set $weekly.gwylan_school_talk_classes to 1>>
				<<if _robinPresent>>
					"수업은 잘 돼가?" 그윌란이 묻는다.
				<<else>>
					"수업은 잘 돼가?" <<nnpc_he "Gwylan">>【이가】 묻는다.
				<</if>>
				<<if $sciencetrait + $mathstrait + $englishtrait + $historytrait gte 16>>
					당신은 <<nnpc_him "Gwylan">>에게 모든 과목에서 A를 받았다고 자랑스럽게 말한다. <<nnpc_He "Gwylan">>【은는】 당신이 배운 흥미로운 사실들에 대해 길게 이야기하는 것을 듣는다.
					<br><br>

					"정말 좋은 소식이네, <<pcpetname "Gwylan" "simple">>." <<nnpc_He "Gwylan">>【이가】 미소 짓는다. "지식은 뇌의 양식이야. 배우려는 노력을 절대 멈추지 않길 바라."
				<<elseif $sciencetrait + $mathstrait + $englishtrait + $historytrait gte 8 and ($sciencetrait lte 1 or $mathstrait lte 1 or $englishtrait lte 1 or $historytrait lte 1)>>
					<<set _badClass to $sciencetrait lte 1 ? "과학" : $mathstrait lte 1 ? "수학" : $englishtrait lte 1 ? "영어" : "역사">>
					당신은 <<nnpc_him "Gwylan">>에게 대체로 잘되고 있지만, _badClass 수업은 뒤처지고 있다고 말한다.
					<br><br>

					<<nnpc_He "Gwylan">>【은는】 당신의 머리를 쓰다듬는다. "누구에게나 부족한 점은 있어. 자연스러운 일이니까, 너무 자책하지 마. 그냥 최선을 다하면 돼, 알겠지?"
				<<elseif $sciencetrait + $mathstrait + $englishtrait + $historytrait gte 8>>
					당신은 <<nnpc_him "Gwylan">>에게 순조롭게 진행되고 있다고 말한다.
					<<if $stress gte ($stressmax / 5) * 3>>
						하지만 모든 학교 과제 때문에 스트레스를 받고 있다고.
						<br><br>

						그윌란이 몸을 기울여 당신을 안아준다<<if $gwylanSeen.includes("partners")>>, 그리고 당신의 뺨에 입을 맞춘다. <<stress -10>><<llstress>><<else>>. <<stress -5>><<lstress>><</if>>
						<br><br>

						"안타깝네. 학교 시스템은 학생들의 정신 건강에 대해 매우 무정할 수 있어. 그들이 널 갉아먹게 두지 마, 넌 쉴 자격이 있어."
					<<else>>
						그리고 계속해서 나아지고 있다고.
