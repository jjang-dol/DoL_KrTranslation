:: Gwylan Widgets [widget]

<<widget "gwylanGreeting">><<silently>>
	<<set $_gwylanSpeech to "">>
	<<if !$daily.gwylan.greeting>>
		<<set $daily.gwylan.greeting to true>>
		<<set $_gwylanSpeech to "<br><br>">>
		<<if $location is "cafe" and $daily.robin_in_cafe is 1>>
			<<set $_gwylanSpeech += "그윌란은 ">>
		<<else>>
			<<set $_gwylanSpeech += "<<nnpc_He 'Gwylan'>>【은는】 ">>
		<</if>>
		<<if $gwylan.wary gte 5>>
			<<set $_gwylanSpeech += "당신을 뚫어져라 바라본다.">>
		<<elseif _gwylanLastSeenDays gte 21>>
			<<set $_gwylanSpeech += "당신을 보고 놀라면서도 기뻐 보인다.">>
		<<elseif $gwylan.hunting is 3>>
			<<set $_gwylanSpeech += "당신을 보고 기뻐하면서도 짜증 난 듯하다.">>
		<<elseif $daily.gwylan.ritual>>
			<<set $_gwylanSpeech += "새빨개진 뺨 위로 따뜻한 미소를 지어 보인다.">>
		<<elseif _gwylanLovePercent gte 25>>
			<<set $_gwylanSpeech += "당신을 보자 기운이 나는 듯하다.">>
		<<else>>
			<<if $location is "cafe">>
				<<set $_gwylanSpeech += "부드럽게 미소 짓지만, 계속 바다를 바라본다.">>
			<<else>>
				<<set $_gwylanSpeech += "당신에게 오라고 손짓한다.">>
			<</if>>
		<</if>>

		<<set $_linePool to []>>
		<<if $moorLuck gt 0>>
			<<set $_linePool.push(`"오늘은 네 주변에 행운의 기운이 감도네.`)>>
		<</if>>
		<<if $gwylanSeen.includes("romance")>>
			<<set $_linePool.push(`"안녕, 내 사랑.`)>>
		<<else>>
			<<set $_linePool.push(`"안녕, 얘야.`)>>
		<</if>>
		<<if $gwylanSeen.includes("ritual_beast")>>
			<<set $_linePool.push(`"안녕, <<pcpetname 'Gwylan' 'name'>>.`)>>
		<</if>>
		<<if $location is "forest_shop" and $gwylanTalked.length gte 10 and (!$gwylan.wary or $gwylan.wary lte 1)>>
			<<set $_linePool.push(`"내가 제일 좋아하는 손님이네!`)>>
		<</if>>
		<<if $exposed gte 2 and $location is "forest_shop">>
			<<set $_linePool.push(`<<He>>【은는】 시선을 아래로 향하는 것을 피한다. "여기가 꽤 쌀쌀한 모양이네.`)>>
		<</if>>
		<<if $worn.head.name is "rose" and $worn.head.colour.includes("pink")>>
			<<set $_linePool.push(`<<He>>【은는】 당신의 머리에 꽂힌 분홍 장미를 보며 미간을 찌푸린다. "안녕.`)>>
		<<elseif $worn.head.name is "sage witch hat">>
			<<set $_linePool.push(`"멋진 모자네.`)>>
		<</if>>
		<<if $worn.upper.name === "chain tunic" && $worn.lower.name === "chain tunic skirt" ||
			$worn.upper.name.includes("vintage") && $worn.lower.name.includes("vintage")>>
			<<set $_linePool.push(`"그거 정말 잘 어울린다.`)>>
		<<elseif $worn.upper.type.includes("costume") && $worn.lower.type.includes("costume") ||
			(V.worn.upper.type.includes("naked") && V.worn.under_upper.type.includes("costume") &&
			V.worn.lower.type.includes("naked") && V.worn.under_lower.type.includes("costume"))>>
			<<set $_linePool.push(`"옷차림 괜찮네.`)>>
		<</if>>
		<<if $location is "forest_shop" and $worn.feet.name is "reindeer slippers">>
			<<set $_linePool.push(`<<He>>【은는】 당신의 슬리퍼를 눈치챈다. "안녕, 사슴아.`)>>
		<</if>>

		<<if $_linePool.length>>
			<<set $_gwylanSpeech += " " + $_linePool.pluck()>>
			<<if _gwylanLastSeenDays gte 21>>
				<<set $_gwylanSpeech += `" <<He>>【은는】 뒷머리를 긁적인다. "다시 만나서 반가워. 날 잊어버린 줄 알기 시작하던 참이었어.`>>
			<</if>>
			<<if $location is "cafe" and getRobinLocation() is "cafe">>
				<<set $_gwylanSpeech += ` 이리 와, 같이 있자." 로빈이 미소 지으며 당신에게 손을 흔든다.`>>
			<<else>>
				<<set $_gwylanSpeech += `"`>>
			<</if>>
		<</if>>
	<</if>>
<</silently>><<print $_gwylanSpeech>><</widget>>

<<widget "gwylanOptions">>
	<<if $gwylanPassTime>>
		<<pass $gwylanPassTime>>
		<<unset $gwylanPassTime>>
	<</if>>
	<<set _gwylanLocation to gwylanSchedule()>>
	<<set $gwylan.timer.lastSeen to Time.date.timeStamp>>

	<<if _gwylanLocation is "nowhere">>
		/* Nothing */
		<<gwylanOptionsLeave>>
		<<exit>>
	<</if>>

	/* Story progress */
	<<if !$gwylanSeen.includes("struggles") and $gwylan.progress gte 15 and _gwylanLovePercent gte 65 and $gwylanSeen.includes("ritual_beast") and $dateCount.GwylanBeast gte 2 and $gwylan.request.event isnot "meetAtCafe" and !gwylanRequestMet() and C.npc.Gwylan.dom gte 10 and C.npc.Gwylan.lust gte 25>>
		<<set $_noLeave to true>>
		<<if $location is "forest_shop">>
			<<He>>【은는】 잠시 확신이 없는 표정을 짓더니 불쑥 말을 꺼낸다. "너한테 물어볼 게 있어."
			<br><br>

			<<link [[다음|Gwylan Talk Struggles Intro]]>><</link>>
			<br>
		<<else>>
			그윌란이 눈을 감고 있다. <span class="blue">당신은 <<his>> 주의를 끌어보려 하지만, <<he>>【은는】 대답하지 않는다.</span>
			<br><br>

			<<if $location is "cafe" and !(between($chef_state, 7, 8) and $chef_rework lte 30)>>
				<<getouticon>><<link [[작별 인사를 하고 다시 안으로 들어간다 (0:01)|Gwylan Talk Struggles Intro]]>><<pass 1>><</link>>
			<<elseif $location is "cafe">>
				<<getouticon>><<link [[작별 인사를 한다 (0:01)|Gwylan Talk Struggles Intro]]>><<pass 1>><</link>>
			<<else>>
				<<getouticon>><<link [[상점으로 돌아간다|Gwylan Talk Struggles Intro]]>><</link>>
			<</if>>
			<br>
		<</if>>
		<<exit>>
	<</if>>
	<<if $location is "forest_shop" and _gwylanLovePercent gte 80 and C.npc.Gwylan.dom gte 75 and $dateCount.GwylanSex gte 5 and $gwylan.sea gte 5 and !$gwylanSeen.includes("partners") and _gwylanStatus.includes("lust") and !$weekly.gwylanLIChance and $exposed is 0 and !Time.isBloodMoon()>>
		<<set $weekly.gwylanLIChance to true>>
		그윌란의 손이 당신의 손 위로 포개지는 것이 느껴진다.
		<br><br>

		"나랑 같이 좀 걸을래?" <<he>>【이가】 묻는다. "뭔가 이야기하고 싶은 게 있어서." <<He>>【은는】 잠시 뜸을 들인다. "다시는 너한테 화내지 않을게. 약속해."
		<br><br>

		<<link [[예 (1:00)|Gwylan Promenade Walk]]>><<endevent>><<pass 20>><<trauma -1>><</link>><<ltrauma>><<gyearning true>>
		<br>
		<<link [[지금은 아니야|Gwylan Promenade Walk No]]>><<npcincr Gwylan dom -5>><</link>><<llyearning>>
		<br>
		<<exit>>
	<</if>>

	/* Leaving the cafe for elsewhere */
	<<if $location is "cafe" and !(between($chef_state, 7, 8) and $chef_rework lte 30) and $gwylan.robin gte 10 and $daily.robin_in_cafe and getRobinLocation() isnot "cafe" and false>> /* WARNING! Re-enable later for Gwybin cafe */
		그윌란은 <<his>> 접시를 들고 일어난다. 갈매기 떼가 지나가는 순간, <<He>>【은는】 부스러기들을 허공에 흩뿌린다. 녀석들은 빵가루가 해변에 하나도 떨어지지 않게 다 주워 먹는다.
		<br><br>

		<<He>>【은는】 당신을 향해 미소를 짓는다. "이제 가는 게 좋겠어. 학교에 늦고 싶진 않을 테니까." 로빈이 고개를 끄덕이고 <<person2>><<his>> 가방을 챙긴다. <span class="red">TODO: 그윌란, 로빈과 함께 학교에 등교하는 부분.</span>
		<br><br>
		<<schoolicon "building">><<link [[학교로 걸어간다 (0:05)|Gwylan Walk School Robin]]>><<set $daily.gwylan.cafeSkip to true>><<pass 5>><<unset $cafe_study>><<storeon "cafe_balcony">><<set $phase to 1>><</link>>
		<br>
		<<getouticon>><<link [[양해를 구하고 다시 안으로 들어간다 (0:01)|Ocean Breeze]]>><<pass 1>><<unset $cafe_study>><<storeon "cafe_balcony">><<endevent>><</link>>
		<br>
		<<exit>>
	<</if>>
	<<if $location is "cafe" and !$gwylan_school_walk_refused and Time.schoolDay and (Time.hour is 8 and Time.minute gte 40 or Time.hour is 9) and !$daily.gwylan_skip_school and ($gwylanSeen.includes("cafe_walk") or ($gwylan.sea + ($gwylanTalked.count("fox_mask") * 20) + ($gwylanTalked.count("dark_pendant") * 20) gte 40))>>
		<<if _gwylanTF?.known>>
			그윌란의 귀가 쫑긋거리고, <<he>>【은는】 무언가를 깨달은 듯하다.
		<</if>>

		<<He>>【은는】 당신에게 미소를 짓는다.
		<<if !$gwylanSeen.includes("cafe_walk")>>
			<<set $gwylanSeen.pushUnique("cafe_walk")>>
			<<if $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1 or $gwylanSeen.includes("petplay") and $worn.neck.type.includes("leash")>>
				<<set _magicLeash to true>>
				"학교 갈 시간 거의 다 됐지?" <<He>>【은는】 당신의 목줄을 잡아당겨 가까이 끌어당긴 뒤, 두 손가락으로 당신의 가슴을 쓸어올린다. "학교까지 데려다줄까?"
			<<else>>
				"학교 갈 시간 거의 다 됐지? 학교까지 데려다줄까?"
			<</if>>
		<<else>>
			<<if $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1 or $gwylanSeen.includes("petplay") and $worn.neck.type.includes("leash")>>
				<<set _magicLeash to true>>
				"이제 슬슬 가는 게 좋겠어, <<pcpetname "Gwylan" "my">>." <<He>>【은는】 당신의 목줄을 잡아당겨 가까이 끌어당긴 뒤, 두 손가락으로 당신의 가슴을 쓸어올린다. "학교에 지각하고 싶진 않을 거 아니야."
			<<else>>
				"이제 슬슬 가는 게 좋겠어, <<pcpetname "Gwylan" "simple">>. 학교에 지각하고 싶진 않을 거 아니야."
			<</if>>
		<</if>>
		<br><br>

		<<schoolicon "building">><<link [[학교로 걸어간다 (0:10)|Gwylan Walk School Solo]]>><<set $daily.gwylan.cafeSkip to true>><<pass 10>><<unset $cafe_study>><<storeon "cafe_balcony">><</link>>
		<br>
		<<refuseicon>><<link [[거절한다 (0:01)|Gwylan Walk School Solo Decline]]>><<pass 1>><<set $daily.gwylan.cafeSkip to false>><<set $daily.gwylan_skip_school to 1>><</link>>
		<br>
		<<exit>>
	<</if>>
	<<if $location is "cafe" and !["cafe", "cliff", "walking_to_cafe"].includes(_gwylanLocation)>>
		<<if !(between($chef_state, 7, 8) and $chef_rework lte 30)>>
			그윌란은 <<his>> 접시를 들고 일어난다. 갈매기 떼가 지나가는 순간, <<He>>【은는】 부스러기들을 허공에 흩뿌린다. 녀석들은 빵가루가 해변에 하나도 떨어지지 않게 다 주워 먹는다.
			<br><br>
		<</if>>

		"난 상점으로 돌아가야겠어." <<he>>【이가】 말한다.
		<<if $gwylan.request is "meetAtShop" and !$daily.gwylan.preventProgress>>
			"나중에 거기로 나 보러 오는 거 잊지 마, 꼭."
		<<elseif $daily.gwylan.ritualRequestBlocked and $gwylanSeen.includes("ritual_beast")>>
			"오늘 의식을 치르길 원한다면, 날 어디서 찾을 수 있는지 알겠지." <<He>>【은는】 윙크를 하고 발코니를 떠난다.
		<<else>>
			"같이 있어 줘서 고마워." <<He>>【은는】 인사를 하고 발코니를 떠난다.
		<</if>>
		<br><br>

		<<gwylanOptionsLeave>>
		<<exit>>
	<</if>>

	/* Leaving the forest shop for elsewhere */
	<<if $location is "forest_shop" and ["walking_to_cafe", "cafe", "cliff"].includes(_gwylanLocation) and !$daily.gwylan.cafeOfferDeclined>>
		그윌란의 시선이 근처에 있는 뻐꾸기시계에 고정되어 있다. <<He>>【은는】 갑자기 당신을 스쳐 지나가며, 받침대에서 <<his>> 모자와 우산을 챙긴다.
		<<if ["walking_to_cafe", "cafe"].includes(_gwylanLocation)>>
			<<if $gwylanSeen.includesAny("cafe_walk", "struggles") or $gwylan.sea gte 10>>
				"아침 먹을 시간이야." <<he>>【이가】 말한다.
				<<if Time.schoolDay and $gwylanSeen.includes("cafe_walk")>>
					"같이 갈래? 나중에 내가 학교까지 데려다줄 수도 있어."
				<<else>>
					"나랑 같이 갈래?"
				<</if>>
				<br><br>

				<<cafeicon>><<link [[그윌란과 걷는다 (0:15)|Gwylan Walk Cafe Solo]]>><<pass 15>><<set $phase to 0>><</link>>
				<br>
				<<refuseicon>><<link [[거절한다 (0:01)|Gwylan Walk Cafe Solo]]>><<pass 1>><<set $phase to 1>><<set $daily.gwylan.cafeOfferDeclined to true>><</link>>
			<<else>>
				"아침 먹을 시간이야." <<he>>【이가】 말한다. "미안해. <<if Time.season is "winter">>진저브레드<<else>>크레페<</if>>【은는】 누구도 기다려주지 않거든.<<if $gwylanSeen.includes("cafe")>> 이따가 카페에서 만날까?<</if>>"
				<br><br>

				<<gwylanOptionsLeave>>
			<</if>>
		<<else>>
			"난 이제..." <<He>>【은는】 잠시 확신이 서지 않는 듯한 표정을 짓는다. "미안해, 공사 때문에 내 일과가 망가져서 어떻게 해야 할지 잘 모르겠어. 클리프 가에 있을게."
			<br><br>

			<<gwylanOptionsLeave>>
		<</if>>
		<<exit>>
	<</if>>

	/* Normal options */
	<<if $location is "forest_shop" and _gwylanLocation is "sleep">>
		<<He>>【은는】 과장된 하품을 내뱉는다. "너랑 같이 있으면 정말 시간이 눈 깜짝할 사이에 지나간다니까. 난 이제 자러 갈게."
		<br><br>
	<<else>>
		<<if $location is "forest_shop">>
			<<set $daily.gwylan.clothesTalk ||= 0>>
			<<if $daily.gwylan.clothesTalk gte 3 and !$daily.gwylan.enoughTalk>>
				<<set $daily.gwylan.enoughTalk to true>>
				<<if $daily.gwylan.traumaTalk>>
					<<He>>【은는】 슬픈 미소를 띤다. "나한테 마음을 털어놔 줘서 고마워. 미안한데, 한꺼번에 받아들이기엔 너무 벅차네. 우리, 이야기는 다음 날 이어서 할 수 있을까?"
					<br><br>
					<span class="blue">그윌란에게는 당신이 한 말을 받아들일 시간이 필요하다.</span>
					<br><br>
				<<else>>
					<<He>>【은는】 기지개를 켠다. "네 이야기를 들려줘서 고마워. 하루에 소화할 수 있는 분량은 이 정도가 한계인 것 같네. 내일 이 시간에 또 볼까?"
					<br><br>
					<span class="blue">그윌란은 다른 날에 당신의 이야기를 더 듣고 싶어 한다.</span>
					<br><br>
				<</if>>
			<<elseif $daily.gwylan.enoughTalk>>
				<span class="blue">그윌란은 다른 날에 당신의 이야기를 더 듣고 싶어 한다.</span>
				<br><br>
			<</if>>
			<<gwylanOptionsSpecial>>
			<<if $gwylanSeen.includes("cafe_walk") and $exposed is 0 and (Time.hour === 6 && Time.minute >= 45 || Time.hour is 7)>>
				<<cafeicon>><<link [[함께 카페로 가자고 요청한다 (0:15)|Gwylan Walk Cafe Ask]]>><<pass 15>><</link>>
				<br>
			<</if>>
			<<gwylanOptionsRequest>>
			<<gwylanOptionsService>>
			<<gwylanOptionsClothing>>
		<</if>>

		<<if $forest_shop_intro and !$gwylanSeen.includes("clothes_intro")>>
			<<set $_askbr to true>>
			<<socialiseicon "ask">><<link [[그윌란에게 상점에 대해 묻는다 (0:10)|Gwylan Talk Clothes Intro]]>><<pass 10>><</link>>
			<br>
		<</if>>

		<<if $location is "cafe">>
			<<gwylanOptionsCafe>>
		<</if>>

		<<if $gwylanSeen.includes("yearning")>>
			<<gwylanOptionsGift>>
		<</if>>
	<</if>>
	<<gwylanOptionsLeave>>
<</widget>>

<<widget "gwylanOptionsSpecial">>
	<<if !_hideRitualOptions>>
		<<if $gwylanSeen.includes("ritual_beast")>>
			<<if $gwylan.timer.ritual and Time.date.dayDifference(new DateTime(V.gwylan.timer.ritual)) > 0>>
				<<set _ritualDays to Time.date.dayDifference(new DateTime(V.gwylan.timer.ritual))>>
				<<if _ritualDays gt 7>>
					<<set $gwylan.timer.ritual to Time.date.timeStamp + (7 * 86400)>>
					<<set _ritualDays to 7>>
				<</if>>
				<<set $_askbr to true>>
				<<icon "clothes/witch-hat-sage.png">><span class="pink">그윌란은 <<number _ritualDays>>일 뒤에 다음 의식을 준비할 것입니다.</span>
			<<elseif $gwylanSeen.includes("ritual_sex_intro")>>
				<<set $_askbr to true>>
				<<icon "clothes/witch-hat-sage.png">><<link [[`<<his>> 의식에서 그윌란을 돕는다 (?:??)`|Gwylan Ritual Select]]>><</link>>
			<<else>>
				<<set $_askbr to true>>
				<<icon "clothes/witch-hat-sage.png">><<link [[`<<his>> 의식에서 그윌란을 돕는다 (?:??)`|Gwylan Forest Journey Prep]]>><<endevent>><</link>>
			<</if>>
			<br>
			<<if (!$gwylan.timer.sample or $gwylan.timer.sample lte Time.date.timeStamp) and !["meetAtCafe", "sample"].includes($gwylan.request.event)>>
				<<set $_askbr to true>>
				<<if $gwylanSeen.includes("sample")>>
					<<ind>><<link [[그윌란이 측정 부적을 교체하는 것을 돕는다|Gwylan Request Sample]]>><</link>>
				<<else>>
					<<ind>><<link [[그윌란에게 세상의 독에 대해 묻는다|Gwylan Request Sample]]>><</link>>
				<</if>>
				<br>
			<</if>>
		<<elseif !$gwylanSeen.includes("ritual_beast") and $gwylan.request.event is "meetAtShop" and !$daily.gwylan.preventProgress>>
			<<set $_askbr to true>>
			<<socialiseicon "ask">><<link [[그윌란을 돕는다 (?:??)|Gwylan Forest Journey Prep]]>><<endevent>><</link>>
			<br>
		<</if>>
	<</if>>

	/* ToDo: Gwylan ToDo: Magic Tattoos */
	<<if $gwylanSeen.includes("ritual_beast") and !$gwylanSeen.includes("tattoos_intro")>>
		<<set $_askbr to true>>
		<<ind>><<link [[`<<his>> 문신에 대해 그윌란에게 묻는다`|Gwylan Talk Tattoos Intro]]>><</link>>
		<br>
	<</if>>
	<<if $gwylanSeen.includes("gwylan_ears") and !$gwylanSeen.includesAny("gwylan_ears_talk", "gwylan_tf_revealed") and $gwylanSeen.includes("hat_found")>>
		<<set $_askbr to true>>
		<<icon "clothes/witch-hat-sage.png">><<link [[`<<his>> 모자에 달린 귀에 대해 그윌란에게 묻는다 (0:05)`|Gwylan Talk TF Ears]]>><<pass 5>><</link>>
		<br>
	<</if>>
	<<if $gwylanSeen.includes("gwylan_tail") and !$gwylanSeen.includesAny("gwylan_tail_talk", "gwylan_tf_revealed")>>
		<<set $_askbr to true>>
		<<ind>><<link [[`<<his>> 가짜 꼬리에 대해 그윌란에게 묻는다 (0:05)`|Gwylan Talk TF Tail]]>><<pass 5>><</link>>
		<br>
	<</if>>
	<<if $gwylanSeen.includes("gwylan_fangs") and !$gwylanSeen.includesAny("gwylan_fangs_talk", "gwylan_tf_revealed")>>
		<<set $_askbr to true>>
		<<ind>><<link [[`<<his>> 날카로운 이에 대해 그윌란에게 묻는다 (0:05)`|Gwylan Talk TF Fangs]]>><<pass 5>><</link>>
		<br>
	<</if>>
	<<if $gwylanSeen.includesAll("gwylan_ears_talk", "gwylan_tail_talk", "gwylan_fangs_talk") and $settings.transformAnimalEnabled and ($gwylanTalked.includes("transformation") or $gwylanSeen.includes("player_tf")) and !$gwylanSeen.includes("gwylan_tf_revealed")>>
		<<set $_askbr to true>>
		<<icon "transformation.png">><<link [[`<<his>> 여우 같은 모습에 대해 그윌란을 추궁한다 (0:05)`|Gwylan Talk TF Revealed Confront]]>><<pass 5>><</link>>
		<br>
	<</if>>
	<<if $avery_mansion>>
		<<if $avery_mansion.fox.known and $avery_mansion.fox.end and !$brownFoxRevealed and $gwylanTalked.includes("fox_mask") and ($brownFoxWoundedHint or $gwylanSeen.includes("yearning"))>>
			<<set $_askbr to true>>
			<<icon "clothes/fox-mask.png">><<link [[`여우 가면을 써 보라고 <<him>>에게 부탁한다 (0:05)`|Gwylan Talk Brown Fox]]>><<pass 5>><</link>>
			<br>
		<<elseif $brownFoxRevealed and !$brownFoxMaskTalk and $gwylanTalked.includes("fox_mask") and $avery_fate>>
			<<set $_askbr to true>>
			<<icon "clothes/fox-mask.png">><<link [[갈색 여우 가면에 대해 묻는다 (0:05)|Gwylan Talk Brown Fox Mask]]>><<pass 5>><</link>>
			<br>
		<</if>>
	<</if>>
	<<if $_askbr>><br><</if>>
<</widget>>

<<widget "gwylanOptionsRequest">>
	<<if !$gwylan.request.event and $gwylanSeen.includes("hat_found")>>
		<<set $_reqbr to true>>
		<<socialiseicon "ask">><<link [[`도움이 필요한 일이 있는지 <<him>>에게 묻는다`|Gwylan Request]]>><</link>>
		<br>
	<</if>>
	<<if $harpy gte 6 and $birdFly gte 1 and $gwylan.request.event isnot "preen" and !$plucked and $gwylanSeen.includesAny("preen", "request_preen")>>
		<<set $_reqbr to true>>
		<<tficon "bird">><<link [[`당신의 깃털을 다듬어 달라고 <<him>>에게 부탁한다 (0:40)`|Gwylan Request Preen]]>><</link>><<lstress>><<garousal>>
		<br>
	<</if>>
	<<if $gwylan.request.event and $location is "forest_shop">>
		<<switch $gwylan.request.event>>
			<<case "clothing">>
				<<if gwylanRequestMet()>>
					<<set $_reqbr to true>>
					<<set $_iconItem to $gwylan.request.items.find(item => item.root)>><<set $_iconWorn to V.worn[$_iconItem.slot]>>
					<<clothingicon $_iconWorn $_iconItem.slot>>
					<<if $gwylan.request.special and $gwylan.request.special isnot "none">>
						<<set $_specialTextKR to {
							"gas mask": "가스 마스크",
							"maid": "메이드",
							"waiter": "웨이터",
							"waitress": "웨이트리스",
							"nurse": "간호사",
							"plastic nurse": "비닐 간호사",
							"gothic": "고딕",
							"karate": "가라테",
							"sailor": "세일러",
							"short sailor": "짧은 세일러",
							"football": "미식축구",
							"cheerleader": "치어리더",
							"cowboy": "카우보이",
							"bunny": "버니",
							"kitty": "고양이"
						}[$gwylan.request.special] ?? $gwylan.request.special>>
            <<if $gwylan.request.special is "gold accessories">>
                <<link [[`금 장신구를 <<him>>에게 보여준다`|Gwylan Request Clothes Complete]]>><</link>>
            <<elseif $gwylan.request.details.outfit>>
                <<link [[`$_specialTextKR 복장을 <<him>>에게 보여준다`|Gwylan Request Clothes Complete]]>><</link>>
            <<else>>
                <<link [[`$_specialTextKR【을를】 <<him>>에게 보여준다`|Gwylan Request Clothes Complete]]>><</link>>
            <</if>>
        <<elseif $_iconWorn.name>>
						<<link [[`$_iconWorn.name【을를】 <<him>>에게 보여준다`|Gwylan Request Clothes Complete]]>><</link>>
					<<else>>
						<<link [[`<<he>>【이가】 부탁한 옷을 <<him>>에게 보여준다`|Gwylan Request Clothes Complete]]>><</link>>
					<</if>>
					<br>
				<<elseif $earSlime.forcedDressing and $gwylan.request.items.some(item => ![V.earSlime.forcedDressing, "n"].includes(item.gender)) ||
					$earSlime.forcedCommando gte 0 && $gwylan.request.items.some(item => item.slot === "under_lower") ||
					$gwylan.request.items.some(item => item.reveal lt earSlimeCorruptionClothes() && setup.clothingLayer.torso.includes(item.slot))>>
					<<set $_reqbr to true>>
					<<set _earSlimeText to numberOfEarSlime() gt 1 ? "귀 슬라임들" : "귀 슬라임">>
					<<socialiseicon "angry">><<link [[`_earSlimeText 때문에 <<his>> 부탁을 들어줄 수 없다고 <<him>>에게 말한다`|Gwylan Talk Ear Slime Clothes]]>><</link>>
					<br>
				<</if>>
			<<case "ingredients">>
				<<if $gwylan.request.special is "tutorial" and $gwylanTutorialShrooms + $foodstuff.wolfshroom.amount gte 3>>
					<<set $_reqbr to true>>
					<<foodstufficon "wolfshroom">><<link [[`늑대버섯을 <<him>>에게 준다`|Gwylan Request Tutorial Complete]]>><</link>>
					<br>
				<<elseif gwylanRequestMet()>>
					<<set $_reqbr to true>>
					<<set $_iconItem to $gwylan.request.items.find(item => item.root)>>
					<<foodstufficon $_iconItem.name>><<link [[`<<he>>【이가】 부탁한 재료를 <<him>>에게 준다`|Gwylan Request Ingredients Complete]]>><</link>>
					<br>
				<</if>>
			<<case "sample">>
				<<if gwylanRequestMet()>>
					<<set $_reqbr to true>>
					<<scienceicon>><<link [[`샘플을 <<him>>에게 준다`|Gwylan Request Sample Complete]]>><</link>>
					<br>
				<</if>>
			<<case "samplePlayer">>
				/* ToDo: Gwylan */
			<<case "cream">>
				<<set $_reqbr to true>>
				<<foodstufficon "cream">><<link [[`<<his>> 음란한 제안을 받아들인다`|Gwylan Request Cream]]>><</link>>
				<br>
			<<case "preen">>
				<<if $harpy gte 6 and $gwylan.request.special is "harpy">>
					<<set $_reqbr to true>>
					<<tficon "bird">><<link [[`당신의 날개를 다듬도록 <<him>>에게 맡긴다 (0:40)`|Gwylan Request Preen]]>><</link>><<lstress>><<garousal>>
					<br>
					<<if $bird?.materials?.feathers gte 10>>
						<<birdicon "feathers">><<link [[`대신 깃털 10개를 <<him>>에게 준다`|Gwylan Request Feathers]]>><<set $phase to 1>><</link>>
						<br>
					<</if>>
				<<elseif $bird?.materials?.feathers gte $gwylan.request.items.find(feather => feather.name === "feathers").need or $harpy gte 6>>
					<<set $_reqbr to true>>
					<<if $bird?.materials?.feathers gte $gwylan.request.items.find(feather => feather.name === "feathers").need>>
						<<birdicon "feathers">><<link [[`요청받은 깃털을 <<him>>에게 준다`|Gwylan Request Feathers]]>><<set $phase to 2>><</link>>
						<br>
					<</if>>
					<<if $harpy gte 6>>
						<<tficon "bird">><<link [[`대신 당신의 날개를 다듬도록 <<him>>에게 맡긴다 (0:40)`|Gwylan Request Preen]]>><</link>><<lstress>><<garousal>>
						<br>
					<</if>>
				<</if>>
			<<case "chastity">>
				<<if !playerChastity()>>
					<<lockicon "unlock">><<link [[`정조대가 제거됐다고 <<him>>에게 말한다`|Gwylan Chastity Removed]]>><</link>>
					<br>
				<<elseif playerChastity() and gwylanRequestMet()>>
					<<lockicon "unlock">><<link [[`<<he>>【이가】 부탁한 물건을 <<him>>에게 준다 (1:00)`|Gwylan Chastity Removal Gold]]>><<pass 20>><</link>>
					<br>
				<</if>>
			<<default>>
				/* Request not applicable to interaction here */
		<</switch>>
		/* Necessary to avoid an uncompletable request if the golden chastity belt is removed before the request is turned in */
		<<if $gwylan.request.event is "recipe" and $gwylan.request.special is "chastity" and !playerChastity()>>
			<<lockicon "unlock">><<link [[`정조대가 제거됐다고 <<him>>에게 말한다`|Gwylan Chastity Removed]]>><</link>>
			<br>
		<</if>>
		<<if !gwylanRequestMet() and !$gwylan.request.command and $debug is 1>>
			/* ToDo: Gwylan - rerolling requests */
			<span class="red">개발자 메모: 의뢰 재추첨은 아직 구현되지 않았습니다. 현재 의뢰를 초기화합니다. 부주의하게 사용하면 스토리 진행이 완전히 망가질 수 있습니다.</span>
			<br>
			<<set $_reqbr to true>>
			<<icon "cross.png">><<link [[그윌란에게 다른 것을 해도 되냐고 묻는다|Forest Shop Entrance]]>><<gwylanRequestEnd "skip">><<endevent>><</link>>
			<br>
		<</if>>
	<</if>>
	<<if $_reqbr>><br><</if>>
<</widget>>

<<widget "gwylanOptionsService">>
	<<if playerChastity() and $gwylan.request.hold isnot "chastity" and ($gwylanSeen.includesAny("chastity", "partners") or $gwylanJordanChastity or $gwylan.request.event is "chastity" and !$gwylan.request.items?.length)>>
		<<if $gwylan.requestLast?.hold is "chastity" and (!$gwylan.request.event or $gwylan.request.event is "chastity")>>
			<<lockicon>><<link [[정조대를 제거하는 걸 도와달라고 부탁한다|Gwylan Chastity Removal]]>><<set $phase to "skip">><</link>>
		<<else>>
			<<lockicon>><<link [[정조대를 제거하는 걸 도와달라고 부탁한다|Gwylan Chastity Removal]]>><</link>>
		<</if>>
		<br>
	<</if>>
	<<if !$gwylan.taken and $worn.neck.name is "familiar collar" and $gwylanSeen.includes("familiar_collar") and $daily.gwylan.collar_lock isnot 2>>
		<<if $worn.neck.cursed is 1>>
			<<icon "clothes/familiar-collar.png">><<link [[사역마 목걸이를 풀어 달라고 그윌란에게 부탁한다|Gwylan Familiar Collar Unlock]]>><</link>>
		<<else>>
			<<icon "clothes/familiar-collar.png">><<link [[사역마 목걸이를 채워 달라고 그윌란에게 부탁한다|Gwylan Familiar Collar Lock]]>><</link>><<gwylanHypnoNote>>
		<</if>>
		<br>
	<</if>>
	<<if $gwylanSeen.includesAll("partners", "familiar_collar") and (!$gwylan.timer.petBed or $gwylan.timer.petBed and Time.date.dayDifference(new DateTime(V.gwylan.timer.petBed)) <= 1) and $gwylan.request.hold isnot "petBed" and ($tiredness gte 1000 or $gwylanSeen.includes("doggy_bed"))>>
		<<if $gwylan.timer.petBed and Time.date.dayDifference(new DateTime(V.gwylan.timer.petBed)) <= 1>>
			<<bedicon "gwylanpet">><<link [[펫 침대를 한 주 더 꺼내 둬 달라고 그윌란에게 부탁한다|Gwylan Dog Bed Request]]>><</link>>
		<<elseif $gwylanSeen.includes("doggy_bed")>>
			<<bedicon "gwylanpet">><<link [[펫 침대를 다시 끌어내 달라고 그윌란에게 부탁한다|Gwylan Dog Bed Request]]>><</link>>
		<<else>>
			<<bedicon "default">><<link [[여기서 자도 되는지 그윌란에게 묻는다|Gwylan Dog Bed Request]]>><</link>>
		<</if>>
		<br>
	<</if>>
	<<if !_hideHypnosisOptions>>
		<<if $gwylanSeen.includes("player_tf")>>
			<<if $angel gte 4 or $fallenangel gte 2 or $demon gte 4 or $wolfgirl gte 4 or $cat gte 4 or $cow gte 4 or $harpy gte 4 or $fox gte 4>>
				<<set $_hypnobr to true>>
				<<icon "transformation.png">><<link [[내면의 자신을 받아들이도록 도와달라고 부탁한다|Gwylan Hypnosis Start]]>><<set $phase to "peace">><</link>><<gwylanHypnoNote>>
				<br>
			<</if>>
		<</if>>
		<<if numberOfEarSlime(true)>>
			<<if ($gwylanJordanSlime or $gwylanSeen.includes("ear_slime_intro")) and !$gwylanSeen.includes("ear_slime")>>
				<<set $_hypnobr to true>>
				<<socialiseicon "ask">><<link [[귀 슬라임에 대해 묻는다|Gwylan Talk Ear Slime]]>><</link>>
				<br>
			<<elseif $gwylanSeen.includes("ear_slime")>>
				<<set $_hypnobr to true>>
				<<hypnosisicon>><<link [[귀 슬라임을 잠재우는 걸 도와달라고 부탁한다|Gwylan Hypnosis Start]]>><<set $phase to "silence">><</link>><<gwylanHypnoNote>>
				<br>
			<</if>>
		<</if>>
		<<if $gwylanSeen.includes("request_intro") and $sleeptrouble gte 1>>
			<<set $_hypnobr to true>>
			<<bedicon "zzz">><<link [[잠들기 어렵다고 그윌란에게 말한다|Gwylan Hypnosis Start]]>><<set $phase to "slumber">><</link>><<gwylanHypnoNote>>
			<br>
		<</if>>
		/* ToDo: Gwylan - make proper unlock condition */
		<<if $gwylanSeen.includes("ritual_beast") and $hallucinations gte 2>>
			<<set $_hypnobr to true>>
			<<symbol "awareness">><<link [[환각에 대해 도와달라고 그윌란에게 부탁한다|Gwylan Hypnosis Start]]>><<set $phase to "insight">><</link>><<gwylanHypnoNote>>
			<br>
		<</if>>
		<<if $gwylanSeen.includes("request_intro") and Object.keys(V.hypnosis_traits).filter(trait => ["suggestion", "scream", "cover", "deviancy"].includes(trait) && V.hypnosis_traits[trait] >= 1).length>>
			<<set $_hypnobr to true>>
			<<hypnosisicon>><<link [[최면을 잊는 걸 도와달라고 부탁한다|Gwylan Hypnosis Start]]>><<set $phase to "removal">><</link>><<gwylanHypnoNote>>
			<br>
		<</if>>
		<<if $_hypnobr>><br><</if>>
	<</if>>

	/* ToDo: Gwylan - Sneaking into the garden */

	/* ToDo: Gwylan - Punishments for disobedience, including familiar collar */

	/* ToDo: Gwylan - break down to Gwylan about your troubles? Leads to existing fruit trauma scene. */

	/* ToDo: Gwylan - Telling Gwylan about misc troubles. Pool of possible scenes based on trauma, traits, etc. Could unlock hypnosis services.
	'tell Gwylan you've been having trouble sleeping' etc.
	V.gwylan.request.missed is 1 or V.gwylan.timer.lastSeen too high, say player feels bad about not seeing Gwylan
	*/

	/* ToDo: Gwylan - basic service unrelated to hypno that can be done without cooldown? */

<</widget>>

<<widget "gwylanOptionsClothing">>
	<<if $gwylanSeen.includes("clothes_intro")>>
		<<if $daily.gwylan.enoughTalk>>
			/* Nothing */
		<<else>>
			/* Get sets that the player can talk about */
			<<set $_setsAtForestShop to getSpecialSets(sets => sets.shop.includes("forest"))>>
			/* Get unlocked sets */
			<<set $_setsUnlocked to getUnlockedSpecialSets().filter(set => $_setsAtForestShop.includes(set) && !$gwylanTalked.includes(set))>>
			<<if !$gwylanSeen.includesAny("clothes_talk_cheated", "clothes_talk_bypassed")>>
				/* Count cheat sets for one-time event */
				<<set $_setsCheated to getUnlockedSpecialSets(V.specialClothes.filter(c => c.unlocked === 1).map(c => c.name)).filter(set => $_setsAtForestShop.includes(set) && !$gwylanTalked.includes(set))>>
				<<set $_setsUnlocked to $_setsUnlocked.concat($_setsCheated)>>
			<</if>>
			<<if !$gwylanSeen.includes("clothes_talk_bypassed")>>
				/* Count feat sets for one-time event */
				<<set $_setsBypassed to getUnlockedSpecialSets(V.specialClothes.filter(c => c.unlocked === 2).map(c => c.name)).filter(set => $_setsAtForestShop.includes(set) && !$gwylanTalked.includes(set))>>
				<<set $_setsUnlocked to $_setsUnlocked.concat($_setsBypassed)>>
			<</if>>
			<div class="no-numberify">
				/* Talk to Gwylan about further heists after catsuit conversation */
				<<if $gwylanTalked.includes("catsuit") and
				(($bird?.hunts?.estate is "complete" and !$gwylanTalked.includes("heist_silver")) or
				($lakestealgold is 1 and !$gwylanTalked.includes("heist_gold")) or
				($compound?.symbol.includes("docks") and !$gwylanTalked.includes("symbol")) or
				(($wrenHeist or $wrenSeen?.includes("heist")) and !$gwylanTalked.includes("heist_wren")))>>
					<<set $_catsuit to clone(setup.clothes.upper[75])>>
					<<set $_catsuit.colour to "black">>
					<<clothingicon $_catsuit "upper">><<link [[`당신의 범죄 행각에 대해 <<him>>에게 말한다`|Gwylan Talk Heists]]>><<set $phase to "silver">><</link>>
					<br>
				<</if>>
				<<if !$gwylanSeen.includes("clothes_talk_savescum") and _saveLoaded>>
					<<if localStorage.getItem("gwylanTalk") is "seen">>
						<<set $gwylanSeen.pushUnique("clothes_talk_savescum")>>
					<<elseif localStorage.getItem("gwylanTalk") is "nobody">>
						<!-- Do nothing. Don't trigger savescum message if nobody happens -->
					<<elseif !localStorage.getItem("gwylanTalk")>>
						<<run localStorage.setItem("gwylanTalk", 0)>>
					<<else>>
						<<run localStorage.setItem("gwylanTalk", Number(localStorage.getItem("gwylanTalk")) + 1)>>
					<</if>>
				<</if>>
				<<for $_label, _value range $_setsUnlocked>>
					<<set $_subsetVals to Object.keys(setup.specialClothesSets).filter(set => setup.specialClothesSets[set].subsetOf?.includes(_value))>>
					<<if $gwylanTalked.includesAll($_subsetVals)>>
						<<set $_clothesbr to true>>
						/* If value is a set that includes other sets, such as 'halloween', do not show the talk link unless all of its subsets have been talked about already. */
						/* Empty arrays are valid to bypass this check, which is intended. */
						/* Get icon provided by setup */
						<<set _timeToPass to $_subsetVals.length ? 20 : 15>>
						<<set $_clothingObject to clone(setup.specialClothesSets[_value])>>
						<<if $_clothingObject.icon is "clothes">>
							<<set $_cIcon to clone(setup.clothes[$_clothingObject.iconSlot][$_clothingObject.iconIndex])>>
							<<set $_cIcon.colour to $_clothingObject.iconColor>><<set $_cIcon.accessory_colour to $_clothingObject.iconAccColor>>
							<<clothingicon $_cIcon $_clothingObject.iconSlot>>
						<<else>>
							<<set $_cIcon to $_clothingObject.icon>>
							<<icon $_cIcon>>
						<</if>>
						/* Passage names are "Gwylan Talk Clothes " + the set name from setup in title case with underscores removed */
						<<set _incomingPassageText to toTitleCase(_value.replace(/_/g," "))>>
						<<capture _value, _incomingPassageText, _timeToPass>>
							<<if Number(localStorage.getItem("gwylanTalk")) gte 1>>
								<<link [[`$_clothingObject.text【을를】 <<him>>에게 보여준다`|Gwylan Talk Clothes Savescum]]>><<set $clothesBeingTalkedAbout to _value>><</link>>
								<br>
							<<elseif !$_setsAtForestShop.includes(_value) or !setup.specialClothesSets[_value]>>
								<<link [[`$_clothingObject.text【을를】 <<him>>에게 보여준다`|Gwylan Talk Clothes Error]]>><<set $clothesBeingTalkedAbout to _value>><</link>>
								<br>
							<<elseif $_setsCheated?.includes(_value)>>
								<<link [[`$_clothingObject.text【을를】 <<him>>에게 보여준다`|Gwylan Talk Clothes Cheated]]>><<set $clothesBeingTalkedAbout to _value>><</link>>
								<br>
							<<elseif $_setsBypassed?.includes(_value)>>
								<<link [[`$_clothingObject.text【을를】 <<him>>에게 보여준다`|Gwylan Talk Clothes Bypassed]]>><<set $clothesBeingTalkedAbout to _value>><</link>>
								<br>
							<<else>>
								<<if $_subsetVals.length>>
									<<link [[`$_clothingObject.text에 대해 <<him>>에게 묻는다 (0:_timeToPass)`|`Gwylan Talk Clothes `+ _incomingPassageText]]>><<set $gwylanPassTime to _timeToPass>><</link>><<glove>>
								<<else>>
									<<link [[`$_clothingObject.text【을를】 <<him>>에게 보여준다 (0:_timeToPass)`|`Gwylan Talk Clothes `+ _incomingPassageText]]>><<set $gwylanPassTime to _timeToPass>><</link>><<glove>>
								<</if>>
								<br>
							<</if>>
						<</capture>>
					<</if>>
				<</for>>
			</div>
		<</if>>
		<<if $_clothesbr>><br><</if>>
	<</if>>
<</widget>>

<<widget "gwylanOptionsGift">>
	<<if $location is "forest_shop" and checkSextoysGift("Gwylan") and C.npc.Gwylan.penis is "none" and checkIfNPCHasCategorySextoy("Gwylan","strap-on").length <= 5>>
		<<set $_giftbr to true>>
		<<for _key range Object.keys(V.NPCName[7].sextoys).filter(t => V.NPCName[7].sextoys[t][0].gift_state === "held")>>
			<<set _toy to V.NPCName[7].sextoys[_key][0]>>
			<<set _icon to `sex-toys/${_toy.name.replace(/ /g, "-")}.png`>>
			<span @class="`clothes-${_toy.colour}`"><<icon _icon>></span>
			<<set _toyColourKr to _toy.colour ? setup.colourName(_toy.colour) + " " : "">>
			<<capture _toy, _toyColourKr>>
				<<link [[`${_toyColourKr}${_toy.namecap}【을를】 그윌란에게 선물한다`|Gwylan Gift Strap-on]]>>
					<<endevent>>
					<<set $phase to _toy.name>>
					<<set _toy.gift_state to "received">>
					<<generateNewStrapon _toy.size _toy.colour _toy.shape>>
					<<giveNNPCnewstrapon "Gwylan">>
				<</link>>
			<</capture>>
			<br>
		<</for>>
		<br>
	<</if>>
	<<if canGiftFood("Gwylan") and $location isnot "cliff">>
		<<set $_giftbr to true>>
		<<skinicon "give">><<link [[그윌란에게 음식을 준다|Gwylan Gifts List]]>><</link>>
		<br>
	<</if>>
	<<if $_giftbr>><br><</if>>
<</widget>>

<<widget "gwylanOptionsCafe">>
	<<set $_schoolWalkAvailable to ($gwylanSeen.includes("cafe_walk") or ($gwylan.sea + ($gwylanTalked.count("fox_mask") * 20) + ($gwylanTalked.count("dark_pendant") * 20) gte 40)) or ($gwylan.robin gte 10 and $daily.robin_in_cafe and false)>> /* WARNING! Re-enable later for Gwybin cafe */
	<<if $_schoolWalkAvailable and Time.schoolDay and ((Time.hour is 7 and Time.minute gte 45) or (Time.hour is 8 and Time.minute lte 35)) and !$daily.gwylan_skip_school>>
		<<set _passTime to "<<passTimeUntil 8 45>><<set $daily.gwylan.cafeSkip to true>>">><<set _passTimeDisplay to "0:" + ("0" + ((45 - Time.minute + 60) % 60)).slice(-2)>>
		<<if _passTimeDisplay is "0:00">><<set _passTimeDisplay to "1:00">><</if>>
	<<elseif $_schoolWalkAvailable and Time.schoolDay and Time.hour is 8 and Time.minute gt 35 and !$daily.gwylan_skip_school>>
		<<set _passTime to "<<pass 10>><<set $daily.gwylan.cafeSkip to true>>">><<set _passTimeDisplay to "0:10">>
	<<elseif Time.hour lte 7 or (Time.hour is 8 and Time.minute lt 10)>>
		<<set _passTime to "<<pass 1 hour>>">><<set _passTimeDisplay to "1:00">>
	<<elseif Time.hour is 8 and Time.minute lte 20>>
		<<set _passTime to "<<passTimeUntil 9 20>><<set $daily.gwylan.cafeSkip to true>>">><<set _passTimeDisplay to "1:" + ("0" + (20 - Time.minute)).slice(-2)>> /* Because why stop socialising only minutes before you're going to leave anyway? */
	<<elseif Time.hour is 9 and Time.minute gte 10>>
		<<set _passTime to "<<pass 10>><<set $daily.gwylan.cafeSkip to true>>">><<set _passTimeDisplay to "0:10">> /* So that Gwylan stays a little while longer if the player just arrived. */
	<<else>>
		<<set _passTime to "<<passTimeUntil 9 20>><<set $daily.gwylan.cafeSkip to true>>">><<set _passTimeDisplay to "0:" + ("0" + ((20 - Time.minute + 60) % 60)).slice(-2)>>
	<</if>>
	<<beachicon>><<link [[<<him>>【와과】 함께 바다를 본다 (_passTimeDisplay)|Gwylan Ocean Breeze Watch]]>>_passTime<<stress -6>><<trauma -3>><<willpower 1>><</link>><<lstress>><<ltrauma>><<gwillpower>>
	<br>
	<<if $location is "cafe" and !(between($chef_state, 7, 8) and $chef_rework lte 30) and $daily.cafeEaten isnot 1>>
		<<if $money gte 200>>
			<<foodicon "coffee">><<link [[커피를 산다 (_passTimeDisplay £2)|Gwylan Ocean Breeze Watch]]>>
				<<set $phase to "coffee">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -200 "cafe">>
				<<stress -9>><<trauma -3>><<tiredness -4>><<willpower 1>>_passTime
			<</link>><<lstress>><<ltrauma>><<ltiredness>><<gwillpower>>
			<br>
		<</if>>
		<<if $money gte 700>>
			<<if Time.season is "winter">>
				<<foodicon "winterale">>
				<<if playerIsPregnant() and playerAwareTheyArePregnant()>>
					<span class="blue">임신한 것을 아는 상태에서 차마 겨울 에일을 마실 수는 없다.</span>
				<<else>>
					<<link [[겨울 에일을 산다 (_passTimeDisplay £7)|Gwylan Ocean Breeze Watch]]>>
						<<set $phase to "winter ale">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -700 "cafe">>
						<<stress -12>><<drunk 100>><<willpower 1>>_passTime
					<</link>><<llstress>><<ggdrunk>><<gwillpower>>
				<</if>>
				<br>
			<<elseif Time.season is "spring">>
				<<foodicon "fruityale">>
				<<if playerIsPregnant() and playerAwareTheyArePregnant()>>
					<span class="blue">임신한 것을 아는 상태에서 차마 과일 에일을 마실 수는 없다.</span>
				<<else>>
					<<link [[과일 에일을 산다 (_passTimeDisplay £7)|Gwylan Ocean Breeze Watch]]>>
						<<set $phase to "fruity ale">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -700 "cafe">>
						<<stress -12>><<drunk 60>><<willpower 1>>_passTime
					<</link>><<llstress>><<gdrunk>><<gwillpower>>
				<</if>>
				<br>
			<<elseif Time.season is "summer">>
				<<foodicon "shandy">>
				<<if playerIsPregnant() and playerAwareTheyArePregnant()>>
					<span class="blue">임신한 것을 아는 상태에서 차마 섄디를 마실 수는 없다.</span>
				<<else>>
					<<link [[섄디를 산다 (_passTimeDisplay £7)|Gwylan Ocean Breeze Watch]]>>
						<<set $phase to "shandy">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -700 "cafe">>
						<<stress -12>><<drunk 40>><<willpower 1>>_passTime
					<</link>><<llstress>><<gdrunk>><<gwillpower>>
				<</if>>
				<br>
			<<else>>
				<<foodicon "autumnale">>
				<<if playerIsPregnant() and playerAwareTheyArePregnant()>>
					<span class="blue">임신한 것을 아는 상태에서 차마 가을 에일을 마실 수는 없다.</span>
				<<else>>
					<<link [[가을 에일을 산다 (_passTimeDisplay £7)|Gwylan Ocean Breeze Watch]]>>
						<<set $phase to "autumn ale">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -700 "cafe">>
						<<stress -12>><<drunk 80>><<willpower 1>>_passTime
					<</link>><<llstress>><<gdrunk>><<gwillpower>>
				<</if>>
				<br>
			<</if>>
		<</if>>
		<<if $money gte 300>>
			/* ToDo: Gwylan - bringing a milkshake to Gwylan at the forest shop */
			<<if getRobinLocation() is "cafe">>
				<<if $gwylanSeen.includes("yearning")>>
					<<foodicon "milkshake">><<link [[밀크쉐이크를 사서 그윌란과 나눠 먹는다 (_passTimeDisplay £3)|Gwylan Ocean Breeze Watch]]>>
						<<set $phase to "milkshake">><<set $phase2 to 2>><<set $daily.cafeEaten to 1>><<money -300 "cafe">>
						<<stress -12>><<willpower 1>>_passTime
					<</link>><<llstress>><<gwillpower>>
					<br>
				<</if>>
				<<if $robinromance is 1>>
					<<foodicon "milkshake">><<link [[밀크쉐이크를 사서 로빈과 나눠 먹는다 (_passTimeDisplay £3)|Gwylan Ocean Breeze Watch]]>>
						<<set $phase to "milkshake">><<set $phase2 to 3>><<set $daily.cafeEaten to 1>><<money -300 "cafe">>
						<<stress -12>><<willpower 1>>_passTime
					<</link>><<llstress>><<gwillpower>>
					<br>
				<</if>>
				<<if $gwylanSeen.includes("yearning") and $robinromance is 1>>
					<<foodicon "milkshake">><<link [[밀크쉐이크를 사서 둘 모두와 나눠 먹는다 (_passTimeDisplay £3)|Gwylan Ocean Breeze Watch]]>>
						<<set $phase to "milkshake">><<set $phase2 to 4>><<set $daily.cafeEaten to 1>><<money -300 "cafe">>
						<<stress -12>><<willpower 1>>_passTime
					<</link>><<llstress>><<gwillpower>>
					<br>
				<</if>>
			<<else>>
				<<if $gwylanSeen.includes("yearning")>>
					<<foodicon "milkshake">><<link [[밀크쉐이크를 사서 나눠 먹는다 (_passTimeDisplay £3)|Gwylan Ocean Breeze Watch]]>>
						<<set $phase to "milkshake">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -300 "cafe">>
						<<stress -12>><<willpower 1>>_passTime
					<</link>><<llstress>><<gwillpower>>
					<br>
				<</if>>
			<</if>>
		<</if>>
		<<if $money gte 500>>
			<<foodicon "fruitsalad">>
			<<link [[과일 샐러드를 산다 (_passTimeDisplay £5)|Gwylan Ocean Breeze Watch]]>>
				<<set $phase to "fruit salad">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -500 "cafe">>
				<<stress -12>><<trauma -3>><<willpower 1>>_passTime
			<</link>><<lstress>><<ltrauma>><<gwillpower>>
			<br>
		<</if>>
		<<if $money gte 600 and Time.season is "winter">>
			<<foodicon "gingerbread">>
			<<link [[진저브레드를 산다 (_passTimeDisplay £6)|Gwylan Ocean Breeze Watch]]>>
				<<set $phase to "gingerbread">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -600 "cafe">>
				<<stress -14>><<willpower 1>>_passTime
			<</link>><<llstress>><<gwillpower>>
			<br>
		<</if>>
		<<if $money gte 1000>>
			<<foodicon "pancakes">>
			<<link [[팬케이크를 산다 (_passTimeDisplay £10)|Gwylan Ocean Breeze Watch]]>>
				<<set $phase to "pancakes">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -1000 "cafe">>
				<<stress -6>><<trauma -3>><<tiredness -6>><<willpower 1>>_passTime
			<</link>><<lstress>><<ltrauma>><<ltiredness>><<gwillpower>>
			<br>
			<<foodicon "crepes">>
			<<link [[크레페를 산다 (_passTimeDisplay £10)|Gwylan Ocean Breeze Watch]]>>
				<<set $phase to "crepes">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -1000 "cafe">>
				<<stress -3>><<trauma -6>><<tiredness -6>><<willpower 1>>_passTime
			<</link>><<lstress>><<ltrauma>><<ltiredness>><<gwillpower>>
			<br>
		<</if>>
		<<if $money gte 5000>>
			<<foodicon "creambun">>
			<<link [[디럭스 크림 번을 산다 (_passTimeDisplay £50)|Gwylan Ocean Breeze Watch]]>>
				<<set $phase to "deluxe cream bun">><<set $phase2 to 1>><<set $daily.cafeEaten to 1>><<money -5000 "cafe">>
				<<transform cat 1>><<stress -24>><<trauma -3>><<willpower 1>>_passTime
			<</link>><<lllstress>><<ltrauma>><<gwillpower>>
			<br>
		<</if>>
	<</if>>
	<<if !(between($chef_state, 7, 8) and $chef_rework lte 30) and $cafe_study and ($studyBooks.rented isnot "none" or $studyBooks.stolen isnot "none") and Time.schoolDay>>
		<br>
		<<switch $studyBooks.rented>>
			<<case "science">><<scienceicon>><<link [[`과학 공부하기 (_passTimeDisplay)`|Gwylan Ocean Breeze Watch]]>><<set $phase to "science">><<set $phase2 to 2>><<scienceskill>><<willpower 1>>_passTime<</link>><<gscience>><<gwillpower>><br>
			<<case "maths">><<mathicon>><<link [[`수학 공부하기 (_passTimeDisplay)`|Gwylan Ocean Breeze Watch]]>><<set $phase to "maths">><<set $phase2 to 2>><<mathsskill>><<willpower 1>>_passTime<</link>><<gmaths>><<gwillpower>><br>
			<<case "English">><<englishicon>><<link [[`영어 공부하기 (_passTimeDisplay)`|Gwylan Ocean Breeze Watch]]>><<set $phase to "English">><<set $phase2 to 2>><<englishskill>><<willpower 1>>_passTime<</link>><<genglish>><<gwillpower>><br>
			<<case "history">><<historyicon>><<link [[`역사 공부하기 (_passTimeDisplay)`|Gwylan Ocean Breeze Watch]]>><<set $phase to "history">><<set $phase2 to 2>><<historyskill>><<willpower 1>>_passTime<</link>><<ghistory>><<gwillpower>><br>
		<</switch>>
		<<switch $studyBooks.stolen>>
			<<case "science">><<scienceicon>><<link [[`과학 공부하기 (_passTimeDisplay)`|Gwylan Ocean Breeze Watch]]>><<set $phase to "science">><<set $phase2 to 2>><<scienceskill>><<willpower 1>>_passTime<</link>><<gscience>><<gwillpower>><br>
			<<case "maths">><<mathicon>><<link [[`수학 공부하기 (_passTimeDisplay)`|Gwylan Ocean Breeze Watch]]>><<set $phase to "maths">><<set $phase2 to 2>><<mathsskill>><<willpower 1>>_passTime<</link>><<gmaths>><<gwillpower>><br>
			<<case "English">><<englishicon>><<link [[`영어 공부하기 (_passTimeDisplay)`|Gwylan Ocean Breeze Watch]]>><<set $phase to "English">><<set $phase2 to 2>><<englishskill>><<willpower 1>>_passTime<</link>><<genglish>><<gwillpower>><br>
			<<case "history">><<historyicon>><<link [[`역사 공부하기 (_passTimeDisplay)`|Gwylan Ocean Breeze Watch]]>><<set $phase to "history">><<set $phase2 to 2>><<historyskill>><<willpower 1>>_passTime<</link>><<ghistory>><<gwillpower>><br>
		<</switch>>
	<</if>>
	<br>
<</widget>>

<<widget "gwylanOptionsLeave">>
	<<set $_schoolWalkAvailable to ($gwylanSeen.includes("cafe_walk") or ($gwylan.sea + ($gwylanTalked.count("fox_mask") * 20) + ($gwylanTalked.count("dark_pendant") * 20) gte 40)) or ($gwylan.robin gte 10 and $daily.robin_in_cafe and false)>> /* WARNING! Re-enable later for Gwybin cafe */
	<<if $gwylan.request.event is "meetAtShop" and $location is "forest_shop" and gwylanCanForceRitual("beast") and !_ritualFailSafe and !$daily.gwylan.preventProgress>>
		<<getouticon>><<link [[상점으로 돌아간다|Gwylan Forest Journey Cancel]]>><</link>><<if $daily.gwylan.eventCancelled>><<gwylanWillpowerDifficulty>><</if>>
		/* ToDo: Gwylan - forcing player into ritual if it's been too long */
	<<elseif $location is "cafe" and !(between($chef_state, 7, 8) and $chef_rework lte 30)>>
		<<if $_schoolWalkAvailable and Time.schoolDay and !$daily.gwylan_skip_school>>
			<<if $daily.robin_in_cafe>>
				<<schoolicon "building">><<link [[일찍 학교로 걸어간다 (0:10)|Gwylan Walk School Robin]]>><<pass 10>><<set $daily.gwylan.cafeSkip to true>><<unset $cafe_study>><<storeon "cafe_balcony">><</link>>
			<<else>>
				<<schoolicon "building">><<link [[일찍 학교로 걸어간다 (0:10)|Gwylan Walk School Solo]]>><<pass 10>><<set $daily.gwylan.cafeSkip to true>><<unset $cafe_study>><<storeon "cafe_balcony">><</link>>
			<</if>>
			<br>
		<</if>>
		<<getouticon>><<link [[작별 인사를 하고 안으로 돌아간다 (0:01)|Ocean Breeze]]>><<pass 1>><<unset $cafe_study>><<storeon "cafe_balcony">><<endevent>><</link>>
	<<elseif $location is "cafe">>
		<<getouticon>><<link [[작별 인사를 한다 (0:01)|Cliff Street]]>><<pass 1>><<endevent>><<set $eventskip to 1>><</link>>
	<<else>>
		<<getouticon>><<link [[상점으로 돌아간다|Forest Shop Entrance]]>><<endevent>><</link>>
	<</if>>
	<br>
<</widget>>

<<widget "seagullFood">><<silently>>
	<<if npcIsPregnant("Gwylan")>>
		<<set _seagullFood to "자두 크레페">>
	<<elseif Time.season is "winter">>
		<<set _seagullFood to "진저브레드">>
	<<elseif _gwylanStatus?.includes("lust")>>
		<<set _seagullFood to "체리 크레페">>
	<<else>>
		<<set _seagullFood to "딸기 크레페">>
	<</if>>
<</silently>><<print _seagullFood>><</widget>>

<<widget "gwylanHypnoName">><<silently>>
	<<if $hypnosis_traits.devotion gte 4>>
		<<if _args[0] is "cap">>
			<<set $_text_output to `<span class="witch">당신의 <<nnpc_master "Gwylan">></span>`>>
		<<else>>
			<<set $_text_output to `<span class="witch">당신의 <<nnpc_master "Gwylan">></span>`>>
		<</if>>
	<<else>>
		<<set $_text_output to "그윌란">>
	<</if>>
<</silently>><<print $_text_output>><</widget>>

<<widget "gwylanNoChoice">>
	<<if _args[0] is "speech">>
		<<hypnosisText "말을 꺼내기도 전에 입에서 단어들이 빼앗긴다.">>
	<<else>>
		<<hypnosisText "당신의 몸은 더 이상 당신의 것이 아니다.">>
	<</if>>
	<br><br>
	그윌란이 낄낄 웃는다.
	<<print either(
		`"<<pcPetname 'Gwylan' 'simple'>>...?"`,
		`"혼란스러워 보이네... 쉿, 괜찮아."`,
		`"나한테 '아니'라고 말하진 않겠지, 내 사랑?"`,
		)>>
	<br>
<</widget>>

<<widget "gwylanChaseOptions">>
	<<link [[달린다 (0:05)|Gwylan Forest Run]]>><<pass 5>><<tiredness 2>><<set $phase to "run">><</link>><<gtiredness>><<athleticsdifficulty $beastRitual.difficultyMin $beastRitual.difficultyMax true>>
	<br>
	<<if !$beastRitual.foxChase>>
		<<link [[걷는다 (0:10)|Gwylan Forest Run]]>><<stress -1>><<pass 10>><<set $beastRitual.time++>><<set $phase to "walk">><</link>><<lstress>>
		<br>
	<</if>>
	<<if $fox gte 4 and $beastRitual.distance lt 0 and !$beastRitual.foxChase>>
		<<link [[그윌란을 추적해 쫓는다 (0:05)|Gwylan Forest Run Fox Chase]]>><<transform fox 1>><<tiredness 6>><<trauma -8>><</link>><<ggtiredness>><<lltrauma>><<fox>>
		<br>
	<</if>>
	<<if $beastRitual.lewdOption and $beastRitual.distance gte 2 and !$beastRitual.ambush>>
		<<link [[기다렸다가 그윌란을 덮친다|Gwylan Forest Run Ambush]]>><<def 1>><<transform fox 1>><<set $phase to "ambush">><</link>><<skill_difficulty `currentSkillValue("skulduggery")` "속임수" 400 1000>>
		<br>
	<</if>>
	<<if $beastRitual.stalked is "wolf" and ($wolfgirl gte 6 or $wolfpackleader gte 1)>>
		<<if $wolfgirl gte 6>>
			<<link [[울부짖는다|Gwylan Forest Run Howl]]>><</link>><<wolfgirl>>
		<<elseif $wolfpackleader gte 1>>
			<<link [[울부짖는다|Gwylan Forest Run Howl]]>><</link>><<note "무리 우두머리" "red">>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "gwylanPurgeEffect">><<silently>>
	<<if $gwylanSeen.includes("ritual_beast") and $beastRitual or $gwylanSeen.includes("ritual_sex") and $sexRitual>>
		<<set $_plus to _args[0]>>
		<<switch $_plus>>
			<<case 3>><<set $_text_output to " | <span class='teal'>+ + + 정화 효율</span>">>
