:: Gwylan Forest Journey Cancel
<<effects>><<run statusCheck("Gwylan")>>
<<if $daily.gwylan.eventCancelled and $hypnosis_traits.devotion gte 1 and !$willpowerSuccess>>
	떠나려고 몸을 돌리려 하지만, <<hypnosisText "하지만 곧 생각의 흐름을 잃는다. 대신 다른 생각이 자리 잡는다. 오늘 달리 할 일이 뭐가 있지? 바쁜 것도 아니다. 여기서 해야 할 일이 있다.">>
	<br><br>

	그윌란이 다정하게 미소 짓는다. 가슴이 두근거린다.
	<br><br>

	<<link [[<<him>>【을를】 돕고 싶다고 말한다 (?:??)|Gwylan Forest Journey Prep]]>><<gwylanRequestEnd "skip">><<endevent>><<set $ritualForced to true>><</link>>
	<br>
<<else>>
	<<if $daily.gwylan.eventCancelled and $hypnosis_traits.devotion gte 1>>
		<span class="green">그윌란과 함께 가고 싶은 충동을 떨쳐낸다.</span>
	<</if>>
	<<He>>【은는】 얼굴을 찌푸린다. "알겠다. 준비되면 다시 와라."
	<br><br>

	<<link [[다음|Forest Shop Entrance]]>><<endevent>><<set $daily.gwylan.eventCancelled to true>><</link>>
	<br>
<</if>>

:: Gwylan Forest Journey Prep
<<effects>><<run statusCheck("Gwylan")>>
<<npc Gwylan>><<person1>>
<<set _hideRitualOptions to true>>
<<if !$gwylanSeen.includes("ritual_beast")>>
	그윌란에게 도울 준비가 되었다고 말한다.
	<br><br>
<<elseif !$gwylanSeen.includes("ritual_sex_intro")>>
	그윌란에게 <<his>> 의식을 돕고 싶다고 말한다.
	<br><br>
<<elseif !$ritualForced>>
	그윌란에게 정화를 위해 숲의 주민 중 하나를 유인하는 편이 낫겠다고 말한다.
	<br><br>
<</if>>

<<if Time.isBloodMoon() or Time.monthDay is Time.lastDayOfMonth and Time.hour gte 16>>
	<<set _ritualFailSafe to true>><<unset $ritualForced>>
	<<He>>【은는】 고개를 젓는다. "지금은 안 돼. 오늘 같은 밤에는. 너무 위험해."
	<br><br>

	<<gwylanOptions>>
<<elseif Time.hour lte 8>>
	<<set _ritualFailSafe to true>><<unset $ritualForced>>
	<<set $daily.gwylan.ritualRequestBlocked to true>>
	<<He>>【은는】 하품한다. "너무 일러. 먼저 아침부터 먹어야지.<<if $gwylan_cafe_intro>> 나중에 카페에서 볼까?<</if>>"
	<br><br>

	<<gwylanOptions>>
<<elseif $worn.feet.type.includes("heels") and !$ritualForced>>
	<<set _ritualFailSafe to true>>
	<<He>>【은는】 몸을 숙여 당신의 $worn.feet.name【을를】 내려다본다. "그런 힐을 신고 숲을 돌아다니다간 발목이 부러질 거야! 제대로 된 신발이나 부츠를 신고 와." <<he>>【이가】 꾸짖는다.
	<br><br>

	<<gwylanOptions>>
<<elseif $exposed gte 1 and !$ritualForced>>
	<<set _ritualFailSafe to true>><<unset $ritualForced>>
	<<He>>【이가】 당신을 훑어본다. "가기 전에 옷을 좀 더 챙겨 입는 게 좋겠어."
	<br><br>

	<<gwylanOptions>>
<<elseif !isBeastSceneAllowed() and !$settings.plantsEnabled>>
	<<set _ritualFailSafe to true>><<unset $ritualForced>>
	<<He>>【이가】 눈살을 찌푸린다. "긴장한 것 같네. 우린 <span class="blue">숲의 자연적인 거주자들</span>을 상대하게 될 거야, 그런데 넌 그걸 받아들일 준비가 안 된 것 같아. <span class="blue">마음을 열고</span> 다시 와.
	<br><br>

	<i><span class="blue">계속하려면 야수, 괴물 인간 또는 인간형 식물이 활성화되어 있어야 합니다.</span></i>
	<br><br>

	<<gwylanOptions>>
<<else>>
	<<set $beastRitual to {
		lure: "wolf",
		person: "Gwylan",
		difficultyMin: 550,
		difficultyMax: 850,
		binding: "none",
		petplay: 0,
		hasScent: false
	}>>
	<<if _gwylanTF.known>>
		<<set $beastRitual.difficultyMin += 150>><<set $beastRitual.difficultyMax += 300>>
	<</if>>
	<<if !$gwylanSeen.includes("ritual_beast")>>
		<<He>>【은는】 손을 마주 잡는다. "훌륭해! 신나는걸, 마지막으로 도움을 받았던 게 언제인지 기억도 안 나. 숲 더 깊은 곳으로 들어갈 거야. 오늘이 끝날 때쯤이면 네 호기심도 충족될 테고."
	<<elseif $gwylanSeen.includes("struggles") and !$gwylanSeen.includes("ritual_sex_intro") and !_gwylanStatus.includes("cautious")>>
		<<He>>【은는】 고개를 끄덕인다. "<span class="blue">일이 끝나면 너와 이야기하고 싶은 게 있어.</span> 하지만 급한 건 아니야. 가서 준비 좀 할게."
		<<He>>【은는】 몇 분 후 짙은 녹색의 벨트 달린 튜닉을 입고 돌아온다. 여러 개의 가방과 약병, 칼집에 넣은 칼로 장식되어 있다.
		"같이 와줘서 고마워. 가자!"
	<<else>>
		<<He>>【은는】 고개를 끄덕이고 가게 뒤편으로 향한다. "준비할 시간 좀 줘." <<He>>【은는】 몇 분 후 짙은 녹색의 벨트 달린 튜닉을 입고 돌아온다. 여러 개의 가방과 약병, 칼집에 넣은 칼로 장식되어 있다.
		"같이 와줘서 고마워. 가자!"
	<</if>>
	<<if $ritualForced>>
		<<He>>【은는】 당신의 머리를 쓰다듬는다. <<stress -1>><<lstress>>
	<</if>>
	<<unset $ritualForced>>
	<br><br>

	<<if $worn.feet.type.includes("heels")>>
		<<set _linebreak to true>>
		<<He>>【은는】 당신의 $worn.feet.name【을를】 힐끗 내려다본다. "그거 벗어. 그런 거 신고 숲속을 돌아다니다간 발목 부러져." <<he>>【이가】 꾸짖는다.
		<<if $hypnosis_traits.devotion gte 1>>
			<<hypnosisText "<<his>> 명령을 따른다. <<him>>【을를】 실망시키고 싶지 않다.">>
		<<else>>
			<<He>>【은는】 말이 맞는 것 같다. 당신은 $worn.feet.name【을를】 벗어두고 맨발로 가기로 한다.
		<</if>>
		<<feetundress "gwylanRitual">>
	<<elseif $worn.upper.type.includes("athletic") and $worn.lower.type.includes("athletic")>>
		<<set _linebreak to true>>
		<<He>>【은는】 당신의 옷을 훑어본다. "좋은 선택이야, 움직이기 편해 보이네."
		<<if $worn.feet.type.includes("rugged")>>
			<<He>>【은는】 그러고는 당신의 $worn.feet.name【을를】 흘끗 본다. "그것도 숲에서 잘 버텨줄 거야."
		<</if>>
	<<elseif $worn.feet.type.includes("rugged")>>
		<<set _linebreak to true>>
		<<He>>【은는】 몸을 숙여 당신의 $worn.feet.name【을를】 내려다본다. "좋은 선택이야, 숲에서 잘 버텨줄 거야."
	<</if>>
	<<if $leftarm is "bound" or $rightarm is "bound" or $feetuse is "bound">>
		<<set _linebreak to true>>
		<<he>>【이가】 당신을 지나치자, <span class="green">결박이 풀리는 것이 느껴진다.</span> "그런 꼴로 돌아다니게 할 순 없지."
		<<unbind>>
	<</if>>

	<<set _petplayChance to 0>>
	<<if $gwylanSeen.includes("ritual_sex")>>
		<<if $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1>>
			<<set _petplayChance to 100>>
		<<elseif _gwylanStatus.includesAny("dom", "lust")>>
			<<if $wolfgirl gte 6 or $cat gte 6 or $fox gte 6>>
				<<set _petplayChance += 20>>
			<</if>>
			<<set _petplayChance += Math.floor((C.npc.Gwylan.lust + C.npc.Gwylan.dom) / 2)>>
			<<if $worn.neck.collared is 1>>
				<<set _petplayChance += 20>>
				<<if $worn.neck.type.includes("leash")>>
					<<set _petplayChance += 10>>
				<</if>>
			<</if>>
			<<if $hypnosis_traits.devotion>>
				<<set _petplayChance += $hypnosis_traits.devotion * 10>>
			<</if>>
		<</if>>
	<</if>>
	<<if _petplayChance gte random(1, 100)>>
		<<if $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1>>
			<<set _petplayOption to "command">>
			목줄이 나타나면서 목걸이가 당겨지는 것이 느껴진다. "<<pcpetname "Gwylan" "my">>【은는】 산책하고 싶어? <<gwylanCommand "앉아." 1>>"
			<<attach_leash true>><<set $beastRitual.leash to true>>
			<<set $gwylanSeen.pushUnique("petplay")>>
			<<set _linebreak to true>>
		<<elseif $worn.neck.collared is 1>>
			<<set _petplayOption to "ask">>
			<<if $worn.neck.type.includes("leash")>>
				<<set $beastRitual.binding to "leash">>
				그윌란이 당신을 지나쳐 가면서 목줄이 당겨지는 것을 느낀다.
			<<else>>
				그윌란이 멈춰 서서 지나가며 당신의 목걸이를 따라 <<his>> 손을 미끄러뜨린다.
			<</if>>
			"어머, 준비하고 왔네! <<pcpetname "Gwylan" "my">>【은는】 산책하고 싶어?<<if !$worn.neck.type.includes("leash")>> 목줄 몇 개 굴러다니는 거 있는데. 그럼 다시는 떨어질 일 없을 거야.<</if>>"
			<<if !$gwylanSeen.includes("petplay")>>
				<<he>>【은는】 농담인지 아닌지 알 수 없다.
			<</if>>
			<<if !$worn.neck.type.includes("leash")>>
				<<if !$gwylanSeen.includes("petplay")>>
					<<He>>【은는】 선반 뒤를 뒤지기 시작하는데, 그 모습에 <<he>>【이가】 농담이 아니라는 것을 바로 알 수 있다.
				<<else>>
					<<He>>【은는】 선반 뒤를 뒤지기 시작한다.
				<</if>>
				잠시 후 <<he>>【이가】 당신에게 다시 걸어오고, 작은 딸깍 소리가 들린다. <span class="lewd"><<He>>【은는】 당신의 목걸이에 목줄을 채웠다.</span>
				<<attach_leash true>><<set $beastRitual.leash to true>>
			<<elseif !$gwylanSeen.includes("petplay")>>
				<<his>> 얼굴에 띤 유혹적인 표정을 보니 <<he>>【이가】 농담이 아니라는 것을 알 수 있다.
			<</if>>
			<<npcincr Gwylan lust 2>><<glust>>

			<<if _gwylanStatus.includesAny("dom", "lust")>>
				<<set _petplayOption to "command">>
				<br><br>
				<<He>>【은는】 목줄을 <<his>> 손에 감아 당신을 좀 더 가까이 끌어당긴다.
				"<<gwylanCommand "앉아." 1>>"
			<</if>>
			<<set $gwylanSeen.pushUnique("petplay")>>
			<<set _linebreak to true>>
		<<elseif !$worn.neck.cursed>>
			<<set _petplayOption to "ask">>
			<<set $beastRitual.binding to "leash">>
			<<if $worn.neck.name is "naked">>
				목 주위에서 무언가 딸깍하고 채워지는 느낌이 든다.
			<<else>>
				당신의 $worn.neck.name【이가】 벗겨지고, 무언가가 그 자리를 대신하며 딸깍하는 소리가 들린다.
				<<neckundress "gwylanRitual">>
			<</if>>
			<span class="lewd">목줄이 달린 목걸이다.</span> 아주 잘 관리된 것처럼 보인다. 당신은 그것에 의해 부드럽게 당겨진다. "자, <<pcpetname "Gwylan">>, 산책할 시간이야!" <<He>>【이가】 킥킥 웃는다.
			<<neckwear 21>><<set $beastRitual.collared to true>>

			<<if _gwylanStatus.includesAny("dom", "lust")>>
				<<set _petplayOption to "command">>
				<br><br>

				<<He>>【은는】 목줄을 <<his>> 손에 감아 당신을 좀 더 가까이 끌어당긴다.
				"하지만 먼저... <<gwylanCommand "앉아." 1>>"
			<<else>>
				"다시는 우리가 떨어지게 할 수 없어."
			<</if>>
			<<set $gwylanSeen.pushUnique("petplay")>>
			<<set _linebreak to true>>
		<</if>>
	<</if>>
	<<if _linebreak>><br><br><</if>>

	<<if _petplayOption is "command">>
		<<link [[앉는다|Gwylan Forest Journey Pet]]>><<set $phase to 1>><</link>>
		<br>
		<<link [[계속 서 있다|Gwylan Forest Journey Pet]]>><<set $phase to 2>><</link>><<gwylanWillpowerDifficulty>>
		<br>
		<<if $wolfgirl gte 6>>
			<<link [[개처럼 앉아서 애원한다|Gwylan Forest Journey Pet]]>><<sub 1>><<set $phase to 3>><<npcincr Gwylan lust 2>><</link>><<wolfgirl>><<glust>>
			<br>
		<<elseif $cat gte 6>>
			<<link [[고양이처럼 뒹굴며 기지개를 켠다|Gwylan Forest Journey Pet]]>><<sub 1>><<set $phase to 3>><<npcincr Gwylan lust 2>><<transform cat 1>><</link>><<cat>><<glust>>
			<br>
		<<else>>
			<<link [[개처럼 앉아서 애원한다|Gwylan Forest Journey Pet]]>><<sub 1>><<set $phase to 3>><<npcincr Gwylan lust 2>><</link>><<deviant1>><<glust>>
			<br>
		<</if>>
	<<else>>
		<<if $gwylanSeen.includes("romance") or C.npc.Gwylan.dom gte random(20, 100) and $gwylanSeen.includes("forest_journey_handheld")>>
			<<if $beastRitual.binding is "leash">>
				<<set $beastRitual.binding to "both">>
				<<He>>【은는】 한 손으로 당신의 목줄을 잡고 다른 손으로는 당신의 손을 잡는다. <<He>>【은는】 당신을 가게 밖으로 이끌어 숲으로 들어간다. <<takeHandholdingVirginity "Gwylan" "consensual">>
			<<else>>
				<<set $beastRitual.binding to "handheld">>
				<<He>>【이가】 당신을 가게 밖 숲으로 이끌며 <<hers>> 손으로 당신의 손을 잡는다. <<takeHandholdingVirginity "Gwylan" "consensual">>
			<</if>>
		<<elseif $beastRitual.binding is "leash">>
			<<He>>【은는】 당신의 뺨을 꼬집는다. "가까이 있어, <<pcpetname "Gwylan" "simple">>." 당신은 가게를 나와 목줄에 이끌려 <<him>>【와과】 함께 숲으로 향한다.
		<<else>>
			<<He>>【은는】 당신의 뺨을 꼬집는다. "가까이 있어, 길 잃으면 안 되니까." 당신은 가게를 나와 <<him>>【와과】 함께 숲으로 향한다.
		<</if>>
		<br><br>

		<<link [[조용히 걷는다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 1>><</link>>
		<br>
		<<if !$gwylanSeen.includes("ritual_beast")>>
			<<link [[<<him>>에게 무엇을 할 것인지 자세히 물어본다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 2>><</link>>
		<<else>>
			<<link [[걸으면서 대화한다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 3>><</link>>
		<</if>>
		<br>
		<<if $beastRitual.binding isnot "handheld">>
			<<link [[<<his>> 손을 잡는다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 4>><<if C.npc.Gwylan.dom lt 10>><<npcincr Gwylan dom 1>><</if>><</link>><<if C.npc.Gwylan.dom lt 10>><<gyearning>><</if>><<handholdingvirginitywarning>>
			<br>
		<</if>>
		<<if _petplayOption is "ask">>
			<<if hasSexStat("deviancy", 2)>>
				<<link [[<<him>>에게 당신을 개처럼 산책시키게 한다|Gwylan Forest Journey 2]]>><<sub 1>><<pass 20>><<set $phase to 5>><<npcincr Gwylan lust 2>><</link>><<glust>><<deviant2>>
				<br>
			<<else>>
				<<insufficientStat "deviancy" "<<him>>에게 당신을 개처럼 산책시키게 하기엔">>
			<</if>>
		<</if>>
	<</if>>
<</if>>

:: Gwylan Forest Journey Pet
<<effects>><<run statusCheck("Gwylan")>>
<<set $beastRitual.binding to "leash">>
<<if $phase is 1 or $phase is 2 and $hypnosis_traits.devotion gte 1 and !$willpowerSuccess>>
	/* Sit */
	<<if $phase is 2 and $hypnosis_traits.devotion gte 1 and !$willpowerSuccess>>
		<<set $beastRitual.disobey to true>>
		당신은 그 충동에 저항하려 한다. <<gwylanHypnoName "cap">>의 미소가 아주 살짝 옅어지고, 그 모습에 <span class="red">죄책감이 차오른다</span>.
		<<hypnosisText "무릎이 꺾이고, 비틀거리다 주저앉는다.">>
		<br><br>

		"<<pcPetname "Gwylan" "bad">>, 나한테 저항하다니. 벌을 줘야겠어." <<He>>【은는】 당신의 머리를 쓰다듬는다. <<if $phase is 1 and $hypnosis_traits.devotion gte 1>><<trauma -2>><<ltrauma>><</if>>
	<<else>>
		<<set $beastRitual.petplay++>>
		가게 바닥에 앉는다.
		<br><br>

		"<<pcPetname "Gwylan" "good">>." <<He>>【은는】 당신의 머리를 쓰다듬는다. <<if $phase is 1 and $hypnosis_traits.devotion gte 1>><<trauma -2>><<ltrauma>><</if>>
	<</if>>
	<br><br>

	"자, 할 일이 있어." <<He>>【은는】 당신의 뺨을 꼬집는다. "가까이 있어, <<pcpetname "Gwylan" "simple">>." 당신은 가게를 나와, 목줄에 이끌려 <<him>>【와과】 함께 숲으로 향한다.
	<br><br>

	<<link [[조용히 걷는다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 1>><</link>>
	<br>
	<<link [[걸으면서 대화한다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 3>><</link>>
	<br>
	<<link [[<<his>> 손을 잡는다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 4>><<if C.npc.Gwylan.dom lt 10>><<npcincr Gwylan dom 1>><</if>><</link>><<if C.npc.Gwylan.dom lt 10>><<gyearning>><</if>><<handholdingvirginitywarning>>
	<br>
	<<if hasSexStat("deviancy", 2)>>
		<<link [[<<him>>에게 당신을 개처럼 끌고 가게 한다|Gwylan Forest Journey 2]]>><<sub 1>><<pass 20>><<set $phase to 5>><<npcincr Gwylan lust 2>><</link>><<glust>><<deviant2>>
		<br>
	<<else>>
		<<insufficientStat "deviancy" "<<him>>에게 당신을 개처럼 산책시키게 하기엔">>
	<</if>>
<<elseif $phase is 2>>
	/* Stay standing */
	<<if $hypnosis_traits.devotion gte 1 and $willpowerSuccess>>
		당신은 그 충동에 저항하려 한다. 그윌란의 미소가 아주 살짝 옅어지지만, <span class="green">당신은 선 채로 버틴다</span>.
	<<else>>
		당신은 그윌란의 명령에 전혀 반응하지 않는다.
	<</if>>
	<<if C.npc.Gwylan.dom gte 50>>
		<<set $beastRitual.disobey to true>>
		<<He>>【은는】 다시 미소를 짓는다. "오, <<pcpetname "Gwylan" "naughty">>처럼 굴다니? 벌을 생각해 둬야겠네," <<he>>【이가】 킥킥거리며 당신의 목줄을 잡아당기며 말한다. "자, 할 일이 있어."
	<<else>>
		<<He>>【은는】 얼굴을 찌푸린다. "알았어. 그래도 목줄은 계속 잡고 있을 거야. 자, 할 일이 있어."
	<</if>>
	<<He>>【은는】 당신의 뺨을 꼬집는다. "가까이 있어, <<pcpetname "Gwylan" "simple">>." 당신은 가게를 나와 목줄에 이끌려 <<him>>【와과】 함께 숲으로 향한다.
	<br><br>

	<<link [[조용히 걷는다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 1>><</link>>
	<br>
	<<link [[걸으면서 대화한다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 3>><</link>>
	<br>
	<<link [[<<his>> 손을 잡는다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 4>><<if C.npc.Gwylan.dom lt 10>><<npcincr Gwylan dom 1>><</if>><</link>><<if C.npc.Gwylan.dom lt 10>><<gyearning>><</if>><<handholdingvirginitywarning>>
	<br>
<<else>>
	/* Beast tf or deviancy petplay */
	<<set $beastRitual.petplay += 2>>
	<<if $wolfgirl gte 6>>
		당신은 개처럼 앉아, 구걸하듯 가슴에 팔을 모은다.<<if $transformationParts.wolf.tail isnot "hidden">> 당신의 꼬리가 뒤에서 흔들린다.<</if>> 당신은 혀를 내밀고 헐떡이며, 복종의 눈빛으로 <<gwylanHypnoName>>【을를】 올려다본다.
		<<He>>【은는】 당신의 눈높이에 맞춰 웅크려 앉아, 당신을 쓰다듬기 시작한다.
	<<elseif $cat gte 6>>
		당신은 앉았다가, 이내 고양이처럼 드러누워 기지개를 켠다. <<gwylanHypnoName "cap">>【은는】 웅크려 앉아 당신의 <<bellyDescription>>【을를】 긁어주기 시작한다.
	<<else>>
		당신은 개처럼 앉아 짖는 시늉을 한다. 당신은 구걸하듯 가슴에 팔을 모으고, 복종의 눈빛으로 <<gwylanHypnoName>>【을를】 올려다본다.
		<<deviancy1>>
	<</if>>
	"아, 우리 <<pcpetname "Gwylan" "good">>【이가】 누구일까?" <<if $hypnosis_traits.devotion gte 1>><<His>> 손길에 당신은 더없는 행복감에 휩싸인다. <<stress -3>><<trauma -3>><<lstress>><<ltrauma>><</if>>
	<br><br>

	"이러고 있는 것도 좋지만, 할 일이 있어." <<He>>【은는】 휘파람을 불며 당신의 목줄을 잡아당긴다.
	<br><br>

	<<link [[일어서서 조용히 걷는다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 1>><</link>>
	<br>
	<<link [[일어서서 걸으며 대화한다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 3>><</link>>
	<br>
	<<link [[일어서서 <<his>> 손을 잡는다|Gwylan Forest Journey 2]]>><<pass 20>><<set $phase to 4>><<if C.npc.Gwylan.dom lt 10>><<npcincr Gwylan dom 1>><</if>><</link>><<if C.npc.Gwylan.dom lt 10>><<gyearning>><</if>><<handholdingvirginitywarning>>
	<br>
	<<if hasSexStat("deviancy", 2)>>
		<<link [[네 발로 따라간다|Gwylan Forest Journey 2]]>><<sub 1>><<pass 20>><<set $phase to 5>><<npcincr Gwylan lust 2>><</link>><<glust>><<deviant2>>
		<br>
	<<else>>
		<<insufficientStat "deviancy" "<<him>>【을를】 따라가며 계속 네 발로 기기엔">>
	<</if>>
<</if>>

:: Gwylan Forest Journey 2
<<set $outside to 1>><<set $location to "forest">><<effects>><<run statusCheck("Gwylan")>>
<<if $worn.feet.type.includes("rugged") and $phase isnot 5>>
	<<set $beastRitual.difficultyMin -= 50>><<set $beastRitual.difficultyMax -= 50>>
<</if>>
<<if $phase is 1>>
	숲 속으로 더 깊이 걸어 들어가는 동안 조용히 걷는다. 그윌란은 콧노래를 부르며 앞으로 씩씩하게 걸어간다.
	<br><br>

	<<He>>【이가】 돌아서서 당신을 마주보고, 이제 뒷걸음질치며 걷는다. "그렇게 조용히 있을 필요 없어. 사실, 가끔은 소리를 좀 내는 게 더 나아. 곰들을 쫓아낼 수 있거든." <<He>>【이가】 다시 앞으로 돌아선다.
<<elseif $phase is 2>>
	그윌란은 콧노래를 부르며 앞으로 씩씩하게 걸어간다.
	<br><br>

	<<switch $speech_attitude>>
		<<case "meek">>
			"우리 지금 뭐 하는 건지 말해줄 수 있어?" 하고 묻는다.
		<<case "bratty">>
			"자, 이제 실토하시지. 우리 뭐 하는 거야?" 하고 묻는다.
		<<default>>
			"계속 비밀스럽게 굴 거야?" 하고 묻는다.
	<</switch>>
	<br><br>

	<<He>>【이가】 돌아서서 당신을 마주보고, 이제 뒷걸음질치며 걷는다. "쯧쯧, 더 궁금해하는군! 네 그런 점이 마음에 들어. 조금만 참아봐."
<<elseif $phase is 3>>
	숲을 걸으며 <<him>>【와과】 수다를 떤다. <<He>>【이가】 주로 이야기하고, 당신은 듣는 것만으로도 괜찮다.
<<elseif $phase is 4>>
	그윌란은 콧노래를 부르며 앞으로 씩씩하게 걸어간다.
	<br><br>

	<<if $gwylanSeen.includes("forest_journey_handheld")>>
		<<him>> 옆에서 걸으며 손을 내밀어 <<hers>> 손 하나를 잡는다. <<takeHandholdingVirginity "Gwylan" "consensual">> <span class="teal"><<He>>【이가】 망설이며 당신의 손을 마주 잡아준다.</span>
	<<else>>
		<<set $gwylanSeen.pushUnique("forest_journey_handheld")>>
		<<him>> 옆에서 걸으며 손을 내밀어 <<hers>> 손 하나를 잡는다. <<takeHandholdingVirginity "Gwylan" "consensual">> <<He>>【이가】 콧노래를 멈추지만, 계속 걷는다. <span class="teal"><<He>>【이가】 망설이며 당신의 손을 마주 잡아준다.</span>
		<<if $beastRitual.binding isnot "leash">>
			"좋은 생각이야, 이렇게 하면 헤어질 가능성이 줄어들겠지."
		<</if>>
		<<He>>【은는】 잠시 후 다시 콧노래를 부르기 시작한다.
	<</if>>
	<<if $beastRitual.binding is "leash">>
		<<set $beastRitual.binding to "both">>
	<<else>>
		<<set $beastRitual.binding to "handheld">>
	<</if>>
<<else>>
	<<if $beastRitual.petplay is 2>>
		그윌란을 따라 상점 밖으로 나가면서 네 발로 기는 자세를 유지한다.
	<<else>>
		네 발로 기는 자세를 취하고 그윌란을 따라간다.
	<</if>>
	<<He>>【은는】 처음에는 알아채지 못한 듯, 콧노래를 부르며 앞으로 씩씩하게 걸어간다. <<He>>【이가】 돌아서서 당신을 마주보고는, 즉시 멈춰 선다.
	<<deviancy2>>

	<<He>>【은는】 잠시 쳐다보다가 킥킥 웃는다.
	<<if $beastRitual.petplay is 2>>
		"정말 적극적이네." <<He>>【이가】 웅크리고 앉아 당신의 온몸을 쓰다듬기 시작한다. "마음에 들어. 계속 그렇게 착하게 굴면 나중에 상을 줄지도 몰라." <<He>>【이가】 일어서서 다시 당신의 목줄을 당기자, 두 사람은 계속 나아간다.
		당신의 손과 무릎은 금방 지쳐서, 당신은 일어서서 남은 길을 걸어간다.
	<<else>>
		"어이구, 우리 <<pcpetname "Gwylan" "good">>?" <<He>>【이가】 웅크리고 앉아 당신의 온몸을 쓰다듬기 시작한다. <<if $hypnosis_traits.devotion gte 1>><<His>> 손길이 당신을 황홀감으로 채운다. <<stress -3>><<trauma -3>><<lstress>><<ltrauma>><</if>>
		<br><br>

		"계속하고 싶지만, 할 일이 있어." <<He>>【이가】 휘파람을 불며 당신의 목줄을 당긴다. 당신은 네 발로 그윌란을 따라간다.
	<</if>>
	<<set $beastRitual.petplay++>>
<</if>>
<br><br>

<<He>>【이가】 당신을 데리고, 찾으려 하지 않으면 보이지 않을 길로 들어선다. 나무들이 당신 주위를 에워싸고, 다시 모습을 드러냈을 때 당신은 숲 속 훨씬 더 깊은 곳에 와 있다.
<br><br>

"이제 얼마 안 남았어." <<He>>【이가】 멈춰서 무릎을 꿇고,
<<if $beastRitual.binding is "both">>
	당신의 손을 놓고 목줄을 나무에 묶은 뒤
<<elseif $beastRitual.binding is "leash">>
	목줄을 나무에 묶은 뒤
<<elseif $beastRitual.binding is "handheld">>
	당신의 손을 놓고
<</if>>
흙 속의 무언가를 살핀다. "사실, 우린 이미 도착했어." 당신은 주위를 둘러본다.
<<if $tending gte 700>>
	당신의 관리 스킬 덕분에, <span class="blue">이곳이 분쟁 지역이라는 것을 안다</span>. 온갖 종류의 짐승들과, 심지어 일부 포식성 식물들까지 숲의 이 구역에서 충돌한다.
<<elseif $wolfpackleader gte 1>>
	<span class="blue">이곳이 당신의 늑대 무리 영역이라는 것을 잘 알고 있다.</span>
<<elseif $syndromewolves gte 1>>
	<span class="blue">이곳이 늑대 무리의 영역이라는 것을 잘 알고 있다.</span>
<<elseif $wolfgirl gte 6>>
	<span class="blue">이곳이 늑대들의 영역이라는 것을 당신은 잘 알고 있다.</span>
<<else>>
	이 지역이 어떻게 특별한지 알 수 없다.
<</if>>
<br><br>

<<if !$gwylanSeen.includes("ritual_beast")>>
	그윌란이 코웃음을 친다. 뒤돌아 <<him>>【을를】 보면, <<he>>【이가】 사용한 탄피를 들고 있는 것이 보인다. "이걸 쏜 짐승만으로도 소란스러운데, 질식할 위험이 있는 멋진 물건이 또 나왔군." <<He>>【은는】 그것을 <<his>> 허리띠에 달린 작은 가방에 넣는다.
	<br><br>

	다시 명랑한 태도로 돌아온 <<He>>【은는】
<<elseif $rng gte 51 or _gwylanStatus.includes("wounded")>>
	그윌란이 마치 사진 구도를 잡는 것처럼 <<his>> 얼굴 앞에 <<his>> 손을 들어 올린다. <<He>>【은는】 몇 번 자세를 고쳐 잡더니 미소를 짓는다. "그래... 거기." 그러고는 <<He>>【은는】 돌아서서 <<his>> 허리띠에서 칼을 뽑는다.
	<<He>>【은는】 같은 방향을 향해 근처 나무껍질에 상징을 새긴다. 그러고 나서 <<He>>【은는】 나무를 토닥인다.
	<br><br>

	<<He>>
<<else>>
	<<He>>【은는】 재빨리 근처 나무에 올라가 나뭇가지 하나에 앉는다. <<He>>【은는】 <<his>> 허리띠에 달린 가방을 열어 풀과 잔가지를 엮어 만든 부적을 꺼내 다른 나뭇가지에 건다. <<he>>【은는】 기어 내려오는 대신, 뛰어내려 우아하게 착지한다.
	<br><br>

	<<He>>
<</if>>
<<his>> 허리띠에서 팅크처 <<if $settings.plantsEnabled and $settings.tentaclesEnabled>>세<<else>>두<</if>> 개를 꺼내 당신에게 내민다.
"하나 골라." 팅크처는 어두운 액체로 채워져 있고, 마개에는 작은 종이 조각이 붙어 있다.
<br><br>

하나에는 늑대 머리 스케치가 있다.<br>
다른 하나에는 점프하는 여우 스케치가 있다.<br>
<<if $settings.plantsEnabled and $settings.tentaclesEnabled>>
	마지막 것에는 나뭇잎 스케치가 있다. "이게 가장 위험하지만, 독을 정화할 가장 큰 기회가 되기도 할 거다."<br>
<</if>>
<br>

<<link [[늑대|Gwylan Forest Journey 3]]>><<set $beastRitual.lure to "wolf">><</link>>
<br>
<<link [[여우|Gwylan Forest Journey 3]]>><<set $beastRitual.lure to "fox">><</link>><<if _gwylanTF.known>><<glust>><</if>>
<br>
<<if $settings.plantsEnabled and $settings.tentaclesEnabled>>
	<<link [[나뭇잎|Gwylan Forest Journey 3]]>><<set $beastRitual.lure to "dryad">><</link>>
	<br>
<</if>>
<<if $beastRitual.petplay>>
	<<if $fox gte 6>>
		<<link [[깽깽거리기|Gwylan Forest Journey 3]]>><<set $beastRitual.lure to "yip">><</link>>
	<<else>>
		<<link [[짖기|Gwylan Forest Journey 3]]>><<set $beastRitual.lure to "bark">><</link>>
	<</if>>
	<br>
<</if>>

:: Gwylan Forest Journey 3
<<effects>>
<<switch $beastRitual.lure>>
	<<case "wolf">>당신은 늑대 머리가 그려진 팅크처를 가리킨다.
	<<case "fox">>당신은 여우가 그려진 팅크처를 가리킨다.
	<<case "dryad">>당신은 나뭇잎이 그려진 팅크처를 가리킨다.
	<<case "bark">>
		<<set $beastRitual.petplay++>>
		당신은 짖는다.
		<<if $settings.plantsEnabled and $settings.tentaclesEnabled and $rng gte 51>>
			<<set $beastRitual.lure to "dryad">>
			그윌란이 킥킥 웃는다. "짖는다고(bark)? 나무껍질(bark) 말이야? 그럼 이걸 말하는 걸로 알게." <<He>>【은는】 나뭇잎이 그려진 팅크처를 들어 올린다.
		<<else>>
			<<set $beastRitual.lure to "wolf">>
			그윌란이 킥킥 웃는다. "늑대로 하지."
		<</if>>
	<<case "yip">>
		<<set $beastRitual.petplay++>><<set $beastRitual.lure to "fox">>
		당신은 낑낑거린다. 그윌란이 킥킥 웃는다. "여우로 하지."
	<<default>>당신은 그윌란을 가리킨다. <<He>>【은는】 당신을 향해 눈을 깜박이고는 늑대 팅크처를 집는다. <span class="red">이것은 버그입니다, 제보해 주세요.</span> <<set $beastRitual.lure to "wolf">>
<</switch>>
<<He>>【은는】 큰 소리와 함께 코르크 마개를 열고, 다른 팅크처들은 <<his>> 벨트에 다시 집어넣는다.
<<switch $beastRitual.lure>>
	<<case "wolf">>
		"이건 늑대들이 저항할 수 없는 냄새를 풍길 거야. 사향은 아니고, 내가 직접 만든 거지."
		<<if $wolfgirl gte 6>>
			<<He>>【이가】 씩 웃는다. "네가 감당할 수 있으면 좋겠군."
		<</if>>
	<<case "fox">>
		"이건 여우들이 저항할 수 없는 냄새를 풍길 거야. 사향은 아니고, 내가 직접 만든 거지."
		<<if $fox gte 6>>
			<<He>>【이가】 씩 웃는다. "네가 감당할 수 있으면 좋겠군."
		<</if>>
	<<default>>
		"이건 숲의 토착 생물 중 하나를 유혹하는 냄새를 풍길 거야. 그들의 넥타르로 내가 직접 만든 거지."
		<<if $dryad gte 6>>
			<<He>>【이가】 씩 웃는다. "네가 감당할 수 있으면 좋겠군."
		<</if>>
<</switch>>
<br><br>

<<if $beastRitual.lure is "wolf" and $wolfgirl gte 6 or $beastRitual.lure is "fox" and $fox gte 6 or $beastRitual.lure is "dryad" and $dryad gte 6>>
