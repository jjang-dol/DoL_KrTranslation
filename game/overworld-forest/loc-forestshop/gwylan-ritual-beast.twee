:: Gwylan Ritual Bait Sex Plant
<<run statusCheck("Gwylan")>>
<<if $sexstart is 1>>
	<<set $sexstart to 0>>
	<<consensual>><<set $consensual to 1>><<set $fightTargets to []>>
	<<neutral 1>>
	<<maninit "plant">><<npcexpose>>
	<<set $enemyarousalmax to 800>>
	<<if $beastRitual.arousal>>
		<<set $enemyarousal += 120>>
	<</if>>
	<<set _tentacleCount to 9>>
	<<if $beastRitual.person is "player">>
		<<set _tentacleCount += 4>>
	<</if>>
	<<set _tentacleHealth to 8>>
	<<if $beastRitual.milked>>
		<<set _tentacleCount -= 2>>
	<</if>>
	<<if $beastRitual.tainted>>
		<<set $enemyhealthmax += 200>>
		<<set $enemyhealth += 200>>
		<<set $enemyarousalmax += 200>>
		<<set $enemytrust -= 30>>
		<<set $enemyanger += 15>>
		<<set _tentacleHealth += 6>>
		<<if $beastRitual.taintedArm is "right arm">>
			<<set $NPCList[0].righthand to "idle">>
		<<else>>
			<<set $NPCList[0].leftthand to "idle">>
		<</if>>
		<<makeAbomination _tentacleCount _tentacleHealth "vine" "tainted" "desc">>
	<<else>>
		<<makeAbomination _tentacleCount _tentacleHealth "vine" "vine" true>>
	<</if>>

	<<set $speechdisable to 1>><<set $genitalReactionDisable to true>>
	<<set $beastRitual.gwylan to {
		leftarm: 0,
		rightarm: 0,
		mouth: 0
	}>>
	<<set $beastRitual.stateTimer to 0>>
<</if>>
<<if $beastRitual.tainted and $enemyanger lte 100>>
	<<set $enemyanger += 3>>
<</if>>

<<if $enemyanger gte 100 and !$beastRitual.forcedCalm and $beastRitual.gwylan.mouth isnot "choking">>
	<<set $beastRitual.forcedCalm to true>>
	그윌란이 <<personsimple>>의 턱을 부드럽게 잡는다. <<nnpc_his "Gwylan">> 눈에 녹색 빛이 반사된다. "얌전히 있어, 새싹아."
	<br><br>

	<span class="green"><<personsimple>>의 긴장이 풀리고, 진정하는 것 같다.</span>
	<<if $beastRitual.tainted>>
		"미... 미안해. 아파. 구멍...을 채워줘..."
	<<else>>
		"아... 미안해..."
	<</if>>
	<<set $enemyanger to 0>><<set $enemytrust += 50>>

	<<if $beastRitual.gwylan.leftarm isnot 0>>
		<<set _tentToFreeLeft to Object.values($tentacles).find(tentacle => tentacle.id === $beastRitual.gwylan.leftarm)>>
		<<if _tentToFreeLeft>>
			<<tentacleadvdisable _tentToFreeLeft>>
		<</if>>
	<</if>>
	<<if $beastRitual.gwylan.rightarm isnot 0>>
		<<set _tentToFreeRight to Object.values($tentacles).find(tentacle => tentacle.id === $beastRitual.gwylan.rightarm)>>
		<<if _tentToFreeRight>>
			<<tentacleadvdisable _tentToFreeRight>>
		<</if>>
	<</if>>
	<<set $beastRitual.gwylan.leftarm to 0>><<set $beastRitual.gwylan.rightarm to 0>><<set $beastRitual.gwylan.mouth to 0>>
	<<if $beastRitual.taintedArm is "right arm">>
		<<set $NPCList[0].righthand to "idle">><<set $NPCList[0].lefthand to 0>>
	<<else>>
		<<set $NPCList[0].righthand to 0>><<set $NPCList[0].leftthand to "idle">>
	<</if>>
	<br><br>
<</if>>

<<effects>>
<<effectsabomination>>

<<if $speechbanish gte 1 and $beastRitual.tainted and $beastRitual.gwylan.mouth isnot "choking">>
	<<set $speechbanish to 0>>
	<<if !$gwylanSeen.includes("ritual_banish")>>
		<<set $gwylanSeen.pushUnique("ritual_banish")>>
		그윌란이 밝은 빛에 얼굴을 찡그린다. <<nnpc_He "Gwylan">>【은는】 무언가 깨달은 것 같다.
		<<if $beastRitual.gwylan.mouth isnot 0>>
