	<<link [[랜드리를 믿지 않았다고 말한다|Forest Shop Nowhere Talk]]>><<set $gwylan.trouble to "Landry">><</link>>
	<br>
<</if>>
<<if $hypnosis_traits.suggestion gte 4>>
	<<link [[하퍼에게 가까워지고 싶었다고 말한다|Forest Shop Nowhere Talk]]>><<set $gwylan.trouble to "Harper">><</link>>
	<br>
<</if>>
<<if $gwylanSeen.includesAll("romance", "nobody") and $gwylan.triumph is "Gwylan">>
	<<link [[`<<him>>처럼 되고 싶었다고 말한다`|Forest Shop Nowhere Talk Forever]]>><<set $gwylan.trouble to "Gwylan">><</link>>
