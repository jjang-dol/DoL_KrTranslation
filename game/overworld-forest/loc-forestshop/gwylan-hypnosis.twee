<</if>>
<<set $earSlime.defyCooldown to 50>>
<<set $earSlime.eventTimer to 10>>
<<set $earSlime.event to "">>
<<run delete $earSlime.forcedDressing>>
<<run delete $earSlime.noSleep>>
<<run delete $earSlime.alwaysSleepNaked>>
