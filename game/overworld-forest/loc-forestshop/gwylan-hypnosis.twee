	<br>
<<elseif $phase is "monsters">>
	<<link [[다음|Gwylan Hypnosis Insight Monsters]]>><<pass 10>><</link>>
	<br>
<<elseif $phase is "holes">>
	<<link [[다음|Gwylan Hypnosis Insight Holes]]>><<pass 10>><</link>>
	<br>
<<else>>
