	"벌써 그렇게 심해졌나? <<if numberOfEarSlime(true) gte 2>>그것들<<else>>그것<</if>>【을를】 잠재워주겠다는 제안은 아직 유효하다. 네가 할 수 있는 다른 일을 찾아보지."
<<else>>
	<<set $gwylanSeen.pushUnique("ear_slime_intro")>><<set $gwylanSeen.pushUnique("ear_slime")>>
	<<He>>【은는】 신발 상자를 뒤적여 금속 물체를 꺼낸다. <<He>>【은는】 당신 주위를 맴돌며,
	<<if $bodysize is 3>>
		<<his>> 발끝으로 서서
	<<elseif $bodysize is 0>>
		허리를 숙여
	<<else>>
		당신의 머리를 기울여
	<</if>>
	당신의 귓속을 들여다본다. 귓불에 차가운 금속의 감촉이 느껴진다.
	<<if numberOfEarSlime(true) gte 2>>
		<<He>>【은는】 이어서 당신 주위를 돌아, 다른 쪽 귀도 들여다본다.
	<</if>>
	<br><br>

	<<He>>【이가】 한숨을 쉰다. "너는
	<<if numberOfEarSlime(true) gte 2>>
		끔찍한 기생 생물 한 쌍의 숙주가 되었군. 자신들을 보호하도록 강요하고, 네 욕구를 자신들의 욕망으로 덮어쓰는 놈들이지." <<He>>【은는】 당신 앞으로 다가선다. "안전하게 추출할 도구가 없어. 더는. 몇 년 동안 그런 게 필요 없었거든."
	<<else>>
		"끔찍한 기생 생물의 숙주가 되었군. 자신을 보호하도록 강요하고, 네 욕구를 자신의 욕망으로 덮어쓰는 놈이지." <<He>>【은는】 당신 앞으로 다가선다. "안전하게 추출할 도구가 없어. 더는. 몇 년 동안 그런 게 필요 없었거든."
	<</if>>
	<br><br>

	<<He>>【은는】 고개를 돌려 <<his>> 귓불을 앞으로 내민다. <span class="blue">그 뒤에는 화려한 X자 모양의 작은 문신이 있다.</span> 디테일이 복잡하고, 오래 쳐다보면 일부 선이 움직이는 것처럼 보이기도 한다.
	동네 문신 시술소에서 본 그 어떤 것보다 훨씬 정교하다.
	<br><br>

	"네게 좋은 해결책이 되기엔 너무 늦었고, 어차피 잉크 재고도 부족하다. 유일한 영구적인 해결책은 꽤 위험한데, 붉은 달이 떴을 때 화이트플라워 호수의 가라앉은 제단 위에 눕는 것이다.
	숨을 아주 오랫동안 참아야 할 뿐만 아니라, <span class="red">그 호수에는 침입자를 그다지 반기지 않는 무언가가 있다</span>, 그리고 그놈은 바로 이 기생충들의 존재에 이끌리지."
	<br><br>

	<<He>>【은는】 <<his>> 턱에 손을 댄다. "적어도 단기적으로는 도와줄 수 있다. <span class="blue"><<if numberOfEarSlime(true) gte 2>>그것들<<else>>그것<</if>>【을를】 잠재울 수 있는 특별한 최면 기술을 알고 있거든,</span> 아니면 적어도 <<if numberOfEarSlime(true) gte 2>>그것들의<<else>>그것의<</if>> 소음과 화학 물질 방출을 자동으로 걸러낼 수 있게는 해주지."
<</if>>
<br><br>

<<He>>【은는】 잠시 생각에 잠긴다.
<<gwylanRequestEnd "skip">>
<<run gwylanRequest()>>
<<set $gwylan.request.hold to "silence">>
<<gwylanRequestText>>
<br><br>

<<gwylanOptions>>

:: Gwylan Hypnosis Widgets [widget]
<<widget "gwylanHypnosis">>
	<<set $_trait to _args[0]>>
	<<set $_duration to _args[1]>>
	<<set $_level to _args[2] || 5>>
	/* Catch invalid arguments and escape */
	<<if !["devotion", "peace", "silence", "slumber", "insight"].includes($_trait)>>
		<<exit '<span class="red">오류: 잘못된 최면 유형: <<= $_trait>> 부여됨. 보고 바랍니다.</span>'>>
	<</if>>
	<<if typeof $_duration isnot "number">>
		<<exit '<span class="red">오류: 잘못된 최면 지속 시간: <<= $_duration>> 부여됨. 보고 바랍니다.</span>'>>
	<</if>>

	/* Set up colours and text */
	<<switch $_trait>>
		<<case "devotion">>
			<<switch $hypnosis_traits.devotion>>
				<<case 1 0 undefined>><<set $_hypnotic to "최면적">><<set $_color to "lblue">>
				<<case 2>><<set $_hypnotic to "매혹된">><<set $_color to "blue">>
				<<case 3>><<set $_hypnotic to "홀린">><<set $_color to "purple">>
				<<case 4>><<set $_hypnotic to "황홀한">><<set $_color to "pink">>
				<<case 5>><<set $_hypnotic to "숭고한">><<set $_color to "red">>
				<<case 6>><<set $_hypnotic to "광란의">><<set $_color to "basicHypnoCss()">>
			<</switch>>
			<<set $_traitText to $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1 ? "헌신" : "호기심">>
		<<case "peace">><<set $_hypnotic to "최면적">><<set $_color to "forest-green">><<set $_traitText to "평화">>
		<<case "silence">><<set $_hypnotic to "최면적">><<set $_color to "purple">><<set $_traitText to "침묵">>
		<<case "slumber">><<set $_hypnotic to "최면적">><<set $_color to "blue">><<set $_traitText to "수면">>
		<<case "insight">><<set $_hypnotic to "최면적">><<set $_color to "grey">><<set $_traitText to $awareness gte 300 ? "무지" : "통찰">>
	<</switch>>

	<<if !$hypnosis_traits[$_trait] and $_duration lte 0>>
		/* Error, escape */
		<<exit '<span class="red">오류: 잘못된 부정적인 최면 지속 시간: 존재하지 않는 특성 <<= $_trait>>에 <<= $_duration>> 부여됨. 보고 바랍니다.</span>'>>

	<<elseif !$hypnosis_traits[$_trait] and $_duration gt 0>>
		/* Initial trait gain */
		<<set $hypnosis_traits[$_trait] to 1>>
		<<set $hypnosisTimers[$_trait] to {}>>
		<<set $hypnosisTimers[$_trait].time to $_duration>>
		<<if $_trait is "devotion">>
			/* Initial Curiosity/Devotion gain */
			<<set $hypnosisTimers[$_trait].max to gwylanHypnoMax("value")>>
			<<set $hypnosisTimers[$_trait].time to Math.clamp($hypnosisTimers[$_trait].time, 0, gwylanHypnoMax("value"))>>
			<<set $gwylanSeen.pushUnique("hypnosis_first")>>
			<span @class="$_color">해답 없는 질문이 머릿속을 채우고, 숲의 환영이 맴돈다. 그윌란이 조금 더 부드러운 존재처럼 느껴진다.</span><br>
			<span @class="$_color"><<= $_hypnotic>> <<= $_traitText>></span> 특성을 획득했습니다. <<arousal 200>><<awareness 2>><<garousal>><<gawareness>>
		<<else>>
			/* Other trait gain */
			<<set $hypnosisTimers[$_trait].max to $_duration>>
			<span @class="$_color"><<= $_hypnotic>> <<= $_traitText>></span> 특성을 획득했습니다.
		<</if>>
		<<hypnotised 1>>

	<<elseif $hypnosis_traits[$_trait] and $_duration lte 0>>
		/* Duration/trait down */

		<<if $_trait is "devotion">>
			<<set $hypnosisTimers.devotion.time to Math.clamp($hypnosisTimers.devotion.time + $_duration, 0, gwylanHypnoMax("value"))>>
			<<if $hypnosisTimers.devotion.time lte gwylanHypnoMax("value", $hypnosis_traits.devotion - 1)>>
				<<switch $hypnosis_traits.devotion>>
					<<case 1>>/* Trait cleared */
						<<run delete $hypnosis_traits.devotion>><<run delete $hypnosisTimers.devotion>>
						<span class="erase-from-history">한때 머릿속에 </span><span class="erase-from-history">강렬한 질문을 </span><span class="erase-from-history">품고 있었던 </span><span class="erase-from-history">것 같지만, </span><span class="erase-from-history">이제는 전혀 </span><span class="erase-from-history">기억나지 않는다.</span><br>
						당신의 <span class="lblue">최면적인 <<= $_traitText>></span>【이가】 <<print either("증발했다", "빠져나갔다", "물러났다")>>. <<awareness -2>><<lawareness>><br>
					<<case 2>>/* Decay to level 1 */
						<<set $hypnosis_traits.devotion-->>
						<span class="lblue">머릿속을 맴돌던 수수께끼가 애초에 답이 없었던 것처럼 공허해진다. 기억 속에서 누군가가 차지하고 있던 자리가 텅 빈 것처럼 느껴진다.</span><br>
						당신의 <span class="blue">마법에 걸린 <<= $_traitText>></span>【이가】 얕아져 <span class="lblue">최면적인 <<= $_traitText>></span>【으로로】 변했습니다. <<awareness -4>><<lawareness>><br>
					<<case 3>>/* Decay to level 2 */
						<<set $hypnosis_traits.devotion-->>
						<span class="blue">머릿속 깊은 곳에 자리 잡은 미스터리가 닫히고 단순해지기 시작한다. 그윌란의 웃는 얼굴에 대한 환영이 흐려지고 희미해진다.</span><br>
						당신의 <span class="purple">매혹당한 <<= $_traitText>></span>【이가】 얕아져 <span class="blue">마법에 걸린 <<= $_traitText>></span>【으로로】 변했습니다. <<awareness -6>><<lawareness>><br>
					<<case 4>>/* Decay to level 3 */
						<<set $hypnosis_traits.devotion-->>
						<span class="purple">머릿속을 맴돌던 역설이 해방되어 결론에 도달한다. 그윌란에 대한 요염한 환영이 잿빛으로 퇴색된다.</span><br>
						당신의 <span class="pink">넋을 잃은 <<= $_traitText>></span>【이가】 얕아져 <span class="purple">매혹당한 <<= $_traitText>></span>【으로로】 변했습니다. <<awareness -8>><<llawareness>><br>
					<<case 5>>/* Decay to level 4 */
						<<set $hypnosis_traits.devotion-->>
						<span class="pink">한때 간직했던 답이 사라지고, 그와 함께 반복되던 새로운 질문의 파도도 멈춘다. 당신은 무언가를 잊어버렸다.</span><br>
						당신의 <span class="red">경외감을 주는 <<= $_traitText>></span>【이가】 얕아져 <span class="pink">넋을 잃은 <<= $_traitText>></span>【으로로】 변했습니다. <<awareness -12>><<llawareness>><br>
					<<case 6>>/* Decay to level 5 */
						<<set $hypnosis_traits.devotion-->>
						<span class="red">광기 어린 나선형 소용돌이가 마침내 당신을 그 구속에서 풀어준다.</span><br>
						당신의 <span @class="basicHypnoCss()">광적인 <<= $_traitText>></span>【이가】 얕아져 <span class="red">경외감을 주는 <<= $_traitText>></span>【으로로】 변했습니다. <<awareness -15>><<lllawareness>><br>
				<</switch>>
			<<elseif $_duration lte -2>>
				<span class="witchbloom">당신의 <span @class="$_color"><<= $_traitText>></span>【이가】 얕아집니다.</span>
			<</if>>
			<<if $hypnosisTimers.devotion>>
				<<set $hypnosisTimers.devotion.max to gwylanHypnoMax("value")>>
			<</if>>
		<<else>>
			<<if $hypnosisTimers[$_trait].time + $_duration lte 0>>
				<<run delete $hypnosis_traits[$_trait]>><<run delete $hypnosisTimers[$_trait]>>
				<<switch $_trait>>
					<<case "peace">>
						<span class="purple">익숙한 불확실성이 당신의 존재를 채운다. 당신의 최면적 평화가 사라졌습니다.</span><br>
					<<case "silence">>
						<<if numberOfEarSlime()>>
							<span class='purple'>익숙한 속삭임이 귓가를 채운다. 당신의 최면적 침묵이 사라졌습니다.</span><br>
						<<else>>
							<span class='purple'>당신의 최면적 침묵이 사라졌습니다.</span><br>
						<</if>>
					<<default>>
						<span class="purple">당신의 최면적인 <<= $_traitText>>【이가】 사라졌습니다.</span><br>
				<</switch>>
			<</if>>
		<</if>>

	<<else>>
		/* Trait already exists */

		<<if $_trait is "devotion">>
			/* Hypnotic Curiosity/Devotion trait levels and logic */
			<<if $hypnosis_traits.devotion gt $_level>>
				/* Level of action is insufficient to increase curiosity/devotion */
				<span class="witchbloom">친숙한 포옹이 당신의 심장을 감싸지만, 당신의 <span @class="$_color"><<= $_traitText>></span>【은는】 더 깊어지지 않습니다.</span>
			<<else>>
				<<if $hypnosisTimers.devotion.time + $_duration gt gwylanHypnoMax("value") and $hypnosis_traits.devotion gte gwylanHypnoMax("trait")>>
					/* Max current trait level, can't increase further */
					<<if $daily.devotionWall>>
						<<if $hypnosis_traits.devotion gte 5>>
							<<set _devotionTrauma to true>>
							<span class="witchbloom">당신은 더 깊숙이 빠져든다.</span> <<arousal 1000>><<trauma 12>><<ggarousal>><<ggtrauma>>
						<<else>>
							<span class="forest-green">당신의 마음은 더 깊은 <<= $_traitText>>【을를】 거부하며, 마지막 순간에 이성의 기슭으로 되돌아온다.</span>
						<</if>>
					<<elseif $hypnosis_traits.devotion gte 5>>
						<<set _devotionTrauma to true>>
						<span class="witchbloom">당신의 마음은 무한한 질문의 길을 따라 끊임없이 깊이 파고든다.</span> <<arousal 500>><<stress -3>><<trauma 12>><<garousal>><<lstress>><<ggtrauma>>
					<<else>>
						<<set _devotionTrauma to true>>
						당신의 마음은 뭔가 더 깊은 곳으로 미끄러져 들어가려는 찰나의 느낌이 들었지만, <span class="forest-green">마지막 순간 이성의 기슭으로 되돌아온다.</span>
						당신의 <span @class="$_color"><<= $_hypnotic>> <<= $_traitText>></span>【은는】 가라앉지 못한다. <<arousal 500>><<stress -3>><<trauma 3>><<garousal>><<lstress>><<gtrauma>>
					<</if>>
					<<set $daily.devotionWall to true>>
				<<elseif $hypnosisTimers.devotion.time + $_duration gt gwylanHypnoMax("value")>>
					/* Trait level increases */
					<<set $_score to Math.clamp($hypnosisTimers.devotion.time + $_duration, 0, gwylanHypnoMax("value", gwylanHypnoMax()))>>
					<<switch gwylanHypnoMax("level", $_score)>>
						<<case 0 1>>
							/* Should be impossible */
						<<case 2>>
							<span class="blue">말대답할 수 없는 수수께끼가 머릿속을 채우고, 숲속 상점의 환영이 맴돈다. 그윌란에 대한 기묘한 애착심이 뒤따른다.</span><br>
							당신의 <span @class="$_color"><<= $_hypnotic>> <<= $_traitText>></span>【이가】 깊어졌습니다. 당신은 이제 <span class="blue">마법에 걸린</span> 상태입니다. <<arousal 500>><<awareness 4>><<garousal>><<gawareness>>
						<<case 3>>
							<span class="purple">결말 없는 미스터리가 머릿속을 채우고, 그윌란의 웃는 얼굴의 환영이 맴돈다. <<nnpc_He "Gwylan">> 너무나 안전하고 편안해 보인다.</span><br>
							당신의 <span @class="$_color"><<= $_hypnotic>> <<= $_traitText>></span>【이가】 깊어졌습니다. 당신은 이제 <span class="purple">매혹당한</span> 상태입니다. <<arousal 1000>><<awareness 6>><<ggarousal>><<gawareness>>
						<<case 4>>
							<span class="pink">해결될 리 없는 역설이 머릿속을 채우고, 그윌란의 알몸 환영이 맴돈다. <<nnpc_He "Gwylan">> 너무나 따스하고 환영받는 느낌이다.</span><br>
							당신의 <span @class="$_color"><<= $_hypnotic>> <<= $_traitText>></span>【이가】 깊어져, <span class="pink">넋을 잃은</span> 상태가 되었습니다. <<arousal 1000>><<awareness 8>><<ggarousal>><<ggawareness>>
						<<case 5>>
							<<if !$gwylanSeen.includes("hypnosis_sublime")>>
								<<set $gwylanSeen.pushUnique("hypnosis_sublime")>>
								<span class="red">마침내 어떤 해답이 당신의 마음을 채운다. <<nnpc_Hes "Gwylan">> 내내 당신 앞에 있었다. 당신은 바닥을 찾을 수 있을 거라 예상했지만, 여전히 바다 위를 표류하고 있다.
								<<nnpc_He "Gwylan">>【은는】 무한히 아래로 소용돌이치며 더 많은 의문을 불러일으킬 뿐이다. 그윌란의 환영이 당신이 가진 다른 모든 생각을 지워버린다. <<nnpc_He "Gwylan">>【이가】 전부다.</span><br>
								당신의 <span @class="$_color"><<= $_hypnotic>> <<= $_traitText>></span>【이가】 피어나, <span class="red">숭고함</span>이 되었습니다. <<arousal 1000>><<awareness 12>><<ggarousal>><<ggawareness>>
							<<else>>
								<span class="red">마침내 어떤 해답이 당신의 마음을 채운다. <<nnpc_He "Gwylan">>【이가】 내내 당신 앞에 있었다. <<nnpc_He "Gwylan">>【이가】 전부다.</span><br>
								당신의 <span @class="$_color"><<= $_hypnotic>> <<= $_traitText>></span>【이가】 심연의 깊이보다 더 깊어지며, <span class="red">숭고함</span>이 되었습니다. <<arousal 1000>><<awareness 12>><<ggarousal>><<ggawareness>>
							<</if>>
						<<case 6>>
							<span @class="basicHypnoCss()">당신은 바닥 아래로 곤두박질치며, 애초에 존재해서는 안 될 무언가로 떨어져 내린다. 당신은 손을 뻗어보지만 허공을 쥘 뿐이다. 어떤 것도 다시 당신을 붙잡아주지 않고, 그 무엇도 예전과 같지 않을 것이다.</span><br>
							당신의 <span @class="$_color"><<= $_hypnotic>> <<= $_traitText>></span>【이가】 <span class="basicHypnoCss()">광적인</span> 상태가 되었습니다. <<arousal 5000>><<awareness 20>><<gggarousal>><<gggawareness>>
						<<default>>
					<</switch>>
					<<set $hypnosis_traits.devotion to gwylanHypnoMax("level", $_score)>><<hypnotised 1>>
				<<else>>
					/* Trait level does not increase but value does */
					<span class="blue">당신의 <span @class="$_color"><<= $_traitText>></span>【이가】 깊어집니다.</span>
				<</if>>
				<<set $hypnosisTimers[$_trait].time to Math.clamp($hypnosisTimers[$_trait].time + $_duration, 0, gwylanHypnoMax("value"))>>
				<<set $hypnosisTimers[$_trait].max to gwylanHypnoMax("value")>>
			<</if>>

		<<else>>
			<<set $hypnosisTimers[$_trait].time to Math.clamp($hypnosisTimers[$_trait].time + $_duration, 0, 30)>>
			/* Refreshing/adding duration of existing unlevelled traits */
			<<if $hypnosisTimers[$_trait].max lt $_duration>>
				/*If existing max is less than new base duration, equalise before overflow check */
				<<set $hypnosisTimers[$_trait].max to $_duration>>
			<</if>>
			<<if $hypnosisTimers[$_trait].time gte $hypnosisTimers[$_trait].max>>
				/* Allow some overflow, up to 1/2 of overflow value added on to time and max */
				<<set $_overflow to $hypnosisTimers[$_trait].time - $hypnosisTimers[$_trait].max>>
				<<set $_adjustment to Math.ceil($_overflow / 2)>>
				<<set $hypnosisTimers[$_trait].time to $hypnosisTimers[$_trait].max += $_adjustment>>
				<<set $_overflow to true>>
			<</if>>
			<<set $hypnosisTimers[$_trait].max to Math.max($hypnosisTimers[$_trait].max, $hypnosisTimers[$_trait].time)>>
			당신의 <span @class="$_color">최면적인 <<= $_traitText>></span>【이가】 강화되었습니다.
			<<if $_overflow>>
				<span class="blue">당신의 무아지경이 지난번보다 더 깊어졌다고 느껴집니다.</span>
			<</if>>
			<<hypnotised 1>>
		<</if>>
	<</if>>
<</widget>>

<<widget "gwylanHypnoNote">>
	<<set $_note to "">>
	<<if _args[0] is "kiss" and !$gwylanSeen?.includes("kiss_hypno")>>
		/* Do nothing, no warning the first time hypnosis from kiss happens */
	<<elseif $gwylanSeen?.includes("hypnosis_first")>>
		<<set $_devotion to $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1 ? "헌신" : "호기심">>
		<<set $_level to _args[0] || 6>>
		/* Change level later if needed, levelled actions not currently used */
		<<if $_level is "kiss">><<set $_level to 6>><</if>>
		<<if $_level lte $hypnosis_traits.devotion>>
			<<set $_color to "black">>
			| <span @class='$_color'><<print $_devotion>></span>
		<<else>>
			<<switch $hypnosis_traits.devotion>>
				<<case 1>><<set $_color to "blue">>
				<<case 2>><<set $_color to "purple">>
				<<case 3>><<set $_color to "pink">>
				<<case 4>><<set $_color to "red">>
				<<case 5>><<set $_color to "witch">>
				<<default>><<set $_color to "lblue">>
			<</switch>>
			| <span @class='$_color'>+ <<print $_devotion>></span>
		<</if>>
	<</if>>
	<<if _args[0] is "kiss">>
		<<kissvirginitywarning>>
	<</if>>
<</widget>>

<<widget "gwylanWillpowerDifficulty">>
	<<set $_level to _args[0] || 1>>
	<<if !$hypnosis_traits.devotion or $hypnosis_traits.devotion lt $_level>>
		<<set $willpowerSuccess to 1>>
	<<elseif $hypnosis_traits.devotion gte 5>>
		/* resisting Gwylan is now impossible */
		<<if !$settings.blindStatsEnabled>>
			<<if $settings.skillCheckStyle is "skillname">>
				<<hypnosisText "<span class='white'>|</span> <span class='orange'>의지력</span>">>
			<<else>>
				| <span class='orange'>의지력</span>:
				<<switch random(1, 18)>>
					<<case 1>><<hypnosisText "꺼졌다.">>
					<<case 2>><<hypnosisText "내 손가락 사이의 진흙.">>
					<<case 3>><<hypnosisText "쉿, <<pcpetname 'Gwylan'>>.">>
					<<case 4>><<hypnosisText "이건 네가 원한 거야, <<pcpetname 'Gwylan'>>.">>
					<<case 5>><<hypnosisText "기꺼이 내어졌다.">>
					<<case 6>><<hypnosisText "내가 간직할 것.">>
					<<default>><<hypnosisText "불가능해.">>
				<</switch>>
			<</if>>
		<</if>>
		<<set $willpowerSuccess to 0>>
	<<elseif $hypnosis_traits.devotion gte 1>>
		<<willpowerdifficulty `120 * $hypnosis_traits.devotion` `350 * $hypnosis_traits.devotion`>>
	<<else>>
		<<set $willpowerSuccess to 1>>
	<</if>>
<</widget>>

<<widget "gwylanKiss">>
	<<set $_devotionUp to typeof _args[0] is "number" ? _args[0] : 5>>
	<<if $_devotionUp isnot 0>>
		<<if $daily.gwylan.kiss>>
			<<hypnosisText "지금 당신에게 세상의 다른 건 아무래도 상관없다.">>
		<<else>>
			<<hypnosisText "당신은 잠시 세상이 희미해지는 것을 느낀다. 의심과 고민은 사라지고, 모든 것이 너희 둘만 남을 만큼 좁아진다.">>
		<</if>>
		<<set $gwylanSeen.pushUnique("kiss_hypno")>><<set $daily.gwylan.kiss to true>>
		<<gwylanHypnosis "devotion" 5>>
		<<if !_devotionTrauma>>
			<<trauma -4>><<ltrauma>>
		<</if>>
	<</if>>
	<<set $_lustUp to 0 + $gwylanSeen.count("partners") + $gwylanSeen.count("romance")>>
	<<if $_lustUp>>
		<<npcincr Gwylan lust $_lustUp>><<glust>>
	<</if>>
	<<if $player.virginity.kiss is true>>
		<<if $_devotionUp or $_lustup>><br><</if>>
		<<takeKissVirginity "Gwylan" "romantic">>
	<</if>>
<</widget>>

<<widget "gwylanCommand">><<silently>>
	<<set $_gwylanCommand to _args[0]>>
	<<set $_hypnosis_level to _args[1] or 1>>
	<<if $hypnosis_traits.devotion gte $_hypnosis_level>>
		<<set $_gwylanCommand to '<span class="witch">' + $_gwylanCommand + '</span>'>>
	<</if>>
<</silently>><<print $_gwylanCommand>><</widget>>

<<widget "gwylanHypnoCanvas">>
	<<canvas-model-override "left_eye" "green">>
	<<canvas-model-override "right_eye" "green">>
	<<canvas-model-override "trauma" true>>
	<<canvas-model-override "eyes_half" true>>
	<<canvas-model-override "mouth" "cry">>
	<<if !$sexRitual?.bondage>>
		<<canvas-model-override "arm_left" "idle">>
		<<canvas-model-override "arm_right" "idle">>
	<</if>>
<</widget>>

<<widget "gwylanHypnoEffect">><<silently>>
	<<if $gwylanSeen.includes("hypnosis_intro")>>
		<<set $_plus to _args[0]>>
		<<switch $_plus>>
			<<case 3>><<set $_text_output to " | <span class='teal'>+ + + 최면 위력</span>">>
			<<case 2>><<set $_text_output to " | <span class='teal'>+ + 최면 위력</span>">>
			<<case 1>><<set $_text_output to " | <span class='teal'>+ 최면 위력</span>">>
			<<case -1>><<set $_text_output to " | <span class='purple'>- 최면 위력</span>">>
			<<case -2>><<set $_text_output to " | <span class='purple'>- - 최면 위력</span>">>
			<<case -3>><<set $_text_output to " | <span class='purple'>- - - 최면 위력</span>">>
			<<default>><<set $_text_output to " | <span class='teal'>+ 최면력</span>">>
		<</switch>>
	<</if>>
<</silently>><<if $_text_output>><<print $_text_output>><</if>><</widget>>

<<widget "gwylanSong">>
	<<if !$gwylan.lureSong>><<exit>><</if>>
	<<run statusCheck("Gwylan")>>
	<<if _args[0] isnot "end">>
		<<switch $gwylan.lureSong>>
			<<case 1>>
				<<if $islander_language gte 100>>
					<span class="narration">
					<<if $rng gte 51 and ($wolfgirl gte 6 or $cat gte 6 or $cow gte 6 or $harpy gte 6 or $fox gte 6)>>
						<<if $wolfgirl gte 6>>
							<<if $gwylanSeen?.includes("partners")>>날 위해<<else>>나와 함께<</if>> 뛰는 야생의 심장이여<br>
							이곳에 길이 있으니<br>
							기다리는 바다와 하나 되기 위한 길이라오.
						<<elseif $cat gte 6>>
							당신의 호기심은<br>
							우리가 함께 할 때까지 우릴 띄워주리니<br>
							그때 비로소 기다리는 바다에 합류할 수 있을 것이오.
						<<elseif $cow gte 6>>
							강요된 당신의 순종은
							우리의 운명을 멈추지 못하리니;
							우리는 기다리는 바다와 함께할 것이오.
						<<elseif $harpy gte 6>>
							노래하는 새여, 나와 함께 날아오르오.<br>
							내가 당신을 데려가 주리니<br>
							기다리는 바다와 하나 되기 위함이라오.
						<<else>>
							친애하는 동족이여, 곧 당신도 알게 될 것이니<br>
							<<if $auriga_scar>>
								우리의 검은 심장은 준비되었소<br>
							<<else>>
								우리의 심장, 치유제가 되어<br>
							<</if>>
							기다리는 바다와 함께하리라.
						<</if>>
					<<else>>
						<<if $gwylanSeen?.includes("romance") and $rng lte 25>>
							내 사랑, 당신은 언제나 알 수 있었지
						<<elseif $demon gte 6>>
							열정이 당신을 이끌어 알게 하고
						<<elseif $angel gte 6>>
							미덕이 당신을 이끌어 알게 하리니
						<<elseif $fallenangel gte 4>>
							용서받은 마음들은 알게 되리라
						<<elseif $fallenangel gte 2 or $auriga_scar>>
							당신의 검은 심장은 알고 싶어 갈망하고
						<<else>>
							당신 안에 그 해답이 있었소
						<</if>><br>
						이곳에 길이 있으니<br>
						기다리는 바다와 하나 되기 위한 길이라오.
					<</if>>
					</span>
				<<else>>
					가사는 당신이 알지 못하는 언어로 되어 있다.
				<</if>>
			<<case 2>>
				<<if $islander_language gte 100>>
					<span class="narration">
					<<if _gwylanStatus.includes("badEndReady") or $gwylanSeen?.includes("romance") and $rng gte 51>>
						당신 피부에 닿은 내 손길을 느껴보오,<br>
						바람결에 속삭이는 그 이름을,<br>
						우리의 손길이 스며들게 해.
					<<else>>
						당신 피부의 짠내를 느껴보오,<br>
						바람결에 속삭이는 그 이름을,<br>
						빛이 스며들게 해.
					<</if>>
					</span>
				<<else>>
					<span class="blue">이 노래는 마치 자장가처럼 들린다.</span>
				<</if>>
			<<case 3>>
				<<if $islander_language gte 100>>
					<span class="narration">
					<<if _gwylanStatus.includes("badEndReady") or $gwylanSeen?.includes("romance") and $rng gte 51>>
						지친 당신 뼈를 내 달래주리라,<br>
						오직 연인의 속삭임만으로,<br>
						물이 돌을 다듬어 내듯.
					<<else>>
						뼛속 깊이 새겨진,<br>
						처녀, 어머니, 노파의 말들이,<br>
						물이 돌을 깎아내듯.
					<</if>>
					</span>
				<<else>>
					<span class="purple">눈꺼풀이 무거워진다.</span> <<tiredness 2>><<gtiredness>>
				<</if>>
			<<case 4>>
				<<if $islander_language gte 100>>
					<span class="narration">
					<<if _gwylanStatus.includes("badEndReady") or $gwylanSeen?.includes("romance") and $rng gte 51 or $auriga_scar>>
						나와 함께 이곳을 걷다 보면, 우리는 찾게 되리<br>
						시간 속에 잃어버린 모든 것을,<br>
						부서진 봉인을 다시 묶어내리라.
					<<else>>
						당신의 길을 밟으시오, 해가 돋는 방향으로<br>
						잃어버린 것을 찾고, 부디 후회하지 마오,<br>
						그것은 아직도 당신을 위해 노래하고 있으니.
					<</if>>
					</span>
				<<else>>
					<span class="purple">눈꺼풀이 무거워진다.</span> <<tiredness 2>><<gtiredness>>
				<</if>>
			<<case 5>>
				<<if $islander_language gte 100>>
					<span class="narration">
					<<if _gwylanStatus.includes("badEndReady") or $gwylanSeen?.includes("romance") and $rng gte 51 or $auriga_scar>>
						강물이 그 흐름을 바꾼다오<br>
						버려진 우리의 이름들을 위해,<br>
						냇가에 말없이 누워있던 이름들.
					<<else>>
						뿌리를 내리거라 아이야, 네 방패를 들어라.<br>
						네 이름을 품어라, 드러나지 않은 채로.<br>
						강물은 온다. 그들은 물러설 것이다.
					<</if>>
					</span>
				<<else>>
					<span class="blue">노래의 가사는 희미해지고, 그저 선율만이 이어질 뿐이다. 그것이 너무나도 익숙하게 들린다.</span>
				<</if>>
			<<default>>
				<span class="blue">노래의 멜로디가 나무 사이에서 춤을 춘다.</span>
		<</switch>>
		<<set $gwylan.lureSong++>>
	<<else>>
		<<if $islander_language gte 100>>
			<span class="narration">
			<<if _gwylanStatus.includes("badEndReady")>>
				쉿, 이제 다시 잠들 시간이야.<br>
				더 깊이, 아득한 잠에 빠져들렴.<br>
				<span class="red">마침내, 너는 내가 간직할 내 것이니.</span>
			<<else>>
				깨어나라, 깊은 잠에서 일어나렴.<br>
				<<if $auriga_scar>>어둠의 엘크가<<else>>어둠이<</if>> 거두지 못하리니<br>
				그것은 대지가 간직할 것이리라.
			<</if>>
			</span>
		<<else>>
			<span class="blue">노래 소리가 멈춘다.</span>
		<</if>>
	<</if>>
<</widget>>
