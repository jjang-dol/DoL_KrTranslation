:: Gwylan Request Widgets [widget]
<<widget "gwylanRequestText">>
    <<set $_request to gwylanRequest()>>
    <<switch $_request.event>>

        <<case "clothing">>
            <<if $_request.special is "gas mask">>
                "하이 가에 있는 옷가게에 <u>방독면</u>이 새로 들어왔다는 소문을 들었어. 그게 진짜 방독면인지, 아니면 그냥 특이한 코스튬인지 알고 싶네.
                괜찮다면 나한테 하나 가져다줄래? 특별히, <span class="white">흰색</span> 렌즈가 달린 <span class="black">검은색</span> 방독면으로 부탁해. <span class="gold">그걸 직접 쓰고 이리 와야 해</span>."
            <<elseif $_request.special is "gold accessories">>
                "엘크 가에 있는 성인용품점에서 파는 장신구 세트가 있어. <u>전부 황금으로 맞춰진 세트지. 팔찌, 발찌, 그리고 초커까지.</u>
                초라한 나를 위해 그 정도 수고는 해줄 수 있겠지? 물론, <span class="gold">네가 그걸 입고 있는 모습을 먼저 보고 싶네</span>."
            <<else>>
                <<set $_outfit to $_request.details.outfit>>
                <<set $_shops to $_request.details.shops>>
                <<set $_shopPrimaryRaw to $_shops.includes("clothing") ? "clothing" : $_shops[0]>>
                <<set $_shopTextRaw to $_shops.filter(shop => shop !== $_shopPrimaryRaw)>>
				<<set _translateShop to function(shop) {
					switch(shop) {
						case "clothing": return "옷가게";
						case "adult": return "성인용품점";
						case "antique": return "골동품점";
						default: return shop;
					}
				}>>

				<<set $_shopPrimary to _translateShop($_shopPrimaryRaw)>>
				<<set $_shopText to $_shopTextRaw.map(shop => _translateShop(shop))>>
                "내 눈길을 사로잡은 <<if $_outfit>>옷 세트가<<else>>옷이 하나<</if>> 있어.
                저기 <<= $_shopPrimary>>에 말이야<<if $_shopText.length gte 1>>. 뭐, <<= formatList($_shopText, "그리고")>> 상점<<if $_shopText.length gte 2>>들<</if>>에도 재고가 있을 거라고 생각하지만<</if>>.
                <<set $_shoppingList to $_request.items.filter(piece => !piece.skip && !piece.alt)>>
                <<set $_plural to $_outfit || $_shoppingList[0].word is "n">>
                <<if $_outfit>>
                    <span class="teal">그건 전체 세트야.</span>
                <</if>>
                <<set _shoppingListText to []>>
                <<for $_i to 0; $_i lt $_shoppingList.length; $_i++>>
                    <<set $_colour to $_shoppingList[$_i].colour_requirement>>
                    <<set $_colour_acc to $_shoppingList[$_i].acc_colour_requirement>>
                    <<set $_word to $_shoppingList[$_i].word>>
                    <<if $_colour isnot "any">>
                        <<set $_firstWord to $_word is "n" ? "<span class='" + $_colour + "'>" + setup.colourName($_colour) + "</span> 세트" : "<span class='" + $_colour + "'>" + setup.colourName($_colour) + "</span>">>
                        <<set $_secondWord to $_colour_acc isnot "any" ? "에 <span class='" + $_colour_acc + "'>" + setup.colourName($_colour_acc) + "</span> 장식이 들어간" : "">>
                    <<else>>
                        <<set $_firstWord to $_word is "n" ? "세트" : "">>
                        <<set $_secondWord to "">>
                    <</if>>
                    <<set $_theName to "<u>" + $_shoppingList[$_i].name + "</u>">>
                    <<set $_theRest to ($_firstWord ? $_firstWord + " " : "") + $_secondWord + ($_secondWord ? " " : "") + $_theName>>
                    <<set _shoppingListText.push($_theRest)>>
                <</for>>
                <<= formatList(_shoppingListText, "그리고", true).toUpperFirst()>>.
                <<if $_request.items.some(item => item.integrity_requirement isnot "any")>>
                    <<set $_full to []>><<set $_frayed to []>><<set $_torn to []>><<set $_tattered to []>>
                    <<for $_i to 0; $_i lt $_shoppingList.filter(items => items.integrity_requirement isnot "any").length; $_i++>>
                        <<switch $_shoppingList[$_i].integrity_word>>
                            <<case "full">><<set $_full.push($_shoppingList[$_i].name)>>
                            <<case "frayed">><<set $_frayed.push($_shoppingList[$_i].name)>>
                            <<case "torn">><<set $_torn.push($_shoppingList[$_i].name)>>
                            <<case "tattered">><<set $_tattered.push($_shoppingList[$_i].name)>>
                        <</switch>>
                    <</for>>
                    <<if $_full.length>>
                        <<if $_full.length gt 1>><<print formatList($_full, "【와과】")>>【은는】 <<elseif $_plural>>그것들은<<else>>그것은<</if>> <span class="green">아주 새것</span>이었어.
                    <</if>>
                    <<if $_frayed.length>>
                        난 <<if $_frayed.length gt 1>><<print formatList($_frayed, "【와과】")>>【이가】 <<elseif $_plural>>그것들이<<else>>그것이<</if>> 조금 닳은 뒤엔 어떤 모습일지 궁금해, 어쩌면 <span class="teal">올이 풀려도</span> 괜찮을 거야.
                    <</if>>
                    <<if $_torn.length>>
                        <<if $_torn.length gt 1>><<print formatList($_torn, "【와과】")>>【을를】<<elseif $_plural>>그것들을<<else>>그것을<</if>> 입고 거리를 돌아다니는 걸 두려워하지 마, 난 그게 <span class="purple">찢어졌을 때</span> 어떻게 보일지 알고 싶거든.
                    <</if>>
                    <<if $_tattered.length>>
                        <<if $_tattered.length gt 1>><<print formatList($_tattered, "【와과】")>>【을를】<<elseif $_plural>>그것들을<<else>>그것을<</if>> 한동안 입고 있어 봐, <span class="red">너덜너덜</span>해질 때까지 말이야.
                    <</if>>
                <</if>>
                <<set $_conclusions to [
                    "네가 입으면 정말 멋질 거야! 내가 볼 수 있게 <span class='gold'>꼭 입고 이리 와야 해</span>.",
                    "괜찮다면, <span class='gold'>그걸 직접 입고 이리 와줘.</span>",
                    "<span class='gold'>그걸 입고 여기로 와준다면,</span> 정말 훌륭할 거야.",
                ]>>
                <<if $gwylanSeen.includes("yearning") and $gwylan.timer.ritual and Time.date.dayDifference(new DateTime($gwylan.timer.ritual)) lte 0>>
                    <<set $_conclusions.push("<span class='gold'>그걸 입고 여기로 와줘.</span> 어쩌면 내가 바로 찢어 벗겨버릴지도 모르니까.")>>
                <</if>>
                <<print $_conclusions.pluck()>>
                <<if $_request.details.replacements is "allowed">>
                    여러 가지 스타일이 있는데, <span class="green">아무거나 상관없어</span>."
                <<elseif $_request.details.replacements is "blocked">>
                    여러 가지 스타일이 있으니까, <span class="red">꼭 제대로 된 걸로 가져와야 해.</span>"
                <<else>>
                    <<print either("어렵진 않을 거야.", "번거로울 것 없어.", "그럼 어서 해, 얘야.", "신세 좀 질게.")>>"
                <</if>>
            <</if>>
            <br><br>

            <span class="gold">그윌란의 의뢰가 당신의 일지에 추가되었습니다.</span>

		<<case "ingredients">>
			<<if $_request.special is "tutorial">>
				<<set $_shroomAmount to $_request.items.find(shroom => shroom.name === "wolfshroom").need>>
				"늑대버섯이 뭔지 알아?"
				<br><br>

				<<if $scienceshroomknown is 1 and $scienceproject is "ongoing">>
					당신은 고개를 끄덕인다. "지금 학교 과학 과제에 쓸까 생각 중이었어요," 당신이 말한다. "고대 전사들 사이에서 인기 있었잖아요."
					<br><br>

					"멋지네! 재고가 얼마 없어서, 몇 개쯤 더 필요했거든.
				<<elseif $foodstuff.wolfshroom.amount>>
					당신은 고개를 끄덕인다. "전에 따본 적 있어요."
					<br><br>

					"멋지네! 재고가 얼마 없어서, 몇 개쯤 더 필요했거든.
				<<elseif currentSkillValue('science') gte 200>>
					당신은 학교에서 들은 것을 떠올리며 고개를 끄덕인다. "고대 전사들이 귀하게 여겼잖아요," 당신이 말한다.
					<br><br>

					"멋지네! 재고가 얼마 없어서, 몇 개쯤 더 필요했거든.
				<<else>>
					당신은 고개를 가로젓는다.
					<br><br>

					"참 신기한 녀석들이야. 갈색 줄기에 밝은 붉은색 갓이 씌워져 있지. 나중에 더 자세히 알려줄게.
				<</if>>
				가서 <span class="gold"><<number $_shroomAmount>></span>개만 찾아와 준다면, 오늘 하루가 훨씬 수월해질 거야."
			<<elseif $_request.special is "plums">>
				"내가 좀... 먹고 싶은 게 생겨서. 괜찮다면 가서... 서양자두 좀 잔뜩 가져다줄래." <<He>>【이가】 손을 뻗어 당신의 볼을 꼬집는다. "부탁할게?"
				<br><br>

				<<He>>【은는】 <<his>> 손을 내려 <<his>> <<bellyDescription "Gwylan">> 위에 얹는다. "많이 가져다줘. 지금 난 두 몫을 먹어야 하잖아."
			<<else>>
				<<set $_types to []>>
				<<run $_request.items.forEach(item => $_types.pushUnique(item.type))>>
				<<if $_types.length is 1>>
					<<switch $_types[0]>>
						<<case "flower">>
							"내 정원에도 유전적 다양성이 필요해서, 야생화를 좀 꺾어오려던 참이었어.
						<<case "fruit">>
							"<<print either("발효", "씨앗 추출", "착즙")>>【을를】 할 과일이 잔뜩 필요해.
						<<case "ingredient">>
							"무언가를 섞어 만드는 데 쓸 기본 재료가 좀 필요해.
						<<case "produce">>
							"어... 그, 접착제로 쓸 농작물이 좀 필요한데... 뭐, 신경 쓰지 마."
						<<default>>
							"<<print ({ dish: "요리", flower: "꽃", fruit: "과일", ingredient: "재료", meat: "고기", mushroom: "버섯", produce: "농작물", seafood: "해산물", vegetable: "채소" }[$_types[0]] || $_types[0])>>【이가】 좀 필요해.
					<</switch>>
				<<elseif $_request.items.every(item => setup.foodstuff[item.name].shop.available_in?.includes("supermarket"))>>
					"여기 물건 살 목록이 조금 있어. 별로 흥미로운 일은 아니지만, 덕분에 수고를 덜 수 있겠지.
				<<else>>
					<<set $_typesPlural to []>>
					<<run $_types.forEach(type => {
						if (type === "flower") {
							$_typesPlural.pushUnique("꽃")
						} else if (type === "fruit") {
							$_typesPlural.pushUnique("과일")
						} else if (type === "ingredient") {
							$_typesPlural.pushUnique("재료")
						} else if (type === "produce") {
							$_typesPlural.pushUnique("농작물")
						} else if (type === "mushroom") {
							$_typesPlural.pushUnique("버섯")
						} else if (type === "meat") {
							$_typesPlural.pushUnique("고기")
						} else if (type === "seafood") {
							$_typesPlural.pushUnique("해산물")
						} else if (type === "vegetable") {
							$_typesPlural.pushUnique("채소")
						} else if (type === "dish") {
							$_typesPlural.pushUnique("요리")
						} else {
							$_typesPlural.pushUnique(type)
						}
					})>>
					<<set $_typesPlural.push("그런 것들")>>
					<<print either(`"재료가 좀 필요한데... 뭐, 그건 신경 쓰지 마.`, `"새로운 걸 시도해보려 해서 재료가 좀 필요해.`, `"뭔가 만들어보려 해서 재료가 좀 필요해.`)>>
					<<print formatList($_typesPlural, "", true)>> 말이야.
				<</if>>
				<<set $_names to []>>
            <<run $_request.items.forEach(item => {
				if (item.need > 1) {
					$_names.pushUnique(window.KR.getFoodstuffCountKr(item.name, item.need));
				} else {
					$_names.pushUnique(setup.foodstuff[item.name].name);
				}
			})>>
            <span class="gold"><<print formatList($_names, "그리고", true)>>【이가】 필요해.</span> 그걸 구해와 준다면, 정말 고마울 거야."
            <</if>>
			<br><br>

			<span class="gold">그윌란의 의뢰가 당신의 일지에 추가되었습니다.</span>

		<<case "sample">>
			<<if $gwylanSeen.includes("sample")>>
				<<if $gwylan.request.hold is "corruption">>
					"새 측정 부적을 만들려면 신선한 <span class="pink">체액 샘플</span>이 좀 필요해."
				<<elseif $gwylan.timer.sample gt Time.date.timeStamp>>
					"측정 부적이 타버리기 전에 새로 바꾸고 싶어. <span class="pink">체액 샘플</span>이 한 번 더 필요해."
				<<else>>
					"측정 부적을 교체해야 해. 이젠 어떻게 돌아가는지 알지. 신선한 <span class="pink">체액 샘플</span>이 필요해."
				<</if>>
			<<else>>
				<<if $gwylan.request.hold is "corruption">>
					"타락의 정도를 측정하려면, <span class="pink">체액 샘플</span>이 좀 필요해."
				<<else>>
					"세상에 퍼진 독을 측정해야 해. 얼마나 빨리 퍼지고 있는지, 얼마나 깊게 침투했는지. 그러기 위해선, 그... 샘플이 좀 필요해."
					<<He>>【은는】 헛기침을 한다. <span class="pink">"체액 샘플 말이야."</span>
				<</if>>
			<</if>>
			<br><br>

			<<He>>【은는】 어두운 방 안으로 사라진다. 무언가 덜그럭거리는 소리가 나더니, 이내 유리병 몇 개를 들고 돌아온다. "너한테서 뽑아내겠다는 건 아니야.<<if $gwylanSeen.includes("player_sample")>> 적어도 이번엔 말이지.<</if>>
			<<set $_sampleSpecies to []>><<set $_sampleLocations to []>>
			<<run $gwylan.request.items.forEach(item => {
				$_sampleSpecies.pushUnique(item.name);
				if (["human", "dog", "cat"].includes(item.name)) $_sampleLocations.pushUnique("마을");
				if (["wolf", "fox", "lizard", "boar", "bear", "plant"].includes(item.name)) $_sampleLocations.pushUnique("숲");
				if (["hawk", "fox", "cat"].includes(item.name)) $_sampleLocations.pushUnique("황야");
				if (["dolphin"].includes(item.name)) $_sampleLocations.pushUnique("바다");
			})>>
			<<if $_sampleSpecies.length is 1>>
				<<set $_thisSpecies to $gwylan.request.items[0]>>
				<<set $_thisColour to hasSexStat("deviancy", 3) ? "pink" : "red">>
				<<if $_thisSpecies.name is "wolf">>
					<<set $_thisColour to $syndromewolves gte 1 ? "green" : "red">>
				<</if>>
				<<switch $_thisSpecies.name>>
					<<case "human">><span class="purple">마을 사람들</span>에게서 다양한 샘플을 좀 구해줘.
					<<case "wolf">>근처 <span @class="$_thisColour">늑대 무리</span>의 흥분 상태를 파악해야 해. 그 녀석들의 샘플이 필요해.
					<<case "plant">><span class="forest-green">숲의 인간형 식물들</span>에게서 다량의 넥타르 샘플이 필요해. 그들이 타락하면 상황이 아주 암울해질 거야.
					<<case "fox">>우리 숲의 <span @class="$_thisColour">여우들</span>이 영악하긴 해도 독엔 면역이 없지. 숲에 있는 녀석들이나, 황야에 있는 녀석들의 샘플이 필요해.
					<<case "cat">>고양잇과 생물들에게서 흥미로운 반응이 나타나고 있어서, <span @class="$_thisColour">커다란 고양이들</span>의 샘플이 필요해. 마을이든 황야에 있는 녀석이든 상관없어.
					<<case "dolphin">>독이 바다로 흘러가기 시작한 건 아닌지 걱정돼. <span @class="$_thisColour">돌고래</span>처럼 거대한 해양 포유류의 샘플이 필요해.
					<<case "dog">><span @class="$_thisColour">개들</span>에게서 다양한 샘플이 필요해.
					<<case "lizard">><span @class="$_thisColour">도마뱀들</span>에게서 다양한 샘플이 필요해.
					<<case "boar">><span @class="$_thisColour">멧돼지들</span>에게서 다양한 샘플이 필요해.
					<<case "bear">><span @class="$_thisColour">곰들</span>에게서 다양한 샘플이 필요해.
					<<case "hawk">><span @class="$_thisColour">매들</span>에게서 다양한 샘플이 필요해.
					<<default>>
						<<print formatList($_sampleLocations, "그리고", true)>>에 있는 <span @class="$_thisColour"><<print $_thisSpecies.name + "들">></span>에게서 다양한 샘플이 필요해.
				<</switch>>
				<<pluralise $_thisSpecies.need "샘플" "샘플">> <span class="gold"><<Number $_thisSpecies.need>></span>개면 충분할 거야."
			<<else>>
				<<print formatList($_sampleLocations, "그리고", true)>>에 있는 녀석들의 샘플이 좀 필요해. 구체적으로 말하자면,
				<<for $_s to 0; $_s lt $_sampleSpecies.length; $_s++>>
					<<set $_thisSpecies to $gwylan.request.items.find(species => species.name === $_sampleSpecies[$_s])>>
					<<switch $_thisSpecies.name>>
						<<case "wolf">><<set $_thisSpeciesPlural to "늑대들">>
						<<case "fox">><<set $_thisSpeciesPlural to "여우들">>
						<<case "plant">><<set $_thisSpeciesPlural to "숲의 인간형 식물들">>
						<<case "human">><<set $_thisSpeciesPlural to "마을 사람들">>
						<<case "dog">><<set $_thisSpeciesPlural to "개들">>
						<<case "cat">><<set $_thisSpeciesPlural to "고양잇과 생물들">>
						<<case "lizard">><<set $_thisSpeciesPlural to "도마뱀들">>
						<<case "boar">><<set $_thisSpeciesPlural to "멧돼지들">>
						<<case "bear">><<set $_thisSpeciesPlural to "곰들">>
						<<case "dolphin">><<set $_thisSpeciesPlural to "돌고래들">>
						<<case "hawk">><<set $_thisSpeciesPlural to "매들">>
						<<default>><<set $_thisSpeciesPlural to $_thisSpecies.name + "들">>
					<</switch>>
					<<switch $_thisSpecies.name>>
						<<case "human">><<set $_thisSpeciesColour to "purple">>
						<<case "wolf">><<set $_thisSpeciesColour to $syndromewolves gte 1 ? "green" : hasSexStat("deviancy", 3) ? "pink" : "red">>
						<<case "plant">><<set $_thisSpeciesColour to "forest-green">>
						<<default>><<set $_thisSpeciesColour to hasSexStat("deviancy", 3) ? "pink" : "red">>
					<</switch>>
					<span @class="$_thisSpeciesColour"><<print $_thisSpeciesPlural>></span>의
					<<if $_thisSpecies.name is "plant">>
						넥타르
					<<else>>
						<<if maleChance() >= 100>>
							정액
						<<else>>
							체액
						<</if>>
					<</if>>
					샘플 <span class="gold"><<number $_thisSpecies.need>></span>개<<if $_s is $_sampleSpecies.length - 1>>야."<<elseif $_s is $_sampleSpecies.length - 2>>, 그리고<<else>>,<</if>>
				<</for>>
			<</if>>
			<br><br>

			<<He>>【은는】 필요한 것보다 더 많은 유리병을 건네준다. <<if $_sampleSpecies.length gt 1>>각 병에는 샘플의 출처 이름이 적힌 라벨이 붙어 있다.<</if>>
			<<if $gwylanSeen.includes("sample")>>
				"네가 이 일을 해낼 수 있다는 걸 알아. 넌 강하잖아.
				<<if $gwylanSeen.includes("romance") or _gwylanStatus.includes("dom")>>
					그래도 조심하고, 몸 성히 나에게 돌아와 줘."
				<<else>>
					"그래도, 조심해."
				<</if>>
			<<else>>
				"이런 위험한 부탁을 해서 미안해. 내가 이곳으로 유인하는 녀석들의 체액은 항상 너무 포화 상태라서 쓸 수가 없거든.
				수치가 정확하게 나오지 않을 거야. 중요한 일이 아니었다면 부탁하지도 않았을 거야." <<He>>【은는】 당신에게 용기를 주는 미소를 짓는다. "부디 몸조심해."
			<</if>>
			<br><br>

			<<if $gwylan.request.items.some(item => item.name === "plant")>>
				<<if $gwylanSeen.includes("plantperson_tip")>>
					<<He>>【은는】 재빨리 당신을 향해 다시 돌아선다. "아, 명심해. 인간형 식물의 <span class="green">덩굴</span>에서도 넥타르를 채취할 수 있어. 그쪽이 훨씬 많이 나올 거야."
				<<else>>
					<<set $gwylanSeen.pushUnique("plantperson_tip")>>
					<<He>>【은는】 재빨리 당신을 향해 다시 돌아선다. "아, 한 가지 더. 인간형 식물의 <span class="green">덩굴</span>에서도 넥타르를 채취할 수 있어. 그쪽이 훨씬 많이 나올 거야."
				<</if>>
				<br><br>
			<</if>>

			<span class="gold">그윌란의 의뢰가 당신의 일지에 추가되었습니다.</span>

		<<case "samplePlayer">>
			/* ToDo: Gwylan */

		<<case "preen">>
			<<if $harpy gte 6>>
				"네 날개를 좀 다듬어 주고 싶어.
				<<if !$gwylanSeen.includes("preen")>>
					<<set $gwylanSeen.pushUnique("preen")>>
					정말 예뻐서, 그 깃털을 좀 썼으면 하거든."
				<<else>>
					"깃털 재고를 다시 채워야 하거든."
				<</if>>
			<<else>>
				<<set $_featherCount to $gwylan.request.items.find(feather => feather.name === "feathers").need>>
				"매의 깃털이 좀 필요해. 아주 귀중한 재료거든. <span class="gold"><<Number $_featherCount>></span>개면 충분할 거야."
				<br><br>

				<span class="gold">그윌란의 의뢰가 당신의 일지에 추가되었습니다.</span>
			<</if>>

		<<case "cream">>
			"최근에 나한테 큰 도움을 줬지. 상을 받을 자격이 있어.
			<<if $gwylanSeen.includes("cream_lick")>>
				<<if $cat gte 6>>
					<span class="lewd">그 거친 혀를 움직이는 걸 다시 보고 싶네, 고양이 <<girl>>,</span>" <<he>>【이가】 얼굴을 붉힌 채 미소를 지으며 말한다. "저번에는 정말 재밌었잖아! 나한테 쓸 크림도 더 생겼고 말이지."
				<<else>>
					<span class="lewd">그 혀를 움직이는 걸 다시 보고 싶네,</span>" <<he>>【이가】 얼굴을 붉힌 채 미소를 지으며 말한다. "저번에는 정말 재밌었잖아! 나한테 쓸 크림도 더 생겼고 말이지."
				<</if>>
			<<elseif $gwylanSeen.includes("nectar_lick")>>
				<<if $cat gte 6>>
					<span class="lewd">그 거친 혀를 움직이는 걸 다시 보고 싶네, 고양이 <<girl>>,</span>" <<he>>【이가】 얼굴을 붉힌 채 미소를 지으며 말한다. "저번에는 정말 재밌었잖아! 이번엔 내어줄 넥타르가 없지만, 대신 크림을 가져왔지."
				<<else>>
					<span class="lewd">그 혀를 움직이는 걸 다시 보고 싶네,</span>" <<he>>【이가】 얼굴을 붉힌 채 미소를 지으며 말한다. "저번에는 정말 재밌었잖아! 이번엔 내어줄 넥타르가 없지만, 대신 크림을 가져왔지."
				<</if>>
			<<else>>
				<<if $cat gte 6>>
					난... <span class="lewd">네 고양이 혀로 뭘 할 수 있는지 보고 싶네</span>," <<he>>【이가】 얼굴을 붉힌 채 미소를 지으며 말한다. "널 위한 크림도 가져왔어."
				<<else>>
					재미있는 생각이 났어," <<he>>【이가】 얼굴을 붉힌 채 미소를 지으며 말한다. "카페에서 크림을 좀 챙겨왔는데, 그리고... 아니, 이건 비밀로 해둘게."
				<</if>>
			<</if>>
			<br><br>

			<<His>> 시선은 당신에게 고정되어 있다. "준비가 되면 말해. 이건 좀... 질척거릴 수도 있으니까."

		<<case "robin">>
			/* ToDo: Gwylan */

		<<default>>
			그윌란이 무언가 말하려 입을 연다. <<He>>【은는】 입을 연 채로 멈칫한다. 그러곤 <<He>>【은는】 재채기를 한다.
			<br><br>

			"미안, 우리 무슨 얘기 하고 있었지?"
			<br><br>

			<span class="red">버그입니다. 제보해 주세요.</span>
	<</switch>>
<</widget>>

<<widget "gwylanRequestEnd">>
	<<set $_skip to _args[0] is "skip" ? true : false>>
	<<set $_silent to _args[0] is "silent" ? true : false>>
	<<if !$_skip and $gwylan.request.event>>
		<<set $gwylan.requestDone to true>>
		<<set $gwylan.requestCount++>>
		<<set $daily.gwylan.request to true>>
		<<if !$_silent>>
			<<if !$gwylanSeen.includes("request_intro")>>
				<<set $_requestBr to true>>
				<<set $gwylanSeen.pushUnique("request_intro")>>
				<<He>>【은는】 당신을 위아래로 훑어보며 생각에 잠긴 채 턱 밑에 <<his>> 손을 괸다.
				<<if $gwylan.request.hold>>
					"네가 이미 도와달라고 하려던 일이 있는 건 알아. 하지만 내가 해줄 수 있는 일이 더 있어.
				<<else>>
					"내가 널 위해 특별히 해줄 수 있는 일이 있어.
				<</if>>
				<span class="blue">잠을 자는 데 문제가 있다면, 내가 도와줄 수 있는 기술을 알아.</span> 그나저나,
				<span class="blue">만약 다른 사람의 말에 홀려버렸다면, 나한테 와서 얘기해.</span> 그런 최면적인 충동을 <span class="pink">덮어쓰고 지우는</span> 방법을 알고 있거든."
			<<elseif $gwylan.request.hold>>
				<<set $_requestBr to true>>
				<<He>>【은는】 카운터에 팔꿈치를 올린다.
				<<switch $gwylan.request.hold>>
					<<case "peace">>"네 내면에 평화를 가져다주는 방법에 대해 물어봤었지."
					<<case "silence">>"이제 네 귀에 있는 그 성가신 놈을 조용히 시킬 수 있어."
					<<case "slumber">>"잠을 자는 데 문제가 있다고 했지."
					<<case "insight">>"뭔가 헛것이 보인다고 했나?"
					<<case "chastity">>"구속구를 푸는 걸 도와달라고 했지?"
					<<case "familiar">>
						<<if $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1>>
							"네 목걸이를 풀어달라고 했었지?"
						<<else>>
							"네 목걸이를 풀어달라고 했었지? 이젠 그 일로 내 도움이 필요 없는 것 같네."
						<</if>>
					<<case "petBed">>"네가 원한다면 당장 네 침대를 다시 밖으로 끌어내 줄게."
					<<default>>"이미 생각해둔 게 있었지?"
				<</switch>>
			<</if>>
		<</if>>
		<<if $hypnosis_traits.devotion>>
			<<if $_requestBr>>
				<br><br>
			<</if>>
			<<switch $hypnosis_traits.devotion>>
				<<case 1>>
					<<hypnosisText "<span class='lblue'>그윌란의 의뢰를 완료하자 기묘한 만족감이 당신을 채운다.</span><<stress -3>><<trauma -3>><<lstress>><<ltrauma>>">>
				<<case 2>>
					<<hypnosisText "<span class='teal'>그윌란의 의뢰를 완료하자 만족감이 당신을 채운다.</span><<stress -6>><<trauma -6>><<lstress>><<ltrauma>>">>
				<<case 3>>
					<<hypnosisText "<span class='green'>그윌란이 자랑스럽다는 듯 당신을 향해 미소 짓는다. 당신은 따뜻함과 성취감을 느낀다.</span><<stress -6>><<trauma -10>><<hallucinogen 50>><<lstress>><<lltrauma>><<ghallucinogens>>">>
				<<case 4>>
					<<hypnosisText "<span class='purple'>그윌란의 따뜻한 미소에 심장이 철렁 내려앉는다. 당신은 <<him>>【을를】 행복하게 만들었고, 그로 인해 당신도 행복해진다.</span><<trauma -12>><<arousal 1000>><<hallucinogen 80>><<lltrauma>><<garousal>><<ghallucinogens>>">>
				<<default>>
					<<hypnosisText "<span class='pink'>그윌란의 자랑스러운 미소에 하마터면 무릎이 꺾일 뻔한다. 원초적인 성취감이 당신을 휩쓴다.</span><<trauma -16>><<arousal 3000>><<drugs 80>><<lltrauma>><<gggarousal>><<gdrugged>>">>
			<</switch>>
		<</if>>
		/* Save as recently completed task for use later */
		<<set $gwylan.timer[$gwylan.request.event] to new DateTime(Time.date).addDays(14).timeStamp>>
		<<set $gwylan.timer.requestLast to Time.date.timeStamp>>
	<</if>>
	<<set $gwylan.requestLast to $gwylan.request>>
	<<set $gwylan.request to {}>>
	<<if $gwylan.requestSeed isnot undefined>>
		<<set $_seedIncrement to 0.001>>
		<<set $gwylan.requestSeed to (($gwylan.requestSeed - 0.25 + $_seedIncrement) % (0.99 - 0.25)) + 0.25>>
	<</if>>
<</widget>>

<<widget "gwylanChastityRequest">>
	<<set $_consensual to _args[0] or 0>>
	<<if $_consensual is 0 or _gwylanStatus.includes("lust")>>
		<<if !$gwylan.request.event>>
			<<He>>【은는】 잠시 생각하더니, 미소를 짓는다.
			<br><br>

			"<<pcPetname "Gwylan">>, 그 정조대를 제거하거나 나중에 나를 찾아와. 내가 부숴서 벗겨줄게."
			<<run gwylanRequest("chastity")>>
			<<set V.gwylan.request.command to true>>
			<<set V.gwylan.request.timer = new DateTime(Time.date).addDays(1).timeStamp>>
			<<if $combat is 1>><<npcincr Gwylan lust 10>><</if>> /* Partially negates lust loss from ejaculation */
			<br><br>

			<span class="gold">그윌란의 요청이 당신의 일지에 추가되었습니다.</span>
		<<elseif $gwylan.request.event is "chastity" and $gwylan.request.command>>
			<<He>>【은는】 약간 짜증난 기색으로 당신을 내려다본다. "그거 벗으라고 말했잖아."
		<<else>>
			<<He>>【은는】 짜증난 표정으로 내려다본다.
		<</if>>
	<</if>>
<</widget>>

<<widget "gwylanJournalItems">>
	<<set $_itemsToList to $gwylan.request.items?.filter(item => !item.skip && !item.alt)>>
	<<if $_itemsToList?.length>>
		<<for $_requestIndex to 0; $_requestIndex lt $_itemsToList.length; $_requestIndex++>>
			<<set $_thisItem to $_itemsToList[$_requestIndex]>>
			<<switch $_thisItem.category>>
				<<case "clothing">>
					<<set $_thisItemSetup to clone(setup.clothes[$_thisItem.slot].find(it => it.name === $_thisItem.name))>>
					<<set $_thisItemSetup.colour to $_thisItem.colour_requirement isnot "any" ? $_thisItem.colour_requirement : $_thisItemSetup.colour_options.random()>>
					<<set $_thisItemSetup.accessory_colour to $_thisItem.acc_colour_requirement isnot "any" ? $_thisItem.acc_colour_requirement : $_thisItemSetup.accessory_colour_options.random()>>
					<<if gwylanRequestClothingSlotCheck($_thisItem.slot)>>
						<span class='fa-icon fa-selected'></span>
					<<else>>
						<span class='fa-icon fa-unselected'></span>
					<</if>>
					<<clothingicon $_thisItemSetup $_thisItem.slot>>
					<<print $_thisItemSetup.name_cap>>
					<<if $_thisItem.slot is "neck" and $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1>>
						<span class="forest-green">또는 당신의 낯익은 목걸이</span>
					<<elseif $_thisItemSetup.shopGroup and $gwylan.request.details?.replacements is "allowed">>
						<span class="green">또는 변형 제품</span>
					<<elseif $_thisItemSetup.shopGroup and $gwylan.request.details?.replacements is "blocked">>
						<span class="red">(특정 변형)</span>
					<</if>>
					<<if $_thisItem.colour_requirement is "any" and $_thisItem.acc_colour_requirement is "any" and ($_thisItemSetup.colour_options.length or $_thisItemSetup.accessory_colour_options.length)>>
						(모든 색상)
					<<elseif $_thisItemSetup.colour_options.length or $_thisItemSetup.accessory_colour_options.length>>
						(<<if $_thisItemSetup.colour_options.length>><span @class='$_thisItem.colour_requirement'>기본 <<print setup.colourName($_thisItem.colour_requirement)>></span><</if>><<if $_thisItemSetup.colour_options.length and $_thisItemSetup.accessory_colour_options.length>> 그리고 <</if>><<if $_thisItemSetup.accessory_colour_options.length>><span @class='$_thisItem.acc_colour_requirement'>보조 <<print setup.colourName($_thisItem.acc_colour_requirement)>></span><</if>>)
					<</if>>
					<<if ["upper", "lower", "under_upper", "under_lower"].includes($_thisItem.slot)>>
						<<switch $_thisItem.integrity_word>>
							<<case "any">>(모든 상태)
							<<case "full">><span class="green">(온전함)</span>
							<<case "frayed">><span class="teal">(해짐)</span>
							<<case "torn">><span class="purple">(찢어짐)</span>
							<<case "tattered">><span class="red">(너덜너덜함)</span>
						<</switch>>
					<</if>>
				<<case "tending">>
					<<set $_itemAmount to $foodstuff[$_thisItem.name].amount>>
					<<if $gwylan.request.special is "tutorial">>
						<<set $_itemAmount += $gwylanTutorialShrooms>>
					<</if>>
					<<if $_itemAmount gte $_thisItem.need>>
						<span class='fa-icon fa-selected'></span>
					<<else>>
						<span class='fa-icon fa-unselected'></span>
					<</if>>
					<<foodstufficon $_thisItem.name>>
					<<print window.KR.getFoodstuffCountKr($_thisItem.name, $_thisItem.need)>>					
					<<if $_itemAmount gte $_thisItem.need>>
						<span class='green'>(<<print $_itemAmount>> / <<print $_thisItem.need>>)</span>
					<<elseif $_itemAmount is 0>>
						<span class='red'>(<<print $_itemAmount>> / <<print $_thisItem.need>>)</span>
					<<else>>
						<span class='blue'>(<<print $_itemAmount>> / <<print $_thisItem.need>>)</span>
					<</if>>
				<<case "sample">>
					<<if $_thisItem.have gte $_thisItem.need>>
						<span class='fa-icon fa-selected'></span>
					<<else>>
						<span class='fa-icon fa-unselected'></span>
					<</if>>
					<<if $_thisItem.name is "plant">>
						넥타르
					<<elseif maleChance() gte 100>>
						정액
					<<else>>
						음란한 액체
					<</if>>
					샘플 <<print $_thisItem.need>>개 
					<<if $_thisItem.have lt $_thisItem.need>>
						(<span class="blue"><<print $_thisItem.have>>/<<print $_thisItem.need>></span>)
					<</if>>
					 | 채취 대상: 
					<<set $_sampleColour to $_thisItem.name is "wolf" and $syndromewolves gte 1 ? "green" : hasSexStat("deviancy", 3) ? "pink" : "red">>
					<<switch $_thisItem.name>>
						<<case "human">><span class="purple">인간.</span>
						<<case "plant">><span class="forest-green">인간형 식물,</span> 또는 <span class="forest-green">촉수.</span>
						<<case "wolf">><span @class="$_sampleColour">늑대.</span>
						<<case "fox">><span @class="$_sampleColour">여우.</span>
						<<default>><span @class="$_sampleColour"><<= window.KR.getCreatureTypeKr($_thisItem.name)>>.</span>
					<</switch>>
				<<default>>
			<</switch>>
			<br>
		<</for>>
	<</if>>
<</widget>>
