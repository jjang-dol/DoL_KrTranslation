<!-- 'level 2' ritual to purge world corruption -->
:: Gwylan Ritual Select
<<set $outside to 0>><<set $location to "forest_shop">><<effects>><<run statusCheck("Gwylan")>>
<<set _hideRitualOptions to true>>

<<if $phase isnot "no">>
	그윌란에게 의식을 돕겠다고, 준비됐다고 말한다.
<<else>>
	숲의 생물을 유인해서 대신 정화 의식에 쓸 수 있을지 그윌란에게 물어본다.
<</if>>
<br><br>

<<if Time.isBloodMoon() or Time.monthDay is Time.lastDayOfMonth and Time.hour gte 16>>
	<<set _ritualFailSafe to true>><<unset $ritualForced>>
	<<He>>【은는】 <<his>> 고개를 젓는다. "지금은 안 돼. 오늘 같은 밤에는 안 돼. 너무 위험해."
	<br><br>

	<<gwylanOptions>>
<<elseif Time.hour lte 8>>
	<<set _ritualFailSafe to true>><<unset $ritualForced>>
	<<set $daily.gwylan.ritualRequestBlocked to true>>
	<<He>>【은는】 하품한다. "너무 일러. 아침부터 먹고.<<if $gwylan_cafe_intro>> 나중에 카페에서 볼까?<</if>>"
	<br><br>

	<<gwylanOptions>>
<<else>>

	<<if _gwylanStatus.includes("cautious")>>
		<<if $auriga_scar or $brownFoxRevealed>>
			<<He>>【은는】 미소 짓는다. "더 격렬한 의식을 망설이더라도 이해해 줘. 신경 쓸 게 많아서." <<He>>【은는】 당신을 위아래로 훑어본다. "미안하지만, 지금 너 때문에 집중이 안 돼."
		<<else>>
			<<He>>【은는】 눈을 깜빡인다. "그래, 물론이지. <span class="purple">지금은 덜 격렬한 의식만 할 거야.</span> 내가 좀..." <<he>>【은는】 말을 멈추고, 오른쪽으로 살짝 몸을 틀며 얼굴을 찡그린다. "무리했거든."
		<</if>>
		<br><br>

		<<ind>><<link [[정화를 위해 숲의 주민을 유인한다|Gwylan Forest Journey Prep]]>><<endevent>><</link>>
		<br>
	<<elseif $phase is "no">>
		<<He>>【은는】 고개를 젓는다. "요즘 날 소홀히 했잖아, 자기야." <<He>>【은는】 미소 짓는다. 눈은 웃고 있지 않다. "이 정도는 해줘야지."
		<br><br>

		<<ind>><<link [[숲의 그릇이 되어준다|Gwylan Ritual Start]]>><</link>><<if $gwylanSeen.includes("ritual_sex")>><<gwylanHypnoNote>><</if>>
		<br>
	<<elseif $gwylan.hunting is 3>>
		<<He>>【은는】 미소 짓는다. "드디어. 더 상급 의식을 할 거야. 네 손길이 그리웠어." <<He>>【은는】 얼굴을 붉히며 시선을 피한다. "내 말은, 그게 더 효과적이고, 그리고—" <<he>>【은는】 말을 멈추고 심호흡을 한다. "<span class="lewd">널 갈망했어, <<pcpetname "Gwylan">>.</span> 너무 오래 걸렸어."
		<br><br>

		<<ind>><<link [[숲의 생물을 유인해서 정화 의식에 쓰게 해달라고 부탁한다|Gwylan Ritual Select]]>><<set $phase to "no">><</link>>
		<br>
		<<ind>><<link [[숲의 그릇이 되어준다|Gwylan Ritual Start]]>><</link>><<if $gwylanSeen.includes("ritual_sex")>><<gwylanHypnoNote>><</if>>
		<br>
	<<elseif $gwylan.ritualNext is "sex" or $gwylan.hunting gte 2>>
		<<if _gwylanStatus.includes("heat")>>
			<<He>>【은는】 카운터를 뛰어넘을 것처럼 움직이다가 중간에 멈춘다. "미안! 미안. 그냥 신나서. 이번엔 우리 둘만 있었으면 좋겠어." <<He>>【은는】 얼굴을 붉히며 시선을 피한다.
		<<else>>
			<<He>>【은는】 미소 짓는다. "좋아, 기다리고 있었어. 이번엔 너랑 나, 둘뿐일 거야." <<He>>【은는】 당신에게 윙크한다.
		<</if>>
		<br><br>

		<<ind>><<link [[정화를 위해 숲의 주민을 유인한다|Gwylan Ritual Select]]>><<set $phase to "no">><</link>>
		<br>
		<<ind>><<link [[숲의 그릇이 되어준다|Gwylan Ritual Start]]>><</link>><<if $gwylanSeen.includes("ritual_sex")>><<gwylanHypnoNote>><</if>>
		<br>
	<<else>>
		<<He>>【은는】 고개를 끄덕인다. "밖에 나가서 숲의 주민 중 하나를 유인하거나, 네가 직접 숲의 그릇이 되어줄 수도 있어. 후자의 경우, <span class="lewd">체액 교환은 필수고, 어떤 방해물도 없어야 해</span>."
		<br><br>

		<<ind>><<link [[정화를 위해 숲의 주민을 유인한다|Gwylan Forest Journey Prep]]>><<endevent>><</link>>
		<br>
		<<ind>><<link [[숲의 그릇이 되어준다|Gwylan Ritual Start]]>><</link>><<if $gwylanSeen.includes("ritual_sex")>><<gwylanHypnoNote>><</if>>
		<br>
	<</if>>
	<br>

	<<gwylanOptions>>
<</if>>

:: Gwylan Ritual Start
<<effects>><<run statusCheck("Gwylan")>>
<<set _hideRitualOptions to true>>
당신은 그윌란에게 숲의 그릇이 되고 싶다고 말한다.
<br><br>

<<if !$settings.tentaclesEnabled or !$settings.hypnosisEnabled>>
	<<set _ritualFailSafe to true>><<unset $ritualForced>>
	<<He>>【이가】 당신을 보며 고개를 갸웃거린다. "이런 걸 감당할 수 있겠어?" <<He>>【이가】 당신의 머리를 헝클어뜨린다.
	"다른 의식보다 훨씬 격렬한 과정이 될 수 있어. 준비되지 않은 것들을 보게 될지도 몰라. 다른 쪽 구멍에서 <span class="lewd">꿈틀거리며</span> 모습을 드러내는 것들 말이야.
	<span class="lewd">최면의 영향</span>에도 대비해야 할 거야. <span class="blue">널 위해서라도, 먼저 마음을 조금 열어두는 게 좋을 거야.</span>"
	<br><br>

	<i><span class="blue">계속하려면 촉수와 최면 설정을 활성화해야 합니다.</span></i>
	<br><br>

	<<gwylanOptions>>
<<elseif playerChastity()>>
	<<set $phase to "ritual">>
	<<include "Gwylan Chastity Removal">>
<<else>>
	<<gwylanRitualStart>>
	<<if !$gwylanSeen.includes("ritual_sex")>>
		<<He>>【이가】 얼굴을 붉힌다. "좋아, 준비가 됐다면.
		<<if $wolfpackleader gte 1 or $wolfgirl gte 6 or $fox gte 6 or $dryad gte 6>>
			<span class="green">넌 이미 숲에 익숙하군.</span>"
			<<if $wolfgirl gte 6>>
				<<if $transformationParts.wolf.ears isnot "hidden">>
					<<He>>【은는】 당신의 늑대 귀를 문지른다.
				<<else>>
					<<He>>【은는】 당신의 머리를 쓰다듬는다, 늑대 귀가 있어야 할 바로 그 자리를.
				<</if>>
			<<elseif $fox gte 6>>
				<<if $transformationParts.fox.ears isnot "hidden">>
					<<He>>【은는】 당신의 여우 귀를 문지른다.
				<<else>>
					<<He>>【은는】 당신의 머리를 쓰다듬는다, 여우 귀가 있어야 할 바로 그 자리를.
				<</if>>
			<<elseif $dryad gte 6>>
				<<He>>【은는】 당신의 나뭇잎 몇 개를 쓸어내린다.
			<<else>>
				<<He>>【은는】 당신의 머리를 쓰다듬는다. "이 근방 늑대 무리의 우두머리지, 안 그래?" 당신은 <<he>>【이가】 어떻게 그걸 아는지 궁금해진다.
			<</if>>
			"그렇다 해도, 처음에는 몇 가지 준비를 해야 해.
		<<else>>
			<span class="blue">넌 숲의 타고난 주민이 아니니,</span> 처음에는 몇 가지 준비를 해야 해.
		<</if>>
		서로 유대를 맺어야 하거든."
		<br><br>

		<<He>>【이가】 미소 짓는다. "<span class="lewd">짝짓기 의식</span>이야. 숲속에서 너와 내가 쫓고 쫓기는 거지. 잠시만 기다려."
		<<He>>【은는】 어두운 문으로 사라진다. 식기들이 달그락거리는 소리가 들리고, 몇 분 후 <<he>>【이가】 핏빛 액체가 가득 담긴 잔을 들고 돌아온다.
		<br><br>

		/* ToDo: Gwylan - unlock ability to learn wolfbrew (and ghostbrew?) recipe later after this event */
		<<if $wolfpackleader gte 1 or $wolfgirl gte 6 or $fox gte 6 or $dryad gte 6>>
			"이건 <span class="purple">늑대술</span>이야. 보통은 이걸 마시게 해야 하지만, 말했듯이 숲은 이미 네 안에 있어. 바로 시작할 수 있지.
			<<if $fox gte 6>>
				원한다면 마셔도 되지만, 추천하진 않아. 너의 여우 같은 면이 무뎌질 수도 있거든."
			<<elseif $cow gte 6 or $cat gte 6 or $harpy gte 6>>
				원한다면 마셔도 되지만, 너의 동물적인 성향이 좀 더... <span class="black">늑대처럼</span> 변하게 될지도 몰라."
			<<elseif $wolfgirl gte 6>>
				원한다면 마셔도 돼. 내면의 늑대와 더 가까워지게 해줄 거야.
			<<else>>
				원한다면 마셔도 돼."
			<</if>>
			<<if playerBellyVisible()>>
				<<He>>【은는】 잠시 말을 멈추고는, 당신의 <<bellyDescription>>【을를】 내려다본다. "아이에게는 안전하니, 걱정 마."
			<</if>>
			<br><br>

			냄새를 맡아보니 와인 향이 난다.
			<br><br>

			<<link [[마신다|Gwylan Ritual Start Wolfbrew]]>><<tiredness -3>><<drugs 120>><</link>><<ggdrugged>>
			<br>
			<<link [[마시지 않는다|Gwylan Ritual Start Hunt]]>><</link>>
			<br>
		<<else>>
			"이건 <span class="purple">늑대술</span>이야. 한동안 숲과 더 가까워지게 해줄 거야. 이걸 마셔야 해. 꽤 독하니, 조심해."
			<<if playerBellyVisible()>>
				<<He>>【은는】 잠시 말을 멈추고는, 당신의 <<bellyDescription>>【을를】 내려다본다. "아이에게는 안전하니, 걱정 마."
			<</if>>
			<br><br>

			냄새를 맡아보니 와인 향이 난다.
			<br><br>

			<<link [[마신다|Gwylan Ritual Start Wolfbrew]]>><<tiredness -3>><<drugs 120>><</link>><<ggdrugged>>
			<br>
		<</if>>
	<<else>>
		<<He>>【은는】 미소 짓는다. "좋아.
		<<if $wolfpackleader gte 1 or $wolfgirl gte 6 or $fox gte 6 or $dryad gte 6>>
			넌 이미 숲의 일부이니, 바로 검사로 넘어가도 되겠어." <<He>>【이가】 잠시 말을 멈춘다. "그래도 원한다면 짝짓기 의식을 다시 할 수도 있고."
		<<else>>
			"우린 이미 체액으로 맺어졌으니, 짝짓기 의식을 반복할 필요는 없어. 그래도 다시 해서 네가 추격전에서 이기면 의식의 효과가 더 강해지긴 할 거야."
		<</if>>
		<br><br>

		<<link [[의식을 전부 진행한다|Gwylan Ritual Start Hunt]]>><<tiredness 2>><</link>><<ggtiredness>><<glust>><<gwylanPurgeEffect>>
		<br>
		<<link [[짝짓기 의식을 건너뛴다|Gwylan Ritual Start Garden]]>><<endevent>><<set $phase to "skip">><</link>>
		<br>
	<</if>>
<</if>>

:: Gwylan Ritual Start Wolfbrew
<<effects>>
<<set $sexRitual.wolfbrew to true>>
당신은 성배를 입술에 가져가 마신다.
<br><br>

역할 정도로 달콤한 맛이 나고, 목구멍을 태우며 넘어간다. 강렬한 활력이 솟는다. <span class="pink">몸 안에 열기가 피어오른다.</span> "몸에 털이 좀 더 자랄지도 몰라." 그윌란이 말한다. "미리 말했어야 했는데."
<br><br>

<<transform wolf 12>>

<<link [[다음|Gwylan Ritual Start Hunt]]>><</link>>
<br>

:: Gwylan Ritual Start Hunt
<<set $outside to 1>><<set $location to "forest">><<effects>><<run statusCheck("Gwylan")>>
<<gwylanHuntStart>><<set $huntGame.hunterKnown to true>><<set $sexRitual.chase to true>>
<<set $huntGame.event to "Gwylan Ritual Hunt">>
당신은 숲속 상점 앞으로 이끌려 나간다.
<br><br>

그윌란이 스트레칭을 시작한다. "규칙은 간단해. 내가 널 잡으면 내가 이기고, 네가 날 잡으면 네가 이기는 거야. 네가 이기면 숲이 널 자기들 중 하나로 받아들여서 의식의 효력이 더 강해질 거야. 그렇다고 그냥 져줄 수는 없어. 진짜 사냥이어야 하니까."
<br><br>

<<if $worn.feet.type.includes("heels")>>
	<<set _linebreak to true>>
	<<He>>【은는】 당신의 $worn.feet.name【을를】 힐끗 본다. "그거 벗어. 그런 거 신고 숲을 돌아다니다간 발목 부러져." <<he>>【이가】 꾸짖는다. <<He>>【은는】 아마 맞는 것 같다. 당신은 $worn.feet.name【을를】 챙겨 넣고 맨발로 다니기로 한다.
	<<feetundress "gwylanRitual">>
<</if>>

<<if !_gwylanStatus.includes("wounded") and $brownFoxWoundedTimer>>
	<<unset $brownFoxWoundedTimer>>
	<<He>>【은는】 조심스럽게 <<his>> 오른쪽 다리를 뻗는다. 다리가 완전히 펴지자, <<he>>【은는】 미소 짓는다. "달리는 거 오랜만이네."
	<<if !$brownFoxRevealed>>
		<<He>>【은는】 잠시 말을 멈춘다. "파트너랑 같이 말이야."
	<</if>>
<<elseif _gwylanStatus.includes("wounded")>>
	<<He>>【은는】 시험하듯 <<his>> 오른쪽 다리를 뻗는다. <<He>>【은는】 잠시 얼굴을 찡그린다.
	<<if $brownFoxRevealed>>
		"아쉽게도, 아직 다리가 낫지 않았어. 무리하겠지만, 평소보다 느릴 거야."
	<<else>>
		"지금 다리를 삐어서, 느릴 거야."
	<</if>>
<</if>>

<<if _gwylanStatus.includesAny("aroused", "lust") and random(0, 2)>>
	<<He>>【은는】 잠시 생각하더니, 씨익 웃는다. "내가 먼저 사냥할게. 20초 주지. 어서 뛰는 게 좋을 거야, <<pcpetname "Gwylan" "name">>."
	<br><br>

	당신은 숲으로 달아난다. 몇 분 후, 당신은 상황을 파악하기 위해 멈춰 선다.
<<else>>
	<<set $huntGame.hunter to "player">>
	<<He>>【은는】 잠시 생각한다. "네가 먼저 사냥해. 20초 기다렸다가, 날 잡으러 와!" <<He>>【은는】 당신의 대답을 기다리지 않고 달리기 시작한다.
	<br><br>

	당신은 요청대로 20초를 기다린 뒤, <<him>>【을를】 따라 숲으로 달려간다. 몇 분 후, 당신은 상황을 파악하기 위해 멈춰 선다.
<</if>>
<br><br>

어떻게 하시겠습니까?
<br>
<<gwylanHuntOptions>>

:: Gwylan Ritual Hunt
<<effects>><<run statusCheck("Gwylan")>>
<<if ($drugged gte 1 or $fox gte 4 or $cat gte 4 or $wolfgirl gte 4) and !random(0, 10) and $huntGame.turn gte 1>>
	숲이 당신 안에 있다.
<<else>>
	당신은 숲 안에 있다.
<</if>>
<<gwylanHuntEffects>>

<<if $huntGame.end>>
	<<tiredness 1>>
	<br><br>
	<<if $huntGame.end is "ambushSuccess">>
		<<if $huntGame.otherHealth lte 1>>
			마지막으로, 결연한 자세로 덮쳐서 <span class="green"><<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【을를】 붙잡는다</span>. <<He>>【은는】 당신 밑에서 몸부림치지만, 당신은 <<his>> 손목을 땅에 단단히 붙잡아 누른다. <<He>>【은는】 굴복한다. <<npcincr Gwylan lust 3>><<gglust>>
		<<elseif $huntGame.otherHealth is 2>>
			포식자처럼 덮쳐서 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【을를】 덮친다. 잠시 <<him>>【와과】 함께 뒹굴지만, <<he>>【은는】 간신히 빠져나간다. <span class="teal">당신은 <<he>>【이가】 다시는 도망칠 수 없으리란 걸 안다.</span>

			<<if !$huntGame.brownFox and $awarelevel gte 4 and _gwylanTF.known and $huntGame.otherHealth lte 2 and $hypnosis_traits.devotion gte 4 and !_gwylanStatus.includes("wounded")>>
				<<set $huntGame.brownFox to true>><<set $huntGame.adversaryText to "the brown fox">>
				<<set $huntGame.skills.athleticsMax += 75>><<set $huntGame.skills.skulduggeryMax += 75>><<set $huntGame.skills.danceMax += 75>>
				<br><br>

				당신은 일어선다. 당신에게서 도망치는 그윌란은 보이지 않는다. 다른 것이 보인다.
				<br><br>

				<span class="red">거대한 갈색 여우다. 네 발로 당신에게서 도망치자 주변 공기가 흐릿해진다.</span>
			<</if>>
		<<else>>
			잘 훈련된 포식자처럼 덮쳐 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【을를】 붙잡는다. 하지만 <<He>>【은는】 빠르다. 잠깐의 몸싸움 끝에, <<he>>【은는】 당신에게서 빠져나가는 데 성공한다.
		<</if>>
		<br><br>

		<<if $huntGame.otherHealth lte 1>>
			<<set $sexRitual.chaseWon to true>><<set $sexRitual.purge++>>
			<span class="gold">사냥에서 이겼다!</span> <<gwylanPurgeEffect>>
			<br><br>

			<<if $huntGame.brownFox>>
				갑자기 머리가 맑아지는 느낌이다. 아래를 내려다보니 여우가 아니라 당신 밑에 깔린 그윌란이 보인다. <<His>> 얼굴이 새빨갛다.
			<<else>>
				그윌란이 당신을 올려다본다. <<his>> 얼굴이 새빨갛다.
			<</if>>
			/* ToDo: Gwylan - variation for when Gwylan is in heat and gets caught or catches the player */
			"알았어, 이제 나한테서 내려와도 돼. 네가 이겼어." <<He>>【이가】 미소 짓는다.
			<<if _gwylanStatus.includes("wounded")>>
				"내가 다리를 절어서 운이 좋은 줄 알아. 안 그랬으면 이렇게 쉽진 않았을걸." <<npcincr Gwylan dom 1>><<gyearning>>
			<<else>>
				"대단했어! 정말 빠르게 움직이더군." <<npcincr Gwylan dom 3>><<ggyearning>>
			<</if>>
			<br><br>

			당신은 그윌란이 일어서는 것을 돕는다. 둘은 함께 상점으로 돌아간다. <<tiredness 6>><<ggtiredness>>
			<br><br>

			<<link [[다음|Gwylan Ritual Start Garden]]>><<endevent>><<unset $huntGame>><<pass 10>><</link>>
			<br>
		<<else>>
			<<set $huntGame.otherHealth-->>
			<<gwylanHuntOptions>>
		<</if>>
	<<elseif $huntGame.end is "ambushFailed">>
		<<if $huntGame.hunter is "player">>
			덮치려 했지만 빗나갔고, <<he>>【은는】 달아나기 시작한다!
			<br><br>

			<<if $huntGame.otherHealth lte 1>>
				이제 마지막 구간이다. <span class="green">지금 <<him>>【을를】 잡으면 끝이다.</span>
				<br><br>
			<</if>>

			<<link [[추격!|Gwylan Ritual Chase]]>><<set $chasestart to 1>><</link>>
			<br>
		<<else>>
			덮치려 했지만 빗나갔고, <<he>>【이가】 당신을 붙잡으려 한다!
			<br><br>

			<<link [[도망쳐!|Gwylan Ritual Chase]]>><<set $runstart to 1>><</link>>
			<br>
		<</if>>
	<<elseif $huntGame.end is "chase">>
		<<if $huntGame.otherHealth lte 1>>
			이제 마지막 구간이다. <span class="green">지금 <<him>>【을를】 잡으면 끝이다.</span>
			<br><br>
		<</if>>

		<<link [[추격!|Gwylan Ritual Chase]]>><<set $chasestart to 1>><</link>>
		<br>
	<<else>>
		<<if !$huntGame.brownFox and $awarelevel gte 4 and _gwylanTF.known and $huntGame.otherHealth lte 2 and $hypnosis_traits.devotion gte 4 and !_gwylanStatus.includes("wounded")>>
			<<set $huntGame.brownFox to true>><<set $huntGame.adversaryText to "the brown fox">>
			<<set $huntGame.skills.athleticsMax += 75>><<set $huntGame.skills.skulduggeryMax += 75>><<set $huntGame.skills.danceMax += 75>>
			하지만 이건 그윌란이 아니다.
			<br><br>

			<span class="red">세 개의 눈이 밝은 녹색으로 빛나는 거대한 갈색 여우다. 당신에게 덮쳐들자 주변 공기가 흐릿해진다.</span>
			<br><br>
		<</if>>

		<<if $phase isnot "noDodge" and !$huntGame.noDodge>>
			<<link [[피해!|Gwylan Ritual Chase Dodge]]>><</link>><<dancedifficulty $huntGame.skills.danceMin $huntGame.skills.danceMax>>
			<br>
		<</if>>
		<<link [[도망쳐!|Gwylan Ritual Chase]]>><<set $runstart to 1>><</link>>
		<br>
	<</if>>
	<<set $huntGame.tracked to false>>
	<<set $huntGame.distance to 2>>
	<<set $huntGame.playerAction to "">>
	<<set $huntGame.playerActionLast to "">>
	<<set $huntGame.playerTracked to false>><<set $huntGame.playerTrackedKnown to false>>
	<<run delete $huntGame.noMoreHiding>><<run delete $huntGame.otherHideTimer>>
	<<set $huntGame.otherAction to "run">>
	<<set $huntGame.turn to 0>>
	<<set $huntGame.end to false>>
<<else>>
	<<gwylanHuntState>>
	<<gwylanHuntOptions>>
<</if>>

:: Gwylan Ritual Chase Dodge
<<effects>><<run statusCheck("Gwylan")>>
<<set $huntGame.dance ||= 0>>
<<if $danceSuccess>>
	<<set $huntGame.skills.danceMin += 100>><<set $huntGame.skills.danceMax += 175>>
	<<if $huntGame.dance is 0>>
		당신은 덮쳐오는 <<him>>【을를】 <<dancetext>> 붙잡는다. <<his>> 기세를 이용해 춤추듯 한 바퀴 돈 다음 <<him>>【을를】 밀쳐낸다. <<He>>【은는】 착지하더니, 다시 덮쳐온다!
		<br><br>

		<<link [[다시 피한다!|Gwylan Ritual Chase Dodge]]>><</link>><<dancedifficulty $huntGame.skills.danceMin $huntGame.skills.danceMax>>
		<br>
		<<link [[도망친다!|Gwylan Ritual Chase]]>><<set $huntGame.dance to 0>><<set $runstart to 1>><</link>>
		<br>
	<<elseif $huntGame.dance is 1>>
		<<if $huntGame.brownFox>>
			<<he>>【이가】 덮쳐올 때, 당신은 <<his>> 앞다리를 잡을 작정이었다. 하지만 당신의 손에 닿은 것은 부드러운 피부였다. 여우 대신, 그윌란의 단호한 얼굴이 당신을 마주한다.
		<</if>>
		당신은 <<his>> 손목을 <<dancetext>> 붙잡고 당신 주위로 <<him>>【을를】 빙글 돌린다. 춤은 계속되고, 그윌란에게서 희미한 미소를 본 것 같다.
		<br><br>

		<span class="blue">지금 도망치면, <<him>>보다 훨씬 앞서나갈 수 있습니다.</span> 다시 한번, <<he>>【이가】 당신에게 덮쳐온다!
		<br><br>

		<<if $huntGame.otherHealth lte 1>>
			<<link [[춤춘다|Gwylan Ritual Chase Dodge]]>><</link>><<dancedifficulty $huntGame.skills.danceMin $huntGame.skills.danceMax>>
		<<else>>
			<span class="blue"><<him>>【을를】 더 지치게 만들면, 다음에는 반격할 수 있을지도 모릅니다.</span>
		<</if>>
		<br>
		<<link [[도망친다!|Gwylan Ritual Chase]]>><<set $huntGame.chaseDistance to 3>><<set $huntGame.dance to 0>><<set $runstart to 1>><</link>>
		<br>
	<<else>>
		마지막으로 한 번, 당신은 <<dancetext>> 옆으로 비켜서서, 붙잡고, 빙글 돈다.
		<br><br>

		<<if $gwylanSeen.includes("yearning") and ($hypnosis_traits.devotion gte 4 or $auriga_scar or C.npc.Gwylan.dom gte 140)>>
			잠시 동안, 이것은 더 이상 사냥이 아니다. 숲 자체가 당신의 우아함에 굴복한다. 그윌란도 마찬가지다. 시간이 느려진다.
			<br><br>

			이번에는 <<him>>【을를】 내던지려 하지도, <<he>>【이가】 당신을 넘어뜨리려 하지도 않는다. 대신, 서로에게 기댄다.
			<br><br>

			당신은 껴안는다.
			<br><br>

			당신은 춤을 춘다.
			<br><br>

			당신은 여섯 개의 <span class="teal">익숙한</span> 음에 맞춰 스텝을 밟는다. 잠시 멈춘다. 첫 음이 다음 마디 앞에서 비틀거리자, 나머지 다섯 음이 따라잡는다. 당신은 이것을 세 번 반복한다.
			<br><br>

			당신은 더 이상 원래 있던 곳에 있지 않다.
			<br><br>

			<<link [[다음|Gwylan Ritual Chase Dance]]>><</link>>
			<br>
		<<else>>
			당신은 <<him>>【을를】 붙잡았고, 이번에는 놓아주지 않는다. 당신은 앞으로 밀고 나가, 기세에 몸을 맡겨 <<= window.KR.gatPersonNameDictKR($huntGame.adversaryText)>>【을를】 땅에 쓰러뜨린다.
			<<He>>【은는】 당신 밑에서 꿈틀거리지만, 당신은 <<his>> 손목을 땅에 단단히 고정한다. <<He>>【은는】 굴복한다. <<npcincr Gwylan lust 3>><<gglust>>
			<br><br>

			<<set $sexRitual.chaseWon to true>>
			<span class="gold">사냥에서 승리했습니다!</span>
			<<if $gwylanSeen.includes("yearning")>>
				<span class="blue">하지만 당신의 우아한 춤은, 당신의 <<if V.worn.neck.name === "familiar collar" && V.worn.neck.cursed === 1>>헌신<<else>>호기심<</if>>【이가】 더 깊었다면 무언가 더 큰 것의 문턱에 다다랐을 것 같은 느낌을 남깁니다.</span>
			<</if>>
			<<set $sexRitual.purge++>><<gwylanPurgeEffect>>
			<br><br>

			<<if $huntGame.brownFox>>
				갑자기 머리가 맑아지는 느낌이다. 아래를 내려다보니 여우가 아니라 당신 밑에 깔린 그윌란이 보인다. <<His>> 얼굴이 새빨갛다.
			<<else>>
				그윌란이 당신을 올려다본다. <<his>> 얼굴이 새빨갛다.
			<</if>>
			"알았어, 이제 나한테서 내려와도 돼. 네가 이겼어." <<He>>【이가】 미소 짓는다.
			<<if _gwylanStatus.includes("wounded")>>
				"다리가 다쳤는데도, 우아하게 나와 함께 움직여줬어. 내일이면 욱신거리겠지만, 그럴 만한 가치가 있었어." <<npcincr Gwylan dom 1>><<gyearning>>
			<<else>>
				"굉장했어. 정말... 우아하게 움직이더라." <<npcincr Gwylan dom 3>><<ggyearning>>
			<</if>>
			<br><br>

			당신은 그윌란이 일어서는 것을 돕는다. 두 사람은 상점으로 걸어 돌아간다. <<tiredness 6>><<ggtiredness>>
			<br><br>

			<<link [[다음|Gwylan Ritual Start Garden]]>><<endcombat>><<clotheson>><<unset $huntGame>><<pass 10>><</link>>
			<br>
		<</if>>
	<</if>>
	<<set $huntGame.dance++>>
<<else>>
	<<if $huntGame.playerHealth is 3>>
		피하려고 하지만, <span class="red">당신은 너무 느리다</span>. 아니, <<he>>【은는】 너무 빠르다.
		<br><br>

		<<if $huntGame.brownFox>>
			<<His>> 발톱이 당신을 거의 덮칠 뻔했지만, 대신 스치기만 한다. <<he>>【이가】 쏜살같이 지나가면서 당신은 땅에 넘어진다. <<pain 2>><<gpain>>
			<br><br>
		<<else>>
			<<He>>【이가】 당신을 붙잡아, 당신은 넘어진다. <<He>>【은는】 도 조금 떨어진 곳에 넘어진다.
		<</if>>
		다시 일어설 시간은 충분했지만, <<he>>【은는】 재빨리 다시 덮쳐온다.
		<br><br>

		<<if $huntGame.dance gte 2>>
			<<if $huntGame.otherHealth lte 1>>
				<<link [[춤춘다|Gwylan Ritual Chase Dodge]]>><</link>><<dancedifficulty $huntGame.skills.danceMin $huntGame.skills.danceMax>>
			<<else>>
				<span class="blue"><<him>>【을를】 더 지치게 만들면, 반격할 수 있을지도 모릅니다.</span>
			<</if>>
		<<else>>
			<<link [[다시 피한다!|Gwylan Ritual Chase Dodge]]>><</link>><<dancedifficulty $huntGame.skills.danceMin $huntGame.skills.danceMax>>
		<</if>>
		<br>
		<<link [[도망친다!|Gwylan Ritual Chase]]>><<set $huntGame.dance to 0>><<set $runstart to 1>><</link>>
		<br>
	<<elseif $huntGame.playerHealth is 2>>
		다시 한번 피하려고 하지만, <span class="red"><<he>>【은는】 너무 빠르다</span>.
		<br><br>

		<<if $huntGame.brownFox>>
			<<He>>【은는】 당신을 넘어뜨리고 구르지만, 덮치지는 않는다. <<He>>【은는】 몇 걸음 떨어져서 총총거리며 킁킁거린다. 마치 <<he>>【이가】 다시 해보길 바라는 것처럼. <<pain 2>><<gpain>>
		<<else>>
			<<He>>【은는】 당신을 단단히 붙잡고, 땅바닥에서 몸싸움을 벌인다. 잠깐의 몸부림 끝에 당신이 구르자, <<he>>【이가】 당신을 놓아준다.
		<</if>>
		<br><br>

		당신이 비틀거리며 일어서자, <<he>>【이가】 다시 덮쳐온다.
		<br><br>

		<<if $huntGame.dance gte 2>>
			<<if $huntGame.otherHealth lte 1>>
				<<link [[춤춘다|Gwylan Ritual Chase Dodge]]>><</link>><<dancedifficulty $huntGame.skills.danceMin $huntGame.skills.danceMax>>
			<<else>>
				<span class="blue"><<him>>【을를】 더 지치게 만들면, 반격할 수 있을지도 모릅니다.</span>
			<</if>>
		<<else>>
			<<link [[다시 피한다!|Gwylan Ritual Chase Dodge]]>><</link>><<dancedifficulty $huntGame.skills.danceMin $huntGame.skills.danceMax>>
		<</if>>
		<br>
		<<link [[도망친다!|Gwylan Ritual Chase]]>><<set $huntGame.dance to 0>><<set $runstart to 1>><</link>>
		<br>
	<<else>>
		<span class="red">제때 피할 수 있을 거란 희망이 없다.</span>
		<br><br>

		<<if $huntGame.brownFox>>
			갈색 여우가 당신을 덮쳐 눕힌다. <<His>> 주둥이가 당신 얼굴로 내려오고, 날카로운 이빨을 드러낸다. 당신은 고개를 돌리고 눈을 감는다.
			<br><br>

			아무 일도 일어나지 않는다. 당신이 주저하며 한쪽 눈을 뜨자, 그윌란이 미소를 지으며 당신 위에 누워있는 것이 보인다. <<His>> 발이 허공을 찬다.
		<<else>>
			그윌란의 팔이 당신을 감싼다. 재빨리 몸을 돌려, <<he>>【은는】 당신을 <<him>> 아래에 깔고 눕힌다.
			<br><br>

			<<He>>【은는】 당신이 굴복할 때까지 손목을 누르고 있다가, 킥킥 웃는다.
		<</if>>
		<<if _gwylanStatus.includes("lust")>>
			<<He>>【은는】 당신의 뺨에 키스한다.
		<<else>>
			<<He>>【은는】 당신의 뺨을 찌른다.
		<</if>>
		"잡았다. 좋은 시도였어! 그렇게 고집스럽게 버틴 것에 점수를 줄게." <<npcincr Gwylan lust 3>><<gglust>>
		<br><br>

		<<He>>【이가】 당신이 일어서는 것을 돕고, 두 사람은 숲속 상점으로 걸어 돌아간다. <<tiredness 6>><<ggtiredness>>
		<br><br>

		<<link [[다음|Gwylan Ritual Start Garden]]>><<endcombat>><<clotheson>><<unset $huntGame>><<pass 10>><</link>>
		<br>
	<</if>>
	<<set $huntGame.playerHealth-->>
<</if>>

:: Gwylan Ritual Chase Dance
<<set $location to "estate">><<effects>><<run statusCheck("Gwylan")>>
여기가 어디인지 잘 모르겠다.
<br><br>

신경 쓰이는지조차 잘 모르겠다.
<br><br>

<<if $fox gte 6 and ($demon gte 6 or $auriga_scar)>>
	<<set _masked to "뿔 달린 여우">>
<<elseif $fox gte 6 or isLoveInterest("Avery")>>
	<<set _masked to "여우">>
<<elseif $demon gte 6>>
	<<set _masked to "엘크">>
<<elseif $wolfgirl gte 6>>
	<<set _masked to "사냥개">>
<<else>>
	<<set _masked to "쥐">>
<</if>>

얼굴에 쓴 <<= _masked>> 가면의 눈구멍 때문에 주위 세상이 희미하게 보인다.
<br><br>

그윌란이 당신과 함께 춤을 춘다.
<<if _masked is "뿔 달린 여우">>
	<<He>>【은는】 여우 가면을 쓰고 있지만, 뿔은 부러져 있다.
<<elseif _masked is "여우">>
	<<He>>【은는】 여우 가면을 쓰고 있다.
<<else>>
	여우 가면을 쓴 채로.
<</if>>
<<His>> 튜닉은 사라지고, 대신
<<if C.npc.Gwylan.pronoun is "m">>
	하얀 장미로 장식된 프릴 정장을 입고 있다.
<<else>>
	붉은 장미로 장식된 프릴 드레스를 입고 있다.
<</if>>
<<if _gwylanTF.known>>
	등 쪽에는 천이 둘러져 있어 <<his>> 꼬리가 밖으로 삐져나와 있다. 당신과 춤을 추는 동안 꼬리가 부드럽게 좌우로 흔들린다.
<</if>>
<br><br>

다른 이들이 당신 주위에서 춤을 춘다.
<<if _masked is "엘크">>
	다른 엘크들이 음흉한 질투심으로 지켜본다.
<<else>>
	음흉한 엘크 가면들이 질투심으로 지켜본다.
<</if>>
그들의 팔이 당신을 향해 뻗어오지만, 결코 닿지 않는다. 그들의 시선이 당신들 둘을 발가벗기지만, 당신들 중 누구도 신경 쓰지 않는다. 그들은 중요하지 않다. 지금 이 순간, 그들은 당신에게 아무런 힘도 행사할 수 없다.
<br><br>

춤이 느려지자 그윌란이 당신에게 기댄다. 이렇게 가까이서 보니, <<if _masked is "뿔 달린 여우">>또 다른<<else>>하나의<</if>> <<his>> 가면에는 흠집이 있다. 이마 정중앙에 금이 간 자국이 나 있다. 그곳에서 피가 흐른다. <<He>>【은는】 그걸 눈치채지 못했거나, 신경 쓰지 않는 것 같다.
<br><br>

숲속에는 당신들 둘뿐이다. 당신은 숲속에 있고, 숲은 당신 안에 있다.
<br><br>

당신들은 하나다.
<br><br>

그윌란이
<<switch $bodysize>>
	<<case 0 1>>당신의 머리를 들어 올리고,
	<<case 2>>몸을 숙이고,
	<<case 3>><<his>> 발끝으로 서서,
<</switch>>
당신에게 키스한다. <<takeKissVirginity "Gwylan" "romantic">>
<br><br>

<<link [[다음|Gwylan Ritual Chase Dance 2]]>><<if $arousal lt 6000>><<set $arousal to 6000>><</if>><</link>>
<br>

:: Gwylan Ritual Chase Dance 2
<<set $location to "forest">><<effects>><<run statusCheck("Gwylan")>>
시야가 숲으로 돌아온다.
<br><br>

그윌란은 여전히 당신에게 키스하고 있으며, <<his>> 팔로 당신을 꽉 껴안고 있다.
<br><br>

<<His>> 눈이 깜빡 뜨인다. <<He>>【은는】 당신에게서 황급히 물러나 등을 돌리지만, <<his>> 팔은 여전히 당신을 감싸고 있다.
<br><br>

<<He>>【은는】 헛기침을 한다.
<br><br>

아무 말 없이, <<he>>【은는】 당신의 손을 잡고 걷기 시작한다. <<He>>【은는】 당신을 숲속 상점으로 다시 데려간다. <<tiredness 6>><<ggtiredness>><<npcincr Gwylan dom 5>><<gggyearning>>
<br><br>

