				"네 새장은 네가 만들었어, 불사조야. 잿더미로 도금된 채, 그 재가 바람에 흩날려 사라지는 걸 속수무책으로 바라만 보거라."
			)>>
			<<if $gwylanSeen?.includes("ritual_sex")>>
				<<run _linePool.pushUnique(
					"정화. 충동.",
					"슬픔 속에서 울부짖어라.",
					"메마르고 죽어버린 장미들, 불타기만을 기다리고 있지.",
					"가시의 입맞춤은 붉게 물들었네.",
					"꽃피우기 전에 봉오리를 꺾어버리기 위하여."
				)>>
			<</if>>
			<<if $gwylanSeen?.includes("yearning")>>
				<<run _linePool.pushUnique(
