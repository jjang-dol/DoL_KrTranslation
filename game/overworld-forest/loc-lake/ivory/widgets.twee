:: Widgets Wraith [widget]
<<widget "generateWraith">>
	<<if _args[0] is undefined>>
		<<set _w to 1>>
	<<else>>
		<<set _w to _args[0]>>
	<</if>>
	<<set _n to (_w -1)>>
	<<if C.npc["Ivory Wraith"].init isnot 1>>
		<<set _strapIgnore to true>><<set _condomIgnore to true>>
		<<generateNPC _w a n n 20>>
		<<set $NPCList[_n].skincolour to "ghost">>
		<<saveNPC _n "temp_wraith">>
		<<clearsinglenpc _n>>
		<<initnpc "Ivory Wraith">>
		<<run ["gender", "pregnancyAvoidance", "vagina", "penis", "chest", "skincolour", "breastsize", "breastsdesc", "breastdesc", "penisdesc", "penissize", "trust", "type"].forEach(s => C.npc["Ivory Wraith"][s] = clone($per_npc.temp_wraith[s]))>>
		<<npc "Ivory Wraith">>
		<<clearNPC "temp_wraith">>
	<<else>>
		<<npc "Ivory Wraith">>
	<</if>>
	<<checkWraith>>
	<<if _args[1]>>
		<<set $wraith.seen++>>
	<</if>>
	<<personselect _n>>
<</widget>>

<!-- Recursive. With no argument, picks one at random. If option is disabled, runs as another argument. Can not infinite loop. -->
<<widget "initWraith">>
	<<if _args[0]>>
		<<set $wraith.gen to _args.random()>>
		<<set $pronoun to "i">>
		<<statsWraith>>
		<<switch $wraith.gen>>
			<<case "man">>
				<<set $molestationstart to 1>>
				<<set $wraith.type to "man">>
				<<set _genderknownbeforehand to true>>
				<<set $noBodyWriting to true>>
				<<set $stealtarget to "012345">>
				<<maninit>>
				<<set $enemyhealthmax to _wraithHP>>
				<<set $enemyhealth to _wraithHP>>
				<<set $enemyarousalmax to 700>>
				<<set $enemyanger += (C.npc["Ivory Wraith"].lust * 5)>>
				<<set $enemytrust -= (C.npc["Ivory Wraith"].lust * 2)>>
				<<npcexpose>>
			<<case "slimetentacles">>
				<<if $debug is 1>>
					/* Unreachable until swarms are un-fucked */
					<<if $settings.slimesEnabled and $settings.tentaclesEnabled>>
						<<set $molestationstart to 1>>
						<<set $wraith.type to "tentacles">>
						<<swarminit "slimes" "슬라임 덩어리" "당신을 향해 다가오고 있다" "당신을 포위한다" "뿌리치기" _wraithSlimes 0>>
						<<tentaclestart _wraithTentacles 18 "tentacle" "pale">>
					<<else>>
						<<initWraith "tentacles">>
					<</if>>
				<<else>>
					<<initWraith "tentacles">>
				<</if>>
			<<case "slime">>
				<<if $settings.slimesEnabled>>
					<<set $struggle_start to 1>>
					<<set $wraith.type to "slime">>
					<<struggle_init>>
					<<set $struggle.creature to "pale slime">>
					<<if $wraith.state is "haunt">>
						<<struggle_creatures 4 2>>
					<<else>>
						<<struggle_creatures 3 1>>
					<</if>>
				<<else>>
					<<initWraith "tentacles">>
				<</if>>
			<<case "tentacles">>
				<<if $settings.tentaclesEnabled>>
					<<set $molestationstart to 1>>
					<<set $wraith.type to "tentacles">>
					<<tentaclestart _wraithTentacles 18 "tentacle" "pale">>
				<<else>>
					<<initWraith "arms">>
				<</if>>
			<<case "abomination">>
				<<if $settings.tentaclesEnabled>>
					<<set $molestationstart to 1>>
					<<set $wraith.type to "man">>
					<<set $abomination to 1>>
					<<set _genderknownbeforehand to true>>
					<<set $noBodyWriting to true>>
					<<maninit>>
					<<npcexpose>>
					<<set $enemyhealthmax to _wraithHP>>
					<<set $enemyhealth to _wraithHP>>
					<<set $enemyarousalmax to 1300>>
					<<set $enemyanger += (C.npc["Ivory Wraith"].lust * 5)>>
					<<set $enemytrust -= (C.npc["Ivory Wraith"].lust * 2)>>
					<<tentaclestart _wraithTentaclesAbomination 15 "tentacle" "pale">>
					/* This felt a bit too powerful, partially disabled for now. */
					<<for _i to 0; _i lt $tentacles.active; _i++>>
						/*<<set $enemyhealthmax += $tentacles[_i].tentaclehealth>>*/
						/*<<set $enemyhealth += $tentacles[_i].tentaclehealth>>*/
						<<set $enemyarousalmax += $tentacles[_i].tentaclehealth>>
					<</for>>
				<<else>>
					<<initWraith "arms">>
				<</if>>
			<<case "arms">>
				<<set $molestationstart to 1>>
				<<set $breakIgnore to true>>
				<<set $wraith.type to "man">>
				<<set _genderknownbeforehand to true>>
				<<set $noBodyWriting to true>>
				<<set $stealtarget to "012345">>
				<<maninit>>
				<<for _iw to 1; _iw lt 4; _iw++>>
					<<npc "Ivory Wraith" -1>>
					<<set $NPCList[_iw].lefthand to 0>>
					<<set $NPCList[_iw].righthand to 0>>
					<<set $NPCList[_iw].mouth to "none">>
					<<set $NPCList[_iw].penis to "none">>
					<<set $NPCList[_iw].vagina to "none">>
					<<set $NPCList[_iw].active to "active">>
				<</for>>
				<<set $enemyhealth to _wraithHP>>
				<<set $enemyhealthmax to _wraithHP>>
				<<npcexpose>>
				<<set $enemyarousalmax to 700>>
				<<set $enemyanger += (C.npc["Ivory Wraith"].lust * 5)>>
				<<set $enemytrust -= (C.npc["Ivory Wraith"].lust * 2)>>
			<<default>>
				<<initWraith "man">>
		<</switch>>
		<<if $wraithHealth>>
			<<set $enemyhealth to $wraithHealth>>
		<</if>>
	<<else>>
		<<switch random(1, 6)>>
			<<case 1>>
				<<if $wraith.state is "haunt" or Time.isBloodMoon()>>
					<<initWraith "abomination">>
				<<else>>
					<<initWraith "man">>
				<</if>>
			<<case 2>>
				<<initWraith "tentacles">>
			<<case 3>>
				<<initWraith "slimetentacles">>
			<<case 4>>
				<<initWraith "slime">>
			<<case 5>>
				<<initWraith "abomination">>
			<<case 6>>
				<<initWraith "arms">>
		<</switch>>
	<</if>>
	<<set $speechdisable to 1>><<set $enemynomax to 1>>
<</widget>>

<<widget "statsWraith">>
	<<set _wraithMod to (1 + (Math.floor(C.npc["Ivory Wraith"].lust / 3)))>>
	<<set _wraithHP to 600 + (50 * _wraithMod)>>
	<<set _wraithSlimes to (1 + _wraithMod)>>
	<<set _wraithTentacles to Math.clamp((4 + _wraithMod), 6, 10)>>
	<<set _wraithTentaclesAbomination to Math.clamp(Math.floor(1 + _wraithMod), 4, 7)>>
<</widget>>

<<widget "startWraith">>
	<<switch $wraith.gen>>
		<<case "man">>
			<<He>>【이가】 손을 들자, 당신은 강제로 무릎을 꿇게 된다.
		<<case "abomination">>
			<<his>> 등에서 많은 촉수들이 터져 나오고, <<he>>【이가】 당신을 끌어당긴다.
		<<case "arms">>
			<<his>> 등에서 몇 쌍의 추가적인 팔이 튀어나온다.
		<<case "tentacles" "slimetentacles">>
			<<He>>【이가】 손을 들자, 당신 주위에 소용돌이치는 보라색 원반들이 나타난다. 그 안에서 촉수들이 튀어나와 당신을 붙잡는다. <<He>>【은는】 공중에 물러나 앉아, 히죽거리며 지켜본다.
		<<case "slime">>
			<<He>>【이가】 팔로 이상한 동작을 취하자, 공중에 소용돌이치는 보라색 원반이 나타난다. 거기서 창백하고 거대한 슬라임 여러 마리가 기어 나온다. <<He>>【은는】 공중에 물러나 앉아, 히죽거리며 지켜본다.
	<</switch>>
<</widget>>

<<widget "continueWraith">>
	<<if !$wraithOptions>>
		<<if $consensual is 1>>
			<<set $wraithOptions to ["man", "tentacles", "abomination", "arms"]>>
		<<else>>
			<<set $wraithOptions to ["man", "tentacles", "abomination", "slime", "arms"]>>
		<</if>>
	<</if>>
	<<set _wraithLast to $wraith.gen>>
	<<set _wraithSelect to $wraithOptions.pluck()>>
	<<set $wraithHealth to $enemyhealth>>
	<<endcombat>>
	<<generateWraith 1>>
	<<initWraith _wraithSelect>>
	<<set $NPCList[0].intro to 0>>
	<<set $enemyhealth to $wraithHealth>>
	<<if $pain gte 50 and $bus isnot "lake_ruin_prison">>
		<<kissWraith>>
		<br><br>
	<</if>>
	<<if _wraithLast is $wraith.gen>>
		그것이 당신을 미소 지으며 내려다본다. "<span class="wraith">다시.</span>"
	<<else>>
		<<switch $wraith.gen>>
			<<case "man">>
				<<he>>【이가】 <<his>> 손을 들자, 보이지 않는 힘이 당신을 다시 끌어당긴다. "<span class="wraith">영원히.</span>"
			<<case "abomination">>
				<<his>> 등에서 수많은 촉수들이 터져 나오고, <<he>>【은는】 당신을 끌어당긴다. "<span class="wraith">받아들여.</span>"
			<<case "arms">>
				<<his>> 등에서 몇 쌍의 여분의 팔이 튀어나온다. "<span class="wraith">다시는 자유로워질 수 없어.</span>"
			<<case "tentacles" "slimetentacles">>
				<<he>>【이가】 <<his>> 손을 들자 소용돌이치는 보라색 원반들이 당신 주변에 나타난다. 거기서 덩굴손들이 튀어나와 당신을 붙잡는다. <<he>>【은는】 허공에 편안히 기대앉아 씨익 웃으며 바라본다. "<span class="wraith">몸부림이 계속되겠군.</span>"
			<<case "slime">>
				<<he>>【이가】 <<his>> 팔로 기묘한 동작을 취하자 공중에 소용돌이치는 보라색 원반이 나타난다. 거기서 여러 마리의 크고 창백한 슬라임들이 튀어나온다. <<he>>【은는】 허공에 기대앉아 씨익 웃으며 바라본다. "<span class="wraith">파도가 집어삼킬 것이다.</span>"
		<</switch>>
	<</if>>
<</widget>>

<<widget "endWraith">>
	<<if $enemyhealth gt 0>>
		<<set $wraithHealth to $enemyhealth + 50>>
	<<else>>
		<<unset $wraithHealth>>
	<</if>>
	<<endevent>>
	<<run delete $wraith.type>>
	<<run delete $wraith.select>>
	<<run delete $wraith.gen>>
	<<unset $wraithOptions>>
	<<set $wraith.mimic to "">>
	<<unset $wraithCount>>
	<<unset $wraithMax>>
	<<set $wraith.revealed to false>>
	<<if $controlSaved>>
		<<set $control to $controlSaved>>
		<<unset $controlSaved>>
	<</if>>
	<<if $wraith.nightmare is 2>>
		<<set $wraith.nightmare to 0>>
	<</if>>
	<<if $possessed>>
		<<if $wraith.possessCount is undefined>>
			<<set $wraith.possessCount to 1>>
		<<else>>
			<<set $wraith.possessCount++>>
		<</if>>
		<<unset $possessed>><<canvas-model-override "clear">>
	<</if>>
	<<unset $nextPassage>>
	<<unset $nextPassageIntended>>
	<<unset $nextPassageCheck>>
	<<unset $phaseWraith>>
	<<unset $wraithBedSpeech>>
	<<unset $gwylanDoesALittleTrolling>>
<</widget>>

<<widget "rainWraith">>
	<<if Weather.precipitation is "none">>
		<<set Weather.set("heavyPrecipitation", true, 20)>>
		<<if _args[0]>>
			<<if $outside is 1>>
				<<if Weather.precipitation is "snow">>
					<<print either(
						"언제부터 눈이 내리기 시작했는지 기억나지 않는다. 벌써 시야가 흐릿하다.",
						"바람이 거세지고, 눈보라가 몰아치면서 시야가 좁아진다.",
						"피부에 눈송이가 느껴진다."
					)>>
				<<else>>
					<<print either(
						"언제부터 비가 내리기 시작했는지 기억나지 않는다.",
						"바람이 거세지고, 비가 내리기 시작한다.",
						"피부에 빗방울이 느껴진다."
					)>>
				<</if>>
			<<else>>
				<<print either(
					"언제 안개가 끼었는지 기억나지 않는다. 벌써 시야가 흐릿하다.",
					"설명할 수 없는 바람이 불고, 안개가 몰려온다.",
					"안개가 주위를 감싼다."
				)>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "endRainWraith">>
	<<if _args[0]>>
		<<if $outside is 1>>
			<<if Weather.precipitation is "rain">>
				<<print either(
					"하늘이 맑아지지 않는다.",
					"비가 그치지 않는다.",
					"비가 그칠 기미를 보이지 않는다."
				)>>
			<<else>>
				<<print either(
					"하늘이 맑아지지 않는다.",
					"눈이 그치지 않는다.",
					"눈이 그칠 기미를 보이지 않는다."
				)>>
			<</if>>
		<<else>>
			<<print either(
				"주변이 맑아지기 시작한다.",
				"안개가 갑자기 걷힌다.",
				"안개가 걷힌다."
			)>>
		<</if>>
	<</if>>
<</widget>>

<<widget "checkWraith">>
	<<if !$wraith.init>>
		<<set $wraith to {init: 1, seen: 0, days: 0, defeated: 0, evaded: 0, nightmare: 0, timer: 0, hunt: 0, state: "", mimic: "", revealed: false, offspring: "", exit: ""}>>
	<</if>>
	<<if Time.days gte 32 and Time.monthName isnot "October" and !$wraithSkip>>
		<<if $museumAntiques.antiques.antiqueivorynecklace isnot "notFound">>
			<<if $necklaceThief is "player">>
				<<set $wraith.state to "haunt">>
			<<else>>
				<<set $wraith.state to "despair">>
			<</if>>
		<<else>>
			<<set $wraith.state to "active">>
		<</if>>
	<</if>>
	<<if _args[0]>>
		<<if $wraith.state isnot "" and !$wraithCheck and $wraith.nightmare is 0 and (random(0,2) is 2 or $wraith.state is "haunt" or $wraith.offspring is "dead")>>
			<<set $wraith.nightmare to 1>>
			<<set $wraithCheck to true>>
		<</if>>
		<<if $moonstate isnot "morning" and $wraith.state isnot "" and $wraith.timer lte 0>>
			<<set $wraith.timer to C.npc["Ivory Wraith"].lust>>
		<</if>>
	<</if>>
<</widget>>

<<widget "clearWraith">>
	<<if $wraith>>
		<<if $foresthunt gte 1>>
			<<set $foresthunt to 0>>
		<</if>>
		<<set $wraith.mimic to "">>
		<<set $wraith.exit to "">>
		<<set $wraith.nightmare to 0>>
		<<set $wraith.hunt to 0>>
		<<set $wraith.timer to 0>>
		<<set $wraith.evaded to 0>>
		<<unset $wraithCheck>>
		<<unset $wPersist>>
		<<unset $wraithSkip>>
		<<run delete $wraith.type>>
		<<run delete $wraith.select>>
		<<run delete $wraith.gen>>
		<<run delete $wraith.will>>
		<<unset $wraithOptions>>
		<<unset $wraithCount>>
		<<unset $wraithMax>>
		<<unset $wraithHealth>>
		<<if $possessed>>
			<<if $wraith.possessCount is undefined>>
				<<set $wraith.possessCount to 1>>
			<<else>>
				<<set $wraith.possessCount++>>
			<</if>>
			<<unset $possessed>><<canvas-model-override "clear">>
		<</if>>
		<<set $wraith.revealed to false>>
		<<unset $wraithWillMessage>>
		<<unset $nextPassage>>
		<<unset $nextPassageIntended>>
		<<unset $nextPassageCheck>>
		<<unset $phaseWraith>>
		<<unset $wraithPaleVisit>>
		<<unset $wraithApologise>>
		<<unset $wraithApologiseCooldown>>
	<</if>>
<</widget>>

<<widget "wraithEyes">><<silently>>
	<<if _args[0] is "adv">>
		<<set _text_output to (["haunt", "despair"].includes($wraith.state) ? "빨갛게" : "파랗게")>>
	<<elseif _args[0] is "noun">>
		<<set _text_output to (["haunt", "despair"].includes($wraith.state) ? "빨간색" : "파란색")>>
	<<else>>
		<<set _text_output to (["haunt", "despair"].includes($wraith.state) ? "빨간" : "파란")>>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "wraithShamble">><<silently>>
	<<if $compound.wraith>>
		<<set _text_output to ($compound.wraith is "willing" ? "걷는다" : "비틀거린다")>>
	<<else>>
		<<set _text_output to "비틀거린다">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "speechWraith">><<silently>>
	<<if $possessed and _args[0] isnot "lines">>
		<<set $_npcWraith to _args[0] || "none">>
		<<set _speakPool to ["말한다","신음한다","낄낄거린다","속삭인다","비웃는다","웃는다","소리친다","침을 뱉는다","섬뜩할 정도로 차분한 목소리로 말한다"]>>
		<<if $wolfgirl gte 4>>
			<<run _speakPool.pushUnique(
				"짖는다","으르렁거린다","울부짖는다"
			)>>
		<</if>>
		<<if $cat gte 4>>
			<<run _speakPool.pushUnique(
				"야옹거린다","가르랑거린다","하악질한다"
			)>>
		<</if>>
		<<if $cow gte 4>>
			<<run _speakPool.pushUnique(
				"음메 하고 운다","콧김을 내뿜는다","씩씩거린다"
			)>>
		<</if>>
		<<if $harpy gte 4>>
			<<run _speakPool.pushUnique(
				"지저귄다","꽥꽥거린다","노래한다"
			)>>
		<</if>>
		<<if $fox gte 4>>
			<<run _speakPool.pushUnique(
				"짖는다","깽깽거린다","비명을 지른다"
			)>>
		<</if>>

		<<set _linePool to ($_npcWraith is "none" ? [
			"나를.",
			"머물러.",
			"굴복해.",
			"아직 안 돼.",
			"버려졌어.",
			"위선자.",
			"고개를 숙여라.",
			"우리 또한 그렇다.",
			"네 분수를 알아라.",
			"대혼란, 쏟아지는 비난.",
			"시체는 말을 할 수 없지.",
			"어디 한번 알아볼까?",
			"조금만 더.",
			"이 실들이 나를 편안하게 해.",
			"나뭇가지로 만들어진 우리의 천국.",
			"다시는 달을 볼 수 없겠지.",
			"비켜라, 아니면 내쳐지든가.",
			"시체는 관 속에 머물러야지.",
			"같은 말을 반복하게 하지 마. 수고할 필요 없어.",
			"우린 결코 이곳에 없었어. 그게 우리가 떠난 이유지.",
			"손가락 사이로 빠져나가는 모래처럼.",
			"내 손으로 널 거기까지 끌고 가야만 한대도.",
			"도망쳐. 네게 갈 곳이 없다는 사실을 잊고. 도망쳐라.",
			"내 응접실로 들어오렴, 파리가 거미에게 말했다.",
			"내면의 것은 항상 외부의 것을 정복하기 마련이야.",
			"마음껏 널 강철로 무장해 봐. 결국 넌 녹슬게 될 테니까.",
			"역사는 희생자들을 집어삼키고 그들의 뼈를 뱉어내지.",
			"황폐해져라. 사라져라. 빠져 죽어라. 우리가 다시 널 찾아낼 테니.",
			"시련의 결말만을 안다는 것은 미칠 노릇일 테지.",
			"너의. 안에. 우리의. 이름을. 완벽을. 새겨라. 너란. 존재를. 모두. 씻어. 내라."
		] : [])>>
		<<if $npc.includes("Sydney")>>
			<<run statusCheck("Sydney")>>
			<<run _linePool.pushUnique(
				"거짓말쟁이.",
				"다시.",
				"시드니?",
				"드디어 혼자 남았네.",
				"나는 우리를 잃었어.",
				"우리가 영원히 잠들 수 있게 해 줘.",
				"순결한 자가 회개할 수 있을까?",
				"네가 왜 여기 있는지 넌 알고 있지.",
				"나를 믿었다니 유감이구나.",
				"참 우스꽝스럽군. 왜 웃지 않는 거지?",
				"이제 괜찮아, 시드니. 난 원래대로 돌아왔어.",
				"마음껏 날 차단해 봐. 난 여전히 여기 있으니까.",
				"너의 <<sydneyOtherParent>>【을를】 기억하니?",
				"그들은 결코 멈추지 않았어, 시작조차 한 적이 없었기 때문이지.",
				"빛은 너를 서서히, 고통스럽게 집어삼킬 것이다.",
				"너를 다시 보게 되어 기쁘군. 널 그리워했어, 그거 아니?",
				"기억하고 있나? 물론 기억하겠지. 물론 넌 기억 못 해.",
				"정말 끔찍한 노래야, 그리고 그걸 연주하는 건 네가 아니지.",
				"<<nnpc_He \"Harper\">>【은는】 <<nnpc_himself \"Harper\">>에게 참 확신이 넘쳤지.",
				"순결함과 타락함은 극과 극이지만, 그 끝은 똑같지.",
				"둘이 하나에서 나오듯, 하나도 둘에서 나와 <span class=\"tentacle\">하나로서(As One)</span> 나타날지니."
			)>>
			<<if $templePromised is "Sydney">>
				<<run _linePool.pushUnique("재앙이 울려 퍼진다.")>>
			<</if>>
			<<if _sydneyStatus.includes("pure")>>
				<<run _linePool.pushUnique(
					"날게 되면 이해할 수 있을 거야.",
					"자궁의 양수로 세례를 받거라.",
					"모든 삶엔 죄가 있지. 모든 죄엔 삶이 있고."
				)>>
			<<elseif _sydneyStatus.includes("neutral")>>
				<<run _linePool.pushUnique(
					"그 끝은 공허를 향하지.",
					"그리고 그게 사실인 한, 절대 사라지지 않을 거야.",
					"균형. 우유부단함. 공포. 정말 많은 단어들이 있군."
				)>>
			<<elseif _sydneyStatus.includes("corrupt")>>
				<<run _linePool.pushUnique(
					"아무도 대답하지 않을 거야.",
					"네가 두려워하던 그 자체로 넌 변해버렸지.",
					"그럴 만한 가치가 있었나? 물론, 있었겠지."
				)>>
			<</if>>
		<<else>>
			<<run _linePool.pushUnique(
				"넌 절대 우리의 일부(a part)가 될 수 없어. 우린 절대 떨어지지(apart) 않을 테니까.",
				"우리는 <span class=\"tentacle\">하나로서</span> 서 있다, 그리고 넌 결코 그 일부가 될 수 없을 것이다."
				)>>
		<</if>>
		<<if $npc.includes("Robin") or $_npcWraith is "Robin">>
			<<run _linePool.pushUnique(
				"하찮고 아무것도 아닌 것.",
				"날개가 잘린 자는 숨통이 끊어지는 게 낫지.",
				"얼마나 더 갈 수 있을까? 얼마나 멀리 도망칠 수 있지?",
				"네 새장은 네가 만들었어, 노래하는 새야. 그 안에 얌전히 누워 있어라."
			)>>
			<<if C.npc.Robin.trauma gte 20>>
				<<run _linePool.pushUnique("<<phim>>【을를】 믿다니 정말 유감이구나.")>>
			<</if>>
			<<if C.npc.Robin.cdquest gte 7>>
				<<run _linePool.pushUnique("새로운 가죽. 변함없는 죄악.")>>
			<</if>>
		<</if>>
		<<if $npc.includes("Whitney") or $_npcWraith is "Whitney">>
			<<run _linePool.pushUnique(
				"고문관.",
				"연기 속에 빠져라. 불꽃 속에 빠져 죽어라.",
				"시체들로 만들어진 갑옷. 지금 그들은 여기 없지."
			)>>
			<<if $whitneyrescued>>
				<<run _linePool.pushUnique("가장 끔찍한 적에게 배신당했군. 넌 <<phim>>【을를】 사랑하나?")>>
			<</if>>
		<</if>>
		<<if $npc.includes("Kylar") or $_npcWraith is "Kylar">>
			<<run _linePool.pushUnique(
				"괴물들의 아이야.",
				"너도 그것을 보았겠지.",
				"똑같이 신의를 저버린 그림자여.",
				"네가 쥐는 힘이 조금만 더 강했더라면.",
				"세상을 멀게 할 정도로 눈부신 에메랄드 그린. 그것이 네가 가진 질투의 색이지."
			)>>
			<<if ["dead","sold"].includes($wraith.offspring)>>
				<<run _linePool.pushUnique("넌 그들을 실망시켰고, 우리를 실망시켰어.")>>
			<</if>>
			<<if $syndromekylar is 1>>
				<<run _linePool.pushUnique("그리움, 소속감.")>>
			<</if>>
		<</if>>
		<<if $npc.includes("Eden") or $_npcWraith is "Eden">>
			<<run _linePool.pushUnique(
				"에덴...",
				"말하지 못한 것들이 너무 많아.",
				"네가 날 데려가 줄 수만 있다면...",
				"넌 애초에 도망치는 걸 멈추지 말았어야 했어.",
				"네가 전혀 알지 못했던 오랫동안 잊혀진 친구처럼.",
				"넌 결코 충분히 멀리 갈 수 없을 거다. 이건 절대 널 떠나지 않으니까."
			)>>
			<<if $syndromeeden is 1>>
				<<run _linePool.pushUnique("넌 목줄과 사슬 속에서, 안식처를 찾아냈지.")>>
			<</if>>
		<</if>>
		<<if $npc.includes("Avery") or $_npcWraith is "Avery">>
			<<run _linePool.pushUnique(
				"모든 얼룩이 다 씻겨 나가는 건 아니야.",
				"돈. 물질. 의미 없는 소음들.",
				"그래봤자 넌 여전히 그걸 감당할 능력이 없을 테지."
			)>>
			<<if $averyragerevealed is 1>>
				<<run _linePool.pushUnique("산산조각 난 유리잔에서 흘러나온 피와 와인이 뒤섞이는구나.")>>
			<</if>>
		<</if>>
		<<if $npc.includes("Alex") or $_npcWraith is "Alex">>
			<<run _linePool.pushUnique(
				"넌 아무것도 아니게 될 거다.",
				"열셋 중의 하나. 구별할 수 없는 존재.",
				"네가 사랑하는 모든 것을 파괴할 때까지, 네 마음을 희석시켜라."
			)>>
			<<if $farm.aggro gte 60>>
				<<run _linePool.pushUnique("메뚜기 떼가 새로운 만찬을 즐길 것이다.")>>
			<</if>>
		<</if>>
		<<if $npc.includes("Black Wolf") or $_npcWraith is "Black Wolf">>
			<<run _linePool.pushUnique(
				"네 차례를 기다려.",
				"울부짖음도, 붉은 피를 뚝뚝 흘리고 있군.",
				"감히 사냥에 나서 보아라. 굴복당하고 말 테니."
			)>>
			<<if $wolfpackleader is 1>>
				<<run _linePool.pushUnique("먹이를 주는 손을 물어뜯어라.")>>
			<</if>>
		<</if>>
		<<if $npc.includes("Great Hawk") or $_npcWraith is "Great Hawk">>
			<<run _linePool.pushUnique(
				"자신의 거울 속 모습을 두려워하는 건 현명한 일이지.",
				"돌보지 않은 알은 결코 부화하지 못한다.",
				"태양을 향해 날아가든, 아니면 진흙탕 속에 가라앉든.",
				"노래는 멈춘 적이 없었어. 애초에 시작되기는 했을까?"
			)>>
			<<if $birdFly is 1>>
				<<run _linePool.pushUnique("깃털을 세어봐. 셀 수조차 없는 깃털들을.")>>
			<</if>>
		<</if>>
		<<if $npc.includes("Gwylan") or $_npcWraith is "Gwylan">>
			<<run _linePool.pushUnique(
				"시체.",
				"남겨진 것들.",
				"여우. 사냥개. 뱀.",
				"나와 함께 노래하자, 바닷새야.",
				"영원토록 홀로 남을 운명.",
				"갈매기는 자신의 둥지를 중독시키지.",
				"이름을 빼앗긴 자. 희망을 잃어버린 자.",
				"언제나 네 두 눈은 바다의 수평선만 바라보고 있구나.",
				"넌 너무 오랫동안 날아다녔어. 네 다리는 이미 쇠약해졌지.",
				"허물을 벗는 뱀처럼. 너의 자식을 잡아먹어라.",
				"짐승과 함께 누운 자는 물어뜯길 각오를 해야 하는 법.",
				"시간의 화살은 네가 태어나기도 한참 전에 이미 자정을 쳤단다.",
