					<<set $rng2 to random(1, 3)>>
					<<if $rng2 is 1 and $edenfreedom gte 1>>
						등골이 오싹해지며 원초적 본능이 경고를 보낸다. <span class="red">무언가 당신을 사냥하고 있다.</span>
						<<set $forestHunter to "Eden">>
					<<else>>
						현기증과 혼란이 밀려온다. 눈을 깜박일 때마다 흐릿한 형상이 보인다.
						<br>
						두 눈을 질끈 감자, 형상이 선명해지기 시작한다. 붉은 달빛을 받으며 서 있는, 상아처럼 창백한 피부의 키 큰 로브를 입은 형상이 보인다. 당신이 그것을 보는 순간, 그것 역시 당신을 보고 있다는 생각을 지울 수 없다.
						사슬이 끊어지는 소리가 귓가에 울려 퍼진다. <<stress 6>><<gstress>><<trauma 6>><<gtrauma>>
						<br>
						<span class="red">무언가 당신을 사냥하고 있다.</span>
					<</if>>
					<<set $wraith.hunt to 1>>
				<<else>>
					주변 허공에서 기이한 형상들이 보이기 시작한다. 등골이 오싹해진다. <span class="red">무언가 당신을 여전히 쫓고 있다.</span>
				<</if>>
				<<set $forestHunter to "Ivory Wraith">>
				<<set $foresthunt to $wraith.hunt>>
				<br><br>
				<<link [[다음|Forest]]>><<set $eventskip to 1>><</link>>
			<<case "drain">>
				<<if npcCanHunt("Ivory Wraith") and $wraith.state and $wraith.hunt is 0 and $wraith.timer gte (random(0, 60))>>
					<<set $wraith.hunt to 1>>
					<br><br>
					현기증과 혼란이 밀려온다. 눈을 깜박일 때마다 흐릿한 형상이 보인다.
					<br>
					두 눈을 질끈 감자, 형상이 선명해지기 시작한다. 붉은 달빛을 받으며 서 있는, 상아처럼 창백한 피부의 키 큰 로브를 입은 형상이 보인다. 당신이 그것을 보는 순간, 그것 역시 당신을 보고 있다는 생각을 지울 수 없다.
					사슬이 끊어지는 소리가 귓가에 울려 퍼진다. <<stress 6>><<gstress>><<trauma 6>><<gtrauma>>
					<br>
					<<if $wraith.state is "haunt">>
						<span class="red">당신은 사냥당하고 있다.</span>
					<<else>>
						<span class="red">공포가 공기 중에 감돌고 있다.</span>
					<</if>>
				<<elseif $wraith.hunt>>
					<<if $moonstate is "morning" and Time.hour gte 6>>
						<br><br>
						열린 맨홀과 창살 사이로 아침 햇살이 스며들자, 안도감이 밀려온다. 공포가 사라진다. <span class="blue"><i>다음 붉은 달이 뜰 때까지는 안전하다.</i></span>
						<<clearWraith>>
					<<elseif $wraith.state is "haunt">>
						<span class="red">무언가 끔찍한 것이 당신을 사냥하고 있다.</span>
						<<set $wraith.hunt += (0.5 + (C.npc["Ivory Wraith"].lust / 40))>>
						<<if $wraith.hunt gte ($rng / 10)>>
							<<set $eventforced to true>>
						<</if>>
					<<else>>
						<span class="red">지상의 거리를 기괴한 무언가가 배회하고 있다.</span>
						<<set $wraith.hunt += (0.5 + (C.npc["Ivory Wraith"].lust / 40))>>
						<<if $wraith.hunt gte ($rng / 10)>>
							<<set $eventforced to true>>
						<</if>>
					<</if>>
				<</if>>
			<<case "sewers">>
				<<if npcCanHunt("Ivory Wraith") and $wraith.state and $wraith.hunt is 0 and $wraith.timer gte (random(0, 60))>>
					<<set $wraith.hunt to 1>>
					<br><br>
					현기증과 혼란이 밀려온다. 눈을 깜박일 때마다 흐릿한 형상이 보인다.
					<br>
					두 눈을 질끈 감자, 형상이 선명해지기 시작한다. 붉은 달빛을 받으며 서 있는, 상아처럼 창백한 피부의 키 큰 로브를 입은 형상이 보인다. 당신이 그것을 보는 순간, 그것 역시 당신을 보고 있다는 생각을 지울 수 없다.
					사슬이 끊어지는 소리가 귓가에 울려 퍼진다. <<stress 6>><<gstress>><<trauma 6>><<gtrauma>>
					<br>
					<<if $wraith.state is "haunt">>
						<span class="red">당신은 사냥당하고 있다.</span>
					<<else>>
						<span class="red">공포가 공기 중에 감돌고 있다.</span>
					<</if>>
				<<elseif $wraith.hunt>>
					<<if $moonstate is "morning" and Time.hour gte 6>>
						<br><br>
						태양이 떠올랐다는 것을 본능적으로 깨닫고 안도감을 느낀다. 공포가 사라진다. <span class="blue"><i>다음 붉은 달이 뜰 때까지는 안전하다.</i></span>
						<<clearWraith>>
					<<elseif $wraith.state is "haunt">>
						<span class="red">무언가 끔찍한 것이 당신을 사냥하고 있다.</span>
						<<set $wraith.hunt += (0.5 + (C.npc["Ivory Wraith"].lust / 40))>>
						<<if $wraith.hunt gte ($rng / 10)>>
							<<set $eventforced to true>>
						<</if>>
					<<else>>
						<span class="red">하수도를 기괴한 무언가가 배회하고 있다.</span>
						<<set $wraith.hunt += 0.5>>
						<<if $wraith.hunt gte ($rng / 10)>>
							<<set $eventforced to true>>
						<</if>>
					<</if>>
				<</if>>
			<<case "lake">>
				이명이 울리고 누군가 쳐다보는 듯한 느낌이 든다. 본능적으로 뒤를 돌아본다.
				<br><br>
				<<if $bus is "lakeshore" or $bus is "lakeshallows" or $bus is "lakedepths">>
					호수 중앙에 창백하고 아름다운 형상이 떠 있다. 긴 은발이 바람에 휘날리는 것이 보인다. 보는 순간 그것은 사라진다. <<stress 6>><<gstress>>
					<br><br>
				<<elseif $location is "lake_ruin">>
					물속에 창백하고 아름다운 형상이 떠 있다. 수류에 긴 은발이 이리저리 흩날린다. 보는 순간 그것은 사라진다. <<stress 6>><<gstress>>
					<br><br>
				<<else>>
					아주 잠시, 나무들 사이에서 창백한 얼굴 형상을 본 듯한 기분이 든다. <<stress 6>><<gstress>>
					<br><br>
				<</if>>
				<span class="red">당신은 침입했다. 무언가가 당신을 사냥하고 있다.</span>
				<<set $forestHunter to "Ivory Wraith">>
				<<set $wraith.hunt to 1>>
				<<set $foresthunt to $wraith.hunt>>
				<br><br>
				<<set $eventskip to 1>>
				<<if $location is "lake_ruin">>
					<<destinationlakeruin>>
				<<else>>
					<<if Weather.isSnow and ($bus is "lakeshallows" or $bus is "lakedepths")>>
						<<destination_lake_ice>>
					<<else>>
						<<destinationlake>>
					<</if>>
				<</if>>
		<</switch>>
	<</if>>
<</widget>>

<<widget "wPersist">>
	<<if $wraith.state and !$possessed>>
		<<if $wraith.hunt and npcCanHunt("Ivory Wraith")>>
			<<if _args[0] is "forest">>
				<<if $foresthunt gte 1>>
					<<set $wraith.hunt to $foresthunt>>
					<<set $forestHunter to "Ivory Wraith">>
					<<if !$wPersist>>
						<<set $wPersist to 1>>
					<</if>>
				<<else>>
					<<set $foresthunt to $wraith.hunt>><<set $forestHunter to "Ivory Wraith">>
					숲속으로 들어섰지만, <span class="red">여전히 무언가가 당신을 쫓아오고 있다는 불길한 느낌을 지울 수 없다.</span>
				<</if>>
				<<if ($location is "lake" or $location is "lake_ruin") and !$possessed>>
					<<set $wraith.hunt += 1.5>>
					<<set $foresthunt += 1.5>>
					<<if $moonstate is "morning" and Time.hour gte 6 and Time.hour lte 20>>
						태양이 떠오르자, 안도감이 밀려온다. 공포가 가신다. <span class="blue"><i>다음 붉은 달이 뜰 때까지는 안전하다.</i></span>
						<<clearWraith>>
						<br><br>
					<<else>>
						<<rng 60>>
						<<if $rng lte 20>>
						<span class="red">당신은 사냥당하고 있다. 붉은 달빛이 수면에 반사된다.</span> <<stress 6>><<gstress>>
						<br><br>
						<<elseif $rng lte 40>>
						<span class="red">당신은 사냥당하고 있다. 멀리서 웃음소리가 들린다.</span> <<trauma 6>><<gtrauma>>
						<br><br>
						<<else>>
						<span class="red">당신은 사냥당하고 있다. 사방에서 짓누르는 듯한 압박감이 느껴진다.</span> <<stress 6>><<gstress>><<trauma 6>><<gtrauma>>
						<br><br>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<<elseif npcCanHunt("Ivory Wraith") and !$possessed>>
			<<wTimerProgress>>
		<</if>>
	<</if>>
<</widget>>

<<widget "wTimerProgress">>
	<<if $wraith.state and $wraith.hunt is 0 and Time.isBloodMoon()>>
		<<set $wraith.timer++>>
		<<set $wraith.timer += Math.floor(C.npc["Ivory Wraith"].lust / 10)>>
		<<if $rng gte 61 and numberOfEarSlime()>>
			귀 안의 슬라임이 평소와 다른 소리를 내는 것이 들린다, <span class="red">마치 무언가를 부르는 듯한 소리다.</span>
			<<set $wraith.timer++>>
		<</if>>
	<</if>>
<</widget>>

<<widget "exitWraith">>
	<<switch $wraith.exit>>
		<<case "home">>
			<<link [[다음|Bedroom]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "sleep">>
			<<set $wardrobe_location to "wardrobe">>
			<<wardrobeSelection true>>
			<<radiooutfits>>
			<br><br>
			<<link [[다음|Bedroom]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "cabin">>
			<<link [[다음|Eden Cabin]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "alex_cottage">>
			<<link [[다음|Farm Cottage]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "tower">>
			<<link [[다음|Bird Tower]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "town">>
			<<destinationeventend>>
			<<endevent>><<if _args[0]>><<set $phase2 to 1>><</if>>
		<<case "forest">>
			<<link [[다음|Forest]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "Gwylan">>
			<<link [[...|Forest Wraith Gwylan]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "forest_shop">>
			<<link [[다음|Forest]]>><<endevent>><<set $eventskip to 1>><<set $forest to 0>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "lake_ruin">>
			<<destinationlakeruin>>
			<<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>>
		<<case "lake">>
			<<if Weather.isSnow and ($bus is "lakedepths" or $bus is "lakeshallows")>>
				<<destination_lake_ice>>
			<<else>>
				<<destinationlake>>
			<</if>>
			<<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>>
		<<case "wolf_cave">>
			<<link [[다음|Wolf Cave]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "moor">>
			<<link [[다음|Moor]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "farm_assault">>
			<<link [[다음|Farm Assault]]>><<endevent>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "sewers">>
			<<destinationsewers>>
			<<endevent>><<set $eventskip to 1>>
		<<case "pirates">>
			<<link [[다음|Pirate Deck]]>><<endevent>><<set $eventskip to 1>><<if _args[0]>><<set $phase2 to 1>><</if>><</link>>
			<br>
		<<case "mansion">>
			<<link [[다음|Mansion Bedroom]]>><<endevent>><<set $eventskip to 1>><</link>>
			<br>
		<<default>>
			<span class="red">뭔가 잘못되었습니다. 원혼의 코드 오류로 인해 당신을 둘 곳이 없습니다. PurityGuy에게 알려주세요.</span>
			<br><br>
			오류 발생 이벤트: $passage | 위치: $location ($bus) | 출구: $wraith.exit
			<br><br>
			<<endWraith>>
			<<clearWraith>>
			<<link [[침실로 가는 포탈|Bedroom]]>><<endevent>><<set $eventskip to 1>><<hallucinogen 180>><</link>><<gghallucinogens>>
			<br>
	<</switch>>
	<<if !_args[0]>>
		<<endWraith>>
	<</if>>
<</widget>>

<<widget "rngWraith">>
	<<if $wraith.state>>
		<<if _args[1] is "night" and Time.dayState isnot "night" or _args[1] is "noBlood" and Time.isBloodMoon()>>
			<<set _wraithEvent to false>>
		<<else>>
			<<set _rngWraith to 2 + (Math.floor(C.npc["Ivory Wraith"].lust / 10))>>
			<<if Time.dayState is "night">>
				<<set _rngWraith += 2>>
			<</if>>
			<<set _wraithHallucinations to (_args[0] is 1 or _args[0] is 2 ? _args[0] : 0)>>
			<<if ($hallucinations gte _wraithHallucinations and _rngWraith gte random(1,100)) or Time.isBloodMoon()>>
				<<set _wraithEvent to true>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "rngWraithSocial">>
	<<if !_rngWraithSocialCheck>>
		<<set _rngWraithSocialCheck to true>>
		<<set _rngWraithFace to ($wraith.type ? Math.ceil(Math.random() * 10) : Math.ceil(Math.random() * 30))>>
		<<set _rngWraithLineChance to Math.ceil(Math.random() * 15)>>
		<<set _rngWraithSocial to 2 + (Math.floor(C.npc["Ivory Wraith"].lust / 10))>>
		<<if Time.dayState is "night">>
			<<set _rngWraithSocial += 2>>
		<</if>>
		<<if ($hallucinations gte 1 and _rngWraithSocial gte Math.ceil(Math.random() * 100)) or Time.isBloodMoon()>>
			<<set _wraithEventSocial to true>>
		<</if>>
		<<if $wraith.mimic isnot "" and $wraith.revealed>>
			<<set _wraithTitle to "pretender">>
		<<else>>
			<<switch $wraith.gen>>
				<<case "tentacles">><<set _wraithTitle to "writhing">>
				<<case "abomination">><<set _wraithTitle to "profane">>
				<<case "arms">><<set _wraithTitle to "vain">>
				<<default>><<set _wraithTitle to (["haunt", "despair"].includes($wraith.state) ? "forlorn" : "reflection")>>
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "wraithEventStreet">>
	<<set $wraith.exit to "town">>
	<<if $wraith.hunt gte 10>>
		<<if !$wraithIntro>>
			<<wraithIntro>>
		<<else>>
			<<wraithCaught>>
		<</if>>
	<<else>>
		<<cleareventpool>>
		<<if $wraith.hunt gte 5>>
			<<if !$wraithIntro>>
				<<addevent "wraithIntro" 0.1>>
			<<else>>
				<<addinlineevent "wraithClose1" 0.1>>
				걸음을 옮길수록, 발걸음이 가벼워진다. 당신은 숨을 쉬기 힘들어하고<<if $exposed lte 0>>, 옷이 무겁게 느껴진다<</if>>. <<rainWraith true>>
				<br><br>
				귀가 울리기 시작하며, <<print window.KR.getWeatherKr(Weather.precipitation)>> 속에서 무언가 형체를 갖추는 것을 본다.
				바람에 흩날리는 반투명한 흰옷을 입은, 아름답고 창백한 인물이 땅 위로 살짝 떠 있다. 그것이 당신을 보자 눈에서 밝은 <<wraithEyes "noun">>【이가】 번쩍인다. 당신의 마음은 대기 중과 그것의 눈동자 너머에서 형태들이 춤추는 것을 보며 흐릿해지는 것을 느낀다.
				<br><br>
				당신이 시선을 피하기도 전에, 그것은 두 손으로 최면을 거는 듯한 몸짓을 한다.
				<<if $wraith.state is "haunt">>
					그러고는 한 손을 목으로 가져가, 거기에 없는 무언가를 잡으려는 듯 움켜쥔다.
					<br><br>
					"<span class="wraith">도둑. 넌 영원히 자유롭지 못할 것이다.</span>"
					<br><br>
					<<if numberOfEarSlime()>>
						<span class="lewd">당신의 머릿속에 있는 슬라임이</span> <span class="red">그것을 돌려주라고 명령하는 것을 느낀다.</span>
						<br><br>
					<</if>>
				<<elseif $wraith.state is "despair">>
					그러고는 한 손을 목으로 가져가, 거기에 없는 무언가를 잡으려는 듯 움켜쥔다.
					<br><br>
					"<span class="wraith">너무 차가워. 넌 너무 따뜻해.</span>"
					<br><br>
					<<if numberOfEarSlime()>>
						<span class="lewd">당신의 머릿속에 있는 슬라임이 당신에게</span> <span class="red">무릎을 꿇으라고 명령하는 것을 느낀다.</span>
						<br><br>
					<</if>>
				<<else>>
					그것은 한 손을 가슴으로 가져가 상아 목걸이를 문지른다. 박혀 있는 푸른 보석의 번뜩임이 빛나는 눈동자와 일치한다.
					<br><br>
					"<span class="wraith">무릎 꿇어.</span>"
					<br><br>
					<<if numberOfEarSlime()>>
						<span class="lewd">당신의 머릿속에 있는 슬라임이 무릎을 꿇으라고 명령하는 것을 느낀다.</span>
						<br><br>
					<</if>>
				<</if>>
				<<link [[굴복한다|Wraith Caught Obey]]>><<if numberOfEarSlime()>><<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><</if>><<sub 1>><</link>><<if numberOfEarSlime()>><<gcorruption>><<lpain>><<lltrauma>><<lstress>><</if>>
				<br>
				<<link [[고개를 돌리려 애쓴다|Wraith Caught Resist]]>><<if numberOfEarSlime()>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><</if>><<def 1>><</link>><<if numberOfEarSlime()>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>><</if>><<willpowerdifficulty 1 $willpowermax>>
				<br>
				<</addinlineevent>>
				<<addinlineevent "wraithClose2" 0.1>>
					무언가가 귓가에 당신의 이름을 직접 속삭인다. 당신은 허우적거리며 옆으로 물러나지만, 그곳에는 아무것도 없다.
					<<if $loveInterest.primary isnot "None" and $loveInterest.primary isnot "Black Wolf" and $loveInterest.primary isnot "Great Hawk">>
						그 소리가 <<= window.KR.gatPersonNameDictKR($loveInterest.primary)>>【와과】 비슷하다고 생각한다. <<if $wraith.seen gte 5>>하지만 당신은 그게 아니라는 것을 더 잘 알고 있다.<</if>>
					<</if>>
					<br><br>
					뒤를 돌아봤을 때 당신의 피가 차갑게 얼어붙는다. 창백한 형체가 <<if $location is "park">>분수대 위에 떠 있<<else>>거리의 끝에 서 있<</if>>다. <<rainWraith>>
					<br><br>
					<<link [[도망친다|Wraith Run]]>><</link>><<athleticsdifficulty 800 1500>>
					<br>
					<<link [[숨는다 (0:10)|Wraith Hide]]>><<pass 10>><</link>>
					<br>
				<</addinlineevent>>
				<<addinlineevent "wraithClose3" 0.1>>
					<<if $settings.tentaclesEnabled>>
						당신의 시야 한구석에 흐릿한 하얀색이 보이며, 무언가가 허벅지를 건드리는 것을 느낀다. 당신이 밑을 내려다보자, 열린 맨홀에서 하얀 촉수가 뻗어 나오고 있는 것이 보인다. <span class="red">당신을 사냥하는 무언가가 가까워지고 있음을 느낀다.</span>
						<br><br>
						<<if !pcAreArmsBound("both") and $angel gte 4 and $angelBanish gte 1>>
							<<link [[촉수를 추방한다|Wraith Tentacle Banish]]>><<angelBanishUse>><</link>><<angelBanishNote>>
							<br>
						<</if>>
						<<link [[촉수를 잡는다|Wraith Tentacle Grab]]>><</link>><<physiquedifficulty 6000 15000>><<deviant1>>
						<br>
						<<if hasSexStat("deviancy", 5)>>
							<<link [[자신을 바친다|Wraith Tentacle Rape]]>><<set $molestationstart to 1>><</link>><<deviant5>>
							<br>
						<</if>>
						<<link [[도망치려 한다|Wraith Tentacle Run]]>><<stress 3>><<trauma 3>><</link>><<gtrauma>><<gstress>>
						<br>
					<<else>>
						당신의 시야 한구석에 흐릿한 하얀색이 보이며, 무언가가 발목을 잡는 것을 느낀다. 당신은 즉시 뒤로 뛰려 하지만, 그립이 강해지며 넘어지고 만다. <<pain 2>><<gpain>>
						<br><br>
						당신이 밑을 내려다보자, 빗물받이로 후퇴하는 창백한 손이 보인다. <<stress 6>><<gstress>>
						<br><br>
						당신은 서둘러 일어나서 계속 움직인다.
						<br><br>
						<<set $wraith.hunt++>>
						<<destinationeventend>>
					<</if>>
				<</addinlineevent>>
				<<addinlineevent "wraithClose4" 0.2>>
					주변의 모든 것이 붉은 빛에 잠겨 있다. 걸어가며 주위에 다른 사람이 전혀 없는 것처럼 느껴지는 긴 시간을 인지한다.
					<br><br>
					이것이 잠깐의 휴식인지, 아니면 더 끔찍한 무언가의 징조인지 당신은 확신하지 못한다.
					<br><br>
					<<destinationeventend>>
				<</addinlineevent>>
				<<addinlineevent "wraithClose5" 0.1>>
					아래에서 맹렬한 우르릉 소리가 들려온다. 그 소리는 하수도에서 오는 것 같다. 열린 맨홀에서 거대한 물기둥이 하늘 높이 솟구쳐 오르는 것이 보인다.
					<br><br>
					우르릉거리는 소리가 더 무거워진다. 당신과 훨씬 가까운 배수구 창살에서 물이 분출한다. 당신이 아래를 내려다보자, 자신이 바로 창살 위에 서 있다는 것을 깨닫는다.
					<br><br>
					<<if (currentSkillValue('danceskill') + $rng) gte 800>>
						민첩성 덕분에 당신은 또 다른 물기둥이 솟구쳐 오르자 <span class="green">반사적으로 방향을 틀어 피한다.</span>
					<<else>>
						피하려 애쓰지만, <span class="red">너무 늦었다.</span> 아래에서 솟구치는 물기둥에 완전히 젖는다.
						<<water>><<effectswater "water">><<exposure>><<covered>>
					<</if>>
					<br><br>
					당신의 한참 뒤에 있는 또 다른 맨홀에서 마지막 물줄기가 솟아오른다. 정점에 유령 같은 창백한 형체가 반투명한 물의 촉수로 둘러싸인 채 서 있는 것이 보인다. <<stress 12>><<ggstress>>
					<br><br>
					당신은 반대 방향으로 달려간다.
					<<set $wraith.hunt++>>
					<br><br>
					<<exitWraith>>
				<</addinlineevent>>
			<</if>>
		<</if>>
		<<addinlineevent "wraith1" 0.2>>
			시야의 구석으로, 창백한 얼굴이 당신을 주시하고 있는 것을 언뜻 본다.
			<<if $location is "park">>
				나무 뒤에서.
			<<else>>
				높은 창문에서.
			<</if>>
			당신이 눈을 깜박이자, 사라졌다. <<stress 6>><<gstress>>
			<br><br>
			<<destinationeventend>>
		<</addinlineevent>>
		<<addinlineevent "wraith2" 0.1>>
			누군가 당신의 이름을 부른 것 같다. 주위에는 아무도 보이지 않는다. <<stress 6>><<gstress>>
			<br><br>
			<<destinationeventend>>
		<</addinlineevent>>
		<<addinlineevent "wraith3" 0.1>>
			<<generate1>><<person1>><<person>>【이가】 당신을 거의 넘어뜨릴 뻔하며 옆을 스쳐 지나간다. <<Hes>> 두 발로 겨우 버티고 서 있는 상태고, 계속 겁에 질린 눈으로 당신을 돌아본다.
			<br><br>
			당신은 <<he>>【은는】 당신의 뒤쪽을 바라보고 있다는 것을 깨닫는다. 당신은 돌아보지만, 그곳엔 아무것도 없다.
			<<if $location is "park">>
				텅 빈 공원만.
			<<else>>
				텅 빈 거리만.
			<</if>>
			<br><br>
			<<endevent>>
			<<destinationeventend>>
		<</addinlineevent>>
		<<addinlineevent "wraith4" 0.2>>
			먼 창문과 주차된 차들에 붉은 달빛이 반사된다. 으스스한 분위기 속에서도, 상당히 아름답다는 사실은 부정할 수 없다. <<stress -3>><<lstress>>
			<br><br>
			<<destinationeventend>>
		<</addinlineevent>>
		<<addinlineevent "wraith5" 0.1>>
			당신이 창살을 지나갈 때, 아래에서 희미하게 우르릉거리는 소리가 들린다. 더 오래 귀 기울일수록 소리가 커진다.
			<br><br>
			당신은 지체하지 않기로 결심한다.
			<br><br>
			<<destinationeventend>>
		<</addinlineevent>>
		<<addinlineevent "wraithEventSkip" 0.3>>
			<<set _wraithEventSkipped to true>>
			<<eventsstreet>>
		<</addinlineevent>>
		<<runeventpool>>
	<</if>>
<</widget>>

<<widget "wraithEventSewers">>
	<<set $wraith.exit to "sewers">>
	<<if $wraith.hunt gte 10>>
		<<if !$wraithIntro>>
			<<wraithIntro>>
		<<else>>
			<<wraithCaught>>
		<</if>>
	<<else>>
		<<cleareventpool>>
		<<if $wraith.hunt gte 5>>
			<<if !$wraithIntro>>
				<<addevent "wraithIntro" 0.1>>
			<<else>>
				<<addinlineevent "wraithClose1" 0.1>>
					걷다 보니 당신의 발걸음이 가벼워진다. 호흡하기가 어려워지며<<if $exposed lte 0>>, 옷이 무겁게 느껴진다<</if>>. <<rainWraith true>>
					<br><br>
					귀가 울리기 시작하고, 안개 속에서 무언가가 형체를 갖추는 것이 보인다.
					아름답고 창백한 형상이 바람에 휘날리는 반투명한 흰색 로브를 입은 채 땅 위로 살짝 떠 있다. 그것이 당신을 보자 두 눈이 밝고 <<wraithEyes "adv">> 번뜩인다. 공기 중과 그 눈동자 뒤로 일렁이는 형상들을 바라보자 정신이 혼미해진다.
					<br><br>
					당신이 시선을 돌리기도 전에, 그것이 손으로 최면을 걸 듯한 동작을 취한다.
					<<if $wraith.state is "haunt">>
						이내 목으로 손을 가져가더니, 보이지 않는 무언가를 잡으려는 듯 손을 꽉 쥔다.
						<br><br>
						"<span class="wraith">도둑. 넌 다신 자유로워지지 못할 거다.</span>"
						<br><br>
						<<if numberOfEarSlime()>>
							<span class="lewd">머릿속의 슬라임이</span> <span class="red">그것을 돌려주라고 당신에게 명령하는 것이 느껴진다.</span>
							<br><br>
						<</if>>
					<<elseif $wraith.state is "despair">>
						그것이 목으로 손을 가져가더니, 보이지 않는 무언가를 잡으려는 듯 손을 꽉 쥔다.
						<br><br>
						"<span class="wraith">이곳은 너무 차갑고, 넌 너무나 따스하구나.</span>"
						<br><br>
						<<if numberOfEarSlime()>>
							<span class="lewd">머릿속의 슬라임이 당신에게</span> <span class="red">무릎을 꿇으라고 명령하는 것이 느껴진다.</span>
							<br><br>
						<</if>>
					<<else>>
						그것이 손을 가슴으로 가져가, 상아 목걸이를 문지른다. 거기에 박힌 푸른 보석들의 반짝임이 빛나는 눈동자와 잘 어울린다.
						<br><br>
						"<span class="wraith">꿇어라.</span>"
						<br><br>
						<<if numberOfEarSlime()>>
							<span class="lewd">머릿속의 슬라임이 당신에게 무릎을 꿇으라고 명령하는 것이 느껴진다.</span>
							<br><br>
						<</if>>
					<</if>>
					<<link [[굴복한다|Wraith Caught Obey]]>><<if numberOfEarSlime()>><<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><</if>><<sub 1>><</link>><<if numberOfEarSlime()>><<gcorruption>><<lpain>><<lltrauma>><<lstress>><</if>>
					<br>
					<<link [[시선을 피하려 시도한다|Wraith Caught Resist]]>><<if numberOfEarSlime()>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><</if>><<def 1>><</link>><<if numberOfEarSlime()>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>><</if>><<willpowerdifficulty 1 $willpowermax>>
					<br>
				<</addinlineevent>>
				<<addinlineevent "wraithClose2" 0.1>>
					<<if $settings.tentaclesEnabled>>
						곁눈질로 하얀 무언가가 스쳐 지나는 것이 보이더니, 당신의 허벅지에 뭔가가 닿는 것이 느껴진다. 밑을 내려다보자 창백한 촉수가 수로에서부터 뻗어나와 있다. <span class="red">당신을 사냥하는 그 무언가가 다가오는 것이 느껴진다.</span>
						<br><br>
						<<if !pcAreArmsBound("both") and $angel gte 4 and $angelBanish gte 1>>
							<<link [[촉수를 쫓아낸다|Wraith Tentacle Banish]]>><<angelBanishUse>><</link>><<angelBanishNote>>
							<br>
						<</if>>
						<<link [[촉수를 붙잡는다|Wraith Tentacle Grab]]>><</link>><<physiquedifficulty 6000 15000>><<deviant1>>
						<br>
						<<if hasSexStat("deviancy", 5)>>
							<<link [[자신을 바친다|Wraith Tentacle Rape]]>><<set $molestationstart to 1>><</link>><<deviant5>>
							<br>
						<</if>>
						<<link [[도망치려 한다|Wraith Tentacle Run]]>><<stress 3>><<trauma 3>><</link>><<gtrauma>><<gstress>>
						<br>
					<<else>>
						곁눈질로 하얀 무언가가 스쳐 지나는 것이 보이더니, 뭔가가 당신의 발목을 움켜쥐는 것이 느껴진다. 즉시 뒤로 물러서려 했지만, 그것이 악력을 높이는 바람에 당신은 넘어진다. <<pain 2>><<gpain>>
						<br><br>
						밑을 내려다보자 창백한 손 하나가 하수도 구멍 안으로 물러나고 있다. <<stress 6>><<gstress>>
						<br><br>
						당신은 비틀거리며 일어나 계속 걷는다.
						<br><br>
						<<set $wraith.hunt++>>
						<<destinationsewers>>
					<</if>>
				<</addinlineevent>>
				<<addinlineevent "wraithClose3" 0.1>>
					천장이 번들거리는 것이 눈에 띈다.
					<<if $settings.slimesEnabled>>
						끈적끈적한 액체가 철썩하고 바닥에 떨어진다. 희고 미끌거리는 두꺼운 점액이다. 그것이 당신을 향해 기어오고, 안개 속에서 더 많은 것들이 나타난다.
						<br><br>
						<<link [[다음|Wraith Sewers Struggle]]>><<set $struggle_start to 1>><</link>>
					<<else>>
						창백한 슬라임 하나가 철썩하고 바닥에 떨어지려는 찰나, 옆으로 비켜선다. 그것이 뒤쫓아오기 전에 당신은 뛰지만, 사냥꾼이 더 다가온 것 같은 느낌이 든다. <<stress 6>><<gstress>>
						<br><br>
						<<set $wraith.hunt++>>
						<<destinationsewers>>
					<</if>>
				<</addinlineevent>>
			<</if>>
		<</if>>
		<<addinlineevent "wraith1" 0.2>>
			곁눈질로, 어둠 속에서 창백한 얼굴 하나가 당신을 지켜보고 있는 것을 힐끗 본다. 눈을 깜빡이자, 그 얼굴은 사라졌다. <<stress 6>><<gstress>>
			<br><br>
			<<destinationsewers>>
		<</addinlineevent>>
		<<addinlineevent "wraith2" 0.1>>
			누군가가 당신의 이름을 부르는 소리를 들은 것 같다. 주변을 둘러봐도 아무도 보이지 않는다. <<stress 6>><<gstress>>
			<br><br>
			<<destinationsewers>>
		<</addinlineevent>>
		<<addinlineevent "wraith3" 0.1>>
			강물이 부자연스럽게 요동치더니 당신에게 달려든다. 뒤로 펄쩍 뛰지만 물은 공중에서 멈춘다. 변덕이라도 부린 양, 강물은 천천히 수로 안으로 물러난다. <<stress 6>><<gstress>>
			<br><br>
			<<destinationsewers>>
		<</addinlineevent>>
		<<addinlineevent "wraithEventSkip" 0.1>>
			<<set _wraithEventSkipped to true>>
			<<eventssewers>>
		<</addinlineevent>>
		<<runeventpool>>
	<</if>>
<</widget>>

<<widget "wraithIntro">>
	<<set $wraithIntro to true>>
	걷다 보니, 발걸음이 점점 더 가벼워진다. 숨쉬기가 어려워지고<<if $exposed lte 0>>, 옷이 무겁게 느껴진다<</if>>.
	<br><br>
	<<if $location is "forest" or $location is "lake">>
		당신은 나무에 기대어 몸을 가누며 헐떡인다. 주위를 둘러보니 모든 것이 고요해졌음을 깨닫는다.
		<<switch Weather.precipitation>>
			<<case "snow">>
				눈이 내리며 차가운 바람이 동반된다. 뒤를 돌아보니 이미 발자국이 지워져 있다. 당신은 방향 감각을 완전히 잃었다.
			<<case "rain">>
				오직 빗소리만이 정적을 깬다.
			<<default>>
				<<if Weather.isSnow>>
					눈이 고요히 내린다. 하지만 언제부터 눈이 내리기 시작했는지 기억나지 않는다. <<rainWraith>>
				<<else>>
					오직 빗소리만이 정적을 깬다. 하지만 언제부터 비가 내리기 시작했는지 기억나지 않는다. <<rainWraith>>
				<</if>>
		<</switch>>
		귀에서 이명이 들리기 시작한다.
		<br><br>
		<<print window.KR.getWeatherKr(Weather.precipitation)>> 속에서 사람의 형상이 나타나기 시작하고, 당신의 맥박이 빨라진다.
	<<elseif $location is "sewers">>
		<<rainWraith>>
		주변 공기가 차가워진다. 피부에 <<print window.KR.getWeatherKr(Weather.precipitation)>>【이가】 닿는 것이 분명히 느껴지지만, 하수도에 <<print window.KR.getWeatherKr(Weather.precipitation)>> 같은 건 있을 리 없다. 그저 빠르게 짙어지는 안개만이 있을 뿐이다.
		<br><br>
		귀에서 이명이 들리기 시작한다. 안개 속에서 어떤 형상이 나타나기 시작하고, 맥박이 빨라진다.
	<<else>>
		주위를 둘러본다. 이 주변에는 사람이 완전히 사라져 있다. 당신은 잠시 진정할 시간을 갖는다. 로브를 입은 형상의 이미지가 머릿속에서 천천히 흐려진다. <<rainWraith true>>
		<br><br>
		귀에서 이명이 들리기 시작한다. <<print window.KR.getWeatherKr(Weather.precipitation)>> 속에서 형상이 나타나기 시작하고, 맥박이 빨라진다.
	<</if>>
	뒤돌아 도망치려 하지만 다리가 움직이지 않고, 시선을 뗄 수조차 없다.
	아름답고 창백한 형상이 바람에 휘날리는 반투명한 흰색 로브를 입은 채 땅 위를 살짝 떠다닌다. 당신을 보자 그것의 두 눈이 밝은 <<wraithEyes>> 빛으로 번쩍인다.
	<<if $wraith.state is "haunt">>
		그것은 흉터가 있는 목으로 손을 가져가며, 마치 그곳에 없는 무언가를 쥐려는 듯한 행동을 취한다.
		<br><br>
		"<span class="wraith">도둑. 돌려달라. 그러지 않으면 <<if Weather.precipitation is "snow">>이 눈보라가 널 얼려버릴 것이다<<else>>이 폭우가 널 익사시킬 것이다<</if>>.</span>"
		<br><br>
		<<if numberOfEarSlime()>>
			<span class="lewd">머릿속의 슬라임이 당신에게 명령하는 것이 느껴진다.</span> <span class="red">돌려줘라.</span>
			<br><br>
		<</if>>
	<<elseif $wraith.state is "despair">>
		그런 다음 그것은 목으로 손을 가져가며, 마치 그곳에 없는 무언가를 쥐려는 듯한 행동을 취한다. 그 손이 꽉 쥐어진다.
		<br><br>
		"<span class="wraith">내... 내 목걸이 못 봤어?</span>"
		<br><br>
		<<if numberOfEarSlime()>>
			<span class="lewd">머릿속의 슬라임이 당신에게 명령하는 것이 느껴진다.</span> <span class="red">무릎 꿇어라.</span>
			<br><br>
		<</if>>
	<<else>>
		그것은 가슴에 손을 얹고 상아 목걸이를 문지른다. 박혀 있는 푸른 보석의 반짝임이 그 빛나는 눈과 일치한다.
		<br><br>
		"<span class="wraith">불쌍하고, 외로운 영혼이여. 오라. 내가 우리를 아름답게 만들어주마.</span>"
		<br><br>
		<<if numberOfEarSlime()>>
			<span class="lewd">머릿속의 슬라임이 당신에게 무릎을 꿇으라고 명령하는 것이 느껴진다.</span>
			<br><br>
		<</if>>
	<</if>>
	<<link [[굴복한다|Wraith Caught Obey]]>><<if numberOfEarSlime()>><<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><</if>><<sub 1>><</link>><<if numberOfEarSlime()>><<gcorruption>><<lpain>><<lltrauma>><<lstress>><</if>>
	<br>
	<<link [[시선을 피하려 한다|Wraith Caught Resist]]>><<if numberOfEarSlime()>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><</if>><<def 1>><</link>><<if numberOfEarSlime()>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>><</if>><<willpowerdifficulty 250 $willpowermax>>
	<br>
	<<if $angel gte 6>>
		<<link [[기도한다|Wraith Intro Pray]]>><</link>><<angel>>
		<br>
	<</if>>
<</widget>>

<<widget "wraithCaught">>
	<<rainWraith>>
	<<if $passage is "Lake Meditate">>
		당신의 팔이<<if $exposed lte 0>> 옷가지와 함께<</if>> 무거워지며, 허공에 뜬 듯한 기분이 든다.
		<br><br>
		뒤를 돌아보는 순간, 무언가가 당신의 목을 난폭하게 틀어쥐고 단숨에 허공으로 들어 올리는 것이 느껴진다.
		<br><br>
		<<if $wraithIntro>>
			창백한 인영이 당신 앞에 서 있다.
			<<if $wraith.state is "haunt">>
				그것은 제 목을 손으로 틀어쥔 채, 당신을 향해 이빨을 드러낸다.
				<br><br>
				"<span class="wraith">익사해.</span>"
			<<elseif $wraith.state is "despair">>
				그것은 제 목을 손으로 틀어쥔 채, 당신을 노려본다.
				<br><br>
				"<span class="wraith">어딨지? 너무 추워.</span>"
			<<else>>
				녀석의 목걸이가 붉은 달빛 아래에서도 푸르게 반짝인다.
				<br><br>
				"<span class="wraith">넌 내 거야.</span>"
			<</if>>
		<<else>>
			<<set $wraithIntro to true>>
			아름답고 창백한 형상이 당신 앞에 서 있다. 녀석은 당신을 훑어보더니 당신을 가까이 끌어당긴다. 눈을 떼기 힘들다.
			<br><br>
			<<if $wraith.state is "haunt">>
				녀석은 흉터 난 제 목을 꽉 틀어쥐고는 당신을 향해 이빨을 드러낸다.
				<br><br>
				"<span class="wraith">도둑. 돌려줘.</span>"
			<<elseif $wraith.state is "despair">>
				녀석은 제 목을 손으로 틀어쥔 채, 당신을 노려본다.
				<br><br>
				"<span class="wraith">내... 내 목걸이 못 봤어?</span>"
			<<else>>
				녀석의 목걸이가 붉은 달빛 아래에서도 푸르게 반짝인다.
				<br><br>
				"<span class="wraith">저항하지 마. 우리를 아름답게 만들어줄게.</span>"
			<</if>>
		<</if>>
	<<elseif $location is "lake_ruin" or $bus is "lakedepths" or $bus is "lakeshallows">>
		<<if $bus is "lakeshallows" or $bus is "lakedepths">>
			<<set $location to "lake_ruin">>
			<<if Weather.isSnow>>
				당신은 앞으로 비틀거리다가, 발끝에 얼음장처럼 차가운 물이 닿는 것을 느낀다. 얼음이 깨지는 소리는 들리지 않았다.
				<br><br>
				뒤를 돌아보자 얼음에 구멍 하나 없이 쑥 튀어나온 창백한 손이 보인다. <span class="red">그 손이 당신을 끌어당기고, 당신의 몸이 얼음을 그대로 통과하기 시작한다.</span> 붙잡을 곳 하나 없이, 당신은 속수무책으로 물속으로 끌려 들어간다.
			<<else>>
				다리가 당겨지는 것이 느껴진다. 예고도 없이, <span class="red">당신은 수면 아래로 격렬하게 끌려 들어간다.</span>
			<</if>>
			<br><br>
		<<else>>
			당신은 밑으로 쑥 끌려 내려가는 느낌을 받는다. 물속에서 버둥거리지만, 몸이 마음대로 움직이지 않는다. 주위를 둘러보자, 수많은 투명하고 긴 팔다리가 당신을 옥죄고 있다.
			<br><br>
		<</if>>
		<<if $wraithIntro>>
			당신 앞의 물속에 창백한 인영이 떠 있다.
			<<if $wraith.state is "haunt" or $wraith.offspring is "dead">>
				녀석은 제 목을 손으로 틀어쥔 채, 당신을 향해 이빨을 드러낸다.
				<br><br>
				"<span class="wraith">익사해.</span>"
			<<elseif $wraith.state is "despair">>
				녀석은 제 목을 손으로 틀어쥔 채, 당신에게 미소를 짓는다.
				<br><br>
				"<span class="wraith"><<pcPetname "Wraith">>. 돌아왔구나. 내 목걸이 못 봤어?</span>"
			<<else>>
				녀석의 목걸이가 매혹적인 푸른빛으로 반짝이며 사방의 물결에 그 빛을 일렁이게 한다.
				<br><br>
				"<span class="wraith">돌아왔구나.</span>"
			<</if>>
		<<else>>
			<<set $wraithIntro to true>>
			아름답고 창백한 인영이 당신 주위를 맴돈다. 길게 늘어뜨린 은빛 머리카락이 물결을 따라 뒤로 흩날린다. 녀석은 당신을 구석구석 살피는 듯하다.
			<br><br>
			<<if $wraith.state is "haunt">>
				녀석은 맨 목을 긁어대며, 섬뜩할 정도로 붉은 눈으로 당신을 쳐다본다.
				<br><br>
				"<span class="wraith">도둑. 돌아왔구나. 당장 돌려줘.</span>"
			<<elseif $wraith.state is "despair">>
				녀석은 제 목을 손으로 틀어쥔 채, 당신을 노려본다.
				<br><br>
				"<span class="wraith">내... 내 목걸이 못 봤어?</span>"
			<<else>>
				녀석은 당신으로부터 상아의 목걸이를 지키려는 듯, 그 위로 손을 가져다 댄다.
				<br><br>
				"<span class="wraith">침입자. 망자의 물건을 훔치러 왔느냐?</span>"
			<</if>>
		<</if>>
	<<else>>
		갑자기 허리춤까지 차오른 물속을 걷고 있는 듯한 기분이 든다. 팔이<<if $exposed lte 0>> 옷가지와 함께<</if>> 묵직해지고, 발은 더 이상 땅에 닿지 않는 듯하다.
		<br><br>
		뒤를 돌아보는 순간, 무언가가 당신의 목을 난폭하게 틀어쥐고 단숨에 허공으로 들어 올리는 것이 느껴진다. 창백한 형상이 당신 앞에 서 있다.
		<<if ["haunt", "despair"].includes($wraith.state)>>
			녀석은 맨 목에 손을 얹은 채, 강렬하게 빛나는 붉은 눈으로 당신을 쳐다본다.
		<<else>>
			녀석의 은빛 머리카락이 느껴지지 않는 산들바람에 흩날린다. 녀석이 남은 손으로 제 목걸이를 덮어 가린다.
		<</if>>
		<br><br>
		<<if $wraith.state is "haunt" or $wraith.offspring is "dead">>
			"<span class="wraith">익사해.</span>"
		<<elseif $wraith.state is "despair">>
			"<span class="wraith">너무 추워. 어딨지?</span>"
		<<else>>
			"<span class="wraith">넌 내 거야.</span>"
		<</if>>
	<</if>>
	<br><br>
	<<generateWraith 1 true>>
	<<initWraith "abomination">>
	<<if $wraith.gen is "abomination">>
		창백한 촉수들이 당신을 허공에 묶어두고 있다.
	<<else>>
		수많은 투명한 팔들이 녀석의 등 뒤에서 소용돌이친다.
	<</if>>
	<br><br>
	<<link [[다음|Wraith Caught]]>><</link>>
	<br>
<</widget>>

<<widget "wraith_pass">>
	<<if _args[0]>>
		<<pass _args[0]>>
		<<set $wraithPrison.timer -= _args[0]>>
		<<if $wraithPrison.timer lte 0 and $wraithPrison.state isnot "gone">>
			<<set $wraithPrison.state to "present">>
		<<elseif $wraithPrison.state isnot "gone">>
			<<set $wraithPrison.state to "recovering">>
		<</if>>
		<<set $wraithPrison.timePassed += _args[0]>>
		<<hallucinogen `(_args[0] * 3)`>>
		<<set $arousal += (_args[0] * 3)>>
	<</if>>
<</widget>>

<<widget "wraithPossess">>
	<<set $possessed to true>><<canvas-model-override "blink" false>>
	<<set $controlSaved to $control>><<set $control to 0>>
	<<set $wraith.hunt to 0>>
	<<if $forestHunter is "Wraith">>
		<<set $foresthunt to 0>>
	<</if>>

	<<if _args[0]>>
		<<set $wraith.exit to _args[0]>>
	<</if>>
<</widget>>

<<widget "wraithExorcise">>
	<<unset $possessed>><<canvas-model-override "clear">>

	<<if _args[0]>>
		<<if $wraith.possessCount is undefined>>
			<<set $wraith.possessCount to 1>>
		<<else>>
			<<set $wraith.possessCount++>>
		<</if>>
	<</if>>

	<<if _args[1] and $controlSaved isnot undefined>>
		<<set $control to $controlSaved>><<unset $controlSaved>>
	<</if>>
<</widget>>

<<widget "gobsession">>
	<<if !$wraith.init>>
		<span class="red">오류: 원혼이 초기화되지 않았다.</span>
		<br><br>
		문제 이벤트: $passage | 위치: $location ($bus)
	<<else>>
		<<set $_change to (_args[0] ? _args[0] : 1)>>
		<<set C.npc["Ivory Wraith"].lust += $_change>>
		<<if !$settings.blindStatsEnabled and $_change gt 0>> |
			<<if $_change gt 4>>
				<span class="red">+ + + 집착</span>
			<<elseif $_change gt 2>>
				<span class="red">+ + 집착</span>
			<<else>>
				<span class="red">+ 집착</span>
			<</if>>
		<</if>>
	<</if>>
	<<relationshipclamp>>
<</widget>>

<<widget "lobsession">>
	<<if !$wraith.init>>
		<span class="red">오류: 원혼이 초기화되지 않았습니다.</span>
		<br><br>
		문제 발생 이벤트: $passage | 위치: $location ($bus)
	<<else>>
		<<set $_change to (_args[0] ? _args[0] : 1)>>
		<<set C.npc["Ivory Wraith"].lust -= $_change>>
		<<if $wraith.state is "haunt" and C.npc["Ivory Wraith"].lust lt 10>>
			<<set $_change -= (10 - C.npc["Ivory Wraith"].lust)>>
		<</if>>
		<<if !$settings.blindStatsEnabled and $_change gt 0>> |
			<<if $_change gt 4>>
				<span class="blue">- - - 집착</span>
			<<elseif $_change gt 2>>
				<span class="blue">- - 집착</span>
			<<else>>
				<span class="blue">- 집착</span>
			<</if>>
		<</if>>
	<</if>>
	<<relationshipclamp>>
<</widget>>

<<widget "possessedWord">><<set $_colour to _args[1] ? _args[1] : "">><span @class="$possessed ? 'wraith ' + $_colour : '$_colour'"><<print _args[0]>></span><</widget>>
