		<</if>>
<</switch>>
<br>

:: Lake Ruin Prison Rape Finish
<<effects>>
<<if !$wraithCount>>
	<<set $wraithCount to 0>>
<</if>>
<<if !$wraithMax>>
	<<set $wraithCount to 0>>
	<<set $wraithMax to 1>>
	<<if C.npc["Ivory Wraith"].lust gt 10>>
		<<set $wraithMax++>>
	<</if>>
	<<if !$settings.tentaclesEnabled>>
		<<set $wraithMax -->>
	<</if>>
<</if>>
<<if $wraith.type is "man" and $enemyhealth lte 0>>
	<<person>>【은는】 뒷걸음질 치며 충격에 빠져 당신을 내려다본다.
	<<if $wraith.gen is "abomination">>
		촉수들이 생명력을 잃고 땅으로 떨어지더니, 분홍빛 안개로 승화한다.
	<<elseif $wraith.gen is "arms">>
		<<His>> 여분의 팔들이 다시 안으로 접힌다.
	<</if>>
	<<His>> 머리가 젖혀지고, <<he>>【은는】 당신의 마음속에 울려 퍼지는 짧은 비명과 함께 허공으로 사라진다. 귀가 울리고, 사방에서 그 목소리가 들려온다. "<span class="wraith">좋아. 계속 발버둥 쳐라.</span>"
	<br><br>
	<<tearful>> 당신은 <<he>>【이가】 정말로 사라졌는지 확인하려 주위를 둘러본다.
	<<set $wraith.defeated++>>
	<<set $wraithPrison.timer to 120>>
	<<set $wraithPrison.state to "recovering">>
	<<clotheson>>
	<<endcombat>>
	<<endWraith>>
	<br><br>
	<<link [[다음|Lake Ruin Prison]]>><</link>>
	<br>
<<elseif $enemyarousal gte $enemyarousalmax or ($wraith.type is "tentacles" and $tentacles.active lte ($tentacles.max / 2)) or ($wraith.type is "slime" and $struggle.done gte $struggle.number)>>
	<<set $wraithCount++>>
	<<ejacW>>
	<<if $wraithCount gte $wraithMax>>
		<<kissWraith>>
		<br><br>
		<<He>>【은는】 떨어져 나가 바닥으로 다시 가라앉는다. <<His>> 웃음소리가 사방에 울려 퍼진다.
		<br><br>
		<<tearful>> 당신은 다음 공격이 언제 올지 궁금해하며 주위를 둘러본다.
		<<set $wraithPrison.timer to 60>>
		<<set $wraithPrison.state to "recovering">>
		<<clotheson>>
		<<endcombat>>
		<<endWraith>>
		<br><br>
		<<link [[다음|Lake Ruin Prison]]>><</link>>
		<br>
	<<else>>
		<<continueWraith>>
		<br><br>
		<<link [[다음|Lake Ruin Prison Rape]]>><</link>>
		<br>
	<</if>>
<</if>>

:: Lake Ruin Prison Possession Resist
<<effects>>
그것의 의지에 맞서, 할 수 있는 한 힘껏 밀어낸다.
<br><br>
<<if $willpowerSuccess>>
	그것은 밀려나, <span class="green">당신의 몸에서 쫓겨난다.</span>
	<<if $wraith.state is "haunt">>
		그것이 으르렁거리며 당신의 목을 움켜쥔다.
		<br><br>
		"<span class="wraith">아주 좋아. 그렇다면, 거친 방법을 써야겠군.</span>"
	<<elseif $wraith.state is "despair">>
		그것이 눈살을 찌푸리며 당신의 목을 움켜쥔다.
		<br><br>
		"<span class="wraith">우리는 모든 것을 공유할 것이다. 쾌락과 고통을.</span>"
	<<else>>
		그것이 웃으며 당신의 어깨에 손을 얹는다.
		<br><br>
		"<span class="wraith">하지만, 이건 부탁이 아니었다.</span>"
	<</if>>
	<br><br>
	<<initWraith>>
	<<startWraith>>
	<br><br>
	<<link [[다음|Lake Ruin Prison Rape]]>><</link>>
	<br>
<<else>>
	<<set $possessed to true>><<canvas-model-override "blink" false>>
	그것은 잠시 느려지지만, <span class="red">여전히 당신의 몸으로 들어온다.</span> 당신의 사지가 경련하고, 의식이 뒤로 밀려나 덮어씌워지는 것을 느낀다.
	<br><br>
	<<link [[다음|Lake Ruin Prison Possession]]>><</link>>
	<br>
<</if>>

:: Lake Ruin Prison Possession
<<effects>><<set $possessed to true>><<canvas-model-override "blink" false>><<set $wraithPrison.possession to true>>

<<if $phase is 1>>
	그것은 하얀 안개로 흩어지기 시작한다. 당신은 전혀 저항하지 않고, 그것이 당신을 완전히 장악하도록 내버려 둔다. 모든 감각이 사라진다. 사지가 경련하고, 의식이 뒤로 밀려나 덮어씌워지는 것을 느낀다.
	<br>
<</if>>
그것은 당신의 몸을 일으켜 세우고, 우리 창살에 기대게 한다. 당신의 손을 꽉 쥐고 목을 꺾는다. 그것은 미소 짓는다.
<br><br>

"넌 내 거야." 그것이 당신의 목소리로 말한다.
<br><br>

<<if $settings.tentaclesEnabled and $rng gte 26>>
	그것은 벽에 기대앉아 당신의 다리를 벌린다. 창백한 촉수 여러 개가 시야에 들어온다.
	<<if $worn.lower.name isnot "naked">>
