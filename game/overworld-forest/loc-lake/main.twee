	<<else>>
		호수 <<= Weather.isFrozen("lake") ? "얼음" : "수면">> 아래에서 어두운 물이 보이지 않게 일렁인다.
	<</if>>
<<else>>
	모닥불 구덩이를 둘러싸고 돌벤치가 있다.
<</if>>
<<if Weather.isFrozen("lake")>>
	<<= Weather.precipitation is "snow" ? "눈이 아래 얼음 위에 내려앉는다" : "얼음은 고요하다">>.
<<else>>
	수면은 <<= Weather.precipitation is "rain" ? "빗방울에 맞아 요동친다" : "잔잔하다">>.
<</if>>
<br><br>

<<if $exposed gte 1 and ($laketeenspresent is 1 or $laketeensfire is 1)>>
	<<if hasSexStat("exhibitionism", 5)>>
		당신은 몸을 낮추고 나무들 사이에 머무른다. <<lewdness>> 모습을 보여주고 싶어 안달이 났지만, 가까스로 참아낸다.
	<<else>>
