:: Lake Fishing Rock
<<set $outside to 1>><<set $location to "lake">><<effects>><<lakeeffects>>
<<set $forest to 50>><<set $bus to "lakefishingrock">>
<<if $phase is "rockclimb">>
	<<set $phase to 0>>
	당신은 낚시 바위 아래의 기슭으로 헤엄쳐 가 거친 표면 위로 몸을 끌어올린다. 바위 위로 물방울이 뚝뚝 떨어진다.
<<else>>
	당신은 낚시 바위 위에 있다.
<</if>>
<<if $laketeenspresent is 1>>
	<<= Weather.isFrozen("lake") ? "얼어붙은 호수 반대편에 사람들이 보인다" : "호수 반대편에 사람들이 보인다. 물고기들이 곤충을 잡아먹으려고 물 위로 튀어 오른다. 평화롭지만, 근처의 나무들은 불길한 느낌을 준다">>.
<<elseif Time.dayState is "night">>
	어두운 물이 <<= Weather.isFrozen("lake") ? "얼음" : "호수 표면">> 아래에서 보이지 않게 일렁인다.
<<elseif Time.dayState is "dusk" or Time.dayState is "dawn">>
	<<= Weather.isFrozen("lake") ? "희미한 빛 속에서 호수 얼음이 반짝인다" : "물고기들이 튀어 올라 벌레를 잡아먹는다">>. 평화롭지만, 근처의 나무들은 불길한 느낌을 준다.
<<else>>
	여기서 호수 전체가 선명하게 보인다. 물고기들이 <<= Weather.isFrozen("lake") ? "얼음 아래에서" : "물속에서">> 헤엄치는 것이 보인다.
<</if>>
<<if Weather.isFrozen("lake")>>
	<<= Weather.precipitation is "snow" ? "눈이 얼음 위에 내려앉는다" : "얼음은 고요하다">>.
<<if $lake_fishing_ice_broken is undefined and canStartFishing()>>
	<span class="blue">이곳의 얼음은 얇다. 구멍을 뚫으면 낚시를 할 수 있을 것 같다.</span>
<</if>>
<<else>>
	수면은 <<= Weather.precipitation is "rain" ? "빗방울에 맞아 요동친다" : "잔잔하다">>.
<</if>>
<br><br>

<<if $exposed gte 1 and $laketeenspresent is 1>>
	<<if hasSexStat("exhibitionism", 5)>>
		당신은 몸을 낮추고 나무들 사이에 머무른다. 당신의 <<lewdness>> 모습을 보여주고 싶어 안달이 났지만, 간신히 참아낸다.
	<<else>>
		당신은 몸을 낮추고 나무들 사이에 머무르며 당신의 <<lewdness>> 모습이 보이지 않도록 한다.
	<</if>>
	<br><br>
<</if>>

<<if $stress gte $stressmax and !$possessed>>
	<<passoutlake>>
<<elseif $foresthunt gte 10>>
	<<foresthunt>>
<<elseif dangerEvent() and $eventskip is 0 and $laketeenspresent isnot 1>>
	<<eventlake>>
<<else>>
	<<eventlakesafe>>
	<<lakereturnjourney>>
	<<lakeicon "meditate">><<link [[명상하기|Lake Meditate]]>><<set $phase to 1>><</link>>
	<br>
	<<if $nextPassageCheck is "Lake Waterfall">>
		<<lakeicon>><span class="nextLink"><<link [[호수로.|Lake Waterfall]]>><<pass 10>><</link>></span>
	<<else>>
		<<watericon "waterfall">><<link [[북쪽 폭포로 (0:10)|Lake Waterfall]]>><<pass 10>><</link>>
	<</if>>
	<br>
	<<lakeicon "campfire">><<link [[남쪽 캠프장으로 (0:20)|Lake Campsite]]>><<pass 20>><</link>>

	<<if canStartFishing()>>
		<<if !$fishing.locationsFound.includes("fishingForestLake")>>
			<<run V.fishing.locationsFound.pushUnique("fishingForestLake")>>
			<<if !Weather.isFrozen("lake")>>
				<br>
				<span class="gold">낚시하기에 좋은 장소인 것 같다</span>.
			<</if>>
		<</if>>
		<<if !Weather.isFrozen("lake")>>
			<br>
			<<fishingRodIcon>><<link [[낚시한다 (0:05)|Fishing Forest Lake Wait]]>><<set $fishingAmbientOverride to "castOut">><<pass 5>><</link>>
		<<elseif $lake_fishing_ice_broken isnot undefined>>
			<br>
			<<fishingRodIcon>><<link [[낚시한다 (0:05)|Fishing Forest Lake Wait]]>><<set $fishingAmbientOverride to "castOut">><<pass 5>><</link>>
		<<else>>
			<br>
			<<swimicon "break">><<link [[얼음을 깬다 (0:20)|Lake Fishing Rock Ice Break]]>><<pass 20>><<set $lake_fishing_ice_broken to 2>><<tiredness 3>><</link>><<gtiredness>>
		<</if>>
	<<elseif !$fishing.locationsFound.includes("fishingForestLake")>>
		<br>
		<span class="gold">낚싯대가 있다면 여기서 물고기를 잡을 수 있을 것 같다</span>.
		<<run V.fishing.locationsFound.pushUnique("fishingForestLake")>>
	<</if>>
	<br><br>

	<<if $earSlime.forcedCommando isnot undefined and !$worn.under_lower.type.includes("naked") and hasSexStat("exhibitionism", 3) and $hypnosis_traits?.silence isnot 1>>
		<span class="red">귓속 슬라임이 <<underwearTypeText>>【을를】 입은 채 떠나는 것을 허락하지 않습니다.</span>
	<<else>>
		<<foresticon>><<link [[숲 (0:10)|Forest]]>><<pass 10>><</link>>
	<</if>>
	<br>
	<<set $eventskip to 0>>
<</if>>

:: Lake Firepit
<<set $outside to 1>><<set $location to "lake">><<effects>><<lakeeffects>>
<<set $forest to 30>><<set $bus to "lakefirepit">>

모닥불 앞이다.
<<if $laketeenspresent is 1>>
	몇몇 학생들이 원형으로 놓인 돌벤치에 앉아 있다. <<= Weather.isFrozen("lake") ? "다른 사람들은 근처 얼음 위에서 스케이트를 타려고 한다" : "해안 아래쪽에서는 몇몇 사람들이 물장구를 치는 것이 보인다">>.
