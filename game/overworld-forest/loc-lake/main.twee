	<</if>>
	<<eventlakesafe>>
	<<lakereturnjourney>>
	<<link [[남쪽 해안으로 (0:10)|Lake Shore]]>><<pass 10>><</link>>
	<br><br>

	<<if $earSlime.forcedCommando isnot undefined and !$worn.under_lower.type.includes("naked") and hasSexStat("exhibitionism", 3) and $hypnosis_traits?.silence isnot 1>>		<span class="red">귓속 슬라임이 <<underwearTypeText>>【을를】 입은 채 떠나는 것을 허락하지 않습니다.</span>
	<<else>>
