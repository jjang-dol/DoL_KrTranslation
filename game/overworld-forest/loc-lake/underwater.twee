		<<set $antiquemoney += 10>><<museumAntiqueStatus "antiquebox" "found">>
		<br><br>
	<</if>>

	<<if $worn.genitals.name is "naked" and _goldchastity and playerBellySize() lte 7>>
		<<antiqueicon "chastity">><<link [[착용한다|Lake Gold Chastity Belt]]>><<wateraction>><</link>><<loxygen>>
		<br>
	<</if>>
	<<lakeicon "pots">><<link [[항아리 수색하기|Lake Pots]]>><<pass 1>><<tiredness 1>>
	<<if _goldchastity>>
