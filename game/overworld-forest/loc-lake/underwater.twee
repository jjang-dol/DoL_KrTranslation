:: Lake Ruin Box

<<set $outside to 0>><<set $location to "lake_ruin">><<underwater>><<effects>><<lakeeffects>>

<<skulduggerycheck>>
<<skulduggeryuse>>
<<if $skulduggerysuccess is 1>>
	<<set _boxEventWeights to {
		silverRing: 190,
		goldNecklace: 8,
		goldChastity: 2
	}>>
	<<set $lakeRuin.goldChastityAttempts ||= 0>>
	<<set _boxEventMulti to 1 - ($lakeRuin.goldChastityAttempts / (_boxEventWeights.silverRing + _boxEventWeights.goldNecklace))>>
	<<cleareventpool>>
	<<addinlineevent "silver ring" `_boxEventWeights.silverRing * _boxEventMulti`>>
		<<wearProp "antique silver ring">>
		은반지를 발견했다.
		<<set $antiquemoney += 20>><<museumAntiqueStatus "antiquesilverring" "found">>
		<<set $lakeRuin.goldChastityAttempts += 1>>
	<</addinlineevent>>
	<<addinlineevent "gold necklace" `_boxEventWeights.goldNecklace * _boxEventMulti`>>
		<<wearProp "antique gold necklace">>
		<span class="gold">금 목걸이</span>를 발견했다.
		<<set $antiquemoney += 250>><<museumAntiqueStatus "antiquegoldnecklace" "found">>
		<<set $lakeRuin.goldChastityAttempts += 1>>
	<</addinlineevent>>
	<<addinlineevent "gold chastity belt" _boxEventWeights.goldChastity>>
		<<wearProp "antique chastity">>
		<span class="gold">황금 정조대</span>를 발견했다.
		<<set $antiquemoney += 2000>><<museumAntiqueStatus "antiquegoldchastitybelt" "found">>
		<<set $lakeRuin.goldChastityAttempts = 0>>
		<<set _goldchastity to true>> /* Used to remember if the current belt is kept or worn. */
		<<set $lakeRuin.goldchastityfound to true>> /* Increases danger in the lake once a belt is found at least once. */
	<</addinlineevent>>
	<<runeventpool>>
	<br><br>
	<<if $historytrait gte 4>>
