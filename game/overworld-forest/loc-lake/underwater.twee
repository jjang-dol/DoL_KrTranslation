	<</if>>
	<<wateraction>><</link>><<loxygen>>
	<br>
	<<swimicon "up">><<link [[출구 쪽으로 헤엄친다|Lake Ruin]]>>
	<<if _goldchastity>>
		<<set $gold_chastity_held to true>>
	<</if>>
	<<wateraction>><</link>><<loxygen>>
<<else>>
	<<wearProp "antique ivory box">>
	자물쇠를 따는 데 실패한다.
	<br><br>
	<<lockicon "unlock">><<link [[다시 시도한다|Lake Ruin Box]]>><<wateraction>><</link>><<skulduggerydifficulty>><<loxygen>>
	<br>
