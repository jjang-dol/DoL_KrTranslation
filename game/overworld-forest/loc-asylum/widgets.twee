<</widget>>

<<widget "AsylumHypnosisCommon">>
	<<set $phase to _args[0]>>
	<<set _traitValue to _args[1]>>
	<<set $outside to 0>><<set $location to "asylum">><<asylumeffects>><<effects>>
	<<npc Harper>><<person1>>

	당신은 하퍼의 진료실로 들어간다. <<He>>【은는】 책상에 앉아 당신을 기다리고 있다.
	<<if $phase is "Oral">>
		<<generate2>> 건너편에 <<person2>><<person>>【이가】 앉아 있다. 또 다른 환자다. "함께해주어 고맙습니다," 의사가
	<<else>>
		"와주셔서 감사합니다," <<person1>><<he>>【이가】 
	<</if>>
	말한다. "앉으시죠."
	<br><br>

	<<if $phase is "Oral">>
		당신은 <<person2>><<person>> 옆에 앉는다.
	<<else>>
		자리에 앉자,
	<</if>>
	하퍼는 <<person1>><<his>> 책상 위의 펜을 집어 든다. "<<if $phase is "Oral">>두 분 다 <</if>>【이가】 펜에 집중하고, 깊게 숨을 들이마시길 바랍니다. 이 세상엔 이 펜과 제 목소리, 그리고 당신의 숨소리 외엔 아무것도 존재하지 않습니다."
	<br><br>

	<<pass 5>>
	수 분 동안 계속된다. 당신의 정신이 다른 데로 쏠리려 할 때마다, 하퍼는 신기하게도 그것을 눈치채고 당신을 다시 집중하게 한다. 마치 최면 상태에 빠져들듯, 의식 속에서 무언가 변화하는 것이 느껴진다.
	<br><br>

	<<link [[이 느낌이 꽤 좋다 (0:10)|Asylum Hypnosis Trance]]>><<npcincr Harper dom 5>><<control 25>><<trauma -6>><<stress -12>><<awareness -10>><</link>><<ggcontrol>><<llawareness>><<ltrauma>><<lstress>>
	<br>
	<<link [[저항한다|Asylum Hypnosis Trance Resist]]>><</link>><<willpowerdifficulty 1 `300 * (_traitValue || 3)`>>
<</widget>>

<<widget "asylumend">>
	<<set $asylum to 0>>

	<<if $badEndStats.some(badEnd => ["asylumTentacle", "asylumBlackWolf", "asylumTentacleAngel", "asylumEden", "asylumSabotage"].includes(badEnd.reasonEnd))>>
		<<specialClothesUnlock "set" "asylum">>
	<</if>>
<</widget>>

<<widget "asylumpunish">>
	<<endevent>><<npc Harper>><<person1>><<set $asylumbound to 2>>
	"이 <<phim>>【을를】 독방으로 데려가," 하퍼가 말한다. "<<pher>> 팔을 단단히 묶어두고."
	<br><br>

	<<if !pcAreArmsBound("both")>>
		<<asylumBind "punish">>
		그들은 당신의 옷을 찢어발기고 억지로 구속복을 입힌다.
	<</if>>
	그들은 "직원 전용"이라고 적힌 문을 지나, 당신을 정신병원의 텅 빈 동으로 밀어 넣는다. 이곳의 조명 대부분은 고장 났으며, 멀쩡한 것조차 기묘한 리듬으로 깜빡거린다.
	<br><br>

	높다란 금속 문에 다다랐다. 문을 열자 칠흑 같은 암흑뿐인 방이 드러난다. 그들은 당신을 거칠게 밀어 넣고는 쾅 하고 문을 닫는다.
	<br><br>

	방은 몹시 비좁다. 그저 앉아 있을 만한 공간뿐이다. 당신은 완벽한 정적 속에서 기다린다.
	<br><br>

	<<link [[기다린다 (1:00)|Asylum Room]]>><<pass 60>><</link>>
	<br>
<</widget>>

<<widget "asylumoptions">>
	<<if pcAreArmsBound("any") and $asylumbound lte 0>>
		<<He>>【은는】 당신의 결박을 쳐다본다. "풀어줄 때가 된 것 같군요," 몸을 숙인 <<he>>【이가】 매듭을 풀고 그것을 완전히 벗겨내며 말한다.<<unbind>><<exposure>> <<He>>【은는】 환자복으로 당신의 몸을 덮어준다.
		<<unbind>><<upperwear "patient gown">><<exposure>>
		<br><br>
	<<elseif $asylumbound gt 0 and ($worn.upper.name isnot "straightjacket" or $worn.lower.name isnot "straightjacket bottom")>>
		<<if $worn.upper.name is "straightjacket">>
			<<set _nurseJacket to "broken">>
			<<He>>【은는】 미간을 찌푸린 채 당신의 찢어진 구속복을 바라본다. "제대로 된 옷으로 갈아입혀 드리지요," <<he>>【이가】 말한다.
		<<else>>
			<<set _anyclothing to getVisibleClothesList().some(item => item.name !== "naked")>>
			"당신은 아직 구속복을 벗을 단계가 아닙니다," <<he>>【이가】 단호하게 말한다.
		<</if>>

		<<if _nurseJacket is "broken">>
			<<He>>【은는】 당신의 구속복 잔해를 벗겨낸다<<if pcAreArmsBound("both")>>. 그 과정에서 당신의 두 팔이 양옆으로 늘어진다<</if>>.
		<</if>>

		<<asylumBind>>
		<<if _anyclothing and (!_asylumBindUnderwear or _asylumBindUnderwear is "given")>>
			<<He>>【은는】 당신이 가진 모든 개인 소지품을 내놓게 한다.
		<<elseif _asylumBindUnderwear and _asylumBindUnderwear isnot "given">>
			<<He>>【은는】 당신에게 속옷만 남기고 전부 벗게 한다.
			<<if _nurseJacket is "broken">>
				그런 다음 <<he>>【은는】 
			<<else>>
				<<He>>
			<</if>>

			당신의 _asylumBindUnderwear【을를】 끌어내려 발을 빼게 한다.
		<</if>>
		<<if _asylumBindUnderwear>> <<He>>【은는】 당신에게 새 $worn.under_lower.name_simple【을를】 입히고 위로 끌어 올려준다.
		<</if>>
		당신의 짧았던 자유의 시간은 <<he>>【이가】 새 구속복으로 당신을 단단히 묶으면서 끝이 난다.
		<<fameexhibitionism 1>>
		<br><br>
	<<elseif $exposed gte 1>>
		<<He>>【은는】 뒤로 물러서서 당신을 유심히 살핀다. <<covered>> "그런 꼴로는 선생님을 뵐 수 없습니다," <<he>>【이가】 말한다. <<He>>【은는】 환자복으로 당신을 덮어준다. <<unbind>><<upperwear "patient gown">><<exposure>>
		<br><br>
	<</if>>
<</widget>>

/* _args[0] should be punish, fake, or session */
<<widget "asylumBind">>
	<<unbind>><<exposure>><<strip>>

	<<if _args[0] is "punish">>
		<<ruined false true "carried">>
	<<elseif _args[0] is "fake">>
	<<else>>
		<<if $player.gender_appearance is "f">>
			<<set _underwearIndex to 1>>
		<<else>>
			<<set _underwearIndex to 4>>
		<</if>>

		<<if $carried.under_lower.index isnot _underwearIndex or $carried.under_lower.colour isnot "pale white">>
			<<if $carried.under_lower.name is "naked">>
				<<set _asylumBindUnderwear to "given">>
			<<else>>
				<<set _asylumBindUnderwear to $carried.under_lower.name>>
			<</if>>

			<<underlowerwear _underwearIndex "pale white">>
		<<else>>
			<<underloweron>>
		<</if>>
	<</if>>

	<<if _args[0] is "session">>
		<<generalRuined "upper" true "carried">>
	<<else>>
		<<returnCarried>>
	<</if>>

	<<bind>><<upperwear "straightjacket">><<exposure>>
<</widget>>

<<widget "asylumUnbind">>
	<<if pcAreArmsBound("any")>>
		<<endevent>>
		<<generate1>><<person1>>
		어느 문 앞에 다다르기 직전, 다른 간호사가 당신을 멈춰 세운다. "의사 선생님께서 이번 치료에는 당신 두 손을 자유롭게 해두라고 하셨습니다," <<he>>【이가】 말하며 당신의 결박을 풀어준다.
		<<if $worn.upper.name is "straightjacket" or $worn.lower.name is "straightjacket bottom">>
			그런 다음 <<he>>【은는】 당신이<<if $worn.lower.name isnot "straightjacket bottom" or $worn.upper.name isnot "straightjacket">> 찢어진<</if>> 구속복을 벗도록 도와준다<<if _args[0]>>. 그리고 환자복으로 당신의 몸을 덮어준다.<<unbind>><<exposure>><<upperwear "patient gown">><<else>>.<</if>>
		<<else>>
			<<unbind>><<exposure>>
		<</if>>

		<<He>>【은는】 근처의 문을 열고 당신을 안으로 안내한다.
		<br><br>

		<<endevent>>
	<</if>>
<</widget>>

<<widget "asylumUnbindGown">>
	<<asylumUnbind true>>
<</widget>>

<<widget "asylumRebind">>
	<<if $asylumbound gt 0 and ($worn.upper.name isnot "straightjacket" or $worn.lower.name isnot "straightjacket bottom")>>
		<<clearsinglenpc 0>>
		<<generate1>><<person1>>
		<<if V.carried.upper.name is "patient gown" or V.worn.upper.name is "patient gown">>
			<<set _gown to true>>
		<</if>>

		<<if $worn.upper.name is "straightjacket" and $worn.lower.name isnot "straightjacket bottom">>
			<<set _ruined to true>>
		<</if>>

		<<asylumBind "session">>

		방 밖에서 간호사가 당신을 기다리고 있다.
		<<if _gown>>
			<<He>>【은는】 당신이 입고 있던 환자복을 반납하게 한다. 그런 다음 <<he>>【은는】 
		<<elseif _ruined>>
			<<He>>【은는】 당신이 찢어진 구속복에서 빠져나오도록 돕는다. 그런 다음 <<he>>【은는】 
		<<else>>
			<<He>>
		<</if>>

		<<if _asylumBindUnderwear>>
			당신에게 $worn.under_lower.name_simple【을를】 입힌 뒤,
		<<else>>
			곧장
		<</if>>

		당신을 다시 한번 <<if _ruined>>새 <</if>>구속복으로 구속한다.
		<br><br>
	<</if>>
<</widget>>

<<widget "asylumClothesOn">>
	<<clotheson>>
	<<if $asylumbound gt 0>>
		<<asylumBind>>
	<</if>>
<</widget>>

<<widget "asylumevents">>
	<<if dangerEvent()>>
		<<cleareventpool>>

		<<addinlineevent "asylum_exposure" 1>>
			<<generate1>><<person1>>
			"저기요," 당신의 곁에서 누군가 부른다. 환자복을 입은 <<person>>【이】네. "하퍼 선생님이 제게 과제를 주셨어요. 저는—" <<He>>【은는】 시선을 돌린다. "다음 평가 전까지 열두 명의 사람들에게 절 노출해야 해요. ㅈ-제 몸을요. ㄷ-당신한테 보여줘도 될까요?" <<He>>【은는】 행복해 보이지 않는다.
			<br><br>

			<<link [[승낙한다|Asylum Exposure Accept]]>><<handheldon>><<arousal 600>><</link>><<garousal>>
			<br>
			<<link [[눈을 감은 채로 승낙한다|Asylum Exposure Shut]]>><<famegood 1>><<handheldon>><</link>>
			<br>
			<<link [[눈을 감은 척하며 승낙한다|Asylum Exposure Peek]]>><<arousal 600>><<famegood 1>><<handheldon>><</link>><<garousal>>
			<br>
			<<link [[거절한다|Asylum Exposure Refuse]]>><<handheldon>><</link>>
			<br>
		<</addinlineevent>>

		<<if random(1,100) lte $suspicion>>
			<<addinlineevent "asylum_fake_treatment" 1>>
				<<generateDoctor 1>><<generate2>><<person1>>
				간호조무사 복장을 한 <<person>>【이가】 당신에게 다가온다. "안녕하세요. 의사 선생님께서 오늘 여유 시간이 생겨 환자분께 추가 치료를 하고 싶어 하십니다," <<he>>【이가】 말한다. "저를 따라오시죠."
				<br><br>

				<<person2>><<person>>【이가】 당신 뒤에 서 있다.
				<br><br>

				<<link [[그들을 따라간다|Asylum Fake Treatment Accept]]>><<handheldon>><</link>>
				<br>
				<<link [[가기를 거부한다|Asylum Fake Treatment Refuse]]>><<handheldon>><</link>><<physiquedifficulty 1 $physiquemax>>
				<br>
			<</addinlineevent>>
		<</if>>

		<<addinlineevent "asylum_flirt" 2>>
			<<generate1>><<person1>><<npcClothesType $NPCList[0] "patient">>다른 환자 중 하나인 <<person>>【이가】 당신을 보고 있는 것을 눈치챈다. <<He>>【은는】 미소 짓는다.
			<br><br>

			<<link [[추파를 던진다 (0:02)|Asylum Flirt]]>><<handheldon>><<asylumstatus 1>><<pass 2>><</link>><<promiscuous1>><<gcool>>
			<br>
			<<link [[무시한다|Asylum]]>><<endevent>><</link>>
			<br>
		<</addinlineevent>>

		<<addinlineevent "asylum_nurse_grope" 4>>
			<<generate1>><<generatev2>><<person1>>환자 중 한 명인 <<person>>【이가】 간호사인 <<person2>><<person>>의 몸을 더듬는다. 간호사는 저항하지 않는다. <<He>>【은는】 체념한 듯 보인다.
			<br><br>

			<<link [[개입한다 (0:02)|Asylum Intervene]]>><<handheldon>><<pass 2>><<suspicion -5>><<asylumstatus -5>><</link>><<llsuspicion>><<llcool>>
			<br>
			<<link [[무시한다|Asylum]]>><<endevent>><</link>>
			<br>
		<</addinlineevent>>

		<<addinlineevent "asylum_answer" 2>>
			<<generate1>><<person1>><<generate2>>환자인 <<person>>【이가】 당신을 지나쳐 숨자마자, 간호사인 <<person2>><<person>>【이가】 모퉁이를 돈다. 주위를 둘러보던 <<He>>【은는】 당신을 본다. "혹시 <<person1>><<person>> 못 봤습니까?"
			<br><br>

			<<link [[진실을 말한다|Asylum Truth]]>><<handheldon>><<suspicion -5>><<asylumstatus -5>><</link>><<llsuspicion>><<llcool>>
			<br>
			<<link [[거짓을 말한다|Asylum Lie]]>><<handheldon>><<suspicion 5>><<asylumstatus 5>><</link>><<ggsuspicion>><<ggcool>>
			<br>
		<</addinlineevent>>

		<<addinlineevent "asylum_flower_patch" 1>>
			결국 다른 환자들에게 지친 당신은 신선한 공기를 쐬러 정신병원 마당으로 나간다. 마당을 거닐며 그나마 즐길 만한 것을 찾아본다.
			<br><br>
			산책하던 중 야생화가 피어 있는 곳을 발견한다.
			<br><br>
			<<if !pcAreArmsBound("any")>>
				<<link [[화관을 만든다|Asylum Flower Patch Crown]]>><</link>><<tendingdifficulty 1 200>>
				<br>
			<<else>>
				<span class="blue">당신의 두 팔이 묶여 있는 동안에는 꽃으로 아무것도 할 수 없다.</span>
				<br>
			<</if>>
			<<link [[앉아서 감상한다|Asylum Flower Patch Observe]]>><<stress -6>><</link>><<lstress>>
			<br>
			<<link [[무시한다|Asylum]]>><<endevent>><</link>>
			<br>
		<</addinlineevent>>


		<<if $daily.asylumPuzzle isnot 1>>
			<<addinlineevent "asylum_puzzle" 1>>

				<<set $daily.asylumPuzzle to 1>>
				당신은 한쪽 구석의 탁자에 둘러앉은 환자 무리를 발견한다.
				<<if $asylumPuzzleProgress gte 1>>
					<<loadNPC 0 "asylum_puzzle_group">>
					<span class="blue">지난번에 당신이 도왔던 바로 그 무리가</span> 다시 퍼즐에 몰두하고 있다.
				<<else>>
					<<generate1>>
					그들은 눈앞에 펼쳐진 커다란 퍼즐을 맞추고 있다.
				<</if>>
				<br><br>

				<<= $asylumPuzzleProgress >= 1 ? "그" : "한">> <<person1>><<person>>【이가】 고개를 들고 당신과 눈이 마주치자,
				<<if pcAreArmsBound("both")>>
					비웃음을 터뜨리고는 고개를 돌린다.<<asylumstatus -1>><<lcool>>
					<br><br>

					<span class="blue">두 팔이 묶여 있는 동안에는 참가할 수 없다.</span>
					<br><br>

					<<link [[다음|Asylum]]>><<handheldon>><<endevent>><</link>>
					<br>
				<<elseif $asylumstatus gte 60>>
					당신에게 이리 오라고 손짓한다.
					<br><br>

					<<link [[그들과 합류한다|Asylum Puzzle]]>><<asylumstatus 1>><</link>><<gcool>>
					<br>
					<<link [[고개를 돌린다|Asylum]]>><<handheldon>><<endevent>><</link>>
					<br>
				<<else>>
					경멸하는 듯한 시선으로 당신을 쏘아본다. 당신은 서둘러 고개를 돌리고 다른 할 일을 찾는다.
					<br><br>

					<<link [[다음|Asylum]]>><<handheldon>><<endevent>><</link>>
					<br>
				<</if>>
			<</addinlineevent>>
		<</if>>

		<<runeventpool>>
	<<else>>
		<<link [[다음|Asylum]]>><<handheldon>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "passoutasylum">>
	<<if isPregnancyEnding()>>
		<<pregnancyPassout "asylum">>
	<<else>>
		<<passout>>
		<<link [[모든 것이 어둠에 잠긴다...|Passout Asylum]]>><</link>>
	<</if>>
<</widget>>

<<widget "asylumescape">>
	<<set $asylumescaped to 1>>
	<<specialClothesUnlock "set" "asylum">>
	<<if $location is "tentworld">>
		<<set $asylumtentacleescape to 1>> /* unused */
	<</if>>

	<<if C.npc.Robin.init is 1>>
		<<set $robinReunionScene to "asylum">>
	<</if>>
<</widget>>
<<widget "asylum_mirror_assess">>
	<<set _asylum_mirror_count to ($asylum_mirror_large * 3) + ($asylum_mirror_medium * 2) + $asylum_mirror_small>>
<</widget>>

<<widget "asylum_depths_mirror_links">>
	<<if $asylum_mirror_small_carried gte 1>>
		<<link [[작은 거울을 추가한다|Asylum Depths Mirror Small]]>><<awareness -6>><<trauma -6>><<set $asylum_mirror_small_carried -= 1>><<set $asylum_mirror_small += 1>><<endevent>><<generate1>><<generate2>><<person1>><</link>><<lawareness>><<ltrauma>>
		<br>
	<</if>>
	<<if $asylum_mirror_medium_carried gte 1>>
		<<link [[중간 크기 거울을 추가한다|Asylum Depths Mirror Medium]]>><<awareness -6>><<trauma -6>><<set $asylum_mirror_medium_carried -= 1>><<set $asylum_mirror_medium += 1>><<endevent>><<generate1>><<generate2>><<person1>><</link>><<lawareness>><<ltrauma>>
		<br>
	<</if>>
	<<if $asylum_mirror_large_carried gte 1>>
		<<link [[큰 거울을 추가한다|Asylum Depths Mirror Large]]>><<awareness -6>><<trauma -6>><<set $asylum_mirror_large_carried -= 1>><<set $asylum_mirror_large += 1>><<endevent>><<generate1>><<generate2>><<person1>><</link>><<lawareness>><<ltrauma>>
		<br>
	<</if>>
<</widget>>
