	<<elseif !$hypnosis_traits[_trait]>>
		<<set $hypnosis_traits[_trait] to 1>>
		<span class="pink">최면 _TraitText</span> 특성을 얻었습니다.
	<<elseif $hypnosis_traits[_trait] lt 5>>
		<<set $hypnosis_traits[_trait] += 1>>
		당신의 최면 _traitText【이가】 강화되었습니다.
	<</if>>

	<<set _traitValue to $hypnosis_traits[_trait]>>
	<br><br>

	"좋아요," 의사가 말한다.
	<<if $phase is "Oral">>
		<<person2>>"무릎을 꿇고 <<his>> 성기에 입을 사용하도록. <<He>>【은는】 즐거워할 겁니다. 알겠습니까?"
		<br><br>

		"네," <<person>>【이가】 말한다. "즐거울 거예요."
	<<elseif $phase is "Exhibitionism">>
		"옷을 벗으세요. 산책을 갈 겁니다."
	<<elseif $phase is "Dog">>
		<<generateBEAST 2 "dog">>

