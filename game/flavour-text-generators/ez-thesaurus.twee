:: Widget EZ Thesaurus [widget]
<<widget "EZdisgusting">>
	<<set _possibilities to [
		"역겨운",
		"더러운",
		"혐오스러운",
		"추잡한",
		"징그러운",
		"추악한",
		"구역질 나는",
		"역겨운",
		"썩어빠진"
	]>>
	<<print _possibilities.pluck()>>
<</widget>>

